def Ecma.Machine.Ins.eqB : Ecma.Machine.Ins → Ecma.Machine.Ins → Bool
  | .site a1, b => match b with
    | .site b1 => EqB.eqB a1 b1
    | _ => false
  | .let_ a1 a2, b => match b with
    | .let_ b1 b2 => EqB.eqB a1 b1 && EqB.eqB a2 b2
    | _ => false
  | .eval a1, b => match b with
    | .eval b1 => EqB.eqB a1 b1
    | _ => false
  | .setField a1 a2 a3, b => match b with
    | .setField b1 b2 b3 => EqB.eqB a1 b1 && EqB.eqB a2 b2 && EqB.eqB a3 b3
    | _ => false
  | .setIndex a1 a2 a3, b => match b with
    | .setIndex b1 b2 b3 => EqB.eqB a1 b1 && EqB.eqB a2 b2 && EqB.eqB a3 b3
    | _ => false
  | .ret a1, b => match b with
    | .ret b1 => EqB.eqB a1 b1
    | _ => false
  | .retUnused, b => match b with
    | .retUnused => true
    | _ => false
  | .throw a1, b => match b with
    | .throw b1 => EqB.eqB a1 b1
    | _ => false
  | .br a1 a2 a3, b => match b with
    | .br b1 b2 b3 => EqB.eqB a1 b1 && Ecma.Machine.Ins.eqB_LIns a2 b2 && Ecma.Machine.Ins.eqB_LIns a3 b3
    | _ => false
  | .assert a1, b => match b with
    | .assert b1 => EqB.eqB a1 b1
    | _ => false
  | .assertAt a1 a2, b => match b with
    | .assertAt b1 b2 => EqB.eqB a1 b1 && EqB.eqB a2 b2
    | _ => false
  | .assertIf a1 a2, b => match b with
    | .assertIf b1 b2 => EqB.eqB a1 b1 && EqB.eqB a2 b2
    | _ => false
  | .loop a1 a2 a3 a4, b => match b with
    | .loop b1 b2 b3 b4 => EqB.eqB a1 b1 && EqB.eqB a2 b2 && EqB.eqB a3 b3 && Ecma.Machine.Ins.eqB_LIns a4 b4
    | _ => false
  | .ctxPush a1, b => match b with
    | .ctxPush b1 => EqB.eqB a1 b1
    | _ => false
  | .ctxRemove a1, b => match b with
    | .ctxRemove b1 => EqB.eqB a1 b1
    | _ => false
  | .ctxTopIs a1, b => match b with
    | .ctxTopIs b1 => EqB.eqB a1 b1
    | _ => false
  | .transfer a1 a2 a3, b => match b with
    | .transfer b1 b2 b3 => EqB.eqB a1 b1 && EqB.eqB a2 b2 && EqB.eqB a3 b3
    | _ => false
  | .readings a1 a2 a3, b => match b with
    | .readings b1 b2 b3 => EqB.eqB a1 b1 && Ecma.Machine.Ins.eqB_LIns a2 b2 && Ecma.Machine.Ins.eqB_LPReadingLIns a3 b3
    | _ => false
  | .reading a1 a2, b => match b with
    | .reading b1 b2 => EqB.eqB a1 b1 && Ecma.Machine.Ins.eqB_LIns a2 b2
    | _ => false
  | .byReading a1 a2 a3, b => match b with
    | .byReading b1 b2 b3 => EqB.eqB a1 b1 && Ecma.Machine.Ins.eqB_LIns a2 b2 && Ecma.Machine.Ins.eqB_LPReadingLIns a3 b3
    | _ => false
  | .cover a1 a2 a3 a4, b => match b with
    | .cover b1 b2 b3 b4 => EqB.eqB a1 b1 && EqB.eqB a2 b2 && EqB.eqB a3 b3 && EqB.eqB a4 b4
    | _ => false
  | .stop a1, b => match b with
    | .stop b1 => EqB.eqB a1 b1
    | _ => false
  | .residue a1, b => match b with
    | .residue b1 => EqB.eqB a1 b1
    | _ => false

