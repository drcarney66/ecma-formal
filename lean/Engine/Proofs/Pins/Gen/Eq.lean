def Ecma.Machine.CellCode.eqB : Ecma.Machine.CellCode → Ecma.Machine.CellCode → Bool
  | .vals a1, b => match b with
    | .vals b1 => EqB.eqB a1 b1
    | _ => false
  | .lines a1, b => match b with
    | .lines b1 => Ecma.Machine.CellCode.eqB_LCellCode a1 b1
    | _ => false
  | .wrap a1, b => match b with
    | .wrap b1 => Ecma.Machine.CellCode.eqB a1 b1
    | _ => false
  | .other, b => match b with
    | .other => true
    | _ => false

def Ecma.Machine.CellCode.eqB_LCellCode : (List Ecma.Machine.CellCode) → (List Ecma.Machine.CellCode) → Bool
  | [], [] => true
  | a :: as, b :: bs => Ecma.Machine.CellCode.eqB a b && Ecma.Machine.CellCode.eqB_LCellCode as bs
  | _, _ => false
end

