    split at h
    · have h1 := h
      have e1 := EqB.sound _ _ h1
      subst e1
      rfl
    · exact absurd h Bool.false_ne_true
  | .lines a1, b, h => by
    unfold Ecma.Machine.CellCode.eqB at h
    split at h
    · have h1 := h
      have e1 := Ecma.Machine.CellCode.eqB_LCellCode_sound _ _ h1
      subst e1
      rfl
    · exact absurd h Bool.false_ne_true
  | .wrap a1, b, h => by
    unfold Ecma.Machine.CellCode.eqB at h
    split at h
    · have h1 := h
      have e1 := Ecma.Machine.CellCode.eqB_sound _ _ h1
      subst e1
      rfl
    · exact absurd h Bool.false_ne_true
  | .other, b, h => by
    unfold Ecma.Machine.CellCode.eqB at h
    split at h
    · rfl
    · exact absurd h Bool.false_ne_true

