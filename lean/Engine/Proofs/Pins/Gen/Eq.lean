mutual
def Ecma.Machine.Op.eqB : Ecma.Machine.Op → Ecma.Machine.Op → Bool
  | .const a1, b => match b with
    | .const b1 => EqB.eqB a1 b1
    | _ => false
  | .var a1, b => match b with
    | .var b1 => EqB.eqB a1 b1
    | _ => false
  | .bnd a1, b => match b with
    | .bnd b1 => EqB.eqB a1 b1
    | _ => false
  | .node, b => match b with
    | .node => true
    | _ => false
  | .child a1 a2, b => match b with
    | .child b1 b2 => EqB.eqB a1 b1 && EqB.eqB a2 b2
    | _ => false
  | .resumed, b => match b with
    | .resumed => true
    | _ => false
  | .closure a1 a2, b => match b with
    | .closure b1 b2 => EqB.eqB a1 b1 && EqB.eqB a2 b2
    | _ => false
  | .bound, b => match b with
    | .bound => true
    | _ => false
  | .leaf a1 a2, b => match b with
    | .leaf b1 b2 => EqB.eqB a1 b1 && Ecma.Machine.Op.eqB_LOp a2 b2
    | _ => false
  | .call a1 a2, b => match b with
    | .call b1 b2 => EqB.eqB a1 b1 && Ecma.Machine.Op.eqB_LOp a2 b2
    | _ => false
  | .on a1 a2 a3, b => match b with
    | .on b1 b2 b3 => EqB.eqB a1 b1 && Ecma.Machine.Op.eqB a2 b2 && Ecma.Machine.Op.eqB_LOp a3 b3
    | _ => false
  | .bind a1 a2, b => match b with
    | .bind b1 b2 => Ecma.Machine.Op.eqB a1 b1 && Ecma.Machine.Op.eqB a2 b2
    | _ => false
  | .and a1, b => match b with
    | .and b1 => Ecma.Machine.Op.eqB_LOp a1 b1
    | _ => false
  | .or a1, b => match b with
    | .or b1 => Ecma.Machine.Op.eqB_LOp a1 b1
    | _ => false
  | .andT a1 a2, b => match b with
    | .andT b1 b2 => Ecma.Machine.Op.eqB_LOp a1 b1 && Ecma.Machine.Op.eqB a2 b2
    | _ => false
  | .all a1 a2, b => match b with
    | .all b1 b2 => Ecma.Machine.Op.eqB a1 b1 && Ecma.Machine.Op.eqB a2 b2
    | _ => false
  | .stop a1, b => match b with
    | .stop b1 => EqB.eqB a1 b1
    | _ => false
  | .residue a1, b => match b with
    | .residue b1 => EqB.eqB a1 b1
    | _ => false

def Ecma.Machine.Op.eqB_LOp : (List Ecma.Machine.Op) → (List Ecma.Machine.Op) → Bool
  | [], [] => true
  | a :: as, b :: bs => Ecma.Machine.Op.eqB a b && Ecma.Machine.Op.eqB_LOp as bs
  | _, _ => false
end

