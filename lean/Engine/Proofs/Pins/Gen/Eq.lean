theorem Ecma.Machine.Op.eqB_LOp_sound : ∀ a b : (List Ecma.Machine.Op), Ecma.Machine.Op.eqB_LOp a b = true → a = b
  | [], [], _ => rfl
  | _ :: _, _ :: _, h => by
    simp only [Ecma.Machine.Op.eqB_LOp, Bool.and_eq_true] at h
    obtain ⟨h1, h2⟩ := h
    have e1 := Ecma.Machine.Op.eqB_sound _ _ h1
    have e2 := Ecma.Machine.Op.eqB_LOp_sound _ _ h2
    subst e1 e2
    rfl
  | [], _ :: _, h | _ :: _, [], h => by simp [Ecma.Machine.Op.eqB_LOp] at h
end

