  | .inline a1, b, h => by
    unfold Ecma.Body.eqB at h
    split at h
    · have h1 := h
      have e1 := Ecma.Stmt.eqB_sound _ _ h1
      subst e1
      rfl
    · exact absurd h Bool.false_ne_true
  | .block a1, b, h => by
    unfold Ecma.Body.eqB at h
    split at h
    · have h1 := h
      have e1 := Ecma.Body.eqB_LNode_sound _ _ h1
