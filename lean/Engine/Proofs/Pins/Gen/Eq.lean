mutual
def Ecma.Machine.CellCode.eqB : Ecma.Machine.CellCode → Ecma.Machine.CellCode → Bool
  | .vals a1, b => match b with
    | .vals b1 => EqB.eqB a1 b1
    | _ => false
  | .lines a1, b => match b with
    | .lines b1 => Ecma.Machine.CellCode.eqB_LCellCode a1 b1
    | _ => false
  | .wrap a1, b => match b with
    | .wrap b1 => Ecma.Machine.CellCode.eqB a1 b1
    | _ => false
  | .other, b => match b with
    | .other => true
    | _ => false

def Ecma.Machine.CellCode.eqB_LCellCode : (List Ecma.Machine.CellCode) → (List Ecma.Machine.CellCode) → Bool
  | [], [] => true
  | a :: as, b :: bs => Ecma.Machine.CellCode.eqB a b && Ecma.Machine.CellCode.eqB_LCellCode as bs
  | _, _ => false
end

mutual
theorem Ecma.Machine.CellCode.eqB_sound : ∀ a b : Ecma.Machine.CellCode, Ecma.Machine.CellCode.eqB a b = true → a = b
  | .vals a1, b, h => by
    unfold Ecma.Machine.CellCode.eqB at h
    split at h
    · have h1 := h
      have e1 := EqB.sound _ _ h1
      subst e1
      rfl
    · exact absurd h Bool.false_ne_true
  | .lines a1, b, h => by
    unfold Ecma.Machine.CellCode.eqB at h
    split at h
    · have h1 := h
      have e1 := Ecma.Machine.CellCode.eqB_LCellCode_sound _ _ h1
      subst e1
      rfl
    · exact absurd h Bool.false_ne_true
  | .wrap a1, b, h => by
    unfold Ecma.Machine.CellCode.eqB at h
    split at h
    · have h1 := h
      have e1 := Ecma.Machine.CellCode.eqB_sound _ _ h1
      subst e1
      rfl
    · exact absurd h Bool.false_ne_true
  | .other, b, h => by
    unfold Ecma.Machine.CellCode.eqB at h
    split at h
    · rfl
    · exact absurd h Bool.false_ne_true

theorem Ecma.Machine.CellCode.eqB_LCellCode_sound : ∀ a b : (List Ecma.Machine.CellCode), Ecma.Machine.CellCode.eqB_LCellCode a b = true → a = b
  | [], [], _ => rfl
  | _ :: _, _ :: _, h => by
    simp only [Ecma.Machine.CellCode.eqB_LCellCode, Bool.and_eq_true] at h
    obtain ⟨h1, h2⟩ := h
    have e1 := Ecma.Machine.CellCode.eqB_sound _ _ h1
    have e2 := Ecma.Machine.CellCode.eqB_LCellCode_sound _ _ h2
    subst e1 e2
    rfl
  | [], _ :: _, h | _ :: _, [], h => by simp [Ecma.Machine.CellCode.eqB_LCellCode] at h
end

instance : EqB Ecma.Machine.CellCode := ⟨Ecma.Machine.CellCode.eqB, Ecma.Machine.CellCode.eqB_sound⟩

