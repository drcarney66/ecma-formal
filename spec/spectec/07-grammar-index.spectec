goal |InputElementDiv|  src grammar
goal |InputElementTemplateTail|  src grammar
goal |InputElementRegExp|  src grammar
goal |InputElementRegExpOrTemplateTail|  src grammar
goal |InputElementHashbangOrRegExp|  src grammar
goal |Pattern|  src grammar
goal |StringNumericLiteral|  src grammar
goal |StrDecimalLiteral|  src grammar
goal |StringIntegerLiteral|  src grammar
goal |UTCOffset|  src grammar
goal |Script|  src grammar
goal |Module|  src grammar
goal |HexDigits| [~Sep] src parseText
goal |FunctionExpression|  src grammarSymbol
goal |FunctionBody| [~Yield, ~Await] src grammarSymbol
goal |FormalParameters| [~Yield, ~Await] src grammarSymbol
goal |GeneratorExpression|  src grammarSymbol
goal |GeneratorBody|  src grammarSymbol
goal |FormalParameters| [+Yield, ~Await] src grammarSymbol
goal |AsyncFunctionExpression|  src grammarSymbol
goal |AsyncFunctionBody|  src grammarSymbol
goal |FormalParameters| [~Yield, +Await] src grammarSymbol
goal |AsyncGeneratorExpression|  src grammarSymbol
goal |AsyncGeneratorBody|  src grammarSymbol
goal |FormalParameters| [+Yield, +Await] src grammarSymbol
goal |NativeFunction|  src syntaxOf
goal |Pattern| [+UnicodeMode, +UnicodeSetsMode, +NamedCaptureGroups] src parseText
goal |Pattern| [+UnicodeMode, ~UnicodeSetsMode, +NamedCaptureGroups] src parseText
goal |Pattern| [~UnicodeMode, ~UnicodeSetsMode, +NamedCaptureGroups] src parseText
goal |Pattern| [~UnicodeMode, ~UnicodeSetsMode, ~NamedCaptureGroups] src parseText
goal |AssignmentPattern|  src mustCover
goal |ParenthesizedExpression|  src mustCover
goal |AwaitUsingDeclarationHead|  src mustCover
goal |ArrowFormalParameters|  src mustCover
goal |AsyncArrowHead|  src mustCover
goal |CallMemberExpression|  src supplemental
goal |AwaitExpression|  src copy
goal |JSONText|  src json

cover p"Syntactic - PrimaryExpression : CoverParenthesizedExpressionAndArrowParameterList[?Yield, ?Await]" cover |CoverParenthesizedExpressionAndArrowParameterList| refined |ParenthesizedExpression|
cover p"Syntactic - CallExpression : CoverCallExpressionAndAsyncArrowHead[?Yield, ?Await]" cover |CoverCallExpressionAndAsyncArrowHead| refined |CallMemberExpression|
cover p"Syntactic - UnaryExpression : [+Await] CoverAwaitExpressionAndAwaitUsingDeclarationHead[?Yield]" cover |CoverAwaitExpressionAndAwaitUsingDeclarationHead| refined |AwaitExpression|
cover p"Syntactic - AssignmentExpression : LeftHandSideExpression[?Yield, ?Await] `=` AssignmentExpression[?In, ?Yield, ?Await]" cover |LeftHandSideExpression| refined |AssignmentPattern|
cover p"Syntactic - AwaitUsingDeclaration : CoverAwaitExpressionAndAwaitUsingDeclarationHead[?Yield] [no LineTerminator here] BindingList[?In, ?Yield, +Await, ~Pattern] `;`" cover |CoverAwaitExpressionAndAwaitUsingDeclarationHead| refined |AwaitUsingDeclarationHead|
cover p"Syntactic - ArrowParameters : CoverParenthesizedExpressionAndArrowParameterList[?Yield, ?Await]" cover |CoverParenthesizedExpressionAndArrowParameterList| refined |ArrowFormalParameters|
cover p"Syntactic - AsyncArrowFunction : CoverCallExpressionAndAsyncArrowHead[?Yield, ?Await] [no LineTerminator here] `=>` AsyncConciseBody[?In]" cover |CoverCallExpressionAndAsyncArrowHead| refined |AsyncArrowHead|

