grammar syntactic

rule syntactic |IdentifierReference| [Yield, Await] : {
  | |Identifier|
  | [~Yield] "yield"
  | [~Await] "await"
}

rule syntactic |BindingIdentifier| [Yield, Await] : {
  | |Identifier|
  | "yield"
  | "await"
}

rule syntactic |LabelIdentifier| [Yield, Await] : {
  | |Identifier|
  | [~Yield] "yield"
  | [~Await] "await"
}

rule syntactic |Identifier| [] : {
  | |IdentifierName| butnot |ReservedWord|
}

rule syntactic |PrimaryExpression| [Yield, Await] : {
  | "this"
  | |IdentifierReference[?Yield, ?Await]|
  | |Literal|
  | |ArrayLiteral[?Yield, ?Await]|
  | |ObjectLiteral[?Yield, ?Await]|
  | |FunctionExpression|
  | |ClassExpression[?Yield, ?Await]|
  | |GeneratorExpression|
  | |AsyncFunctionExpression|
  | |AsyncGeneratorExpression|
  | |RegularExpressionLiteral|
  | |TemplateLiteral[?Yield, ?Await, ~Tagged]|
  | |CoverParenthesizedExpressionAndArrowParameterList[?Yield, ?Await]| #label "parencover"
}

rule syntactic |CoverParenthesizedExpressionAndArrowParameterList| [Yield, Await] : {
  | "(" ")"
  | "(" |Expression[+In, ?Yield, ?Await]| ","? ")"
  | "(" "..." |BindingIdentifier[?Yield, ?Await]| ")"
  | "(" "..." |BindingPattern[?Yield, ?Await]| ")"
  | "(" |Expression[+In, ?Yield, ?Await]| "," "..." |BindingIdentifier[?Yield, ?Await]| ")"
  | "(" |Expression[+In, ?Yield, ?Await]| "," "..." |BindingPattern[?Yield, ?Await]| ")"
}

rule syntactic |ParenthesizedExpression| [Yield, Await] : {
  | "(" |Expression[+In, ?Yield, ?Await]| ")"
}

rule syntactic |Literal| [] : {
  | |NullLiteral|
  | |BooleanLiteral|
  | |NumericLiteral|
  | |StringLiteral|
}

rule syntactic |ArrayLiteral| [Yield, Await] : {
  | "[" |Elision|? "]"
  | "[" |ElementList[?Yield, ?Await]| "]"
  | "[" |ElementList[?Yield, ?Await]| "," |Elision|? "]"
}

rule syntactic |ElementList| [Yield, Await] : {
  | |Elision|? |AssignmentExpression[+In, ?Yield, ?Await]|
  | |Elision|? |SpreadElement[?Yield, ?Await]|
  | |ElementList[?Yield, ?Await]| "," |Elision|? |AssignmentExpression[+In, ?Yield, ?Await]|
  | |ElementList[?Yield, ?Await]| "," |Elision|? |SpreadElement[?Yield, ?Await]|
}

rule syntactic |Elision| [] : {
  | ","
  | |Elision| ","
}

rule syntactic |SpreadElement| [Yield, Await] : {
  | "..." |AssignmentExpression[+In, ?Yield, ?Await]|
}

rule syntactic |ObjectLiteral| [Yield, Await] : {
  | "{" "}"
  | "{" |PropertyDefinitionList[?Yield, ?Await]| ","? "}"
}

rule syntactic |PropertyDefinitionList| [Yield, Await] : {
  | |PropertyDefinition[?Yield, ?Await]|
  | |PropertyDefinitionList[?Yield, ?Await]| "," |PropertyDefinition[?Yield, ?Await]|
}

rule syntactic |PropertyDefinition| [Yield, Await] : {
  | |IdentifierReference[?Yield, ?Await]|
  | |CoverInitializedName[?Yield, ?Await]|
  | |PropertyName[?Yield, ?Await]| ":" |AssignmentExpression[+In, ?Yield, ?Await]|
  | |MethodDefinition[?Yield, ?Await]|
  | "..." |AssignmentExpression[+In, ?Yield, ?Await]|
}

rule syntactic |PropertyName| [Yield, Await] : {
  | |LiteralPropertyName|
  | |ComputedPropertyName[?Yield, ?Await]|
}

rule syntactic |LiteralPropertyName| [] : {
  | |IdentifierName|
  | |StringLiteral|
  | |NumericLiteral|
}

rule syntactic |ComputedPropertyName| [Yield, Await] : {
  | "[" |AssignmentExpression[+In, ?Yield, ?Await]| "]"
}

rule syntactic |CoverInitializedName| [Yield, Await] : {
  | |IdentifierReference[?Yield, ?Await]| |Initializer[+In, ?Yield, ?Await]|
}

rule syntactic |Initializer| [In, Yield, Await] : {
  | "=" |AssignmentExpression[?In, ?Yield, ?Await]|
}

rule syntactic |TemplateLiteral| [Yield, Await, Tagged] : {
  | |NoSubstitutionTemplate|
  | |SubstitutionTemplate[?Yield, ?Await]|
}

rule syntactic |SubstitutionTemplate| [Yield, Await] : {
  | |TemplateHead| |Expression[+In, ?Yield, ?Await]| |TemplateSpans[?Yield, ?Await]|
}

rule syntactic |TemplateSpans| [Yield, Await] : {
  | |TemplateTail|
  | |TemplateMiddleList[?Yield, ?Await]| |TemplateTail|
}

rule syntactic |TemplateMiddleList| [Yield, Await] : {
  | |TemplateMiddle| |Expression[+In, ?Yield, ?Await]|
  | |TemplateMiddleList[?Yield, ?Await]| |TemplateMiddle| |Expression[+In, ?Yield, ?Await]|
}

rule syntactic |MemberExpression| [Yield, Await] : {
  | |PrimaryExpression[?Yield, ?Await]|
  | |MemberExpression[?Yield, ?Await]| "[" |Expression[+In, ?Yield, ?Await]| "]"
  | |MemberExpression[?Yield, ?Await]| "." |IdentifierName|
  | |MemberExpression[?Yield, ?Await]| |TemplateLiteral[?Yield, ?Await, +Tagged]|
  | |SuperProperty[?Yield, ?Await]|
  | |MetaProperty|
  | "new" |MemberExpression[?Yield, ?Await]| |Arguments[?Yield, ?Await]|
  | |MemberExpression[?Yield, ?Await]| "." |PrivateIdentifier|
}

rule syntactic |SuperProperty| [Yield, Await] : {
  | "super" "[" |Expression[+In, ?Yield, ?Await]| "]"
  | "super" "." |IdentifierName|
}

rule syntactic |MetaProperty| [] : {
  | |NewTarget|
  | |ImportMeta|
}

rule syntactic |NewTarget| [] : {
  | "new" "." "target"
}

rule syntactic |ImportMeta| [] : {
  | "import" "." "meta"
}

rule syntactic |NewExpression| [Yield, Await] : {
  | |MemberExpression[?Yield, ?Await]|
  | "new" |NewExpression[?Yield, ?Await]|
}

rule syntactic |CallExpression| [Yield, Await] : {
  | |CoverCallExpressionAndAsyncArrowHead[?Yield, ?Await]| #label "callcover"
  | |SuperCall[?Yield, ?Await]|
  | |ImportCall[?Yield, ?Await]|
  | |CallExpression[?Yield, ?Await]| |Arguments[?Yield, ?Await]|
  | |CallExpression[?Yield, ?Await]| "[" |Expression[+In, ?Yield, ?Await]| "]"
  | |CallExpression[?Yield, ?Await]| "." |IdentifierName|
  | |CallExpression[?Yield, ?Await]| |TemplateLiteral[?Yield, ?Await, +Tagged]|
  | |CallExpression[?Yield, ?Await]| "." |PrivateIdentifier|
}

rule syntactic |SuperCall| [Yield, Await] : {
  | "super" |Arguments[?Yield, ?Await]|
}

rule syntactic |ImportCall| [Yield, Await] : {
  | "import" |ImportCallArguments[?Yield, ?Await]|
  | "import" "." "defer" |ImportCallArguments[?Yield, ?Await]|
}

rule syntactic |ImportCallArguments| [Yield, Await] : {
  | "(" |AssignmentExpression[+In, ?Yield, ?Await]| ","? ")"
  | "(" |AssignmentExpression[+In, ?Yield, ?Await]| "," |AssignmentExpression[+In, ?Yield, ?Await]| ","? ")"
}

rule syntactic |Arguments| [Yield, Await] : {
  | "(" ")"
  | "(" |ArgumentList[?Yield, ?Await]| ","? ")"
}

rule syntactic |ArgumentList| [Yield, Await] : {
  | |AssignmentExpression[+In, ?Yield, ?Await]|
  | "..." |AssignmentExpression[+In, ?Yield, ?Await]|
  | |ArgumentList[?Yield, ?Await]| "," |AssignmentExpression[+In, ?Yield, ?Await]|
  | |ArgumentList[?Yield, ?Await]| "," "..." |AssignmentExpression[+In, ?Yield, ?Await]|
}

rule syntactic |OptionalExpression| [Yield, Await] : {
  | |MemberExpression[?Yield, ?Await]| |OptionalChain[?Yield, ?Await]|
  | |CallExpression[?Yield, ?Await]| |OptionalChain[?Yield, ?Await]|
  | |OptionalExpression[?Yield, ?Await]| |OptionalChain[?Yield, ?Await]|
}

rule syntactic |OptionalChain| [Yield, Await] : {
  | "?." |Arguments[?Yield, ?Await]|
  | "?." "[" |Expression[+In, ?Yield, ?Await]| "]"
  | "?." |IdentifierName|
  | "?." |TemplateLiteral[?Yield, ?Await, +Tagged]|
  | "?." |PrivateIdentifier|
  | |OptionalChain[?Yield, ?Await]| |Arguments[?Yield, ?Await]|
  | |OptionalChain[?Yield, ?Await]| "[" |Expression[+In, ?Yield, ?Await]| "]"
  | |OptionalChain[?Yield, ?Await]| "." |IdentifierName|
  | |OptionalChain[?Yield, ?Await]| |TemplateLiteral[?Yield, ?Await, +Tagged]|
  | |OptionalChain[?Yield, ?Await]| "." |PrivateIdentifier|
}

rule syntactic |LeftHandSideExpression| [Yield, Await] : {
  | |NewExpression[?Yield, ?Await]|
  | |CallExpression[?Yield, ?Await]|
  | |OptionalExpression[?Yield, ?Await]|
}

rule syntactic |CallMemberExpression| [Yield, Await] : {
  | |MemberExpression[?Yield, ?Await]| |Arguments[?Yield, ?Await]|
}

rule syntactic |UpdateExpression| [Yield, Await] : {
  | |LeftHandSideExpression[?Yield, ?Await]|
  | |LeftHandSideExpression[?Yield, ?Await]| [noLT] "++"
  | |LeftHandSideExpression[?Yield, ?Await]| [noLT] "--"
  | "++" |UnaryExpression[?Yield, ?Await]|
  | "--" |UnaryExpression[?Yield, ?Await]|
}

rule syntactic |UnaryExpression| [Yield, Await] : {
  | |UpdateExpression[?Yield, ?Await]|
  | "delete" |UnaryExpression[?Yield, ?Await]|
  | "void" |UnaryExpression[?Yield, ?Await]|
  | "typeof" |UnaryExpression[?Yield, ?Await]|
  | "+" |UnaryExpression[?Yield, ?Await]|
  | "-" |UnaryExpression[?Yield, ?Await]|
  | "~" |UnaryExpression[?Yield, ?Await]|
  | "!" |UnaryExpression[?Yield, ?Await]|
  | [+Await] |CoverAwaitExpressionAndAwaitUsingDeclarationHead[?Yield]| #label "awaitusingcover"
}

rule syntactic |CoverAwaitExpressionAndAwaitUsingDeclarationHead| [Yield] : {
  | "await" |UnaryExpression[?Yield, +Await]|
}

rule syntactic |ExponentiationExpression| [Yield, Await] : {
  | |UnaryExpression[?Yield, ?Await]|
  | |UpdateExpression[?Yield, ?Await]| "**" |ExponentiationExpression[?Yield, ?Await]|
}

rule syntactic |MultiplicativeExpression| [Yield, Await] : {
  | |ExponentiationExpression[?Yield, ?Await]|
  | |MultiplicativeExpression[?Yield, ?Await]| |MultiplicativeOperator| |ExponentiationExpression[?Yield, ?Await]|
}

rule syntactic |MultiplicativeOperator| [] : one_of {
  row ["*", "/", "%"]
}

rule syntactic |AdditiveExpression| [Yield, Await] : {
  | |MultiplicativeExpression[?Yield, ?Await]|
  | |AdditiveExpression[?Yield, ?Await]| "+" |MultiplicativeExpression[?Yield, ?Await]|
  | |AdditiveExpression[?Yield, ?Await]| "-" |MultiplicativeExpression[?Yield, ?Await]|
}

rule syntactic |ShiftExpression| [Yield, Await] : {
  | |AdditiveExpression[?Yield, ?Await]|
  | |ShiftExpression[?Yield, ?Await]| "<<" |AdditiveExpression[?Yield, ?Await]|
  | |ShiftExpression[?Yield, ?Await]| ">>" |AdditiveExpression[?Yield, ?Await]|
  | |ShiftExpression[?Yield, ?Await]| ">>>" |AdditiveExpression[?Yield, ?Await]|
}

rule syntactic |RelationalExpression| [In, Yield, Await] : {
  | |ShiftExpression[?Yield, ?Await]|
  | |RelationalExpression[?In, ?Yield, ?Await]| "<" |ShiftExpression[?Yield, ?Await]|
  | |RelationalExpression[?In, ?Yield, ?Await]| ">" |ShiftExpression[?Yield, ?Await]|
  | |RelationalExpression[?In, ?Yield, ?Await]| "<=" |ShiftExpression[?Yield, ?Await]|
  | |RelationalExpression[?In, ?Yield, ?Await]| ">=" |ShiftExpression[?Yield, ?Await]|
  | |RelationalExpression[?In, ?Yield, ?Await]| "instanceof" |ShiftExpression[?Yield, ?Await]|
  | [+In] |RelationalExpression[+In, ?Yield, ?Await]| "in" |ShiftExpression[?Yield, ?Await]|
  | [+In] |PrivateIdentifier| "in" |ShiftExpression[?Yield, ?Await]|
}

rule syntactic |EqualityExpression| [In, Yield, Await] : {
  | |RelationalExpression[?In, ?Yield, ?Await]|
  | |EqualityExpression[?In, ?Yield, ?Await]| "==" |RelationalExpression[?In, ?Yield, ?Await]|
  | |EqualityExpression[?In, ?Yield, ?Await]| "!=" |RelationalExpression[?In, ?Yield, ?Await]|
  | |EqualityExpression[?In, ?Yield, ?Await]| "===" |RelationalExpression[?In, ?Yield, ?Await]|
  | |EqualityExpression[?In, ?Yield, ?Await]| "!==" |RelationalExpression[?In, ?Yield, ?Await]|
}

rule syntactic |BitwiseANDExpression| [In, Yield, Await] : {
  | |EqualityExpression[?In, ?Yield, ?Await]|
  | |BitwiseANDExpression[?In, ?Yield, ?Await]| "&" |EqualityExpression[?In, ?Yield, ?Await]|
}

rule syntactic |BitwiseXORExpression| [In, Yield, Await] : {
  | |BitwiseANDExpression[?In, ?Yield, ?Await]|
  | |BitwiseXORExpression[?In, ?Yield, ?Await]| "^" |BitwiseANDExpression[?In, ?Yield, ?Await]|
}

rule syntactic |BitwiseORExpression| [In, Yield, Await] : {
  | |BitwiseXORExpression[?In, ?Yield, ?Await]|
  | |BitwiseORExpression[?In, ?Yield, ?Await]| "|" |BitwiseXORExpression[?In, ?Yield, ?Await]|
}

rule syntactic |LogicalANDExpression| [In, Yield, Await] : {
  | |BitwiseORExpression[?In, ?Yield, ?Await]|
  | |LogicalANDExpression[?In, ?Yield, ?Await]| "&&" |BitwiseORExpression[?In, ?Yield, ?Await]|
}

rule syntactic |LogicalORExpression| [In, Yield, Await] : {
  | |LogicalANDExpression[?In, ?Yield, ?Await]|
  | |LogicalORExpression[?In, ?Yield, ?Await]| "||" |LogicalANDExpression[?In, ?Yield, ?Await]|
}

rule syntactic |CoalesceExpression| [In, Yield, Await] : {
  | |CoalesceExpressionHead[?In, ?Yield, ?Await]| "??" |BitwiseORExpression[?In, ?Yield, ?Await]|
}

rule syntactic |CoalesceExpressionHead| [In, Yield, Await] : {
  | |CoalesceExpression[?In, ?Yield, ?Await]|
  | |BitwiseORExpression[?In, ?Yield, ?Await]|
}

rule syntactic |ShortCircuitExpression| [In, Yield, Await] : {
  | |LogicalORExpression[?In, ?Yield, ?Await]|
  | |CoalesceExpression[?In, ?Yield, ?Await]|
}

rule syntactic |ConditionalExpression| [In, Yield, Await] : {
  | |ShortCircuitExpression[?In, ?Yield, ?Await]|
  | |ShortCircuitExpression[?In, ?Yield, ?Await]| "?" |AssignmentExpression[+In, ?Yield, ?Await]| ":" |AssignmentExpression[?In, ?Yield, ?Await]|
}

rule syntactic |AssignmentExpression| [In, Yield, Await] : {
  | |ConditionalExpression[?In, ?Yield, ?Await]|
  | [+Yield] |YieldExpression[?In, ?Await]|
  | |ArrowFunction[?In, ?Yield, ?Await]|
  | |AsyncArrowFunction[?In, ?Yield, ?Await]|
  | |LeftHandSideExpression[?Yield, ?Await]| "=" |AssignmentExpression[?In, ?Yield, ?Await]| #label "assignment"
  | |LeftHandSideExpression[?Yield, ?Await]| |AssignmentOperator| |AssignmentExpression[?In, ?Yield, ?Await]|
  | |LeftHandSideExpression[?Yield, ?Await]| "&&=" |AssignmentExpression[?In, ?Yield, ?Await]|
  | |LeftHandSideExpression[?Yield, ?Await]| "||=" |AssignmentExpression[?In, ?Yield, ?Await]|
  | |LeftHandSideExpression[?Yield, ?Await]| "??=" |AssignmentExpression[?In, ?Yield, ?Await]|
}

rule syntactic |AssignmentOperator| [] : one_of {
  row ["*=", "/=", "%=", "+=", "-=", "<<=", ">>=", ">>>=", "&=", "^=", "|=", "**="]
}

rule syntactic |AssignmentPattern| [Yield, Await] : {
  | |ObjectAssignmentPattern[?Yield, ?Await]|
  | |ArrayAssignmentPattern[?Yield, ?Await]|
}

rule syntactic |ObjectAssignmentPattern| [Yield, Await] : {
  | "{" "}"
  | "{" |AssignmentRestProperty[?Yield, ?Await]| "}"
  | "{" |AssignmentPropertyList[?Yield, ?Await]| ","? "}"
  | "{" |AssignmentPropertyList[?Yield, ?Await]| "," |AssignmentRestProperty[?Yield, ?Await]| "}"
}

rule syntactic |ArrayAssignmentPattern| [Yield, Await] : {
  | "[" |Elision|? |AssignmentRestElement[?Yield, ?Await]|? "]"
  | "[" |AssignmentElementList[?Yield, ?Await]| "]"
  | "[" |AssignmentElementList[?Yield, ?Await]| "," |Elision|? |AssignmentRestElement[?Yield, ?Await]|? "]"
}

rule syntactic |AssignmentRestProperty| [Yield, Await] : {
  | "..." |DestructuringAssignmentTarget[?Yield, ?Await]|
}

rule syntactic |AssignmentPropertyList| [Yield, Await] : {
  | |AssignmentProperty[?Yield, ?Await]|
  | |AssignmentPropertyList[?Yield, ?Await]| "," |AssignmentProperty[?Yield, ?Await]|
}

rule syntactic |AssignmentElementList| [Yield, Await] : {
  | |AssignmentElisionElement[?Yield, ?Await]|
  | |AssignmentElementList[?Yield, ?Await]| "," |AssignmentElisionElement[?Yield, ?Await]|
}

rule syntactic |AssignmentElisionElement| [Yield, Await] : {
  | |Elision|? |AssignmentElement[?Yield, ?Await]|
}

rule syntactic |AssignmentProperty| [Yield, Await] : {
  | |IdentifierReference[?Yield, ?Await]| |Initializer[+In, ?Yield, ?Await]|?
  | |PropertyName[?Yield, ?Await]| ":" |AssignmentElement[?Yield, ?Await]|
}

rule syntactic |AssignmentElement| [Yield, Await] : {
  | |DestructuringAssignmentTarget[?Yield, ?Await]| |Initializer[+In, ?Yield, ?Await]|?
}

rule syntactic |AssignmentRestElement| [Yield, Await] : {
  | "..." |DestructuringAssignmentTarget[?Yield, ?Await]|
}

rule syntactic |DestructuringAssignmentTarget| [Yield, Await] : {
  | |LeftHandSideExpression[?Yield, ?Await]|
}

rule syntactic |Expression| [In, Yield, Await] : {
  | |AssignmentExpression[?In, ?Yield, ?Await]|
  | |Expression[?In, ?Yield, ?Await]| "," |AssignmentExpression[?In, ?Yield, ?Await]|
}

rule syntactic |Statement| [Yield, Await, Return] : {
  | |BlockStatement[?Yield, ?Await, ?Return]|
  | |VariableStatement[?Yield, ?Await]|
  | |EmptyStatement|
  | |ExpressionStatement[?Yield, ?Await]|
  | |IfStatement[?Yield, ?Await, ?Return]|
  | |BreakableStatement[?Yield, ?Await, ?Return]|
  | |ContinueStatement[?Yield, ?Await]|
  | |BreakStatement[?Yield, ?Await]|
  | [+Return] |ReturnStatement[?Yield, ?Await]|
  | |WithStatement[?Yield, ?Await, ?Return]|
  | |LabelledStatement[?Yield, ?Await, ?Return]|
  | |ThrowStatement[?Yield, ?Await]|
  | |TryStatement[?Yield, ?Await, ?Return]|
  | |DebuggerStatement|
}

rule syntactic |Declaration| [Yield, Await] : {
  | |HoistableDeclaration[?Yield, ?Await, ~Default]|
  | |ClassDeclaration[?Yield, ?Await, ~Default]|
  | |LexicalDeclaration[+In, ?Yield, ?Await]|
}

rule syntactic |HoistableDeclaration| [Yield, Await, Default] : {
  | |FunctionDeclaration[?Yield, ?Await, ?Default]|
  | |GeneratorDeclaration[?Yield, ?Await, ?Default]|
  | |AsyncFunctionDeclaration[?Yield, ?Await, ?Default]|
  | |AsyncGeneratorDeclaration[?Yield, ?Await, ?Default]|
}

rule syntactic |BreakableStatement| [Yield, Await, Return] : {
  | |IterationStatement[?Yield, ?Await, ?Return]|
  | |SwitchStatement[?Yield, ?Await, ?Return]|
}

rule syntactic |BlockStatement| [Yield, Await, Return] : {
  | |Block[?Yield, ?Await, ?Return]|
}

rule syntactic |Block| [Yield, Await, Return] : {
  | "{" |StatementList[?Yield, ?Await, ?Return]|? "}"
}

rule syntactic |StatementList| [Yield, Await, Return] : {
  | |StatementListItem[?Yield, ?Await, ?Return]|
  | |StatementList[?Yield, ?Await, ?Return]| |StatementListItem[?Yield, ?Await, ?Return]|
}

rule syntactic |StatementListItem| [Yield, Await, Return] : {
  | |Statement[?Yield, ?Await, ?Return]|
  | |Declaration[?Yield, ?Await]|
}

rule syntactic |LexicalDeclaration| [In, Yield, Await] : {
  | |LetOrConst| |BindingList[?In, ?Yield, ?Await, +Pattern]| ";"
  | |UsingDeclaration[?In, ?Yield, ?Await]|
  | [+Await] |AwaitUsingDeclaration[?In, ?Yield]|
}

rule syntactic |LetOrConst| [] : {
  | "let"
  | "const"
}

rule syntactic |UsingDeclaration| [In, Yield, Await] : {
  | "using" [noLT] |BindingList[?In, ?Yield, ?Await, ~Pattern]| ";"
}

rule syntactic |AwaitUsingDeclaration| [In, Yield] : {
  | |CoverAwaitExpressionAndAwaitUsingDeclarationHead[?Yield]| [noLT] |BindingList[?In, ?Yield, +Await, ~Pattern]| ";"
}

rule syntactic |BindingList| [In, Yield, Await, Pattern] : {
  | |LexicalBinding[?In, ?Yield, ?Await, ?Pattern]|
  | |BindingList[?In, ?Yield, ?Await, ?Pattern]| "," |LexicalBinding[?In, ?Yield, ?Await, ?Pattern]|
}

rule syntactic |LexicalBinding| [In, Yield, Await, Pattern] : {
  | |BindingIdentifier[?Yield, ?Await]| |Initializer[?In, ?Yield, ?Await]|?
  | [+Pattern] |BindingPattern[?Yield, ?Await]| |Initializer[?In, ?Yield, ?Await]|
}

rule syntactic |AwaitUsingDeclarationHead| [] : {
  | "await" [noLT] "using"
}

rule syntactic |VariableStatement| [Yield, Await] : {
  | "var" |VariableDeclarationList[+In, ?Yield, ?Await]| ";"
}

rule syntactic |VariableDeclarationList| [In, Yield, Await] : {
  | |VariableDeclaration[?In, ?Yield, ?Await]|
  | |VariableDeclarationList[?In, ?Yield, ?Await]| "," |VariableDeclaration[?In, ?Yield, ?Await]|
}

rule syntactic |VariableDeclaration| [In, Yield, Await] : {
  | |BindingIdentifier[?Yield, ?Await]| |Initializer[?In, ?Yield, ?Await]|?
  | |BindingPattern[?Yield, ?Await]| |Initializer[?In, ?Yield, ?Await]|
}

rule syntactic |BindingPattern| [Yield, Await] : {
  | |ObjectBindingPattern[?Yield, ?Await]|
  | |ArrayBindingPattern[?Yield, ?Await]|
}

rule syntactic |ObjectBindingPattern| [Yield, Await] : {
  | "{" "}"
  | "{" |BindingRestProperty[?Yield, ?Await]| "}"
  | "{" |BindingPropertyList[?Yield, ?Await]| ","? "}"
  | "{" |BindingPropertyList[?Yield, ?Await]| "," |BindingRestProperty[?Yield, ?Await]| "}"
}

rule syntactic |ArrayBindingPattern| [Yield, Await] : {
  | "[" |Elision|? |BindingRestElement[?Yield, ?Await]|? "]"
  | "[" |BindingElementList[?Yield, ?Await]| "]"
  | "[" |BindingElementList[?Yield, ?Await]| "," |Elision|? |BindingRestElement[?Yield, ?Await]|? "]"
}

rule syntactic |BindingRestProperty| [Yield, Await] : {
  | "..." |BindingIdentifier[?Yield, ?Await]|
}

rule syntactic |BindingPropertyList| [Yield, Await] : {
