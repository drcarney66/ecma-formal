  | "..." |BindingPattern[?Yield, ?Await]|
}

rule syntactic |EmptyStatement| [] : {
  | ";"
}

rule syntactic |ExpressionStatement| [Yield, Await] : {
  | [lookahead not_in { "{", "function", "async" noLT "function", "class", "let" "[" }] |Expression[+In, ?Yield, ?Await]| ";"
}

rule syntactic |IfStatement| [Yield, Await, Return] : {
  | "if" "(" |Expression[+In, ?Yield, ?Await]| ")" |Statement[?Yield, ?Await, ?Return]| "else" |Statement[?Yield, ?Await, ?Return]|
  | "if" "(" |Expression[+In, ?Yield, ?Await]| ")" |Statement[?Yield, ?Await, ?Return]| [lookahead != "else"]
}

rule syntactic |IterationStatement| [Yield, Await, Return] : {
  | |DoWhileStatement[?Yield, ?Await, ?Return]|
  | |WhileStatement[?Yield, ?Await, ?Return]|
