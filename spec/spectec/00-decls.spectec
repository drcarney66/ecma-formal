extern def $ParseDateString { sig "ParseDateString(_s_: a String): a Number" meaning "The result of parsing _s_ as a date, in exactly the same manner as for the `parse` method (<emu-xref href=\"#sec-date.parse\"></emu-xref>): the host's interpretation of _s_ as a date and time, the UTC time value corresponding to it. A String in the Date Time String Format (<emu-xref href=\"#sec-date-time-string-format\"></emu-xref>) is parsed according to that format; for any other String the host may fall back to implementation-specific heuristics or formats; an unrecognizable String, or one with out-of-bounds format element values, gives *NaN*." }
extern def $ParseGoal { sig "ParseGoal(_sourceText_: a sequence of Unicode code points, _goalSymbol_: a nonterminal in one of the ECMAScript grammars, _strict_: a Boolean, _json_: a Boolean, _direct_: a Boolean): a Parse Node or ~empty~" meaning "The Parse Node, an instance of _goalSymbol_, at the root of the parse tree of _sourceText_ with _goalSymbol_ as the goal symbol (<emu-xref href=\"#sec-context-free-grammars\"></emu-xref>, <emu-xref href=\"#sec-grammar-notation\"></emu-xref>), or ~empty~ if _sourceText_ cannot be parsed so. Each call creates new Parse Nodes. Early errors are not considered. The new Parse Nodes record the invocation's context: whether its source text is strict from outside (_strict_; a direct eval in strict mode code) and whether it is parsed for ParseJSON (_json_) and whether it is PerformEval's with _direct_ *true* (_direct_: eval code being processed by a direct eval). A parse with no outside context passes *false* for all three." }
extern def $ParseNodesWithin { sig "ParseNodesWithin(_node_: a Parse Node): a List of Parse Nodes" meaning "A new List of _node_ and the Parse Nodes of nonterminals that it contains, in source text order with a node before its children (the model's descendants of _node_, after _node_); « _node_ » for a terminal's Parse Node. The Parse Nodes contained within _node_ include _node_: CountLeftCapturingParensWithin(|Atom|) of an |Atom| that is itself a left-capturing parenthesis counts it, as RepeatMatcher's clearing of the captures of the quantified |Atom| needs. Every phrase that reads the List asks for instances of a nonterminal or a production, so terminals' Parse Nodes are not listed." }
extern def $ParseTree { sig "(text: source text, goal: nonterminal) → Parse Node" meaning "the root Parse Node of a successful parse of text with goal and no early errors" }
extern def $PassedArguments { sig "PassedArguments(): a List of ECMAScript language values" meaning "The List of arguments that was passed to the running built-in function (<emu-xref href=\"#sec-built-in-function-objects\"></emu-xref>)." }
extern def $Pi
extern def $Prepend
extern def $Present
extern def $PrimaryTimeZoneId { sig "PrimaryTimeZoneId(_id_: a String): a String" meaning "The primary time zone identifier associated with the non-primary time zone identifier _id_: an available named time zone identifier that is not non-primary." }
extern def $PropertyCharSet { sig "PropertyCharSet(_p_: a List of code points or a String, _v_: a List of code points or a String): a CharSet" meaning "A new CharSet of the CharSetElements whose Unicode Character Database definition includes the property named _p_ with the value named _v_ (a property name or alias, a property value or value alias; *True* for a binary property). Each element is a sequence of characters, a one-character sequence being that character; no two are equal; elements of two or more characters occur only for the binary Unicode properties of strings (<emu-xref href=\"#table-binary-unicode-properties-of-strings\"></emu-xref>). A pair that names no property value is a sort error." }
extern def $PropertyIsKind { sig "PropertyIsKind(_p_: an own property, _kind_: ~data~ or ~accessor~): a Boolean" meaning "Whether _p_ is a _kind_ property: a data property or an accessor property (<emu-xref href=\"#sec-object-type\"></emu-xref>)." }
extern def $PropertyOrder { sig "PropertyOrder(_O_: an Object, _properties_: a List of Records): a List of Records" meaning "The order in which the host creates the specified properties _properties_ of _O_: a new List whose elements are those of _properties_, each once, in an order the host chooses. The specification fixes no order of a built-in object's property creation (<emu-xref href=\"#sec-createintrinsics\"></emu-xref>)." }
extern def $RangesOverlap { sig "(e: Shared Data Block event, f: Shared Data Block event) → Boolean" meaning "whether the memory ranges of e and f intersect" }
extern def $RealmIntrinsic { sig "RealmIntrinsic(_realm_: a Realm Record, _name_: a String): an Object" meaning "The intrinsic object named _name_ that _realm_.[[Intrinsics]] records: the field of _realm_.[[Intrinsics]] whose name is _name_, set when the realm was created (<emu-xref href=\"#sec-well-known-intrinsic-objects\"></emu-xref>). _name_ is the name with the enclosing % of one of the objects of IntrinsicObjects()." }
extern def $RecordFieldNames { sig "RecordFieldNames(_r_: a Record): a List of field names" meaning "A new List of the names of _r_'s fields (<emu-xref href=\"#sec-list-and-record-specification-type\"></emu-xref>). The specification defines no order of a Record's fields, so the List's order is fixed by the field names alone (ascending by their index in the field table), never by the model, and no step may depend on it." }
extern def $ReleaseCriticalSection { sig "ReleaseCriticalSection(_waiterList_: a WaiterList Record): ~unused~" meaning "The surrounding agent leaves the critical section for _waiterList_, which it is in (<emu-xref href=\"#sec-waiterlist-records\"></emu-xref>)." }
