sdo CompileCharacterClass { header (kind sdo params [slot 0 : #"RegExp Record"] -> record { [[CharSet]]: CharSet, [[Invert]]: Boolean }) }
sdo CompileToCharSet { header (kind sdo params [slot 0 : #"RegExp Record"] -> CharSet) }
sdo CompileClassSetString { header (kind sdo params [slot 0 : #"RegExp Record"] -> seq<character that sat @ph-character-of-pattern(v0)>) }
