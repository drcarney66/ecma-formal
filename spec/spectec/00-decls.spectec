syntax #"Shared Data Block event" defined { super [#"Memory event"] record true test none }
syntax #"WriteSharedMemory event" defined { super [#"Shared Data Block event"] record false test alg @sort-WriteSharedMemory-event }
syntax Undefined defined { super [] record false test alg @sort-Undefined }
syntax Null defined { super [] record false test alg @sort-Null }
syntax #"candidate execution Record" defined {}
syntax callable defined {}
syntax #"IteratorResult object" defined {}
syntax #"async iterator object" defined {}
syntax #"AsyncGeneratorRequest Record" defined {}
syntax #"host-defined exotic object" defined {}
syntax Set defined {}
syntax #"candidate execution Agent Events Record" defined {}
syntax #"host-specific event" defined {}
syntax events defined {}
syntax #"host-specific Memory events" defined {}
syntax event defined {}
syntax execution defined {}
syntax production defined {}
syntax indirect defined { super [] record false test alg @sort-indirect }
syntax #"Agent Record" defined { super [] record true test none }
syntax #"non-zero" defined { super [] record false test alg @sort-non-zero }

sdo #"Early Errors"
