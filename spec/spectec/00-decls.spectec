sdo IsCharacterClass { header (kind sdo params [] -> Boolean) }
sdo CharacterValue { header (kind sdo params [] -> sort [#"non-negative"] integer) }
sdo MayContainStrings { header (kind sdo params [] -> Boolean) }
sdo CapturingGroupName { header (kind sdo params [] -> String) }
