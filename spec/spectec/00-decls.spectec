sdo CompileAssertion { header (kind sdo params [slot 0 : #"RegExp Record"] -> Matcher) }
sdo CompileQuantifier { header (kind sdo params [] -> record { [[Min]]: sort [#"non-negative"] integer, [[Max]]: sort [#"non-negative"] integer | val(math(+∞)), [[Greedy]]: Boolean }) }
sdo CompileQuantifierPrefix { header (kind sdo params [] -> record { [[Min]]: sort [#"non-negative"] integer, [[Max]]: sort [#"non-negative"] integer | val(math(+∞)) }) }
