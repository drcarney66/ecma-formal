extern def $CanAllocate { sig "CanAllocate(_n_: a non-negative integer, _shared_: a Boolean): a Boolean" meaning "Whether it is possible to create a Data Block (if _shared_ is *true*, a Shared Data Block) consisting of _n_ bytes: the host's fact, which the specification does not constrain (<emu-xref href=\"#sec-createbytedatablock\"></emu-xref>, <emu-xref href=\"#sec-createsharedbytedatablock\"></emu-xref>)." }
extern def $BlockBytes { sig "(b: Data Block, i: integer, j: integer) → List of byte" meaning "the bytes of b at the indices from i to j, j excluded" }
extern def $WaiterListFor { sig "WaiterListFor(_block_: a Shared Data Block, _i_: a non-negative integer): a WaiterList Record" meaning "The WaiterList Record that the agent cluster's store of WaiterList Records holds for (_block_, _i_) (<emu-xref href=\"#sec-waiterlist-records\"></emu-xref>): the same Record for the same _block_ and _i_. Until its critical section is first entered, its [[Waiters]] is an empty List and its [[MostRecentLeaveEvent]] is ~empty~." }
extern def $AcquireCriticalSection { sig "AcquireCriticalSection(_waiterList_: a WaiterList Record): ~unused~" meaning "Waits until no agent is in the critical section for _waiterList_, then enters it, without allowing any other agent to enter (<emu-xref href=\"#sec-waiterlist-records\"></emu-xref>). With the surrounding agent the only agent, the wait ends at once unless the surrounding agent is in that critical section, when it never ends." }
extern def $Pair { sig "(a: value, b: value) → pair" meaning "the ordered pair of a and b" }
extern def $ReleaseCriticalSection { sig "ReleaseCriticalSection(_waiterList_: a WaiterList Record): ~unused~" meaning "The surrounding agent leaves the critical section for _waiterList_, which it is in (<emu-xref href=\"#sec-waiterlist-records\"></emu-xref>)." }
extern def $WakeAgent { sig "WakeAgent(_sig_: an agent signifier): ~unused~" meaning "Wakes the agent whose signifier is _sig_ from suspension (<emu-xref href=\"#sec-notifywaiter\"></emu-xref> step 2.a): its latest SuspendAgentUntil, if performed before this, ends, so that AgentWoken() is *true* for it and it resumes execution in SuspendThisAgent. It has no other effect." }
extern def $SpinWaitHint { sig "SpinWaitHint(): ~unused~" meaning "If the execution environment of the ECMAScript implementation supports signaling to the operating system or CPU that the current executing code is in a spin-wait loop, sends that signal (<emu-xref href=\"#sec-atomics.pause\"></emu-xref> step 1). It has no effect on ECMAScript state." }
extern def $IsJSONText { sig "IsJSONText(_cps_: a List of code points): a Boolean" meaning "Whether _cps_ is a valid JSON text as specified in ECMA-404: whether the sequence of code points _cps_ can be derived from |JSONText| above." }
extern def $Parent { sig "(n: Parse Node) → Parse Node" meaning "the Parse Node of which n is a child node" }
extern def $ChildNodes { sig "(n: Parse Node) → List of Parse Node" meaning "the child nodes of n, in order" }
extern def $InCodeUnitRanges { sig "(c: code unit, rs: List of code unit ranges) → Boolean" meaning "whether c is one of the listed code units or lies in one of the listed ranges" }
extern def $ContextBelowTop { sig "ContextBelowTop(): an execution context or ~empty~" meaning "The second to top element of the execution context stack, or ~empty~ if the stack has fewer than two elements (<emu-xref href=\"#sec-execution-contexts\"></emu-xref>)." }
extern def $SetDifference { sig "(a: Set, b: Set) → Set" meaning "the elements of a that are not elements of b" }
extern def $SomeIndex { sig "(lo: integer, hi: integer, p: integer → Boolean) → Boolean" meaning "whether p holds for some integer from lo to hi, hi excluded" }
extern def $RangesOverlap { sig "(e: Shared Data Block event, f: Shared Data Block event) → Boolean" meaning "whether the memory ranges of e and f intersect" }
extern def $InRace { sig "(e: Shared Data Block event, f: Shared Data Block event, x: candidate execution) → Boolean" meaning "whether e and f are in a race in x (29.9)" }
extern def $IsSingleCharacter { sig "(cs: CharSet) → Boolean" meaning "whether cs has exactly one element and it is a single character" }
extern def $ReplaceCodeUnit { sig "(s: String, c: code unit, r: String) → String" meaning "s with each occurrence of c replaced by r" }
extern def $UCDMember
extern def $NewSymbol
extern def $NaNEncoding { sig "NaNEncoding(_value_: *NaN*, _w_: a positive integer, _p_: a positive integer): a non-negative integer" meaning "The host's choice of an IEEE 754-2019 binary interchange format Not-a-Number encoding, with an exponent field of _w_ bits and a precision of _p_ bits, for _value_ (<emu-xref href=\"#sec-numerictorawbytes\"></emu-xref>): its exponent field is all ones and its trailing significand field is not zero. The same arguments always give the same encoding." }
extern def $MustCoverChild { sig "MustCoverChild(_node_: a Parse Node, _child_: a Parse Node): a Boolean" meaning "*true* if an early error rule associated with the production of which _node_ is an instance, whose conditions hold, states that _child_ must cover a nonterminal (<emu-xref href=\"#sec-static-semantic-rules\"></emu-xref>); otherwise *false*." }
extern def $ApproxInteger { sig "ApproxInteger(_x_: a mathematical value): an integer" meaning "An implementation-approximated integer representing _x_: the host's choice, as for an implementation-approximated Number value." }
extern def $TableRowValue { sig "TableRowValue(_t_: a table, _valueColumn_: a String, _key_: anything): anything" meaning "The entry in the column of _t_ headed _valueColumn_ of the row \"for _key_\": the row whose entry in _t_'s first column, which names its rows, is _key_ (TableLookup(_t_, _valueColumn_, the first column's heading, _key_)). An entry of several lines is _key_ if one of its lines is. _t_ has such a row." }
extern def $NewBindingsRecord { sig "NewBindingsRecord(_kind_: an Environment Record sort): an Environment Record" meaning "A new Environment Record of sort _kind_ with no fields and no bindings." }
extern def $HasBinding
extern def $BindingFor { sig "BindingFor(_env_: an Environment Record, _N_: a String): a binding Record" meaning "_env_'s binding for _N_. _env_ has one." }
extern def $AddBinding { sig "AddBinding(_env_: an Environment Record, _N_: a String, _b_: a binding Record): ~unused~" meaning "Makes _b_ _env_'s binding for _N_, after the bindings it has. _env_ has no binding for _N_." }
extern def $RemoveBinding { sig "RemoveBinding(_env_: an Environment Record, _N_: a String): ~unused~" meaning "_env_ no longer has a binding for _N_; its other bindings keep their order." }
extern def $BindingNames { sig "BindingNames(_env_: an Environment Record): a List of Strings" meaning "A new List of the names _env_ has bindings for, in the order they were added." }
extern def $StrictFromOutside { sig "StrictFromOutside(_node_: a Parse Node): a Boolean" meaning "Whether _node_ is in source text that is strict mode code from outside it (<emu-xref href=\"#sec-strict-mode-code\"></emu-xref>: eval code of a direct eval contained in strict mode code): the parser invocation that made _node_ was given that its source text is strict." }
extern def $ClosureArity { sig "ClosureArity(_c_: an Abstract Closure): a non-negative integer" meaning "The number of parameters of _c_, as the step that creates it lists them (<emu-xref href=\"#sec-abstract-closure\"></emu-xref>); 0 for an Abstract Closure \"with no parameters\"." }
extern def $RecordFieldNames { sig "RecordFieldNames(_r_: a Record): a List of field names" meaning "A new List of the names of _r_'s fields (<emu-xref href=\"#sec-list-and-record-specification-type\"></emu-xref>). The specification defines no order of a Record's fields, so the List's order is fixed by the field names alone (ascending by their index in the field table), never by the model, and no step may depend on it." }
extern def $HasParam { sig "HasParam(_node_: a Parse Node, _p_: a grammar parameter): a Boolean" meaning "Whether the grammar parameter _p_ was set when _node_ was parsed: the production of which _node_ is an instance was used with _p_ as a parameter (<emu-xref href=\"#sec-grammatical-parameters\"></emu-xref>)." }
extern def $GoalSymbolOf { sig "GoalSymbolOf(_node_: a Parse Node): a nonterminal" meaning "The goal symbol of the parse that produced _node_: the nonterminal of that parse's root (<emu-xref href=\"#sec-syntactic-grammar\"></emu-xref>)." }
extern def $InDirectEval { sig "InDirectEval(_node_: a Parse Node): a Boolean" meaning "Whether _node_ is in eval code being processed by a direct eval: the parser invocation that made _node_ was PerformEval's with _direct_ *true* (<emu-xref href=\"#sec-performeval\"></emu-xref>)." }
extern def $MathFn { sig "MathFn(_f_: a non-negative integer, _x_: a mathematical value): a mathematical value" meaning "The value at _x_ of the function that _f_ indexes among \"the ( cosine | sine | tangent | cube root | square root | exponential function | hyperbolic cosine | hyperbolic sine | hyperbolic tangent | inverse cosine | inverse sine | inverse tangent | inverse hyperbolic cosine | inverse hyperbolic sine | inverse hyperbolic tangent ) of _x_\", counted from 0. The steps call it only on the function's domain. The square root is exact (the model's square root); every step that uses another of the functions takes an implementation-approximated value of it, so those are opaque: no law states their values." }
extern def $BindingsHas { sig "BindingsHas(_env_: an Environment Record, _N_: a String): a Boolean" meaning "Whether _env_ has a binding for the name _N_." }
extern def $EvaluateBuiltin { sig "EvaluateBuiltin(_F_: a built-in function object, _thisArgument_: an ECMAScript language value or ~uninitialized~, _argumentsList_: a List of ECMAScript language values, _newTarget_: a constructor or *undefined*): a Completion Record" meaning "The Completion Record that is the result of evaluating _F_ in a manner that conforms to the specification of _F_ (<emu-xref href=\"#step-call-builtin-function-result\"></emu-xref>). If _thisArgument_ is ~uninitialized~, the *this* value is uninitialized; else _thisArgument_ provides the *this* value. _argumentsList_ provides the named parameters. _newTarget_ provides the NewTarget value." }
extern def $HostInitializeBuiltinContext { sig "HostInitializeBuiltinContext(_calleeContext_: an execution context): ~unused~" meaning "Any necessary implementation-defined initialization of _calleeContext_ (<emu-xref href=\"#sec-builtincallorconstruct\"></emu-xref> step 8)." }
extern def $IntrinsicObjects { sig "IntrinsicObjects(): a List of Records" meaning "The objects of <emu-xref href=\"#sec-createintrinsics\"></emu-xref> step 2, one new Record each, in an order in which each comes after the objects its [[Prototype]] names: the well-known intrinsic objects of <emu-xref href=\"#table-well-known-intrinsic-objects\"></emu-xref> and every object their properties hold, as clauses <emu-xref href=\"#sec-global-object\"></emu-xref> through <emu-xref href=\"#sec-reflection\"></emu-xref>, <emu-xref href=\"#sec-additional-built-in-properties\"></emu-xref>, <emu-xref href=\"#sec-%throwtypeerror%\"></emu-xref> and <emu-xref href=\"#sec-%foriniteratorprototype%-object\"></emu-xref> specify them. Each Record has the fields [[Index]] (its position in the List), [[Names]] (a List of the [[Intrinsics]] field names it is recorded under: its intrinsic names, with and without the enclosing %), [[Prototype]] (the position of its [[Prototype]], or *null*), [[Exotic]] (the clause defining its kind of exotic object, or ~empty~), [[Extensible]], [[Slots]] (a List of its specified internal slots' names), [[SlotValues]] (a List of Records with fields [[Name]] and [[Value]], the specified values of those slots), and [[Properties]] (a List of its properties' Records, as ClauseProperties gives them, in document order, with [[Object]], [[Get]] and [[Set]] the positions of objects in the List). A built-in function object's Record also has [[Behaviour]] (its algorithm steps, or the clause that gives its behaviour), [[Length]], [[Name]] (its *\"name\"* property's key), [[Prefix]] (*\"get\"*, *\"set\"*, or ~empty~), [[Constructor]], [[Async]] (whether it is described as async), [[LengthAttributes]] and [[NameAttributes]] (Records with fields [[Writable]], [[Enumerable]] and [[Configurable]]); for any other object [[Behaviour]] is ~empty~." }
extern def $PropertyOrder { sig "PropertyOrder(_O_: an Object, _properties_: a List of Records): a List of Records" meaning "The order in which the host creates the specified properties _properties_ of _O_: a new List whose elements are those of _properties_, each once, in an order the host chooses. The specification fixes no order of a built-in object's property creation (<emu-xref href=\"#sec-createintrinsics\"></emu-xref>)." }
extern def $OmitSharedArrayBuffer { sig "OmitSharedArrayBuffer(): a Boolean" meaning "Whether the host omits the *\"SharedArrayBuffer\"* property of the global object (<emu-xref href=\"#sec-sharedarraybuffer-constructor\"></emu-xref>). It is a fact of the host: every call gives the same answer." }
extern def $ListSeparator
extern def $AdditionalTimeout { sig "AdditionalTimeout(): a non-negative mathematical value" meaning "An implementation-defined non-negative mathematical value added to a waiter's timeout (<emu-xref href=\"#sec-dowait\"></emu-xref> step 23)." }
extern def $TimeZoneNameSuffix { sig "TimeZoneNameSuffix(_tv_: a time value): a String" meaning "An implementation-defined String for the time zone name at _tv_: either the empty String or the string-concatenation of the code unit 0x0020 (SPACE), the code unit 0x0028 (LEFT PARENTHESIS), an implementation-defined time zone name, and the code unit 0x0029 (RIGHT PARENTHESIS) (<emu-xref href=\"#sec-timezoneestring\"></emu-xref> step 9)." }
extern def $SystemTimeZoneString { sig "SystemTimeZoneString(): a String" meaning "The String representing the host environment's current time zone, either a primary time zone identifier or an offset time zone identifier (<emu-xref href=\"#sec-systemtimezoneidentifier\"></emu-xref> step 2)." }
extern def $TimeNow { sig "TimeNow(): a time value" meaning "The time value (UTC) identifying the current time: a finite integral Number from -8.64 × 10<sup>15</sup> to 8.64 × 10<sup>15</sup> (<emu-xref href=\"#sec-time-values-and-time-range\"></emu-xref>)." }
extern def $HostGlobalObject { sig "HostGlobalObject(_realm_: a Realm Record): an Object or ~empty~" meaning "If the host requires use of a specific object to serve as _realm_'s global object, that object, created in a host-defined manner; otherwise ~empty~ (<emu-xref href=\"#sec-initializehostdefinedrealm\"></emu-xref> steps 11 and 12)." }
extern def $HostThisValue { sig "HostThisValue(_realm_: a Realm Record): an Object or ~empty~" meaning "If the host requires that the `this` binding in _realm_'s global scope return an object other than the global object, that object, created in a host-defined manner; otherwise ~empty~ (<emu-xref href=\"#sec-initializehostdefinedrealm\"></emu-xref> steps 13 and 14)." }
extern def $HostGlobalProperties { sig "HostGlobalProperties(_realm_: a Realm Record, _global_: an Object): ~unused~" meaning "Creates any host-defined global object properties on _global_ (<emu-xref href=\"#sec-initializehostdefinedrealm\"></emu-xref> step 18). It changes no existing value but _global_'s own properties; it may create new values for them." }
extern def $HostReportCleanupError { sig "HostReportCleanupError(_completion_: an abrupt completion): ~unused~" meaning "Any host-defined steps for reporting the error of _completion_ (<emu-xref href=\"#sec-host-cleanup-finalization-registry\"></emu-xref> step 2)." }
extern def $MayCleanup { sig "MayCleanup(_finalizationRegistry_: a FinalizationRegistry): a Record or ~empty~" meaning "The implementation's choice at <emu-xref href=\"#sec-cleanup-finalization-registry\"></emu-xref> step 3: ~empty~ if it performs the steps no more, else any Record _cell_ that _finalizationRegistry_.[[Cells]] contains such that _cell_.[[WeakRefTarget]] is ~empty~ (step 3.a's choice). It is ~empty~ when there is no such Record. It has no effect on ECMAScript state." }
extern def $DebuggerEnabled { sig "DebuggerEnabled(): a Boolean" meaning "Whether an implementation-defined debugging facility is available and enabled. A host whose answer is *true* runs DebuggerAction, which the invariants of the essential internal methods bound (<emu-xref href=\"#sec-invariants-of-the-essential-internal-methods\"></emu-xref>)." }
extern def $DebuggerAction { sig "DebuggerAction(): ~unused~" meaning "An implementation-defined debugging action. An implementation must not allow the invariants of the essential internal methods to be circumvented in any manner (<emu-xref href=\"#sec-invariants-of-the-essential-internal-methods\"></emu-xref>), and the model reads this as: every object stays an object and keeps its internal slots but [[Extensible]] and [[Prototype]]; its [[Extensible]] only turns from *true* to *false*; an object whose [[Extensible]] is not *true* keeps its [[Prototype]] and gains no property; and a non-configurable property stays, its attributes changing only as the invariants of [[GetOwnProperty]] allow." }
extern def $NativeFunctionSource { sig "NativeFunctionSource(_func_: a function object): a String" meaning "An implementation-defined String source code representation of _func_. The representation must have the syntax of a |NativeFunction|. If _func_ has an [[InitialName]] internal slot, _func_.[[InitialName]] is a String, and _func_.[[InitialName]] is matched by |NativeFunctionAccessor?| |PropertyName|, the portion of the returned String that would be matched by |NativeFunctionAccessor?| |PropertyName| must be _func_.[[InitialName]]; a String is so matched when it is *\"get\"* or *\"set\"* (the portion is the name whether it is read as the |NativeFunctionAccessor| or as the |PropertyName|), or when the |NativeFunction| that follows `function ` with it has it as that portion. If _func_.[[InitialName]] is the empty String, the returned String has neither a |NativeFunctionAccessor| nor a |PropertyName|, so that its portion is empty (<emu-xref href=\"#erratum-NativeFunctionInitialName\"></emu-xref>). The returned String is the string-concatenation of *\"function \"*, a name, and *\"() { [native code] }\"*, where the name is the empty String or, after *\"get \"*, *\"set \"* or nothing, an ASCII |IdentifierName| without escapes or *\"[Symbol.\"*, one, and *\"]\"*; its portion matched by |NativeFunctionAccessor?| |PropertyName| is the name. This is narrower than the syntax of a |NativeFunction|, which also admits white space, line terminators and comments between its tokens and non-ASCII or escaped names: a host whose representation is one of those does not meet this law, and an [[InitialName]] that is matched but is not such a name has no String this law admits (a choice of the model, not a reading of the text: decisions.md, <code>nativefunctionsource-form</code>)." }
extern def $EnteredCriticalSections { sig "EnteredCriticalSections(): a List of WaiterList Records" meaning "A new List of the WaiterList Records whose critical section the surrounding agent is in (<emu-xref href=\"#sec-waiterlist-records\"></emu-xref>), in an order that uses must not depend on." }
extern def $SortStep { sig "SortStep(_n_: a non-negative integer, _state_: anything, _result_: anything): a List or a Record" meaning "The host's next step in sorting _n_ elements, from its own state _state_ and the Number _result_ that the call it last asked for returned; at the start both are ~empty~. The step is either a List « _j_, _k_, _next_ »: the next call to make, on the elements at indices _j_ and _k_ less than _n_, and the state _next_ the host is given back with that call's result; or a Record whose [[Value]] is the order: a List of the indices less than _n_, each once, the index of each element in the order it is to have. If some consistent comparator for the elements gives the result of every call the sort made, the order meets the conditions after SortIndexedProperties for each such comparator. A host makes only finitely many calls, whatever their results." }
extern def $EscapePattern { sig "EscapePattern(_pattern_: a String, _flags_: a String): a String" meaning "A String in the form of the |Pattern| that _flags_ selects, equivalent to _pattern_ interpreted as UTF-16 encoded Unicode code points, in which certain code points are escaped. The Abstract Closure that would result from evaluating it as that |Pattern| must behave identically to the one _pattern_ gives, and the string-concatenation of *\"/\"*, it, *\"/\"*, and _flags_ must be parsable as a |RegularExpressionLiteral| whose body it is. It is a function of _pattern_ and _flags_: multiple calls with the same values produce identical results." }
extern def $ForInStep { sig "ForInStep(_obj_: an Object, _history_: a List of Records): a Record" meaning "The host's next action in enumerating the properties of _obj_, given _history_, a Record { [[Action]], [[Result]] } for each action so far, in order: the action and the result of the internal method call it made, or ~empty~ for a key it returned. The action is a new Record { [[Kind]], [[Object]], [[Key]] }: [[Kind]] is ~own-property-keys~ (call [[OwnPropertyKeys]] of [[Object]]), ~get-own-property~ (call [[GetOwnProperty]] of [[Object]] with [[Key]]), ~get-prototype-of~ (call [[GetPrototypeOf]] of [[Object]]), ~yield~ (return the String [[Key]]) or ~done~ (the enumeration is over); fields an action does not use are ~empty~. The actions conform to the rules of EnumerateObjectProperties." }
extern def $TerminalAlternatives { sig "TerminalAlternatives(_nt_: a nonterminal): a List of Strings" meaning "A new List of the String values of the code points of each terminal that is a right-hand side of _nt_, whose right-hand sides are each one terminal written in a fixed-width font (<emu-xref href=\"#sec-grammar-notation\"></emu-xref>), in the order the grammar lists them." }
extern def $SetFieldNamed { sig "SetFieldNamed(_r_: a Record or an Object, _f_: a field name, _v_: anything): ~unused~" meaning "Sets _r_'s field, or _r_'s internal slot, named _f_ to _v_." }
extern def $HostSupportsOptional { sig "HostSupportsOptional(_c_: a clause): a Boolean" meaning "Whether a host that is not a web browser provides the normative optional feature that clause _c_ specifies. It is a fact of the host: every call with the same _c_ gives the same answer." }
extern def $IsIntrinsicName { sig "IsIntrinsicName(_n_: a String): a Boolean" meaning "Whether _n_ is this specification's name of an intrinsic object (<emu-xref href=\"#sec-well-known-intrinsic-objects\"></emu-xref>): a name listed in the “Intrinsic Name” column of <emu-xref href=\"#table-well-known-intrinsic-objects\"></emu-xref>, or such a name with the enclosing % around it extended by one or more parts *\".\"* _k_, each _k_ the key of a property, specified for the object the name before it names, whose value (an accessor property's: its getter's result, as if accessed before any code is evaluated) is an object." }
extern def $TableAssociated { sig "TableAssociated(_t_: a table, _key_: anything): anything" meaning "The value associated with _key_ in _t_, a step's table of two columns (\"the abstract operation associated with _key_ in the following table\"): the entry in the second column of the row whose entry in the first column is _key_. A sequence of Unicode code points _key_ is the entry written in code as those code points. _t_ has such a row." }
extern def $WellKnownSymbol { sig "WellKnownSymbol(_d_: a String): a Symbol" meaning "The well-known symbol whose [[Description]] is _d_ (<emu-xref href=\"#sec-well-known-symbols\"></emu-xref>, <emu-xref href=\"#table-well-known-symbols\"></emu-xref>): the value the specification names %_d_%. It is the same value in every realm." }
extern def $DesignateShared { sig "DesignateShared(_block_: a Data Block): a Shared Data Block" meaning "_block_, a Data Block that no value refers to yet, designated a Shared Data Block (<emu-xref href=\"#sec-data-blocks\"></emu-xref>): from then on it is a Shared Data Block, with the same bytes." }
extern def $LocaleUppercase { sig "LocaleUppercase(_cps_: a List of code points): a List of code points" meaning "A new List of the code points of _cps_ mapped to upper case by the conventions of the host environment's current locale (<emu-xref href=\"#sec-string.prototype.tolocaleuppercase\"></emu-xref>): toUppercase(_cps_), except in the few cases (such as Turkish) where the rules for that language conflict with the regular Unicode case mappings." }
extern def $LocaleLowercase { sig "LocaleLowercase(_cps_: a List of code points): a List of code points" meaning "A new List of the code points of _cps_ mapped to lower case by the conventions of the host environment's current locale (<emu-xref href=\"#sec-string.prototype.tolocalelowercase\"></emu-xref>): toLowercase(_cps_), except in the few cases (such as Turkish) where the rules for that language conflict with the regular Unicode case mappings." }
extern def $LocaleCompare { sig "LocaleCompare(_string_: a String, _thatValue_: a String): a Number" meaning "The result, other than *NaN*, of an implementation-defined locale-sensitive comparison of _string_ with _thatValue_ (<emu-xref href=\"#sec-string.prototype.localecompare\"></emu-xref>): negative when _string_ is ordered before _thatValue_, positive when it is ordered after, and zero otherwise, by an ordering of all Strings that every call follows (a consistent comparator defining a total ordering); *+0*<sub>𝔽</sub> when the two are canonically equivalent according to the Unicode Standard. It has no effect on ECMAScript state." }
extern def $LocaleNumberString { sig "LocaleNumberString(_x_: a Number or a BigInt): a String or ~empty~" meaning "A String that represents _x_ formatted according to the conventions of the host environment's current locale, or ~empty~ where the host returns the same thing as `toString` (<emu-xref href=\"#sec-number.prototype.tolocalestring\"></emu-xref>, <emu-xref href=\"#sec-bigint.prototype.tolocalestring\"></emu-xref>). It has no effect on ECMAScript state." }
extern def $CanonicalPropertyValue { sig "CanonicalPropertyValue(_p_: a List of code points or a String, _v_: a List of code points or a String): a List of code points" meaning "A new List of the code points of the canonical property value of _v_ for the Unicode property named _p_: the long name of the row of PropertyValueAliases.txt for _p_ that lists _v_. A pair for which IsPropertyValueAlias(_p_, _v_) is *false* is a sort error." }
extern def $LocaleDateString { sig "LocaleDateString(_portion_: a portion (~date~, ~time~ or ~all~), _thisValue_: an ECMAScript language value): a String, ~empty~ or ~throw~" meaning "A String that represents the “date” portion (~date~), the “time” portion (~time~) or the whole (~all~) of the Date _thisValue_ in the current time zone in a convenient, human-readable form that corresponds to the conventions of the host environment's current locale, or ~empty~ where the host returns the form `toDateString`, `toTimeString` or `toString` returns (<emu-xref href=\"#sec-date.prototype.tolocaledatestring\"></emu-xref>, <emu-xref href=\"#sec-date.prototype.tolocaletimestring\"></emu-xref>, <emu-xref href=\"#sec-date.prototype.tolocalestring\"></emu-xref>). These methods are not generic: their *this* value \"must be an object that has a [[DateValue]] internal slot\" (<emu-xref href=\"#sec-properties-of-the-date-prototype-object\"></emu-xref>), and the text gives no consequence for any other value, for which the host gives a String or ~throw~ (a *TypeError*, as every algorithmic Date method throws); ~empty~ only for an object with a [[DateValue]] internal slot. It has no effect on ECMAScript state." }
extern def $SuspendAgentUntil { sig "SuspendAgentUntil(_waiterList_: a WaiterList Record, _timeoutTime_: an extended mathematical value): ~unused~" meaning "Suspends the surrounding agent until the time is _timeoutTime_, or until another agent performs NotifyWaiter(_waiterList_, _w_) for a Waiter Record _w_ whose [[AgentSignifier]] is the surrounding agent's signifier (via a call to `Atomics.notify`), whichever comes first (<emu-xref href=\"#sec-suspendthisagent\"></emu-xref> step 7). The suspension takes effect together with the LeaveCriticalSection(_waiterList_) performed just before it, in such a way that a notification that arrives after the critical section is exited but before the suspension takes effect is not lost. With the surrounding agent the only agent, it wakes only by the timeout, so never where _timeoutTime_ is +∞." }
extern def $InstancesOf
extern def $ExpandedYearForm { sig "ExpandedYearForm(_tv_: a finite time value): a Boolean" meaning "Whether the host writes the year of _tv_, one from 0 to 9999, as an expanded year (<emu-xref href=\"#sec-expanded-years\"></emu-xref>) in the String toISOString returns: `YYYY` is \"four decimal digits from 0000 to 9999, or as an expanded year\" (<emu-xref href=\"#sec-date-time-string-format\"></emu-xref>), and toISOString's step 7 does not say which. A year outside that interval is always expanded. It has no effect on ECMAScript state." }
extern def $HostExtendIntrinsics { sig "HostExtendIntrinsics(_realm_: a Realm Record): ~unused~" meaning "Provides any properties not described in this specification, and values for them, for _realm_'s intrinsics, the objects its [[Intrinsics]] holds and the objects their properties hold (<emu-xref href=\"#sec-conformance\"></emu-xref>, <emu-xref href=\"#sec-hosts-and-implementations\"></emu-xref>): it only adds own properties to those objects, and may create new values for them; it changes no internal slot, no existing property and no other value, adds no own property to an object whose [[Extensible]] is not *true* (<emu-xref href=\"#sec-invariants-of-the-essential-internal-methods\"></emu-xref>), and adds no own property that <emu-xref href=\"#sec-forbidden-extensions\"></emu-xref> forbids (*\"caller\"* or *\"arguments\"* on a function object)." }
extern def $HostExtendObject { sig "HostExtendObject(_o_: an Object): ~unused~" meaning "Provides any properties not described in this specification, and values for them, for the object _o_ that the specification's steps have just created (<emu-xref href=\"#sec-conformance\"></emu-xref>): it only adds own properties to _o_, and may create new values for them; it changes no internal slot, no existing property and no other value, adds no own property if _o_.[[Extensible]] is not *true* (<emu-xref href=\"#sec-invariants-of-the-essential-internal-methods\"></emu-xref>), and adds no own property that <emu-xref href=\"#sec-forbidden-extensions\"></emu-xref> forbids." }
extern def $OnContextStack { sig "OnContextStack(_ctx_: an execution context): a Boolean" meaning "Whether _ctx_ is an element of the execution context stack (<emu-xref href=\"#sec-execution-contexts\"></emu-xref>)." }
extern def $HostJobCallbackData { sig "HostJobCallbackData(_callback_: a function object): anything" meaning "The host's [[HostDefined]] value of the JobCallback Record HostMakeJobCallback makes for _callback_ (<emu-xref href=\"#sec-hostmakejobcallback\"></emu-xref>): ~empty~ in the default implementation. It changes only the heap, each object as <emu-xref href=\"#sec-invariants-of-the-essential-internal-methods\"></emu-xref> allows; it may create new values." }
extern def $HostPrepareCallJobCallback { sig "HostPrepareCallJobCallback(_jobCallback_: a JobCallback Record): ~unused~" meaning "The host's steps before HostCallJobCallback calls _jobCallback_.[[Callback]] (<emu-xref href=\"#sec-hostcalljobcallback\"></emu-xref>; HTML's preparation to run a callback): none in the default implementation. They change only the heap, the execution context stack and the suspended context, each object as <emu-xref href=\"#sec-invariants-of-the-essential-internal-methods\"></emu-xref> allows." }
extern def $HostCleanupCallJobCallback { sig "HostCleanupCallJobCallback(_jobCallback_: a JobCallback Record): ~unused~" meaning "The host's steps after HostCallJobCallback's call of _jobCallback_.[[Callback]] returns (<emu-xref href=\"#sec-hostcalljobcallback\"></emu-xref>; HTML's clean-up after running a callback): none in the default implementation. They change only the heap, the execution context stack and the suspended context, each object as <emu-xref href=\"#sec-invariants-of-the-essential-internal-methods\"></emu-xref> allows." }
extern def $ReplacedSourceText { sig "ReplacedSourceText(_node_: a Parse Node, _replacement_: a String): a sequence of Unicode code points" meaning "A new sequence of the code points of the source text that the root Parse Node of the parser invocation that made _node_ matched (the white space and comments before its first and after its last input element left out, which give no Early Errors), with the source text that _node_ matched replaced by the code points of _replacement_ (<emu-xref href=\"#sec-stringtocodepoints\"></emu-xref>). The source text of a cover's reparse is the source text the covering node matched, in the source text of the invocation that made the covering node, and so on through every cover (<emu-xref href=\"#sec-static-semantic-rules\"></emu-xref>); the |IfStatement| a node of <emu-xref href=\"#sec-functiondeclarations-in-ifstatement-statement-clauses\"></emu-xref>'s productions is processed as matched that node's source text with a `{` before and a `}` after each |FunctionDeclaration| child, and a point of its source text is the point of the node's source text it stands at, the braces left out." }
extern def $SwitchToAgent { sig "SwitchToAgent(_agent_: an Agent Record): ~unused~" meaning "Saves the execution context stack in the surrounding agent's Agent Record's [[ParkedStack]], makes _agent_.[[ParkedStack]] the execution context stack and _agent_ the surrounding agent. The execution context that was running before is the one whose evaluation a following Resume suspends. _agent_ is not the surrounding agent, and the surrounding agent is in no critical section." }
extern def $HostSelectAgent { sig "HostSelectAgent(_agent_: an Agent Record, _n_: a non-negative integer): an Agent Record or ~empty~" meaning "The host's choice of the agent of _agent_'s agent cluster that runs next, after _agent_ has added _n_ events to its [[EventList]]: an agent other than _agent_ that is not suspended or has been woken, or ~empty~ if the host lets _agent_ continue (<emu-xref href=\"#sec-forward-progress\"></emu-xref>)." }
extern def $AgentTimeout { sig "AgentTimeout(): a non-negative integer" meaning "The time the host advances the agent cluster's clock to while no other agent can run and the surrounding agent is suspended: the earliest time at which a suspended agent wakes, never before the present time." }
extern def $AgentWoken { sig "AgentWoken(): a Boolean" meaning "Whether the surrounding agent, suspended by its latest SuspendAgentUntil(_waiterList_, _timeoutTime_), has been woken: by a WakeAgent of its signifier performed after it, or by the time reaching _timeoutTime_." }
extern def $SetEvaluationSteps { sig "SetEvaluationSteps(_node_: a Parse Node, _steps_: an Abstract Closure): ~unused~" meaning "From now on, _steps_ are the steps performed when _node_ is evaluated, in place of its Evaluation algorithm, until the next SetEvaluationSteps of _node_ (<emu-xref href=\"#sec-block-level-function-declarations-web-legacy-compatibility-semantics\"></emu-xref>)." }
extern def $EvaluationStepsOf { sig "EvaluationStepsOf(_node_: a Parse Node): an Abstract Closure or ~empty~" meaning "The _steps_ of the last SetEvaluationSteps(_node_, _steps_), or ~empty~ when there was none." }
extern def $ChooseReadsBytesFrom { sig "ChooseReadsBytesFrom(_execution_: a candidate execution, _eventsRecord_: an Agent Events Record, _block_: a Shared Data Block, _byteIndex_: a non-negative integer, _elementSize_: a non-negative integer): a List of either WriteSharedMemory or ReadModifyWriteSharedMemory events" meaning "The host's choice of reads-bytes-from (<emu-xref href=\"#sec-reads-bytes-from\"></emu-xref>) for a read of _elementSize_ bytes of _block_ from _byteIndex_ that the surrounding agent appends next to _eventsRecord_.[[EventList]]: a new List of _elementSize_ events of the [[EventList]]s of _execution_.[[EventsRecords]], the one at index _i_ a WriteSharedMemory or ReadModifyWriteSharedMemory event whose [[Block]] is _block_ and whose memory range contains _byteIndex_ + _i_, such that _execution_ with the read has a valid execution in which the read reads those bytes from them (<emu-xref href=\"#sec-valid-executions\"></emu-xref>)." }
extern def $AgentNextJob { sig "AgentNextJob(): a non-negative integer or ~empty~" meaning "The host's next job for the surrounding agent (<emu-xref href=\"#sec-jobs\"></emu-xref>): the scheduling of a Job of this agent, ready to be performed now, that has not been taken, else ~empty~. The scheduling is identified by an integer the host gives; taking it is taking that Job." }
extern def $AgentPrepareJob { sig "AgentPrepareJob(_k_: a non-negative integer): a Job Abstract Closure" meaning "Performs the host-defined preparation steps of the Job the scheduling _k_ scheduled, with the execution context stack empty, and returns that Job." }
extern def $AgentCleanupJob { sig "AgentCleanupJob(_k_: a non-negative integer): ~unused~" meaning "Performs the host-defined cleanup steps of the Job the scheduling _k_ scheduled; the execution context stack is then empty." }
extern def $ToStringDigits
extern def $ChooseExpDigits
extern def $YearFromTimeOf
extern def $FirstDayOf
extern def $ApproxPower { sig "ApproxPower(_base_: a Number, _exponent_: a Number): a Number" meaning "An implementation-approximated Number value representing the result of raising ℝ(_base_) to the ℝ(_exponent_) power: the host's choice, as for an implementation-approximated Number value (<emu-xref href=\"#sec-numeric-types-number-exponentiate\"></emu-xref> step 13). The step calls it with finite Numbers other than *+0*<sub>𝔽</sub> and *-0*<sub>𝔽</sub>, _base_ positive or _exponent_ integral." }
extern def $BigIntTooLarge { sig "BigIntTooLarge(_operation_: a String, _x_: a BigInt, _y_: a BigInt): a Boolean" meaning "Whether the BigInt that the BigInt type's numeric method named _operation_ (*\"exponentiate\"*, *\"leftShift\"* or *\"multiply\"*) returns for _x_ and _y_ would exceed the implementation's maximum BigInt size: the host's choice. The specification sets no maximum (<emu-xref href=\"#sec-ecmascript-language-types-bigint-type\"></emu-xref>: \"The value may be any size and is not limited to a particular bit-width\"); the proposed reading of erratum BigIntMaximumSize asks it." }
extern def $HasUseStrictDirective { sig "HasUseStrictDirective(_body_: a |FunctionBody| or |ScriptBody| Parse Node): a Boolean" meaning "Whether the Directive Prologue of _body_ contains a Use Strict Directive (<emu-xref href=\"#sec-directive-prologues-and-the-use-strict-directive\"></emu-xref>): the Directive Prologue is the longest initial sequence of the |StatementListItem|s of _body_ that are an |ExpressionStatement| whose |Expression| is one |StringLiteral| token, and a Use Strict Directive is one whose |StringLiteral| is exactly the code points `\"use strict\"` or `'use strict'`." }
extern def $StrictModeCode { sig "StrictModeCode(_node_: a Parse Node): a Boolean" meaning "Whether the source text matched by _node_ is strict mode code (<emu-xref href=\"#sec-strict-mode-code\"></emu-xref>), by the code it is part of (<emu-xref href=\"#sec-types-of-source-code\"></emu-xref>): strict from outside when the parser invocation that made _node_ was given that its source text is strict (StrictFromOutside); else by the tree _node_ is in, through every cover a parse of it is a reparse of. Module code and all parts of a |ClassDeclaration| or |ClassExpression| are strict mode code; global code and eval code when the |Script|'s Directive Prologue contains a Use Strict Directive; function code when the function form's body does, or the code containing the form is strict mode code; and the body of a function that CreateDynamicFunction parses on its own when its Directive Prologue does. A function form's own Parse Node, and a method's |ClassElementName|, are part of the code containing the form." }
extern def $NewDataBlock { sig "NewDataBlock(_n_: a non-negative integer): a Data Block" meaning "A new Data Block of _n_ bytes, each 0 (<emu-xref href=\"#sec-data-blocks\"></emu-xref>): a new Data Block cell of the store holding the model's _n_ zero bytes (`bytesZero`)." }
extern def $SetAllBytes { sig "SetAllBytes(_block_: a Data Block, _v_: a byte value): ~unused~" meaning "Sets every byte of _block_ to _v_: its Data Block cell of the store has every byte set to _v_ (`bytesFill`), preserving its length." }
extern def $StringRepeat { sig "StringRepeat(_s_: a String, _n_: a non-negative integer): a String" meaning "The String value that is made from _n_ copies of _s_ appended together: the string-concatenation of _n_ copies of _s_, the empty String for _n_ = 0 (<emu-xref href=\"#sec-ecmascript-language-types-string-type\"></emu-xref>)." }
extern def $ParseNodesWithin { sig "ParseNodesWithin(_node_: a Parse Node): a List of Parse Nodes" meaning "A new List of _node_ and the Parse Nodes of nonterminals that it contains, in source text order with a node before its children (the model's descendants of _node_, after _node_); « _node_ » for a terminal's Parse Node. The Parse Nodes contained within _node_ include _node_: CountLeftCapturingParensWithin(|Atom|) of an |Atom| that is itself a left-capturing parenthesis counts it, as RepeatMatcher's clearing of the captures of the quantified |Atom| needs. Every phrase that reads the List asks for instances of a nonterminal or a production, so terminals' Parse Nodes are not listed." }
extern def $ListFindOf { sig "ListFindOf(_t_: a type, _f_: a field name, _l_: a List, _v_: anything): anything" meaning "ListFind(_f_, _l_, _v_) among the elements of _l_ of the Record sort _t_: the element of _l_ that is a _t_ and whose _f_ field is _v_. Exactly one element of _l_ is a _t_ with an _f_ field whose value is _v_." }
extern def $NumberDigitsExponent { sig "NumberDigitsExponent(_x_: a Number, _radix_: an integer): an integer" meaning "The _n_ of the integers _n_, _k_ and _s_ that Number::toString's step <emu-xref href=\"#step-number-tostring-intermediate-values\"></emu-xref> lets be such that _k_ ≥ 1, _radix_<sup>_k_ - 1</sup> ≤ _s_ &lt; _radix_<sup>_k_</sup>, 𝔽(_s_ × _radix_<sup>_n_ - _k_</sup>) is _x_, and _k_ is as small as possible, for a finite Number _x_ > *+0*<sub>𝔽</sub> and _radix_ in the inclusive interval from 2 to 36. The three integers are the implementation's function of _x_ and _radix_: where the condition leaves the least significant digit of _s_ open, the implementation's choice, the same at every call." }
extern def $NumberDigitsCount { sig "NumberDigitsCount(_x_: a Number, _radix_: an integer): a positive integer" meaning "The _k_ of the same three integers as NumberDigitsExponent(_x_, _radix_): the number of digits of _s_." }
extern def $NumberDigitsSignificand { sig "NumberDigitsSignificand(_x_: a Number, _radix_: an integer): a positive integer" meaning "The _s_ of the same three integers as NumberDigitsExponent(_x_, _radix_)." }
extern def $DecimalExponent { sig "DecimalExponent(_x_: a mathematical value): an integer" meaning "The integer _e_ such that 10<sup>_e_</sup> ≤ _x_ &lt; 10<sup>_e_ + 1</sup>, for _x_ > 0: the place of the first significant digit of the decimal representation of _x_ (the units digit's is 0)." }
extern def $EmptyCharSet { sig "EmptyCharSet(): a CharSet" meaning "A new empty CharSet." }
extern def $CharSetInterval { sig "CharSetInterval(_i_: a non-negative integer, _j_: a non-negative integer): a CharSet" meaning "A new CharSet containing all characters whose character value is in the inclusive interval from _i_ to _j_." }
extern def $CharSetMinus { sig "CharSetMinus(_a_: a CharSet, _b_: a CharSet): a CharSet" meaning "A new CharSet containing the CharSetElements of _a_ that are not also CharSetElements of _b_." }
extern def $CharSetAllSingle { sig "CharSetAllSingle(_cs_: a CharSet): a Boolean" meaning "Whether every CharSetElement of _cs_ consists of a single character." }
extern def $CharSetSingles { sig "CharSetSingles(_cs_: a CharSet): a CharSet" meaning "A new CharSet containing every CharSetElement of _cs_ that consists of a single character." }
extern def $CharSetNoScf { sig "CharSetNoScf(): a CharSet" meaning "A new CharSet containing all Unicode code points _c_ that do not have a Simple Case Folding mapping (scf(_c_) = _c_)." }
extern def $CharSetCanonExtra { sig "CharSetCanonExtra(_cs_: a CharSet, _u_: a Boolean): a CharSet" meaning "A new CharSet containing the characters _c_ not in _cs_ whose case-folded Canonicalize(_c_, _u_) is in _cs_." }
extern def $CharSetHasCanonical { sig "CharSetHasCanonical(_cs_: a CharSet, _cc_: a character, _u_: a Boolean, _ic_: a Boolean): a Boolean" meaning "Whether _cs_ contains a single-character CharSetElement _a_ whose Canonicalize(_a_, _u_, _ic_) is _cc_." }
extern def $IsCharSet { sig "IsCharSet(_v_: anything): a Boolean" meaning "Whether _v_ is a CharSet (<emu-xref href=\"#sec-pattern-notation\"></emu-xref>)." }
extern def $IntToRadix { sig "IntToRadix(_n_: a non-negative integer, _radix_: an integer): a String" meaning "The representation of _n_ using radix _radix_ in positional notation without leading zeroes, with digits from the first _radix_ code units of *\"0123456789abcdefghijklmnopqrstuvwxyz\"*, for _n_ ≥ 0 and _radix_ in the inclusive interval from 2 to 36." }
extern def $StringTooLarge { sig "StringTooLarge(_len_: a non-negative integer): a Boolean" meaning "Host-defined (under erratum StringMaximumLength): whether a String of length _len_ exceeds the implementation's maximum String length (at most 2<sup>53</sup> - 1; <emu-xref href=\"#sec-ecmascript-language-types-string-type\"></emu-xref>)." }

