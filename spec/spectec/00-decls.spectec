extern def $OwnPropertyCreate { sig "OwnPropertyCreate(_O_: an Object, _P_: a property key, _Desc_: a Property Descriptor, _kind_: ~accessor~ or ~data~): ~unused~" meaning "Adds to _O_ an own _kind_ property with key _P_, last in property creation order, each of whose attributes is the corresponding field of _Desc_ if _Desc_ has that field, or else the attribute's default value (<emu-xref href=\"#table-object-property-attributes\"></emu-xref>). _O_ has no own property with key _P_." }
extern def $OwnPropertyHas { sig "OwnPropertyHas(_O_: an Object, _P_: a property key): a Boolean" meaning "Whether _O_ has an own property whose key is _P_." }
extern def $OwnPropertyLookup { sig "OwnPropertyLookup(_O_: an Object, _P_: a property key): an own property" meaning "The own property of _O_ whose key is _P_. _O_ has such a property." }
extern def $OwnPropertyRemove { sig "OwnPropertyRemove(_O_: an Object, _P_: a property key): ~unused~" meaning "Removes _O_'s own property with key _P_; the other properties keep their creation order." }
extern def $OwnPropertyReplace { sig "OwnPropertyReplace(_O_: an Object, _P_: a property key, _Desc_: a Property Descriptor, _kind_: ~accessor~ or ~data~, _configurable_: a Boolean, _enumerable_: a Boolean): ~unused~" meaning "Replaces _O_'s own property with key _P_, in place in property creation order, by a _kind_ property whose [[Configurable]] and [[Enumerable]] attributes are _configurable_ and _enumerable_ and each of whose other attributes is the corresponding field of _Desc_ if _Desc_ has that field, or else the attribute's default value." }
extern def $OwnPropertySetAttribute { sig "OwnPropertySetAttribute(_O_: an Object, _P_: a property key, _Desc_: a Property Descriptor): ~unused~" meaning "For each field of _Desc_, sets the attribute of the same name of _O_'s own property with key _P_ to the field's value." }
extern def $Pair { sig "(a: value, b: value) → pair" meaning "the ordered pair of a and b" }
extern def $Parent { sig "(n: Parse Node) → Parse Node" meaning "the Parse Node of which n is a child node" }
