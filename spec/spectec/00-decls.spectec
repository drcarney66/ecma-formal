extern def $IsPropertyValueAlias { sig "IsPropertyValueAlias(_p_: a List of code points or a String, _v_: a List of code points or a String): a Boolean" meaning "Whether _v_ is a property value or property value alias that the file PropertyValueAliases.txt of the Unicode Character Database lists for the Unicode property named _p_, a property name or property alias of the file PropertyAliases.txt. Names compare exactly: case, white space, U+002D (HYPHEN-MINUS) and U+005F (LOW LINE) count, as <emu-xref href=\"#sec-runtime-semantics-unicodematchpropertyvalue-p-v\"></emu-xref> requires. Script_Extensions has the values of Script." }
extern def $IsSharedDataBlock { sig "IsSharedDataBlock(_v_: anything): a Boolean" meaning "Whether _v_ is a Shared Data Block (<emu-xref href=\"#sec-data-blocks\"></emu-xref>)." }
extern def $IsSingleCharacter { sig "(cs: CharSet) → Boolean" meaning "whether cs has exactly one element and it is a single character" }
extern def $IsStrictModeCode { sig "(text: source text) → Boolean" meaning "whether text is strict mode code (11.2.2)" }
