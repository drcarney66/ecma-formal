extern def $NumberCeil { sig "(n: Number) → Number" meaning "the smallest integral Number not less than n" }
extern def $NumberDigitsCount { sig "NumberDigitsCount(_x_: a Number, _radix_: an integer): a positive integer" meaning "The _k_ of the same three integers as NumberDigitsExponent(_x_, _radix_): the number of digits of _s_." }
extern def $NumberDigitsExponent { sig "NumberDigitsExponent(_x_: a Number, _radix_: an integer): an integer" meaning "The _n_ of the integers _n_, _k_ and _s_ that Number::toString's step <emu-xref href=\"#step-number-tostring-intermediate-values\"></emu-xref> lets be such that _k_ ≥ 1, _radix_<sup>_k_ - 1</sup> ≤ _s_ &lt; _radix_<sup>_k_</sup>, 𝔽(_s_ × _radix_<sup>_n_ - _k_</sup>) is _x_, and _k_ is as small as possible, for a finite Number _x_ > *+0*<sub>𝔽</sub> and _radix_ in the inclusive interval from 2 to 36. The three integers are the implementation's function of _x_ and _radix_: where the condition leaves the least significant digit of _s_ open, the implementation's choice, the same at every call." }
extern def $NumberDigitsSignificand { sig "NumberDigitsSignificand(_x_: a Number, _radix_: an integer): a positive integer" meaning "The _s_ of the same three integers as NumberDigitsExponent(_x_, _radix_)." }
extern def $NumberFloor { sig "(n: Number) → Number" meaning "the greatest integral Number not greater than n" }
extern def $NumberFor
extern def $NumberRound { sig "(n: Number) → Number" meaning "the integral Number closest to n, a tie going toward +∞" }
extern def $NumberTrunc { sig "(n: Number) → Number" meaning "the integral Number nearest n in the direction of +0" }
extern def $NumericValue
extern def $OmitSharedArrayBuffer { sig "OmitSharedArrayBuffer(): a Boolean" meaning "Whether the host omits the *\"SharedArrayBuffer\"* property of the global object (<emu-xref href=\"#sec-sharedarraybuffer-constructor\"></emu-xref>). It is a fact of the host: every call gives the same answer." }
extern def $OnContextStack { sig "OnContextStack(_ctx_: an execution context): a Boolean" meaning "Whether _ctx_ is an element of the execution context stack (<emu-xref href=\"#sec-execution-contexts\"></emu-xref>)." }
