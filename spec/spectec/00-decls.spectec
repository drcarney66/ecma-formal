extern def $IsNonterminal { sig "IsNonterminal(_v_: anything): a Boolean" meaning "Whether _v_ is a nonterminal symbol of one of the ECMAScript grammars (<emu-xref href=\"#sec-context-free-grammars\"></emu-xref>)." }
extern def $IsOrdinaryInternalMethod { sig "(m: internal method, n: internal method name) → Boolean" meaning "whether m is the ordinary object internal method named n" }
