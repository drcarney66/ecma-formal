  keys ["\n          EscapeSequence ::\n            LegacyOctalEscapeSequence\n            NonOctalDecimalEscapeSequence\n        "]
  vars []
  sentences {
    syntax_error @sec-isstrict(call_at @ph-this-production(data choice 0)) is val {true}
  }
}

early @sec-identifiers-static-semantics-early-errors #"Early Errors" {
  prods [p"Syntactic - BindingIdentifier : Identifier"]
  keys ["BindingIdentifier : Identifier"]
  vars []
  sentences {
    syntax_error @sec-isstrict(call_at @ph-this-production(data choice 0)) is val {true} and sdo StringValue(child 5 |Identifier|) is val {"arguments"; "eval"}
  }
}

