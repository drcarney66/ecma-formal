early @sec-object-initializer-static-semantics-early-errors #"Early Errors" {
  prods [p"Syntactic 0 ObjectLiteral : `{` PropertyDefinitionList[?Yield, ?Await] `,`? `}`", p"Syntactic 1 ObjectLiteral : `{` PropertyDefinitionList[?Yield, ?Await] `,`? `}`"]
  keys ["ObjectLiteral : `{` PropertyDefinitionList `,`? `}`"]
  vars []
  sentences {
    syntax_error @formal-protopropertycount(child 5 |PropertyDefinitionList|) >= 2
    not_applied call_at @ph-this-nt(|ObjectLiteral|) sat @spec-copy-3(data choice 0) { perform $""(bool(call_at @ph-this-nt(|ObjectLiteral|) sat @spec-copy-3(data choice 0)), data choice 0, clause @sec-json.parse, code "ParseJSON") }
  }
}

