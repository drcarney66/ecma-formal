    syntax_error @sec-isstrict(child 4 |UnaryExpression|) is val {true} and child 3 |UnaryExpression| is val {prods [p"Syntactic - PrimaryExpression : IdentifierReference[?Yield, ?Await]"]; prods [p"Syntactic - MemberExpression : MemberExpression[?Yield, ?Await] `.` PrivateIdentifier"]; prods [p"Syntactic - CallExpression : CallExpression[?Yield, ?Await] `.` PrivateIdentifier"]; prods [p"Syntactic - OptionalChain : `?.` PrivateIdentifier"]; prods [p"Syntactic - OptionalChain : OptionalChain[?Yield, ?Await] `.` PrivateIdentifier"]}
  }
}

