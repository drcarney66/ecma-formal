  vars []
  sentences {
    syntax_error child 3 |UnaryExpression| is val {prods [p"Syntactic - PrimaryExpression : CoverParenthesizedExpressionAndArrowParameterList[?Yield, ?Await]"]} and expr call_at @ph-derives-error(|CoverParenthesizedExpressionAndArrowParameterList|, |UnaryExpression|)
    info { perform $""() }
  }
}

