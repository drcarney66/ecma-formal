-- ECMA-262 Static Semantics: Early Errors

early @sec-identifier-names-static-semantics-early-errors #"Early Errors" {
  prods [p"Lexical - IdentifierStart :: `\\` UnicodeEscapeSequence"]
  keys ["IdentifierStart :: `\\` UnicodeEscapeSequence"]
  vars []
  sentences {
    syntax_error sdo IdentifierCodePoint(child 5 |UnicodeEscapeSequence|) sat @ph-not-some-cp-matched(data choice 0, data choice 0, $GrammarSymbol(|IdentifierStartChar|))
  }
}

early @sec-identifier-names-static-semantics-early-errors#1 #"Early Errors" {
  prods [p"Lexical - IdentifierPart :: `\\` UnicodeEscapeSequence"]
  keys ["IdentifierPart :: `\\` UnicodeEscapeSequence"]
  vars []
  sentences {
    syntax_error sdo IdentifierCodePoint(child 5 |UnicodeEscapeSequence|) sat @ph-not-some-cp-matched(data choice 0, data choice 0, $GrammarSymbol(|IdentifierPartChar|))
  }
}

early @sec-numeric-literals-early-errors #"Early Errors" {
  prods [p"Lexical - NumericLiteral :: LegacyOctalIntegerLiteral", p"Lexical - DecimalIntegerLiteral :: NonOctalDecimalIntegerLiteral"]
  keys ["\n          NumericLiteral :: LegacyOctalIntegerLiteral\n\n          DecimalIntegerLiteral :: NonOctalDecimalIntegerLiteral\n        "]
  vars []
  sentences {
    syntax_error @sec-isstrict(call_at @ph-this-production(data choice 0)) is val {true}
  }
}

early @sec-string-literals-early-errors #"Early Errors" {
