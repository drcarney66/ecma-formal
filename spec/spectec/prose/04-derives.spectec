spec_module ProseDerives
import Ecma.Grammar.Notation

---! # What ECMA-262's grammar notation means (§5.1)
---!
---! `Derives` is §5.1's derivation relation over GL's notation (`Grammar.Core`,
---! read through `Grammar.Notation`),
---! for each grammar and goal symbol, with parameters and guards (§5.1.6),
---! optional symbols (one right-hand side per presence mask, so a node's
---! production is a GL production id), lookahead, `[no LineTerminator here]`,
---! `but not` and `[empty]`. Its terminals come from an `Alphabet`: code points for
---! the lexical, RegExp and numeric string grammars, tokens for the syntactic
---! grammar. The descriptive phrases, `<USP>` and the `[> but only if …]`
---! conditions are the alphabet's (b) primitives.
---!
---! `but not` and the lookahead `∉ N` are negative. `Derives` is therefore the
---! limit of strata: stratum `k + 1` reads the exclusions in stratum `k`, and a
---! derivation is one at every stratum from some on, which is §5.1's relation for
---! a grammar whose exclusions are stratified, as GL's are.
---!
---! The rest of §5.1.3, §5.1.5, §11 and §12 is stated over it: scanning source
---! text into input elements (`Scans`), the tokens and their line terminators,
---! the choice of lexical goal at the parse's position (`GoalsAt`), automatic semicolon insertion
---! (`ASIOk`), and chain productions (`chainNt`).

namespace Ecma.Grammar {
  ---!  ## Derivations 

  --- A Parse Node: a nonterminal instance with its production id, its
  --- parameters and its span of the input; a leaf (a terminal or a phrase) and its
  --- span; or input element `k` as an instance of another grammar's nonterminal,
  --- with that grammar's derivation `t` over the element's code points.
  syntax Tree {
    | leaf (i j : Nat)
    | node (n : NT) (id : Nat) (ps : List(Param)) (i j : Nat) (kids : List(Tree))
    | lex (k : Nat) (t : Tree)
  }

  --- A node of nonterminal `n` spanning `i` to `j` is in the tree.
  def Tree.has (n : NT) (i j : Nat) : Tree -> Bool
    | .node(m, _, _, a, b, kids) => m == n && a == i && b == j || kids.attach.any(fun ctor(k, _) => k.has(n, i, j))
    | .leaf(..) => false
    | .lex(_, t) => t.has(n, i, j)
  end

  --- A terminal's tree: no Parse Node child of its parent.
  def Tree.isLeaf : Tree -> Bool
    | .leaf(..) => true
    | _ => false
  end

  def Tree.nt? : Tree -> Option(NT)
    | .node(n, ..) => some(n)
    | .leaf(..) => none
    | .lex(_, t) => t.nt?
  end

  def Tree.span : Tree -> Nat times Nat
    | .leaf(i, j) => (i, j)
    | .lex(k, _) => (k, k + 1)
    | .node(_, _, _, i, j, _) => (i, j)
  end

  --- The elements `i` to `j` of the input.
  def slice {T : Type} (inp : List(T)) (i j : Nat) : List(T) := inp.drop(i).take(j - i)

  --- A grammar's terminals.
  syntax Alphabet (T : Type) record {
    --- terminal `x`, at item `k` of right-hand side `s`, matches these input elements
    term : Src -> Nat -> Terminal -> List(T) -> Prop;
    --- (b) a descriptive phrase's class
    phrase : Phrase -> List(T) -> Prop;
    --- (b) a `[> but only if …]` condition on the node derived for the item
    --- before it, in the whole input
    cond : Phrase -> List(T) -> Tree -> Prop;
    --- this input element is an instance of a nonterminal this grammar does not
    --- define, derived as `t` over its code points
    leaf : NT -> T -> Tree -> Prop;
    --- no line terminator before the input element at this position
    noLT : List(T) -> Nat -> Prop;
    --- the position a lookahead reads from this one: past the elements §12.10 inserted
    look : List(T) -> Nat -> Nat := fun _ j => j;
  }

  section {
    var {T : Type} (A : Alphabet(T)) (neg : NT -> List(Param) -> Nat -> Nat -> Prop) (inp : List(T))

    --- The input from `j` starts with the lookahead sequence, each item read from `A.look`.
    def StartsWith (s : Src) : List(LookItem) -> Nat -> Prop
      | [], _ => True
      | .t(x) :: rest, j => exists h, A.look(inp, j) < h /\ h <= inp.length /\ A.term(s, 0, x, slice(inp, A.look(inp, j), h)) /\ StartsWith(s, rest, h)
      | .noLT :: rest, j => A.noLT(inp, A.look(inp, j)) /\ StartsWith(s, rest, j)
    end

    --- A lookahead restriction holds at `j`; `∉ N` reads `N` in `neg`.
    def LookOk (s : Src) : Lookahead -> Nat -> Prop
      | .eq(q), j => StartsWith(A, inp, s, q, j)
      | .ne(q), j => not StartsWith(A, inp, s, q, j)
      | .mem(qs), j => exists q mem qs, StartsWith(A, inp, s, q, j)
      | .notMem(qs), j => forall q mem qs, not StartsWith(A, inp, s, q, j)
      | .notMemNT(n), j => not exists h, neg(n, [], j, h)
    end

    --- The input `i` to `h` is an excluded symbol (in `neg` for a nonterminal).
    def Excluded (s : Src) (k : Nat) (ps : List(Param)) (i h : Nat) : Exclusion -> Prop
      | .sym(y) => match y with
          | .t(x) => A.term(s, k, x, slice(inp, i, h))
          | .nt(n, args) => neg(n, applyArgs(ps, args), i, h)
        end
      | .oneOf(ys, _) => exists y mem ys, match y with
          | .t(x) => A.term(s, k, x, slice(inp, i, h))
          | .nt(n, args) => neg(n, applyArgs(ps, args), i, h)
        end
    end

    --- The condition after an item, if any, holds of its node.
    def CondOk (is : List(Item)) (t : Tree) : Prop := match is with
      | .onlyIf(c) :: _ => A.cond(c, inp, t)
      | _ => True
    end

    var (gl : GL) (cx : Ctx) (g : GrammarId)

    mutual {
      --- One stratum: nonterminal `n` with parameters `ps` derives the input `i` to
      --- `j` as node `t`, the exclusions read in `neg`.
      relation Step : NT -> List(Param) -> Nat -> Nat -> Tree -> Prop {
        rule node {n ps i j m kids id} (s : Src) : Step(n, ps, i, j, .node(n, id, ps, i, j, kids)) :- s mem gl.alts(cx, g, n), s.alt.guard.all(Guard.holds(ps)), gl.prodId(s, m) = some(id), Seq(s, ps, 0, s.alt.rhs, i, j, m, kids);
        rule lex {n ps i t} {e : T} : Step(n, ps, i, i + 1, .lex(i, t)) :- gl.alts(cx, g, n) = [], inp[i]? = some(e), A.leaf(n, e, t);
      }

      --- Items `k` on of right-hand side `s` derive the input `i` to `j`, with the
      --- optional symbols' presences `m` and the nodes `ts`.
      relation Seq : Src -> List(Param) -> Nat -> List(Item) -> Nat -> Nat -> List(Bool) -> List(Tree) -> Prop {
        rule nil {s ps k i} : Seq(s, ps, k, [], i, i, [], []);
        rule absent {s ps k x is i j m ts} : Seq(s, ps, k, .sym(x, true) :: is, i, j, false :: m, ts) :- Seq(s, ps, k + 1, is, i, j, m, ts);
        rule term {s ps k x o is i h j m ts} : Seq(s, ps, k, .sym(.t(x), o) :: is, i, j, if o then true :: m else m, .leaf(i, h) :: ts) :- A.term(s, k, x, slice(inp, i, h)), Seq(s, ps, k + 1, is, h, j, m, ts);
        rule nt {s ps k n args o is i h j m t ts} : Seq(s, ps, k, .sym(.nt(n, args), o) :: is, i, j, if o then true :: m else m, t :: ts) :- Step(n, applyArgs(ps, args), i, h, t), CondOk(A, inp, is, t), Seq(s, ps, k + 1, is, h, j, m, ts);
        rule butNotT {s ps k x ex is i h j m ts} : Seq(s, ps, k, .butNot(.t(x), ex) :: is, i, j, m, .leaf(i, h) :: ts) :- A.term(s, k, x, slice(inp, i, h)), not Excluded(A, neg, inp, s, k, ps, i, h, ex), Seq(s, ps, k + 1, is, h, j, m, ts);
        rule butNotN {s ps k n args ex is i h j m t ts} : Seq(s, ps, k, .butNot(.nt(n, args), ex) :: is, i, j, m, t :: ts) :- Step(n, applyArgs(ps, args), i, h, t), not Excluded(A, neg, inp, s, k, ps, i, h, ex), Seq(s, ps, k + 1, is, h, j, m, ts);
        rule phrase {s ps k p is i h j m ts} : Seq(s, ps, k, .phrase(p) :: is, i, j, m, .leaf(i, h) :: ts) :- A.phrase(p, slice(inp, i, h)), Seq(s, ps, k + 1, is, h, j, m, ts);
        rule look {s ps k l is i j m ts} : Seq(s, ps, k, .lookahead(l) :: is, i, j, m, ts) :- LookOk(A, neg, inp, s, l, i), Seq(s, ps, k + 1, is, i, j, m, ts);
        rule noLT {s ps k is i j m ts} : Seq(s, ps, k, .noLT :: is, i, j, m, ts) :- A.noLT(inp, i), Seq(s, ps, k + 1, is, i, j, m, ts);
        rule empty {s ps k is i j m ts} : Seq(s, ps, k, .empty :: is, i, j, m, ts) :- Seq(s, ps, k + 1, is, i, j, m, ts);
        rule onlyIf {s ps k c is i j m ts} : Seq(s, ps, k, .onlyIf(c) :: is, i, j, m, ts) :- Seq(s, ps, k + 1, is, i, j, m, ts);
      }
    }
  }

  --- Stratum `k` of the derivation relation.
  def DerivesAt (gl : GL) (cx : Ctx) (g : GrammarId) {T : Type} (A : Alphabet(T)) (inp : List(T)) : Nat -> NT -> List(Param) -> Nat -> Nat -> Tree -> Prop
    | 0 => fun _ _ _ _ _ => False
    | k + 1 => Step(A, fun n ps i j => exists t, DerivesAt(gl, cx, g, A, inp, k, n, ps, i, j, t), inp, gl, cx, g)
  end

  --- §5.1: in grammar `g` and context `cx`, `n` with
  --- parameters `ps` derives the input `i` to `j` as `t`: at every stratum from
  --- some on.
  def Derives (gl : GL) (cx : Ctx) (g : GrammarId) {T : Type} (A : Alphabet(T)) (inp : List(T)) (n : NT) (ps : List(Param)) (i j : Nat) (t : Tree) : Prop := exists K, forall k, K <= k -> DerivesAt(gl, cx, g, A, inp, k, n, ps, i, j, t)

  ---!  ## Code points: the lexical, RegExp and numeric string grammars 

  --- The (b) primitives of the code point grammars: the descriptive phrases'
  --- classes, `<USP>`, and the `[> but only if …]` conditions (each reads a static
  --- semantics of the node before it, which the Ecma program supplies).
  syntax CodePrims record {
    phrase : Phrase -> Nat -> Prop;
    usp : Nat -> Prop;
    cond : Phrase -> List(Nat) -> Tree -> Prop;
  }

  def codeAlphabet (P : CodePrims) : Alphabet(Nat) {
    term _ _ x w := match x with
      | .text(s, _) => w = s.toList.map(Char.toNat)
      | .cp(n) => match n.codePoint with
          | some(v) => w = [v]
          | none => exists c, w = [c] /\ P.usp(c)
        end
    end;
    phrase p w := exists c, w = [c] /\ P.phrase(p, c);
    cond := P.cond;
    leaf _ _ _ := False;
    noLT _ _ := True;
  }

  --- §12.3: the line terminator code points.
  def lineTerminators : List(Nat) := ([.LF, .CR, .LS, .PS] : List(CodePointName)).filterMap(CodePointName.codePoint)

  ---!  ## Source text, input elements and tokens (§5.1.3, §11, §12) 

  --- An input element: its span of the source text, the lexical goal it was
  --- read with, and its derivation.
  syntax Element record {
    i : Nat;
    j : Nat;
    goal : NT;
    tree : Tree;
  }

  --- What the element is an instance of, under its goal (`WhiteSpace`,
  --- `Comment`, `CommonToken`, …).
  def Element.kind (e : Element) : Option(NT) := match e.tree with
    | .node(_, _, _, _, _, [k]) => k.nt?
    | _ => none
  end

  --- §5.1.3: white space, line terminators and comments are not tokens; B.1.1's |HTMLCloseComment|
  --- is a comment.
  def Element.isToken (e : Element) : Bool := ![NT.WhiteSpace, .LineTerminator, .Comment, .HashbangComment, .HTMLCloseComment].any(fun _dot0 => some(_dot0) == e.kind)

  --- §12.4, B.1.1: a line terminator, or a comment that contains a line
  --- terminator code point (a |MultiLineComment| with one, a
  --- |SingleLineHTMLCloseComment|), is a |LineTerminator| for the syntactic grammar.
  def Element.breaks (src : List(Nat)) (e : Element) : Bool := e.kind == some(.LineTerminator) || e.kind == some(.Comment) && slice(src, e.i, e.j).any(lineTerminators.contains)

  var (gl : GL) (cx : Ctx) (P : CodePrims)

  --- §12: the source text is scanned left to right into the input elements
  --- `els`, each the longest sequence of code points its lexical goal derives; §12.9.3: the code point
  --- after a |NumericLiteral| is not an |IdentifierStart| or a |DecimalDigit|.
  def Scans (src : List(Nat)) (els : List(Element)) : Prop := els.zipIdx.all(fun (e, k) => e.i == (if k == 0 then 0 else els[k - 1]?.map(fun _dot0 => _dot0.j).getD(0))) = true /\ els.getLast?.map(fun _dot0 => _dot0.j).getD(0) = src.length /\ forall e mem els, e.i < e.j /\ Derives(gl, cx, .lexical, codeAlphabet(P), src, e.goal, [], e.i, e.j, e.tree) /\ (forall h, e.j < h -> h <= src.length -> not exists t, Derives(gl, cx, .lexical, codeAlphabet(P), src, e.goal, [], e.i, h, t)) /\ (e.tree.has(.NumericLiteral, e.i, e.j) = true -> e.j < src.length -> (forall n mem [NT.IdentifierStart, NT.DecimalDigit], not exists t, Derives(gl, cx, .lexical, codeAlphabet(P), src, n, [], e.j, e.j + 1, t)))

  --- Why §12.10 inserted a virtual semicolon: rule 1 (an offending token after
  --- a line terminator, or `}`), rule 1's `)` of a do-while, rule 2, rule 3.
  syntax Why {
    | offending
    | paren
    | eof
    | restricted
  }
  deriving [Repr, BEq, Inhabited]

  --- A token of the syntactic grammar: its code points, whether a line
  --- terminator precedes it, and, for a virtual semicolon, why it was inserted.
  syntax Token record {
    text : List(Nat);
    lt : Bool;
    virt : Option(Why);
  }

  --- The tokens of scanned input elements.
  def tokensOf (src : List(Nat)) (els : List(Element)) : List(Token) := els.zipIdx.filter(fun _dot0 => _dot0.1.isToken).map(fun (e, k) => let before := els.take(k).reverse.takeWhile(fun _dot0 => !_dot0.isToken) in ctor(slice(src, e.i, e.j), before.any(fun _dot0 => _dot0.breaks(src)), none))

  --- The first position from `j` that holds no virtual semicolon.
  def pastVirt (toks : List(Token)) (j : Nat) : Nat := j + toks.drop(j).takeWhile(fun _dot0 => _dot0.virt.isSome).length

  --- The syntactic grammar's alphabet: a terminal is a token of its text; a
  --- virtual semicolon only where §12.10 lets one stand (`Gen.semis`'s class of
  --- that `;`); a lexical nonterminal is a real token whose text it derives, the
  --- token's Parse Node being that derivation; a lookahead reads the source's tokens,
  --- past the virtual semicolons (§5.1.6's "input token sequence").
  def tokenAlphabet : Alphabet(Token) {
    term s k x w := match x, w with
      | .text(str, _), [tok] => tok.text = str.toList.map(Char.toNat) /\ match tok.virt with
          | none => True
          | some(why) => exists c, gl.ctorOf(s) = some(c) /\ exists cls, (c, k, cls) mem gl.semis /\ match cls with
              | .insertable | .forHeaderIfDeclaration => why != .paren
              | .doWhile => True
              | .emptyStatement | .forHeader => False
            end
        end
      | _, _ => False
    end;
    phrase _ _ := False;
    cond _ _ _ := False;
    leaf n tok t := tok.virt = none /\ Derives(gl, cx, .lexical, codeAlphabet(P), tok.text, n, [], 0, tok.text.length, t);
    noLT toks i := forall tok, toks[i]? = some(tok) -> tok.lt = false;
    look := pastVirt;
  }

  --- A token sequence the goal derives.
  def Sentence (goal : NT) (ps : List(Param)) (toks : List(Token)) (t : Tree) : Prop := Derives(gl, cx, .syntactic, tokenAlphabet(gl, cx, P), toks, goal, ps, 0, toks.length, t)

  --- §12.10's overriding condition at the `;` that ends the |LexicalDeclaration|
  --- of `for ( LexicalDeclaration …`: it is the header's first, never virtual.
  def ForHeadersExplicit (toks : List(Token)) : Tree -> Prop
    | .leaf(..) | .lex(..) => True
    | .node(n, _, _, _, _, kids) => (n == .ForStatement -> (forall d mem kids, d.nt? = some(.LexicalDeclaration) -> (forall tok, toks[d.span.2 - 1]? = some(tok) -> tok.virt = none))) /\ all(kids)
  end
  where {
    all : List(Tree) -> Prop
      | [] => True
      | d :: ds => ForHeadersExplicit(toks, d) /\ all(ds)
    end
  }

  --- B.3.3, B.3.5 ("only applies when parsing non-strict code"): no node of such
  --- a production lies in strict mode code. `strict ancestors node` is §11.2.2's
  --- "is strict mode code" (`StrictCode`, with strictness from outside the parse).
  def NonStrictOk (L : GL) (strict : List(Tree) -> Tree -> Prop) : List(Tree) -> Tree -> Prop
    | _, .leaf(..) | _, .lex(..) => True
    | up, t@(.node(_, id, _, _, _, kids)) => (id mem L.sloppyIds -> not strict(up, t)) /\ all(t :: up, kids)
  end
  where {
    all (up : List(Tree)) : List(Tree) -> Prop
      | [] => True
      | d :: ds => NonStrictOk(L, strict, up, d) /\ all(up, ds)
    end
  }

  --- The lexical goal a lexical nonterminal is read under (§12).
  def lexicalGoalOf (n : NT) : NT := if n == .RegularExpressionLiteral then .InputElementRegExp else if n == .TemplateMiddle || n == .TemplateTail then .InputElementTemplateTail else .InputElementDiv

  --- The lexical goal the token at position `idx` of a syntactic derivation is read under: a lexical
  --- nonterminal's own goal (`lexicalGoalOf`), a terminal's `InputElementDiv`.
  def Tree.goalAt (idx : Nat) : Tree -> Option(NT)
    | .leaf(i, j) => if i <= idx && idx < j then some(.InputElementDiv) else none
    | .lex(k, lt) => if k == idx then lt.nt?.map(lexicalGoalOf) else none
    | .node(_, _, _, _, _, kids) => inKids(kids)
  end
  where {
    inKids : List(Tree) -> Option(NT)
      | [] => none
      | d :: ds => match d.goalAt(idx) with
          | some(g) => some(g)
          | none => inKids(ds)
        end
    end
  }

  --- The index in `toks` of the `n`-th real token.
  def realIdx : Nat -> List(Token) -> Nat
    | _, [] => 0
    | 0, tok :: toks => if tok.virt.isNone then 0 else 1 + realIdx(0, toks)
    | n + 1, tok :: toks => 1 + realIdx(if tok.virt.isNone then n else n + 1, toks)
  end

  --- §12: the first input element of a |Script| or |Module| is read under
  --- `InputElementHashbangOrRegExp`, trivia after that under `InputElementDiv`, and each token under
  --- the lexical goal its node in `t` implies (`Tree.goalAt`, after any inserted `;` before it).
  def GoalsAt (goal : NT) (els : List(Element)) (toks : List(Token)) (t : Tree) : Prop := forall k e, els[k]? = some(e) -> (if k == 0 && (goal == .Script || goal == .Module) then e.goal = .InputElementHashbangOrRegExp else if !e.isToken then e.goal = .InputElementDiv else t.goalAt(realIdx(els.take(k).filter(Element.isToken).length, toks)) = some(e.goal))

  ---!  ## §12.10: left-to-right automatic semicolon insertion 

  --- One maximal non-token input element from `i` to `j` (`first`: whether the goal is |Script| or |Module|).
  def TriviaElem (src : List(Nat)) (first : Bool) (i j : Nat) (e : Element) : Prop := i < j /\ j <= src.length /\ e.i = i /\ e.j = j /\ !e.isToken /\ let g := if first && i == 0 then .InputElementHashbangOrRegExp else .InputElementDiv in e.goal = g /\ Derives(gl, cx, .lexical, codeAlphabet(P), src, e.goal, [], i, j, e.tree) /\ forall h, j < h -> h <= src.length -> not exists t, Derives(gl, cx, .lexical, codeAlphabet(P), src, e.goal, [], i, h, t)

  --- The trivia from `i` ends at `k` with line-terminator flag `lt`: maximal non-token elements until
  --- none starts at `k`.
  relation Trivia (src : List(Nat)) (first : Bool) : Nat -> Nat -> Bool -> Prop {
    rule stop {i} : Trivia(src, first, i, i, false) :- not exists j e, TriviaElem(gl, cx, P, src, first, i, j, e);
    rule step {i m k lt} (e : Element) : Trivia(src, first, i, k, e.breaks(src) || lt) :- TriviaElem(gl, cx, P, src, first, i, m, e), Trivia(src, first, m, k, lt);
  }

  --- The next token from `p` under lexical goal `lg` (`first`: |Script| or |Module|): after trivia to `a`
  --- with `lt`, the maximal element `a` to `b` is a token passing §12.9.3's follow rule.
  def ScanTok (src : List(Nat)) (first : Bool) (lg : NT) (p a b : Nat) (lt : Bool) (tree : Tree) : Prop := Trivia(gl, cx, P, src, first, p, a, lt) /\ a < b /\ b <= src.length /\ let g := if first && a == 0 then .InputElementHashbangOrRegExp else lg in Element.isToken(ctor(a, b, g, tree)) = true /\ Derives(gl, cx, .lexical, codeAlphabet(P), src, g, [], a, b, tree) /\ (forall h, b < h -> h <= src.length -> not exists t, Derives(gl, cx, .lexical, codeAlphabet(P), src, g, [], a, h, t)) /\ (tree.has(.NumericLiteral, a, b) = true -> b < src.length -> (forall n mem [NT.IdentifierStart, NT.DecimalDigit], not exists t, Derives(gl, cx, .lexical, codeAlphabet(P), src, n, [], b, b + 1, t)))

  --- A virtual `;` in `vs` waits at boundary `s` (`2 * p`).
  def vsPending (vs : List(Nat times Bool)) (s : Nat) : Bool := s % 2 == 0 && vs.any(fun (p, _) => p == s / 2)

  --- Whether the virtual `;` at `p` was inserted after `)` (do-while).
  def vsParen (vs : List(Nat times Bool)) (p : Nat) : Bool := vs.any(fun (q, b) => q == p && b)

  --- No virtual `;` of `vs` lies strictly between `p` and `q`.
  def noCross (vs : List(Nat times Bool)) (p q : Nat) : Bool := vs.all(fun (v, _) => !(p < v && v < q))

  --- §12.10: a virtual `;` (`paren`: after `)`) may stand at item `k` of `s`.
  def semiAllowed (s : Src) (k : Nat) (paren : Bool) : Prop := exists c cls, gl.ctorOf(s) = some(c) /\ (c, k, cls) mem gl.semis /\ match cls with
    | .insertable | .forHeaderIfDeclaration => paren = false
    | .doWhile => True
    | .emptyStatement | .forHeader => False
  end

  --- §12.10: the `;` ending a `for` header's |LexicalDeclaration| is never virtual.
  def forKeep (lhs n : NT) (j : Nat) : Bool := !(lhs == .ForStatement && n == .LexicalDeclaration && j % 2 == 1)

  --- Terminal `x` at item `k` of `s` matches from boundary `i` to `j` under virtual semicolons `vs`.
  def SynTerm (src : List(Nat)) (first : Bool) (vs : List(Nat times Bool)) (s : Src) (k : Nat) (x : Terminal) (i j : Nat) : Prop := match x with
    | .text(str, _) => if vsPending(vs, i) then str = ";" /\ semiAllowed(gl, s, k, vsParen(vs, i / 2)) /\ j = i + 1 else exists a b lt tr, ScanTok(gl, cx, P, src, first, .InputElementDiv, i / 2, a, b, lt, tr) /\ noCross(vs, i / 2, b) = true /\ slice(src, a, b) = str.toList.map(Char.toNat) /\ j = 2 * b
    | .cp(_) => False
  end

  --- Lexical nonterminal `n` matches one token from boundary `i` to `j` under virtual semicolons `vs`.
  def SynLeaf (src : List(Nat)) (first : Bool) (vs : List(Nat times Bool)) (n : NT) (i j : Nat) : Prop := vsPending(vs, i) = false /\ exists a b lt tr t, ScanTok(gl, cx, P, src, first, lexicalGoalOf(n), i / 2, a, b, lt, tr) /\ noCross(vs, i / 2, b) = true /\ Derives(gl, cx, .lexical, codeAlphabet(P), slice(src, a, b), n, [], 0, b - a, t) /\ j = 2 * b

  --- No line terminator precedes the token at boundary `i` (a virtual `;` has none).
  def SynNoLT (src : List(Nat)) (first : Bool) (vs : List(Nat times Bool)) (i : Nat) : Prop := vsPending(vs, i) = true \/ exists k lt, Trivia(gl, cx, P, src, first, i / 2, k, lt) /\ (src.length <= k \/ lt = false)

  --- The boundary a lookahead reads from `i`: past a waiting virtual `;`.
  def SynLook (vs : List(Nat times Bool)) (i : Nat) : Nat := if vsPending(vs, i) then i + 1 else i

  --- The source tokens from boundary `i` start with the lookahead sequence.
  def SynStarts (src : List(Nat)) (first : Bool) (vs : List(Nat times Bool)) : List(LookItem) -> Nat -> Prop
    | [], _ => True
    | .noLT :: rest, i => SynNoLT(gl, cx, P, src, first, vs, SynLook(vs, i)) /\ SynStarts(src, first, vs, rest, i)
    | .t(.text(str, _)) :: rest, i => exists a b lt tr, ScanTok(gl, cx, P, src, first, .InputElementDiv, SynLook(vs, i) / 2, a, b, lt, tr) /\ noCross(vs, SynLook(vs, i) / 2, b) = true /\ slice(src, a, b) = str.toList.map(Char.toNat) /\ SynStarts(src, first, vs, rest, 2 * b)
    | .t(.cp(_)) :: _, _ => False
  end

  --- A syntactic lookahead restriction holds at boundary `i`.
  def SynLookOk (src : List(Nat)) (first : Bool) (vs : List(Nat times Bool)) : Lookahead -> Nat -> Prop
    | .eq(q), i => SynStarts(gl, cx, P, src, first, vs, q, i)
    | .ne(q), i => not SynStarts(gl, cx, P, src, first, vs, q, i)
    | .mem(qs), i => exists q mem qs, SynStarts(gl, cx, P, src, first, vs, q, i)
    | .notMem(qs), i => forall q mem qs, not SynStarts(gl, cx, P, src, first, vs, q, i)
    | .notMemNT(_), _ => True
  end

  --- One symbol of a syntactic `but not` exclusion holds over boundaries `i` to `h`.
  def SynSymEx (src : List(Nat)) (first : Bool) (vs : List(Nat times Bool)) (s : Src) (k : Nat) (i h : Nat) : Sym -> Prop
    | .t(x) => SynTerm(gl, cx, P, src, first, vs, s, k, x, i, h)
    | .nt(n, _) => gl.alts(cx, .syntactic, n) = [] /\ SynLeaf(gl, cx, P, src, first, vs, n, i, h)
  end

  --- A syntactic `but not` exclusion holds over boundaries `i` to `h`.
  def SynExcluded (src : List(Nat)) (first : Bool) (vs : List(Nat times Bool)) (s : Src) (k : Nat) (i h : Nat) : Exclusion -> Prop
    | .sym(y) => SynSymEx(gl, cx, P, src, first, vs, s, k, i, h, y)
    | .oneOf(ys, _) => exists y mem ys, SynSymEx(gl, cx, P, src, first, vs, s, k, i, h, y)
  end

  --- No `[> but only if …]` condition immediately follows this item.
  def noCondAfter : List(Item) -> Bool
    | .onlyIf(_) :: _ => false
    | _ => true
  end

  section {
    var (src : List(Nat)) (first : Bool) (vs : List(Nat times Bool))

    mutual {
      --- Syntactic nonterminal `n` with `ps` derives boundaries `i` to `j` under virtual semicolons `vs`.
      relation SynDerives : NT -> List(Param) -> Nat -> Nat -> Prop {
        rule node {n ps i j} (s : Src) : SynDerives(n, ps, i, j) :- s mem gl.alts(cx, .syntactic, n), s.alt.guard.all(Guard.holds(ps)) = true, SynSeq(s, ps, 0, s.alt.rhs, i, j);
      }

      --- Right-hand side items from index `k` of `s` derive boundaries `i` to `j` under `vs`.
      relation SynSeq : Src -> List(Param) -> Nat -> List(Item) -> Nat -> Nat -> Prop {
        rule nil {s ps k i} : SynSeq(s, ps, k, [], i, i);
        rule absent {s ps k x is i j} : SynSeq(s, ps, k, .sym(x, true) :: is, i, j) :- SynSeq(s, ps, k + 1, is, i, j);
        rule term {s ps k x o is i h j} : SynSeq(s, ps, k, .sym(.t(x), o) :: is, i, j) :- SynTerm(gl, cx, P, src, first, vs, s, k, x, i, h), SynSeq(s, ps, k + 1, is, h, j);
        rule nt {s ps k n args o is i h j} : SynSeq(s, ps, k, .sym(.nt(n, args), o) :: is, i, j) :- gl.alts(cx, .syntactic, n) <> [], SynDerives(n, applyArgs(ps, args), i, h), forKeep(s.rule.lhs, n, h) = true, noCondAfter(is) = true, SynSeq(s, ps, k + 1, is, h, j);
        rule leaf {s ps k n args o is i h j} : SynSeq(s, ps, k, .sym(.nt(n, args), o) :: is, i, j) :- gl.alts(cx, .syntactic, n) = [], SynLeaf(gl, cx, P, src, first, vs, n, i, h), forKeep(s.rule.lhs, n, h) = true, noCondAfter(is) = true, SynSeq(s, ps, k + 1, is, h, j);
        rule butNotT {s ps k x ex is i h j} : SynSeq(s, ps, k, .butNot(.t(x), ex) :: is, i, j) :- SynTerm(gl, cx, P, src, first, vs, s, k, x, i, h), not SynExcluded(gl, cx, P, src, first, vs, s, k, i, h, ex), SynSeq(s, ps, k + 1, is, h, j);
        rule butNotN {s ps k n args ex is i h j} : SynSeq(s, ps, k, .butNot(.nt(n, args), ex) :: is, i, j) :- gl.alts(cx, .syntactic, n) <> [], SynDerives(n, applyArgs(ps, args), i, h), not SynExcluded(gl, cx, P, src, first, vs, s, k, i, h, ex), SynSeq(s, ps, k + 1, is, h, j);
        rule butNotLeaf {s ps k n args ex is i h j} : SynSeq(s, ps, k, .butNot(.nt(n, args), ex) :: is, i, j) :- gl.alts(cx, .syntactic, n) = [], SynLeaf(gl, cx, P, src, first, vs, n, i, h), not SynExcluded(gl, cx, P, src, first, vs, s, k, i, h, ex), SynSeq(s, ps, k + 1, is, h, j);
        rule look {s ps k l is i j} : SynSeq(s, ps, k, .lookahead(l) :: is, i, j) :- SynLookOk(gl, cx, P, src, first, vs, l, i), SynSeq(s, ps, k + 1, is, i, j);
        rule noLT {s ps k is i j} : SynSeq(s, ps, k, .noLT :: is, i, j) :- SynNoLT(gl, cx, P, src, first, vs, i), SynSeq(s, ps, k + 1, is, i, j);
        rule empty {s ps k is i j} : SynSeq(s, ps, k, .empty :: is, i, j) :- SynSeq(s, ps, k + 1, is, i, j);
        rule onlyIf {s ps k c is i j} : SynSeq(s, ps, k, .onlyIf(c) :: is, i, j) :- SynSeq(s, ps, k + 1, is, i, j);
      }
    }

    var (goal : NT) (goalPs : List(Param))

    mutual {
      --- Nonterminal `n` with `ps` is opened at boundary `i` when parsing left to right from `(goal, goalPs, 0)`.
      relation SynOpen : NT -> List(Param) -> Nat -> Prop {
        rule root : SynOpen(goal, goalPs, 0);
        rule nt {s ps k n args o is i} : SynOpen(n, applyArgs(ps, args), i) :- SynPrefix(s, ps, k, .sym(.nt(n, args), o) :: is, i), gl.alts(cx, .syntactic, n) <> [];
        rule butNotN {s ps k n args ex is i} : SynOpen(n, applyArgs(ps, args), i) :- SynPrefix(s, ps, k, .butNot(.nt(n, args), ex) :: is, i), gl.alts(cx, .syntactic, n) <> [];
      }

      --- Item `k` on of `s` is reached at boundary `i` when parsing left to right from `(goal, goalPs, 0)`.
      relation SynPrefix : Src -> List(Param) -> Nat -> List(Item) -> Nat -> Prop {
        rule enter {n ps i} (s : Src) : SynPrefix(s, ps, 0, s.alt.rhs, i) :- SynOpen(n, ps, i), s mem gl.alts(cx, .syntactic, n), s.alt.guard.all(Guard.holds(ps)) = true;
        rule absent {s ps k x is i} : SynPrefix(s, ps, k + 1, is, i) :- SynPrefix(s, ps, k, .sym(x, true) :: is, i);
        rule term {s ps k x o is i h} : SynPrefix(s, ps, k + 1, is, h) :- SynPrefix(s, ps, k, .sym(.t(x), o) :: is, i), SynTerm(gl, cx, P, src, first, vs, s, k, x, i, h);
        rule nt {s ps k n args o is i h} : SynPrefix(s, ps, k + 1, is, h) :- SynPrefix(s, ps, k, .sym(.nt(n, args), o) :: is, i), gl.alts(cx, .syntactic, n) <> [], SynDerives(gl, cx, P, src, first, vs, n, applyArgs(ps, args), i, h), forKeep(s.rule.lhs, n, h) = true, noCondAfter(is) = true;
        rule leaf {s ps k n args o is i h} : SynPrefix(s, ps, k + 1, is, h) :- SynPrefix(s, ps, k, .sym(.nt(n, args), o) :: is, i), gl.alts(cx, .syntactic, n) = [], SynLeaf(gl, cx, P, src, first, vs, n, i, h), forKeep(s.rule.lhs, n, h) = true, noCondAfter(is) = true;
        rule butNotT {s ps k x ex is i h} : SynPrefix(s, ps, k + 1, is, h) :- SynPrefix(s, ps, k, .butNot(.t(x), ex) :: is, i), SynTerm(gl, cx, P, src, first, vs, s, k, x, i, h), not SynExcluded(gl, cx, P, src, first, vs, s, k, i, h, ex);
        rule butNotN {s ps k n args ex is i h} : SynPrefix(s, ps, k + 1, is, h) :- SynPrefix(s, ps, k, .butNot(.nt(n, args), ex) :: is, i), gl.alts(cx, .syntactic, n) <> [], SynDerives(gl, cx, P, src, first, vs, n, applyArgs(ps, args), i, h), not SynExcluded(gl, cx, P, src, first, vs, s, k, i, h, ex);
        rule butNotLeaf {s ps k n args ex is i h} : SynPrefix(s, ps, k + 1, is, h) :- SynPrefix(s, ps, k, .butNot(.nt(n, args), ex) :: is, i), gl.alts(cx, .syntactic, n) = [], SynLeaf(gl, cx, P, src, first, vs, n, i, h), not SynExcluded(gl, cx, P, src, first, vs, s, k, i, h, ex);
        rule look {s ps k l is i} : SynPrefix(s, ps, k + 1, is, i) :- SynPrefix(s, ps, k, .lookahead(l) :: is, i), SynLookOk(gl, cx, P, src, first, vs, l, i);
        rule noLT {s ps k is i} : SynPrefix(s, ps, k + 1, is, i) :- SynPrefix(s, ps, k, .noLT :: is, i), SynNoLT(gl, cx, P, src, first, vs, i);
        rule empty {s ps k is i} : SynPrefix(s, ps, k + 1, is, i) :- SynPrefix(s, ps, k, .empty :: is, i);
        rule onlyIf {s ps k c is i} : SynPrefix(s, ps, k + 1, is, i) :- SynPrefix(s, ps, k, .onlyIf(c) :: is, i);
      }
    }

    --- Boundary `h` is reached by a match when parsing left to right from `(goal, goalPs, 0)`.
    relation SynHit : Nat -> Prop {
      rule zero : SynHit(0);
      rule term {s ps k x o is i h} : SynHit(h) :- SynPrefix(gl, cx, P, src, first, vs, goal, goalPs, s, ps, k, .sym(.t(x), o) :: is, i), SynTerm(gl, cx, P, src, first, vs, s, k, x, i, h);
      rule nt {s ps k n args o is i h} : SynHit(h) :- SynPrefix(gl, cx, P, src, first, vs, goal, goalPs, s, ps, k, .sym(.nt(n, args), o) :: is, i), gl.alts(cx, .syntactic, n) <> [], SynDerives(gl, cx, P, src, first, vs, n, applyArgs(ps, args), i, h), forKeep(s.rule.lhs, n, h) = true, noCondAfter(is) = true;
      rule leaf {s ps k n args o is i h} : SynHit(h) :- SynPrefix(gl, cx, P, src, first, vs, goal, goalPs, s, ps, k, .sym(.nt(n, args), o) :: is, i), gl.alts(cx, .syntactic, n) = [], SynLeaf(gl, cx, P, src, first, vs, n, i, h), forKeep(s.rule.lhs, n, h) = true, noCondAfter(is) = true;
      rule butNotT {s ps k x ex is i h} : SynHit(h) :- SynPrefix(gl, cx, P, src, first, vs, goal, goalPs, s, ps, k, .butNot(.t(x), ex) :: is, i), SynTerm(gl, cx, P, src, first, vs, s, k, x, i, h), not SynExcluded(gl, cx, P, src, first, vs, s, k, i, h, ex);
      rule butNotN {s ps k n args ex is i h} : SynHit(h) :- SynPrefix(gl, cx, P, src, first, vs, goal, goalPs, s, ps, k, .butNot(.nt(n, args), ex) :: is, i), gl.alts(cx, .syntactic, n) <> [], SynDerives(gl, cx, P, src, first, vs, n, applyArgs(ps, args), i, h), not SynExcluded(gl, cx, P, src, first, vs, s, k, i, h, ex);
      rule butNotLeaf {s ps k n args ex is i h} : SynHit(h) :- SynPrefix(gl, cx, P, src, first, vs, goal, goalPs, s, ps, k, .butNot(.nt(n, args), ex) :: is, i), gl.alts(cx, .syntactic, n) = [], SynLeaf(gl, cx, P, src, first, vs, n, i, h), not SynExcluded(gl, cx, P, src, first, vs, s, k, i, h, ex);
    }
  }

  --- A derivation of `(goal, ps)` spans the source text under virtual semicolons `vs`, none left after it.
  def SynDone (src : List(Nat)) (first : Bool) (vs : List(Nat times Bool)) (goal : NT) (ps : List(Param)) : Prop := exists e k lt, SynDerives(gl, cx, P, src, first, vs, goal, ps, 0, e) /\ Trivia(gl, cx, P, src, first, e / 2, k, lt) /\ src.length <= k /\ vsPending(vs, e) = false /\ vs.all(fun (p, _) => p <= e / 2) = true

  --- §12.10: when no derivation spans the source text under `vs`, the next virtual `;` goes at the
  --- furthest boundary reached (`f = 2 * p`), at end of input or before an offending token after a line
  --- terminator, `}`, or `)` (for do-while).
  def NextASI (src : List(Nat)) (first : Bool) (vs : List(Nat times Bool)) (goal : NT) (ps : List(Param)) (p : Nat) (paren : Bool) : Prop := not SynDone(gl, cx, P, src, first, vs, goal, ps) /\ exists f, SynHit(gl, cx, P, src, first, vs, goal, ps, f) /\ (forall h, SynHit(gl, cx, P, src, first, vs, goal, ps, h) -> h <= f) /\ f % 2 = 0 /\ p = f / 2 /\ vs.all(fun (q, _) => q != p) = true /\ ((exists k lt, Trivia(gl, cx, P, src, first, p, k, lt) /\ src.length <= k /\ paren = false) \/ exists a b lt tr, ScanTok(gl, cx, P, src, first, .InputElementDiv, p, a, b, lt, tr) /\ if lt || slice(src, a, b) == "}".toList.map(Char.toNat) then paren = false else 0 < p /\ src[p - 1]? = some(0x29) /\ paren = true)

  --- The virtual semicolons §12.10 inserts left to right from empty.
  relation ValidASI (src : List(Nat)) (first : Bool) (goal : NT) (ps : List(Param)) : List(Nat times Bool) -> Prop {
    rule nil : ValidASI(src, first, goal, ps, []);
    rule step {vs p paren} : ValidASI(src, first, goal, ps, vs ++ [(p, paren)]) :- ValidASI(src, first, goal, ps, vs), NextASI(gl, cx, P, src, first, vs, goal, ps, p, paren);
  }

  --- The code point after the last real token before index `k` of `toks` (`0` before the first).
  def tokPos (els : List(Element)) (toks : List(Token)) (k : Nat) : Nat := let es := els.filter(Element.isToken) in let r := toks.take(k).countP(fun tok => tok.virt.isNone) in if r == 0 then 0 else es[r - 1]?.map(fun e => e.j).getD(0)

  --- The virtual semicolons of `toks` are `vs` at their token boundaries, none adjacent.
  def toksMatchASI (els : List(Element)) (toks : List(Token)) (vs : List(Nat times Bool)) : Prop := (forall k t1 t2, toks[k]? = some(t1) -> toks[k + 1]? = some(t2) -> t1.virt = none \/ t2.virt = none) /\ (forall k tok why, toks[k]? = some(tok) -> tok.virt = some(why) -> (let w := if vsParen(vs, tokPos(els, toks, k)) then .paren else if k + 1 == toks.length then .eof else .offending in why = w /\ (tokPos(els, toks, k), vsParen(vs, tokPos(els, toks, k))) mem vs)) /\ forall p paren, (p, paren) mem vs -> (exists k tok, toks[k]? = some(tok) /\ tok.virt.isSome = true /\ tokPos(els, toks, k) = p)

  --- §12.10: the virtual semicolons of `toks` are a sequence `ValidASI` inserts left to right.
  def ASIOk (goal : NT) (ps : List(Param)) (src : List(Nat)) (els : List(Element)) (toks : List(Token)) : Prop := exists vs, ValidASI(gl, cx, P, src, goal == .Script || goal == .Module, goal, ps, vs) /\ toksMatchASI(els, toks, vs)

  ---!  ## B.1.2: ordered alternatives and the group-number condition 

  --- B.1.2's "each alternative is considered only if previous production alternatives do not match",
  --- as commitment: a node of a nonterminal B.1.2 restates (`GL.orderedNts`) at `i` uses an alternative only
  --- if no earlier alternative of it derives (in `D`) any span from `i`.
  def Tree.Commits (g : GrammarId) (D : NT -> List(Param) -> Nat -> Nat -> Tree -> Prop) : Tree -> Prop
    | .leaf(..) => True
    | .lex(_, t) => t.Commits(g, D)
    | .node(n, id, ps, i, _, kids) => (n mem gl.orderedNts(cx, g) -> (forall h id' kids' k k', D(n, ps, i, h, .node(n, id', ps, i, h, kids')) -> gl.altPos(cx, g, n, id) = some(k) -> gl.altPos(cx, g, n, id') = some(k') -> k <= k')) /\ all(kids)
  end
  where {
    all : List(Tree) -> Prop
      | [] => True
      | d :: ds => d.Commits(g, D) /\ all(ds)
    end
  }

  --- A parse of the whole input with B.1.2's ordered alternatives: a derivation whose every node
  --- commits (`Tree.Commits`), an earlier alternative's match read in `Derives`.
  def Committed (g : GrammarId) (goal : NT) (ps : List(Param)) (src : List(Nat)) (t : Tree) : Prop := Derives(gl, cx, g, codeAlphabet(P), src, goal, ps, 0, src.length, t) /\ t.Commits(gl, cx, g, Derives(gl, cx, g, codeAlphabet(P), src))

  --- The primitives with `c` as B.1.2's group-number condition.
  def CodePrims.withGroup (P : CodePrims) (c : List(Nat) -> Tree -> Prop) : CodePrims := { P with cond := fun p => match p with
    | .groupNumberAtMostCount => c
    | p => P.cond(p)
  end }

  --- The nodes of a tree whose production is one of `ids`, the tree's own included.
  def Tree.countProds (ids : List(Nat)) : Tree -> Nat
    | .leaf(..) => 0
    | .lex(_, t) => t.countProds(ids)
    | .node(_, id, _, _, _, kids) => (if ids.contains(id) then 1 else 0) + kids.attach.map(fun ctor(k, _) => k.countProds(ids)).sum
  end

  --- §22.2.1.5 CapturingGroupNumber: the MV of a |DecimalEscape|'s code points, decimal digits.
  def decimalMV (cs : List(Nat)) : Nat := cs.foldl(fun a c => 10 * a + (c - 0x30), 0)

  --- One code point of a hexadecimal MV (§12.9.3; a NumericLiteralSeparator adds none).
  def hexStep (v c : Nat) : Option(Nat) := if 0x30 <= c && c <= 0x39 then some(16 * v + (c - 0x30)) else if 0x61 <= c && c <= 0x66 then some(16 * v + (c - 0x61 + 10)) else if 0x41 <= c && c <= 0x46 then some(16 * v + (c - 0x41 + 10)) else if c == 0x5F then some(v) else none

  --- §12.9.3: the MV of hexadecimal digits (with NumericLiteralSeparators).
  def hexMV (cs : List(Nat)) : Option(Nat) := cs.foldl(fun acc c => acc.bind(fun v => hexStep(v, c)), some(0))

  --- B.1.2's condition of `AtomEscape :: DecimalEscape`, stratified: the CapturingGroupNumber of the
  --- |DecimalEscape| `t` is at most CountLeftCapturingParensWithin (§22.2.1.2, B.1.2.2) of a committed
  --- parse of the input as Pattern[~UnicodeMode, ~UnicodeSetsMode, ~NamedCaptureGroups] with the condition
  --- true ("the |Pattern| containing |DecimalEscape|" being the tree the condition selects).
  def groupCond (inp : List(Nat)) (t : Tree) : Prop := exists T, Committed(gl, cx, P.withGroup(fun _ _ => True), .regExp, .Pattern, [], inp, T) /\ decimalMV(slice(inp, t.span.1, t.span.2)) <= T.countProds(gl.capturingIds)

  --- A code point grammar's goal (RegExp's |Pattern|, the numeric string
  --- grammar's) parses the text as `t`; with B.1.2's ordered alternatives, a
  --- committed parse, its group-number condition `groupCond`.
  def ParsesCode (g : GrammarId) (goal : NT) (ps : List(Param)) (src : List(Nat)) (t : Tree) : Prop := if gl.ordered(cx, g) then Committed(gl, cx, P.withGroup(groupCond(gl, cx, P)), g, goal, ps, src, t) else Derives(gl, cx, g, codeAlphabet(P), src, goal, ps, 0, src.length, t)
}
