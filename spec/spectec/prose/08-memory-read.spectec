spec_module ProseMemoryRead
import Ecma.MemoryModel

---! # A read added to a candidate execution
---!
---! A shared read appends its event to an Agent Events Record's [[EventList]] and its Chosen Value Record
---! to [[ChosenValues]] (GetRawBytesFromSharedBlock, GetModifySetValueInBuffer,
---! AtomicCompareExchangeInSharedBlock, CopyDataBlockBytes): `Exec.snoc`, the new event `none` and the
---! others `some`. Over it: the claim of law L2 (`ReadsValid`).

namespace Ecma.MemoryModel {
  var {M : Model} {E : Type}

  --- The new event of a shared read (§29.1, sec-memory-model-fundamentals; §25.1.3.15,
  --- sec-getrawbytesfromsharedblock; §25.1.3.19, sec-getmodifysetvalueinbuffer): its kind and fields.
  syntax NewEvent (M : Model) record {
    kind : Kind;
    order : Order;
    noTear : Bool;
    block : M.Addr;
    byteIndex : M.Math;
    elementSize : M.Math;
    payload : List(M.Math);
    modify : List(M.Math) -> List(M.Math) -> Option(List(M.Math));
  }

  --- A read event of a shared read (§29.1, sec-memory-model-fundamentals; §29.7.3, sec-tear-free-aligned-reads):
  --- a ReadSharedMemory or ReadModifyWriteSharedMemory event, not ~init~, its [[ByteIndex]] a non-negative integer,
  --- aligned where it cannot tear.
  laws NewEvent.IsRead (r : NewEvent(M)) {
    --- sec-memory-model-fundamentals:
    --- "A read event is either a ReadSharedMemory or a ReadModifyWriteSharedMemory."
    --- Reading: the new event's kind is `.read` or `.rmw`.
    law kind : r.kind = .read \/ r.kind = .rmw;
    --- sec-memory-model-fundamentals:
    --- "[[Order]] ~seq-cst~ or ~unordered~"
    --- Reading: a read event's [[Order]] is not ~init~.
    law order : r.order <> .init;
    --- sec-memory-model-fundamentals:
    --- "[[ByteIndex]] a non-negative integer"
    --- Reading: the event's [[ByteIndex]] is a non-negative integer.
    law byteIndex : exists n, r.byteIndex = M.ofNat(n);
    --- sec-tear-free-aligned-reads step 1.a.i:
    --- "Assert: The remainder of dividing readEvent.[[ByteIndex]] by readEvent.[[ElementSize]] is 0."
    --- Reading: when [[NoTear]] is *true*, [[ByteIndex]] is an integer multiple of [[ElementSize]].
    law aligned : r.noTear = true -> M.isInt(M.div(r.byteIndex, r.elementSize)) = true;
  }

  --- The `i`th Agent Events Record `er`, the new event `none` appended where `i` is `k`.
  def EventsRecord.snoc (k i : Nat) (er : EventsRecord(E)) : EventsRecord(Option(E)) := ctor(er.events.map(some) ++ (if i = k then [none] else []), er.syncs.map(fun p => (some(p.1), some(p.2))))

  --- `x` with the event `r` (`none`) appended to the [[EventList]] of its `k`th Agent Events Record,
  --- and the Chosen Value Record of `r` and `cv` to its [[ChosenValues]].
  def Exec.snoc (x : Exec(M, E)) (k : Nat) (r : NewEvent(M)) (cv : List(M.Math)) : Exec(M, Option(E)) {
    records := x.records.mapIdx(EventsRecord.snoc(k));
    chosen := x.chosen.map(fun c => (some(c.1), c.2)) ++ [(none, cv)];
    kind
      | some(e) => x.kind(e)
      | none => r.kind
    end;
    order
      | some(e) => x.order(e)
      | none => r.order
    end;
    noTear
      | some(e) => x.noTear(e)
      | none => r.noTear
    end;
    block
      | some(e) => x.block(e)
      | none => r.block
    end;
    byteIndex
      | some(e) => x.byteIndex(e)
      | none => r.byteIndex
    end;
    elementSize
      | some(e) => x.elementSize(e)
      | none => r.elementSize
    end;
    payload
      | some(e) => x.payload(e)
      | none => r.payload
    end;
    modify
      | some(e) => x.modify(e)
      | none => r.modify
    end;
  }

  --- `rbf`, the new event reading from `ws`.
  def Rbf.snoc (rbf : Rbf(E)) (ws : List(E)) : Rbf(Option(E))
    | some(e) => rbf(e).map(some)
    | none => ws.map(some)
  end

  --- A Relation on the events but the new one.
  def Rel.lift (r : Rel(E)) : Rel(Option(E))
    | some(a), some(b) => r(a, b)
    | _, _ => False
  end

  --- Law L2's claim: with the read `r` appended to the `k`th Agent Events Record, reading its bytes
  --- from `ws`, its Chosen Value Record the byte values ComposeWriteEventBytes composes of them, `x` is a
  --- valid execution with `rbf` and `hsw`.
  def ReadsValid (x : Exec(M, E)) (rbf : Rbf(E)) (hsw : Rel(E)) (k : Nat) (r : NewEvent(M)) (ws : List(E)) : Prop := forall cv, (forall c mem cv, exists n, c = M.ofNat(n)) -> Compose(x, rbf, r.byteIndex, ws, cv) -> ValidWith(x.snoc(k, r, cv), rbf.snoc(ws), Rel.lift(hsw))
}
