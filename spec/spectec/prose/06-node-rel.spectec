spec_module ProseNodeRel
import Ecma.Model
import Ecma.Grammar.Derives
import Ecma.Grammar.StrictCode

---! # Parse Nodes and derivations
---!
---! `Model.NodeRel M src n t`: the model's Parse Node `n` is the derivation tree
---! `t` of `Grammar.Derives` (§5.1.2): the same nonterminal, production,
---! parameters (as a set) and children (its nonterminals', a terminal giving none), and as source text
---! the code points `src i j` of the input elements `t` spans. A token that is an instance of a lexical nonterminal is its lexical
---! derivation, over the token's own code points.

namespace Ecma {
  --- The model's Parse Node `n` is the derivation tree `t` of parser invocation `st` over the code
  --- points `text` (§5.1.2, sec-parsing); `span i j` is the span of `text` that input elements `i` to `j` occupy
  --- (§5.2.3, sec-algorithm-conventions-syntax-directed-operations: from the first's start to the last's end, the
  --- white space and comments between them included).
  relation Model.NodeRel (M : Model) (st : Nat) (text : List(Nat)) : (Nat -> Nat -> Nat times Nat) -> M.Node -> Grammar.Tree -> Prop {
    rule node {span : Nat -> Nat -> Nat times Nat} {n : M.Node} {nt : Grammar.NT} {id : Nat} {ps : List(Grammar.Param)} {i j : Nat} {kids : List(Grammar.Tree)} : Model.NodeRel(M, st, text, span, n, .node(nt, id, ps, i, j, kids)) :- M.nodeNt(n) = nt.ctorIdx, M.nodeProd(n) = id, forall p, p mem M.nodeArgs(n) <=> p mem ps, M.nodeStamp(n) = st, M.nodeSpan(n) = span(i, j), M.seqLen(M.nodeSource(n)) = M.ofNat(Grammar.slice(text, span(i, j).1, span(i, j).2).length), forall (k : Nat), M.seqGet(M.nodeSource(n), M.ofNat(k)) = Grammar.slice(text, span(i, j).1, span(i, j).2)[k]?.map(M.ofNat), M.seqLen(M.nodeKids(n)) = M.ofNat(kids.filter(fun _dot0 => !_dot0.isLeaf).length), forall k, M.seqGet(M.nodeKids(n), M.ofNat(k)).isSome = (k < kids.filter(fun _dot0 => !_dot0.isLeaf).length), forall k t c, kids.filter(fun _dot0 => !_dot0.isLeaf)[k]? = some(t) -> M.seqGet(M.nodeKids(n), M.ofNat(k)) = some(c) -> Model.NodeRel(M, st, text, span, c, t);
    --- a terminal (§5.1.2: its Parse Node has no children)
    rule leaf {span : Nat -> Nat -> Nat times Nat} {n : M.Node} {i j : Nat} : Model.NodeRel(M, st, text, span, n, .leaf(i, j)) :- M.nodeStamp(n) = st, M.nodeSpan(n) = span(i, j), M.seqLen(M.nodeSource(n)) = M.ofNat(Grammar.slice(text, span(i, j).1, span(i, j).2).length), forall (k : Nat), M.seqGet(M.nodeSource(n), M.ofNat(k)) = Grammar.slice(text, span(i, j).1, span(i, j).2)[k]?.map(M.ofNat), M.seqLen(M.nodeKids(n)) = M.ofNat(0);
    --- input element `k` as an instance of a lexical nonterminal: its derivation `t`, over the
    --- element's code points (spans from the element's start)
    rule lex {span : Nat -> Nat -> Nat times Nat} {n : M.Node} {k : Nat} {t : Grammar.Tree} : Model.NodeRel(M, st, text, span, n, .lex(k, t)) :- Model.NodeRel(M, st, text, fun i j => (span(k, k + 1).1 + i, span(k, k + 1).1 + j), n, t);
  }

  --- The span of tokens `i` to `j` of `toks` in the source text: from the start of the first real
  --- token's input element to the end of the last's (a virtual `;` has none).
  def Grammar.tokenSpan (els : List(Grammar.Element)) (toks : List(Grammar.Token)) (i j : Nat) : Nat times Nat := let es := els.filter(fun _dot0 => _dot0.isToken) in let a := toks.take(i).countP(fun _dot0 => _dot0.virt.isNone) in let b := toks.take(j).countP(fun _dot0 => _dot0.virt.isNone) in let start := es[a]?.map(fun _dot0 => _dot0.i).getD(es.getLast?.map(fun _dot0 => _dot0.j).getD(0)) in if a < b then (start, es[b - 1]?.map(fun _dot0 => _dot0.j).getD(start)) else (start, start)

  --- The code points of `src` that tokens `i` to `j` of `toks` span.
  def Grammar.tokenText (src : List(Nat)) (els : List(Grammar.Element)) (toks : List(Grammar.Token)) (i j : Nat) : List(Nat) := Grammar.slice(src, Grammar.tokenSpan(els, toks, i, j).1, Grammar.tokenSpan(els, toks, i, j).2)

  --- What a model's parse is stated against (§5.1, sec-syntactic-and-lexical-grammars): the grammar data, the
  --- context, the code point grammars' primitives, and whether its source text is strict mode code from outside
  --- (§11.2.2, sec-strict-mode-code: eval code of a direct eval contained in strict mode code).
  syntax GrammarCtx record {
    gl : Grammar.GL;
    cx : Grammar.Ctx;
    P : Grammar.CodePrims;
    strict : Bool;
  }

  --- The context of a parser invocation under `pc`: Annex B's grammar, the |Module| goal (B.1.1) and strict
  --- mode code from outside as `pc` says.
  def GrammarCtx.at (G : GrammarCtx) (pc : ParseCx) : GrammarCtx := { G with cx := ctor(pc.module, pc.annexB), strict := pc.strict }

  --- One more than the depth of the tree.
  def Grammar.Tree.height : Grammar.Tree -> Nat
    | .node(_, _, _, _, _, kids) => kids.attach.map(fun ctor(k, _) => k.height).foldl(max, 0) + 1
    | _ => 1
  end

  --- The tree's Parse Nodes as §11.2.2 reads them (`Grammar.NodeView`), `text i j` the code points the
  --- span `i` to `j` matches: a token that is an instance of a lexical nonterminal is one node, its own
  --- derivation not read.
  def Grammar.Tree.view (text : Nat -> Nat -> List(Nat)) : Grammar.NodeView(Grammar.Tree) {
    isA t n := t.nt? == some(n);
    kids
      | .node(_, _, _, _, _, kids) => kids.filter(fun _dot0 => !_dot0.isLeaf)
      | _ => []
    end;
    span := Grammar.Tree.span;
    textIs t cs := text(t.span.1, t.span.2) == cs;
    height := Grammar.Tree.height;
  }

  --- §11.2.2 ("Code is interpreted as strict mode code in the following situations"): the source text
  --- `t` matches is strict mode code by the tree it is in, `up` being its ancestors nearest first
  --- (`Grammar.strictCode`).
  def Grammar.StrictCode (text : Nat -> Nat -> List(Nat)) (up : List(Grammar.Tree)) (t : Grammar.Tree) : Prop := Grammar.strictCode(Grammar.Tree.view(text), up, t) = true

  --- §11.2.2 in a parse of `src` scanned as `els` and `toks`: the source text the node `t` (its ancestors
  --- `up`) matches is strict mode code, from outside or by the tree (`Grammar.StrictCode`).
  def GrammarCtx.StrictIn (G : GrammarCtx) (src : List(Nat)) (els : List(Grammar.Element)) (toks : List(Grammar.Token)) (up : List(Grammar.Tree)) (t : Grammar.Tree) : Prop := G.strict = true \/ Grammar.StrictCode(Grammar.tokenText(src, els, toks), up, t)

  --- The grammar parameters a goal symbol's arguments switch on.
  def ParamsOf (args : List(ParamId times Bool)) (ps : List(Grammar.Param)) : Prop := forall p, p mem ps <=> (p.ctorIdx, true) mem args

  --- §5.1.2, §11.1.6: `t` is a parse of the code points `src` with goal `goal`, and the model's
  --- Parse Node `n` of parser invocation `st` is it: by ParsesText's steps for the syntactic grammar (its tokens named, a node's
  --- source the span of its input elements, white space and comments included), by `ParsesCode` for a code point grammar.
  --- B.1's productions modify those grammars (`GL.overlays`) and are no grammar a goal is parsed in (spec.html:53976, 54038).
  def GrammarCtx.ParseIs (G : GrammarCtx) (M : Model) (st : Nat) (goal : Grammar.NT) (ps : List(Grammar.Param)) (src : List(Nat)) (n : M.Node) (t : Grammar.Tree) : Prop := if G.gl.rulesOf(.syntactic).any(fun _dot0 => _dot0.lhs == goal) then exists els toks, Grammar.Scans(G.gl, G.cx, G.P, src, els) /\ Grammar.GoalsAt(goal, els, toks, t) /\ toks.filter(fun _dot0 => _dot0.virt.isNone) = Grammar.tokensOf(src, els) /\ toks.all(fun k => k.virt.isNone || !k.lt) = true /\ Grammar.ASIOk(G.gl, G.cx, G.P, goal, ps, src, els, toks) /\ Grammar.Sentence(G.gl, G.cx, G.P, goal, ps, toks, t) /\ Grammar.ForHeadersExplicit(toks, t) /\ Grammar.NonStrictOk(G.gl, G.StrictIn(src, els, toks), [], t) /\ Model.NodeRel(M, st, src, Grammar.tokenSpan(els, toks), n, t) else exists g mem Grammar.codeGrammars, G.gl.rulesOf(g).any(fun _dot0 => _dot0.lhs == goal) /\ Grammar.ParsesCode(G.gl, G.cx, G.P, g, goal, ps, src, t) /\ Model.NodeRel(M, st, src, fun i j => (i, j), n, t)

  --- §5.1.2, §11.1.6: `t` is a parse of the code points `src` with goal `goal`: `ParseIs` without the model's
  --- Parse Node.
  def GrammarCtx.Parses (G : GrammarCtx) (goal : Grammar.NT) (ps : List(Grammar.Param)) (src : List(Nat)) (t : Grammar.Tree) : Prop := if G.gl.rulesOf(.syntactic).any(fun _dot0 => _dot0.lhs == goal) then exists els toks, Grammar.Scans(G.gl, G.cx, G.P, src, els) /\ Grammar.GoalsAt(goal, els, toks, t) /\ toks.filter(fun _dot0 => _dot0.virt.isNone) = Grammar.tokensOf(src, els) /\ toks.all(fun k => k.virt.isNone || !k.lt) = true /\ Grammar.ASIOk(G.gl, G.cx, G.P, goal, ps, src, els, toks) /\ Grammar.Sentence(G.gl, G.cx, G.P, goal, ps, toks, t) /\ Grammar.ForHeadersExplicit(toks, t) /\ Grammar.NonStrictOk(G.gl, G.StrictIn(src, els, toks), [], t) else exists g mem Grammar.codeGrammars, G.gl.rulesOf(g).any(fun _dot0 => _dot0.lhs == goal) /\ Grammar.ParsesCode(G.gl, G.cx, G.P, g, goal, ps, src, t)

  --- §5.1.5: `t` is a reparse of the sequence of tokens originally matched over `src` (including any virtual
  --- semicolons §12.10 inserted inside that span) with goal `goal`, and `n` is its Parse Node at `st`.
  def GrammarCtx.CoverIs (G : GrammarCtx) (M : Model) (st : Nat) (goal : Grammar.NT) (ps : List(Grammar.Param)) (src : List(Nat)) (n : M.Node) (t : Grammar.Tree) : Prop := if G.gl.rulesOf(.syntactic).any(fun _dot0 => _dot0.lhs == goal) then exists els toks, Grammar.Scans(G.gl, G.cx, G.P, src, els) /\ Grammar.GoalsAt(goal, els, toks, t) /\ toks.filter(fun _dot0 => _dot0.virt.isNone) = Grammar.tokensOf(src, els) /\ toks.all(fun k => k.virt.isNone || !k.lt) = true /\ Grammar.Sentence(G.gl, G.cx, G.P, goal, ps, toks, t) /\ Grammar.ForHeadersExplicit(toks, t) /\ Grammar.NonStrictOk(G.gl, G.StrictIn(src, els, toks), [], t) /\ Model.NodeRel(M, st, src, Grammar.tokenSpan(els, toks), n, t) else exists g mem Grammar.codeGrammars, G.gl.rulesOf(g).any(fun _dot0 => _dot0.lhs == goal) /\ Grammar.ParsesCode(G.gl, G.cx, G.P, g, goal, ps, src, t) /\ Model.NodeRel(M, st, src, fun i j => (i, j), n, t)

  --- The code points of a List as the model's sequence.
  def Model.seqOfNats (M : Model) (src : List(Nat)) : M.Seq(M.Math) := src.foldl(fun s c => M.seqPush(s, M.ofNat(c)), M.seqNil)

  --- `Model.parse`'s laws (§5.1.2, sec-parsing; §11.1.6, sec-parsetext), stated and never assumed, per invocation
  --- context: a Parse Node it gives is a parse under the grammar in that context, its nodes carrying the
  --- invocation's stamp, and where it gives none no tree is a parse (`GrammarCtx.Parses`).
  laws Model.ParseLaws (M : Model) (G : GrammarCtx) {
    --- sec-parsetext:
    --- "If the parse succeeded and no early errors were found, return the Parse Node (an instance of goalSymbol) at the root of the parse tree resulting from the parse."
    --- sec-parsing: "When a parse is successful, it constructs a parse tree, a rooted tree structure in which each node is a Parse Node."
    --- Reading: a Parse Node the model's parse gives is the root of a parse of the code points with the goal, under the
    --- grammar and the invocation's context, its nodes carrying the invocation's stamp (`GrammarCtx.ParseIs`).
    law sound : forall pc st src (goal : Grammar.NT) args ps n, ParamsOf(args, ps) -> M.parse(pc, st, M.seqOfNats(src), goal.ctorIdx, args) = some(some(n)) -> (exists t, G.at(pc).ParseIs(M, st, goal, ps, src, n, t));
    --- sec-parsing:
    --- "An input stream of terminal symbols can be parsed using a goal symbol when it is matched by that goal symbol with no terminal symbols left over."
    --- Reading: where the model's parse gives no Parse Node, no tree is a parse of the code points with the goal under
    --- the grammar and the invocation's context (`GrammarCtx.Parses`).
    law complete : forall pc st src (goal : Grammar.NT) args ps, ParamsOf(args, ps) -> M.parse(pc, st, M.seqOfNats(src), goal.ctorIdx, args) = some(none) -> (forall t, not G.at(pc).Parses(goal, ps, src, t));
  }

  --- The Parse Nodes of parser invocations in context `pc` (§5.1.2, sec-parsing; §5.1.5, sec-syntactic-grammar):
  --- a parse's result, the covered node the model gives from such a node (`Model.cover`), and their descendants.
  relation Model.Parsed (M : Model) (pc : ParseCx) : M.Node -> Prop {
    rule parse {st : Nat} {src : M.Seq(M.Math)} {goal : NtId} {args : List(ParamId times Bool)} {n : M.Node} : Model.Parsed(M, pc, n) :- M.parse(pc, st, src, goal, args) = some(some(n));
    rule cover {st : Nat} {n : M.Node} {k : NtId} {args : List(ParamId times Bool)} {r : M.Node} : Model.Parsed(M, pc, r) :- Model.Parsed(M, pc, n), M.cover(pc, st, n, k, args) = some(r);
    rule desc {n d : M.Node} : Model.Parsed(M, pc, d) :- Model.Parsed(M, pc, n), d mem seqList(M.nodeDescendants(n));
  }

  --- `Model.cover`'s law (§5.1.5, sec-syntactic-grammar: "P must cover K"), stated and never assumed, per invocation
  --- context: the node it gives from a Parse Node `n` of parser invocations in that context, with a goal and
  --- arguments, is a parse of `n`'s source text with that goal under the grammar in that context, its nodes carrying
  --- the new invocation's stamp: what `ParseLaws.sound` says of `Model.parse`'s node for that text.
  --- Nothing is said of a node no parser invocation made, nor of one made in another context.
  laws Model.CoverLaws (M : Model) (G : GrammarCtx) {
    --- sec-syntactic-grammar:
    --- "The sequence of tokens originally matched by p is parsed again using n as the goal symbol. If n takes grammatical parameters, then they are set to the same values used when p was originally parsed."
    --- Reading: the covered node the model gives from a Parse Node `n` of a parse in this context is a reparse of `n`'s
    --- matched tokens with the goal and the arguments, its nodes carrying the new invocation's stamp
    --- (`GrammarCtx.CoverIs`).
    law sound : forall pc st n (goal : Grammar.NT) args ps src r, Model.Parsed(M, pc, n) -> ParamsOf(args, ps) -> M.nodeSource(n) = M.seqOfNats(src) -> M.cover(pc, st, n, goal.ctorIdx, args) = some(r) -> (exists t, G.at(pc).CoverIs(M, st, goal, ps, src, r, t));
  }

  namespace Grammar {
    --- The nonterminal occurrences of a right-hand side in written order, with its optional symbols'
    --- presences `m`: each with whether it is present.
    def occsOf : List(Item) -> List(Bool) -> List(NT times Bool)
      | [], _ => []
      | .sym(.nt(n, _), true) :: is, b :: bs => (n, b) :: occsOf(is, bs)
      | .sym(.t(_), true) :: is, _ :: bs => occsOf(is, bs)
      | .sym(.nt(n, _), false) :: is, bs => (n, true) :: occsOf(is, bs)
      | .butNot(.nt(n, _), _) :: is, bs => (n, true) :: occsOf(is, bs)
      | _ :: is, bs => occsOf(is, bs)
    end

    --- The right-hand side with production id `id` (`GL.byId`).
    def prodAt (gl : GL) (id : Nat) : Option(Prod) := gl.byId.toList[id]?.join

    --- The nonterminal occurrences of production `id`'s right-hand side, with their presences.
    def occsAt (gl : GL) (id : Nat) : List(NT times Bool) := prodAt(gl, id).bind(fun p => p.altOf.map(fun a => occsOf(a.rhs, p.mask))).getD([])

    --- The written occurrences, each with its child: a present one takes the next of `kids`.
    def fillOccs {N : Type} : List(NT times Bool) -> List(N) -> List(Nat times Option(N))
      | [], _ => []
      | (n, true) :: os, k :: ks => (n.ctorIdx, some(k)) :: fillOccs(os, ks)
      | (n, _) :: os, ks => (n.ctorIdx, none) :: fillOccs(os, ks)
    end
  }

  --- The laws of `nodeChild` and `nodeDescendants` (§5.1.2, sec-parsing), over the grammar `G`: a written
  --- occurrence's child is the next child with its nonterminal; in a parse and in a covered node the model
  --- gives, the absent ones are the production's absent optional symbols; the descendants are the children's
  --- pre-order flattening.
  laws Model.NodeLaws (M : Model) (G : GrammarCtx) {
    --- sec-parsing:
    --- "Moreover, it has zero or more children, one for each symbol on the production's right-hand side: each child is a Parse Node that is an instance of the corresponding symbol."
    --- Reading: the written occurrences of `nt`, first to last, have as children the node's children whose
    --- nonterminal is `nt`, in order.
    law child_kids : forall n nt, exists (os : List(Option(M.Node))), (forall k, M.nodeChild(n, nt, k) = os[k]?) /\ os.filterMap(id) = seqList(M.nodeKids(n)).filter(fun _dot0 => M.nodeNt(_dot0) == nt);
    --- sec-parsing:
    --- "Moreover, it has zero or more children, one for each symbol on the production's right-hand side: each child is a Parse Node that is an instance of the corresponding symbol."
    --- Reading: "the |X| of" a node of a parse is the child of the `k`-th written
    --- occurrence of `nt` in its production, none where that occurrence is an absent optional symbol.
    law child_parse : forall pc st src goal args n d nt k, M.parse(pc, st, M.seqOfNats(src), goal, args) = some(some(n)) -> d = n \/ d mem seqList(M.nodeDescendants(n)) -> M.nodeChild(d, nt, k) = Grammar.fillOccs(Grammar.occsAt(G.gl, M.nodeProd(d)), seqList(M.nodeKids(d))).filter(fun _dot0 => _dot0.1 == nt).map(fun _dot0 => _dot0.2)[k]?;
    --- sec-parsing:
    --- "Moreover, it has zero or more children, one for each symbol on the production's right-hand side: each child is a Parse Node that is an instance of the corresponding symbol."
    --- Reading: the same in a covered node the model gives (`Model.cover`) and its descendants, whatever the cover.
    law child_cover : forall pc st c goal args n d nt k, M.cover(pc, st, c, goal, args) = some(n) -> d = n \/ d mem seqList(M.nodeDescendants(n)) -> M.nodeChild(d, nt, k) = Grammar.fillOccs(Grammar.occsAt(G.gl, M.nodeProd(d)), seqList(M.nodeKids(d))).filter(fun _dot0 => _dot0.1 == nt).map(fun _dot0 => _dot0.2)[k]?;
    --- sec-syntactic-grammar:
    --- "No early error rules are applied to p or any of its descendants."
    --- Reading: a node's descendants are its children, each followed by its own descendants (pre-order).
    law descendants : forall n, seqList(M.nodeDescendants(n)) = seqList(M.nodeKids(n)).flatMap(fun c => c :: seqList(M.nodeDescendants(c)));
  }
}
