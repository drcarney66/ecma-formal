def @sec-createiterresultobject "CreateIteratorResultObject" (kind ao params [value : #"ECMAScript language value", done : Boolean] -> Object that sat @ph-type-conforms-iterator-result()) vars [value, done, #"obj"] {
  let #"obj" = @sec-ordinaryobjectcreate(intrinsic [[Object.prototype]])
  perform ! @sec-createdatapropertyorthrow(#"obj", "value", value)
  perform ! @sec-createdatapropertyorthrow(#"obj", "done", done)
  return #"obj"
}

def @sec-createlistiteratorRecord "CreateListIteratorRecord" (kind ao params [#"list" : list<#"ECMAScript language value">] -> #"Iterator Record") vars [#"list", #"closure", value, iterator] {
  let #"closure" = closure 0
  let iterator = @sec-createiteratorfromclosure(#"closure", ~empty~, intrinsic [[Iterator.prototype]])
  return record #"Iterator Record" { [[Iterator]]: iterator, [[NextMethod]]: intrinsic [[GeneratorPrototype.next]], [[Done]]: false }
  closure abstract params none captures [#"list"] {
    for_each value in #"list" {
      perform ? @sec-generatoryield(@sec-createiterresultobject(value, false))
    }
    return @sec-normalcompletion(undefined)
  }
}

def @sec-iteratortolist "IteratorToList" (kind ao params [iteratorRecord : #"Iterator Record"] -> completion<list<#"ECMAScript language value">> | #"throw completion") vars [iteratorRecord, values, next] {
  let values = $ListNew()
  repeat {
    let next = ? @sec-iteratorstepvalue(iteratorRecord)
    if next is val {~done~} {
      return values
    }
    perform $Append(?next, ?values)
  }
}

def @sec-adddisposableresource "AddDisposableResource" (kind ao params [disposableResourceStack : list<#"DisposableResource Record">, value : #"ECMAScript language value", #"kind" : val(~sync-dispose~) | val(~async-dispose~), #"method" : #"function object" opt] -> completion<val(~unused~)> | #"throw completion") vars [disposableResourceStack, value, #"kind", #"method", resource] {
  if #"method" sat $Present() {
    assert value is val {undefined}
    let resource = record #"DisposableResource Record" { [[ResourceValue]]: undefined, [[Kind]]: #"kind", [[DisposeMethod]]: #"method" }
  }
  else_if value is val {null; undefined} {
    if #"kind" is val {~sync-dispose~} -> return ~unused~
    note "When _value_ is either *null* or *undefined* and _kind_ is ~async-dispose~, we record that the resource was evaluated to ensure we will still perform an Await when resources are later disposed."
    let resource = record #"DisposableResource Record" { [[ResourceValue]]: undefined, [[Kind]]: ~async-dispose~, [[DisposeMethod]]: undefined }
  }
  else {
    set var #"method" = ? @sec-getdisposemethod(value, #"kind")
    if #"method" is val {undefined} -> throw @ph-new-error([[TypeError]])
    let resource = record #"DisposableResource Record" { [[ResourceValue]]: value, [[Kind]]: #"kind", [[DisposeMethod]]: #"method" }
  }
  perform $Append(?resource, ?disposableResourceStack)
  return ~unused~
}

def @sec-getdisposemethod "GetDisposeMethod" (kind ao params [value : #"ECMAScript language value", #"kind" : val(~sync-dispose~) | val(~async-dispose~)] -> completion<#"function object" | val(undefined)> | #"throw completion") vars [value, #"kind", asyncMethod, syncMethod, #"closure", #"obj", #"#the *this* value", #"#NewTarget", #"#the List of arguments that was passed to this function by [[Call]] or [[Construct]]", promiseCapability, result] {
  if value is not ty {Object} -> throw @ph-new-error([[TypeError]])
  if #"kind" is val {~sync-dispose~} -> return ? @sec-getmethod(value, $WellKnownSymbol("Symbol.dispose"))
  assert #"kind" is val {~async-dispose~}
  let asyncMethod = ? @sec-getmethod(value, $WellKnownSymbol("Symbol.asyncDispose"))
  if asyncMethod is not val {undefined} -> return asyncMethod
  let syncMethod = ? @sec-getmethod(value, $WellKnownSymbol("Symbol.dispose"))
  if syncMethod is val {undefined} -> return undefined
  let #"closure" = closure 0
  note "This function is not observable to user code. It is used to ensure that a Promise returned from a synchronous `%Symbol.dispose%` method will not be awaited and that a synchronous exception will be translated to a rejected Promise."
  return @sec-createbuiltinfunction(#"closure", 0, "", [])
  closure abstract params none captures [syncMethod] frame (#"#the *this* value", #"#NewTarget", #"#the List of arguments that was passed to this function by [[Call]] or [[Construct]]") {
    let #"obj" = #"#the *this* value"
    let promiseCapability = ! @sec-newpromisecapability(intrinsic [[Promise]])
    let result = @sec-completion-ao(@sec-call(syncMethod, #"obj"))
    block {
      assert result is ty {#"Completion Record"}
      if result is ty {#"abrupt completion"} {
        perform ? @sec-call(promiseCapability[[Reject]], undefined, [result[[Value]]])
        return promiseCapability[[Promise]]
      }
      set var result = ! result
    }
    perform ! @sec-call(promiseCapability[[Resolve]], undefined, [undefined])
    return promiseCapability[[Promise]]
  }
}

def @sec-disposeresources "DisposeResources" (kind ao params [disposableResourceStack : list<#"DisposableResource Record">, #"completion" : completion<#"ECMAScript language value" | val(~empty~)> | #"abrupt completion"] -> completion<#"ECMAScript language value" | val(~empty~)> | #"abrupt completion") vars [disposableResourceStack, #"completion", needsAwait, hasAwaited, outputCompletion, resource, value, #"kind", #"method", result, suppressed, error] {
  let needsAwait = false
  let hasAwaited = false
  let outputCompletion = #"completion"
  for_each resource rev in disposableResourceStack {
    let value = resource[[ResourceValue]]
    let #"kind" = resource[[Kind]]
    let #"method" = resource[[DisposeMethod]]
    if #"kind" is val {~sync-dispose~} and needsAwait is val {true} and hasAwaited is val {false} {
      perform ! @await(undefined)
      set var needsAwait = false
    }
    if #"method" is not val {undefined} {
      let result = @sec-completion-ao(@sec-call(#"method", value))
      if result is ty {#"normal completion"} and #"kind" is val {~async-dispose~} {
        set var result = @sec-completion-ao(@await(result[[Value]]))
        set var hasAwaited = true
      }
      if result is ty {#"throw completion"} {
        if outputCompletion is ty {#"throw completion"} {
          set var result = result[[Value]]
          let suppressed = outputCompletion[[Value]]
          let error = @ph-new-error(err [[SuppressedError]])
          perform @sec-createnonenumerabledatapropertyorthrow(error, "error", result)
          perform @sec-createnonenumerabledatapropertyorthrow(error, "suppressed", suppressed)
          set var outputCompletion = @sec-throwcompletion(error)
        }
        else {
          set var outputCompletion = result
        }
      }
    }
    else {
      assert #"kind" is val {~async-dispose~}
      set var needsAwait = true
      note "This can only indicate a case where either *null* or *undefined* was the initialized value of an `await using` declaration."
    }
  }
  if needsAwait is val {true} and hasAwaited is val {false} {
    perform ! @await(undefined)
  }
  note "At this point _disposableResourceStack_ will never be used again. The contents of _disposableResourceStack_ can be discarded in implementations, such as by garbage collection."
  return ? outputCompletion
}

sdo_row @sec-runtime-semantics-stringnumericvalue StringNumericValue form alg {
  prods [p"NumericString 0 StringNumericLiteral ::: StrWhiteSpace?", p"NumericString 1 StringNumericLiteral ::: StrWhiteSpace?"]
  keys ["StringNumericLiteral ::: StrWhiteSpace?"]
  vars []
  steps {
    return num_f(+0)
  }
}

sdo_row @sec-runtime-semantics-stringnumericvalue#1 StringNumericValue form alg {
  prods [p"NumericString 00 StringNumericLiteral ::: StrWhiteSpace? StrNumericLiteral StrWhiteSpace?", p"NumericString 01 StringNumericLiteral ::: StrWhiteSpace? StrNumericLiteral StrWhiteSpace?", p"NumericString 10 StringNumericLiteral ::: StrWhiteSpace? StrNumericLiteral StrWhiteSpace?", p"NumericString 11 StringNumericLiteral ::: StrWhiteSpace? StrNumericLiteral StrWhiteSpace?"]
  keys ["StringNumericLiteral ::: StrWhiteSpace? StrNumericLiteral StrWhiteSpace?"]
  vars []
  steps {
    return sdo StringNumericValue(child 5 |StrNumericLiteral|)
  }
}

sdo_row @sec-runtime-semantics-stringnumericvalue#2 StringNumericValue form alg {
  prods [p"NumericString - StrNumericLiteral ::: NonDecimalIntegerLiteral[~Sep]"]
  keys ["StrNumericLiteral ::: NonDecimalIntegerLiteral"]
  vars []
  steps {
    return $𝔽(sdo MV(child 5 |NonDecimalIntegerLiteral|))
  }
}

sdo_row @sec-runtime-semantics-stringnumericvalue#3 StringNumericValue form alg {
  prods [p"NumericString - StrDecimalLiteral ::: `-` StrUnsignedDecimalLiteral"]
  keys ["StrDecimalLiteral ::: `-` StrUnsignedDecimalLiteral"]
  vars [a]
  steps {
    let a = sdo StringNumericValue(child 5 |StrUnsignedDecimalLiteral|)
    if a is val {num_f(+0)} -> return num_f(-0)
    return neg a
  }
}

sdo_row @sec-runtime-semantics-stringnumericvalue#4 StringNumericValue form alg {
  prods [p"NumericString - StrUnsignedDecimalLiteral ::: `Infinity`"]
  keys ["StrUnsignedDecimalLiteral ::: `Infinity`"]
  vars []
  steps {
    return num_f(+∞)
  }
}

sdo_row @sec-runtime-semantics-stringnumericvalue#5 StringNumericValue form alg {
  prods [p"NumericString 00 StrUnsignedDecimalLiteral ::: DecimalDigits[~Sep] `.` DecimalDigits[~Sep]? ExponentPart[~Sep]?", p"NumericString 01 StrUnsignedDecimalLiteral ::: DecimalDigits[~Sep] `.` DecimalDigits[~Sep]? ExponentPart[~Sep]?", p"NumericString 10 StrUnsignedDecimalLiteral ::: DecimalDigits[~Sep] `.` DecimalDigits[~Sep]? ExponentPart[~Sep]?", p"NumericString 11 StrUnsignedDecimalLiteral ::: DecimalDigits[~Sep] `.` DecimalDigits[~Sep]? ExponentPart[~Sep]?"]
  keys ["StrUnsignedDecimalLiteral ::: DecimalDigits `.` DecimalDigits? ExponentPart?"]
  vars [a, b, n, e]
  steps {
    let a = sdo MV(child 0 |DecimalDigits|)
    if child 1 |DecimalDigits| sat $Present() {
      let b = sdo MV(child 1 |DecimalDigits|)
      let n = $Count(data choice 2, child 1 |DecimalDigits|)
    }
    else {
      let b = 0
      let n = 0
    }
    if_else child 5 |ExponentPart| sat $Present() { let e = sdo MV(child 5 |ExponentPart|) } else { let e = 0 }
    return @formal-rounddecimalmv(a * 10 ^ n + b, e - n)
  }
}

sdo_row @sec-runtime-semantics-stringnumericvalue#6 StringNumericValue form alg {
  prods [p"NumericString 0 StrUnsignedDecimalLiteral ::: `.` DecimalDigits[~Sep] ExponentPart[~Sep]?", p"NumericString 1 StrUnsignedDecimalLiteral ::: `.` DecimalDigits[~Sep] ExponentPart[~Sep]?"]
  keys ["StrUnsignedDecimalLiteral ::: `.` DecimalDigits ExponentPart?"]
  vars [b, e, n]
  steps {
    let b = sdo MV(child 5 |DecimalDigits|)
    if_else child 5 |ExponentPart| sat $Present() { let e = sdo MV(child 5 |ExponentPart|) } else { let e = 0 }
    let n = $Count(data choice 2, child 5 |DecimalDigits|)
    return @formal-rounddecimalmv(b, e - n)
  }
}

sdo_row @sec-runtime-semantics-stringnumericvalue#7 StringNumericValue form alg {
  prods [p"NumericString 0 StrUnsignedDecimalLiteral ::: DecimalDigits[~Sep] ExponentPart[~Sep]?", p"NumericString 1 StrUnsignedDecimalLiteral ::: DecimalDigits[~Sep] ExponentPart[~Sep]?"]
