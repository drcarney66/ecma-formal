  prods [p"RegExp - ClassAtom :: `-`", p"RegExp - ClassAtomNoDash :: SourceCharacter but not one of `\\` or `]` or `-`", p"AnnexB - ClassAtomNoDash :: SourceCharacter but not one of `\\` or `]` or `-`", p"RegExp - ClassEscape :: `b`", p"AnnexB - ClassEscape :: `b`", p"RegExp - ClassEscape :: [+UnicodeMode] `-`", p"AnnexB - ClassEscape :: [+UnicodeMode] `-`", p"RegExp - ClassEscape :: CharacterEscape[?UnicodeMode]", p"AnnexB - ClassEscape :: CharacterEscape[?UnicodeMode, ?NamedCaptureGroups]"]
  keys ["\n          ClassAtom ::\n            `-`\n\n          ClassAtomNoDash ::\n            SourceCharacter but not one of `\\` or `]` or `-`\n\n          ClassEscape ::\n            `b`\n            `-`\n            CharacterEscape\n        "]
  vars []
  steps {
