-- ECMA-262 SpecTec Clauses: S22

def @sec-string-constructor-string-value "String" (kind builtin params [value]) vars [#"this value", NewTarget, value, string] {
  if value fails $Present() {
    let string = $"the empty String"()
  }
  else {
    if new_target is val {undefined} and value is ty {Symbol} -> return @sec-symboldescriptivestring(value)
    let string = ? @sec-tostring(value)
  }
  if new_target is val {undefined} -> return string
  return @sec-stringcreate(string, ? @sec-getprototypefromconstructor(new_target, "%String.prototype%"))
}

def @sec-string.fromcharcode "String.fromCharCode" (kind builtin params [codeUnits rest]) vars [#"this value", NewTarget, codeUnits, result, next, nextCU] {
  let result = $"the empty String"()
  for_each next in codeUnits {
    let nextCU = $UnitOrPointOf(data choice 1, $ℝ(? @sec-touint16(next)))
    set var result = $"string-concatenation"(result, nextCU)
  }
  return result
}

def @sec-string.fromcodepoint "String.fromCodePoint" (kind builtin params [codePoints rest]) vars [#"this value", NewTarget, codePoints, result, next, nextCP] {
  let result = $"the empty String"()
  for_each next in codePoints {
    let nextCP = ? @sec-tonumber(next)
    if nextCP is not ty {#"integral Number"} -> throw @ph-new-error([[RangeError]])
    if $ℝ(nextCP) < 0 or $ℝ(nextCP) > math(hex(1114111, "10FFFF")) -> throw @ph-new-error([[RangeError]])
    set var result = $"string-concatenation"(result, @sec-utf16encodecodepoint($ℝ(nextCP)))
  }
  assert_if codePoints sat $IsEmpty() then result is val {$"the empty String"()}
  return result
}

def @sec-string.raw "String.raw" (kind builtin params [template, substitutions rest]) vars [#"this value", NewTarget, template, substitutions, substitutionCount, cooked, literals, literalCount, result, nextIndex, nextLiteralValue, nextLiteral, nextSubValue, nextSub] {
  let substitutionCount = $ListLen(?substitutions)
  let cooked = ? @sec-toobject(template)
  let literals = ? @sec-toobject(? @sec-get-o-p(cooked, "raw"))
  let literalCount = ? @sec-lengthofarraylike(literals)
  if literalCount <= 0 -> return $"the empty String"()
  let result = $"the empty String"()
  let nextIndex = 0
  repeat {
    let nextLiteralValue = ? @sec-get-o-p(literals, ! @sec-tostring($𝔽(nextIndex)))
    let nextLiteral = ? @sec-tostring(nextLiteralValue)
    set var result = $"string-concatenation"(result, nextLiteral)
    if nextIndex + 1 == literalCount -> return result
    if nextIndex < substitutionCount {
      let nextSubValue = substitutions[nextIndex]
      let nextSub = ? @sec-tostring(nextSubValue)
      set var result = $"string-concatenation"(result, nextSub)
    }
    set var nextIndex = nextIndex + 1
  }
}

def @sec-string.prototype.at "String.prototype.at" (kind builtin params [index]) vars [#"this value", NewTarget, index, thisValue, string, length, k] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let length = $StrLen(?string)
  let k = ? @sec-toabsoluteindex(index, length)
  if k < 0 or k >= length -> return undefined
  return $Substring(?string, ?k, k + 1)
}

def @sec-string.prototype.charat "String.prototype.charAt" (kind builtin params [position]) vars [#"this value", NewTarget, position, thisValue, string, size] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  set var position = ? @sec-tointegerorinfinity(position)
  let size = $StrLen(?string)
  if position < 0 or position >= size -> return $"the empty String"()
  return $Substring(?string, ?position, position + 1)
}

def @sec-string.prototype.charcodeat "String.prototype.charCodeAt" (kind builtin params [position]) vars [#"this value", NewTarget, position, thisValue, string, size] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  set var position = ? @sec-tointegerorinfinity(position)
  let size = $StrLen(?string)
  if position < 0 or position >= size -> return nan
  return $NumberFor($NumericValue($UnitAt(?position, @ph-the-string(data choice 1, ?string))))
}

def @sec-string.prototype.codepointat "String.prototype.codePointAt" (kind builtin params [position]) vars [#"this value", NewTarget, position, thisValue, string, size, codePoint] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  set var position = ? @sec-tointegerorinfinity(position)
  let size = $StrLen(?string)
  if position < 0 or position >= size -> return undefined
  let codePoint = @sec-codepointat(string, position)
  return $𝔽(codePoint[[CodePoint]])
}

def @sec-string.prototype.concat "String.prototype.concat" (kind builtin params [args rest]) vars [#"this value", NewTarget, args, thisValue, string, result, next, nextString] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let result = string
  for_each next in args {
    let nextString = ? @sec-tostring(next)
    if $StringTooLarge($StrLen(?result) + $StrLen(?nextString)) is val {true} -> throw @ph-new-error([[RangeError]])
    set var result = $"string-concatenation"(result, nextString)
  }
  return result
}

def @sec-string.prototype.endswith "String.prototype.endsWith" (kind builtin params [searchString, endPosition opt]) vars [#"this value", NewTarget, searchString, endPosition, thisValue, string, isRegexp, length, end, searchLength, start, substring] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let isRegexp = ? @sec-isregexp(searchString)
  if isRegexp is val {true} -> throw @ph-new-error([[TypeError]])
  set var searchString = ? @sec-tostring(searchString)
  let length = $StrLen(?string)
  if_else endPosition is val {undefined} { let end = length } else { let end = $clamping(? @sec-tointegerorinfinity(endPosition), 0, ?length) }
  let searchLength = $StrLen(?searchString)
  if searchLength == 0 -> return true
  let start = end - searchLength
  if start < 0 -> return false
  let substring = $Substring(?string, ?start, ?end)
  if substring is val {searchString} -> return true
  return false
}

def @sec-string.prototype.includes "String.prototype.includes" (kind builtin params [searchString, position opt]) vars [#"this value", NewTarget, searchString, position, thisValue, string, isRegexp, length, start, index] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let isRegexp = ? @sec-isregexp(searchString)
  if isRegexp is val {true} -> throw @ph-new-error([[TypeError]])
  set var searchString = ? @sec-tostring(searchString)
  let length = $StrLen(?string)
  let start = $clamping(? @sec-tointegerorinfinity(position), 0, ?length)
  assert_if position is val {undefined} then start is val {0}
  let index = @sec-stringindexof(string, searchString, start)
  if index is val {~not-found~} -> return false
  return true
}

def @sec-string.prototype.indexof "String.prototype.indexOf" (kind builtin params [searchString, position opt]) vars [#"this value", NewTarget, searchString, position, thisValue, string, length, start, result] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  set var searchString = ? @sec-tostring(searchString)
  let length = $StrLen(?string)
  let start = $clamping(? @sec-tointegerorinfinity(position), 0, ?length)
  assert_if position is val {undefined} then start is val {0}
  let result = @sec-stringindexof(string, searchString, start)
  if result is val {~not-found~} -> return num_f(-1)
  return $𝔽(result)
}

def @sec-string.prototype.iswellformed "String.prototype.isWellFormed" (kind builtin params []) vars [#"this value", NewTarget, thisValue, string] {
