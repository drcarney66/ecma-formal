sdo_row @sec-compilepattern CompilePattern form alg {
  prods [p"RegExp - Pattern :: Disjunction[?UnicodeMode, ?UnicodeSetsMode, ?NamedCaptureGroups]"]
  keys ["Pattern :: Disjunction"]
  vars [regexpRecord, m, input, index, c, y, capability, x]
  steps {
    let m = sdo CompileSubpattern(child 5 |Disjunction|; regexpRecord, ~forward~)
    return closure 0
  }
  closure abstract params [input, index] captures [regexpRecord, m] {
    assert input is ty {list<character that sat @ph-character-of-pattern(?regexpRecord)>}
    assert expr $Chain(0, data choice 1, ?index, data choice 1, $ListLen(?input))
    let c = closure 1
    let capability = $OneIndexedList(regexpRecord[[CapturingGroupsCount]], undefined)
    let x = record MatchState { [[Input]]: input, [[EndIndex]]: index, [[Captures]]: capability }
    return m(x, c)
  }
  closure matcher_continuation params [y] captures [] {
    assert y is ty {MatchState}
    return y
  }
}

