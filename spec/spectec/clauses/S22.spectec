def @sec-parsepattern "ParsePattern" (kind ao params [patternText : seq<#"Unicode code point">, u : Boolean, v : Boolean] -> #"Parse Node" | pred(sat @ph-type-syntax-errors())) vars [patternText, u, v, parseResult] {
  if expr $"the host is a web browser"(data choice 0, clause @sec-regular-expressions-patterns) -> return @sec-parsepattern-annexb(patternText, u, v)
  if v is val {true} and u is val {true} {
    let parseResult = @ph-syntax-errors()
  }
  else_if v is val {true} {
    let parseResult = @sec-parsetext(patternText, |Pattern[+UnicodeMode, +UnicodeSetsMode, +NamedCaptureGroups]|)
  }
  else_if u is val {true} {
    let parseResult = @sec-parsetext(patternText, |Pattern[+UnicodeMode, ~UnicodeSetsMode, +NamedCaptureGroups]|)
  }
  else {
    let parseResult = @sec-parsetext(patternText, |Pattern[~UnicodeMode, ~UnicodeSetsMode, +NamedCaptureGroups]|)
  }
  return parseResult
}

def @sec-regexp-pattern-flags "RegExp" (kind builtin params [patternOrRegexp, flags]) vars [#"this value", NewTarget, patternOrRegexp, flags, patternIsRegExp, newTarget, patternCtor, patternSource, #"obj"] {
