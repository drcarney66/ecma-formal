sdo_row @sec-compiletocharset#32 CompileToCharSet form alg {
  prods [p"RegExp - ClassStringDisjunctionContents :: ClassString"]
  keys ["ClassStringDisjunctionContents :: ClassString"]
  vars [regexpRecord, s]
  steps {
    let s = sdo CompileClassSetString(child 5 |ClassString|; regexpRecord)
    return @ph-charset-one-string(?s)
  }
}

sdo_row @sec-compiletocharset#33 CompileToCharSet form alg {
  prods [p"RegExp - ClassStringDisjunctionContents :: ClassString `|` ClassStringDisjunctionContents"]
  keys ["ClassStringDisjunctionContents :: ClassString `|` ClassStringDisjunctionContents"]
  vars [regexpRecord, s, charSet, otherSet]
  steps {
    let s = sdo CompileClassSetString(child 5 |ClassString|; regexpRecord)
    let charSet = @ph-charset-one-string(?s)
    let otherSet = sdo CompileToCharSet(child 5 |ClassStringDisjunctionContents|; regexpRecord)
    return $CharSetUnion(data choice 0, ?charSet, ?otherSet)
  }
}

sdo_row @sec-compiletocharset#34 CompileToCharSet form alg {
  prods [p"RegExp - ClassSetCharacter :: [lookahead ∉ ClassSetReservedDoublePunctuator] SourceCharacter but not ClassSetSyntaxCharacter", p"RegExp - ClassSetCharacter :: `\\` CharacterEscape[+UnicodeMode]", p"RegExp - ClassSetCharacter :: `\\` ClassSetReservedPunctuator"]
  keys ["\n          ClassSetCharacter ::\n            SourceCharacter but not ClassSetSyntaxCharacter\n            `\\` CharacterEscape\n            `\\` ClassSetReservedPunctuator\n        "]
  vars [regexpRecord, charValue, char]
  steps {
    let charValue = sdo CharacterValue(call_at @ph-this-nt(|ClassSetCharacter|))
    let char = $Char(?charValue)
    return $CharSetOne(?char)
  }
}

sdo_row @sec-compiletocharset#35 CompileToCharSet form alg {
  prods [p"RegExp - ClassSetCharacter :: `\\b`"]
  keys ["ClassSetCharacter :: `\\b`"]
  vars [regexpRecord]
  steps {
    return $CharSetOne(cp(8, "0008", "BACKSPACE"))
  }
}

sdo_row @sec-compileclasssetstring CompileClassSetString form alg {
  prods [p"RegExp - ClassString :: [empty]"]
  keys ["ClassString :: [empty]"]
