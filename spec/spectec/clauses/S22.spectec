  steps {
    return @ph-empty-character-sequence(data choice 1)
  }
}

sdo_row @sec-compileclasssetstring#1 CompileClassSetString form alg {
  prods [p"RegExp - ClassString :: NonEmptyClassString"]
  keys ["ClassString :: NonEmptyClassString"]
  vars [regexpRecord]
  steps {
    return sdo CompileClassSetString(child 5 |NonEmptyClassString|; regexpRecord)
  }
}

sdo_row @sec-compileclasssetstring#2 CompileClassSetString form alg {
  prods [p"RegExp 0 NonEmptyClassString :: ClassSetCharacter NonEmptyClassString?", p"RegExp 1 NonEmptyClassString :: ClassSetCharacter NonEmptyClassString?"]
  keys ["NonEmptyClassString :: ClassSetCharacter NonEmptyClassString?"]
  vars [regexpRecord, cs, s1, s2]
  steps {
    let cs = sdo CompileToCharSet(child 5 |ClassSetCharacter|; regexpRecord)
    let s1 = @ph-single-charset-element(?cs)
    if child 5 |NonEmptyClassString| sat $Present() {
      let s2 = sdo CompileClassSetString(child 5 |NonEmptyClassString|; regexpRecord)
      return @ph-concatenation([s1, s2])
    }
    return s1
  }
}

