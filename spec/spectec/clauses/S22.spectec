sdo_row @sec-compileassertion CompileAssertion form alg {
  prods [p"RegExp - Assertion :: `^`", p"AnnexB - Assertion :: `^`"]
  keys ["Assertion :: `^`"]
  vars [regexpRecord, matchState, continue, input, e]
  steps {
    return closure 0
  }
  closure matcher params [matchState, continue] captures [regexpRecord] {
    assert matchState is ty {MatchState}
    assert continue is ty {MatcherContinuation}
    let input = matchState[[Input]]
    let e = matchState[[EndIndex]]
    if e == 0 or regexpRecord[[Multiline]] is val {true} and $Char(input[e - 1]) sat @ph-matched-by(|LineTerminator|) {
      return continue(matchState)
    }
    return ~failure~
  }
}

