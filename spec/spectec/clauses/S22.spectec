def @sec-string.prototype.lastindexof "String.prototype.lastIndexOf" (kind builtin params [searchString, position opt]) vars [#"this value", NewTarget, searchString, position, thisValue, string, numberPosition, length, searchLength, maxStart, start, result] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  set var searchString = ? @sec-tostring(searchString)
  let numberPosition = ? @sec-tonumber(position)
  let length = $StrLen(?string)
  let searchLength = $StrLen(?searchString)
  let maxStart = length - searchLength
  if maxStart < 0 -> return num_f(-1)
  if_else numberPosition is val {nan} { let start = maxStart } else { let start = $clamping(! @sec-tointegerorinfinity(numberPosition), 0, ?maxStart) }
  assert_if position is val {undefined} then start is val {maxStart}
  let result = @sec-stringlastindexof(string, searchString, start)
  if result is val {~not-found~} -> return num_f(-1)
  return $𝔽(result)
}

def @sec-string.prototype.localecompare "String.prototype.localeCompare" (kind builtin params [#"that", reserved1 opt, reserved2 opt]) vars [#"this value", NewTarget, #"that", reserved1, reserved2, thisValue, string, thatValue] {
