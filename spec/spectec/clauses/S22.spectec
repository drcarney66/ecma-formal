      note "Escaping a leading digit ensures that output corresponds with pattern text which may be used after a `\\0` character escape or a |DecimalEscape| such as `\\1` and still match _string_ rather than be interpreted as an extension of the preceding escape sequence. Escaping a leading ASCII letter does the same for the context after `\\c`."
      let numericValue = $NumericValue(?codePoint)
      let #"hex" = @sec-numeric-types-number-tostring($𝔽(numericValue), 16)
      assert $StrLen(?#"hex") is val {2}
      set var escaped = $"string-concatenation"($CodeUnit(cu(92, "005C", "REVERSE SOLIDUS")), "x", #"hex")
    }
    else {
      set var escaped = $"string-concatenation"(escaped, @sec-encodeforregexpescape(codePoint))
    }
  }
  return escaped
}

def @sec-encodeforregexpescape "EncodeForRegExpEscape" (kind ao params [codePoint : #"code point"] -> String) vars [codePoint, otherPunctuators, toEscape, codePointNumber, #"hex", escaped, codeUnits, codeUnit, i] {
  if codePoint sat @ph-matched-by(|SyntaxCharacter|) or codePoint is val {cp(47, "002F", "SOLIDUS")} {
    return $"string-concatenation"(cu(92, "005C", "REVERSE SOLIDUS"), @sec-utf16encodecodepoint(codePoint))
  }
  if codePoint sat @ph-tn-listed-in-column(data choice 0, data sort #"code point", code "Code Point", table t"table-controlescape-code-point-values") {
    return $"string-concatenation"(cu(92, "005C", "REVERSE SOLIDUS"), $TableLookup(table t"table-controlescape-code-point-values", code "ControlEscape", code "Code Point", ?codePoint))
  }
