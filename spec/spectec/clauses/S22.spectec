  vars [regexpRecord, charSet, otherSet]
  steps {
    let charSet = sdo CompileToCharSet(child 4 |ClassSubtraction|; regexpRecord)
    let otherSet = sdo CompileToCharSet(child 4 |ClassSetOperand|; regexpRecord)
    return @ph-charset-minus(?charSet, ?otherSet)
  }
}

sdo_row @sec-compiletocharset#24 CompileToCharSet form alg {
  prods [p"RegExp - ClassSetRange :: ClassSetCharacter `-` ClassSetCharacter"]
  keys ["ClassSetRange :: ClassSetCharacter `-` ClassSetCharacter"]
  vars [regexpRecord, charSet, otherSet]
  steps {
    let charSet = sdo CompileToCharSet(child 0 |ClassSetCharacter|; regexpRecord)
    let otherSet = sdo CompileToCharSet(child 1 |ClassSetCharacter|; regexpRecord)
    return @sec-maybesimplecasefolding(regexpRecord, @sec-runtime-semantics-characterrange-abstract-operation(charSet, otherSet))
  }
}

