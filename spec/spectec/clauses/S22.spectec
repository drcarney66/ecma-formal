    assert continue is ty {MatcherContinuation}
    let input = matchState[[Input]]
    let e = matchState[[EndIndex]]
    let inputLength = $ListLen(?input)
    if e == inputLength or regexpRecord[[Multiline]] is val {true} and $Char(input[e]) sat @ph-matched-by(|LineTerminator|) {
      return continue(matchState)
    }
    return ~failure~
  }
}

