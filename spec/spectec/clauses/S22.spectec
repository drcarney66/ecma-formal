def @sec-regexpinitialize "RegExpInitialize" (kind ao params [#"obj" : Object, pattern : #"ECMAScript language value", flags : #"ECMAScript language value"] -> completion<Object> | #"throw completion") vars [#"obj", pattern, flags, i, m, s, u, v, patternText, k, parseResult, capturingGroupsCount, regexpRecord] {
  if pattern is val {undefined} -> set var pattern = $"the empty String"()
  else -> set var pattern = ? @sec-tostring(pattern)
  if flags is val {undefined} -> set var flags = $"the empty String"()
  else -> set var flags = ? @sec-tostring(flags)
  if flags sat @ph-units-other-than(data choice 0, ["d", "g", "i", "m", "s", "u", "v", "y"]) -> throw @ph-new-error([[SyntaxError]])
  if flags sat @ph-unit-more-than-once() -> throw @ph-new-error([[SyntaxError]])
  if_else flags sat $Contains("i") { let i = true } else { let i = false }
  if_else flags sat $Contains("m") { let m = true } else { let m = false }
  if_else flags sat $Contains("s") { let s = true } else { let s = false }
  if_else flags sat $Contains("u") { let u = true } else { let u = false }
  if_else flags sat $Contains("v") { let v = true } else { let v = false }
  if u is val {true} or v is val {true} {
    let patternText = @sec-stringtocodepoints(pattern)
  }
  else {
    let patternText = $ListNew()
    for_range k incl 0 .. excl $StrLen(?pattern) {
      perform $Append($UnitOrPointOf(data choice 0, $NumericValue($UnitAt(?k, ?pattern))), ?patternText)
    }
  }
  let parseResult = @sec-parsepattern(patternText, u, v)
  if parseResult is ty {pred(sat @ph-type-syntax-errors())} -> throw @ph-new-error([[SyntaxError]])
  assert parseResult is ty {pred(sat @ph-type-nt-parse-node(data choice 0, |Pattern|))}
  set field #"obj"[[OriginalSource]] = pattern
  set field #"obj"[[OriginalFlags]] = flags
  let capturingGroupsCount = @sec-countleftcapturingparenswithin(parseResult)
  let regexpRecord = record #"RegExp Record" { [[IgnoreCase]]: i, [[Multiline]]: m, [[DotAll]]: s, [[Unicode]]: u, [[UnicodeSets]]: v, [[CapturingGroupsCount]]: capturingGroupsCount }
  set field #"obj"[[RegExpRecord]] = regexpRecord
  set field #"obj"[[RegExpMatcher]] = sdo CompilePattern(parseResult; regexpRecord)
  perform ? @sec-set-o-p-v-throw(#"obj", "lastIndex", num_f(+0), true)
  return #"obj"
