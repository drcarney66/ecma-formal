def @sec-stringpaddingbuiltinsimpl "StringPaddingBuiltinsImpl" (kind ao params [thisValue : #"ECMAScript language value", maxLength : #"ECMAScript language value", fillString : #"ECMAScript language value", placement : val(~start~) | val(~end~)] -> completion<String> | #"throw completion") vars [thisValue, maxLength, fillString, placement, string, intMaxLength, stringLength] {
  let string = ? @sec-tostring(thisValue)
  let intMaxLength = $ℝ(? @sec-tolength(maxLength))
  let stringLength = $StrLen(?string)
  if intMaxLength <= stringLength -> return string
  if fillString is val {undefined} -> set var fillString = @ph-string-solely($CodeUnit(cu(32, "0020", "SPACE")))
  else -> set var fillString = ? @sec-tostring(fillString)
  if fillString is not val {$"the empty String"()} and $StringTooLarge(intMaxLength) is val {true} -> throw @ph-new-error([[RangeError]])
  return @sec-stringpad(string, intMaxLength, fillString, placement)
}

def @sec-stringpad "StringPad" (kind ao params [string : String, maxLength : sort [#"non-negative"] integer, fillString : String, placement : val(~start~) | val(~end~)] -> String) vars [string, maxLength, fillString, placement, stringLength, fillLength, truncatedStringFiller] {
  let stringLength = $StrLen(?string)
  if maxLength <= stringLength -> return string
  if fillString is val {$"the empty String"()} -> return string
  let fillLength = maxLength - stringLength
  let truncatedStringFiller = @ph-repeat-to-length(?fillString, ?fillLength)
  if placement is val {~start~} -> return $"string-concatenation"(truncatedStringFiller, string)
  return $"string-concatenation"(string, truncatedStringFiller)
}

def @sec-tozeropaddeddecimalstring "ToZeroPaddedDecimalString" (kind ao params [n : sort [#"non-negative"] integer, minLength : sort [#"non-negative"] integer] -> String) vars [n, minLength, string] {
  let string = @ph-decimal-string(?n)
  return @sec-stringpad(string, minLength, "0", ~start~)
}

def @sec-string.prototype.repeat "String.prototype.repeat" (kind builtin params [count]) vars [#"this value", NewTarget, count, thisValue, string, n] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let n = ? @sec-tointegerorinfinity(count)
  if n < 0 or n == math(+∞) -> throw @ph-new-error([[RangeError]])
  if n == 0 -> return $"the empty String"()
  if $StringTooLarge(n * $StrLen(?string)) is val {true} -> throw @ph-new-error([[RangeError]])
  return @ph-copies-appended(?n, ?string)
}

def @sec-string.prototype.replace "String.prototype.replace" (kind builtin params [searchValue, replaceValue]) vars [#"this value", NewTarget, searchValue, replaceValue, thisValue, replacer, string, searchString, functionalReplace, searchLength, position, preceding, following, replacement, #"captures"] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  if searchValue is ty {Object} {
    let replacer = ? @sec-getmethod(searchValue, $WellKnownSymbol("Symbol.replace"))
    if replacer is not val {undefined} {
      return ? @sec-call(replacer, searchValue, [thisValue, replaceValue])
    }
  }
  let string = ? @sec-tostring(thisValue)
  let searchString = ? @sec-tostring(searchValue)
  let functionalReplace = @sec-iscallable(replaceValue)
  if functionalReplace is val {false} {
    set var replaceValue = ? @sec-tostring(replaceValue)
  }
  let searchLength = $StrLen(?searchString)
  let position = @sec-stringindexof(string, searchString, 0)
  if position is val {~not-found~} -> return string
  let preceding = $Substring(?string, 0, ?position)
  let following = $Substring(?string, position + searchLength, data absent)
  if functionalReplace is val {true} {
    let replacement = ? @sec-tostring(? @sec-call(replaceValue, undefined, [searchString, $𝔽(position), string]))
  }
  else {
    assert replaceValue is ty {String}
    let #"captures" = $ListNew()
    let replacement = ! @sec-getsubstitution(searchString, string, position, #"captures", undefined, replaceValue)
  }
  return $"string-concatenation"(preceding, replacement, following)
}

def @sec-getsubstitution "GetSubstitution" (kind ao params [matched : String, string : String, position : sort [#"non-negative"] integer, #"captures" : list<String | val(undefined)>, namedCaptures : Object | val(undefined), replacementTemplate : String] -> completion<String> | #"throw completion") vars [matched, string, position, #"captures", namedCaptures, replacementTemplate, stringLength, result, templateRemainder, #"ref", refReplacement, matchLength, tailPosition, digitCount, digits, index, captureLength, capture, gtPosition, groupName, refLength] {
  let stringLength = $StrLen(?string)
  assert position <= stringLength
  let result = $"the empty String"()
  let templateRemainder = replacementTemplate
  repeat_while templateRemainder is not val {$"the empty String"()} {
    note "The following steps isolate _ref_ (a prefix of _templateRemainder_), determine _refReplacement_ (its replacement), and then append that replacement to _result_."
    if templateRemainder sat $StartsWith("$$") {
      let #"ref" = "$$"
      let refReplacement = "$"
    }
    else_if templateRemainder sat $StartsWith("$`") {
      let #"ref" = "$`"
      let refReplacement = $Substring(?string, 0, ?position)
    }
    else_if templateRemainder sat $StartsWith("$&") {
      let #"ref" = "$&"
      let refReplacement = matched
    }
    else_if expr @ph-starts-dollar-quote(?templateRemainder) {
      let #"ref" = "$'"
      let matchLength = $StrLen(?matched)
      let tailPosition = position + matchLength
      let refReplacement = $Substring(?string, $min(tailPosition, stringLength), data absent)
      note "_tailPosition_ can exceed _stringLength_ only if this abstract operation was invoked by a call to the intrinsic %Symbol.replace% method of %RegExp.prototype% on an object whose *\"exec\"* property is not the intrinsic %RegExp.prototype.exec%."
    }
    else_if expr @ph-dollar-one-digit(?templateRemainder) {
      if_else expr @ph-dollar-two-digits(?templateRemainder) { let digitCount = 2 } else { let digitCount = 1 }
      let digits = $Substring(?templateRemainder, 1, 1 + digitCount)
      let index = $ℝ(@sec-stringtonumber(digits))
      assert expr $Chain(0, data choice 1, ?index, data choice 1, 99)
      let captureLength = $ListLen(?#"captures")
      if index > captureLength and digitCount == 2 {
        note "When a two-digit replacement pattern specifies an index exceeding the count of capturing groups, it is treated as a one-digit replacement pattern followed by a literal digit."
        set var digitCount = 1
        set var digits = $Substring(?digits, 0, 1)
        set var index = $ℝ(@sec-stringtonumber(digits))
      }
      let #"ref" = $Substring(?templateRemainder, 0, 1 + digitCount)
      if expr $Chain(1, data choice 1, ?index, data choice 1, ?captureLength) {
        let capture = #"captures"[index - 1]
        if capture is val {undefined} {
          let refReplacement = $"the empty String"()
        }
        else {
          let refReplacement = capture
        }
      }
      else {
        let refReplacement = #"ref"
      }
    }
    else_if templateRemainder sat $StartsWith("$<") {
      let gtPosition = @sec-stringindexof(templateRemainder, ">", 0)
      if gtPosition is val {~not-found~} or namedCaptures is val {undefined} {
        let #"ref" = "$<"
        let refReplacement = #"ref"
      }
      else {
        let #"ref" = $Substring(?templateRemainder, 0, gtPosition + 1)
        let groupName = $Substring(?templateRemainder, 2, ?gtPosition)
        assert namedCaptures is ty {Object}
        let capture = ? @sec-get-o-p(namedCaptures, groupName)
        if capture is val {undefined} {
          let refReplacement = $"the empty String"()
        }
        else {
          let refReplacement = ? @sec-tostring(capture)
        }
      }
    }
    else {
      let #"ref" = $Substring(?templateRemainder, 0, 1)
      let refReplacement = #"ref"
    }
    let refLength = $StrLen(?#"ref")
    set var templateRemainder = $Substring(?templateRemainder, ?refLength, data absent)
    set var result = $"string-concatenation"(result, refReplacement)
  }
  return result
}

def @sec-string.prototype.replaceall "String.prototype.replaceAll" (kind builtin params [searchValue, replaceValue]) vars [#"this value", NewTarget, searchValue, replaceValue, thisValue, isRegexp, flags, replacer, string, searchString, functionalReplace, searchLength, advanceBy, matchPositions, position, endOfLastMatch, result, matchPosition, preserved, replacement, #"captures"] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  if searchValue is ty {Object} {
    let isRegexp = ? @sec-isregexp(searchValue)
    if isRegexp is val {true} {
      let flags = ? @sec-get-o-p(searchValue, "flags")
      perform ? @sec-requireobjectcoercible(flags)
      if ? @sec-tostring(flags) fails $Contains("g") -> throw @ph-new-error([[TypeError]])
    }
    let replacer = ? @sec-getmethod(searchValue, $WellKnownSymbol("Symbol.replace"))
    if replacer is not val {undefined} {
      return ? @sec-call(replacer, searchValue, [thisValue, replaceValue])
    }
  }
  let string = ? @sec-tostring(thisValue)
  let searchString = ? @sec-tostring(searchValue)
  let functionalReplace = @sec-iscallable(replaceValue)
  if functionalReplace is val {false} {
    set var replaceValue = ? @sec-tostring(replaceValue)
  }
  let searchLength = $StrLen(?searchString)
  let advanceBy = $max(1, searchLength)
  let matchPositions = $ListNew()
  let position = @sec-stringindexof(string, searchString, 0)
  repeat_while position is not val {~not-found~} {
    perform $Append(?position, ?matchPositions)
    set var position = @sec-stringindexof(string, searchString, position + advanceBy)
  }
  let endOfLastMatch = 0
  let result = $"the empty String"()
  for_each matchPosition in matchPositions {
    let preserved = $Substring(?string, ?endOfLastMatch, ?matchPosition)
    if functionalReplace is val {true} {
      let replacement = ? @sec-tostring(? @sec-call(replaceValue, undefined, [searchString, $𝔽(matchPosition), string]))
    }
    else {
      assert replaceValue is ty {String}
      let #"captures" = $ListNew()
      let replacement = ! @sec-getsubstitution(searchString, string, matchPosition, #"captures", undefined, replaceValue)
    }
    set var result = $"string-concatenation"(result, preserved, replacement)
    set var endOfLastMatch = matchPosition + searchLength
  }
  if endOfLastMatch < $StrLen(?string) {
    set var result = $"string-concatenation"(result, $Substring(?string, ?endOfLastMatch, data absent))
  }
  return result
}

def @sec-string.prototype.search "String.prototype.search" (kind builtin params [regexpOrPattern]) vars [#"this value", NewTarget, regexpOrPattern, thisValue, searcher, string, regexp] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  if regexpOrPattern is ty {Object} {
    let searcher = ? @sec-getmethod(regexpOrPattern, $WellKnownSymbol("Symbol.search"))
    if searcher is not val {undefined} {
      return ? @sec-call(searcher, regexpOrPattern, [thisValue])
    }
  }
  let string = ? @sec-tostring(thisValue)
  let regexp = ? @sec-regexpcreate(regexpOrPattern, undefined)
  return ? @sec-invoke(regexp, $WellKnownSymbol("Symbol.search"), [string])
}

def @sec-string.prototype.slice "String.prototype.slice" (kind builtin params [start, end]) vars [#"this value", NewTarget, start, end, thisValue, string, length, #"from", #"to"] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let length = $StrLen(?string)
  let #"from" = ? @sec-toclampedindex(start, length)
  if_else end is val {undefined} { let #"to" = length } else { let #"to" = ? @sec-toclampedindex(end, length) }
  if #"from" >= #"to" -> return $"the empty String"()
  return $Substring(?string, ?#"from", ?#"to")
}

def @sec-string.prototype.split "String.prototype.split" (kind builtin params [separator, substringLimit]) vars [#"this value", NewTarget, separator, substringLimit, thisValue, splitter, string, substringLimitInt, separatorString, separatorLength, stringLength, outLength, head, codeUnits, i, substrings, searchStart, matchIndex, substring] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  if separator is ty {Object} {
    let splitter = ? @sec-getmethod(separator, $WellKnownSymbol("Symbol.split"))
    if splitter is not val {undefined} {
      return ? @sec-call(splitter, separator, [thisValue, substringLimit])
    }
  }
  let string = ? @sec-tostring(thisValue)
  if_else substringLimit is val {undefined} { let substringLimitInt = 2 ^ 32 - 1 } else { let substringLimitInt = $ℝ(? @sec-touint32(substringLimit)) }
  let separatorString = ? @sec-tostring(separator)
  if substringLimitInt == 0 {
    return @sec-createarrayfromlist([])
  }
  if separator is val {undefined} {
    return @sec-createarrayfromlist([string])
  }
  let separatorLength = $StrLen(?separatorString)
  if separatorLength == 0 {
    let stringLength = $StrLen(?string)
    let outLength = $clamping(?substringLimitInt, 0, ?stringLength)
    let head = $Substring(?string, 0, ?outLength)
    let codeUnits = $ListNew()
    for_range i incl 0 .. excl outLength {
      perform $Append($Substring(?head, ?i, i + 1), ?codeUnits)
    }
    return @sec-createarrayfromlist(codeUnits)
  }
  if string is val {$"the empty String"()} -> return @sec-createarrayfromlist([string])
  let substrings = $ListNew()
  let searchStart = 0
  let matchIndex = @sec-stringindexof(string, separatorString, 0)
  repeat_while matchIndex is not val {~not-found~} {
    let substring = $Substring(?string, ?searchStart, ?matchIndex)
    perform $Append(?substring, ?substrings)
    if $ListLen(?substrings) is val {substringLimitInt} -> return @sec-createarrayfromlist(substrings)
    set var searchStart = matchIndex + separatorLength
    set var matchIndex = @sec-stringindexof(string, separatorString, searchStart)
  }
  let substring = $Substring(?string, ?searchStart, data absent)
  perform $Append(?substring, ?substrings)
  return @sec-createarrayfromlist(substrings)
}

def @sec-string.prototype.startswith "String.prototype.startsWith" (kind builtin params [searchString, position opt]) vars [#"this value", NewTarget, searchString, position, thisValue, string, isRegexp, length, start, searchLength, end, substring] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let isRegexp = ? @sec-isregexp(searchString)
  if isRegexp is val {true} -> throw @ph-new-error([[TypeError]])
  set var searchString = ? @sec-tostring(searchString)
  let length = $StrLen(?string)
  let start = $clamping(? @sec-tointegerorinfinity(position), 0, ?length)
  assert_if position is val {undefined} then start is val {0}
  let searchLength = $StrLen(?searchString)
  if searchLength == 0 -> return true
  let end = start + searchLength
  if end > length -> return false
  let substring = $Substring(?string, ?start, ?end)
  if substring is val {searchString} -> return true
  return false
}

def @sec-string.prototype.substring "String.prototype.substring" (kind builtin params [start, end]) vars [#"this value", NewTarget, start, end, thisValue, string, length, finalStart, finalEnd, #"from", #"to"] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let length = $StrLen(?string)
  let finalStart = $clamping(? @sec-tointegerorinfinity(start), 0, ?length)
  assert_if start is val {undefined} then finalStart is val {0}
  if_else end is val {undefined} { let finalEnd = length } else { let finalEnd = $clamping(? @sec-tointegerorinfinity(end), 0, ?length) }
  let #"from" = $min(finalStart, finalEnd)
  let #"to" = $max(finalStart, finalEnd)
  return $Substring(?string, ?#"from", ?#"to")
}

def @sec-string.prototype.tolowercase "String.prototype.toLowerCase" (kind builtin params []) vars [#"this value", NewTarget, thisValue, string, sText, lowerText, lowercaseString] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let sText = @sec-stringtocodepoints(string)
  let lowerText = $toLowercase(sText)
  let lowercaseString = @sec-codepointstostring(lowerText)
  return lowercaseString
}

def @sec-string.prototype.tostring "String.prototype.toString" (kind builtin params []) vars [#"this value", NewTarget] {
  return ? @sec-thisstringvalue(this_value)
}

def @sec-string.prototype.towellformed "String.prototype.toWellFormed" (kind builtin params []) vars [#"this value", NewTarget, thisValue, string, stringLength, k, result, codePoint] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let stringLength = $StrLen(?string)
  let k = 0
  let result = $"the empty String"()
  repeat_while k < stringLength {
    let codePoint = @sec-codepointat(string, k)
    if codePoint[[IsUnpairedSurrogate]] is val {true} {
      set var result = $"string-concatenation"(result, cu(65533, "FFFD", "REPLACEMENT CHARACTER"))
    }
    else {
      set var result = $"string-concatenation"(result, @sec-utf16encodecodepoint(codePoint[[CodePoint]]))
    }
    set var k = k + codePoint[[CodeUnitCount]]
  }
  return result
}

def @sec-string.prototype.trim "String.prototype.trim" (kind builtin params []) vars [#"this value", NewTarget, thisValue] {
  let thisValue = this_value
  return ? @sec-trimstring(thisValue, ~start+end~)
}

def @sec-trimstring "TrimString" (kind ao params [arg : #"ECMAScript language value", #"where" : val(~start~) | val(~end~) | val(~start+end~)] -> completion<String> | #"throw completion") vars [arg, #"where", string, trimmedString] {
  perform ? @sec-requireobjectcoercible(arg)
  let string = ? @sec-tostring(arg)
  if #"where" is val {~start~} {
    let trimmedString = @ph-trim-leading(?string)
  }
  else_if #"where" is val {~end~} {
    let trimmedString = @ph-trim-trailing(?string)
  }
  else {
    assert #"where" is val {~start+end~}
    let trimmedString = @ph-trim-both(?string)
  }
  return trimmedString
}

def @sec-string.prototype.trimend "String.prototype.trimEnd" (kind builtin params []) vars [#"this value", NewTarget, string] {
  let string = this_value
  return ? @sec-trimstring(string, ~end~)
}

def @sec-string.prototype.trimstart "String.prototype.trimStart" (kind builtin params []) vars [#"this value", NewTarget, string] {
  let string = this_value
  return ? @sec-trimstring(string, ~start~)
}

def @sec-string.prototype.valueof "String.prototype.valueOf" (kind builtin params []) vars [#"this value", NewTarget] {
  return ? @sec-thisstringvalue(this_value)
}

def @sec-thisstringvalue "ThisStringValue" (kind ao params [arg : #"ECMAScript language value"] -> completion<String> | #"throw completion") vars [arg, string] {
  if arg is ty {String} -> return arg
  if arg is ty {Object} and arg sat $HasSlot([[StringData]]) {
    let string = arg[[StringData]]
    assert string is ty {String}
    return string
  }
  throw @ph-new-error([[TypeError]])
}

def @sec-string.prototype-%symbol.iterator% "String.prototype [ %Symbol.iterator% ]" (kind builtin params []) vars [#"this value", NewTarget, string, #"closure", length, position, codePoint, nextIndex, resultString] {
  let string = this_value
  perform ? @sec-requireobjectcoercible(string)
  set var string = ? @sec-tostring(string)
  let #"closure" = closure 0
  return @sec-createiteratorfromclosure(#"closure", "%StringIteratorPrototype%", intrinsic [[StringIteratorPrototype]])
  closure abstract params none captures [string] {
    let length = $StrLen(?string)
    let position = 0
    repeat_while position < length {
      let codePoint = @sec-codepointat(string, position)
      let nextIndex = position + codePoint[[CodeUnitCount]]
      let resultString = $Substring(?string, ?position, ?nextIndex)
      set var position = nextIndex
      perform ? @sec-generatoryield(@sec-createiterresultobject(resultString, false))
    }
    return @sec-normalcompletion(~unused~)
  }
}

def @sec-%stringiteratorprototype%.next "%StringIteratorPrototype%.next" (kind builtin params []) vars [#"this value", NewTarget] {
  return ? @sec-generatorresume(this_value, ~empty~, "%StringIteratorPrototype%")
}

def @sec-countleftcapturingparenswithin "CountLeftCapturingParensWithin" (kind ao params [parseNode : #"Parse Node"] -> sort [#"non-negative"] integer) vars [parseNode, atoms, extendedAtoms] {
  assert parseNode sat @ph-production-in(clause @sec-patterns)
  let atoms = @ph-count-nodes-within(prods [p"RegExp 0 Atom :: `(` GroupSpecifier[?UnicodeMode]? Disjunction[?UnicodeMode, ?UnicodeSetsMode, ?NamedCaptureGroups] `)`", p"RegExp 1 Atom :: `(` GroupSpecifier[?UnicodeMode]? Disjunction[?UnicodeMode, ?UnicodeSetsMode, ?NamedCaptureGroups] `)`"], ?parseNode)
  let extendedAtoms = @ph-count-nodes-within(prods [p"AnnexB 0 ExtendedAtom :: `(` GroupSpecifier[~UnicodeMode]? Disjunction[~UnicodeMode, ~UnicodeSetsMode, ?NamedCaptureGroups] `)`", p"AnnexB 1 ExtendedAtom :: `(` GroupSpecifier[~UnicodeMode]? Disjunction[~UnicodeMode, ~UnicodeSetsMode, ?NamedCaptureGroups] `)`"], ?parseNode)
  return atoms + extendedAtoms
}

def @sec-countleftcapturingparensbefore "CountLeftCapturingParensBefore" (kind ao params [parseNode : #"Parse Node"] -> sort [#"non-negative"] integer) vars [parseNode, pattern, atoms, extendedAtoms] {
  assert parseNode sat @ph-production-in(clause @sec-patterns)
  let pattern = @ph-nt-containing(|Pattern|, ?parseNode)
  let atoms = @ph-count-nodes-before(prods [p"RegExp 0 Atom :: `(` GroupSpecifier[?UnicodeMode]? Disjunction[?UnicodeMode, ?UnicodeSetsMode, ?NamedCaptureGroups] `)`", p"RegExp 1 Atom :: `(` GroupSpecifier[?UnicodeMode]? Disjunction[?UnicodeMode, ?UnicodeSetsMode, ?NamedCaptureGroups] `)`"], ?pattern, ?parseNode, ?parseNode)
  let extendedAtoms = @ph-count-nodes-before(prods [p"AnnexB 0 ExtendedAtom :: `(` GroupSpecifier[~UnicodeMode]? Disjunction[~UnicodeMode, ~UnicodeSetsMode, ?NamedCaptureGroups] `)`", p"AnnexB 1 ExtendedAtom :: `(` GroupSpecifier[~UnicodeMode]? Disjunction[~UnicodeMode, ~UnicodeSetsMode, ?NamedCaptureGroups] `)`"], ?pattern, ?parseNode, ?parseNode)
  return atoms + extendedAtoms
}

def @sec-mightbothparticipate "MightBothParticipate" (kind ao params [x : #"Parse Node", y : #"Parse Node"] -> Boolean) vars [x, y, d, left, right] {
  assert $NearestEnclosing(x, [|Pattern|]) is val {$NearestEnclosing(y, [|Pattern|])}
  for_each d in $ParseNodesWithin($NearestEnclosing(x, [|Pattern|])) {
    if expr $InstanceOf(d, prods [p"RegExp - Disjunction :: Alternative[?UnicodeMode, ?UnicodeSetsMode, ?NamedCaptureGroups] `|` Disjunction[?UnicodeMode, ?UnicodeSetsMode, ?NamedCaptureGroups]"]) {
      let left = $ParseNodesWithin($ChildOf(|Alternative|, ?d))
      let right = $ParseNodesWithin($ChildOf(|Disjunction|, ?d))
      if left sat $Contains(?x) and right sat $Contains(?y) -> return false
      if right sat $Contains(?x) and left sat $Contains(?y) -> return false
    }
  }
  return true
}

def @sec-groupspecifiersthatmatch "GroupSpecifiersThatMatch" (kind ao params [thisGroupName : |GroupName|] -> doc "a List of |GroupSpecifier| Parse Nodes") vars [thisGroupName, name, pattern, result, groupSpecifier] {
  let name = sdo CapturingGroupName(thisGroupName)
  let pattern = @ph-nt-containing(|Pattern|, ?thisGroupName)
  let result = $ListNew()
  for_each groupSpecifier in $ParseNodesWithin(pattern) {
    if groupSpecifier is ty {pred(sat @ph-type-nt-parse-node(data choice 0, |GroupSpecifier|))} {
      if sdo CapturingGroupName(groupSpecifier) is val {name} {
        perform $Append(?groupSpecifier, ?result)
      }
    }
  }
  return result
}

def @sec-runtime-semantics-repeatmatcher-abstract-operation "RepeatMatcher" (kind ao params [m : Matcher, min : sort [#"non-negative"] integer, max : sort [#"non-negative"] integer | val(math(+∞)), greedy : Boolean, matchState : MatchState, continue : MatcherContinuation, parenIndex : sort [#"non-negative"] integer, parenCount : sort [#"non-negative"] integer] -> MatchState | val(~failure~)) vars [m, min, max, greedy, matchState, continue, parenIndex, parenCount, d, y, min2, max2, capability, k, input, e, xr, z] {
  if max == 0 -> return continue(matchState)
  let d = closure 0
  let capability = $Copy(matchState[[Captures]])
  for_range k incl parenIndex + 1 .. incl parenIndex + parenCount {
    set expr capability[k] = undefined
  }
  let input = matchState[[Input]]
  let e = matchState[[EndIndex]]
  let xr = record MatchState { [[Input]]: input, [[EndIndex]]: e, [[Captures]]: capability }
  if min != 0 -> return m(xr, d)
  if greedy is val {false} {
    let z = continue(matchState)
    if z is not val {~failure~} -> return z
    return m(xr, d)
  }
  let z = m(xr, d)
  if z is not val {~failure~} -> return z
  return continue(matchState)
  closure matcher_continuation params [y] captures [m, min, max, greedy, matchState, continue, parenIndex, parenCount] {
    assert y is ty {MatchState}
    if min == 0 and y[[EndIndex]] == matchState[[EndIndex]] -> return ~failure~
    if_else min == 0 { let min2 = 0 } else { let min2 = min - 1 }
    if_else max == math(+∞) { let max2 = math(+∞) } else { let max2 = max - 1 }
    return @sec-runtime-semantics-repeatmatcher-abstract-operation(m, min2, max2, greedy, y, continue, parenIndex, parenCount)
  }
}

def @sec-emptymatcher "EmptyMatcher" (kind ao params [] -> Matcher) vars [matchState, continue] {
  return closure 0
  closure matcher params [matchState, continue] captures [] {
    assert matchState is ty {MatchState}
    assert continue is ty {MatcherContinuation}
    return continue(matchState)
  }
}

def @sec-matchtwoalternatives "MatchTwoAlternatives" (kind ao params [m1 : Matcher, m2 : Matcher] -> Matcher) vars [m1, m2, matchState, continue, result] {
  return closure 0
  closure matcher params [matchState, continue] captures [m1, m2] {
    assert matchState is ty {MatchState}
    assert continue is ty {MatcherContinuation}
    let result = m1(matchState, continue)
    if result is not val {~failure~} -> return result
    return m2(matchState, continue)
  }
}

def @sec-matchsequence "MatchSequence" (kind ao params [m1 : Matcher, m2 : Matcher, direction : val(~forward~) | val(~backward~)] -> Matcher) vars [m1, m2, direction, matchState, continue, d, y] {
  if direction is val {~forward~} {
    return closure 0
  }
  assert direction is val {~backward~}
  return closure 2
  closure matcher params [matchState, continue] captures [m1, m2] {
    assert matchState is ty {MatchState}
    assert continue is ty {MatcherContinuation}
    let d = closure 1
    return m1(matchState, d)
  }
  closure matcher_continuation params [y] captures [continue, m2] {
    assert y is ty {MatchState}
    return m2(y, continue)
  }
  closure matcher params [matchState, continue] captures [m1, m2] {
    assert matchState is ty {MatchState}
    assert continue is ty {MatcherContinuation}
    let d = closure 3
    return m2(matchState, d)
  }
  closure matcher_continuation params [y] captures [continue, m1] {
    assert y is ty {MatchState}
    return m1(y, continue)
  }
}

def @sec-runtime-semantics-iswordchar-abstract-operation "IsWordChar" (kind ao params [regexpRecord : #"RegExp Record", input : list<character that sat @ph-character-of-pattern(regexpRecord)>, e : integer] -> Boolean) vars [regexpRecord, input, e, inputLength, char] {
  let inputLength = $ListLen(?input)
  if e == math(-1) or e == inputLength -> return false
  let char = $Char(input[e])
  if @sec-wordcharacters(regexpRecord) sat $Contains(?char) -> return true
  return false
}

def @sec-runtime-semantics-charactersetmatcher-abstract-operation "CharacterSetMatcher" (kind ao params [regexpRecord : #"RegExp Record", charSet : CharSet, invert : Boolean, direction : val(~forward~) | val(~backward~)] -> Matcher) vars [regexpRecord, charSet, invert, direction, x, c, input, endIndex, f, inputLength, index, char, cc, a, found, capability, y] {
  if regexpRecord[[UnicodeSets]] is val {true} {
    assert invert is val {false}
    assert expr @ph-every-element-single-character(?charSet)
  }
  return closure 0
  closure matcher params [x, c] captures [regexpRecord, charSet, invert, direction] {
    assert x is ty {MatchState}
    assert c is ty {MatcherContinuation}
    let input = x[[Input]]
    let endIndex = x[[EndIndex]]
    if direction is val {~forward~} -> let f = endIndex + 1
    else -> let f = endIndex - 1
    let inputLength = $ListLen(?input)
    if f < 0 or f > inputLength -> return ~failure~
    let index = $min(endIndex, f)
    let char = $Char(input[index])
    let cc = @sec-runtime-semantics-canonicalize-ch(regexpRecord, char)
    let found = $CharSetHasCanonical(charSet, cc, @sec-runtime-semantics-haseitherunicodeflag-abstract-operation(regexpRecord), regexpRecord[[IgnoreCase]])
    if invert is val {false} and found is val {false} -> return ~failure~
    if invert is val {true} and found is val {true} -> return ~failure~
    let capability = x[[Captures]]
    let y = record MatchState { [[Input]]: input, [[EndIndex]]: f, [[Captures]]: capability }
    return c(y)
  }
}

def @sec-backreference-matcher "BackreferenceMatcher" (kind ao params [regexpRecord : #"RegExp Record", ns : list<sort [positive] integer>, direction : val(~forward~) | val(~backward~)] -> Matcher) vars [regexpRecord, ns, direction, x, c, input, capability, r, n, endIndex, rs, re, length, f, inputLength, g, i, y] {
  return closure 0
  closure matcher params [x, c] captures [regexpRecord, ns, direction] {
    assert x is ty {MatchState}
    assert c is ty {MatcherContinuation}
    let input = x[[Input]]
    let capability = x[[Captures]]
    let r = undefined
    for_each n : integer in ns {
      if capability[n] is not val {undefined} {
        assert r is val {undefined}
        set var r = capability[n]
      }
    }
    if r is val {undefined} -> return c(x)
    let endIndex = x[[EndIndex]]
    let rs = r[[StartIndex]]
    let re = r[[EndIndex]]
    let length = re - rs
    if direction is val {~forward~} -> let f = endIndex + length
    else -> let f = endIndex - length
    let inputLength = $ListLen(?input)
    if f < 0 or f > inputLength -> return ~failure~
    let g = $min(endIndex, f)
    for_range i incl 0 .. excl length {
      if @sec-runtime-semantics-canonicalize-ch(regexpRecord, input[rs + i]) is not val {@sec-runtime-semantics-canonicalize-ch(regexpRecord, input[g + i])} -> return ~failure~
    }
    let y = record MatchState { [[Input]]: input, [[EndIndex]]: f, [[Captures]]: capability }
    return c(y)
  }
}

def @sec-runtime-semantics-canonicalize-ch "Canonicalize" (kind ao params [regexpRecord : #"RegExp Record", char : character that sat @ph-character-of-pattern(regexpRecord)] -> character that sat @ph-character-of-pattern(regexpRecord)) vars [regexpRecord, char, folded, codePoint, mappedCodePoints, mappedCodePoint] {
  if @sec-runtime-semantics-haseitherunicodeflag-abstract-operation(regexpRecord) is val {true} and regexpRecord[[IgnoreCase]] is val {true} {
    let folded = $SimpleCaseFold(char)
    if folded is not val {~empty~} -> return folded
    return char
  }
  if regexpRecord[[IgnoreCase]] is val {false} -> return char
  assert char is ty {#"code unit"}
  let codePoint = $UnitOrPointOf(data choice 0, $NumericValue(?char))
  let mappedCodePoints = $toUppercase([codePoint])
  if $StrLen(@sec-codepointstostring(mappedCodePoints)) != 1 -> return char
  assert $ListLen(?mappedCodePoints) is val {1}
  let mappedCodePoint = @ph-single-code-point-element(?mappedCodePoints)
  if $NumericValue(?char) >= 128 and $NumericValue(?mappedCodePoint) < 128 -> return char
  return $UnitOrPointOf(data choice 1, $NumericValue(?mappedCodePoint))
}

def @sec-updatemodifiers "UpdateModifiers" (kind ao params [regexpRecord : #"RegExp Record", add : String, #"remove" : String] -> #"RegExp Record") vars [regexpRecord, add, #"remove", ignoreCase, multiline, dotAll, unicode, unicodeSets, capturingGroupsCount] {
  assert expr @ph-no-elements-in-common(?add, ?#"remove")
  let ignoreCase = regexpRecord[[IgnoreCase]]
  let multiline = regexpRecord[[Multiline]]
  let dotAll = regexpRecord[[DotAll]]
  let unicode = regexpRecord[[Unicode]]
  let unicodeSets = regexpRecord[[UnicodeSets]]
  let capturingGroupsCount = regexpRecord[[CapturingGroupsCount]]
  if #"remove" sat $Contains("i") -> set var ignoreCase = false
  else_if add sat $Contains("i") -> set var ignoreCase = true
  if #"remove" sat $Contains("m") -> set var multiline = false
  else_if add sat $Contains("m") -> set var multiline = true
  if #"remove" sat $Contains("s") -> set var dotAll = false
  else_if add sat $Contains("s") -> set var dotAll = true
  return record #"RegExp Record" { [[IgnoreCase]]: ignoreCase, [[Multiline]]: multiline, [[DotAll]]: dotAll, [[Unicode]]: unicode, [[UnicodeSets]]: unicodeSets, [[CapturingGroupsCount]]: capturingGroupsCount }
}

def @sec-runtime-semantics-characterrange-abstract-operation "CharacterRange" (kind ao params [charSet : CharSet, otherSet : CharSet] -> CharSet) vars [charSet, otherSet, a, b, i, j] {
  assert $ListLen(?charSet) is val {1}
  assert $ListElem(data choice 0, ?charSet) is not ty {List} or $ListLen($ListElem(data choice 0, ?charSet)) is val {1}
  assert $ListLen(?otherSet) is val {1}
  assert $ListElem(data choice 0, ?otherSet) is not ty {List} or $ListLen($ListElem(data choice 0, ?otherSet)) is val {1}
  let a = @ph-one-character(?charSet)
  let b = @ph-one-character(?otherSet)
  let i = $CharValue(?a)
  let j = $CharValue(?b)
  assert i <= j
  return @ph-character-interval(?i, ?j)
}

def @sec-runtime-semantics-haseitherunicodeflag-abstract-operation "HasEitherUnicodeFlag" (kind ao params [regexpRecord : #"RegExp Record"] -> Boolean) vars [regexpRecord] {
  if regexpRecord[[Unicode]] is val {true} or regexpRecord[[UnicodeSets]] is val {true} -> return true
  return false
}

def @sec-wordcharacters "WordCharacters" (kind ao params [regexpRecord : #"RegExp Record"] -> CharSet) vars [regexpRecord, basicWordChars, extraWordChars, c] {
  let basicWordChars = @ph-charset-of-every-character(@ph-ascii-word-characters())
  if_else regexpRecord[[IgnoreCase]] is val {true} { let extraWordChars = $CharSetCanonExtra(basicWordChars, @sec-runtime-semantics-haseitherunicodeflag-abstract-operation(regexpRecord)) } else { let extraWordChars = $EmptyCharSet() }
  if @sec-runtime-semantics-haseitherunicodeflag-abstract-operation(regexpRecord) is val {false} or regexpRecord[[IgnoreCase]] is val {false} {
    assert extraWordChars sat $IsEmpty()
  }
  return $CharSetUnionAll([basicWordChars, extraWordChars])
}

def @sec-allcharacters "AllCharacters" (kind ao params [regexpRecord : #"RegExp Record"] -> CharSet) vars [regexpRecord, c] {
  if regexpRecord[[UnicodeSets]] is val {true} and regexpRecord[[IgnoreCase]] is val {true} {
    return $CharSetNoScf()
  }
  if @sec-runtime-semantics-haseitherunicodeflag-abstract-operation(regexpRecord) is val {true} {
    return @ph-all-code-points()
  }
  return @ph-all-code-units()
}

def @sec-maybesimplecasefolding "MaybeSimpleCaseFolding" (kind ao params [regexpRecord : #"RegExp Record", charSet : CharSet] -> CharSet) vars [regexpRecord, charSet, otherSet, s, t, codePoint] {
  if regexpRecord[[UnicodeSets]] is val {false} or regexpRecord[[IgnoreCase]] is val {false} -> return charSet
  let otherSet = $NewRecord(data sort CharSet, data sort #"empty")
  for_each s : CharSetElement in charSet {
    let t = @ph-empty-character-sequence(data choice 1)
    for_each codePoint : sort [single] #"code point" in s {
      perform $Append($scf(codePoint), ?t)
    }
    perform $SetAdd(?t, ?otherSet)
  }
  return otherSet
}

def @sec-charactercomplement "CharacterComplement" (kind ao params [regexpRecord : #"RegExp Record", complement : CharSet] -> CharSet) vars [regexpRecord, complement, charSet] {
  let charSet = @sec-allcharacters(regexpRecord)
  return @ph-charset-minus(?charSet, ?complement)
}

def @sec-runtime-semantics-unicodematchproperty-p "UnicodeMatchProperty" (kind ao params [regexpRecord : #"RegExp Record", p : #"ECMAScript source text"] -> #"Unicode property name") vars [regexpRecord, p, c, t] {
  if regexpRecord[[UnicodeSets]] is val {true} and p sat @ph-listed-property-name(table t"table-binary-unicode-properties-of-strings") {
    return $CodePoints(?p)
  }
  assert p sat @ph-listed-property-name-or-alias-either(table t"table-nonbinary-unicode-properties", table t"table-binary-unicode-properties")
