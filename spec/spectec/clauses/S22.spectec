sdo_row @sec-compileatom#2 CompileAtom form alg {
  prods [p"RegExp - Atom :: CharacterClass[?UnicodeMode, ?UnicodeSetsMode]"]
  keys ["Atom :: CharacterClass"]
  vars [regexpRecord, direction, cc, cs, listOfMatchers, csSequences, s, remaining, cs2, m2, c1, cs1, m1, singles]
  steps {
    let cc = sdo CompileCharacterClass(child 5 |CharacterClass|; regexpRecord)
    let cs = cc[[CharSet]]
    if regexpRecord[[UnicodeSets]] is val {false} or expr @ph-every-single-character(?cs, ?cs) -> return @sec-runtime-semantics-charactersetmatcher-abstract-operation(regexpRecord, cs, cc[[Invert]], direction)
    assert cc[[Invert]] is val {false}
    let listOfMatchers = $ListNew()
    let csSequences = $ListNew()
    for_each s : CharSetElement in cs {
      if expr @ph-charset-element-longer-than-one(?s) -> perform $Append(?s, ?csSequences)
    }
    perform @ph-sort-by-length(?csSequences, data sort CharSetElement)
    for_each s : CharSetElement in csSequences {
      assert s sat @ph-code-point-sequence(2)
      let remaining = @ph-list-consisting-of(@ph-code-points-of(?s))
      let cs2 = $CharSetOne($ListElem(data choice 2, ?remaining))
      let m2 = @sec-runtime-semantics-charactersetmatcher-abstract-operation(regexpRecord, cs2, false, direction)
      perform $RemoveLast(?remaining)
      for_each c1 : #"code point" rev in remaining {
        let cs1 = $CharSetOne(?c1)
        let m1 = @sec-runtime-semantics-charactersetmatcher-abstract-operation(regexpRecord, cs1, false, direction)
        set var m2 = @sec-matchsequence(m1, m2, direction)
      }
      perform $Append(?m2, ?listOfMatchers)
    }
    let singles = @ph-charset-singles(?cs)
    perform $Append(@sec-runtime-semantics-charactersetmatcher-abstract-operation(regexpRecord, singles, false, direction), ?listOfMatchers)
    if cs sat $Contains(@ph-empty-character-sequence(data choice 0)) -> perform $Append(@sec-emptymatcher(), ?listOfMatchers)
    let m2 = @ph-last-in(data sort Matcher, ?listOfMatchers)
    for_each m1 : Matcher in @ph-iter-backwards(?listOfMatchers) {
      set var m2 = @sec-matchtwoalternatives(m1, m2)
    }
    return m2
  }
}

sdo_row @sec-compileatom#3 CompileAtom form alg {
  prods [p"RegExp 0 Atom :: `(` GroupSpecifier[?UnicodeMode]? Disjunction[?UnicodeMode, ?UnicodeSetsMode, ?NamedCaptureGroups] `)`", p"RegExp 1 Atom :: `(` GroupSpecifier[?UnicodeMode]? Disjunction[?UnicodeMode, ?UnicodeSetsMode, ?NamedCaptureGroups] `)`"]
  keys ["Atom :: `(` GroupSpecifier? Disjunction `)`"]
  vars [regexpRecord, direction, m, parenIndex, x, c, d, y, capability, input, xe, ye, r, z]
  steps {
    let m = sdo CompileSubpattern(child 5 |Disjunction|; regexpRecord, direction)
    let parenIndex = @sec-countleftcapturingparensbefore(child 6 |Atom|)
    return closure 0
  }
  closure matcher params [x, c] captures [direction, m, parenIndex] {
    assert x is ty {MatchState}
    assert c is ty {MatcherContinuation}
    let d = closure 1
    return m(x, d)
  }
  closure matcher_continuation params [y] captures [x, c, direction, parenIndex] {
    assert y is ty {MatchState}
    let capability = $Copy(y[[Captures]])
    let input = x[[Input]]
    let xe = x[[EndIndex]]
    let ye = y[[EndIndex]]
    if direction is val {~forward~} {
      assert xe <= ye
      let r = record CaptureRange { [[StartIndex]]: xe, [[EndIndex]]: ye }
    }
    else {
      assert direction is val {~backward~}
      assert ye <= xe
      let r = record CaptureRange { [[StartIndex]]: ye, [[EndIndex]]: xe }
    }
    set expr capability[parenIndex + 1] = r
    let z = record MatchState { [[Input]]: input, [[EndIndex]]: ye, [[Captures]]: capability }
    return c(z)
  }
}

