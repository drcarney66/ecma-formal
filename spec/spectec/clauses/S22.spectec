  return ? @sec-invoke(regexp, $WellKnownSymbol("Symbol.match"), [string])
}

def @sec-string.prototype.matchall "String.prototype.matchAll" (kind builtin params [regexpOrPattern]) vars [#"this value", NewTarget, regexpOrPattern, thisValue, isRegexp, flags, matcher, string, regexp] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  if regexpOrPattern is ty {Object} {
    let isRegexp = ? @sec-isregexp(regexpOrPattern)
    if isRegexp is val {true} {
      let flags = ? @sec-get-o-p(regexpOrPattern, "flags")
      perform ? @sec-requireobjectcoercible(flags)
      if ? @sec-tostring(flags) fails $Contains("g") -> throw @ph-new-error([[TypeError]])
    }
    let matcher = ? @sec-getmethod(regexpOrPattern, $WellKnownSymbol("Symbol.matchAll"))
    if matcher is not val {undefined} {
      return ? @sec-call(matcher, regexpOrPattern, [thisValue])
    }
  }
  let string = ? @sec-tostring(thisValue)
  let regexp = ? @sec-regexpcreate(regexpOrPattern, "g")
  return ? @sec-invoke(regexp, $WellKnownSymbol("Symbol.matchAll"), [string])
}

def @sec-string.prototype.normalize "String.prototype.normalize" (kind builtin params [#"form" opt]) vars [#"this value", NewTarget, #"form", thisValue, string, normal] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  if #"form" is val {undefined} -> set var #"form" = "NFC"
  else -> set var #"form" = ? @sec-tostring(#"form")
  if #"form" is not val {"NFC"; "NFD"; "NFKC"; "NFKD"} -> throw @ph-new-error([[RangeError]])
  let normal = $UnicodeNormalize(string, #"form")
  return normal
}

