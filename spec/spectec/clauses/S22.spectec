  let splitter = ? @sec-construct(speciesCtor, [regexp, newFlags])
  let array = ! @sec-arraycreate(0)
  let lengthA = 0
  if_else substringLimit is val {undefined} { let substringLimitInt = 2 ^ 32 - 1 } else { let substringLimitInt = $ℝ(? @sec-touint32(substringLimit)) }
  if substringLimitInt == 0 -> return array
  if string is val {$"the empty String"()} {
    let matchResult = ? @sec-regexpexec(splitter, string)
    if matchResult is not val {null} -> return array
    perform ! @sec-createdatapropertyorthrow(array, "0", string)
    return array
  }
  let size = $StrLen(?string)
  let lastMatchEnd = 0
  let searchIndex = lastMatchEnd
  repeat_while searchIndex < size {
    perform ? @sec-set-o-p-v-throw(splitter, "lastIndex", $𝔽(searchIndex), true)
    let matchResult = ? @sec-regexpexec(splitter, string)
    if matchResult is val {null} {
      set var searchIndex = @sec-advancestringindex(string, searchIndex, unicodeMatching)
    }
    else {
      let matchEnd = $ℝ(? @sec-tolength(? @sec-get-o-p(splitter, "lastIndex")))
      set var matchEnd = $min(matchEnd, size)
      if matchEnd == lastMatchEnd {
        set var searchIndex = @sec-advancestringindex(string, searchIndex, unicodeMatching)
      }
      else {
        let substring = $Substring(?string, ?lastMatchEnd, ?searchIndex)
        perform ! @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(lengthA)), substring)
        set var lengthA = lengthA + 1
        if lengthA == substringLimitInt -> return array
        set var lastMatchEnd = matchEnd
        let numberOfCaptures = ? @sec-lengthofarraylike(matchResult)
        set var numberOfCaptures = $max(numberOfCaptures - 1, 0)
        let captureIndex = 1
        repeat_while captureIndex <= numberOfCaptures {
          let nextCapture = ? @sec-get-o-p(matchResult, ! @sec-tostring($𝔽(captureIndex)))
          perform ! @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(lengthA)), nextCapture)
          set var captureIndex = captureIndex + 1
          set var lengthA = lengthA + 1
          if lengthA == substringLimitInt -> return array
        }
        set var searchIndex = lastMatchEnd
      }
    }
  }
  let substring = $Substring(?string, ?lastMatchEnd, ?size)
  perform ! @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(lengthA)), substring)
  return array
}

def @sec-get-regexp.prototype.sticky "get RegExp.prototype.sticky" (kind builtin params []) vars [#"this value", NewTarget, regexp, codeUnit] {
  let regexp = this_value
  let codeUnit = $CodeUnit(cu(121, "0079", "LATIN SMALL LETTER Y"))
  return ? @sec-regexphasflag(regexp, codeUnit)
}

def @sec-regexp.prototype.test "RegExp.prototype.test" (kind builtin params [string]) vars [#"this value", NewTarget, string, regexp, match] {
  let regexp = this_value
  if regexp is not ty {Object} -> throw @ph-new-error([[TypeError]])
  set var string = ? @sec-tostring(string)
  let match = ? @sec-regexpexec(regexp, string)
  if match is val {null} -> return false
  return true
}

def @sec-regexp.prototype.tostring "RegExp.prototype.toString" (kind builtin params []) vars [#"this value", NewTarget, regexp, pattern, flags, result] {
  let regexp = this_value
  if regexp is not ty {Object} -> throw @ph-new-error([[TypeError]])
  let pattern = ? @sec-tostring(? @sec-get-o-p(regexp, "source"))
  let flags = ? @sec-tostring(? @sec-get-o-p(regexp, "flags"))
  let result = $"string-concatenation"("/", pattern, "/", flags)
  return result
}

def @sec-get-regexp.prototype.unicode "get RegExp.prototype.unicode" (kind builtin params []) vars [#"this value", NewTarget, regexp, codeUnit] {
  let regexp = this_value
  let codeUnit = $CodeUnit(cu(117, "0075", "LATIN SMALL LETTER U"))
  return ? @sec-regexphasflag(regexp, codeUnit)
}

def @sec-get-regexp.prototype.unicodesets "get RegExp.prototype.unicodeSets" (kind builtin params []) vars [#"this value", NewTarget, regexp, codeUnit] {
  let regexp = this_value
  let codeUnit = $CodeUnit(cu(118, "0076", "LATIN SMALL LETTER V"))
  return ? @sec-regexphasflag(regexp, codeUnit)
}

def @sec-regexpexec "RegExpExec" (kind ao params [regexp : Object, string : String] -> completion<Object | val(null)> | #"throw completion") vars [regexp, string, exec, result] {
  let exec = ? @sec-get-o-p(regexp, "exec")
  if @sec-iscallable(exec) is val {true} {
    let result = ? @sec-call(exec, regexp, [string])
    if result is not ty {Object} and result is not val {null} -> throw @ph-new-error([[TypeError]])
    return result
  }
  perform ? @sec-requireinternalslot(regexp, [[RegExpMatcher]])
  return ? @sec-regexpbuiltinexec(regexp, string)
}

def @sec-regexpbuiltinexec "RegExpBuiltinExec" (kind ao params [regexp : #"initialized RegExp instance", string : String] -> completion<#"Array exotic object" | val(null)> | #"throw completion") vars [regexp, string, length, lastIndex, flags, global, sticky, hasIndices, matcher, fullUnicode, matchSucceeded, input, inputIndex, result, endIndex, capturingGroupsCount, array, match, indices, groupNames, matchedSubstring, groups, hasGroups, matchedGroupNames, i, capture, capturedValue, captureStart, captureEnd, captureRecord, groupName, groupNameNode, indicesArray] {
  let length = $StrLen(?string)
  let lastIndex = $ℝ(? @sec-tolength(! @sec-get-o-p(regexp, "lastIndex")))
  let flags = regexp[[OriginalFlags]]
  if_else flags sat $Contains("g") { let global = true } else { let global = false }
  if_else flags sat $Contains("y") { let sticky = true } else { let sticky = false }
  if_else flags sat $Contains("d") { let hasIndices = true } else { let hasIndices = false }
  if global is val {false} and sticky is val {false} -> set var lastIndex = 0
  let matcher = regexp[[RegExpMatcher]]
  if_else flags sat $Contains("u") or flags sat $Contains("v") { let fullUnicode = true } else { let fullUnicode = false }
  let matchSucceeded = false
  if_else fullUnicode is val {true} { let input = @sec-stringtocodepoints(string) } else { let input = @ph-list-whose-elements([@ph-code-units-of-string(data choice 1, ?string)]) }
  note "Each element of _input_ is considered to be a character."
  repeat_while matchSucceeded is val {false} {
    if lastIndex > length {
      if global is val {true} or sticky is val {true} {
        perform ? @sec-set-o-p-v-throw(regexp, "lastIndex", num_f(+0), true)
      }
      return null
    }
    let inputIndex = @ph-input-index-of(?input, ?lastIndex, ?string)
    let result = matcher(input, inputIndex)
    if result is val {~failure~} {
      if sticky is val {true} {
        perform ? @sec-set-o-p-v-throw(regexp, "lastIndex", num_f(+0), true)
        return null
      }
      set var lastIndex = @sec-advancestringindex(string, lastIndex, fullUnicode)
    }
    else {
      assert result is ty {MatchState}
      set var matchSucceeded = true
    }
  }
  let endIndex = result[[EndIndex]]
  if fullUnicode is val {true} -> set var endIndex = @sec-getstringindex(string, endIndex)
  if global is val {true} or sticky is val {true} {
    perform ? @sec-set-o-p-v-throw(regexp, "lastIndex", $𝔽(endIndex), true)
  }
  let capturingGroupsCount = $ListLen(result[[Captures]])
  assert capturingGroupsCount == regexp[[RegExpRecord]][[CapturingGroupsCount]]
  assert capturingGroupsCount < 2 ^ 32 - 1
  let array = ! @sec-arraycreate(capturingGroupsCount + 1)
  assert $ℝ(@sec-ordinarygetownproperty(array, "length")[[Value]]) == capturingGroupsCount + 1
  perform ! @sec-createdatapropertyorthrow(array, "index", $𝔽(lastIndex))
  perform ! @sec-createdatapropertyorthrow(array, "input", string)
  let match = record #"Match Record" { [[StartIndex]]: lastIndex, [[EndIndex]]: endIndex }
  let indices = $ListNew()
  let groupNames = $ListNew()
  perform $Append(?match, ?indices)
  let matchedSubstring = @sec-getmatchstring(string, match)
  perform ! @sec-createdatapropertyorthrow(array, "0", matchedSubstring)
  if regexp sat @ph-contains-any-nt(|GroupName|) {
    let groups = @sec-ordinaryobjectcreate(null)
    let hasGroups = true
  }
  else {
    let groups = undefined
    let hasGroups = false
  }
  perform ! @sec-createdatapropertyorthrow(array, "groups", groups)
  let matchedGroupNames = $ListNew()
  for_range i incl 1 .. incl capturingGroupsCount {
    let capture = @ph-ith-element(?i, result[[Captures]])
    if capture is val {undefined} {
      let capturedValue = undefined
      perform $Append(undefined, ?indices)
    }
    else {
      let captureStart = capture[[StartIndex]]
      let captureEnd = capture[[EndIndex]]
      if fullUnicode is val {true} {
        set var captureStart = @sec-getstringindex(string, captureStart)
        set var captureEnd = @sec-getstringindex(string, captureEnd)
      }
      let captureRecord = record #"Match Record" { [[StartIndex]]: captureStart, [[EndIndex]]: captureEnd }
      let capturedValue = @sec-getmatchstring(string, captureRecord)
      perform $Append(?captureRecord, ?indices)
    }
    perform ! @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(i)), capturedValue)
    let groupNameNode = @formal-capturegroupname(@formal-regexppattern(regexp), i)
    if groupNameNode is not val {~empty~} {
      let groupName = sdo CapturingGroupName(groupNameNode)
      if matchedGroupNames sat $Contains(?groupName) {
        assert capturedValue is val {undefined}
        perform $Append(undefined, ?groupNames)
      }
      else {
        if capturedValue is not val {undefined} -> perform $Append(?groupName, ?matchedGroupNames)
        note "If there are multiple groups named _groupName_, _groups_ may already have an _groupName_ property at this point. However, because _groups_ is an ordinary object whose properties are all writable data properties, the call to CreateDataPropertyOrThrow is nevertheless guaranteed to succeed."
        perform ! @sec-createdatapropertyorthrow(groups, groupName, capturedValue)
        perform $Append(?groupName, ?groupNames)
      }
    }
    else {
      perform $Append(undefined, ?groupNames)
    }
  }
  if hasIndices is val {true} {
    let indicesArray = @sec-makematchindicesindexpairarray(string, indices, groupNames, hasGroups)
    perform ! @sec-createdatapropertyorthrow(array, "indices", indicesArray)
  }
  return array
}

def @sec-advancestringindex "AdvanceStringIndex" (kind ao params [string : String, index : sort [#"non-negative"] integer, unicode : Boolean] -> sort [#"non-negative"] integer) vars [string, index, unicode, length, codePoint] {
  assert index <= 2 ^ 53 - 1
  if unicode is val {false} -> return index + 1
  let length = $StrLen(?string)
  if index + 1 >= length -> return index + 1
  let codePoint = @sec-codepointat(string, index)
  return index + codePoint[[CodeUnitCount]]
}

def @sec-getstringindex "GetStringIndex" (kind ao params [string : String, codePointIndex : sort [#"non-negative"] integer] -> sort [#"non-negative"] integer) vars [string, codePointIndex, length, codeUnitCount, codePointCount, codePoint] {
  if string is val {$"the empty String"()} -> return 0
  let length = $StrLen(?string)
  let codeUnitCount = 0
  let codePointCount = 0
  repeat_while codeUnitCount < length {
    if codePointCount == codePointIndex -> return codeUnitCount
    let codePoint = @sec-codepointat(string, codeUnitCount)
    set var codeUnitCount = codeUnitCount + codePoint[[CodeUnitCount]]
    set var codePointCount = codePointCount + 1
  }
  return length
}

def @sec-getmatchstring "GetMatchString" (kind ao params [string : String, match : #"Match Record"] -> String) vars [string, match] {
  assert! expr $Chain(match[[StartIndex]], data choice 1, match[[EndIndex]], data choice 1, $StrLen(?string))
  return $Substring(?string, match[[StartIndex]], match[[EndIndex]])
}

def @sec-getmatchindexpair "GetMatchIndexPair" (kind ao params [string : String, match : #"Match Record"] -> Array) vars [string, match] {
  assert expr $Chain(match[[StartIndex]], data choice 1, match[[EndIndex]], data choice 1, $StrLen(?string))
  return @sec-createarrayfromlist([$𝔽(match[[StartIndex]]), $𝔽(match[[EndIndex]])])
}

def @sec-makematchindicesindexpairarray "MakeMatchIndicesIndexPairArray" (kind ao params [string : String, indices : list<#"Match Record" | val(undefined)>, groupNames : list<String | val(undefined)>, hasGroups : Boolean] -> Array) vars [string, indices, groupNames, hasGroups, n, array, groups, i, matchIndices, matchIndexPair, name] {
  let n = $ListLen(?indices)
  assert n < 2 ^ 32 - 1
  assert groupNames sat @ph-has-n-elements(n - 1)
  note "The _groupNames_ List contains elements aligned with the _indices_ List starting at _indices_[1]."
  let array = ! @sec-arraycreate(n)
  if hasGroups is val {true} {
    let groups = @sec-ordinaryobjectcreate(null)
  }
  else {
    let groups = undefined
  }
  perform ! @sec-createdatapropertyorthrow(array, "groups", groups)
  for_range i incl 0 .. excl n {
    let matchIndices = indices[i]
    if matchIndices is not val {undefined} {
      let matchIndexPair = @sec-getmatchindexpair(string, matchIndices)
    }
    else {
      let matchIndexPair = undefined
    }
    perform ! @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(i)), matchIndexPair)
    if i > 0 {
      let name = groupNames[i - 1]
      if name is not val {undefined} {
        assert groups is not val {undefined}
        note "If there are multiple groups named _name_, _groups_ may already have an _name_ property at this point. However, because _groups_ is an ordinary object whose properties are all writable data properties, the call to CreateDataPropertyOrThrow is nevertheless guaranteed to succeed."
        perform ! @sec-createdatapropertyorthrow(groups, name, matchIndexPair)
      }
    }
  }
  return array
}

def @sec-createregexpstringiterator "CreateRegExpStringIterator" (kind ao params [regexp : Object, string : String, global : Boolean, fullUnicode : Boolean] -> Object) vars [regexp, string, global, fullUnicode, iterator] {
  let iterator = @sec-ordinaryobjectcreate(intrinsic [[RegExpStringIteratorPrototype]], [[[IteratingRegExp]], [[IteratedString]], [[Global]], [[Unicode]], [[Done]]])
  set field iterator[[IteratingRegExp]] = regexp
  set field iterator[[IteratedString]] = string
  set field iterator[[Global]] = global
  set field iterator[[Unicode]] = fullUnicode
  set field iterator[[Done]] = false
  return iterator
}

def @sec-%regexpstringiteratorprototype%.next "%RegExpStringIteratorPrototype%.next" (kind builtin params []) vars [#"this value", NewTarget, iteratorObj, regexp, string, global, fullUnicode, match, matchString, thisIndex, nextIndex] {
  let iteratorObj = this_value
  if iteratorObj is not ty {Object} -> throw @ph-new-error([[TypeError]])
  if iteratorObj sat @ph-not-has-all-slots(data sort #"RegExp String Iterator Object Instance", data choice 0, clause @sec-properties-of-regexp-string-iterator-instances) -> throw @ph-new-error([[TypeError]])
  if iteratorObj[[Done]] is val {true} {
    return @sec-createiterresultobject(undefined, true)
  }
  let regexp = iteratorObj[[IteratingRegExp]]
  let string = iteratorObj[[IteratedString]]
  let global = iteratorObj[[Global]]
  let fullUnicode = iteratorObj[[Unicode]]
  let match = ? @sec-regexpexec(regexp, string)
  if match is val {null} {
    set field iteratorObj[[Done]] = true
    return @sec-createiterresultobject(undefined, true)
  }
  if global is val {false} {
    set field iteratorObj[[Done]] = true
    return @sec-createiterresultobject(match, false)
  }
  let matchString = ? @sec-tostring(? @sec-get-o-p(match, "0"))
  if matchString is val {$"the empty String"()} {
    let thisIndex = $ℝ(? @sec-tolength(? @sec-get-o-p(regexp, "lastIndex")))
    let nextIndex = @sec-advancestringindex(string, thisIndex, fullUnicode)
    perform ? @sec-set-o-p-v-throw(regexp, "lastIndex", $𝔽(nextIndex), true)
  }
  return @sec-createiterresultobject(match, false)
}

sdo_row @sec-patterns-static-semantics-capturing-group-number CapturingGroupNumber form alg {
  prods [p"RegExp 0 DecimalEscape :: NonZeroDigit DecimalDigits[~Sep]? [lookahead ∉ DecimalDigit]"]
  keys ["DecimalEscape :: NonZeroDigit"]
  vars []
  steps {
    return sdo MV(child 5 |NonZeroDigit|)
  }
}

sdo_row @sec-patterns-static-semantics-capturing-group-number#1 CapturingGroupNumber form alg {
  prods [p"RegExp 1 DecimalEscape :: NonZeroDigit DecimalDigits[~Sep]? [lookahead ∉ DecimalDigit]"]
  keys ["DecimalEscape :: NonZeroDigit DecimalDigits"]
  vars [n]
  steps {
    let n = $Count(data choice 2, child 5 |DecimalDigits|)
    return (sdo MV(child 5 |NonZeroDigit|) * 10 ^ n plus sdo MV(child 5 |DecimalDigits|))
  }
}

