    }
    if child 5 |Elision| sat $Present() {
      set var status = @sec-completion-ao(sdo IteratorDestructuringAssignmentEvaluation(child 5 |Elision|; iteratorRecord))
      if status is ty {#"abrupt completion"} {
        assert iteratorRecord[[Done]] is val {true}
        return ? status
