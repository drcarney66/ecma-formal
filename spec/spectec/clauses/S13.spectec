sdo_row @sec-template-literals-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - SubstitutionTemplate : TemplateHead Expression[+In, ?Yield, ?Await] TemplateSpans[?Yield, ?Await]"]
  keys ["SubstitutionTemplate : TemplateHead Expression TemplateSpans"]
  vars [head, subRef, sub, middle, tail]
  steps {
    let head = @ph-tv-defined(child 5 |TemplateHead|, clause @sec-template-literal-lexical-components)
    let subRef = ? sdo Evaluation(child 5 |Expression|)
    let sub = ? @sec-getvalue(subRef)
    let middle = ? @sec-tostring(sub)
    let tail = ? sdo Evaluation(child 5 |TemplateSpans|)
    return $"string-concatenation"(head, middle, tail)
  }
}

