sdo_row @sec-logical-not-operator-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - UnaryExpression : `!` UnaryExpression[?Yield, ?Await]"]
  keys ["UnaryExpression : `!` UnaryExpression"]
  vars [expr, oldValue]
  steps {
    let expr = ? sdo Evaluation(child 5 |UnaryExpression|)
    let oldValue = @sec-toboolean(? @sec-getvalue(expr))
    if oldValue is val {true} -> return false
    return true
  }
}

