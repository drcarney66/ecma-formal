sdo_row @sec-runtime-semantics-argumentlistevaluation#7 ArgumentListEvaluation form alg {
  prods [p"Syntactic - SubstitutionTemplate : TemplateHead Expression[+In, ?Yield, ?Await] TemplateSpans[?Yield, ?Await]"]
  keys ["SubstitutionTemplate : TemplateHead Expression TemplateSpans"]
  vars [firstSubRef, firstSub, restSub]
  steps {
    let firstSubRef = ? sdo Evaluation(child 5 |Expression|)
    let firstSub = ? @sec-getvalue(firstSubRef)
    let restSub = ? sdo SubstitutionEvaluation(child 5 |TemplateSpans|)
    assert restSub is ty {sort [#"possibly empty"] List}
    return $ListConcat([[firstSub], restSub])
  }
}

sdo_row @sec-optional-chaining-evaluation Evaluation form alg {
  prods [p"Syntactic - OptionalExpression : MemberExpression[?Yield, ?Await] OptionalChain[?Yield, ?Await]"]
