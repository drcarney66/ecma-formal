sdo_row @sec-runtime-semantics-propertydefinitionevaluation PropertyDefinitionEvaluation form alg {
  prods [p"Syntactic - PropertyDefinitionList : PropertyDefinitionList[?Yield, ?Await] `,` PropertyDefinition[?Yield, ?Await]"]
  keys ["PropertyDefinitionList : PropertyDefinitionList `,` PropertyDefinition"]
  vars [#"obj"]
  steps {
    perform ? sdo PropertyDefinitionEvaluation(child 5 |PropertyDefinitionList|; #"obj")
    perform ? sdo PropertyDefinitionEvaluation(child 5 |PropertyDefinition|; #"obj")
    return ~unused~
  }
}

sdo_row @sec-runtime-semantics-propertydefinitionevaluation#1 PropertyDefinitionEvaluation form alg {
  prods [p"Syntactic - PropertyDefinition : `...` AssignmentExpression[+In, ?Yield, ?Await]"]
  keys ["PropertyDefinition : `...` AssignmentExpression"]
  vars [#"obj", exprValue, fromValue, excludedNames]
  steps {
    let exprValue = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let fromValue = ? @sec-getvalue(exprValue)
    let excludedNames = $ListNew()
    perform ? @sec-copydataproperties(#"obj", fromValue, excludedNames)
    return ~unused~
  }
}

sdo_row @sec-runtime-semantics-propertydefinitionevaluation#2 PropertyDefinitionEvaluation form alg {
  prods [p"Syntactic - PropertyDefinition : IdentifierReference[?Yield, ?Await]"]
  keys ["PropertyDefinition : IdentifierReference"]
  vars [#"obj", propertyName, exprValue, propertyValue]
  steps {
    let propertyName = sdo StringValue(child 5 |IdentifierReference|)
    let exprValue = ? sdo Evaluation(child 5 |IdentifierReference|)
    let propertyValue = ? @sec-getvalue(exprValue)
    assert #"obj" is ty {pred(sat @spec-copy-2(data choice 1, data choice 0))}
    perform ! @sec-createdatapropertyorthrow(#"obj", propertyName, propertyValue)
    return ~unused~
  }
}

sdo_row @sec-runtime-semantics-propertydefinitionevaluation#3 PropertyDefinitionEvaluation form alg {
  prods [p"Syntactic - PropertyDefinition : PropertyName[?Yield, ?Await] `:` AssignmentExpression[+In, ?Yield, ?Await]"]
  keys ["PropertyDefinition : PropertyName `:` AssignmentExpression"]
  vars [#"obj", propertyKey, isProtoSetter, propertyValue, exprValueRef]
  steps {
    let propertyKey = ? sdo Evaluation(child 5 |PropertyName|)
    if call_at @ph-this-nt(|PropertyDefinition|) sat @ph-in-json-evaluated-script() {
      let isProtoSetter = false
    }
    else_if propertyKey is val {"__proto__"} and sdo IsComputedPropertyKey(child 5 |PropertyName|) is val {false} {
      let isProtoSetter = true
    }
    else {
      let isProtoSetter = false
    }
    if @sec-isanonymousfunctiondefinition(child 5 |AssignmentExpression|) is val {true} and isProtoSetter is val {false} {
      let propertyValue = ? sdo NamedEvaluation(child 5 |AssignmentExpression|; propertyKey)
    }
    else {
      let exprValueRef = ? sdo Evaluation(child 5 |AssignmentExpression|)
      let propertyValue = ? @sec-getvalue(exprValueRef)
    }
    if isProtoSetter is val {true} {
      if propertyValue is ty {Object} or propertyValue is val {null} {
        perform ! #"obj"[[SetPrototypeOf]](propertyValue)
      }
      return ~unused~
    }
    assert #"obj" is ty {pred(sat @spec-copy-2(data choice 1, data choice 0))}
    perform ! @sec-createdatapropertyorthrow(#"obj", propertyKey, propertyValue)
    return ~unused~
  }
}

sdo_row @sec-runtime-semantics-propertydefinitionevaluation#4 PropertyDefinitionEvaluation form alg {
  prods [p"Syntactic - PropertyDefinition : MethodDefinition[?Yield, ?Await]"]
  keys ["PropertyDefinition : MethodDefinition"]
  vars [#"obj", result]
  steps {
    let result = ? sdo MethodDefinitionEvaluation(child 5 |MethodDefinition|; #"obj", true)
    assert result is val {~empty~}
    return ~unused~
  }
}

