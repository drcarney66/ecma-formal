sdo_row @sec-runtime-semantics-propertydestructuringassignmentevaluation#1 PropertyDestructuringAssignmentEvaluation form alg {
  prods [p"Syntactic 0 AssignmentProperty : IdentifierReference[?Yield, ?Await] Initializer[+In, ?Yield, ?Await]?", p"Syntactic 1 AssignmentProperty : IdentifierReference[?Yield, ?Await] Initializer[+In, ?Yield, ?Await]?"]
  keys ["AssignmentProperty : IdentifierReference Initializer?"]
  vars [value, propertyName, leftRef, defaultValue]
  steps {
    let propertyName = sdo StringValue(child 5 |IdentifierReference|)
    let leftRef = ? @sec-resolvebinding(propertyName)
    set var value = ? @sec-getv(value, propertyName)
    if child 5 |Initializer| sat $Present() and value is val {undefined} {
      if @sec-isanonymousfunctiondefinition(child 5 |Initializer|) is val {true} {
        set var value = ? sdo NamedEvaluation(child 5 |Initializer|; propertyName)
      }
      else {
        let defaultValue = ? sdo Evaluation(child 5 |Initializer|)
        set var value = ? @sec-getvalue(defaultValue)
      }
    }
    perform ? @sec-putvalue(leftRef, value)
    return [propertyName]
  }
}

