sdo_row @sec-delete-operator-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - UnaryExpression : `delete` UnaryExpression[?Yield, ?Await]"]
  keys ["UnaryExpression : `delete` UnaryExpression"]
  vars [#"ref", baseObj, deleteStatus, base]
  steps {
    let #"ref" = ? sdo Evaluation(child 5 |UnaryExpression|)
    if #"ref" is not ty {#"Reference Record"} -> return true
    if @sec-isunresolvablereference(#"ref") is val {true} {
      assert #"ref"[[Strict]] is val {false}
      return true
    }
    if @sec-ispropertyreference(#"ref") is val {true} {
      assert @sec-isprivatereference(#"ref") is val {false}
      if @sec-issuperreference(#"ref") is val {true} -> throw @ph-new-error([[ReferenceError]])
      let baseObj = ? @sec-toobject(#"ref"[[Base]])
      if #"ref"[[ReferencedName]] is not ty {#"property key"} {
        set field #"ref"[[ReferencedName]] = ? @sec-topropertykey(#"ref"[[ReferencedName]])
      }
      let deleteStatus = ? baseObj[[Delete]](#"ref"[[ReferencedName]])
      if deleteStatus is val {false} and #"ref"[[Strict]] is val {true} -> throw @ph-new-error([[TypeError]])
      return deleteStatus
    }
    let base = #"ref"[[Base]]
    assert base is ty {#"Environment Record"}
    return ? base.DeleteBinding(#"ref"[[ReferencedName]])
  }
}

sdo_row @sec-void-operator-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - UnaryExpression : `void` UnaryExpression[?Yield, ?Await]"]
  keys ["UnaryExpression : `void` UnaryExpression"]
  vars [expr]
  steps {
    let expr = ? sdo Evaluation(child 5 |UnaryExpression|)
    perform ? @sec-getvalue(expr)
    return undefined
  }
}

sdo_row @sec-typeof-operator-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - UnaryExpression : `typeof` UnaryExpression[?Yield, ?Await]"]
  keys ["UnaryExpression : `typeof` UnaryExpression"]
  vars [value]
  steps {
    let value = ? sdo Evaluation(child 5 |UnaryExpression|)
    if value is ty {#"Reference Record"} {
      if @sec-isunresolvablereference(value) is val {true} -> return "undefined"
    }
    set var value = ? @sec-getvalue(value)
    if value is val {undefined} -> return "undefined"
    if value is val {null} -> return "object"
    if value is ty {String} -> return "string"
    if value is ty {Symbol} -> return "symbol"
    if value is ty {Boolean} -> return "boolean"
    if value is ty {Number} -> return "number"
    if value is ty {BigInt} -> return "bigint"
    assert value is ty {Object}
    if expr $"the host is a web browser"(data choice 0, clause @sec-IsHTMLDDA-internal-slot) {
      if value sat $HasSlot([[IsHTMLDDA]]) -> return "undefined"
    }
    if value sat $HasMethod([[Call]]) -> return "function"
    return "object"
  }
}

sdo_row @sec-unary-plus-operator-runtime-semantics-evaluation Evaluation form alg {
