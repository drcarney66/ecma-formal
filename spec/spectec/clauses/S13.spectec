  }
}

sdo_row @sec-runtime-semantics-arrayaccumulation ArrayAccumulation form alg {
  prods [p"Syntactic - Elision : `,`"]
  keys ["Elision : `,`"]
  vars [array, nextIndex, length]
  steps {
    let length = nextIndex + 1
    perform ? @sec-set-o-p-v-throw(array, "length", $𝔽(length), true)
    note "The above step throws if _length_ exceeds 2<sup>32</sup> - 1."
    return length
  }
}

sdo_row @sec-runtime-semantics-arrayaccumulation#1 ArrayAccumulation form alg {
  prods [p"Syntactic - Elision : Elision `,`"]
  keys ["Elision : Elision `,`"]
  vars [array, nextIndex]
  steps {
    return ? sdo ArrayAccumulation(child 5 |Elision|; array, (nextIndex + 1))
  }
}

sdo_row @sec-runtime-semantics-arrayaccumulation#2 ArrayAccumulation form alg {
  prods [p"Syntactic 0 ElementList : Elision? AssignmentExpression[+In, ?Yield, ?Await]", p"Syntactic 1 ElementList : Elision? AssignmentExpression[+In, ?Yield, ?Await]"]
  keys ["ElementList : Elision? AssignmentExpression"]
  vars [array, nextIndex, initResult, initValue]
  steps {
    if child 5 |Elision| sat $Present() {
      set var nextIndex = ? sdo ArrayAccumulation(child 5 |Elision|; array, nextIndex)
    }
    let initResult = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let initValue = ? @sec-getvalue(initResult)
    perform ! @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(nextIndex)), initValue)
    return nextIndex + 1
  }
}

sdo_row @sec-runtime-semantics-arrayaccumulation#3 ArrayAccumulation form alg {
  prods [p"Syntactic 0 ElementList : Elision? SpreadElement[?Yield, ?Await]", p"Syntactic 1 ElementList : Elision? SpreadElement[?Yield, ?Await]"]
  keys ["ElementList : Elision? SpreadElement"]
  vars [array, nextIndex]
  steps {
    if child 5 |Elision| sat $Present() {
      set var nextIndex = ? sdo ArrayAccumulation(child 5 |Elision|; array, nextIndex)
    }
    return ? sdo ArrayAccumulation(child 5 |SpreadElement|; array, nextIndex)
  }
}

sdo_row @sec-runtime-semantics-arrayaccumulation#4 ArrayAccumulation form alg {
  prods [p"Syntactic 0 ElementList : ElementList[?Yield, ?Await] `,` Elision? AssignmentExpression[+In, ?Yield, ?Await]", p"Syntactic 1 ElementList : ElementList[?Yield, ?Await] `,` Elision? AssignmentExpression[+In, ?Yield, ?Await]"]
  keys ["ElementList : ElementList `,` Elision? AssignmentExpression"]
  vars [array, nextIndex, initResult, initValue]
  steps {
    set var nextIndex = ? sdo ArrayAccumulation(child 3 |ElementList|; array, nextIndex)
    if child 5 |Elision| sat $Present() {
      set var nextIndex = ? sdo ArrayAccumulation(child 5 |Elision|; array, nextIndex)
    }
    let initResult = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let initValue = ? @sec-getvalue(initResult)
    perform ! @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(nextIndex)), initValue)
    return nextIndex + 1
  }
}

sdo_row @sec-runtime-semantics-arrayaccumulation#5 ArrayAccumulation form alg {
  prods [p"Syntactic 0 ElementList : ElementList[?Yield, ?Await] `,` Elision? SpreadElement[?Yield, ?Await]", p"Syntactic 1 ElementList : ElementList[?Yield, ?Await] `,` Elision? SpreadElement[?Yield, ?Await]"]
  keys ["ElementList : ElementList `,` Elision? SpreadElement"]
  vars [array, nextIndex]
  steps {
    set var nextIndex = ? sdo ArrayAccumulation(child 3 |ElementList|; array, nextIndex)
    if child 5 |Elision| sat $Present() {
      set var nextIndex = ? sdo ArrayAccumulation(child 5 |Elision|; array, nextIndex)
    }
    return ? sdo ArrayAccumulation(child 5 |SpreadElement|; array, nextIndex)
  }
}

sdo_row @sec-runtime-semantics-arrayaccumulation#6 ArrayAccumulation form alg {
  prods [p"Syntactic - SpreadElement : `...` AssignmentExpression[+In, ?Yield, ?Await]"]
  keys ["SpreadElement : `...` AssignmentExpression"]
  vars [array, nextIndex, spreadRef, spreadObj, iteratorRecord, next]
  steps {
    let spreadRef = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let spreadObj = ? @sec-getvalue(spreadRef)
    let iteratorRecord = ? @sec-getiterator(spreadObj, ~sync~)
    repeat {
      let next = ? @sec-iteratorstepvalue(iteratorRecord)
      if next is val {~done~} -> return nextIndex
      perform ! @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(nextIndex)), next)
      set var nextIndex = nextIndex + 1
    }
  }
}

sdo_row @sec-array-initializer-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic 0 ArrayLiteral : `[` Elision? `]`", p"Syntactic 1 ArrayLiteral : `[` Elision? `]`"]
  keys ["ArrayLiteral : `[` Elision? `]`"]
  vars [array]
  steps {
    let array = ! @sec-arraycreate(0)
    if child 5 |Elision| sat $Present() {
      perform ? sdo ArrayAccumulation(child 5 |Elision|; array, 0)
    }
    return array
  }
}

