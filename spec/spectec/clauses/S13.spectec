}

sdo_row @sec-assignment-operators-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - AssignmentExpression : LeftHandSideExpression[?Yield, ?Await] `=` AssignmentExpression[?In, ?Yield, ?Await]"]
  keys ["AssignmentExpression : LeftHandSideExpression `=` AssignmentExpression"]
  vars [leftRef, lhs, rightValue, rightRef, assignmentPattern]
  steps {
    if child 5 |LeftHandSideExpression| is neither ty {|ObjectLiteral|; |ArrayLiteral|} {
      let leftRef = ? sdo Evaluation(child 5 |LeftHandSideExpression|)
      if sdo AssignmentTargetType(child 5 |LeftHandSideExpression|) is val {~web-compat~} -> throw @ph-new-error([[ReferenceError]])
      if @sec-isanonymousfunctiondefinition(child 5 |AssignmentExpression|) is val {true} and sdo IsIdentifierRef(child 5 |LeftHandSideExpression|) is val {true} {
        let lhs = sdo StringValue(child 5 |LeftHandSideExpression|)
        let rightValue = ? sdo NamedEvaluation(child 5 |AssignmentExpression|; lhs)
      }
      else {
        let rightRef = ? sdo Evaluation(child 5 |AssignmentExpression|)
        let rightValue = ? @sec-getvalue(rightRef)
      }
      perform ? @sec-putvalue(leftRef, rightValue)
      return rightValue
    }
    let assignmentPattern = $CoveredBy(|AssignmentPattern|, child 5 |LeftHandSideExpression|)
    let rightRef = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let rightValue = ? @sec-getvalue(rightRef)
    perform ? sdo DestructuringAssignmentEvaluation(assignmentPattern; rightValue)
    return rightValue
  }
}

sdo_row @sec-assignment-operators-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - AssignmentExpression : LeftHandSideExpression[?Yield, ?Await] AssignmentOperator AssignmentExpression[?In, ?Yield, ?Await]"]
  keys ["AssignmentExpression : LeftHandSideExpression AssignmentOperator AssignmentExpression"]
  vars [leftRef, leftValue, rightRef, rightValue, assignmentOpText, opText, result]
  steps {
    let leftRef = ? sdo Evaluation(child 5 |LeftHandSideExpression|)
    if sdo AssignmentTargetType(child 5 |LeftHandSideExpression|) is val {~web-compat~} -> throw @ph-new-error([[ReferenceError]])
    let leftValue = ? @sec-getvalue(leftRef)
    let rightRef = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let rightValue = ? @sec-getvalue(rightRef)
    let assignmentOpText = $SourceText(child 5 |AssignmentOperator|)
    let opText = $TableAssociated(table t"sec-assignment-operators-runtime-semantics-evaluation-table-0", ?assignmentOpText)
    let result = ? @sec-applystringornumericbinaryoperator(leftValue, opText, rightValue)
    perform ? @sec-putvalue(leftRef, result)
    return result
  }
}

