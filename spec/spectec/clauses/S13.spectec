sdo_row @sec-meta-properties-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - NewTarget : `new` `.` `target`"]
  keys ["NewTarget : `new` `.` `target`"]
  vars []
  steps {
    return @sec-getnewtarget()
  }
}

sdo_row @sec-meta-properties-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - ImportMeta : `import` `.` `meta`"]
  keys ["ImportMeta : `import` `.` `meta`"]
  vars [module, importMeta, importMetaValues, entry]
  steps {
    let module = @sec-getactivescriptormodule()
    assert module is ty {#"Source Text Module Record"}
    let importMeta = module[[ImportMeta]]
    if importMeta is val {~empty~} {
      set var importMeta = @sec-ordinaryobjectcreate(null)
      let importMetaValues = @sec-hostgetimportmetaproperties(module)
      for_each_rec [[[Key]], [[Value]]] entry in importMetaValues {
        perform ! @sec-createdatapropertyorthrow(importMeta, entry[[Key]], entry[[Value]])
      }
      perform @sec-hostfinalizeimportmeta(importMeta, module)
      set field module[[ImportMeta]] = importMeta
      return importMeta
    }
    assert importMeta is ty {Object}
    return importMeta
  }
}

sdo_row @sec-postfix-increment-operator-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - UpdateExpression : LeftHandSideExpression[?Yield, ?Await] [no LineTerminator here] `++`"]
  keys ["UpdateExpression : LeftHandSideExpression `++`"]
  vars [lhs, oldValue, newValue]
  steps {
    let lhs = ? sdo Evaluation(child 5 |LeftHandSideExpression|)
    if sdo AssignmentTargetType(child 5 |LeftHandSideExpression|) is val {~web-compat~} -> throw @ph-new-error([[ReferenceError]])
    let oldValue = ? @sec-tonumeric(? @sec-getvalue(lhs))
    if oldValue is ty {Number} {
      let newValue = @sec-numeric-types-number-add(oldValue, num_f(1))
    }
    else {
      assert oldValue is ty {BigInt}
      let newValue = @sec-numeric-types-bigint-add(oldValue, num_z(1))
    }
    perform ? @sec-putvalue(lhs, newValue)
    return oldValue
  }
}

sdo_row @sec-postfix-decrement-operator-runtime-semantics-evaluation Evaluation form alg {
