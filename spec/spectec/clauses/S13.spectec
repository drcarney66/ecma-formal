  prods [p"Syntactic 0 AssignmentElement : DestructuringAssignmentTarget[?Yield, ?Await] Initializer[+In, ?Yield, ?Await]?", p"Syntactic 1 AssignmentElement : DestructuringAssignmentTarget[?Yield, ?Await] Initializer[+In, ?Yield, ?Await]?"]
  keys ["AssignmentElement : DestructuringAssignmentTarget Initializer?"]
  vars [iteratorRecord, leftRef, value, next, target, defaultValue, nestedAssignmentPattern]
  steps {
    if child 5 |DestructuringAssignmentTarget| is neither ty {|ObjectLiteral|; |ArrayLiteral|} {
      let leftRef = ? sdo Evaluation(child 5 |DestructuringAssignmentTarget|)
    }
    let value = undefined
    if iteratorRecord[[Done]] is val {false} {
      let next = ? @sec-iteratorstepvalue(iteratorRecord)
      if next is not val {~done~} {
        set var value = next
      }
    }
    if child 5 |Initializer| sat $Present() and value is val {undefined} {
      if @sec-isanonymousfunctiondefinition(child 5 |Initializer|) is val {true} and sdo IsIdentifierRef(child 5 |DestructuringAssignmentTarget|) is val {true} {
        let target = sdo StringValue(child 5 |DestructuringAssignmentTarget|)
        set var value = ? sdo NamedEvaluation(child 5 |Initializer|; target)
      }
      else {
        let defaultValue = ? sdo Evaluation(child 5 |Initializer|)
        set var value = ? @sec-getvalue(defaultValue)
      }
    }
    if child 5 |DestructuringAssignmentTarget| is ty {|ObjectLiteral|; |ArrayLiteral|} {
      let nestedAssignmentPattern = $CoveredBy(|AssignmentPattern|, child 5 |DestructuringAssignmentTarget|)
      return ? sdo DestructuringAssignmentEvaluation(nestedAssignmentPattern; value)
    }
    return ? @sec-putvalue(leftRef, value)
  }
}

sdo_row @sec-runtime-semantics-iteratordestructuringassignmentevaluation#7 IteratorDestructuringAssignmentEvaluation form alg {
  prods [p"Syntactic - AssignmentRestElement : `...` DestructuringAssignmentTarget[?Yield, ?Await]"]
  keys ["AssignmentRestElement : `...` DestructuringAssignmentTarget"]
  vars [iteratorRecord, leftRef, array, n, next, nestedAssignmentPattern]
  steps {
    if child 5 |DestructuringAssignmentTarget| is neither ty {|ObjectLiteral|; |ArrayLiteral|} {
      let leftRef = ? sdo Evaluation(child 5 |DestructuringAssignmentTarget|)
    }
    let array = ! @sec-arraycreate(0)
    let n = 0
    repeat_while iteratorRecord[[Done]] is val {false} {
      let next = ? @sec-iteratorstepvalue(iteratorRecord)
      if next is not val {~done~} {
        perform ! @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(n)), next)
        set var n = n + 1
      }
    }
    if child 5 |DestructuringAssignmentTarget| is neither ty {|ObjectLiteral|; |ArrayLiteral|} {
      return ? @sec-putvalue(leftRef, array)
    }
    let nestedAssignmentPattern = $CoveredBy(|AssignmentPattern|, child 5 |DestructuringAssignmentTarget|)
    return ? sdo DestructuringAssignmentEvaluation(nestedAssignmentPattern; array)
  }
}

sdo_row @sec-runtime-semantics-keyeddestructuringassignmentevaluation KeyedDestructuringAssignmentEvaluation form alg {
  prods [p"Syntactic 0 AssignmentElement : DestructuringAssignmentTarget[?Yield, ?Await] Initializer[+In, ?Yield, ?Await]?", p"Syntactic 1 AssignmentElement : DestructuringAssignmentTarget[?Yield, ?Await] Initializer[+In, ?Yield, ?Await]?"]
  keys ["AssignmentElement : DestructuringAssignmentTarget Initializer?"]
  vars [value, propertyName, leftRef, target, rhsValue, defaultValue, assignmentPattern]
  steps {
    if child 5 |DestructuringAssignmentTarget| is neither ty {|ObjectLiteral|; |ArrayLiteral|} {
      let leftRef = ? sdo Evaluation(child 5 |DestructuringAssignmentTarget|)
    }
    set var value = ? @sec-getv(value, propertyName)
    if child 5 |Initializer| sat $Present() and value is val {undefined} {
      if @sec-isanonymousfunctiondefinition(child 5 |Initializer|) is val {true} and sdo IsIdentifierRef(child 5 |DestructuringAssignmentTarget|) is val {true} {
        let target = sdo StringValue(child 5 |DestructuringAssignmentTarget|)
        let rhsValue = ? sdo NamedEvaluation(child 5 |Initializer|; target)
      }
      else {
        let defaultValue = ? sdo Evaluation(child 5 |Initializer|)
        let rhsValue = ? @sec-getvalue(defaultValue)
      }
    }
    else {
      let rhsValue = value
    }
    if child 5 |DestructuringAssignmentTarget| is ty {|ObjectLiteral|; |ArrayLiteral|} {
      let assignmentPattern = $CoveredBy(|AssignmentPattern|, child 5 |DestructuringAssignmentTarget|)
      return ? sdo DestructuringAssignmentEvaluation(assignmentPattern; rhsValue)
    }
    return ? @sec-putvalue(leftRef, rhsValue)
  }
}

sdo_row @sec-comma-operator-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - Expression : Expression[?In, ?Yield, ?Await] `,` AssignmentExpression[?In, ?Yield, ?Await]"]
  keys ["Expression : Expression `,` AssignmentExpression"]
  vars [leftRef, rightRef]
  steps {
    let leftRef = ? sdo Evaluation(child 5 |Expression|)
    perform ? @sec-getvalue(leftRef)
    let rightRef = ? sdo Evaluation(child 5 |AssignmentExpression|)
    return ? @sec-getvalue(rightRef)
  }
}

