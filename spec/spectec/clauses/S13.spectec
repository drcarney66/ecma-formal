sdo_row @sec-array-initializer-runtime-semantics-evaluation#2 Evaluation form alg {
  prods [p"Syntactic 0 ArrayLiteral : `[` ElementList[?Yield, ?Await] `,` Elision? `]`", p"Syntactic 1 ArrayLiteral : `[` ElementList[?Yield, ?Await] `,` Elision? `]`"]
  keys ["ArrayLiteral : `[` ElementList `,` Elision? `]`"]
  vars [array, nextIndex]
