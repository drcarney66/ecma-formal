-- ECMA-262 SpecTec Clauses: S13

def @sec-isvalidregularexpressionliteral "IsValidRegularExpressionLiteral" (kind ao params [literal : |RegularExpressionLiteral|] -> Boolean) vars [literal, flags, u, v, patternText, stringValue, i, parseResult] {
  let flags = sdo FlagText(literal)
  if flags sat @ph-points-other-than(data choice 1, [code "d", code "g", code "i", code "m", code "s", code "u", code "v", code "y"]) -> return false
  if flags sat @ph-point-more-than-once() -> return false
  if_else flags sat $Contains(code "u") { let u = true } else { let u = false }
  if_else flags sat $Contains(code "v") { let v = true } else { let v = false }
  let patternText = sdo BodyText(literal)
  if u is val {false} and v is val {false} {
    let stringValue = @sec-codepointstostring(patternText)
    set var patternText = $ListNew()
    for_range i incl 0 .. excl $StrLen(?stringValue) {
      perform $Append($UnitOrPointOf(data choice 0, $NumericValue($UnitAt(?i, ?stringValue))), ?patternText)
    }
  }
  let parseResult = @sec-parsepattern(patternText, u, v)
  if parseResult is ty {#"Parse Node"} -> return true
  return false
}

def @sec-templatestring "TemplateString" (kind ao params [templateToken : |NoSubstitutionTemplate| | |TemplateHead| | |TemplateMiddle| | |TemplateTail|, escapes : val(~raw~) | val(~cooked~)] -> String | val(undefined)) vars [templateToken, escapes] {
  if escapes is val {~raw~} -> return sdo TRV(templateToken)
  return sdo TV(templateToken)
}

def @sec-gettemplateobject "GetTemplateObject" (kind ao params [templateLiteral : #"Parse Node"] -> Array) vars [templateLiteral, #"realm", templateRegistry, element, rawStrings, cookedStrings, count, template, rawObj, index, propertyKey, cookedValue, rawValue] {
  let #"realm" = $CurrentRealm()
  let templateRegistry = #"realm"[[TemplateMap]]
  for_each element in templateRegistry {
    if element[[Site]] sat @ph-same-as(data sort #"Parse Node", ?templateLiteral) {
      return element[[Array]]
    }
  }
  let rawStrings = sdo TemplateStrings(templateLiteral; ~raw~)
  assert rawStrings is ty {list<String>}
  let cookedStrings = sdo TemplateStrings(templateLiteral; ~cooked~)
  let count = $ListLen(@ph-the-list(?cookedStrings))
  assert count <= 2 ^ 32 - 1
  let template = ! @sec-arraycreate(count)
  let rawObj = ! @sec-arraycreate(count)
  let index = 0
  repeat_while index < count {
    let propertyKey = ! @sec-tostring($𝔽(index))
    let cookedValue = cookedStrings[index]
    perform ! @sec-definepropertyorthrow(template, propertyKey, record PropertyDescriptor { [[Value]]: cookedValue, [[Writable]]: false, [[Enumerable]]: true, [[Configurable]]: false })
    let rawValue = @ph-the-string(data choice 0, rawStrings[index])
    perform ! @sec-definepropertyorthrow(rawObj, propertyKey, record PropertyDescriptor { [[Value]]: rawValue, [[Writable]]: false, [[Enumerable]]: true, [[Configurable]]: false })
    set var index = index + 1
  }
  perform ! @sec-setintegritylevel(rawObj, ~frozen~)
  perform ! @sec-definepropertyorthrow(template, "raw", record PropertyDescriptor { [[Value]]: rawObj, [[Writable]]: false, [[Enumerable]]: false, [[Configurable]]: false })
  perform ! @sec-setintegritylevel(template, ~frozen~)
  perform $Append(record Record { [[Site]]: templateLiteral, [[Array]]: template }, #"realm"[[TemplateMap]])
  return template
}

def @sec-evaluate-property-access-with-expression-key "EvaluatePropertyAccessWithExpressionKey" (kind ao params [baseValue : #"ECMAScript language value", expr : |Expression|, strict : Boolean] -> completion<#"Reference Record"> | #"abrupt completion") vars [baseValue, expr, strict, propertyNameRef, propertyNameValue] {
  let propertyNameRef = ? sdo Evaluation(expr)
  let propertyNameValue = ? @sec-getvalue(propertyNameRef)
  note "In most cases, ToPropertyKey will be performed on _propertyNameValue_ immediately after this step. However, in the case of `a[b] = c`, it will not be performed until after evaluation of `c`."
  return record #"Reference Record" { [[Base]]: baseValue, [[ReferencedName]]: propertyNameValue, [[Strict]]: strict, [[ThisValue]]: ~empty~ }
}

def @sec-evaluate-property-access-with-identifier-key "EvaluatePropertyAccessWithIdentifierKey" (kind ao params [baseValue : #"ECMAScript language value", identifierName : |IdentifierName|, strict : Boolean] -> #"Reference Record") vars [baseValue, identifierName, strict, propertyNameString] {
  let propertyNameString = sdo StringValue(identifierName)
  return record #"Reference Record" { [[Base]]: baseValue, [[ReferencedName]]: propertyNameString, [[Strict]]: strict, [[ThisValue]]: ~empty~ }
}

def @sec-evaluatenew "EvaluateNew" (kind ao params [constructExpr : |NewExpression| | |MemberExpression|, argumentsNode : val(~empty~) | |Arguments|] -> completion<Object> | #"abrupt completion") vars [constructExpr, argumentsNode, #"ref", ctor, argList] {
  let #"ref" = ? sdo Evaluation(constructExpr)
  let ctor = ? @sec-getvalue(#"ref")
  if argumentsNode is val {~empty~} {
    let argList = $ListNew()
  }
  else {
    let argList = ? sdo ArgumentListEvaluation(argumentsNode)
  }
  if @sec-isconstructor(ctor) is val {false} -> throw @ph-new-error([[TypeError]])
  return ? @sec-construct(ctor, argList)
}

def @sec-evaluatecall "EvaluateCall" (kind ao params [func : #"ECMAScript language value", thisValueRef : #"ECMAScript language value" | #"Reference Record", argumentListNode : #"Parse Node", tailPosition : Boolean] -> completion<#"ECMAScript language value"> | #"abrupt completion") vars [func, thisValueRef, argumentListNode, tailPosition, thisValue, refEnv, argList] {
  if thisValueRef is ty {#"Reference Record"} {
    if @sec-ispropertyreference(thisValueRef) is val {true} {
      let thisValue = @sec-getthisvalue(thisValueRef)
    }
    else {
      let refEnv = thisValueRef[[Base]]
      assert refEnv is ty {#"Environment Record"}
      let thisValue = refEnv.WithBaseObject()
    }
  }
  else {
    let thisValue = undefined
  }
  let argList = ? sdo ArgumentListEvaluation(argumentListNode)
  if func is not ty {Object} -> throw @ph-new-error([[TypeError]])
  if @sec-iscallable(func) is val {false} -> throw @ph-new-error([[TypeError]])
  if tailPosition is val {true} -> perform @sec-preparefortailcall()
  return ? @sec-call(func, thisValue, argList)
}

def @sec-getsuperconstructor "GetSuperConstructor" (kind ao params [] -> Object | val(null)) vars [envRecord, activeFunc, superCtor] {
  let envRecord = @sec-getthisenvironment()
  assert envRecord is ty {#"Function Environment Record"}
  let activeFunc = envRecord[[FunctionObject]]
  assert activeFunc is ty {#"ECMAScript function object"}
  let superCtor = ! activeFunc[[GetPrototypeOf]]()
  return superCtor
}

def @sec-makesuperpropertyreference "MakeSuperPropertyReference" (kind ao params [actualThis : #"ECMAScript language value", propertyKey : #"ECMAScript language value", strict : Boolean] -> #"Super Reference Record") vars [actualThis, propertyKey, strict, envRecord, baseValue] {
  let envRecord = @sec-getthisenvironment()
  assert envRecord.HasSuperBinding() is val {true}
  assert envRecord is ty {#"Function Environment Record"}
  let baseValue = @sec-getsuperbase(envRecord)
  return record #"Reference Record" { [[Base]]: baseValue, [[ReferencedName]]: propertyKey, [[Strict]]: strict, [[ThisValue]]: actualThis }
}

def @sec-evaluate-import-call "EvaluateImportCall" (kind ao params [specifierExpr : #"Parse Node", optionsExpr : #"Parse Node" opt] -> completion<Promise> | #"abrupt completion") vars [specifierExpr, optionsExpr, referrer, specifierRef, specifier, optionsRef, options, promiseCapability, specifierString, attrs, attrsObj, entries, entry, key, value, #"rest", sorted, least, a, moduleRequest] {
  let referrer = @sec-getactivescriptormodule()
  if referrer is val {null} -> set var referrer = $CurrentRealm()
  let specifierRef = ? sdo Evaluation(specifierExpr)
  let specifier = ? @sec-getvalue(specifierRef)
  if optionsExpr sat $Present() {
    let optionsRef = ? sdo Evaluation(optionsExpr)
    let options = ? @sec-getvalue(optionsRef)
  }
  else {
    let options = undefined
  }
  let promiseCapability = ! @sec-newpromisecapability(intrinsic [[Promise]])
  let specifierString = @sec-completion-ao(@sec-tostring(specifier))
  block {
    assert specifierString is ty {#"Completion Record"}
    if specifierString is ty {#"abrupt completion"} {
      perform ? @sec-call(promiseCapability[[Reject]], undefined, [specifierString[[Value]]])
      return promiseCapability[[Promise]]
    }
    set var specifierString = ! specifierString
  }
  let attrs = $ListNew()
  if options is not val {undefined} {
    if options is not ty {Object} {
      perform ! @sec-call(promiseCapability[[Reject]], undefined, [@ph-new-error(err [[TypeError]])])
      return promiseCapability[[Promise]]
    }
    let attrsObj = @sec-completion-ao(@sec-get-o-p(options, "with"))
    block {
      assert attrsObj is ty {#"Completion Record"}
      if attrsObj is ty {#"abrupt completion"} {
        perform ? @sec-call(promiseCapability[[Reject]], undefined, [attrsObj[[Value]]])
        return promiseCapability[[Promise]]
      }
      set var attrsObj = ! attrsObj
    }
    if attrsObj is not val {undefined} {
      if attrsObj is not ty {Object} {
        perform ! @sec-call(promiseCapability[[Reject]], undefined, [@ph-new-error(err [[TypeError]])])
        return promiseCapability[[Promise]]
      }
      let entries = @sec-completion-ao(@sec-enumerableownproperties(attrsObj, ~key+value~))
      block {
        assert entries is ty {#"Completion Record"}
        if entries is ty {#"abrupt completion"} {
          perform ? @sec-call(promiseCapability[[Reject]], undefined, [entries[[Value]]])
          return promiseCapability[[Promise]]
        }
        set var entries = ! entries
      }
      for_each entry in entries {
        let key = ! @sec-get-o-p(entry, "0")
        let value = ! @sec-get-o-p(entry, "1")
        if key is ty {String} {
          if value is not ty {String} {
            perform ! @sec-call(promiseCapability[[Reject]], undefined, [@ph-new-error(err [[TypeError]])])
            return promiseCapability[[Promise]]
          }
          perform $Append(record #"ImportAttribute Record" { [[Key]]: key, [[Value]]: value }, ?attrs)
        }
      }
    }
    if @sec-AllImportAttributesSupported(attrs) is val {false} {
      perform ! @sec-call(promiseCapability[[Reject]], undefined, [@ph-new-error(err [[TypeError]])])
      return promiseCapability[[Promise]]
    }
    let #"rest" = $Copy(?attrs)
    let sorted = $ListNew()
    repeat_while #"rest" fails $IsEmpty() {
      let least = $ListElem(data choice 1, ?#"rest")
      for_each a in #"rest" {
        if ! @sec-islessthan(a[[Key]], least[[Key]], true) is val {true} -> set var least = a
      }
      perform $Append(?least, ?sorted)
      perform $RemoveElem(?least, ?#"rest")
    }
    set var attrs = sorted
  }
  let moduleRequest = @ph-new-record(record #"ModuleRequest Record" { [[Specifier]]: specifierString, [[Attributes]]: attrs })
  perform @sec-HostLoadImportedModule(referrer, moduleRequest, ~empty~, promiseCapability)
  return promiseCapability[[Promise]]
}

def @sec-ContinueDynamicImport "ContinueDynamicImport" (kind ao params [promiseCapability : #"PromiseCapability Record", moduleCompletion : completion<#"Module Record"> | #"throw completion"] -> val(~unused~)) vars [promiseCapability, moduleCompletion, module, loadPromise, rejectedClosure, reason, onRejected, linkAndEvaluateClosure, #"link", evaluatePromise, fulfilledClosure, namespace, onFulfilled, linkAndEvaluate] {
  if moduleCompletion is ty {#"abrupt completion"} {
    perform ! @sec-call(promiseCapability[[Reject]], undefined, [moduleCompletion[[Value]]])
    return ~unused~
  }
  let module = moduleCompletion[[Value]]
  let loadPromise = module.LoadRequestedModules()
  let rejectedClosure = closure 0
  let onRejected = @sec-createbuiltinfunction(rejectedClosure, 1, "", [])
  let linkAndEvaluateClosure = closure 1
  let linkAndEvaluate = @sec-createbuiltinfunction(linkAndEvaluateClosure, 0, "", [])
  perform @sec-performpromisethen(loadPromise, linkAndEvaluate, onRejected)
  return ~unused~
  closure abstract params [reason] captures [promiseCapability] {
    perform ! @sec-call(promiseCapability[[Reject]], undefined, [reason])
    return @sec-normalcompletion(undefined)
  }
  closure abstract params none captures [module, promiseCapability, onRejected] {
    let #"link" = @sec-completion-ao(module.Link())
    if #"link" is ty {#"abrupt completion"} {
      perform ! @sec-call(promiseCapability[[Reject]], undefined, [#"link"[[Value]]])
      return @sec-normalcompletion(undefined)
    }
    let evaluatePromise = module.Evaluate()
    let fulfilledClosure = closure 2
    let onFulfilled = @sec-createbuiltinfunction(fulfilledClosure, 0, "", [])
    perform @sec-performpromisethen(evaluatePromise, onFulfilled, onRejected)
    return ~unused~
  }
  closure abstract params none captures [module, promiseCapability] {
    let namespace = @sec-getmodulenamespace(module)
    perform ! @sec-call(promiseCapability[[Resolve]], undefined, [namespace])
    return @sec-normalcompletion(undefined)
  }
}

def @sec-instanceofoperator "InstanceofOperator" (kind ao params [value : #"ECMAScript language value", target : #"ECMAScript language value"] -> completion<Boolean> | #"throw completion") vars [value, target, instOfHandler] {
  if target is not ty {Object} -> throw @ph-new-error([[TypeError]])
  let instOfHandler = ? @sec-getmethod(target, $WellKnownSymbol("Symbol.hasInstance"))
  if instOfHandler is not val {undefined} {
    return @sec-toboolean(? @sec-call(instOfHandler, target, [value]))
  }
  if @sec-iscallable(target) is val {false} -> throw @ph-new-error([[TypeError]])
  return ? @sec-ordinaryhasinstance(target, value)
}

def @sec-applystringornumericbinaryoperator "ApplyStringOrNumericBinaryOperator" (kind ao params [leftValue : #"ECMAScript language value", opText : doc "**, *, /, %, +, -, <<, >>, >>>, &, ^, or |", rightValue : #"ECMAScript language value"] -> completion<String | BigInt | Number> | #"throw completion") vars [leftValue, opText, rightValue, leftPrimitive, rightPrimitive, leftString, rightString, leftNumber, rightNumber, operation] {
  if opText is val {code "+"} {
    let leftPrimitive = ? @sec-toprimitive(leftValue)
    let rightPrimitive = ? @sec-toprimitive(rightValue)
    if leftPrimitive is ty {String} or rightPrimitive is ty {String} {
      let leftString = ? @sec-tostring(leftPrimitive)
      let rightString = ? @sec-tostring(rightPrimitive)
      if $StringTooLarge($StrLen(?leftString) + $StrLen(?rightString)) is val {true} -> throw @ph-new-error([[RangeError]])
      return $"string-concatenation"(leftString, rightString)
    }
    set var leftValue = leftPrimitive
    set var rightValue = rightPrimitive
  }
  note "At this point, it must be a numeric operation."
  let leftNumber = ? @sec-tonumeric(leftValue)
  let rightNumber = ? @sec-tonumeric(rightValue)
  if @sec-sametype(leftNumber, rightNumber) is val {false} -> throw @ph-new-error([[TypeError]])
  if leftNumber is ty {BigInt} {
    if opText is val {code "**"} -> return ? @sec-numeric-types-bigint-exponentiate(leftNumber, rightNumber)
    if opText is val {code "/"} -> return ? @sec-numeric-types-bigint-divide(leftNumber, rightNumber)
    if opText is val {code "%"} -> return ? @sec-numeric-types-bigint-remainder(leftNumber, rightNumber)
    if opText is val {code ">>>"} -> return ? @sec-numeric-types-bigint-unsignedRightShift(leftNumber, rightNumber)
    let operation = $TableAssociated(table t"sec-applystringornumericbinaryoperator-table-0", ?opText)
  }
  else {
    assert leftNumber is ty {Number}
    let operation = $TableAssociated(table t"sec-applystringornumericbinaryoperator-table-1", ?opText)
  }
  return operation(leftNumber, rightNumber)
}

def @sec-evaluatestringornumericbinaryexpression "EvaluateStringOrNumericBinaryExpression" (kind ao params [leftOperand : #"Parse Node", opText : doc "**, *, /, %, +, -, <<, >>, >>>, &, ^, or |", rightOperand : #"Parse Node"] -> completion<String | BigInt | Number> | #"abrupt completion") vars [leftOperand, opText, rightOperand, leftRef, leftValue, rightRef, rightValue] {
  let leftRef = ? sdo Evaluation(leftOperand)
  let leftValue = ? @sec-getvalue(leftRef)
  let rightRef = ? sdo Evaluation(rightOperand)
  let rightValue = ? @sec-getvalue(rightRef)
  return ? @sec-applystringornumericbinaryoperator(leftValue, opText, rightValue)
}

sdo_row @sec-static-semantics-stringvalue StringValue form alg {
  prods [p"Lexical - IdentifierName :: IdentifierStart", p"Lexical - IdentifierName :: IdentifierName IdentifierPart"]
  keys ["\n        IdentifierName ::\n          IdentifierStart\n          IdentifierName IdentifierPart\n      "]
  vars [nameUnescaped]
  steps {
    let nameUnescaped = sdo IdentifierCodePoints(child 6 |IdentifierName|)
    return @sec-codepointstostring(nameUnescaped)
  }
}

sdo_row @sec-static-semantics-stringvalue#1 StringValue form alg {
  prods [p"Syntactic - IdentifierReference : [~Yield] `yield`", p"Syntactic - BindingIdentifier : `yield`", p"Syntactic - LabelIdentifier : [~Yield] `yield`"]
  keys ["\n        IdentifierReference : `yield`\n\n        BindingIdentifier : `yield`\n\n        LabelIdentifier : `yield`\n      "]
  vars []
  steps {
    return "yield"
  }
}

sdo_row @sec-static-semantics-stringvalue#2 StringValue form alg {
  prods [p"Syntactic - IdentifierReference : [~Await] `await`", p"Syntactic - BindingIdentifier : `await`", p"Syntactic - LabelIdentifier : [~Await] `await`"]
  keys ["\n        IdentifierReference : `await`\n\n        BindingIdentifier : `await`\n\n        LabelIdentifier : `await`\n      "]
  vars []
  steps {
    return "await"
  }
}

sdo_row @sec-static-semantics-stringvalue#3 StringValue form alg {
  prods [p"Syntactic - Identifier : IdentifierName but not ReservedWord"]
  keys ["Identifier : IdentifierName but not ReservedWord"]
  vars []
  steps {
    return sdo StringValue(child 5 |IdentifierName|)
  }
}

sdo_row @sec-static-semantics-stringvalue#4 StringValue form alg {
  prods [p"Lexical - PrivateIdentifier :: `#` IdentifierName"]
  keys ["\n        PrivateIdentifier ::\n          `#` IdentifierName\n      "]
  vars []
  steps {
    return $"string-concatenation"(cu(35, "0023", "NUMBER SIGN"), sdo StringValue(child 5 |IdentifierName|))
  }
}

sdo_row @sec-static-semantics-stringvalue#5 StringValue form alg {
  prods [p"Syntactic - ModuleExportName : StringLiteral"]
  keys ["\n        ModuleExportName : StringLiteral\n      "]
  vars []
  steps {
    return sdo SV(child 5 |StringLiteral|)
  }
}

sdo_row @sec-identifiers-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - IdentifierReference : Identifier"]
  keys ["IdentifierReference : Identifier"]
  vars []
  steps {
    return ? @sec-resolvebinding(sdo StringValue(child 5 |Identifier|))
  }
}

sdo_row @sec-identifiers-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - IdentifierReference : [~Yield] `yield`"]
  keys ["IdentifierReference : `yield`"]
  vars []
