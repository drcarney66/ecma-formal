sdo_row @sec-runtime-semantics-destructuringassignmentevaluation#6 DestructuringAssignmentEvaluation form alg {
  prods [p"Syntactic 01 ArrayAssignmentPattern : `[` Elision? AssignmentRestElement[?Yield, ?Await]? `]`", p"Syntactic 11 ArrayAssignmentPattern : `[` Elision? AssignmentRestElement[?Yield, ?Await]? `]`"]
