sdo_row @sec-template-literals-runtime-semantics-evaluation#5 Evaluation form alg {
  prods [p"Syntactic - TemplateMiddleList : TemplateMiddleList[?Yield, ?Await] TemplateMiddle Expression[+In, ?Yield, ?Await]"]
  keys ["TemplateMiddleList : TemplateMiddleList TemplateMiddle Expression"]
  vars [#"rest", middle, subRef, sub, last]
  steps {
    let #"rest" = ? sdo Evaluation(child 5 |TemplateMiddleList|)
    let middle = @ph-tv-defined(child 5 |TemplateMiddle|, clause @sec-template-literal-lexical-components)
    let subRef = ? sdo Evaluation(child 5 |Expression|)
    let sub = ? @sec-getvalue(subRef)
    let last = ? @sec-tostring(sub)
    return $"string-concatenation"(#"rest", middle, last)
  }
}

