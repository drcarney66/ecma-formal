sdo_row @sec-function-calls-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - CallExpression : CoverCallExpressionAndAsyncArrowHead[?Yield, ?Await]"]
  keys ["CallExpression : CoverCallExpressionAndAsyncArrowHead"]
  vars [expr, memberExpr, args, #"ref", func, argList, evalArg, strictCaller, thisCall, tailCall]
  steps {
    let expr = $CoveredBy(|CallMemberExpression|, child 5 |CoverCallExpressionAndAsyncArrowHead|)
    let memberExpr = $ChildOf(|MemberExpression|, ?expr)
    let args = $ChildOf(|Arguments|, ?expr)
    let #"ref" = ? sdo Evaluation(memberExpr)
    let func = ? @sec-getvalue(#"ref")
    if #"ref" is ty {#"Reference Record"} and @sec-ispropertyreference(#"ref") is val {false} and #"ref"[[ReferencedName]] is val {"eval"} {
      if @sec-samevalue(func, intrinsic [[eval]]) is val {true} {
        let argList = ? sdo ArgumentListEvaluation(args)
        if argList sat @ph-has-no-elements() -> return undefined
        let evalArg = $ListElem(data choice 1, ?argList)
        if_else @sec-isstrict(call_at @ph-this-nt(|CallExpression|)) is val {true} { let strictCaller = true } else { let strictCaller = false }
        return ? @sec-performeval(evalArg, strictCaller, ~direct-eval~)
      }
    }
    let thisCall = call_at @ph-this-nt(|CallExpression|)
    let tailCall = @sec-isintailposition(thisCall)
    return ? @sec-evaluatecall(func, #"ref", args, tailCall)
  }
}

sdo_row @sec-function-calls-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - CallExpression : CallExpression[?Yield, ?Await] Arguments[?Yield, ?Await]"]
  keys ["CallExpression : CallExpression Arguments"]
  vars [#"ref", func, thisCall, tailCall]
  steps {
    let #"ref" = ? sdo Evaluation(child 5 |CallExpression|)
    let func = ? @sec-getvalue(#"ref")
    let thisCall = call_at @ph-this-nt(|CallExpression|)
    let tailCall = @sec-isintailposition(thisCall)
    return ? @sec-evaluatecall(func, #"ref", child 5 |Arguments|, tailCall)
  }
}

sdo_row @sec-super-keyword-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - SuperProperty : `super` `[` Expression[+In, ?Yield, ?Await] `]`"]
  keys ["SuperProperty : `super` `[` Expression `]`"]
  vars [envRecord, actualThis, propertyNameRef, propertyNameValue, strict]
  steps {
    let envRecord = @sec-getthisenvironment()
    let actualThis = ? envRecord.GetThisBinding()
    let propertyNameRef = ? sdo Evaluation(child 5 |Expression|)
    let propertyNameValue = ? @sec-getvalue(propertyNameRef)
    let strict = @sec-isstrict(call_at @ph-this-nt(|SuperProperty|))
    note "In most cases, ToPropertyKey will be performed on _propertyNameValue_ immediately after this step. However, in the case of `super[b] = c`, it will not be performed until after evaluation of `c`."
    return @sec-makesuperpropertyreference(actualThis, propertyNameValue, strict)
  }
}

sdo_row @sec-super-keyword-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - SuperProperty : `super` `.` IdentifierName"]
  keys ["SuperProperty : `super` `.` IdentifierName"]
  vars [envRecord, actualThis, propertyKey, strict]
  steps {
    let envRecord = @sec-getthisenvironment()
    let actualThis = ? envRecord.GetThisBinding()
    let propertyKey = sdo StringValue(child 5 |IdentifierName|)
    let strict = @sec-isstrict(call_at @ph-this-nt(|SuperProperty|))
    return @sec-makesuperpropertyreference(actualThis, propertyKey, strict)
  }
}

sdo_row @sec-super-keyword-runtime-semantics-evaluation#2 Evaluation form alg {
  prods [p"Syntactic - SuperCall : `super` Arguments[?Yield, ?Await]"]
  keys ["SuperCall : `super` Arguments"]
  vars [newTarget, superCtor, argList, result, thisER, funcObj]
  steps {
    let newTarget = @sec-getnewtarget()
    assert newTarget is ty {constructor}
    let superCtor = @sec-getsuperconstructor()
    let argList = ? sdo ArgumentListEvaluation(child 5 |Arguments|)
    if @sec-isconstructor(superCtor) is val {false} -> throw @ph-new-error([[TypeError]])
    let result = ? @sec-construct(superCtor, argList, newTarget)
    let thisER = @sec-getthisenvironment()
    assert thisER is ty {#"Function Environment Record"}
    perform ? @sec-bindthisvalue(thisER, result)
    let funcObj = thisER[[FunctionObject]]
    assert funcObj is ty {#"ECMAScript function object"}
    perform ? @sec-initializeinstanceelements(result, funcObj)
    return result
  }
}

sdo_row @sec-runtime-semantics-argumentlistevaluation ArgumentListEvaluation form alg {
  prods [p"Syntactic - Arguments : `(` `)`"]
  keys ["Arguments : `(` `)`"]
  vars []
  steps {
    return $ListNew()
  }
}

sdo_row @sec-runtime-semantics-argumentlistevaluation#1 ArgumentListEvaluation form alg {
  prods [p"Syntactic - ArgumentList : AssignmentExpression[+In, ?Yield, ?Await]"]
  keys ["ArgumentList : AssignmentExpression"]
  vars [#"ref", arg]
  steps {
    let #"ref" = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let arg = ? @sec-getvalue(#"ref")
    return [arg]
  }
}

sdo_row @sec-runtime-semantics-argumentlistevaluation#2 ArgumentListEvaluation form alg {
  prods [p"Syntactic - ArgumentList : `...` AssignmentExpression[+In, ?Yield, ?Await]"]
  keys ["ArgumentList : `...` AssignmentExpression"]
  vars [#"list", spreadRef, spreadObj, iteratorRecord, next]
  steps {
    let #"list" = $ListNew()
    let spreadRef = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let spreadObj = ? @sec-getvalue(spreadRef)
    let iteratorRecord = ? @sec-getiterator(spreadObj, ~sync~)
    repeat {
      let next = ? @sec-iteratorstepvalue(iteratorRecord)
      if next is val {~done~} -> return #"list"
      perform $Append(?next, ?#"list")
    }
  }
}

sdo_row @sec-runtime-semantics-argumentlistevaluation#3 ArgumentListEvaluation form alg {
  prods [p"Syntactic - ArgumentList : ArgumentList[?Yield, ?Await] `,` AssignmentExpression[+In, ?Yield, ?Await]"]
  keys ["ArgumentList : ArgumentList `,` AssignmentExpression"]
  vars [precedingArgs, #"ref", arg]
  steps {
    let precedingArgs = ? sdo ArgumentListEvaluation(child 5 |ArgumentList|)
    let #"ref" = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let arg = ? @sec-getvalue(#"ref")
    return $ListConcat([precedingArgs, [arg]])
  }
}

sdo_row @sec-runtime-semantics-argumentlistevaluation#4 ArgumentListEvaluation form alg {
  prods [p"Syntactic - ArgumentList : ArgumentList[?Yield, ?Await] `,` `...` AssignmentExpression[+In, ?Yield, ?Await]"]
  keys ["ArgumentList : ArgumentList `,` `...` AssignmentExpression"]
  vars [precedingArgs, spreadRef, iteratorRecord, next]
  steps {
    let precedingArgs = ? sdo ArgumentListEvaluation(child 5 |ArgumentList|)
    let spreadRef = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let iteratorRecord = ? @sec-getiterator(? @sec-getvalue(spreadRef), ~sync~)
    repeat {
      let next = ? @sec-iteratorstepvalue(iteratorRecord)
      if next is val {~done~} -> return precedingArgs
      perform $Append(?next, ?precedingArgs)
    }
  }
}

