sdo_row @sec-import-call-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic 0 ImportCall : `import` `(` AssignmentExpression[+In, ?Yield, ?Await] `,` AssignmentExpression[+In, ?Yield, ?Await] `,`? `)`", p"Syntactic 1 ImportCall : `import` `(` AssignmentExpression[+In, ?Yield, ?Await] `,` AssignmentExpression[+In, ?Yield, ?Await] `,`? `)`"]
  keys ["ImportCall : `import` `(` AssignmentExpression `,` AssignmentExpression `,`? `)`"]
  vars []
  steps {
    return ? @sec-evaluate-import-call(child 0 |AssignmentExpression|, child 1 |AssignmentExpression|)
  }
}

sdo_row @sec-tagged-templates-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - MemberExpression : MemberExpression[?Yield, ?Await] TemplateLiteral[?Yield, ?Await, +Tagged]"]
  keys ["MemberExpression : MemberExpression TemplateLiteral"]
  vars [tagRef, tagFunc, thisCall, tailCall]
  steps {
    let tagRef = ? sdo Evaluation(child 5 |MemberExpression|)
    let tagFunc = ? @sec-getvalue(tagRef)
    let thisCall = call_at @ph-this-nt(|MemberExpression|)
    let tailCall = @sec-isintailposition(thisCall)
    return ? @sec-evaluatecall(tagFunc, tagRef, child 5 |TemplateLiteral|, tailCall)
  }
}

