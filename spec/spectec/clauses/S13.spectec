sdo_row @sec-runtime-semantics-substitutionevaluation#2 SubstitutionEvaluation form alg {
  prods [p"Syntactic - TemplateMiddleList : TemplateMiddle Expression[+In, ?Yield, ?Await]"]
  keys ["TemplateMiddleList : TemplateMiddle Expression"]
  vars [subRef, sub]
  steps {
    let subRef = ? sdo Evaluation(child 5 |Expression|)
    let sub = ? @sec-getvalue(subRef)
    return [sub]
  }
}

sdo_row @sec-runtime-semantics-substitutionevaluation#3 SubstitutionEvaluation form alg {
  prods [p"Syntactic - TemplateMiddleList : TemplateMiddleList[?Yield, ?Await] TemplateMiddle Expression[+In, ?Yield, ?Await]"]
  keys ["TemplateMiddleList : TemplateMiddleList TemplateMiddle Expression"]
  vars [preceding, nextRef, next]
  steps {
    let preceding = ? sdo SubstitutionEvaluation(child 5 |TemplateMiddleList|)
    let nextRef = ? sdo Evaluation(child 5 |Expression|)
    let next = ? @sec-getvalue(nextRef)
    return $ListConcat([preceding, [next]])
  }
}

