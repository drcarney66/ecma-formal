    return ? @sec-resolvebinding("await")
  }
}

sdo_row @sec-relational-operators-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - RelationalExpression : RelationalExpression[?In, ?Yield, ?Await] `<` ShiftExpression[?Yield, ?Await]"]
  keys ["RelationalExpression : RelationalExpression `&lt;` ShiftExpression"]
  vars [leftRef, leftValue, rightRef, rightValue, result]
  steps {
    let leftRef = ? sdo Evaluation(child 5 |RelationalExpression|)
    let leftValue = ? @sec-getvalue(leftRef)
    let rightRef = ? sdo Evaluation(child 5 |ShiftExpression|)
    let rightValue = ? @sec-getvalue(rightRef)
    let result = ? @sec-islessthan(leftValue, rightValue, true)
    if result is val {undefined} -> return false
    return result
  }
}

sdo_row @sec-relational-operators-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - RelationalExpression : RelationalExpression[?In, ?Yield, ?Await] `>` ShiftExpression[?Yield, ?Await]"]
  keys ["RelationalExpression : RelationalExpression `&gt;` ShiftExpression"]
  vars [leftRef, leftValue, rightRef, rightValue, result]
  steps {
    let leftRef = ? sdo Evaluation(child 5 |RelationalExpression|)
    let leftValue = ? @sec-getvalue(leftRef)
    let rightRef = ? sdo Evaluation(child 5 |ShiftExpression|)
    let rightValue = ? @sec-getvalue(rightRef)
    let result = ? @sec-islessthan(rightValue, leftValue, false)
    if result is val {undefined} -> return false
    return result
  }
}

sdo_row @sec-relational-operators-runtime-semantics-evaluation#2 Evaluation form alg {
  prods [p"Syntactic - RelationalExpression : RelationalExpression[?In, ?Yield, ?Await] `<=` ShiftExpression[?Yield, ?Await]"]
  keys ["RelationalExpression : RelationalExpression `&lt;=` ShiftExpression"]
  vars [leftRef, leftValue, rightRef, rightValue, result]
  steps {
    let leftRef = ? sdo Evaluation(child 5 |RelationalExpression|)
    let leftValue = ? @sec-getvalue(leftRef)
    let rightRef = ? sdo Evaluation(child 5 |ShiftExpression|)
    let rightValue = ? @sec-getvalue(rightRef)
    let result = ? @sec-islessthan(rightValue, leftValue, false)
    if result is val {true; undefined} -> return false
    return true
  }
}

sdo_row @sec-relational-operators-runtime-semantics-evaluation#3 Evaluation form alg {
  prods [p"Syntactic - RelationalExpression : RelationalExpression[?In, ?Yield, ?Await] `>=` ShiftExpression[?Yield, ?Await]"]
  keys ["RelationalExpression : RelationalExpression `&gt;=` ShiftExpression"]
  vars [leftRef, leftValue, rightRef, rightValue, result]
  steps {
    let leftRef = ? sdo Evaluation(child 5 |RelationalExpression|)
    let leftValue = ? @sec-getvalue(leftRef)
    let rightRef = ? sdo Evaluation(child 5 |ShiftExpression|)
    let rightValue = ? @sec-getvalue(rightRef)
    let result = ? @sec-islessthan(leftValue, rightValue, true)
    if result is val {true; undefined} -> return false
    return true
  }
}

sdo_row @sec-relational-operators-runtime-semantics-evaluation#4 Evaluation form alg {
  prods [p"Syntactic - RelationalExpression : RelationalExpression[?In, ?Yield, ?Await] `instanceof` ShiftExpression[?Yield, ?Await]"]
  keys ["RelationalExpression : RelationalExpression `instanceof` ShiftExpression"]
  vars [leftRef, leftValue, rightRef, rightValue]
  steps {
    let leftRef = ? sdo Evaluation(child 5 |RelationalExpression|)
    let leftValue = ? @sec-getvalue(leftRef)
    let rightRef = ? sdo Evaluation(child 5 |ShiftExpression|)
    let rightValue = ? @sec-getvalue(rightRef)
    return ? @sec-instanceofoperator(leftValue, rightValue)
  }
}

sdo_row @sec-relational-operators-runtime-semantics-evaluation#5 Evaluation form alg {
  prods [p"Syntactic - RelationalExpression : [+In] RelationalExpression[+In, ?Yield, ?Await] `in` ShiftExpression[?Yield, ?Await]"]
  keys ["RelationalExpression : RelationalExpression `in` ShiftExpression"]
  vars [leftRef, leftValue, rightRef, rightValue]
  steps {
    let leftRef = ? sdo Evaluation(child 5 |RelationalExpression|)
    let leftValue = ? @sec-getvalue(leftRef)
    let rightRef = ? sdo Evaluation(child 5 |ShiftExpression|)
    let rightValue = ? @sec-getvalue(rightRef)
    if rightValue is not ty {Object} -> throw @ph-new-error([[TypeError]])
    return ? @sec-hasproperty(rightValue, ? @sec-topropertykey(leftValue))
  }
}

sdo_row @sec-relational-operators-runtime-semantics-evaluation#6 Evaluation form alg {
  prods [p"Syntactic - RelationalExpression : [+In] PrivateIdentifier `in` ShiftExpression[?Yield, ?Await]"]
  keys ["RelationalExpression : PrivateIdentifier `in` ShiftExpression"]
  vars [privateIdentifier, rightRef, rightValue, privateEnv, privateName]
  steps {
    let privateIdentifier = sdo StringValue(child 5 |PrivateIdentifier|)
    let rightRef = ? sdo Evaluation(child 5 |ShiftExpression|)
    let rightValue = ? @sec-getvalue(rightRef)
    if rightValue is not ty {Object} -> throw @ph-new-error([[TypeError]])
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    assert privateEnv is not val {null}
    let privateName = @sec-resolve-private-identifier(privateEnv, privateIdentifier)
    if @sec-privateelementfind(rightValue, privateName) is val {~empty~} -> return false
    return true
  }
}

sdo_row @sec-equality-operators-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - EqualityExpression : EqualityExpression[?In, ?Yield, ?Await] `==` RelationalExpression[?In, ?Yield, ?Await]"]
  keys ["EqualityExpression : EqualityExpression `==` RelationalExpression"]
  vars [leftRef, leftValue, rightRef, rightValue]
  steps {
    let leftRef = ? sdo Evaluation(child 5 |EqualityExpression|)
    let leftValue = ? @sec-getvalue(leftRef)
    let rightRef = ? sdo Evaluation(child 5 |RelationalExpression|)
    let rightValue = ? @sec-getvalue(rightRef)
    return ? @sec-islooselyequal(rightValue, leftValue)
  }
}

