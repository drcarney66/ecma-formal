sdo_row @sec-runtime-semantics-destructuringassignmentevaluation#8 DestructuringAssignmentEvaluation form alg {
  prods [p"Syntactic 00 ArrayAssignmentPattern : `[` AssignmentElementList[?Yield, ?Await] `,` Elision? AssignmentRestElement[?Yield, ?Await]? `]`", p"Syntactic 01 ArrayAssignmentPattern : `[` AssignmentElementList[?Yield, ?Await] `,` Elision? AssignmentRestElement[?Yield, ?Await]? `]`", p"Syntactic 10 ArrayAssignmentPattern : `[` AssignmentElementList[?Yield, ?Await] `,` Elision? AssignmentRestElement[?Yield, ?Await]? `]`", p"Syntactic 11 ArrayAssignmentPattern : `[` AssignmentElementList[?Yield, ?Await] `,` Elision? AssignmentRestElement[?Yield, ?Await]? `]`"]
