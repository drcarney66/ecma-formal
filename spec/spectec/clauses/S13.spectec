  vars [expr, oldValue]
  steps {
    let expr = ? sdo Evaluation(child 5 |UnaryExpression|)
    let oldValue = ? @sec-tonumeric(? @sec-getvalue(expr))
    if oldValue is ty {Number} -> return @sec-numeric-types-number-unaryMinus(oldValue)
    assert oldValue is ty {BigInt}
    return @sec-numeric-types-bigint-unaryMinus(oldValue)
  }
}

