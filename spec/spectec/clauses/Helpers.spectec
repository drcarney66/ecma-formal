}

def @ph-type-default "ph-type-default" (kind ao params [t : doc "a type", d : pred(sat @ph-type-anything()), v : pred(sat @ph-type-anything())]) vars [t, d, v] {
  if v is ty {var t} -> return true
  return false
}

def @sort-Super-Reference-Record "sort-Super-Reference-Record" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {#"Reference Record"} -> return false
  return @sec-issuperreference(v)
}

def @sort-WriteSharedMemory-event "sort-WriteSharedMemory-event" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is ty {WriteSharedMemory} -> return true
  return false
}

def @sort-continue-completion "sort-continue-completion" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {#"Completion Record"} -> return false
  if v[[Type]] is val {~continue~} -> return true
  return false
}

def @sort-break-completion "sort-break-completion" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {#"Completion Record"} -> return false
  if v[[Type]] is val {~break~} -> return true
  return false
}

def @sort-implementation-defined-Completion-Record "sort-implementation-defined-Completion-Record" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is ty {#"Completion Record"} -> return true
  return false
}

def @sort-fully "sort-fully" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {#"Property Descriptor"} -> return false
  if @sec-isaccessordescriptor(v) is val {true} {
    if v sat $HasField([[Getter]]) and v sat $HasField([[Setter]]) and v sat $HasField([[Enumerable]]) and v sat $HasField([[Configurable]]) -> return true
    return false
  }
  if @sec-isdatadescriptor(v) is val {true} {
    if v sat $HasField([[Value]]) and v sat $HasField([[Writable]]) and v sat $HasField([[Enumerable]]) and v sat $HasField([[Configurable]]) -> return true
  }
  return false
}

def @sort-populated "sort-populated" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  return true
}

def @sort-object "sort-object" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is ty {Object} -> return true
  return false
}

def @sort-function-object "sort-function-object" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {Object} -> return false
  if v sat $HasMethod([[Call]]) -> return true
  return false
}

def @sort-constructor "sort-constructor" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {Object} -> return false
  if v sat $HasMethod([[Construct]]) -> return true
  return false
}

def @sort-ordinary "sort-ordinary" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {Object} -> return false
  if expr not $IsOrdinaryMethod(v[[GetPrototypeOf]], clause @sec-ordinary-object-internal-methods-and-internal-slots-getprototypeof) -> return false
  if expr not $IsOrdinaryMethod(v[[SetPrototypeOf]], clause @sec-ordinary-object-internal-methods-and-internal-slots-setprototypeof-v) -> return false
  if expr not $IsOrdinaryMethod(v[[IsExtensible]], clause @sec-ordinary-object-internal-methods-and-internal-slots-isextensible) -> return false
  if expr not $IsOrdinaryMethod(v[[PreventExtensions]], clause @sec-ordinary-object-internal-methods-and-internal-slots-preventextensions) -> return false
  if expr not $IsOrdinaryMethod(v[[GetOwnProperty]], clause @sec-ordinary-object-internal-methods-and-internal-slots-getownproperty-p) -> return false
  if expr not $IsOrdinaryMethod(v[[DefineOwnProperty]], clause @sec-ordinary-object-internal-methods-and-internal-slots-defineownproperty-p-desc) -> return false
  if expr not $IsOrdinaryMethod(v[[HasProperty]], clause @sec-ordinary-object-internal-methods-and-internal-slots-hasproperty-p) -> return false
  if expr not $IsOrdinaryMethod(v[[Get]], clause @sec-ordinary-object-internal-methods-and-internal-slots-get-p-receiver) -> return false
  if expr not $IsOrdinaryMethod(v[[Set]], clause @sec-ordinary-object-internal-methods-and-internal-slots-set-p-v-receiver) -> return false
  if expr not $IsOrdinaryMethod(v[[Delete]], clause @sec-ordinary-object-internal-methods-and-internal-slots-delete-p) -> return false
  if expr not $IsOrdinaryMethod(v[[OwnPropertyKeys]], clause @sec-ordinary-object-internal-methods-and-internal-slots-ownpropertykeys) -> return false
  if v sat $HasMethod([[Call]]) {
    if expr not $IsOrdinaryMethod(v[[Call]], clause @sec-ecmascript-function-objects-call-thisargument-argumentslist) and expr not $IsOrdinaryMethod(v[[Call]], clause @sec-built-in-function-objects-call-thisargument-argumentslist) -> return false
  }
  if v sat $HasMethod([[Construct]]) {
    if expr not $IsOrdinaryMethod(v[[Construct]], clause @sec-ecmascript-function-objects-construct-argumentslist-newtarget) and expr not $IsOrdinaryMethod(v[[Construct]], clause @sec-built-in-function-objects-construct-argumentslist-newtarget) -> return false
  }
  return true
}

def @sort-extensible "sort-extensible" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {Object} -> return false
  if v fails $HasSlot([[Extensible]]) -> return $""()
  return v[[Extensible]]
}

def @sort-ECMAScript-function-object "sort-ECMAScript-function-object" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {sort [ordinary] object} -> return false
  if @sec-iscallable(v) is val {false} -> return false
  if expr not $IsOrdinaryMethod(v[[Call]], clause @sec-ecmascript-function-objects-call-thisargument-argumentslist) -> return false
  return true
}

def @sort-built-in "sort-built-in" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {sort [ordinary] object} -> return false
  if @sec-iscallable(v) is val {false} -> return false
  if expr not $IsOrdinaryMethod(v[[Call]], clause @sec-built-in-function-objects-call-thisargument-argumentslist) -> return false
  return true
}

def @sort-bound-function-exotic-object "sort-bound-function-exotic-object" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {Object} -> return false
  if @sec-iscallable(v) is val {false} -> return false
  if expr not $IsOrdinaryMethod(v[[Call]], clause @sec-bound-function-exotic-objects-call-thisargument-argumentslist) -> return false
  if v sat $HasMethod([[Construct]]) {
    if expr not $IsOrdinaryMethod(v[[Construct]], clause @sec-bound-function-exotic-objects-construct-argumentslist-newtarget) -> return false
  }
  if expr not $IsOrdinaryMethod(v[[GetPrototypeOf]], clause @sec-ordinary-object-internal-methods-and-internal-slots-getprototypeof) -> return false
  if expr not $IsOrdinaryMethod(v[[SetPrototypeOf]], clause @sec-ordinary-object-internal-methods-and-internal-slots-setprototypeof-v) -> return false
  if expr not $IsOrdinaryMethod(v[[IsExtensible]], clause @sec-ordinary-object-internal-methods-and-internal-slots-isextensible) -> return false
  if expr not $IsOrdinaryMethod(v[[PreventExtensions]], clause @sec-ordinary-object-internal-methods-and-internal-slots-preventextensions) -> return false
  if expr not $IsOrdinaryMethod(v[[GetOwnProperty]], clause @sec-ordinary-object-internal-methods-and-internal-slots-getownproperty-p) -> return false
  if expr not $IsOrdinaryMethod(v[[DefineOwnProperty]], clause @sec-ordinary-object-internal-methods-and-internal-slots-defineownproperty-p-desc) -> return false
  if expr not $IsOrdinaryMethod(v[[HasProperty]], clause @sec-ordinary-object-internal-methods-and-internal-slots-hasproperty-p) -> return false
  if expr not $IsOrdinaryMethod(v[[Get]], clause @sec-ordinary-object-internal-methods-and-internal-slots-get-p-receiver) -> return false
  if expr not $IsOrdinaryMethod(v[[Set]], clause @sec-ordinary-object-internal-methods-and-internal-slots-set-p-v-receiver) -> return false
  if expr not $IsOrdinaryMethod(v[[Delete]], clause @sec-ordinary-object-internal-methods-and-internal-slots-delete-p) -> return false
  if expr not $IsOrdinaryMethod(v[[OwnPropertyKeys]], clause @sec-ordinary-object-internal-methods-and-internal-slots-ownpropertykeys) -> return false
  return true
}

