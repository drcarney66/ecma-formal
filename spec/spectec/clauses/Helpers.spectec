def @formal-date.prototype.tolocaledatestring "formal-date.prototype.tolocaledatestring" (kind builtin params [reserved1 opt, reserved2 opt]) vars [#"this value", NewTarget, reserved1, reserved2, dateObj, s, tv, t] {
  let dateObj = this_value
  let s = $LocaleDateString(~date~, dateObj)
  if s is val {~throw~} -> throw @ph-new-error([[TypeError]])
  if s is val {~empty~} {
    perform ? @sec-requireinternalslot(dateObj, [[DateValue]])
    let tv = dateObj[[DateValue]]
    if tv is val {nan} -> return "Invalid Date"
    let t = @sec-localtime(tv)
    return @sec-datestring(t)
  }
  return s
}

def @formal-date.prototype.tolocalestring "formal-date.prototype.tolocalestring" (kind builtin params [reserved1 opt, reserved2 opt]) vars [#"this value", NewTarget, reserved1, reserved2, dateObj, s, tv] {
  let dateObj = this_value
  let s = $LocaleDateString(~all~, dateObj)
  if s is val {~throw~} -> throw @ph-new-error([[TypeError]])
  if s is val {~empty~} {
    perform ? @sec-requireinternalslot(dateObj, [[DateValue]])
    let tv = dateObj[[DateValue]]
    return @sec-todatestring(tv)
  }
  return s
}

def @formal-date.prototype.tolocaletimestring "formal-date.prototype.tolocaletimestring" (kind builtin params [reserved1 opt, reserved2 opt]) vars [#"this value", NewTarget, reserved1, reserved2, dateObj, s, tv, localTime] {
  let dateObj = this_value
  let s = $LocaleDateString(~time~, dateObj)
  if s is val {~throw~} -> throw @ph-new-error([[TypeError]])
  if s is val {~empty~} {
    perform ? @sec-requireinternalslot(dateObj, [[DateValue]])
    let tv = dateObj[[DateValue]]
    if tv is val {nan} -> return "Invalid Date"
    let localTime = @sec-localtime(tv)
    return $"string-concatenation"(@sec-timestring(localTime), @sec-timezoneestring(tv))
  }
  return s
}

def @formal-singleagentreadbytes "formal-singleagentreadbytes" (kind ao params [execution : #"candidate execution", eventsRecord : #"Agent Events Record", #"block" : #"Shared Data Block", byteIndex : sort [#"non-negative"] integer, elementSize : sort [#"non-negative"] integer] -> list<#"byte value">) vars [execution, eventsRecord, #"block", byteIndex, elementSize, bytes, byteLocation, latest, event, payloadIndex, chosenValueRecord, modifyOp, bytesModified] {
  let bytes = $ListNew()
  for_range byteLocation incl byteIndex .. excl byteIndex + elementSize {
    let latest = ~empty~
    for_each event in eventsRecord[[EventList]] {
      if event is ty {#"WriteSharedMemory event"} or event is ty {ReadModifyWriteSharedMemory} {
        if event[[Block]] is val {#"block"} and event[[ByteIndex]] <= byteLocation and byteLocation < event[[ByteIndex]] + event[[ElementSize]] -> set var latest = event
      }
    }
    assert latest is not val {~empty~}
    let payloadIndex = byteLocation - latest[[ByteIndex]]
    if latest is ty {#"WriteSharedMemory event"} {
      perform $Append(latest[[Payload]][payloadIndex], ?bytes)
    }
    else {
      let chosenValueRecord = @ph-elem-whose(execution[[ChosenValues]], [[Event]], data choice 0, ?latest)
      let modifyOp = latest[[ModifyOp]]
      let bytesModified = modifyOp(chosenValueRecord[[ChosenValue]], latest[[Payload]])
      perform $Append(bytesModified[payloadIndex], ?bytes)
    }
  }
  return bytes
}

def @formal-choosesharedbytes "formal-choosesharedbytes" (kind ao params [execution : #"candidate execution", eventsRecord : #"Agent Events Record", #"block" : #"Shared Data Block", byteIndex : sort [#"non-negative"] integer, elementSize : sort [#"non-negative"] integer] -> list<#"byte value">) vars [execution, eventsRecord, #"block", byteIndex, elementSize, writes, bytes, byteLocation, writeEvent, payloadIndex, chosenValueRecord, modifyOp, bytesModified] {
  let writes = $ChooseReadsBytesFrom(execution, eventsRecord, #"block", byteIndex, elementSize)
  let bytes = $ListNew()
  let byteLocation = byteIndex
  for_each writeEvent in writes {
    let payloadIndex = byteLocation - writeEvent[[ByteIndex]]
    if writeEvent is ty {#"WriteSharedMemory event"} {
      perform $Append(writeEvent[[Payload]][payloadIndex], ?bytes)
    }
    else {
      let chosenValueRecord = @ph-elem-whose(execution[[ChosenValues]], [[Event]], data choice 0, ?writeEvent)
      let modifyOp = writeEvent[[ModifyOp]]
      let bytesModified = modifyOp(chosenValueRecord[[ChosenValue]], writeEvent[[Payload]])
      perform $Append(bytesModified[payloadIndex], ?bytes)
    }
    set var byteLocation = byteLocation + 1
  }
  return bytes
}

def @formal-radixdigitvalue "formal-radixdigitvalue" (kind ao params [c : #"code unit"] -> sort [#"non-negative"] integer | val(~empty~)) vars [c, n] {
  let n = $NumericValue(?c)
  if n sat $InInterval(math(hex(48, "0030")), math(hex(57, "0039"))) -> return n - math(hex(48, "0030"))
  if n sat $InInterval(math(hex(65, "0041")), math(hex(90, "005A"))) -> return n - math(hex(65, "0041")) + 10
  if n sat $InInterval(math(hex(97, "0061")), math(hex(122, "007A"))) -> return n - math(hex(97, "0061")) + 10
  return ~empty~
}

def @formal-earlyerrorsof "formal-earlyerrorsof" (kind ao params [node : #"Parse Node"] -> doc "a List of *SyntaxError* objects") vars [node, errors, #"child"] {
  if node sat @ph-production-in(clause @sec-functiondeclarations-in-ifstatement-statement-clauses) -> return @formal-earlyerrorsof($CoveredBy(|IfStatement|, ?node))
  let errors = $ListNew()
  for_children_of #"child" in node {
    if expr $InstanceOf(#"child", data sort nonterminal) {
      if $MustCoverChild(node, #"child") is val {false} -> set var errors = $ListConcat([errors, @formal-earlyerrorsof(#"child")])
    }
  }
  if errors fails $IsEmpty() -> return errors
  return sdo #"Early Errors"(node)
}

def @formal-parsetextin "formal-parsetextin" (kind ao params [sourceText : String | seq<#"Unicode code point">, goalSymbol : doc "a nonterminal in one of the ECMAScript grammars", strict : Boolean, json : Boolean, direct : Boolean] -> #"Parse Node" | pred(sat @ph-type-syntax-errors())) vars [sourceText, goalSymbol, strict, json, direct, tree, errors] {
  if sourceText is ty {String} -> set var sourceText = @sec-stringtocodepoints(sourceText)
  let tree = $ParseGoal(sourceText, goalSymbol, strict, json, direct)
  if tree is val {~empty~} -> return [@ph-new-error(err [[SyntaxError]])]
  let errors = @formal-earlyerrorsof(tree)
  if errors sat $IsEmpty() -> return tree
  return errors
}

def @formal-function-prototype "formal-function-prototype" (kind builtin params []) vars [#"this value", NewTarget] {
  return undefined
}

def @formal-date.now "formal-date.now" (kind builtin params []) vars [#"this value", NewTarget] {
  return $TimeNow()
}

def @formal-date.parse "formal-date.parse" (kind builtin params [string]) vars [#"this value", NewTarget, string, s] {
  let s = ? @sec-tostring(string)
  return $ParseDateString(s)
}

def @formal-string.prototype.touppercase "formal-string.prototype.touppercase" (kind builtin params []) vars [#"this value", NewTarget, thisValue, string, sText, upperText, uppercaseString] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let sText = @sec-stringtocodepoints(string)
  let upperText = $toUppercase(sText)
  let uppercaseString = @sec-codepointstostring(upperText)
  return uppercaseString
}

def @formal-propertyprovided "formal-propertyprovided" (kind ao params [p : Record] -> Boolean) vars [p] {
  if p[[Omittable]] is val {true} and $OmitSharedArrayBuffer() is val {true} -> return false
  if p[[Optional]] is val {false} -> return true
  if expr $"the host is a web browser"(data choice 1, data absent) -> return true
  return $HostSupportsOptional(p[[Clause]])
}

def @formal-intrinsicpropertydescriptor "formal-intrinsicpropertydescriptor" (kind ao params [p : Record, objects : list<Object>] -> #"Property Descriptor") vars [p, objects, getter, setter, value] {
  if p[[Kind]] is val {~accessor~} {
    if_else p[[Get]] is val {~empty~} { let getter = undefined } else { let getter = objects[p[[Get]]] }
    if_else p[[Set]] is val {~empty~} { let setter = undefined } else { let setter = objects[p[[Set]]] }
    return record PropertyDescriptor { [[Getter]]: getter, [[Setter]]: setter, [[Enumerable]]: p[[Enumerable]], [[Configurable]]: p[[Configurable]] }
  }
  if p[[Object]] is not val {~empty~} {
    let value = objects[p[[Object]]]
  }
  else_if p[[Created]] is not val {~empty~} {
    assert p[[Created]] is val {clause @sec-array.prototype-%symbol.unscopables%}
    let value = @sec-array.prototype-%symbol.unscopables%()
  }
  else {
    let value = p[[Value]]
  }
  return record PropertyDescriptor { [[Value]]: value, [[Writable]]: p[[Writable]], [[Enumerable]]: p[[Enumerable]], [[Configurable]]: p[[Configurable]] }
}

def @formal-outermostinstances "formal-outermostinstances" (kind ao params [symbol : #"grammar symbol", node : #"Parse Node"] -> list<#"Parse Node">) vars [symbol, node, found, #"child"] {
  let found = $ListNew()
  for_children_of #"child" in node {
    if expr $InstanceOf(#"child", ?symbol) -> perform $Append(?#"child", ?found)
    else -> set var found = $ListConcat([found, @formal-outermostinstances(symbol, #"child")])
  }
  return found
}

def @formal-directlycontaininglist "formal-directlycontaininglist" (kind ao params [node : #"Parse Node", symbol : nonterminal] -> #"Parse Node" | val(~empty~)) vars [node, symbol, #"list", m] {
  let #"list" = $NearestEnclosing(node, [symbol])
  if #"list" is val {~empty~} -> return ~empty~
  let m = $Parent(node)
  repeat_while m is not val {#"list"} {
    if $ListLen($ChildNodes(m)) is not val {1} -> return ~empty~
    set var m = $Parent(m)
  }
  repeat_while expr $InstanceOf($Parent(#"list"), ?symbol) {
    set var #"list" = $Parent(#"list")
  }
  return #"list"
}

def @formal-protopropertycount "formal-protopropertycount" (kind ao params [#"list" : |PropertyDefinitionList|] -> sort [#"non-negative"] integer) vars [#"list", count, definition] {
  let count = 0
  for_each definition in @formal-outermostinstances(|PropertyDefinition|, #"list") {
    if definition is val {prods [p"Syntactic - PropertyDefinition : PropertyName[?Yield, ?Await] `:` AssignmentExpression[+In, ?Yield, ?Await]"]} and sdo PropName(definition) is val {"__proto__"} -> set var count = count + 1
  }
  return count
}

def @formal-isprivateaccessorpair "formal-isprivateaccessorpair" (kind ao params [#"list" : |ClassElementList|, name : String] -> Boolean) vars [#"list", name, getters, setters, others, getterStatic, setterStatic, element, n, getter, setter, methods] {
  let getters = 0
  let setters = 0
  let others = 0
  let getterStatic = false
  let setterStatic = false
  for_each element in @formal-outermostinstances(|ClassElement|, #"list") {
    for_each n in sdo PrivateBoundIdentifiers(element) {
      if n is val {name} {
        let getter = false
        let setter = false
        if element is val {prods [p"Syntactic - ClassElement : MethodDefinition[?Yield, ?Await]"]} or element is val {prods [p"Syntactic - ClassElement : `static` MethodDefinition[?Yield, ?Await]"]} {
          let methods = @formal-outermostinstances(|MethodDefinition|, element)
          if methods[0] is val {prods [p"Syntactic - MethodDefinition : `get` ClassElementName[?Yield, ?Await] `(` `)` `{` FunctionBody[~Yield, ~Await] `}`"]} -> set var getter = true
          if methods[0] is val {prods [p"Syntactic - MethodDefinition : `set` ClassElementName[?Yield, ?Await] `(` PropertySetParameterList `)` `{` FunctionBody[~Yield, ~Await] `}`"]} -> set var setter = true
        }
        if getter is val {true} {
          set var getters = getters + 1
          set var getterStatic = sdo IsStatic(element)
        }
        else_if setter is val {true} {
          set var setters = setters + 1
          set var setterStatic = sdo IsStatic(element)
        }
        else {
          set var others = others + 1
        }
      }
    }
  }
  if getters == 1 and setters == 1 and others == 0 and getterStatic is val {setterStatic} -> return true
  return false
}

def @formal-privateduplicatesareaccessorpairs "formal-privateduplicatesareaccessorpairs" (kind ao params [#"list" : |ClassElementList|] -> Boolean) vars [#"list", names, name] {
  let names = sdo PrivateBoundIdentifiers(#"list")
  for_each name in names {
    if names sat @ph-more-than-one-occurrence(?name) and @formal-isprivateaccessorpair(#"list", name) is val {false} -> return false
  }
  return true
}

def @formal-duplicatesonlyfunctiondeclarations "formal-duplicatesonlyfunctiondeclarations" (kind ao params [node : #"Parse Node"] -> Boolean) vars [node, names, d, n] {
  let names = sdo LexicallyDeclaredNames(node)
  for_each d in sdo LexicallyScopedDeclarations(node) {
    for_each n in sdo BoundNames(d) {
      if names sat @ph-more-than-one-occurrence(?n) and d is not ty {pred(sat @ph-type-nt-parse-node(data choice 0, |FunctionDeclaration|))} -> return false
    }
  }
  return true
}

def @formal-enclosingnodes "formal-enclosingnodes" (kind ao params [node : #"Parse Node"] -> list<#"Parse Node">) vars [node, #"goal", nodes, n] {
  let #"goal" = $GoalSymbolOf(node)
  let nodes = $ListNew()
  let n = node
  repeat_while $NearestEnclosing(n, [#"goal"]) is not val {~empty~} {
    set var n = $Parent(n)
    perform $Append(?n, ?nodes)
  }
  return nodes
}

def @formal-deleteoperandiserror "formal-deleteoperandiserror" (kind ao params [operand : #"Parse Node"] -> Boolean) vars [operand] {
  if @sec-isstrict(operand) is val {true} and operand is val {prods [p"Syntactic - PrimaryExpression : IdentifierReference[?Yield, ?Await]"]; prods [p"Syntactic - MemberExpression : MemberExpression[?Yield, ?Await] `.` PrivateIdentifier"]; prods [p"Syntactic - CallExpression : CallExpression[?Yield, ?Await] `.` PrivateIdentifier"]; prods [p"Syntactic - OptionalChain : `?.` PrivateIdentifier"]; prods [p"Syntactic - OptionalChain : OptionalChain[?Yield, ?Await] `.` PrivateIdentifier"]} -> return true
  return @formal-parenthesizedoperandiserror(operand)
}

def @formal-parenthesizedoperandiserror "formal-parenthesizedoperandiserror" (kind ao params [operand : #"Parse Node"] -> Boolean) vars [operand, #"cover", expression] {
  if operand is not val {prods [p"Syntactic - PrimaryExpression : CoverParenthesizedExpressionAndArrowParameterList[?Yield, ?Await]"]} -> return false
  let #"cover" = @ph-first-node-within(|CoverParenthesizedExpressionAndArrowParameterList|, ?operand)
  let expression = $CoveredBy(|ParenthesizedExpression|, ?#"cover")
  return @formal-deleteoperandiserror($ChildOf(|Expression|, ?expression))
}

def @formal-parsenodeswithinprocessed "formal-parsenodeswithinprocessed" (kind ao params [node : #"Parse Node"] -> list<#"Parse Node">) vars [node, nodes, ifStatement, #"child"] {
  let nodes = [node]
  if node sat @ph-production-in(clause @sec-functiondeclarations-in-ifstatement-statement-clauses) {
    let ifStatement = $CoveredBy(|IfStatement|, ?node)
    return $ListConcat([nodes, @formal-parsenodeswithinprocessed(ifStatement)])
  }
  for_children_of #"child" in node {
    set var nodes = $ListConcat([nodes, @formal-parsenodeswithinprocessed(#"child")])
  }
  return nodes
}

def @ph-character-of-pattern "ph-character-of-pattern" (kind ao params [regexpRecord : #"RegExp Record", v : pred(sat @ph-type-anything())]) vars [regexpRecord, v] {
  if @sec-runtime-semantics-haseitherunicodeflag-abstract-operation(regexpRecord) is val {true} {
    if v is ty {#"code point"} -> return true
    return false
  }
  if v is ty {#"code unit"} -> return true
  return false
}

def @sec-joinindexedproperties "JoinIndexedProperties" (kind ao params [#"obj" : Object, length : sort [#"non-negative"] integer, separator : String, methodName : #"property key" opt, methodArgs : list<#"ECMAScript language value"> opt] -> completion<String> | #"throw completion") vars [#"obj", length, separator, methodName, methodArgs, result, k, element, elementString] {
  if methodName sat $Present() and methodArgs fails $Present() -> set var methodArgs = $ListNew()
  let result = $"the empty String"()
  let k = 0
  repeat_while k < length {
    if k > 0 {
      if $StringTooLarge($StrLen(?result) + $StrLen(?separator)) is val {true} -> throw @ph-new-error([[RangeError]])
      set var result = $"string-concatenation"(result, separator)
    }
    note "If _obj_ is a TypedArray, the following invocation of Get will return a normal completion."
    let element = ? @sec-get-o-p(#"obj", ! @sec-tostring($𝔽(k)))
    if element is neither val {undefined; null} {
      if methodName sat $Present() {
        let elementString = ? @sec-tostring(? @sec-invoke(element, methodName, methodArgs))
      }
      else {
        note "If _obj_ is a TypedArray, the following invocation of ToString will return a normal completion."
        let elementString = ? @sec-tostring(element)
      }
      if $StringTooLarge($StrLen(?result) + $StrLen(?elementString)) is val {true} -> throw @ph-new-error([[RangeError]])
      set var result = $"string-concatenation"(result, elementString)
    }
    set var k = k + 1
  }
  return result
}

def @sec-iterator.prototype.chunks "Iterator.prototype.chunks" (kind builtin params [chunkSize]) vars [#"this value", NewTarget, chunkSize, #"obj", iterated, error, #"closure", buffer, value, #"completion", result] {
  let #"obj" = this_value
  if #"obj" is not ty {Object} -> throw @ph-new-error([[TypeError]])
  let iterated = record #"Iterator Record" { [[Iterator]]: #"obj", [[NextMethod]]: undefined, [[Done]]: false }
  if chunkSize is not ty {#"integral Number"} {
    let error = @sec-throwcompletion(@ph-new-error(err [[TypeError]]))
    return ? @sec-iteratorclose(iterated, error)
  }
  if chunkSize fails $InInterval(num_f(1), $𝔽(2 ^ 32 - 1)) {
    let error = @sec-throwcompletion(@ph-new-error(err [[RangeError]]))
    return ? @sec-iteratorclose(iterated, error)
  }
  set var iterated = ? @sec-getiteratordirect(#"obj")
  let #"closure" = closure 0
  let result = @sec-createiteratorfromclosure(#"closure", "Iterator Helper", intrinsic [[IteratorHelperPrototype]], [[[UnderlyingIterators]]])
  set field result[[UnderlyingIterators]] = [iterated]
  return result
  closure abstract params none captures [iterated, chunkSize] {
    let buffer = $ListNew()
    repeat {
      let value = ? @sec-iteratorstepvalue(iterated)
      if value is val {~done~} {
        if buffer fails $IsEmpty() {
          perform @sec-completion-ao(@sec-yield(@sec-createarrayfromlist(buffer)))
        }
        return @sec-returncompletion(undefined)
      }
      perform $Append(?value, ?buffer)
      if $ListLen(?buffer) is val {$ℝ(chunkSize)} {
        let #"completion" = @sec-completion-ao(@sec-yield(@sec-createarrayfromlist(buffer)))
        block {
          assert #"completion" is ty {#"Completion Record"}
          if #"completion" is ty {#"abrupt completion"} -> return ? @sec-iteratorclose(iterated, #"completion")
          set var #"completion" = ! #"completion"
        }
        set var buffer = $ListNew()
      }
    }
  }
}

def @sec-iterator.prototype.includes "Iterator.prototype.includes" (kind builtin params [searchElement, skippedElements opt]) vars [#"this value", NewTarget, searchElement, skippedElements, #"obj", iterated, toSkip, error, skipped, value] {
  let #"obj" = this_value
  if #"obj" is not ty {Object} -> throw @ph-new-error([[TypeError]])
  let iterated = record #"Iterator Record" { [[Iterator]]: #"obj", [[NextMethod]]: undefined, [[Done]]: false }
  if skippedElements is val {undefined} {
    let toSkip = num_f(+0)
  }
  else {
    if skippedElements sat @ph-not-infinity-or-integral() {
      let error = @sec-throwcompletion(@ph-new-error(err [[TypeError]]))
      return ? @sec-iteratorclose(iterated, error)
    }
    let toSkip = skippedElements
  }
  if toSkip < num_f(-0) {
    let error = @sec-throwcompletion(@ph-new-error(err [[RangeError]]))
    return ? @sec-iteratorclose(iterated, error)
  }
  if toSkip sat $IsFinite() and toSkip > $𝔽(2 ^ 53 - 1) {
    let error = @sec-throwcompletion(@ph-new-error(err [[RangeError]]))
    return ? @sec-iteratorclose(iterated, error)
  }
  let skipped = num_f(+0)
  set var iterated = ? @sec-getiteratordirect(#"obj")
  repeat {
    let value = ? @sec-iteratorstepvalue(iterated)
    if value is val {~done~} -> return false
    if skipped < toSkip {
      set var skipped = skipped + num_f(1)
    }
    else_if @sec-samevaluezero(value, searchElement) is val {true} {
      return ? @sec-iteratorclose(iterated, @sec-normalcompletion(true))
    }
  }
}

def @sec-iterator.prototype.join "Iterator.prototype.join" (kind builtin params [separator]) vars [#"this value", NewTarget, separator, #"obj", iterated, separatorString, result, first, value, valueString] {
  let #"obj" = this_value
  if #"obj" is not ty {Object} -> throw @ph-new-error([[TypeError]])
  let iterated = record #"Iterator Record" { [[Iterator]]: #"obj", [[NextMethod]]: undefined, [[Done]]: false }
  if separator is val {undefined} {
    let separatorString = ","
  }
  else {
    let separatorString = @sec-completion-ao(@sec-tostring(separator))
    block {
      assert separatorString is ty {#"Completion Record"}
      if separatorString is ty {#"abrupt completion"} -> return ? @sec-iteratorclose(iterated, separatorString)
      set var separatorString = ! separatorString
    }
  }
  set var iterated = ? @sec-getiteratordirect(#"obj")
  let result = $"the empty String"()
  let first = true
  repeat {
    let value = ? @sec-iteratorstepvalue(iterated)
    if value is val {~done~} -> return result
    if first is val {true} {
      set var first = false
    }
    else {
      set var result = $"string-concatenation"(result, separatorString)
    }
    if value is neither val {undefined; null} {
      let valueString = @sec-completion-ao(@sec-tostring(value))
      block {
        assert valueString is ty {#"Completion Record"}
        if valueString is ty {#"abrupt completion"} -> return ? @sec-iteratorclose(iterated, valueString)
        set var valueString = ! valueString
      }
      set var result = $"string-concatenation"(result, valueString)
    }
  }
}

def @sec-iterator.prototype.windows "Iterator.prototype.windows" (kind builtin params [windowSize, undersized opt]) vars [#"this value", NewTarget, windowSize, undersized, #"obj", iterated, error, #"closure", buffer, value, #"completion", result] {
  let #"obj" = this_value
  if #"obj" is not ty {Object} -> throw @ph-new-error([[TypeError]])
  let iterated = record #"Iterator Record" { [[Iterator]]: #"obj", [[NextMethod]]: undefined, [[Done]]: false }
  if windowSize is not ty {#"integral Number"} {
    let error = @sec-throwcompletion(@ph-new-error(err [[TypeError]]))
    return ? @sec-iteratorclose(iterated, error)
  }
  if windowSize fails $InInterval(num_f(1), $𝔽(2 ^ 32 - 1)) {
    let error = @sec-throwcompletion(@ph-new-error(err [[RangeError]]))
    return ? @sec-iteratorclose(iterated, error)
  }
  if undersized is val {undefined} -> set var undersized = "only-full"
  if undersized is neither val {"only-full"; "allow-partial"} {
    let error = @sec-throwcompletion(@ph-new-error(err [[TypeError]]))
    return ? @sec-iteratorclose(iterated, error)
  }
  set var iterated = ? @sec-getiteratordirect(#"obj")
  let #"closure" = closure 0
  let result = @sec-createiteratorfromclosure(#"closure", "Iterator Helper", intrinsic [[IteratorHelperPrototype]], [[[UnderlyingIterators]]])
  set field result[[UnderlyingIterators]] = [iterated]
  return result
  closure abstract params none captures [iterated, windowSize, undersized] {
    let buffer = $ListNew()
    repeat {
      let value = ? @sec-iteratorstepvalue(iterated)
      if value is val {~done~} {
        if undersized is val {"allow-partial"} and buffer fails $IsEmpty() and $ListLen(?buffer) < $ℝ(windowSize) {
          perform @sec-completion-ao(@sec-yield(@sec-createarrayfromlist(buffer)))
        }
        return @sec-returncompletion(undefined)
      }
      if $ListLen(?buffer) is val {$ℝ(windowSize)} {
        perform $RemoveFirst(?buffer)
      }
      perform $Append(?value, ?buffer)
      if $ListLen(?buffer) is val {$ℝ(windowSize)} {
        let #"completion" = @sec-completion-ao(@sec-yield(@sec-createarrayfromlist(buffer)))
        block {
          assert #"completion" is ty {#"Completion Record"}
          if #"completion" is ty {#"abrupt completion"} -> return ? @sec-iteratorclose(iterated, #"completion")
          set var #"completion" = ! #"completion"
        }
      }
    }
  }
}

def @ph-finite-numbers "ph-finite-numbers" (kind ao params [xs : list<Number>]) vars [xs, x] {
  for_each x in xs {
    if x is not ty {sort [finite] Number} -> return false
  }
  return true
}

def @ph-nonzero-finite-numbers "ph-nonzero-finite-numbers" (kind ao params [xs : list<Number>]) vars [xs, x] {
  for_each x in xs {
    if x is not ty {sort [#"non-zero", finite] Number} -> return false
  }
  return true
}

def @ph-not-infinity-or-integral "ph-not-infinity-or-integral" (kind ao params [x : #"ECMAScript language value"]) vars [x] {
  if x is val {num_f(+∞); num_f(-∞)} -> return false
  if x is ty {#"integral Number"} -> return false
  return true
}

def @sort-non-zero "sort-non-zero" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is ty {Number} {
    if v is val {num_f(+0); num_f(-0)} -> return false
    return true
  }
  if v is ty {#"mathematical value"} and v != 0 -> return true
  return false
}

def @sort-finite "sort-finite" (kind ao params [v : pred(sat @ph-type-anything())]) vars [v] {
  if v is not ty {Number} and v is not ty {BigInt} and v is not ty {#"extended mathematical value"} -> return false
  if v sat $IsFinite() -> return true
  return false
}

def @ph-only-single-code-points "ph-only-single-code-points" (kind ao params [cs : CharSet]) vars [cs] {
  return $CharSetAllSingle(cs)
}

def @ph-named-exports-resolvable "ph-named-exports-resolvable" (kind ao params [module : #"Source Text Module Record"]) vars [module, e] {
  for_each e : #"ExportEntry Record" in $ListConcat([module[[LocalExportEntries]], module[[IndirectExportEntries]]]) {
    if module.ResolveExport(e[[ExportName]]) is not ty {#"ResolvedBinding Record"} -> return false
  }
  return true
}

def @ph-every-element-single-character "ph-every-element-single-character" (kind ao params [cs : CharSet]) vars [cs] {
  return $CharSetAllSingle(cs)
}

def @ph-no-elements-in-common "ph-no-elements-in-common" (kind ao params [a : String, b : String]) vars [a, b, i] {
  for_range i incl 0 .. excl $StrLen(?a) {
    if b sat $Contains($Substring(?a, ?i, i + 1)) -> return false
  }
  return true
}

def @ph-all-ready-to-evaluate "ph-all-ready-to-evaluate" (kind ao params [l : list<#"Cyclic Module Record">]) vars [l, m] {
  for_each m in l {
    if m[[AsyncEvaluationOrder]] is not ty {integer} -> return false
    if m[[PendingAsyncDependencies]] != 0 -> return false
    if m[[EvaluationError]] is not val {~empty~} -> return false
  }
  return true
}

def @ph-contains-one-such "ph-contains-one-such" (kind ao params [t : doc "a type", x : pred(sat @ph-type-anything()), c : doc "a condition on _x_", l : List]) vars [t, x, c, l, n, e] {
  let n = 0
  for_each e in l {
    if e is ty {var t} and c(e) is val {true} -> set var n = n + 1
  }
  if n == 1 -> return true
  return false
}

def @ph-list-of-write-events "ph-list-of-write-events" (kind ao params [n : sort [#"non-negative"] integer, l : List]) vars [n, l, w] {
  if $ListLen(?l) != n -> return false
  for_each w in l {
    if w is not ty {#"WriteSharedMemory event"} and w is not ty {ReadModifyWriteSharedMemory} -> return false
  }
  return true
}

def @ph-type-no-non-configurable-properties "ph-type-no-non-configurable-properties" (kind ao params [#"choice 0", t : doc "a type", v : pred(sat @ph-type-anything())]) vars [#"choice 0", t, v, P] {
  if v is not ty {var t} -> return false
  if v is not ty {Object} -> return false
  for_keys P of v where P is ty {#"property key"} order 1 {
    if @sec-ordinarygetownproperty(v, P)[[Configurable]] is val {false} -> return false
  }
  return true
}

def @ph-not-explicitly-defined-export "ph-not-explicitly-defined-export" (kind ao params [n : String, module : #"Source Text Module Record"]) vars [n, module, e] {
  for_each e : #"ExportEntry Record" in module[[LocalExportEntries]] {
    if e[[ExportName]] is val {n} -> return false
  }
  for_each e : #"ExportEntry Record" in module[[IndirectExportEntries]] {
    if e[[ExportName]] is val {n} -> return false
  }
  return true
}

def @ph-no-waiter-with "ph-no-waiter-with" (kind ao params [l : list<#"Waiter Record">, p : #"PromiseCapability Record" | val(~blocking~), a : #"agent signifier"]) vars [l, p, a, w] {
  for_each w in l {
    if w[[PromiseCapability]] is val {p} and w[[AgentSignifier]] is val {a} -> return false
  }
  return true
}

def @ph-exactly-one-private-name "ph-exactly-one-private-name" (kind ao params [l : list<#"Private Name">, d : String]) vars [l, d, n, pn] {
  let n = 0
  for_each pn in l {
    if pn[[Description]] is val {d} -> set var n = n + 1
  }
  if n == 1 -> return true
  return false
}

def @formal-rounddecimalmv "formal-rounddecimalmv" (kind ao params [m : sort [#"non-negative"] integer, k : integer] -> Number) vars [m, k, e] {
  if m == 0 -> return num_f(+0)
  let e = $DecimalExponent(m) + k
  if e > 309 -> return num_f(+∞)
  if e < math(-325) -> return num_f(+0)
  return @sec-roundmvresult(m * 10 ^ k)
}

def @ph-whitespace-lineterminator-set "ph-whitespace-lineterminator-set" (kind ao params []) vars [] {
  return $RightHandSideCharacters([|WhiteSpace|, |LineTerminator|])
}

def @ph-unique-code-points-set "ph-unique-code-points-set" (kind ao params [s : String]) vars [s, cps, out, #"cp"] {
  let cps = @sec-stringtocodepoints(s)
  let out = $ListNew()
  for_each #"cp" in cps {
    if out fails $Contains(?#"cp") -> perform $Append(?#"cp", ?out)
  }
  return out
}

def @ph-trim-leading-set "ph-trim-leading-set" (kind ao params [s : String, ws : list<#"code point">]) vars [s, ws, len, i, #"cp"] {
  let len = $StrLen(?s)
  let i = 0
  repeat_while i < len {
    let #"cp" = @sec-codepointat(s, i)
    if ws fails $Contains(#"cp"[[CodePoint]]) -> return $Substring(?s, ?i, data absent)
    if_else #"cp"[[CodeUnitCount]] is val {2} { set var i = i + 2 } else { set var i = i + 1 }
  }
  return $"the empty String"()
}

def @ph-trim-trailing-set "ph-trim-trailing-set" (kind ao params [s : String, ws : list<#"code point">]) vars [s, ws, end, u, start, hi, #"cp"] {
  let end = $StrLen(?s)
  repeat_while end > 0 {
    let u = $NumericValue($UnitAt(end - 1, ?s))
    let start = end - 1
    if end >= 2 and u sat $InInterval(math(hex(56320, "DC00")), math(hex(57343, "DFFF"))) {
      let hi = $NumericValue($UnitAt(end - 2, ?s))
      if hi sat $InInterval(math(hex(55296, "D800")), math(hex(56319, "DBFF"))) -> set var start = end - 2
    }
    let #"cp" = @sec-codepointat(s, start)
    if ws fails $Contains(#"cp"[[CodePoint]]) -> return $Substring(?s, 0, ?end)
    set var end = start
  }
  return $"the empty String"()
}

def @ph-trim-both-set "ph-trim-both-set" (kind ao params [s : String, ws : list<#"code point">]) vars [s, ws, t] {
  let t = @ph-trim-leading-set(?s, ?ws)
  return @ph-trim-trailing-set(?t, ?ws)
}

def @spec-cond-0 "spec-cond" (kind ao params [x0, x1]) vars [x0, x1] {
  return bool(x0[[Key]] is val {x1[[Key]]})
}

def @spec-cond-1 "spec-cond" (kind ao params [x0, x1]) vars [x0, x1] {
  return bool(sdo CapturingGroupName(x0) is val {sdo CapturingGroupName(x1)})
}

def @spec-cond-2 "spec-cond" (kind ao params [x0, x1]) vars [x0, x1] {
  return bool(@sec-mightbothparticipate(x0, x1) is val {true})
}

def @spec-type-0 "spec-type" (kind ao params [v]) vars [v] {
  return bool(v is ty {|VariableDeclaration|})
}

def @spec-type-1 "spec-type" (kind ao params [v]) vars [v] {
  return bool(v is ty {|ForBinding|})
}

def @spec-type-2 "spec-type" (kind ao params [v]) vars [v] {
  return bool(v is ty {|BindingIdentifier|})
}

def @spec-type-3 "spec-type" (kind ao params [v]) vars [v] {
  return bool(v is ty {sort [extensible, ordinary] object})
}

def @spec-type-4 "spec-type" (kind ao params [v]) vars [v] {
  return bool(v is ty {|Script| that sat @ph-parsed-for-parsejson()})
}

def @spec-type-5 "spec-type" (kind ao params [v]) vars [v] {
  return bool(v is ty {|IterationStatement|})
}

def @spec-type-6 "spec-type" (kind ao params [v]) vars [v] {
  return bool(v is ty {|IterationStatement| | |SwitchStatement|})
}

def @spec-type-7 "spec-type" (kind ao params [v]) vars [v] {
  return bool(v is ty {pred(sat @ph-type-anything())})
}

def @spec-type-8 "spec-type" (kind ao params [v]) vars [v] {
  return bool(v is ty {pred(sat @ph-type-promise-for(data sort #"IteratorResult object"))})
}

def @spec-type-9 "spec-type" (kind ao params [v]) vars [v] {
  return bool(v is ty {pred(sat @ph-type-promise())})
}

def @spec-copy-0 "ph-neither-nor-nor" (kind ao params [a : doc "a type", b : doc "a type", c : doc "a type", x : pred(sat @ph-type-anything())]) vars [a, b, c, x] {
  if x is ty {pred(sat @spec-type-0())} -> return false
  if x is ty {pred(sat @spec-type-1())} -> return false
  if x is ty {pred(sat @spec-type-2())} -> return false
  return true
}

def @spec-copy-1 "ph-type-no-own-properties" (kind ao params [#"choice 0", t : doc "a type", v : pred(sat @ph-type-anything())]) vars [#"choice 0", t, v, P] {
  if v is not ty {pred(sat @spec-type-3())} -> return false
  if v is not ty {Object} -> return false
  for_keys P of v where P is ty {#"property key"} order 1 {
    return false
  }
  return true
}

def @spec-copy-2 "ph-type-no-non-configurable-properties" (kind ao params [#"choice 0", t : doc "a type", v : pred(sat @ph-type-anything())]) vars [#"choice 0", t, v, P] {
  if v is not ty {pred(sat @spec-type-3())} -> return false
  if v is not ty {Object} -> return false
  for_keys P of v where P is ty {#"property key"} order 1 {
    if @sec-ordinarygetownproperty(v, P)[[Configurable]] is val {false} -> return false
  }
  return true
}

def @spec-copy-3 "ph-contained-within" (kind ao params [t : doc "a type", node : #"Parse Node"]) vars [t, node, n] {
  for_each n in @formal-enclosingnodes(node) {
    if n is ty {pred(sat @spec-type-4())} -> return true
  }
  return false
}

def @spec-copy-4 "ph-not-nested" (kind ao params [c : doc "a terminal symbol", t : doc "a type", node : #"Parse Node"]) vars [c, t, node, n] {
  assert c is val {@ph-token(term "static")}
  for_each n in @formal-enclosingnodes(node) {
    if n is ty {pred(sat @spec-type-5())} -> return false
    if n is ty {pred(sat @ph-type-nt-parse-node(data choice 0, |FunctionBody|))} or n is ty {pred(sat @ph-type-nt-parse-node(data choice 0, |ClassStaticBlockBody|))} -> return true
  }
  return true
}

def @spec-copy-5 "ph-not-nested-alt" (kind ao params [c : doc "a terminal symbol", t : doc "a type", node : #"Parse Node"]) vars [c, t, node, n] {
  assert c is val {@ph-token(term "static")}
  for_each n in @formal-enclosingnodes(node) {
    if n is ty {pred(sat @spec-type-6())} -> return false
    if n is ty {pred(sat @ph-type-nt-parse-node(data choice 0, |FunctionBody|))} or n is ty {pred(sat @ph-type-nt-parse-node(data choice 0, |ClassStaticBlockBody|))} -> return true
  }
  return true
}

def @spec-copy-6 "ph-type-default" (kind ao params [t : doc "a type", d : pred(sat @ph-type-anything()), v : pred(sat @ph-type-anything())]) vars [t, d, v] {
  if v is ty {pred(sat @spec-type-7())} -> return true
  return false
}

def @spec-copy-7 "ph-type-function-returns" (kind ao params [#"choice 0", t : doc "a type", v : pred(sat @ph-type-anything())]) vars [#"choice 0", t, v] {
  if v is ty {#"function object"} -> return true
  return false
}

def @spec-copy-8 "ph-type-returns" (kind ao params [#"choice 0", t : doc "a type", u : doc "a type", v : pred(sat @ph-type-anything())]) vars [#"choice 0", t, u, v] {
  if v is ty {var t} -> return true
  return false
}

sdo_row @row-propname-coverinitializedname PropName form alg {
  prods [p"Syntactic - PropertyDefinition : CoverInitializedName[?Yield, ?Await]"]
  keys ["PropertyDefinition : CoverInitializedName"]
  vars []
  steps {
    return sdo StringValue($ChildOf(|IdentifierReference|, child 5 |CoverInitializedName|))
  }
}

sdo_row @row-compilesubpattern-quantifiableassertion-quantifier CompileSubpattern form alg {
  prods [p"AnnexB - Term :: [~UnicodeMode] QuantifiableAssertion[?NamedCaptureGroups] Quantifier"]
  keys ["Term :: QuantifiableAssertion Quantifier"]
  vars [regexpRecord, direction, m, q, parenIndex, parenCount, x, c]
  steps {
    let m = sdo CompileAssertion(child 5 |QuantifiableAssertion|; regexpRecord)
    let q = sdo CompileQuantifier(child 5 |Quantifier|)
    assert q[[Min]] <= q[[Max]]
    let parenIndex = @sec-countleftcapturingparensbefore(child 6 |Term|)
    let parenCount = @sec-countleftcapturingparenswithin(child 5 |QuantifiableAssertion|)
    return closure 0
  }
  closure matcher params [x, c] captures [m, q, parenIndex, parenCount] {
    assert x is ty {MatchState}
    assert c is ty {MatcherContinuation}
    return @sec-runtime-semantics-repeatmatcher-abstract-operation(m, q[[Min]], q[[Max]], q[[Greedy]], x, c, parenIndex, parenCount)
  }
}

sdo_row @row-compilesubpattern-extendedatom-quantifier CompileSubpattern form alg {
  prods [p"AnnexB - Term :: [~UnicodeMode] ExtendedAtom[?NamedCaptureGroups] Quantifier"]
  keys ["Term :: ExtendedAtom Quantifier"]
  vars [regexpRecord, direction, m, q, parenIndex, parenCount, x, c]
  steps {
    let m = sdo CompileAtom(child 5 |ExtendedAtom|; regexpRecord, direction)
    let q = sdo CompileQuantifier(child 5 |Quantifier|)
    assert q[[Min]] <= q[[Max]]
    let parenIndex = @sec-countleftcapturingparensbefore(child 6 |Term|)
    let parenCount = @sec-countleftcapturingparenswithin(child 5 |ExtendedAtom|)
    return closure 0
  }
  closure matcher params [x, c] captures [m, q, parenIndex, parenCount] {
    assert x is ty {MatchState}
    assert c is ty {MatcherContinuation}
    return @sec-runtime-semantics-repeatmatcher-abstract-operation(m, q[[Min]], q[[Max]], q[[Greedy]], x, c, parenIndex, parenCount)
  }
}

sdo_row @row-compilesubpattern-extendedatom CompileSubpattern form alg {
  prods [p"AnnexB - Term :: [~UnicodeMode] ExtendedAtom[?NamedCaptureGroups]"]
  keys ["Term :: ExtendedAtom"]
  vars [regexpRecord, direction]
  steps {
    return sdo CompileAtom(child 5 |ExtendedAtom|; regexpRecord, direction)
  }
}

sdo_row @row-compileassertion-quantifiableassertion-lookahead CompileAssertion form alg {
  prods [p"AnnexB - QuantifiableAssertion :: `(?=` Disjunction[~UnicodeMode, ~UnicodeSetsMode, ?NamedCaptureGroups] `)`"]
  keys ["QuantifiableAssertion :: `(?=` Disjunction `)`"]
  vars [regexpRecord, m, matchState, continue, d, y, result, capability, input, xe, z]
  steps {
    let m = sdo CompileSubpattern(child 5 |Disjunction|; regexpRecord, ~forward~)
    return closure 0
  }
  closure matcher params [matchState, continue] captures [m] {
    assert matchState is ty {MatchState}
    assert continue is ty {MatcherContinuation}
    let d = closure 1
    let result = m(matchState, d)
    if result is val {~failure~} -> return ~failure~
    assert result is ty {MatchState}
    let capability = result[[Captures]]
    let input = matchState[[Input]]
    let xe = matchState[[EndIndex]]
    let z = record MatchState { [[Input]]: input, [[EndIndex]]: xe, [[Captures]]: capability }
    return continue(z)
  }
  closure matcher_continuation params [y] captures [] {
    assert y is ty {MatchState}
    return y
  }
}

sdo_row @row-compileassertion-quantifiableassertion-negative-lookahead CompileAssertion form alg {
  prods [p"AnnexB - QuantifiableAssertion :: `(?!` Disjunction[~UnicodeMode, ~UnicodeSetsMode, ?NamedCaptureGroups] `)`"]
  keys ["QuantifiableAssertion :: `(?!` Disjunction `)`"]
  vars [regexpRecord, m, matchState, continue, d, y, result]
  steps {
    let m = sdo CompileSubpattern(child 5 |Disjunction|; regexpRecord, ~forward~)
    return closure 0
  }
  closure matcher params [matchState, continue] captures [m] {
    assert matchState is ty {MatchState}
    assert continue is ty {MatcherContinuation}
    let d = closure 1
    let result = m(matchState, d)
    if result is not val {~failure~} -> return ~failure~
    return continue(matchState)
  }
  closure matcher_continuation params [y] captures [] {
    assert y is ty {MatchState}
    return y
  }
}

sdo_row @row-compileatom-extendedatom-dot CompileAtom form alg {
  prods [p"AnnexB - ExtendedAtom :: `.`"]
  keys ["ExtendedAtom :: `.`"]
  vars [regexpRecord, direction, charSet]
  steps {
    let charSet = @sec-allcharacters(regexpRecord)
    if regexpRecord[[DotAll]] is not val {true} {
      set var charSet = @ph-charset-minus(?charSet, $RightHandSideCharacters([|LineTerminator|]))
    }
    return @sec-runtime-semantics-charactersetmatcher-abstract-operation(regexpRecord, charSet, false, direction)
  }
}

sdo_row @row-compileatom-extendedatom-characterclass CompileAtom form alg {
  prods [p"AnnexB - ExtendedAtom :: CharacterClass[~UnicodeMode, ~UnicodeSetsMode]"]
  keys ["ExtendedAtom :: CharacterClass"]
  vars [regexpRecord, direction, cc, cs, listOfMatchers, csSequences, s, remaining, cs2, m2, c1, cs1, m1, singles]
  steps {
    let cc = sdo CompileCharacterClass(child 5 |CharacterClass|; regexpRecord)
    let cs = cc[[CharSet]]
    if regexpRecord[[UnicodeSets]] is val {false} or expr @ph-every-single-character(?cs, ?cs) -> return @sec-runtime-semantics-charactersetmatcher-abstract-operation(regexpRecord, cs, cc[[Invert]], direction)
    assert cc[[Invert]] is val {false}
    let listOfMatchers = $ListNew()
    let csSequences = $ListNew()
    for_each s : CharSetElement in cs {
      if expr @ph-charset-element-longer-than-one(?s) -> perform $Append(?s, ?csSequences)
    }
    perform @ph-sort-by-length(?csSequences, data sort CharSetElement)
    for_each s : CharSetElement in csSequences {
      assert s sat @ph-code-point-sequence(2)
      let remaining = @ph-list-consisting-of(@ph-code-points-of(?s))
      let cs2 = $CharSetOne($ListElem(data choice 2, ?remaining))
      let m2 = @sec-runtime-semantics-charactersetmatcher-abstract-operation(regexpRecord, cs2, false, direction)
      perform $RemoveLast(?remaining)
      for_each c1 : #"code point" rev in remaining {
        let cs1 = $CharSetOne(?c1)
        let m1 = @sec-runtime-semantics-charactersetmatcher-abstract-operation(regexpRecord, cs1, false, direction)
        set var m2 = @sec-matchsequence(m1, m2, direction)
      }
      perform $Append(?m2, ?listOfMatchers)
    }
    let singles = @ph-charset-singles(?cs)
    perform $Append(@sec-runtime-semantics-charactersetmatcher-abstract-operation(regexpRecord, singles, false, direction), ?listOfMatchers)
    if cs sat $Contains(@ph-empty-character-sequence(data choice 0)) -> perform $Append(@sec-emptymatcher(), ?listOfMatchers)
    let m2 = @ph-last-in(data sort Matcher, ?listOfMatchers)
    for_each m1 : Matcher in @ph-iter-backwards(?listOfMatchers) {
      set var m2 = @sec-matchtwoalternatives(m1, m2)
    }
    return m2
  }
}

sdo_row @row-compileatom-extendedatom-group CompileAtom form alg {
  prods [p"AnnexB 0 ExtendedAtom :: `(` GroupSpecifier[~UnicodeMode]? Disjunction[~UnicodeMode, ~UnicodeSetsMode, ?NamedCaptureGroups] `)`", p"AnnexB 1 ExtendedAtom :: `(` GroupSpecifier[~UnicodeMode]? Disjunction[~UnicodeMode, ~UnicodeSetsMode, ?NamedCaptureGroups] `)`"]
  keys ["ExtendedAtom :: `(` GroupSpecifier? Disjunction `)`"]
  vars [regexpRecord, direction, m, parenIndex, x, c, d, y, capability, input, xe, ye, r, z]
  steps {
    let m = sdo CompileSubpattern(child 5 |Disjunction|; regexpRecord, direction)
    let parenIndex = @sec-countleftcapturingparensbefore(child 6 |ExtendedAtom|)
    return closure 0
  }
  closure matcher params [x, c] captures [direction, m, parenIndex] {
    assert x is ty {MatchState}
    assert c is ty {MatcherContinuation}
    let d = closure 1
    return m(x, d)
  }
  closure matcher_continuation params [y] captures [x, c, direction, parenIndex] {
    assert y is ty {MatchState}
    let capability = $Copy(y[[Captures]])
    let input = x[[Input]]
    let xe = x[[EndIndex]]
    let ye = y[[EndIndex]]
    if direction is val {~forward~} {
      assert xe <= ye
      let r = record CaptureRange { [[StartIndex]]: xe, [[EndIndex]]: ye }
    }
    else {
      assert direction is val {~backward~}
      assert ye <= xe
      let r = record CaptureRange { [[StartIndex]]: ye, [[EndIndex]]: xe }
    }
    set expr capability[parenIndex + 1] = r
    let z = record MatchState { [[Input]]: input, [[EndIndex]]: ye, [[Captures]]: capability }
    return c(z)
  }
}

sdo_row @row-compileatom-extendedatom-modifiers CompileAtom form alg {
  prods [p"AnnexB - ExtendedAtom :: `(?` RegularExpressionModifiers `:` Disjunction[~UnicodeMode, ~UnicodeSetsMode, ?NamedCaptureGroups] `)`"]
  keys ["ExtendedAtom :: `(?` RegularExpressionModifiers `:` Disjunction `)`"]
  vars [regexpRecord, direction, addModifiers, removeModifiers, modifiedRer]
  steps {
    let addModifiers = $SourceText(child 5 |RegularExpressionModifiers|)
    let removeModifiers = $"the empty String"()
    let modifiedRer = @sec-updatemodifiers(regexpRecord, @sec-codepointstostring(addModifiers), removeModifiers)
    return sdo CompileSubpattern(child 5 |Disjunction|; modifiedRer, direction)
  }
}

sdo_row @row-compileatom-extendedatom-modifiers-remove CompileAtom form alg {
  prods [p"AnnexB - ExtendedAtom :: `(?` RegularExpressionModifiers `-` RegularExpressionModifiers `:` Disjunction[~UnicodeMode, ~UnicodeSetsMode, ?NamedCaptureGroups] `)`"]
  keys ["ExtendedAtom :: `(?` RegularExpressionModifiers `-` RegularExpressionModifiers `:` Disjunction `)`"]
  vars [regexpRecord, direction, addModifiers, removeModifiers, modifiedRer]
  steps {
    let addModifiers = $SourceText(child 0 |RegularExpressionModifiers|)
    let removeModifiers = $SourceText(child 1 |RegularExpressionModifiers|)
    let modifiedRer = @sec-updatemodifiers(regexpRecord, @sec-codepointstostring(addModifiers), @sec-codepointstostring(removeModifiers))
    return sdo CompileSubpattern(child 5 |Disjunction|; modifiedRer, direction)
  }
}

sdo_row @row-evaluation-if-function Evaluation form alg {
  prods [p"AnnexB - IfStatement : `if` `(` Expression[+In, ?Yield, ?Await] `)` FunctionDeclaration[?Yield, ?Await, ~Default] `else` Statement[?Yield, ?Await, ?Return]", p"AnnexB - IfStatement : `if` `(` Expression[+In, ?Yield, ?Await] `)` Statement[?Yield, ?Await, ?Return] `else` FunctionDeclaration[?Yield, ?Await, ~Default]", p"AnnexB - IfStatement : `if` `(` Expression[+In, ?Yield, ?Await] `)` FunctionDeclaration[?Yield, ?Await, ~Default] `else` FunctionDeclaration[?Yield, ?Await, ~Default]", p"AnnexB - IfStatement : `if` `(` Expression[+In, ?Yield, ?Await] `)` FunctionDeclaration[?Yield, ?Await, ~Default] [lookahead != `else`]"]
  keys ["IfStatement :\n      `if` `(` Expression `)` FunctionDeclaration `else` Statement\n      `if` `(` Expression `)` Statement `else` FunctionDeclaration\n      `if` `(` Expression `)` FunctionDeclaration `else` FunctionDeclaration\n      `if` `(` Expression `)` FunctionDeclaration"]
  vars [ifStatement]
  steps {
    let ifStatement = $CoveredBy(|IfStatement|, child 6 |IfStatement|)
    return ? sdo Evaluation(ifStatement)
  }
}

