  if expr not $IsOrdinaryMethod(v[[IsExtensible]], clause @sec-ordinary-object-internal-methods-and-internal-slots-isextensible) -> return false
  if expr not $IsOrdinaryMethod(v[[PreventExtensions]], clause @sec-ordinary-object-internal-methods-and-internal-slots-preventextensions) -> return false
