  if expr not $IsOrdinaryMethod(v[[DefineOwnProperty]], clause @sec-arguments-exotic-objects-defineownproperty-p-desc) -> return false
  if expr not $IsOrdinaryMethod(v[[HasProperty]], clause @sec-ordinary-object-internal-methods-and-internal-slots-hasproperty-p) -> return false
  if expr not $IsOrdinaryMethod(v[[Get]], clause @sec-arguments-exotic-objects-get-p-receiver) -> return false
  if expr not $IsOrdinaryMethod(v[[Set]], clause @sec-arguments-exotic-objects-set-p-v-receiver) -> return false
  if expr not $IsOrdinaryMethod(v[[Delete]], clause @sec-arguments-exotic-objects-delete-p) -> return false
  if expr not $IsOrdinaryMethod(v[[OwnPropertyKeys]], clause @sec-ordinary-object-internal-methods-and-internal-slots-ownpropertykeys) -> return false
  return true
}

