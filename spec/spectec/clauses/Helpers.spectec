def @formal-agent-interleave "formal-agent-interleave" (kind ao params [] -> val(~unused~)) vars [agent, execution, eventsRecord, target] {
  assert $EnteredCriticalSections() sat $IsEmpty()
  let agent = $AgentRecord()
  let execution = agent[[CandidateExecution]]
  let eventsRecord = $ListFind([[AgentSignifier]], execution[[EventsRecords]], @sec-agentsignifier())
  let target = $HostSelectAgent(agent, $ListLen(eventsRecord[[EventList]]))
  if target is val {~empty~} {
    perform $AgentTimeout()
    return ~unused~
  }
  perform $SwitchToAgent(target)
  resume $Running() with @sec-normalcompletion(~unused~)
  return ~unused~
}

def @formal-regexppattern "formal-regexppattern" (kind ao params [regexp : #"initialized RegExp instance"] -> |Pattern|) vars [regexp, pattern, flags, u, v, patternText, i, parseResult] {
  let pattern = regexp[[OriginalSource]]
  let flags = regexp[[OriginalFlags]]
  if_else flags sat $Contains("u") { let u = true } else { let u = false }
  if_else flags sat $Contains("v") { let v = true } else { let v = false }
  if u is val {true} or v is val {true} {
    let patternText = @sec-stringtocodepoints(pattern)
  }
  else {
    let patternText = $ListNew()
    for_range i incl 0 .. excl $StrLen(?pattern) {
      perform $Append($UnitOrPointOf(data choice 0, $NumericValue($UnitAt(?i, ?pattern))), ?patternText)
    }
  }
  let parseResult = @sec-parsepattern(patternText, u, v)
  assert parseResult is ty {pred(sat @ph-type-nt-parse-node(data choice 0, |Pattern|))}
  return parseResult
}

def @formal-capturegroupname "formal-capturegroupname" (kind ao params [pattern : |Pattern|, i : sort [positive] integer] -> |GroupName| | val(~empty~)) vars [pattern, i, specifier] {
  for_each specifier in $ParseNodesWithin(pattern) {
    if specifier is ty {pred(sat @ph-type-nt-parse-node(data choice 0, |GroupSpecifier|))} and @sec-countleftcapturingparensbefore(specifier) == i -> return $ChildOf(|GroupName|, ?specifier)
  }
  return ~empty~
}

def @formal-isdatetimerepresentable "formal-isdatetimerepresentable" (kind ao params [tv : sort [finite] #"time value"] -> Boolean) vars [tv, year] {
  let year = @sec-yearfromtime(tv)
  if year sat $InInterval(math(-999999), 999999) -> return true
  return false
}

def @formal-datetimestring "formal-datetimestring" (kind ao params [tv : sort [finite] #"time value", expanded : Boolean] -> String) vars [tv, expanded, year, yearString, month, day, hour, minute, second, ms, date, time] {
  assert @formal-isdatetimerepresentable(tv) is val {true}
  let year = @sec-yearfromtime(tv)
  if expanded is val {false} and year sat $InInterval(0, 9999) -> let yearString = @sec-tozeropaddeddecimalstring(year, 4)
  else_if year >= 0 -> let yearString = $"string-concatenation"("+", @sec-tozeropaddeddecimalstring(year, 6))
  else -> let yearString = $"string-concatenation"("-", @sec-tozeropaddeddecimalstring(neg year, 6))
  let month = @sec-tozeropaddeddecimalstring(@sec-monthfromtime(tv) + 1, 2)
  let day = @sec-tozeropaddeddecimalstring(@sec-datefromtime(tv), 2)
  let hour = @sec-tozeropaddeddecimalstring(@sec-hourfromtime(tv), 2)
  let minute = @sec-tozeropaddeddecimalstring(@sec-minutefromtime(tv), 2)
  let second = @sec-tozeropaddeddecimalstring(@sec-secondfromtime(tv), 2)
  let ms = @sec-tozeropaddeddecimalstring(@sec-millisecondfromtime(tv), 3)
  let date = $"string-concatenation"(yearString, "-", month, "-", day)
  let time = $"string-concatenation"(hour, ":", minute, ":", second, ".", ms)
  return $"string-concatenation"(date, "T", time, "Z")
}

def @formal-ieeebits "formal-ieeebits" (kind ao params [value : Number, w : sort [positive] integer, p : sort [positive] integer] -> sort [#"non-negative"] integer) vars [value, w, p, bias, sign, a, e] {
  let bias = 2 ^ {w - 1} - 1
  if value is val {nan} -> return $NaNEncoding(value, w, p)
  if_else value is val {num_f(-0)} or value < num_f(-0) { let sign = 2 ^ {w + p - 1} } else { let sign = 0 }
  if value is val {num_f(+∞); num_f(-∞)} -> return sign + (2 ^ w - 1) * 2 ^ {p - 1}
  let a = $abs($ℝ(value))
  if a == 0 -> return sign
  let e = 0
  repeat_while 2 ^ e > a {
    set var e = e - 1
  }
  repeat_while 2 ^ {e + 1} <= a {
    set var e = e + 1
  }
  if e < 1 - bias -> return sign + a / 2 ^ {2 - bias - p}
  return sign + (e + bias) * 2 ^ {p - 1} + (a / 2 ^ {e - p + 1} - 2 ^ {p - 1})
}

def @formal-littleendianbytes "formal-littleendianbytes" (kind ao params [n : sort [#"non-negative"] integer, size : sort [#"non-negative"] integer] -> list<#"byte value">) vars [n, size, bytes, m] {
  assert n < 2 ^ {8 * size}
  let bytes = $ListNew()
  let m = n
  repeat_n size {
    perform $Append(m modulo 256, ?bytes)
    set var m = $floor(m / 256)
  }
  return bytes
}

def @formal-base64encode "formal-base64encode" (kind ao params [bytes : list<#"byte value">, alphabet : String, omitPadding : Boolean] -> String) vars [bytes, alphabet, omitPadding, out, len, i, k, n, j, v] {
  assert $StrLen(?alphabet) is val {64}
  let out = $"the empty String"()
  let len = $ListLen(?bytes)
  let i = 0
  repeat_while i < len {
    let k = $min(3, len - i)
    let n = 0
    for_range j incl 0 .. excl 3 {
      if_else j < k { set var n = n * 256 + bytes[i + j] } else { set var n = n * 256 }
    }
    for_range j incl 0 .. excl 4 {
      if j <= k {
        let v = $floor(n / 2 ^ {6 * (3 - j)}) modulo 64
        set var out = $"string-concatenation"(out, $Substring(?alphabet, ?v, v + 1))
      }
      else_if omitPadding is val {false} {
        set var out = $"string-concatenation"(out, "=")
      }
    }
    set var i = i + 3
  }
  return out
}

def @formal-string.prototype.tolocaleuppercase "formal-string.prototype.tolocaleuppercase" (kind builtin params [reserved1 opt, reserved2 opt]) vars [#"this value", NewTarget, reserved1, reserved2, thisValue, string, sText, upperText, uppercaseString] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let sText = @sec-stringtocodepoints(string)
  let upperText = $LocaleUppercase(sText)
  let uppercaseString = @sec-codepointstostring(upperText)
  return uppercaseString
}

def @formal-string.prototype.tolocalelowercase "formal-string.prototype.tolocalelowercase" (kind builtin params [reserved1 opt, reserved2 opt]) vars [#"this value", NewTarget, reserved1, reserved2, thisValue, string, sText, lowerText, lowercaseString] {
  let thisValue = this_value
  perform ? @sec-requireobjectcoercible(thisValue)
  let string = ? @sec-tostring(thisValue)
  let sText = @sec-stringtocodepoints(string)
  let lowerText = $LocaleLowercase(sText)
  let lowercaseString = @sec-codepointstostring(lowerText)
  return lowercaseString
}

def @formal-number.prototype.tolocalestring "formal-number.prototype.tolocalestring" (kind builtin params [reserved1 opt, reserved2 opt]) vars [#"this value", NewTarget, reserved1, reserved2, x, s] {
  let x = ? @sec-thisnumbervalue(this_value)
  let s = $LocaleNumberString(x)
  if s is val {~empty~} -> return @sec-numeric-types-number-tostring(x, 10)
  return s
}

def @formal-bigint.prototype.tolocalestring "formal-bigint.prototype.tolocalestring" (kind builtin params [reserved1 opt, reserved2 opt]) vars [#"this value", NewTarget, reserved1, reserved2, x, s] {
  let x = ? @sec-thisbigintvalue(this_value)
