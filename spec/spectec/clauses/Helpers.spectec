  if expr not $IsOrdinaryMethod(v[[PreventExtensions]], clause @sec-typedarray-preventextensions) -> return false
  if expr not $IsOrdinaryMethod(v[[GetOwnProperty]], clause @sec-typedarray-getownproperty) -> return false
  if expr not $IsOrdinaryMethod(v[[DefineOwnProperty]], clause @sec-typedarray-defineownproperty) -> return false
  if expr not $IsOrdinaryMethod(v[[HasProperty]], clause @sec-typedarray-hasproperty) -> return false
