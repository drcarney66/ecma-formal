  return true
}

def @sec-module-namespace-exotic-objects-ownpropertykeys "[[OwnPropertyKeys]]" (kind internal_method recv #"obj" : #"module namespace exotic object" params [] -> completion<list<#"property key">>) vars [#"obj", exports, symbolKeys] {
  let exports = ? @sec-GetModuleExportsList(#"obj")
  let symbolKeys = @sec-ordinaryownpropertykeys(#"obj")
  return $ListConcat([exports, symbolKeys])
}

def @sec-modulenamespacecreate "ModuleNamespaceCreate" (kind ao params [module : #"Module Record", exports : list<String>, phase : val(~defer~) | val(~evaluation~)] -> #"module namespace exotic object") vars [module, exports, phase, internalSlotsList, namespace, sortedExports, toStringTag] {
  let internalSlotsList = $SlotsListed(table t"table-internal-slots-of-module-namespace-exotic-objects")
  let namespace = @sec-makebasicobject(internalSlotsList)
  perform @ph-set-methods(?namespace, data choice 1, data choice 1, clause @sec-module-namespace-exotic-objects)
  set field namespace[[Module]] = module
  let sortedExports = @ph-elements-lexicographic(?exports)
  set field namespace[[Exports]] = sortedExports
  if phase is val {~defer~} {
    assert module[[DeferredNamespace]] is val {~empty~}
    set field module[[DeferredNamespace]] = namespace
    set field namespace[[Deferred]] = true
    let toStringTag = "Deferred Module"
  }
  else {
    assert module[[Namespace]] is val {~empty~}
    set field module[[Namespace]] = namespace
    set field namespace[[Deferred]] = false
    let toStringTag = "Module"
  }
  perform $OwnPropertyCreate(namespace, $WellKnownSymbol("Symbol.toStringTag"), record PropertyDescriptor { [[Value]]: toStringTag, [[Writable]]: false, [[Enumerable]]: false, [[Configurable]]: false }, ~data~)
  return namespace
}

