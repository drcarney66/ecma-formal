def @sec-proxycreate "ProxyCreate" (kind ao params [target : #"ECMAScript language value", handler : #"ECMAScript language value"] -> completion<#"Proxy exotic object"> | #"throw completion") vars [target, handler, proxy] {
  if target is not ty {Object} -> throw @ph-new-error([[TypeError]])
  if handler is not ty {Object} -> throw @ph-new-error([[TypeError]])
  let proxy = @sec-makebasicobject([[[ProxyHandler]], [[ProxyTarget]]])
  perform @ph-set-methods(?proxy, data choice 0, data choice 1, clause @sec-proxy-object-internal-methods-and-internal-slots)
  if @sec-iscallable(target) is val {true} {
    set field proxy[[Call]] = ref @sec-proxy-object-internal-methods-and-internal-slots-call-thisargument-argumentslist
    if @sec-isconstructor(target) is val {true} {
      set field proxy[[Construct]] = ref @sec-proxy-object-internal-methods-and-internal-slots-construct-argumentslist-newtarget
    }
  }
  set field proxy[[ProxyTarget]] = target
