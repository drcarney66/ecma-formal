  steps {
    return ? sdo EvaluateAsyncFunctionBody(child 6 |AsyncFunctionBody|; func, argList)
  }
}

sdo_row @sec-runtime-semantics-evaluatebody#5 EvaluateBody form alg {
  prods [p"Syntactic - AsyncConciseBody : [lookahead != `{`] ExpressionBody[?In, +Await]"]
  keys ["\n          AsyncConciseBody : ExpressionBody\n        "]
  vars [func, argList]
  steps {
    return ? sdo EvaluateAsyncConciseBody(child 6 |AsyncConciseBody|; func, argList)
  }
}

sdo_row @sec-runtime-semantics-evaluatebody#6 EvaluateBody form alg {
  prods [p"Syntactic - Initializer : `=` AssignmentExpression[?In, ?Yield, ?Await]"]
  keys ["\n          Initializer :\n            `=` AssignmentExpression\n        "]
  vars [func, argList, value, rhs]
  steps {
    assert argList sat $IsEmpty()
    assert func[[ClassFieldInitializerName]] is not val {~empty~}
    if @sec-isanonymousfunctiondefinition(child 5 |AssignmentExpression|) is val {true} {
      let value = ? sdo NamedEvaluation(child 6 |Initializer|; func[[ClassFieldInitializerName]])
    }
    else {
      let rhs = ? sdo Evaluation(child 5 |AssignmentExpression|)
      let value = ? @sec-getvalue(rhs)
    }
    return @sec-returncompletion(value)
  }
}

sdo_row @sec-runtime-semantics-evaluatebody#7 EvaluateBody form alg {
  prods [p"Syntactic - ClassStaticBlockBody : ClassStaticBlockStatementList"]
  keys ["\n          ClassStaticBlockBody : ClassStaticBlockStatementList\n        "]
  vars [func, argList]
  steps {
    assert argList sat $IsEmpty()
    return ? sdo EvaluateClassStaticBlockBody(child 6 |ClassStaticBlockBody|; func)
  }
}

