def @sec-proxy-object-internal-methods-and-internal-slots-ownpropertykeys "[[OwnPropertyKeys]]" (kind internal_method recv #"obj" : #"Proxy exotic object" params [] -> completion<list<#"property key">> | #"throw completion") vars [#"obj", target, handler, trap, trapResultArray, trapResult, extensibleTarget, targetKeys, targetConfigurableKeys, targetNonconfigurableKeys, key, propertyDesc, uncheckedResultKeys] {
  perform ? @sec-validatenonrevokedproxy(#"obj")
  let target = #"obj"[[ProxyTarget]]
  let handler = #"obj"[[ProxyHandler]]
  assert handler is ty {Object}
  let trap = ? @sec-getmethod(handler, "ownKeys")
  if trap is val {undefined} {
    return ? target[[OwnPropertyKeys]]()
  }
  let trapResultArray = ? @sec-call(trap, handler, [target])
  let trapResult = ? @sec-createlistfromarraylike(trapResultArray, ~property-key~)
  if trapResult sat @ph-duplicate-entries(data choice 0) -> throw @ph-new-error([[TypeError]])
  let extensibleTarget = ? @sec-isextensible-o(target)
  let targetKeys = ? target[[OwnPropertyKeys]]()
  assert targetKeys is ty {list<#"property key">}
  assert targetKeys sat @ph-no-duplicate-entries(data choice 1)
  let targetConfigurableKeys = $ListNew()
  let targetNonconfigurableKeys = $ListNew()
  for_each key in targetKeys {
    let propertyDesc = ? target[[GetOwnProperty]](key)
    if propertyDesc is not val {undefined} and propertyDesc[[Configurable]] is val {false} {
      perform $Append(?key, ?targetNonconfigurableKeys)
    }
    else {
      perform $Append(?key, ?targetConfigurableKeys)
    }
  }
  if extensibleTarget is val {true} and targetNonconfigurableKeys sat $IsEmpty() {
    return trapResult
  }
  let uncheckedResultKeys = @ph-list-whose-elements([@ph-elements-of(?trapResult)])
  for_each key in targetNonconfigurableKeys {
    if uncheckedResultKeys fails $Contains(?key) -> throw @ph-new-error([[TypeError]])
    perform $RemoveElem(?key, ?uncheckedResultKeys)
  }
  if extensibleTarget is val {true} -> return trapResult
  for_each key in targetConfigurableKeys {
    if uncheckedResultKeys fails $Contains(?key) -> throw @ph-new-error([[TypeError]])
    perform $RemoveElem(?key, ?uncheckedResultKeys)
  }
  if uncheckedResultKeys fails $IsEmpty() -> throw @ph-new-error([[TypeError]])
  return trapResult
}

