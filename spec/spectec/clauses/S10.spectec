    let settingConfigurableFalse = false
  }
  if targetDesc is val {undefined} {
    if extensibleTarget is val {false} -> throw @ph-new-error([[TypeError]])
    if settingConfigurableFalse is val {true} -> throw @ph-new-error([[TypeError]])
  }
  else {
    if @sec-iscompatiblepropertydescriptor(extensibleTarget, propertyDesc, targetDesc) is val {false} -> throw @ph-new-error([[TypeError]])
    if settingConfigurableFalse is val {true} and targetDesc[[Configurable]] is val {true} -> throw @ph-new-error([[TypeError]])
    if @sec-isdatadescriptor(targetDesc) is val {true} and targetDesc[[Configurable]] is val {false} and targetDesc[[Writable]] is val {true} {
