  if trap is val {undefined} {
    return ? target[[GetOwnProperty]](propertyKey)
  }
  let trapResultObj = ? @sec-call(trap, handler, [target, propertyKey])
  if trapResultObj is not ty {Object} and trapResultObj is not val {undefined} -> throw @ph-new-error([[TypeError]])
  let targetDesc = ? target[[GetOwnProperty]](propertyKey)
  if trapResultObj is val {undefined} {
    if targetDesc is val {undefined} -> return undefined
    if targetDesc[[Configurable]] is val {false} -> throw @ph-new-error([[TypeError]])
    let extensibleTarget = ? @sec-isextensible-o(target)
    if extensibleTarget is val {false} -> throw @ph-new-error([[TypeError]])
    return undefined
  }
  let extensibleTarget = ? @sec-isextensible-o(target)
  let resultDesc = ? @sec-topropertydescriptor(trapResultObj)
  perform @sec-completepropertydescriptor(resultDesc)
  let valid = @sec-iscompatiblepropertydescriptor(extensibleTarget, resultDesc, targetDesc)
  if valid is val {false} -> throw @ph-new-error([[TypeError]])
  if resultDesc[[Configurable]] is val {false} {
    if targetDesc is val {undefined} or targetDesc[[Configurable]] is val {true} {
      throw @ph-new-error([[TypeError]])
    }
    if resultDesc sat $HasField([[Writable]]) and resultDesc[[Writable]] is val {false} {
      assert targetDesc sat $HasField([[Writable]])
      if targetDesc[[Writable]] is val {true} -> throw @ph-new-error([[TypeError]])
    }
  }
  return resultDesc
}

