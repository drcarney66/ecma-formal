def @sec-object.getownpropertydescriptors "Object.getOwnPropertyDescriptors" (kind builtin params [#"obj"]) vars [#"this value", NewTarget, #"obj", coerced, ownKeys, descs, key, propertyDesc, propertyDescObj] {
  let coerced = ? @sec-toobject(#"obj")
  let ownKeys = ? coerced[[OwnPropertyKeys]]()
  let descs = @sec-ordinaryobjectcreate(intrinsic [[Object.prototype]])
  for_each key in ownKeys {
    let propertyDesc = ? coerced[[GetOwnProperty]](key)
    let propertyDescObj = @sec-frompropertydescriptor(propertyDesc)
    if propertyDescObj is not val {undefined} -> perform ! @sec-createdatapropertyorthrow(descs, key, propertyDescObj)
  }
  return descs
}

def @sec-object.getownpropertynames "Object.getOwnPropertyNames" (kind builtin params [#"obj"]) vars [#"this value", NewTarget, #"obj"] {
