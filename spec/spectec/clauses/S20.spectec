def @sec-object.freeze "Object.freeze" (kind builtin params [#"obj"]) vars [#"this value", NewTarget, #"obj", status] {
  if #"obj" is not ty {Object} -> return #"obj"
  let status = ? @sec-setintegritylevel(#"obj", ~frozen~)
  if status is val {false} -> throw @ph-new-error([[TypeError]])
