def @sec-thissymbolvalue "ThisSymbolValue" (kind ao params [arg : #"ECMAScript language value"] -> completion<Symbol> | #"throw completion") vars [arg, symbol] {
  if arg is ty {Symbol} -> return arg
  if arg is ty {Object} and arg sat $HasSlot([[SymbolData]]) {
    let symbol = arg[[SymbolData]]
    assert symbol is ty {Symbol}
    return symbol
  }
  throw @ph-new-error([[TypeError]])
}

def @sec-symbol.prototype-%symbol.toprimitive% "Symbol.prototype [ %Symbol.toPrimitive% ]" (kind builtin params [hint]) vars [#"this value", NewTarget, hint] {
  return ? @sec-thissymbolvalue(this_value)
}

def @sec-keyforsymbol "KeyForSymbol" (kind ao params [symbol : Symbol] -> String | val(undefined)) vars [symbol, agentRecord, globalSymbolRegistry, element] {
  let agentRecord = $AgentRecord()
  let globalSymbolRegistry = agentRecord[[GlobalSymbolRegistry]]
  for_each element in globalSymbolRegistry {
    if @sec-samevalue(element[[Symbol]], symbol) is val {true} -> return element[[Key]]
  }
  assert globalSymbolRegistry sat @ph-no-registry-entry(?symbol)
  return undefined
}

def @sec-error-message "Error" (kind builtin params [message, options opt]) vars [#"this value", NewTarget, message, options, newTarget, #"obj", messageString] {
  if_else new_target is val {undefined} { let newTarget = $ActiveFunction() } else { let newTarget = new_target }
  let #"obj" = ? @sec-ordinarycreatefromconstructor(newTarget, "%Error.prototype%", [[[ErrorData]]])
  if message is not val {undefined} {
    let messageString = ? @sec-tostring(message)
    perform @sec-createnonenumerabledatapropertyorthrow(#"obj", "message", messageString)
  }
  perform ? @sec-installerrorownproperties(#"obj", options)
  perform $HostExtendObject(#"obj")
  return #"obj"
}

def @sec-error.iserror "Error.isError" (kind builtin params [arg]) vars [#"this value", NewTarget, arg] {
  if arg is not ty {Object} -> return false
  if arg fails $HasSlot([[ErrorData]]) -> return false
  return true
}

def @sec-error.prototype.tostring "Error.prototype.toString" (kind builtin params []) vars [#"this value", NewTarget, #"obj", name, message] {
  let #"obj" = this_value
  if #"obj" is not ty {Object} -> throw @ph-new-error([[TypeError]])
  let name = ? @sec-get-o-p(#"obj", "name")
  if_else name is val {undefined} { set var name = "Error" } else { set var name = ? @sec-tostring(name) }
  let message = ? @sec-get-o-p(#"obj", "message")
  if_else message is val {undefined} { set var message = $"the empty String"() } else { set var message = ? @sec-tostring(message) }
  if name is val {$"the empty String"()} -> return message
  if message is val {$"the empty String"()} -> return name
  return $"string-concatenation"(name, $CodeUnit(cu(58, "003A", "COLON")), $CodeUnit(cu(32, "0020", "SPACE")), message)
}

def @sec-aggregate-error "AggregateError" (kind builtin params [errors, message, options opt]) vars [#"this value", NewTarget, errors, message, options, newTarget, #"obj", messageString, errorsList] {
  if_else new_target is val {undefined} { let newTarget = $ActiveFunction() } else { let newTarget = new_target }
  let #"obj" = ? @sec-ordinarycreatefromconstructor(newTarget, "%AggregateError.prototype%", [[[ErrorData]]])
  if message is not val {undefined} {
    let messageString = ? @sec-tostring(message)
    perform @sec-createnonenumerabledatapropertyorthrow(#"obj", "message", messageString)
  }
  perform ? @sec-installerrorownproperties(#"obj", options)
  let errorsList = ? @sec-iteratortolist(? @sec-getiterator(errors, ~sync~))
  perform ! @sec-definepropertyorthrow(#"obj", "errors", record PropertyDescriptor { [[Configurable]]: true, [[Enumerable]]: false, [[Writable]]: true, [[Value]]: @sec-createarrayfromlist(errorsList) })
  perform $HostExtendObject(#"obj")
  return #"obj"
}

