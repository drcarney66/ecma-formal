def @sec-function-p1-p2-pn-body "Function" (kind builtin params [paramArgs rest, bodyArg]) vars [#"this value", NewTarget, paramArgs, bodyArg, ctor] {
  let ctor = $ActiveFunction()
  if bodyArg fails $Present() -> set var bodyArg = $"the empty String"()
  return ? @sec-createdynamicfunction(ctor, new_target, ~normal~, paramArgs, bodyArg)
}

def @sec-createdynamicfunction "CreateDynamicFunction" (kind ao params [ctor : constructor, newTarget : constructor | val(undefined), #"kind" : val(~normal~) | val(~generator~) | val(~async~) | val(~async-generator~), paramArgs : list<#"ECMAScript language value">, bodyArg : #"ECMAScript language value"] -> completion<#"ECMAScript function object"> | #"throw completion") vars [ctor, newTarget, #"kind", paramArgs, bodyArg, prefix, exprGrammar, bodyGrammar, paramGrammar, fallbackProto, argCount, paramStrings, arg, paramString, bodyString, currentRealm, joinedParamsString, k, nextArgString, bodyParseString, sourceString, sourceText, #"params", body, expr, funcProto, envRecord, privateEnv, func, protoProto] {
  if newTarget is val {undefined} -> set var newTarget = ctor
  if #"kind" is val {~normal~} {
    let prefix = "function"
    let exprGrammar = $GrammarSymbol(|FunctionExpression|)
    let bodyGrammar = $GrammarSymbol(|FunctionBody[~Yield, ~Await]|)
    let paramGrammar = $GrammarSymbol(|FormalParameters[~Yield, ~Await]|)
    let fallbackProto = "%Function.prototype%"
  }
  else_if #"kind" is val {~generator~} {
    let prefix = "function*"
    let exprGrammar = $GrammarSymbol(|GeneratorExpression|)
    let bodyGrammar = $GrammarSymbol(|GeneratorBody|)
    let paramGrammar = $GrammarSymbol(|FormalParameters[+Yield, ~Await]|)
    let fallbackProto = "%GeneratorFunction.prototype%"
  }
  else_if #"kind" is val {~async~} {
    let prefix = "async function"
    let exprGrammar = $GrammarSymbol(|AsyncFunctionExpression|)
    let bodyGrammar = $GrammarSymbol(|AsyncFunctionBody|)
    let paramGrammar = $GrammarSymbol(|FormalParameters[~Yield, +Await]|)
    let fallbackProto = "%AsyncFunction.prototype%"
  }
  else {
    assert #"kind" is val {~async-generator~}
    let prefix = "async function*"
    let exprGrammar = $GrammarSymbol(|AsyncGeneratorExpression|)
    let bodyGrammar = $GrammarSymbol(|AsyncGeneratorBody|)
    let paramGrammar = $GrammarSymbol(|FormalParameters[+Yield, +Await]|)
    let fallbackProto = "%AsyncGeneratorFunction.prototype%"
  }
  let argCount = $ListLen(?paramArgs)
  let paramStrings = $ListNew()
  for_each arg in paramArgs {
    if_else arg is ty {Object} { let paramString = @sec-hostgetcodeforeval(arg) } else { let paramString = ~no-code~ }
    if paramString is val {~no-code~} -> set var paramString = ? @sec-tostring(arg)
    perform $Append(?paramString, ?paramStrings)
  }
  if_else bodyArg is ty {Object} { let bodyString = @sec-hostgetcodeforeval(bodyArg) } else { let bodyString = ~no-code~ }
  if bodyString is val {~no-code~} -> set var bodyString = ? @sec-tostring(bodyArg)
  let currentRealm = $CurrentRealm()
  let joinedParamsString = $"the empty String"()
  if argCount > 0 {
    set var joinedParamsString = paramStrings[0]
    let k = 1
    repeat_while k < argCount {
      let nextArgString = paramStrings[k]
      set var joinedParamsString = $"string-concatenation"(joinedParamsString, ",", nextArgString)
      set var k = k + 1
    }
  }
  let bodyParseString = $"string-concatenation"(cu(10, "000A", "LINE FEED"), bodyString, cu(10, "000A", "LINE FEED"))
  let sourceString = $"string-concatenation"(prefix, " anonymous(", joinedParamsString, cu(10, "000A", "LINE FEED"), ") {", bodyParseString, "}")
  perform ? @sec-hostensurecancompilestrings(currentRealm, paramStrings, bodyString, sourceString, ~function~, paramArgs, bodyArg)
  let sourceText = @sec-stringtocodepoints(sourceString)
  let #"params" = @sec-parsetext(joinedParamsString, paramGrammar)
  if #"params" is ty {list<error>} -> throw @ph-new-error([[SyntaxError]])
  let body = @sec-parsetext(bodyParseString, bodyGrammar)
  if body is ty {list<error>} -> throw @ph-new-error([[SyntaxError]])
  note "The parameters and body are parsed separately to ensure that each is valid alone. For example, `new Function(\"/*\", \"*/ ) {\")` does not evaluate to a function."
  note "If this step is reached, _sourceText_ must have the syntax of _exprGrammar_ (although the reverse implication does not hold). The purpose of the next two steps is to enforce any Early Error rules which apply to _exprGrammar_ directly."
  let expr = @sec-parsetext(sourceText, exprGrammar)
  if expr is ty {list<error>} -> throw @ph-new-error([[SyntaxError]])
  if sdo AllPrivateIdentifiersValid(body; []) is val {false} -> throw @ph-new-error([[SyntaxError]])
  if sdo AllPrivateIdentifiersValid(#"params"; []) is val {false} -> throw @ph-new-error([[SyntaxError]])
  let funcProto = ? @sec-getprototypefromconstructor(newTarget, fallbackProto)
  let envRecord = currentRealm[[GlobalEnv]]
  let privateEnv = null
  let func = @sec-ordinaryfunctioncreate(funcProto, sourceText, #"params", body, ~non-lexical-this~, envRecord, privateEnv)
  perform @sec-setfunctionname(func, "anonymous")
  if #"kind" is val {~generator~} {
    let protoProto = @sec-ordinaryobjectcreate(intrinsic [[GeneratorPrototype]])
    perform ! @sec-definepropertyorthrow(func, "prototype", record PropertyDescriptor { [[Value]]: protoProto, [[Writable]]: true, [[Enumerable]]: false, [[Configurable]]: false })
  }
  else_if #"kind" is val {~async-generator~} {
    let protoProto = @sec-ordinaryobjectcreate(intrinsic [[AsyncGeneratorPrototype]])
    perform ! @sec-definepropertyorthrow(func, "prototype", record PropertyDescriptor { [[Value]]: protoProto, [[Writable]]: true, [[Enumerable]]: false, [[Configurable]]: false })
  }
  else_if #"kind" is val {~normal~} {
    perform @sec-makeconstructor(func)
  }
  note "Functions whose _kind_ is ~async~ are not constructable and do not have a [[Construct]] internal method or a *\"prototype\"* property."
  return func
}

def @sec-function.prototype.apply "Function.prototype.apply" (kind builtin params [thisArg, argArray]) vars [#"this value", NewTarget, thisArg, argArray, func, argList] {
  let func = this_value
  if @sec-iscallable(func) is val {false} -> throw @ph-new-error([[TypeError]])
  if argArray is val {undefined; null} {
    perform @sec-preparefortailcall()
    return ? @sec-call(func, thisArg)
  }
  let argList = ? @sec-createlistfromarraylike(argArray)
  perform @sec-preparefortailcall()
  return ? @sec-call(func, thisArg, argList)
}

def @sec-function.prototype.bind "Function.prototype.bind" (kind builtin params [thisArg, args rest]) vars [#"this value", NewTarget, thisArg, args, target, boundFunc, length, targetHasLength, targetLength, targetLengthAsInt, argCount, targetName] {
  let target = this_value
  if @sec-iscallable(target) is val {false} -> throw @ph-new-error([[TypeError]])
  let boundFunc = ? @sec-boundfunctioncreate(target, thisArg, args)
  let length = 0
  let targetHasLength = ? @sec-hasownproperty(target, "length")
  if targetHasLength is val {true} {
    let targetLength = ? @sec-get-o-p(target, "length")
    if targetLength is ty {Number} {
      let targetLengthAsInt = ! @sec-tointegerorinfinity(targetLength)
      if targetLengthAsInt == math(+∞) {
        set var length = math(+∞)
      }
      else_if targetLengthAsInt == math(-∞) {
        set var length = 0
      }
      else {
        let argCount = $ListLen(?args)
        set var length = $max(targetLengthAsInt - argCount, 0)
      }
    }
  }
  perform @sec-setfunctionlength(boundFunc, length)
  let targetName = ? @sec-get-o-p(target, "name")
  if targetName is not ty {String} -> set var targetName = $"the empty String"()
  perform @sec-setfunctionname(boundFunc, targetName, "bound")
  return boundFunc
}

def @sec-function.prototype.call "Function.prototype.call" (kind builtin params [thisArg, args rest]) vars [#"this value", NewTarget, thisArg, args, func] {
  let func = this_value
  if @sec-iscallable(func) is val {false} -> throw @ph-new-error([[TypeError]])
  perform @sec-preparefortailcall()
  return ? @sec-call(func, thisArg, args)
}

def @sec-function.prototype.tostring "Function.prototype.toString" (kind builtin params []) vars [#"this value", NewTarget, func, name, matched, native, closed, key, accessor, n] {
  let func = this_value
  if func is ty {Object} and func sat $HasSlot([[SourceText]]) and func[[SourceText]] is ty {#"sequence of Unicode code points"} and @sec-hosthassourcetextavailable(func) is val {true} {
    return @sec-codepointstostring(func[[SourceText]])
  }
  if func is ty {sort [#"built-in"] #"function object"} {
    if func sat $HasSlot([[InitialName]]) and func[[InitialName]] is ty {String} {
      let name = func[[InitialName]]
      let matched = false
      if name is val {"get"} or name is val {"set"} {
        set var matched = true
      }
      else_if name is not val {$"the empty String"()} {
        let native = $ParseGoal(@sec-stringtocodepoints($"string-concatenation"("function ", name, "() { [native code] }")), |NativeFunction|, false, false, false)
        let closed = $ParseGoal(@sec-stringtocodepoints($"string-concatenation"("function ", name, $CodeUnit(cu(10, "000A", "LINE FEED")), "() { [native code] }")), |NativeFunction|, false, false, false)
        if native is not val {~empty~} and closed is not val {~empty~} and native sat @ph-contains-node(data choice 0, |PropertyName|) {
          let key = @sec-codepointstostring($SourceText(@ph-first-node-within(|PropertyName|, ?native)))
          if native sat @ph-not-contains-node(data choice 0, |NativeFunctionAccessor|) {
            if name is val {key} -> set var matched = true
          }
          else {
            let accessor = @sec-codepointstostring($SourceText(@ph-first-node-within(|NativeFunctionAccessor|, ?native)))
            let n = $StrLen(?name)
            if $Substring(?name, 0, $StrLen(?accessor)) is val {accessor} and $Substring(?name, n - $StrLen(?key), ?n) is val {key} -> set var matched = true
          }
        }
      }
      if name is not val {$"the empty String"()} and matched is val {false} -> return $""()
    }
    return $NativeFunctionSource(func)
  }
  if func is ty {Object} and @sec-iscallable(func) is val {true} -> return $NativeFunctionSource(func)
  throw @ph-new-error([[TypeError]])
}

def @sec-function.prototype-%symbol.hasinstance% "Function.prototype [ %Symbol.hasInstance% ]" (kind builtin params [value]) vars [#"this value", NewTarget, value, thisValue] {
  let thisValue = this_value
  return ? @sec-ordinaryhasinstance(thisValue, value)
}

def @sec-boolean-constructor-boolean-value "Boolean" (kind builtin params [value]) vars [#"this value", NewTarget, value, bool, #"obj"] {
  let bool = @sec-toboolean(value)
  if new_target is val {undefined} -> return bool
  let #"obj" = ? @sec-ordinarycreatefromconstructor(new_target, "%Boolean.prototype%", [[[BooleanData]]])
  set field #"obj"[[BooleanData]] = bool
  return #"obj"
}

def @sec-boolean.prototype.tostring "Boolean.prototype.toString" (kind builtin params []) vars [#"this value", NewTarget, bool] {
  let bool = ? @sec-thisbooleanvalue(this_value)
  if bool is val {true} -> return "true"
  return "false"
}

def @sec-boolean.prototype.valueof "Boolean.prototype.valueOf" (kind builtin params []) vars [#"this value", NewTarget] {
  return ? @sec-thisbooleanvalue(this_value)
}

def @sec-thisbooleanvalue "ThisBooleanValue" (kind ao params [arg : #"ECMAScript language value"] -> completion<Boolean> | #"throw completion") vars [arg, bool] {
  if arg is ty {Boolean} -> return arg
  if arg is ty {Object} and arg sat $HasSlot([[BooleanData]]) {
    let bool = arg[[BooleanData]]
    assert bool is ty {Boolean}
    return bool
  }
  throw @ph-new-error([[TypeError]])
}

def @sec-symbol-description "Symbol" (kind builtin params [description opt]) vars [#"this value", NewTarget, description, descString] {
  if new_target is not val {undefined} -> throw @ph-new-error([[TypeError]])
  if description is val {undefined} -> let descString = undefined
  else -> let descString = ? @sec-tostring(description)
  return @ph-new-symbol-whose-description(?descString)
}

def @sec-symbol.for "Symbol.for" (kind builtin params [key]) vars [#"this value", NewTarget, key, stringKey, agentRecord, globalSymbolRegistry, element, newSymbol] {
  let stringKey = ? @sec-tostring(key)
  let agentRecord = $AgentRecord()
  let globalSymbolRegistry = agentRecord[[GlobalSymbolRegistry]]
  for_each element in globalSymbolRegistry {
    if element[[Key]] is val {stringKey} -> return element[[Symbol]]
  }
  assert globalSymbolRegistry sat @ph-no-registry-entry(?stringKey)
  let newSymbol = @ph-new-symbol-whose-description(?stringKey)
  perform $Append(record #"GlobalSymbolRegistry Record" { [[Key]]: stringKey, [[Symbol]]: newSymbol }, ?globalSymbolRegistry)
  return newSymbol
}

def @sec-symbol.keyfor "Symbol.keyFor" (kind builtin params [symbol]) vars [#"this value", NewTarget, symbol] {
  if symbol is not ty {Symbol} -> throw @ph-new-error([[TypeError]])
  return @sec-keyforsymbol(symbol)
}

def @sec-symbol.prototype.description "get Symbol.prototype.description" (kind builtin params []) vars [#"this value", NewTarget, symbol] {
