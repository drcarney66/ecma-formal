def @sec-object.prototype.tostring "Object.prototype.toString" (kind builtin params []) vars [#"this value", NewTarget, #"obj", isArray, builtinTag, tag] {
  if this_value is val {undefined} -> return "[object Undefined]"
  if this_value is val {null} -> return "[object Null]"
  let #"obj" = ! @sec-toobject(this_value)
  let isArray = ? @sec-isarray(#"obj")
  if isArray is val {true} -> let builtinTag = "Array"
  else_if #"obj" sat $HasSlot([[ParameterMap]]) -> let builtinTag = "Arguments"
  else_if #"obj" sat $HasMethod([[Call]]) -> let builtinTag = "Function"
  else_if #"obj" sat $HasSlot([[ErrorData]]) -> let builtinTag = "Error"
  else_if #"obj" sat $HasSlot([[BooleanData]]) -> let builtinTag = "Boolean"
  else_if #"obj" sat $HasSlot([[NumberData]]) -> let builtinTag = "Number"
  else_if #"obj" sat $HasSlot([[StringData]]) -> let builtinTag = "String"
  else_if #"obj" sat $HasSlot([[DateValue]]) -> let builtinTag = "Date"
  else_if #"obj" sat $HasSlot([[RegExpMatcher]]) -> let builtinTag = "RegExp"
  else -> let builtinTag = "Object"
  let tag = ? @sec-get-o-p(#"obj", $WellKnownSymbol("Symbol.toStringTag"))
  if tag is not ty {String} -> set var tag = builtinTag
  return $"string-concatenation"("[object ", tag, "]")
}

