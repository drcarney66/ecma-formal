def @sec-object.fromentries "Object.fromEntries" (kind builtin params [iterable]) vars [#"this value", NewTarget, iterable, #"obj", #"closure", key, value, propertyKey, adder] {
  perform ? @sec-requireobjectcoercible(iterable)
  let #"obj" = @sec-ordinaryobjectcreate(intrinsic [[Object.prototype]])
  assert #"obj" is ty {pred(sat @spec-copy-1(data choice 1, data choice 0))}
  let #"closure" = closure 0
  let adder = @sec-createbuiltinfunction(#"closure", 2, "", [])
  return ? @sec-add-entries-from-iterable(#"obj", iterable, adder)
  closure abstract params [key, value] captures [#"obj"] {
    let propertyKey = ? @sec-topropertykey(key)
    perform ! @sec-createdatapropertyorthrow(#"obj", propertyKey, value)
    return @sec-normalcompletion(undefined)
  }
}

def @sec-object.getownpropertydescriptor "Object.getOwnPropertyDescriptor" (kind builtin params [#"obj", key]) vars [#"this value", NewTarget, #"obj", key, coerced, propertyKey, propertyDesc] {
  let coerced = ? @sec-toobject(#"obj")
