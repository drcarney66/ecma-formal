}

def @sec-symboldescriptivestring "SymbolDescriptiveString" (kind ao params [symbol : Symbol] -> String) vars [symbol, description] {
  let description = symbol[[Description]]
  if description is val {undefined} -> set var description = $"the empty String"()
  assert description is ty {String}
  return $"string-concatenation"("Symbol(", description, ")")
}

def @sec-symbol.prototype.valueof "Symbol.prototype.valueOf" (kind builtin params []) vars [#"this value", NewTarget] {
