def @sec-getownpropertykeys "GetOwnPropertyKeys" (kind ao params [value : #"ECMAScript language value", type : val(~string~) | val(~symbol~)] -> completion<list<#"property key">> | #"throw completion") vars [value, type, #"obj", #"keys", nameList, nextKey] {
  let #"obj" = ? @sec-toobject(value)
  let #"keys" = ? #"obj"[[OwnPropertyKeys]]()
  let nameList = $ListNew()
  for_each nextKey in #"keys" {
    if nextKey is ty {Symbol} and type is val {~symbol~} or nextKey is ty {String} and type is val {~string~} {
      perform $Append(?nextKey, ?nameList)
    }
  }
  return nameList
}

