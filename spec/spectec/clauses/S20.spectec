-- ECMA-262 SpecTec Clauses: S20

def @sec-object-value "Object" (kind builtin params [value]) vars [#"this value", NewTarget, value] {
  if new_target is neither val {undefined; $ActiveFunction()} {
    return ? @sec-ordinarycreatefromconstructor(new_target, "%Object.prototype%")
  }
  if value is val {undefined; null} -> return @sec-ordinaryobjectcreate(intrinsic [[Object.prototype]])
  return ! @sec-toobject(value)
}

def @sec-object.assign "Object.assign" (kind builtin params [target, sources rest]) vars [#"this value", NewTarget, target, sources, targetObj, nextSource, #"from", #"keys", nextKey, propertyDesc, propertyValue] {
  let targetObj = ? @sec-toobject(target)
  if expr @ph-only-one-argument-passed() -> return targetObj
  for_each nextSource in sources {
    if nextSource is neither val {undefined; null} {
      let #"from" = ! @sec-toobject(nextSource)
      let #"keys" = ? #"from"[[OwnPropertyKeys]]()
      for_each nextKey in #"keys" {
        let propertyDesc = ? #"from"[[GetOwnProperty]](nextKey)
        if propertyDesc is not val {undefined} and propertyDesc[[Enumerable]] is val {true} {
          let propertyValue = ? @sec-get-o-p(#"from", nextKey)
          perform ? @sec-set-o-p-v-throw(targetObj, nextKey, propertyValue, true)
        }
      }
    }
  }
  return targetObj
}

def @sec-object.create "Object.create" (kind builtin params [proto, properties]) vars [#"this value", NewTarget, proto, properties, #"obj"] {
  if proto is not ty {Object} and proto is not val {null} -> throw @ph-new-error([[TypeError]])
  let #"obj" = @sec-ordinaryobjectcreate(proto)
  if properties is not val {undefined} {
    return ? @sec-objectdefineproperties(#"obj", properties)
  }
  return #"obj"
}

def @sec-object.defineproperties "Object.defineProperties" (kind builtin params [#"obj", properties]) vars [#"this value", NewTarget, #"obj", properties] {
  if #"obj" is not ty {Object} -> throw @ph-new-error([[TypeError]])
  return ? @sec-objectdefineproperties(#"obj", properties)
}

def @sec-objectdefineproperties "ObjectDefineProperties" (kind ao params [#"obj" : Object, properties : #"ECMAScript language value"] -> completion<Object> | #"throw completion") vars [#"obj", properties, #"keys", propertyDescs, nextKey, currentPropertyDesc, propertyDescObj, propertyDesc, property] {
  set var properties = ? @sec-toobject(properties)
  let #"keys" = ? properties[[OwnPropertyKeys]]()
  let propertyDescs = $ListNew()
  for_each nextKey in #"keys" {
    let currentPropertyDesc = ? properties[[GetOwnProperty]](nextKey)
    if currentPropertyDesc is not val {undefined} and currentPropertyDesc[[Enumerable]] is val {true} {
      let propertyDescObj = ? @sec-get-o-p(properties, nextKey)
      let propertyDesc = ? @sec-topropertydescriptor(propertyDescObj)
      perform $Append(record Record { [[Key]]: nextKey, [[Descriptor]]: propertyDesc }, ?propertyDescs)
    }
  }
  for_each property in propertyDescs {
    perform ? @sec-definepropertyorthrow(#"obj", property[[Key]], property[[Descriptor]])
  }
  return #"obj"
}

def @sec-object.defineproperty "Object.defineProperty" (kind builtin params [#"obj", key, attrs]) vars [#"this value", NewTarget, #"obj", key, attrs, propertyKey, propertyDesc] {
  if #"obj" is not ty {Object} -> throw @ph-new-error([[TypeError]])
  let propertyKey = ? @sec-topropertykey(key)
  let propertyDesc = ? @sec-topropertydescriptor(attrs)
  perform ? @sec-definepropertyorthrow(#"obj", propertyKey, propertyDesc)
  return #"obj"
}

