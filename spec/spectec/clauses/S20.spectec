def @sec-installerrorownproperties "InstallErrorOwnProperties" (kind ao params [O : Object, options : #"ECMAScript language value"] -> completion<val(~unused~)> | #"throw completion") vars [O, options, cause, #"code"] {
  if options is ty {Object} {
    if ? @sec-hasproperty(options, "cause") is val {true} {
      let cause = ? @sec-get-o-p(options, "cause")
      perform @sec-createnonenumerabledatapropertyorthrow(O, "cause", cause)
    }
    if ? @sec-hasproperty(options, "code") is val {true} {
      let #"code" = ? @sec-get-o-p(options, "code")
      perform @sec-createnonenumerabledatapropertyorthrow(O, "code", #"code")
    }
  }
  return ~unused~
}

