-- ECMA-262 SpecTec Clauses: S08

def @sec-isanonymousfunctiondefinition "IsAnonymousFunctionDefinition" (kind ao params [expr : |AssignmentExpression| | |Initializer| | |Expression|] -> Boolean) vars [expr, hasName] {
  if sdo IsFunctionDefinition(expr) is val {false} -> return false
  let hasName = sdo HasName(expr)
  if hasName is val {true} -> return false
  return true
}

def @sec-static-semantics-contains "Contains" (kind sdo params [symbol : #"grammar symbol"] -> Boolean) vars [symbol, #"child", contained] {
  for_children #"child" {
    if expr $InstanceOf(#"child", ?symbol) -> return true
    if symbol is val {|AwaitExpression|} and expr $InstanceOf(this_node, prods [p"Syntactic - UnaryExpression : [+Await] CoverAwaitExpressionAndAwaitUsingDeclarationHead[?Yield]"]) -> return true
    if expr $InstanceOf(#"child", data sort nonterminal) {
      let contained = @ph-result-of(@ph-contains(?#"child", ?symbol))
      if contained is val {true} -> return true
    }
  }
  return false
}

def @sec-initializeboundname "InitializeBoundName" (kind ao params [name : String, value : #"ECMAScript language value", envRecord : #"Environment Record" | val(undefined)] -> completion<val(~unused~)> | #"abrupt completion") vars [name, value, envRecord, lhs] {
  if envRecord is not val {undefined} {
    perform ! envRecord.InitializeBinding(name, value)
    return ~unused~
  }
  let lhs = ? @sec-resolvebinding(name)
  return ? @sec-putvalue(lhs, value)
}

sdo_row @sec-static-semantics-boundnames BoundNames form alg {
  prods [p"Syntactic - BindingIdentifier : Identifier"]
  keys ["BindingIdentifier : Identifier"]
  vars []
  steps {
    return $ListOf1(sdo StringValue(child 5 |Identifier|))
  }
}

