    return ? sdo BindingInitialization(child 5 |BindingIdentifier|; value, envRecord)
  }
}

sdo_row @sec-runtime-semantics-iteratorbindinginitialization#15 IteratorBindingInitialization form alg {
  prods [p"Syntactic - ArrowParameters : CoverParenthesizedExpressionAndArrowParameterList[?Yield, ?Await]"]
  keys ["ArrowParameters : CoverParenthesizedExpressionAndArrowParameterList"]
  vars [iteratorRecord, envRecord, formals]
  steps {
    let formals = $CoveredBy(|ArrowFormalParameters|, child 5 |CoverParenthesizedExpressionAndArrowParameterList|)
    return ? sdo IteratorBindingInitialization(formals; iteratorRecord, envRecord)
  }
}

sdo_row @sec-runtime-semantics-iteratorbindinginitialization#16 IteratorBindingInitialization form alg {
  prods [p"Syntactic - AsyncArrowBindingIdentifier : BindingIdentifier[?Yield, +Await]"]
  keys ["\n        AsyncArrowBindingIdentifier : BindingIdentifier\n      "]
  vars [iteratorRecord, envRecord, value, next]
  steps {
    let value = undefined
    assert iteratorRecord[[Done]] is val {false}
    let next = ? @sec-iteratorstepvalue(iteratorRecord)
    if next is not val {~done~} {
      set var value = next
    }
    return ? sdo BindingInitialization(child 5 |BindingIdentifier|; value, envRecord)
  }
}

