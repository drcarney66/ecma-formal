sdo_row @sec-static-semantics-contains#2 Contains form alg {
  prods [p"Syntactic 01 ClassTail : ClassHeritage[?Yield, ?Await]? `{` ClassBody[?Yield, ?Await]? `}`", p"Syntactic 11 ClassTail : ClassHeritage[?Yield, ?Await]? `{` ClassBody[?Yield, ?Await]? `}`"]
  keys ["ClassTail : ClassHeritage? `{` ClassBody `}`"]
  vars [symbol]
  steps {
    if symbol is val {|ClassBody|} -> return true
    if symbol is val {|ClassHeritage|} {
      if child 5 |ClassHeritage| sat $Present() -> return true
      return false
    }
    if child 5 |ClassHeritage| sat $Present() {
      if @ph-contains(child 5 |ClassHeritage|, ?symbol) is val {true} -> return true
    }
    return @ph-result-of(sdo ComputedPropertyContains(child 5 |ClassBody|; symbol))
  }
}

sdo_row @sec-static-semantics-contains#3 Contains form alg {
  prods [p"Syntactic - ClassStaticBlock : `static` `{` ClassStaticBlockBody `}`"]
  keys ["ClassStaticBlock : `static` `{` ClassStaticBlockBody `}`"]
  vars [symbol]
  steps {
    return false
  }
}

sdo_row @sec-static-semantics-contains#4 Contains form alg {
  prods [p"Syntactic - ArrowFunction : ArrowParameters[?Yield, ?Await] [no LineTerminator here] `=>` ConciseBody[?In]"]
  keys ["ArrowFunction : ArrowParameters `=>` ConciseBody"]
  vars [symbol]
  steps {
    if symbol is not val {|NewTarget|; |SuperProperty|; |SuperCall|; term "super"; term "this"} -> return false
    if @ph-contains(child 5 |ArrowParameters|, ?symbol) is val {true} -> return true
    return @ph-contains(child 5 |ConciseBody|, ?symbol)
  }
}

sdo_row @sec-static-semantics-contains#5 Contains form alg {
  prods [p"Syntactic - ArrowParameters : CoverParenthesizedExpressionAndArrowParameterList[?Yield, ?Await]"]
  keys ["ArrowParameters : CoverParenthesizedExpressionAndArrowParameterList"]
  vars [symbol, formals]
  steps {
    let formals = $CoveredBy(|ArrowFormalParameters|, child 5 |CoverParenthesizedExpressionAndArrowParameterList|)
    return @ph-contains(?formals, ?symbol)
  }
}

sdo_row @sec-static-semantics-contains#6 Contains form alg {
  prods [p"Syntactic - AsyncArrowFunction : `async` [no LineTerminator here] AsyncArrowBindingIdentifier[?Yield] [no LineTerminator here] `=>` AsyncConciseBody[?In]"]
  keys ["\n        AsyncArrowFunction : `async` AsyncArrowBindingIdentifier `=>` AsyncConciseBody\n      "]
  vars [symbol]
  steps {
    if symbol is not val {|NewTarget|; |SuperProperty|; |SuperCall|; term "super"; term "this"} -> return false
    return @ph-contains(child 5 |AsyncConciseBody|, ?symbol)
  }
}

sdo_row @sec-static-semantics-contains#7 Contains form alg {
  prods [p"Syntactic - AsyncArrowFunction : CoverCallExpressionAndAsyncArrowHead[?Yield, ?Await] [no LineTerminator here] `=>` AsyncConciseBody[?In]"]
  keys ["\n        AsyncArrowFunction : CoverCallExpressionAndAsyncArrowHead `=>` AsyncConciseBody\n      "]
  vars [symbol, head]
  steps {
    if symbol is not val {|NewTarget|; |SuperProperty|; |SuperCall|; term "super"; term "this"} -> return false
    let head = $CoveredBy(|AsyncArrowHead|, child 5 |CoverCallExpressionAndAsyncArrowHead|)
    if @ph-contains(?head, ?symbol) is val {true} -> return true
    return @ph-contains(child 5 |AsyncConciseBody|, ?symbol)
  }
}

