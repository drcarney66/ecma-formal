sdo_row @sec-static-semantics-assignmenttargettype#3 AssignmentTargetType form alg {
  prods [p"Syntactic - CallExpression : CoverCallExpressionAndAsyncArrowHead[?Yield, ?Await]", p"Syntactic - CallExpression : CallExpression[?Yield, ?Await] Arguments[?Yield, ?Await]"]
