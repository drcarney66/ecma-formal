  keys ["\n        Statement :\n          VariableStatement\n          EmptyStatement\n          ExpressionStatement\n          ContinueStatement\n          BreakStatement\n          ReturnStatement\n          ThrowStatement\n          DebuggerStatement\n\n        Block :\n          `{` `}`\n\n        StatementListItem :\n          Declaration\n      "]
