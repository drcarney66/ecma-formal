sdo_row @sec-runtime-semantics-namedevaluation NamedEvaluation form alg {
  prods [p"Syntactic - PrimaryExpression : CoverParenthesizedExpressionAndArrowParameterList[?Yield, ?Await]"]
  keys ["PrimaryExpression : CoverParenthesizedExpressionAndArrowParameterList"]
  vars [name, expr]
  steps {
    let expr = $CoveredBy(|ParenthesizedExpression|, child 5 |CoverParenthesizedExpressionAndArrowParameterList|)
    return ? sdo NamedEvaluation(expr; name)
  }
}

sdo_row @sec-runtime-semantics-namedevaluation#1 NamedEvaluation form alg {
  prods [p"Syntactic - ParenthesizedExpression : `(` Expression[+In, ?Yield, ?Await] `)`"]
  keys ["ParenthesizedExpression : `(` Expression `)`"]
  vars [name]
  steps {
    assert @sec-isanonymousfunctiondefinition(child 5 |Expression|) is val {true}
    return ? sdo NamedEvaluation(child 5 |Expression|; name)
  }
}

sdo_row @sec-runtime-semantics-namedevaluation#2 NamedEvaluation form alg {
