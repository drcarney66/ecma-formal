    if iteratorRecord[[Done]] is val {false} {
      let next = ? @sec-iteratorstepvalue(iteratorRecord)
      if next is not val {~done~} {
        set var value = next
      }
    }
    if child 5 |Initializer| sat $Present() and value is val {undefined} {
      let defaultValue = ? sdo Evaluation(child 5 |Initializer|)
      set var value = ? @sec-getvalue(defaultValue)
    }
    return ? sdo BindingInitialization(child 5 |BindingPattern|; value, envRecord)
  }
}

sdo_row @sec-runtime-semantics-iteratorbindinginitialization#9 IteratorBindingInitialization form alg {
  prods [p"Syntactic - BindingRestElement : `...` BindingIdentifier[?Yield, ?Await]"]
  keys ["BindingRestElement : `...` BindingIdentifier"]
  vars [iteratorRecord, envRecord, lhs, array, n, next]
  steps {
    let lhs = ? @sec-resolvebinding(sdo StringValue(child 5 |BindingIdentifier|), envRecord)
    let array = ! @sec-arraycreate(0)
    let n = 0
    repeat {
      let next = ~done~
      if iteratorRecord[[Done]] is val {false} {
        set var next = ? @sec-iteratorstepvalue(iteratorRecord)
      }
      if next is val {~done~} {
        if envRecord is val {undefined} -> return ? @sec-putvalue(lhs, array)
        return ? @sec-initializereferencedbinding(lhs, array)
      }
      perform ! @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(n)), next)
      set var n = n + 1
    }
  }
}

