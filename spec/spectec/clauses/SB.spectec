-- ECMA-262 SpecTec Clauses: SB

def @sec-runtime-semantics-characterrangeorunion-abstract-operation "CharacterRangeOrUnion" (kind ao params [regexpRecord : #"RegExp Record", charSet : CharSet, otherSet : CharSet] -> CharSet) vars [regexpRecord, charSet, otherSet, remainingSet] {
  if @sec-runtime-semantics-haseitherunicodeflag-abstract-operation(regexpRecord) is val {false} {
    if charSet sat @ph-not-exactly-one-character() or otherSet sat @ph-not-exactly-one-character() {
      let remainingSet = $CharSetOne(@ph-code-and-name(code "-", cp(45, "002D", "HYPHEN-MINUS")))
      return $CharSetUnionAll([charSet, otherSet, remainingSet])
    }
  }
  return @sec-runtime-semantics-characterrange-abstract-operation(charSet, otherSet)
}

def @sec-parsepattern-annexb "sec-parsepattern-annexb" (kind untyped params [patternText, u, v]) vars [patternText, u, v, parseResult] {
  if v is val {true} and u is val {true} {
    let parseResult = @ph-syntax-errors()
  }
  else_if v is val {true} {
    let parseResult = @sec-parsetext(patternText, |Pattern[+UnicodeMode, +UnicodeSetsMode, +NamedCaptureGroups]|)
  }
  else_if u is val {true} {
    let parseResult = @sec-parsetext(patternText, |Pattern[+UnicodeMode, ~UnicodeSetsMode, +NamedCaptureGroups]|)
  }
  else {
    let parseResult = @sec-parsetext(patternText, |Pattern[~UnicodeMode, ~UnicodeSetsMode, ~NamedCaptureGroups]|)
    if parseResult is ty {#"Parse Node"} and expr @ph-contains-cond(?parseResult, |GroupName|) {
      set var parseResult = @sec-parsetext(patternText, |Pattern[~UnicodeMode, ~UnicodeSetsMode, +NamedCaptureGroups]|)
    }
  }
  return parseResult
}

def @sec-escape-string "escape" (kind builtin params [string]) vars [#"this value", NewTarget, string, length, result, unescapedSet, k, codeUnit, nextPart, codeUnitNumber, #"hex"] {
  set var string = ? @sec-tostring(string)
  let length = $StrLen(?string)
  let result = $"the empty String"()
  let unescapedSet = $"string-concatenation"(@ph-ascii-word-characters(), "@*+-./")
  let k = 0
  repeat_while k < length {
    let codeUnit = $UnitAt(?k, ?string)
    if unescapedSet sat $Contains(?codeUnit) {
      let nextPart = codeUnit
    }
    else {
      let codeUnitNumber = $NumericValue(?codeUnit)
      if codeUnitNumber < 256 {
        let #"hex" = @ph-upper-hex(?codeUnitNumber)
        let nextPart = $"string-concatenation"("%", @sec-stringpad(#"hex", 2, "0", ~start~))
      }
      else {
        let #"hex" = @ph-upper-hex(?codeUnitNumber)
        let nextPart = $"string-concatenation"("%u", @sec-stringpad(#"hex", 4, "0", ~start~))
      }
    }
    set var result = $"string-concatenation"(result, nextPart)
    set var k = k + 1
  }
  return result
}

def @sec-unescape-string "unescape" (kind builtin params [string]) vars [#"this value", NewTarget, string, length, result, k, codeUnit, hexDigits, optionalAdvance, parseResult, codeUnitNumber] {
  set var string = ? @sec-tostring(string)
  let length = $StrLen(?string)
  let result = $"the empty String"()
  let k = 0
  repeat_while k < length {
    let codeUnit = $UnitAt(?k, ?string)
    if codeUnit is val {$CodeUnit(cu(37, "0025", "PERCENT SIGN"))} {
      let hexDigits = $"the empty String"()
      let optionalAdvance = 0
      if k + 5 < length and $UnitAt(k + 1, ?string) is val {$CodeUnit(cu(117, "0075", "LATIN SMALL LETTER U"))} {
        set var hexDigits = $Substring(?string, k + 2, k + 6)
        set var optionalAdvance = 5
      }
      else_if k + 3 <= length {
        set var hexDigits = $Substring(?string, k + 1, k + 3)
        set var optionalAdvance = 2
      }
      let parseResult = @sec-parsetext(hexDigits, |HexDigits[~Sep]|)
      if parseResult is ty {#"Parse Node"} {
        let codeUnitNumber = sdo MV(parseResult)
        set var codeUnit = $UnitOrPointOf(data choice 1, ?codeUnitNumber)
        set var k = k + optionalAdvance
      }
    }
    set var result = $"string-concatenation"(result, codeUnit)
    set var k = k + 1
  }
  return result
}

def @sec-string.prototype.substr "String.prototype.substr" (kind builtin params [start, length]) vars [#"this value", NewTarget, start, length, #"obj", string, size, intStart, intLength, intEnd] {
  let #"obj" = this_value
  perform ? @sec-requireobjectcoercible(#"obj")
  let string = ? @sec-tostring(#"obj")
  let size = $StrLen(?string)
  let intStart = ? @sec-toclampedindex(start, size)
  if_else length is val {undefined} { let intLength = size } else { let intLength = $clamping(? @sec-tointegerorinfinity(length), 0, ?size) }
  let intEnd = $min(intStart + intLength, size)
  return $Substring(?string, ?intStart, ?intEnd)
}

def @sec-string.prototype.anchor "String.prototype.anchor" (kind builtin params [name]) vars [#"this value", NewTarget, name, string] {
  let string = this_value
  return ? @sec-createhtml(string, "a", "name", name)
}

def @sec-createhtml "CreateHTML" (kind ao params [contents : #"ECMAScript language value", tag : String, attr : String, attrValue : #"ECMAScript language value"] -> completion<String> | #"throw completion") vars [contents, tag, attr, attrValue, contentsString, part1, attrValueString, escapedAttrValue, part2, part3, part4] {
  perform ? @sec-requireobjectcoercible(contents)
  let contentsString = ? @sec-tostring(contents)
  let part1 = $"string-concatenation"("<", tag)
  if attr is not val {$"the empty String"()} {
    let attrValueString = ? @sec-tostring(attrValue)
    let escapedAttrValue = @ph-code-unit-replaced(?attrValueString, $CodeUnit(cu(34, "0022", "QUOTATION MARK")), ?attrValueString, "&quot;")
    set var part1 = $"string-concatenation"(part1, $CodeUnit(cu(32, "0020", "SPACE")), attr, $CodeUnit(cu(61, "003D", "EQUALS SIGN")), $CodeUnit(cu(34, "0022", "QUOTATION MARK")), escapedAttrValue, $CodeUnit(cu(34, "0022", "QUOTATION MARK")))
  }
  let part2 = $"string-concatenation"(part1, ">")
  let part3 = $"string-concatenation"(part2, contentsString)
  let part4 = $"string-concatenation"(part3, "</", tag, ">")
  return part4
}

