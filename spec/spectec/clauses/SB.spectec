  }
}

sdo_row @sec-initializers-in-forin-statement-heads#3 IsDestructuring form alg annex {
  prods [p"Syntactic - BindingIdentifier : Identifier", p"Syntactic - BindingIdentifier : `yield`", p"Syntactic - BindingIdentifier : `await`"]
  keys ["\n        BindingIdentifier :\n          Identifier\n          `yield`\n          `await`\n      "]
