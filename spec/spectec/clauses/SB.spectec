def @sec-date.prototype.getyear "Date.prototype.getYear" (kind builtin params []) vars [#"this value", NewTarget, dateObj, tv] {
  let dateObj = this_value
  perform ? @sec-requireinternalslot(dateObj, [[DateValue]])
  let tv = dateObj[[DateValue]]
  if tv is val {nan} -> return nan
  return $𝔽(@sec-yearfromtime(@sec-localtime(tv))) - num_f(1900)
}

def @sec-date.prototype.setyear "Date.prototype.setYear" (kind builtin params [year]) vars [#"this value", NewTarget, year, dateObj, time, fullYear, day, date, utcTimestamp] {
  let dateObj = this_value
  perform ? @sec-requireinternalslot(dateObj, [[DateValue]])
  let time = dateObj[[DateValue]]
  if_else time is val {nan} { set var time = num_f(+0) } else { set var time = @sec-localtime(time) }
  let fullYear = @sec-makefullyear(? @sec-tonumber(year))
  let day = @sec-makeday(fullYear, $𝔽(@sec-monthfromtime(time)), $𝔽(@sec-datefromtime(time)))
  let date = @sec-makedate(day, $𝔽(@sec-timewithinday(time)))
  let utcTimestamp = @sec-timeclip(@sec-utc-t(date))
  set field dateObj[[DateValue]] = utcTimestamp
  return utcTimestamp
}

def @sec-regexp.prototype.compile "RegExp.prototype.compile" (kind builtin params [pattern, flags]) vars [#"this value", NewTarget, pattern, flags, #"obj"] {
  let #"obj" = this_value
  perform ? @sec-requireinternalslot(#"obj", [[RegExpMatcher]])
  if pattern is ty {Object} and pattern sat $HasSlot([[RegExpMatcher]]) {
    if flags is not val {undefined} -> throw @ph-new-error([[TypeError]])
    set var flags = pattern[[OriginalFlags]]
    set var pattern = pattern[[OriginalSource]]
  }
  return ? @sec-regexpinitialize(#"obj", pattern, flags)
}

sdo_row @sec-patterns-static-semantics-is-character-class-annexb IsCharacterClass form alg annex {
  prods [p"AnnexB - ClassAtomNoDash :: `\\` [lookahead == `c`]"]
  keys ["\n          ClassAtomNoDash :: `\\` [lookahead == `c`]\n        "]
  vars []
  steps {
    return false
  }
}

sdo_row @sec-patterns-static-semantics-character-value-annexb CharacterValue form alg annex {
  prods [p"AnnexB - ClassAtomNoDash :: `\\` [lookahead == `c`]"]
  keys ["\n          ClassAtomNoDash :: `\\` [lookahead == `c`]\n        "]
  vars []
  steps {
    return $NumericValue(cp(92, "005C", "REVERSE SOLIDUS"))
  }
}

sdo_row @sec-patterns-static-semantics-character-value-annexb#1 CharacterValue form alg annex {
  prods [p"AnnexB - ClassEscape :: [~UnicodeMode] `c` ClassControlLetter"]
  keys ["ClassEscape :: `c` ClassControlLetter"]
  vars [codePoint, i]
  steps {
    let codePoint = $CodePointMatched(child 5 |ClassControlLetter|)
    let i = $NumericValue(?codePoint)
    return $Remainder(?i, 32)
  }
}

sdo_row @sec-patterns-static-semantics-character-value-annexb#2 CharacterValue form alg annex {
  prods [p"AnnexB - CharacterEscape :: [~UnicodeMode] LegacyOctalEscapeSequence"]
  keys ["CharacterEscape :: LegacyOctalEscapeSequence"]
  vars []
  steps {
    return sdo MV(child 5 |LegacyOctalEscapeSequence|)
  }
}

sdo_row @sec-compileatom-annexb CompileAtom form alg annex {
  prods [p"AnnexB - ExtendedAtom :: `\\` [lookahead == `c`]"]
  keys ["ExtendedAtom :: `\\` [lookahead == `c`]"]
  vars [regexpRecord, direction, charSet]
  steps {
    let charSet = $CharSetOne(@ph-code-and-name(code "\\", cp(92, "005C", "REVERSE SOLIDUS")))
    return @sec-runtime-semantics-charactersetmatcher-abstract-operation(regexpRecord, charSet, false, direction)
  }
}

sdo_row @sec-compileatom-annexb#1 CompileAtom form alg annex {
  prods [p"AnnexB - ExtendedAtom :: ExtendedPatternCharacter"]
  keys ["ExtendedAtom :: ExtendedPatternCharacter"]
  vars [regexpRecord, direction, char, charSet]
  steps {
    let char = @ph-character-of-node(data choice 1, child 5 |ExtendedPatternCharacter|)
    let charSet = $CharSetOne(?char)
    return @sec-runtime-semantics-charactersetmatcher-abstract-operation(regexpRecord, charSet, false, direction)
  }
}

sdo_row @sec-compiletocharset-annexb CompileToCharSet form alg annex {
  prods [p"RegExp - NonemptyClassRanges :: ClassAtom[?UnicodeMode] `-` ClassAtom[?UnicodeMode] ClassContents[?UnicodeMode, ~UnicodeSetsMode]"]
  keys ["NonemptyClassRanges :: ClassAtom `-` ClassAtom ClassContents"]
  vars [regexpRecord, charSet, otherSet, remainingSet, rangeSet]
  steps {
    let charSet = sdo CompileToCharSet(child 0 |ClassAtom|; regexpRecord)
    let otherSet = sdo CompileToCharSet(child 1 |ClassAtom|; regexpRecord)
    let remainingSet = sdo CompileToCharSet(child 5 |ClassContents|; regexpRecord)
    let rangeSet = @sec-runtime-semantics-characterrangeorunion-abstract-operation(regexpRecord, charSet, otherSet)
    return $CharSetUnionAll([rangeSet, remainingSet])
  }
}

sdo_row @sec-compiletocharset-annexb#1 CompileToCharSet form alg annex {
  prods [p"RegExp - NonemptyClassRangesNoDash :: ClassAtomNoDash[?UnicodeMode] `-` ClassAtom[?UnicodeMode] ClassContents[?UnicodeMode, ~UnicodeSetsMode]"]
  keys ["NonemptyClassRangesNoDash :: ClassAtomNoDash `-` ClassAtom ClassContents"]
  vars [regexpRecord, charSet, otherSet, remainingSet, rangeSet]
  steps {
    let charSet = sdo CompileToCharSet(child 5 |ClassAtomNoDash|; regexpRecord)
    let otherSet = sdo CompileToCharSet(child 5 |ClassAtom|; regexpRecord)
    let remainingSet = sdo CompileToCharSet(child 5 |ClassContents|; regexpRecord)
    let rangeSet = @sec-runtime-semantics-characterrangeorunion-abstract-operation(regexpRecord, charSet, otherSet)
    return $CharSetUnionAll([rangeSet, remainingSet])
  }
}

sdo_row @sec-compiletocharset-annexb#2 CompileToCharSet form alg annex {
  prods [p"AnnexB - ClassEscape :: [~UnicodeMode] `c` ClassControlLetter"]
  keys ["ClassEscape :: `c` ClassControlLetter"]
  vars [regexpRecord, charValue, char]
  steps {
    let charValue = sdo CharacterValue(call_at @ph-this-nt(|ClassEscape|))
    let char = $Char(?charValue)
    return $CharSetOne(?char)
  }
}

sdo_row @sec-compiletocharset-annexb#3 CompileToCharSet form alg annex {
  prods [p"AnnexB - ClassAtomNoDash :: `\\` [lookahead == `c`]"]
  keys ["ClassAtomNoDash :: `\\` [lookahead == `c`]"]
  vars [regexpRecord]
  steps {
    return $CharSetOne(@ph-code-and-name(code "\\", cp(92, "005C", "REVERSE SOLIDUS")))
  }
}

sdo_row @sec-initializers-in-forin-statement-heads ContainsDuplicateLabels form alg annex {
  prods [p"AnnexB - ForInOfStatement : `for` `(` `var` BindingIdentifier[?Yield, ?Await] Initializer[~In, ?Yield, ?Await] `in` Expression[+In, ?Yield, ?Await] `)` Statement[?Yield, ?Await, ?Return]"]
  keys ["ForInOfStatement : `for` `(` `var` BindingIdentifier Initializer `in` Expression `)` Statement"]
  vars [labelSet]
  steps {
    return sdo ContainsDuplicateLabels(child 5 |Statement|; labelSet)
  }
}

