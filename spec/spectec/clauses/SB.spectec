  }
}

sdo_row @sec-initializers-in-forin-statement-heads#4 VarDeclaredNames form alg annex {
  prods [p"AnnexB - ForInOfStatement : `for` `(` `var` BindingIdentifier[?Yield, ?Await] Initializer[~In, ?Yield, ?Await] `in` Expression[+In, ?Yield, ?Await] `)` Statement[?Yield, ?Await, ?Return]"]
  keys ["ForInOfStatement : `for` `(` `var` BindingIdentifier Initializer `in` Expression `)` Statement"]
  vars [names1, names2]
  steps {
    let names1 = sdo BoundNames(child 5 |BindingIdentifier|)
    let names2 = sdo VarDeclaredNames(child 5 |Statement|)
    return $ListConcat([names1, names2])
  }
}

sdo_row @sec-initializers-in-forin-statement-heads#5 VarScopedDeclarations form alg annex {
  prods [p"AnnexB - ForInOfStatement : `for` `(` `var` BindingIdentifier[?Yield, ?Await] Initializer[~In, ?Yield, ?Await] `in` Expression[+In, ?Yield, ?Await] `)` Statement[?Yield, ?Await, ?Return]"]
  keys ["ForInOfStatement : `for` `(` `var` BindingIdentifier Initializer `in` Expression `)` Statement"]
  vars [decls1, decls2]
  steps {
    let decls1 = [child 5 |BindingIdentifier|]
    let decls2 = sdo VarScopedDeclarations(child 5 |Statement|)
    return $ListConcat([decls1, decls2])
  }
}

sdo_row @sec-initializers-in-forin-statement-heads#6 ForInOfLoopEvaluation form alg annex {
  prods [p"AnnexB - ForInOfStatement : `for` `(` `var` BindingIdentifier[?Yield, ?Await] Initializer[~In, ?Yield, ?Await] `in` Expression[+In, ?Yield, ?Await] `)` Statement[?Yield, ?Await, ?Return]"]
  keys ["ForInOfStatement : `for` `(` `var` BindingIdentifier Initializer `in` Expression `)` Statement"]
  vars [labelSet, name, lhs, value, rhs, keyResult]
  steps {
    let name = sdo StringValue(child 5 |BindingIdentifier|)
    let lhs = ? @sec-resolvebinding(name)
    if @sec-isanonymousfunctiondefinition(child 5 |Initializer|) is val {true} {
      let value = ? sdo NamedEvaluation(child 5 |Initializer|; name)
    }
    else {
      let rhs = ? sdo Evaluation(child 5 |Initializer|)
      let value = ? @sec-getvalue(rhs)
    }
    perform ? @sec-putvalue(lhs, value)
    let keyResult = ? @sec-runtime-semantics-forinofheadevaluation([], child 5 |Expression|, ~enumerate~)
    return ? @sec-runtime-semantics-forin-div-ofbodyevaluation-lhs-stmt-iterator-lhskind-labelset(child 5 |BindingIdentifier|, child 5 |Statement|, keyResult, ~enumerate~, ~var-binding~, labelSet)
  }
}

