-- ECMA-262 SpecTec Clauses: S25

def @sec-allocatearraybuffer "AllocateArrayBuffer" (kind ao params [ctor : constructor, byteLength : sort [#"non-negative"] integer, maxByteLength : sort [#"non-negative"] integer | val(~empty~) opt] -> completion<ArrayBuffer> | #"throw completion") vars [ctor, byteLength, maxByteLength, #"slots", allocatingResizableBuffer, #"obj", #"block"] {
  let #"slots" = [[[ArrayBufferData]], [[ArrayBufferByteLength]], [[ArrayBufferDetachKey]]]
  if_else maxByteLength sat $Present() and maxByteLength is not val {~empty~} { let allocatingResizableBuffer = true } else { let allocatingResizableBuffer = false }
  if allocatingResizableBuffer is val {true} {
    if byteLength > maxByteLength -> throw @ph-new-error([[RangeError]])
    perform $Append([[ArrayBufferMaxByteLength]], ?#"slots")
  }
  let #"obj" = ? @sec-ordinarycreatefromconstructor(ctor, "%ArrayBuffer.prototype%", #"slots")
  let #"block" = ? @sec-createbytedatablock(byteLength)
  set field #"obj"[[ArrayBufferData]] = #"block"
  set field #"obj"[[ArrayBufferByteLength]] = byteLength
  set field #"obj"[[ArrayBufferDetachKey]] = ~empty~
  if allocatingResizableBuffer is val {true} {
    if $CanAllocate(maxByteLength, false) is val {false} -> throw @ph-new-error([[RangeError]])
    note "Resizable ArrayBuffers are designed to be implementable with in-place growth. Implementations may throw if, for example, virtual memory cannot be reserved up front."
    set field #"obj"[[ArrayBufferMaxByteLength]] = maxByteLength
  }
  return #"obj"
}

def @sec-arraybufferbytelength "ArrayBufferByteLength" (kind ao params [arrayBuffer : ArrayBuffer | SharedArrayBuffer, #"order" : val(~seq-cst~) | val(~unordered~)] -> sort [#"non-negative"] integer) vars [arrayBuffer, #"order", bufferByteLengthBlock, rawLength, agentRecord, isLittleEndian] {
  if @sec-isgrowablesharedarraybuffer(arrayBuffer) is val {true} {
    let bufferByteLengthBlock = arrayBuffer[[ArrayBufferByteLengthData]]
    let rawLength = @sec-getrawbytesfromsharedblock(bufferByteLengthBlock, 0, ~biguint64~, true, #"order")
    let agentRecord = $AgentRecord()
    let isLittleEndian = agentRecord[[LittleEndian]]
    return $ℝ(@sec-rawbytestonumeric(~biguint64~, rawLength, isLittleEndian))
  }
  assert @sec-isdetachedbuffer(arrayBuffer) is val {false}
  return arrayBuffer[[ArrayBufferByteLength]]
}

def @sec-arraybuffercopyanddetach "ArrayBufferCopyAndDetach" (kind ao params [arrayBuffer : #"ECMAScript language value", newLength : #"ECMAScript language value", preserveResizability : val(~preserve-resizability~) | val(~fixed-length~)] -> completion<ArrayBuffer> | #"throw completion") vars [arrayBuffer, newLength, preserveResizability, newByteLength, newMaxByteLength, newBuffer, copyLength, fromBlock, toBlock] {
  perform ? @sec-requireinternalslot(arrayBuffer, [[ArrayBufferData]])
  if @sec-issharedarraybuffer(arrayBuffer) is val {true} -> throw @ph-new-error([[TypeError]])
  if newLength is val {undefined} {
    let newByteLength = arrayBuffer[[ArrayBufferByteLength]]
  }
  else {
    let newByteLength = ? @sec-toindex(newLength)
  }
  if @sec-isdetachedbuffer(arrayBuffer) is val {true} -> throw @ph-new-error([[TypeError]])
  if preserveResizability is val {~preserve-resizability~} and @sec-isfixedlengtharraybuffer(arrayBuffer) is val {false} {
    let newMaxByteLength = arrayBuffer[[ArrayBufferMaxByteLength]]
  }
  else {
    let newMaxByteLength = ~empty~
  }
  if arrayBuffer[[ArrayBufferDetachKey]] is not val {~empty~} -> throw @ph-new-error([[TypeError]])
  let newBuffer = ? @sec-allocatearraybuffer(intrinsic [[ArrayBuffer]], newByteLength, newMaxByteLength)
  let copyLength = $min(newByteLength, arrayBuffer[[ArrayBufferByteLength]])
  let fromBlock = arrayBuffer[[ArrayBufferData]]
  let toBlock = newBuffer[[ArrayBufferData]]
  perform @sec-copydatablockbytes(toBlock, 0, fromBlock, 0, copyLength)
  note "Neither creation of the new Data Block nor copying from the old Data Block are observable. Implementations may implement this method as a zero-copy move or a `realloc`."
  perform ! @sec-detacharraybuffer(arrayBuffer)
  return newBuffer
}

def @sec-isdetachedbuffer "IsDetachedBuffer" (kind ao params [arrayBuffer : ArrayBuffer | SharedArrayBuffer] -> Boolean) vars [arrayBuffer] {
  if arrayBuffer[[ArrayBufferData]] is val {null} -> return true
  return false
}

def @sec-detacharraybuffer "DetachArrayBuffer" (kind ao params [arrayBuffer : ArrayBuffer, key : #"ECMAScript language value" opt] -> completion<val(~unused~)> | #"throw completion") vars [arrayBuffer, key, expectedKey] {
  assert @sec-issharedarraybuffer(arrayBuffer) is val {false}
  let expectedKey = arrayBuffer[[ArrayBufferDetachKey]]
  if key sat $Present() {
    if expectedKey is val {~empty~} or @sec-samevalue(key, expectedKey) is val {false} -> throw @ph-new-error([[TypeError]])
  }
  else {
    if expectedKey is not val {~empty~} -> throw @ph-new-error([[TypeError]])
  }
  set field arrayBuffer[[ArrayBufferData]] = null
  set field arrayBuffer[[ArrayBufferByteLength]] = 0
  return ~unused~
}

def @sec-clonearraybuffer "CloneArrayBuffer" (kind ao params [sourceBuffer : ArrayBuffer | SharedArrayBuffer, sourceByteOffset : sort [#"non-negative"] integer, sourceLength : sort [#"non-negative"] integer] -> completion<ArrayBuffer> | #"throw completion") vars [sourceBuffer, sourceByteOffset, sourceLength, targetBuffer, sourceBlock, targetBlock] {
  assert @sec-isdetachedbuffer(sourceBuffer) is val {false}
  let targetBuffer = ? @sec-allocatearraybuffer(intrinsic [[ArrayBuffer]], sourceLength)
  let sourceBlock = sourceBuffer[[ArrayBufferData]]
  let targetBlock = targetBuffer[[ArrayBufferData]]
  perform @sec-copydatablockbytes(targetBlock, 0, sourceBlock, sourceByteOffset, sourceLength)
  return targetBuffer
}

def @sec-getarraybuffermaxbytelengthoption "GetArrayBufferMaxByteLengthOption" (kind ao params [options : #"ECMAScript language value"] -> completion<sort [#"non-negative"] integer | val(~empty~)> | #"throw completion") vars [options, maxByteLength] {
  if options is not ty {Object} -> return ~empty~
  let maxByteLength = ? @sec-get-o-p(options, "maxByteLength")
  if maxByteLength is val {undefined} -> return ~empty~
  return ? @sec-toindex(maxByteLength)
}

def @sec-isfixedlengtharraybuffer "IsFixedLengthArrayBuffer" (kind ao params [arrayBuffer : ArrayBuffer | SharedArrayBuffer] -> Boolean) vars [arrayBuffer] {
  if arrayBuffer sat $HasSlot([[ArrayBufferMaxByteLength]]) -> return false
  return true
}

def @sec-isunsignedelementtype "IsUnsignedElementType" (kind ao params [type : #"TypedArray element type"] -> Boolean) vars [type] {
  if type is val {~uint8~; ~uint8clamped~; ~uint16~; ~uint32~; ~biguint64~} -> return true
  return false
}

def @sec-isunclampedintegerelementtype "IsUnclampedIntegerElementType" (kind ao params [type : #"TypedArray element type"] -> Boolean) vars [type] {
  if type is val {~int8~; ~uint8~; ~int16~; ~uint16~; ~int32~; ~uint32~} -> return true
  return false
}

def @sec-isbigintelementtype "IsBigIntElementType" (kind ao params [type : #"TypedArray element type"] -> Boolean) vars [type] {
  if type is val {~biguint64~; ~bigint64~} -> return true
  return false
}

def @sec-isnotearconfiguration "IsNoTearConfiguration" (kind ao params [type : #"TypedArray element type", #"order" : val(~seq-cst~) | val(~unordered~) | val(~init~)] -> Boolean) vars [type, #"order"] {
  if @sec-isunclampedintegerelementtype(type) is val {true} -> return true
  if @sec-isbigintelementtype(type) is val {true} and #"order" is val {~seq-cst~} -> return true
  return false
}

def @sec-rawbytestonumeric "RawBytesToNumeric" (kind ao params [type : #"TypedArray element type", rawBytes : list<#"byte value">, isLittleEndian : Boolean] -> Number | BigInt) vars [type, rawBytes, isLittleEndian, elementSize, value, intValue] {
  let elementSize = $TableLookup(table t"table-the-typedarray-constructors", code "Element Size", code "Element Type", ?type)
  if isLittleEndian is val {false} -> perform $Reverse(?rawBytes)
  if type is val {~float16~} {
    let value = @ph-bytes-decode-binary16(?rawBytes)
    if value is ty {NaN} -> return nan
    return $NumberFor(data choice 0, ?value)
  }
  if type is val {~float32~} {
    let value = @ph-bytes-decode-binary32(?rawBytes)
    if value is ty {NaN} -> return nan
    return $NumberFor(data choice 0, ?value)
  }
  if type is val {~float64~} {
    let value = @ph-bytes-decode-binary64(?rawBytes)
    if value is ty {NaN} -> return nan
    return $NumberFor(data choice 0, ?value)
  }
  if @sec-isunsignedelementtype(type) is val {true} {
    let intValue = @ph-bytes-decode-unsigned(?rawBytes)
  }
  else {
    let intValue = @ph-bytes-decode-signed(?rawBytes, elementSize * 8)
  }
  if @sec-isbigintelementtype(type) is val {true} -> return $NumberFor(data choice 1, ?intValue)
  return $NumberFor(data choice 0, ?intValue)
}

def @sec-getrawbytesfromsharedblock "GetRawBytesFromSharedBlock" (kind ao params [#"block" : #"Shared Data Block", byteIndex : sort [#"non-negative"] integer, type : #"TypedArray element type", isTypedArray : Boolean, #"order" : val(~seq-cst~) | val(~unordered~)] -> list<#"byte value">) vars [#"block", byteIndex, type, isTypedArray, #"order", elementSize, agentRecord, execution, eventsRecord, noTear, rawValue, readEvent] {
  let elementSize = $TableLookup(table t"table-the-typedarray-constructors", code "Element Size", code "Element Type", ?type)
  let agentRecord = $AgentRecord()
  let execution = agentRecord[[CandidateExecution]]
  let eventsRecord = $ListFind([[AgentSignifier]], execution[[EventsRecords]], @sec-agentsignifier())
  if_else isTypedArray is val {true} and @sec-isnotearconfiguration(type, #"order") is val {true} { let noTear = true } else { let noTear = false }
  if $ListLen(execution[[EventsRecords]]) is val {1} {
    let rawValue = @formal-singleagentreadbytes(execution, eventsRecord, #"block", byteIndex, elementSize)
  }
  else {
    if $EnteredCriticalSections() sat $IsEmpty() -> perform @formal-agent-interleave()
    let rawValue = @formal-choosesharedbytes(execution, eventsRecord, #"block", byteIndex, elementSize)
  }
  note "In implementations, _rawValue_ is the result of a non-atomic or atomic read instruction on the underlying hardware. The nondeterminism is a semantic prescription of the memory model to describe observable behaviour of hardware with weak consistency."
  let readEvent = record ReadSharedMemory { [[Order]]: #"order", [[NoTear]]: noTear, [[Block]]: #"block", [[ByteIndex]]: byteIndex, [[ElementSize]]: elementSize }
  perform $Append(?readEvent, eventsRecord[[EventList]])
  perform $Append(record #"Chosen Value Record" { [[Event]]: readEvent, [[ChosenValue]]: rawValue }, execution[[ChosenValues]])
  return rawValue
}

def @sec-getvaluefrombuffer "GetValueFromBuffer" (kind ao params [arrayBuffer : ArrayBuffer | SharedArrayBuffer, byteIndex : sort [#"non-negative"] integer, type : #"TypedArray element type", isTypedArray : Boolean, #"order" : val(~seq-cst~) | val(~unordered~), isLittleEndian : Boolean opt] -> Number | BigInt) vars [arrayBuffer, byteIndex, type, isTypedArray, #"order", isLittleEndian, #"block", elementSize, rawValue, agentRecord] {
  assert @sec-isdetachedbuffer(arrayBuffer) is val {false}
  assert expr @ph-sufficient-bytes(?arrayBuffer, ?byteIndex, ?type)
  let #"block" = arrayBuffer[[ArrayBufferData]]
  let elementSize = $TableLookup(table t"table-the-typedarray-constructors", code "Element Size", code "Element Type", ?type)
  if @sec-issharedarraybuffer(arrayBuffer) is val {true} {
    assert #"block" is ty {#"Shared Data Block"}
    let rawValue = @sec-getrawbytesfromsharedblock(#"block", byteIndex, type, isTypedArray, #"order")
  }
  else {
    let rawValue = @ph-block-bytes(?#"block", ?byteIndex, byteIndex + elementSize)
  }
  assert $ListLen(?rawValue) is val {elementSize}
  if isLittleEndian fails $Present() {
    let agentRecord = $AgentRecord()
    set var isLittleEndian = agentRecord[[LittleEndian]]
  }
  return @sec-rawbytestonumeric(type, rawValue, isLittleEndian)
}

def @sec-numerictorawbytes "NumericToRawBytes" (kind ao params [type : #"TypedArray element type", value : Number | BigInt, isLittleEndian : Boolean] -> list<#"byte value">) vars [type, value, isLittleEndian, rawBytes, n, conversionOperation, intValue] {
  if type is val {~float16~} {
    let rawBytes = @formal-littleendianbytes(@formal-ieeebits(@ph-to-binary16(?value, data choice 0), 5, 11), 2)
  }
  else_if type is val {~float32~} {
    let rawBytes = @formal-littleendianbytes(@formal-ieeebits(@ph-to-binary32(?value, data choice 0), 8, 24), 4)
  }
  else_if type is val {~float64~} {
    let rawBytes = @formal-littleendianbytes(@formal-ieeebits(value, 11, 53), 8)
  }
  else {
    let n = $TableLookup(table t"table-the-typedarray-constructors", code "Element Size", code "Element Type", ?type)
    let conversionOperation = $TableLookup(table t"table-the-typedarray-constructors", code "Conversion Operation", code "Element Type", ?type)
    let intValue = $ℝ(! conversionOperation(value))
    if intValue >= 0 {
      let rawBytes = @formal-littleendianbytes(intValue, n)
    }
    else {
      let rawBytes = @formal-littleendianbytes(intValue modulo 2 ^ {8 * n}, n)
    }
  }
  if isLittleEndian is val {false} -> perform $Reverse(?rawBytes)
  return rawBytes
}

def @sec-setvalueinbuffer "SetValueInBuffer" (kind ao params [arrayBuffer : ArrayBuffer | SharedArrayBuffer, byteIndex : sort [#"non-negative"] integer, type : #"TypedArray element type", value : Number | BigInt, isTypedArray : Boolean, #"order" : val(~seq-cst~) | val(~unordered~) | val(~init~), isLittleEndian : Boolean opt] -> val(~unused~)) vars [arrayBuffer, byteIndex, type, value, isTypedArray, #"order", isLittleEndian, #"block", elementSize, agentRecord, rawBytes, execution, eventsRecord, noTear] {
  assert @sec-isdetachedbuffer(arrayBuffer) is val {false}
  assert expr @ph-sufficient-bytes(?arrayBuffer, ?byteIndex, ?type)
  if @sec-isbigintelementtype(type) is val {true} {
    assert value is ty {BigInt}
  }
  else {
    assert value is ty {Number}
  }
  let #"block" = arrayBuffer[[ArrayBufferData]]
  let elementSize = $TableLookup(table t"table-the-typedarray-constructors", code "Element Size", code "Element Type", ?type)
  let agentRecord = $AgentRecord()
  if isLittleEndian fails $Present() {
    set var isLittleEndian = agentRecord[[LittleEndian]]
  }
  let rawBytes = @sec-numerictorawbytes(type, value, isLittleEndian)
  if @sec-issharedarraybuffer(arrayBuffer) is val {true} {
    let execution = agentRecord[[CandidateExecution]]
    let eventsRecord = $ListFind([[AgentSignifier]], execution[[EventsRecords]], @sec-agentsignifier())
    if_else isTypedArray is val {true} and @sec-isnotearconfiguration(type, #"order") is val {true} { let noTear = true } else { let noTear = false }
    perform $Append(record WriteSharedMemory { [[Order]]: #"order", [[NoTear]]: noTear, [[Block]]: #"block", [[ByteIndex]]: byteIndex, [[ElementSize]]: elementSize, [[Payload]]: rawBytes }, eventsRecord[[EventList]])
  }
  else {
    perform $StoreBytes(?rawBytes, ?#"block", ?byteIndex)
  }
  return ~unused~
}

def @sec-getmodifysetvalueinbuffer "GetModifySetValueInBuffer" (kind ao params [arrayBuffer : ArrayBuffer | SharedArrayBuffer, byteIndex : sort [#"non-negative"] integer, type : #"TypedArray element type", value : Number | BigInt, #"op" : #"read-modify-write modification function"] -> Number | BigInt) vars [arrayBuffer, byteIndex, type, value, #"op", #"block", elementSize, agentRecord, isLittleEndian, rawBytes, execution, eventsRecord, rawBytesRead, rmwEvent, rawBytesModified] {
  assert @sec-isdetachedbuffer(arrayBuffer) is val {false}
  assert expr @ph-sufficient-bytes(?arrayBuffer, ?byteIndex, ?type)
  if @sec-isbigintelementtype(type) is val {true} {
    assert value is ty {BigInt}
  }
  else {
    assert value is ty {Number}
  }
  let #"block" = arrayBuffer[[ArrayBufferData]]
  let elementSize = $TableLookup(table t"table-the-typedarray-constructors", code "Element Size", code "Element Type", ?type)
  let agentRecord = $AgentRecord()
  let isLittleEndian = agentRecord[[LittleEndian]]
  let rawBytes = @sec-numerictorawbytes(type, value, isLittleEndian)
  if @sec-issharedarraybuffer(arrayBuffer) is val {true} {
    let execution = agentRecord[[CandidateExecution]]
    let eventsRecord = $ListFind([[AgentSignifier]], execution[[EventsRecords]], @sec-agentsignifier())
    if $ListLen(execution[[EventsRecords]]) is val {1} {
      let rawBytesRead = @formal-singleagentreadbytes(execution, eventsRecord, #"block", byteIndex, elementSize)
    }
    else {
      if $EnteredCriticalSections() sat $IsEmpty() -> perform @formal-agent-interleave()
      let rawBytesRead = @formal-choosesharedbytes(execution, eventsRecord, #"block", byteIndex, elementSize)
    }
    note "In implementations, _rawBytesRead_ is the result of a load-link, of a load-exclusive, or of an operand of a read-modify-write instruction on the underlying hardware. The nondeterminism is a semantic prescription of the memory model to describe observable behaviour of hardware with weak consistency."
    let rmwEvent = record ReadModifyWriteSharedMemory { [[Order]]: ~seq-cst~, [[NoTear]]: true, [[Block]]: #"block", [[ByteIndex]]: byteIndex, [[ElementSize]]: elementSize, [[Payload]]: rawBytes, [[ModifyOp]]: #"op" }
    perform $Append(?rmwEvent, eventsRecord[[EventList]])
    perform $Append(record #"Chosen Value Record" { [[Event]]: rmwEvent, [[ChosenValue]]: rawBytesRead }, execution[[ChosenValues]])
  }
  else {
    let rawBytesRead = @ph-list-of-length(?elementSize, @ph-bytes-from(?elementSize, ?#"block", ?byteIndex))
    let rawBytesModified = #"op"(rawBytesRead, rawBytes)
    perform $StoreBytes(?rawBytesModified, ?#"block", ?byteIndex)
  }
  return @sec-rawbytestonumeric(type, rawBytesRead, isLittleEndian)
}

def @sec-arraybuffer-length "ArrayBuffer" (kind builtin params [length, options opt]) vars [#"this value", NewTarget, length, options, byteLength, requestedMaxByteLength] {
  if new_target is val {undefined} -> throw @ph-new-error([[TypeError]])
  let byteLength = ? @sec-toindex(length)
  let requestedMaxByteLength = ? @sec-getarraybuffermaxbytelengthoption(options)
  return ? @sec-allocatearraybuffer(new_target, byteLength, requestedMaxByteLength)
}

def @sec-arraybuffer.isview "ArrayBuffer.isView" (kind builtin params [arg]) vars [#"this value", NewTarget, arg] {
  if arg is not ty {Object} -> return false
  if arg sat $HasSlot([[ViewedArrayBuffer]]) -> return true
  return false
}

def @sec-get-arraybuffer-%symbol.species% "get ArrayBuffer [ %Symbol.species% ]" (kind builtin params []) vars [#"this value", NewTarget] {
  return this_value
}

def @sec-get-arraybuffer.prototype.bytelength "get ArrayBuffer.prototype.byteLength" (kind builtin params []) vars [#"this value", NewTarget, #"obj", length] {
  let #"obj" = this_value
  perform ? @sec-requireinternalslot(#"obj", [[ArrayBufferData]])
  if @sec-issharedarraybuffer(#"obj") is val {true} -> throw @ph-new-error([[TypeError]])
  if @sec-isdetachedbuffer(#"obj") is val {true} -> return num_f(+0)
  let length = #"obj"[[ArrayBufferByteLength]]
  return $𝔽(length)
}

def @sec-get-arraybuffer.prototype.detached "get ArrayBuffer.prototype.detached" (kind builtin params []) vars [#"this value", NewTarget, #"obj"] {
  let #"obj" = this_value
  perform ? @sec-requireinternalslot(#"obj", [[ArrayBufferData]])
  if @sec-issharedarraybuffer(#"obj") is val {true} -> throw @ph-new-error([[TypeError]])
  return @sec-isdetachedbuffer(#"obj")
}

def @sec-get-arraybuffer.prototype.maxbytelength "get ArrayBuffer.prototype.maxByteLength" (kind builtin params []) vars [#"this value", NewTarget, #"obj", length] {
  let #"obj" = this_value
  perform ? @sec-requireinternalslot(#"obj", [[ArrayBufferData]])
  if @sec-issharedarraybuffer(#"obj") is val {true} -> throw @ph-new-error([[TypeError]])
  if @sec-isdetachedbuffer(#"obj") is val {true} -> return num_f(+0)
  if @sec-isfixedlengtharraybuffer(#"obj") is val {true} {
    let length = #"obj"[[ArrayBufferByteLength]]
  }
  else {
    let length = #"obj"[[ArrayBufferMaxByteLength]]
  }
  return $𝔽(length)
}

def @sec-get-arraybuffer.prototype.resizable "get ArrayBuffer.prototype.resizable" (kind builtin params []) vars [#"this value", NewTarget, #"obj"] {
  let #"obj" = this_value
  perform ? @sec-requireinternalslot(#"obj", [[ArrayBufferData]])
  if @sec-issharedarraybuffer(#"obj") is val {true} -> throw @ph-new-error([[TypeError]])
  if @sec-isfixedlengtharraybuffer(#"obj") is val {false} -> return true
  return false
}

def @sec-arraybuffer.prototype.resize "ArrayBuffer.prototype.resize" (kind builtin params [newLength]) vars [#"this value", NewTarget, newLength, #"obj", newByteLength, hostHandled, oldBlock, newBlock, copyLength] {
  let #"obj" = this_value
  perform ? @sec-requireinternalslot(#"obj", [[ArrayBufferMaxByteLength]])
  if @sec-issharedarraybuffer(#"obj") is val {true} -> throw @ph-new-error([[TypeError]])
  let newByteLength = ? @sec-toindex(newLength)
  if @sec-isdetachedbuffer(#"obj") is val {true} -> throw @ph-new-error([[TypeError]])
  if newByteLength > #"obj"[[ArrayBufferMaxByteLength]] -> throw @ph-new-error([[RangeError]])
  let hostHandled = ? @sec-hostresizearraybuffer(#"obj", newByteLength)
  if hostHandled is val {~handled~} -> return undefined
  let oldBlock = #"obj"[[ArrayBufferData]]
  let newBlock = ? @sec-createbytedatablock(newByteLength)
  let copyLength = $min(newByteLength, #"obj"[[ArrayBufferByteLength]])
  perform @sec-copydatablockbytes(newBlock, 0, oldBlock, 0, copyLength)
  note "Neither creation of the new Data Block nor copying from the old Data Block are observable. Implementations may implement this method as in-place growth or shrinkage."
  set field #"obj"[[ArrayBufferData]] = newBlock
  set field #"obj"[[ArrayBufferByteLength]] = newByteLength
  return undefined
}

def @sec-arraybuffer.prototype.slice "ArrayBuffer.prototype.slice" (kind builtin params [start, end]) vars [#"this value", NewTarget, start, end, #"obj", length, first, final, newLength, ctor, #"new", fromBlock, toBlock, currentLength, maxCount, count] {
  let #"obj" = this_value
  perform ? @sec-requireinternalslot(#"obj", [[ArrayBufferData]])
  if @sec-issharedarraybuffer(#"obj") is val {true} -> throw @ph-new-error([[TypeError]])
  if @sec-isdetachedbuffer(#"obj") is val {true} -> throw @ph-new-error([[TypeError]])
  let length = #"obj"[[ArrayBufferByteLength]]
  let first = ? @sec-toclampedindex(start, length)
  if_else end is val {undefined} { let final = length } else { let final = ? @sec-toclampedindex(end, length) }
  let newLength = $max(final - first, 0)
  let ctor = ? @sec-speciesconstructor(#"obj", intrinsic [[ArrayBuffer]])
  let #"new" = ? @sec-construct(ctor, [$𝔽(newLength)])
  perform ? @sec-requireinternalslot(#"new", [[ArrayBufferData]])
  if @sec-issharedarraybuffer(#"new") is val {true} -> throw @ph-new-error([[TypeError]])
  if @sec-isdetachedbuffer(#"new") is val {true} -> throw @ph-new-error([[TypeError]])
  if @sec-samevalue(#"new", #"obj") is val {true} -> throw @ph-new-error([[TypeError]])
  if #"new"[[ArrayBufferByteLength]] < newLength -> throw @ph-new-error([[TypeError]])
  note "Side-effects of the above steps may have detached or resized _obj_."
  if @sec-isdetachedbuffer(#"obj") is val {true} -> throw @ph-new-error([[TypeError]])
  let fromBlock = #"obj"[[ArrayBufferData]]
  let toBlock = #"new"[[ArrayBufferData]]
  let currentLength = #"obj"[[ArrayBufferByteLength]]
  let maxCount = currentLength - first
  if maxCount > 0 {
    let count = $min(newLength, maxCount)
    perform @sec-copydatablockbytes(toBlock, 0, fromBlock, first, count)
  }
  return #"new"
}

def @sec-arraybuffer.prototype.transfer "ArrayBuffer.prototype.transfer" (kind builtin params [newLength opt]) vars [#"this value", NewTarget, newLength, #"obj"] {
  let #"obj" = this_value
  return ? @sec-arraybuffercopyanddetach(#"obj", newLength, ~preserve-resizability~)
}

def @sec-arraybuffer.prototype.transfertofixedlength "ArrayBuffer.prototype.transferToFixedLength" (kind builtin params [newLength opt]) vars [#"this value", NewTarget, newLength, #"obj"] {
  let #"obj" = this_value
  return ? @sec-arraybuffercopyanddetach(#"obj", newLength, ~fixed-length~)
}

def @sec-allocatesharedarraybuffer "AllocateSharedArrayBuffer" (kind ao params [ctor : constructor, byteLength : sort [#"non-negative"] integer, maxByteLength : sort [#"non-negative"] integer | val(~empty~) opt] -> completion<SharedArrayBuffer> | #"throw completion") vars [ctor, byteLength, maxByteLength, #"slots", allocatingGrowableBuffer, #"obj", allocationLength, #"block", byteLengthBlock, agentRecord, rawBytes, execution, eventsRecord] {
  let #"slots" = [[[ArrayBufferData]]]
  if_else maxByteLength sat $Present() and maxByteLength is not val {~empty~} { let allocatingGrowableBuffer = true } else { let allocatingGrowableBuffer = false }
  if allocatingGrowableBuffer is val {true} {
    if byteLength > maxByteLength -> throw @ph-new-error([[RangeError]])
    perform @ph-append-fields([[[ArrayBufferByteLengthData]], [[ArrayBufferMaxByteLength]]], ?#"slots")
  }
  else {
    perform $Append([[ArrayBufferByteLength]], ?#"slots")
  }
  let #"obj" = ? @sec-ordinarycreatefromconstructor(ctor, "%SharedArrayBuffer.prototype%", #"slots")
  if_else allocatingGrowableBuffer is val {true} { let allocationLength = maxByteLength } else { let allocationLength = byteLength }
  let #"block" = ? @sec-createsharedbytedatablock(allocationLength)
  set field #"obj"[[ArrayBufferData]] = #"block"
  if allocatingGrowableBuffer is val {true} {
    assert byteLength <= maxByteLength
    let byteLengthBlock = ? @sec-createsharedbytedatablock(8)
    let agentRecord = $AgentRecord()
    let rawBytes = @sec-numerictorawbytes(~biguint64~, $ℤ(byteLength), agentRecord[[LittleEndian]])
    let execution = agentRecord[[CandidateExecution]]
    let eventsRecord = $ListFind([[AgentSignifier]], execution[[EventsRecords]], @sec-agentsignifier())
    perform $Append(record WriteSharedMemory { [[Order]]: ~seq-cst~, [[NoTear]]: true, [[Block]]: byteLengthBlock, [[ByteIndex]]: 0, [[ElementSize]]: 8, [[Payload]]: rawBytes }, eventsRecord[[EventList]])
    set field #"obj"[[ArrayBufferByteLengthData]] = byteLengthBlock
    set field #"obj"[[ArrayBufferMaxByteLength]] = maxByteLength
  }
  else {
    set field #"obj"[[ArrayBufferByteLength]] = byteLength
  }
  return #"obj"
}

