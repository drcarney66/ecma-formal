def @sec-validateintegertypedarray "ValidateIntegerTypedArray" (kind ao params [ta : #"ECMAScript language value", waitable : Boolean] -> completion<#"TypedArray With Buffer Witness Record"> | #"throw completion") vars [ta, waitable, taRecord, elementType] {
  note "Bounds checking is not a synchronizing operation when _ta_'s backing buffer is a growable SharedArrayBuffer."
  let taRecord = ? @sec-validatetypedarray(ta, ~unordered~)
  let elementType = @sec-typedarrayelementtype(ta)
  if @sec-isnotearconfiguration(elementType, ~seq-cst~) is val {false} -> throw @ph-new-error([[TypeError]])
  if waitable is val {true} and elementType is neither val {~int32~; ~bigint64~} -> throw @ph-new-error([[TypeError]])
  return taRecord
}

def @sec-validateatomicaccess "ValidateAtomicAccess" (kind ao params [taRecord : #"TypedArray With Buffer Witness Record", requestIndex : #"ECMAScript language value"] -> completion<sort [#"non-negative"] integer> | #"throw completion") vars [taRecord, requestIndex, length, accessIndex, ta, elementSize, offset] {
  let length = @sec-typedarraylength(taRecord)
  let accessIndex = ? @sec-toindex(requestIndex)
  assert accessIndex >= 0
  if accessIndex >= length -> throw @ph-new-error([[RangeError]])
  let ta = taRecord[[Object]]
  let elementSize = @sec-typedarrayelementsize(ta)
  let offset = ta[[ByteOffset]]
  return (accessIndex * elementSize) + offset
}

def @sec-validateatomicaccessonintegertypedarray "ValidateAtomicAccessOnIntegerTypedArray" (kind ao params [ta : #"ECMAScript language value", requestIndex : #"ECMAScript language value"] -> completion<sort [#"non-negative"] integer> | #"throw completion") vars [ta, requestIndex, taRecord] {
  let taRecord = ? @sec-validateintegertypedarray(ta, false)
  return ? @sec-validateatomicaccess(taRecord, requestIndex)
}

def @sec-revalidateatomicaccess "RevalidateAtomicAccess" (kind ao params [ta : TypedArray, byteIndexInBuffer : sort [#"non-negative"] integer] -> completion<val(~unused~)> | #"throw completion") vars [ta, byteIndexInBuffer, taRecord, elementSize, elementLastByteIndex] {
  note "Bounds checking is not a synchronizing operation when _ta_'s backing buffer is a growable SharedArrayBuffer."
  let taRecord = ? @sec-validatetypedarraybounds(ta, ~unordered~)
  assert byteIndexInBuffer >= ta[[ByteOffset]]
  let elementSize = @sec-typedarrayelementsize(ta)
  let elementLastByteIndex = byteIndexInBuffer + elementSize - 1
  if elementLastByteIndex >= taRecord[[CachedBufferByteLength]] -> throw @ph-new-error([[RangeError]])
  return ~unused~
}

def @sec-getwaiterlist "GetWaiterList" (kind ao params [#"block" : #"Shared Data Block", i : doc "a non-negative integer that is evenly divisible by 4"] -> #"WaiterList Record") vars [#"block", i] {
  assert expr $Chain(0, data choice 1, ?i, data choice 0, $Count(data choice 3, ?#"block")) and expr $Chain(0, data choice 1, i + 3, data choice 0, $Count(data choice 3, ?#"block"))
  return $WaiterListFor(#"block", i)
}

def @sec-entercriticalsection "EnterCriticalSection" (kind ao params [waiterList : #"WaiterList Record"] -> val(~unused~)) vars [waiterList, agentRecord, execution, eventsRecord, enterEvent] {
  assert $EnteredCriticalSections() sat $IsEmpty()
  perform $AcquireCriticalSection(waiterList)
  if waiterList[[MostRecentLeaveEvent]] is not val {~empty~} {
    note "A _waiterList_ whose critical section has been entered at least once has a Synchronize event set by LeaveCriticalSection."
    let agentRecord = $AgentRecord()
    let execution = agentRecord[[CandidateExecution]]
    let eventsRecord = $ListFind([[AgentSignifier]], execution[[EventsRecords]], @sec-agentsignifier())
    let enterEvent = $NewRecord(data sort #"Synchronize event")
    perform $Append(?enterEvent, eventsRecord[[EventList]])
    perform $Append([waiterList[[MostRecentLeaveEvent]], enterEvent], eventsRecord[[AgentSynchronizesWith]])
  }
  return ~unused~
}

def @sec-leavecriticalsection "LeaveCriticalSection" (kind ao params [waiterList : #"WaiterList Record"] -> val(~unused~)) vars [waiterList, agentRecord, execution, eventsRecord, leaveEvent] {
  perform @ph-assert-critical(?waiterList)
  let agentRecord = $AgentRecord()
  let execution = agentRecord[[CandidateExecution]]
  let eventsRecord = $ListFind([[AgentSignifier]], execution[[EventsRecords]], @sec-agentsignifier())
  let leaveEvent = $NewRecord(data sort #"Synchronize event")
  perform $Append(?leaveEvent, eventsRecord[[EventList]])
  set field waiterList[[MostRecentLeaveEvent]] = leaveEvent
  perform $ReleaseCriticalSection(waiterList)
  return ~unused~
}

def @sec-addwaiter "AddWaiter" (kind ao params [waiterList : #"WaiterList Record", waiterRecord : #"Waiter Record"] -> val(~unused~)) vars [waiterList, waiterRecord] {
  perform @ph-assert-critical(?waiterList)
  assert! expr @ph-no-waiter-with(waiterList[[Waiters]], waiterRecord[[PromiseCapability]], waiterRecord[[AgentSignifier]])
  perform $Append(?waiterRecord, waiterList[[Waiters]])
  return ~unused~
}

def @sec-removewaiter "RemoveWaiter" (kind ao params [waiterList : #"WaiterList Record", waiterRecord : #"Waiter Record"] -> val(~unused~)) vars [waiterList, waiterRecord] {
  perform @ph-assert-critical(?waiterList)
  assert waiterList[[Waiters]] sat $Contains(?waiterRecord)
  perform $RemoveElem(?waiterRecord, waiterList[[Waiters]])
  return ~unused~
}

def @sec-removewaiters "RemoveWaiters" (kind ao params [waiterList : #"WaiterList Record", count : sort [#"non-negative"] integer | val(math(+∞))] -> list<#"Waiter Record">) vars [waiterList, count, length, waiters] {
  perform @ph-assert-critical(?waiterList)
  let length = $ListLen(waiterList[[Waiters]])
  set var count = $min(count, length)
  let waiters = @ph-list-whose-elements([@ph-first-elements-of(?count, waiterList[[Waiters]])])
  perform @ph-remove-first-n(?count, waiterList[[Waiters]])
  return waiters
}

def @sec-suspendthisagent "SuspendThisAgent" (kind ao params [waiterList : #"WaiterList Record", waiterRecord : #"Waiter Record"] -> val(~unused~)) vars [waiterList, waiterRecord, thisAgent] {
  perform @ph-assert-critical(?waiterList)
  assert waiterList[[Waiters]] sat $Contains(?waiterRecord)
  let thisAgent = @sec-agentsignifier()
  assert waiterRecord[[AgentSignifier]] is val {thisAgent}
  assert waiterRecord[[PromiseCapability]] is val {~blocking~}
  assert @sec-agentcansuspend() is val {true}
  perform @sec-leavecriticalsection(waiterList)
  perform $SuspendAgentUntil(waiterList, waiterRecord[[TimeoutTime]])
  repeat_while $AgentWoken() is val {false} {
    perform @formal-agent-interleave()
  }
  perform @sec-entercriticalsection(waiterList)
  return ~unused~
}

def @sec-notifywaiter "NotifyWaiter" (kind ao params [waiterList : #"WaiterList Record", waiterRecord : #"Waiter Record"] -> val(~unused~)) vars [waiterList, waiterRecord] {
  perform @ph-assert-critical(?waiterList)
  if waiterRecord[[PromiseCapability]] is val {~blocking~} {
    perform $WakeAgent(waiterRecord[[AgentSignifier]])
    note "This causes the agent to resume execution in SuspendThisAgent."
  }
  else_if @sec-agentsignifier() is val {waiterRecord[[AgentSignifier]]} {
    perform @sec-resolveasyncwaiter(waiterRecord)
  }
  else {
    perform @sec-enqueueresolveinagentjob(waiterRecord)
  }
  return ~unused~
}

def @sec-enqueueresolveinagentjob "EnqueueResolveInAgentJob" (kind ao params [waiterRecord : #"Waiter Record"] -> val(~unused~)) vars [waiterRecord, resolveJob, realmInTargetAgent] {
  let resolveJob = closure 0
  let realmInTargetAgent = ! @sec-getfunctionrealm(waiterRecord[[PromiseCapability]][[Resolve]])
  assert waiterRecord[[AgentSignifier]] is val {realmInTargetAgent[[AgentSignifier]]}
  perform @sec-hostenqueuegenericjob(resolveJob, realmInTargetAgent)
  return ~unused~
  closure job params none captures [waiterRecord] {
    perform @sec-resolveasyncwaiter(waiterRecord)
    return ~unused~
  }
}

def @sec-dowait "DoWait" (kind ao params [mode : val(~sync~) | val(~async~), ta : #"ECMAScript language value", index : #"ECMAScript language value", value : #"ECMAScript language value", timeout : #"ECMAScript language value"] -> completion<Object | val("not-equal") | val("timed-out") | val("ok")> | #"throw completion") vars [mode, ta, index, value, timeout, taRecord, buffer, byteIndexInBuffer, elementType, expected, timeoutNumber, signal, realTimeout, #"block", waiterList, promiseCapability, resultObj, witness, thisAgent, now, additionalTimeout, timeoutTime, waiterRecord, algorithm, pending, entry] {
  let taRecord = ? @sec-validateintegertypedarray(ta, true)
  let buffer = taRecord[[Object]][[ViewedArrayBuffer]]
  if @sec-issharedarraybuffer(buffer) is val {false} -> throw @ph-new-error([[TypeError]])
  let byteIndexInBuffer = ? @sec-validateatomicaccess(taRecord, index)
  let elementType = @sec-typedarrayelementtype(ta)
  assert elementType is val {~bigint64~; ~int32~}
  if_else elementType is val {~bigint64~} { let expected = ? @sec-tobigint64(value) } else { let expected = ? @sec-toint32(value) }
  if mode is val {~async~} and timeout is ty {Object} {
    let timeoutNumber = ? @sec-get-o-p(timeout, "timeout")
    let signal = ? @sec-get-o-p(timeout, "signal")
  }
  else {
    let timeoutNumber = timeout
    let signal = undefined
  }
  if timeoutNumber is val {undefined} -> set var timeoutNumber = num_f(+∞)
  if timeoutNumber is not ty {Number} -> throw @ph-new-error([[TypeError]])
  if timeoutNumber is val {nan} -> throw @ph-new-error([[RangeError]])
  if signal is not val {undefined} {
    perform ? @sec-requireinternalslot(signal, [[AbortReason]])
    if @sec-isaborted(signal) is val {true} -> throw signal[[AbortReason]]
  }
  if timeoutNumber is val {num_f(+∞)} -> let realTimeout = math(+∞)
  else_if timeoutNumber is val {num_f(-∞)} -> let realTimeout = 0
  else -> let realTimeout = $max($ℝ(timeoutNumber), 0)
  if mode is val {~sync~} and @sec-agentcansuspend() is val {false} -> throw @ph-new-error([[TypeError]])
  let #"block" = buffer[[ArrayBufferData]]
  let waiterList = @sec-getwaiterlist(#"block", byteIndexInBuffer)
  if mode is val {~sync~} {
    let promiseCapability = ~blocking~
    let resultObj = undefined
  }
  else {
    let promiseCapability = ! @sec-newpromisecapability(intrinsic [[Promise]])
    let resultObj = @sec-ordinaryobjectcreate(intrinsic [[Object.prototype]])
  }
  perform @sec-entercriticalsection(waiterList)
  let witness = @sec-getvaluefrombuffer(buffer, byteIndexInBuffer, elementType, true, ~seq-cst~)
  if expected != witness {
    perform @sec-leavecriticalsection(waiterList)
    if mode is val {~sync~} -> return "not-equal"
    perform ! @sec-createdatapropertyorthrow(resultObj, "async", false)
    perform ! @sec-createdatapropertyorthrow(resultObj, "value", "not-equal")
    return resultObj
  }
  if realTimeout == 0 and mode is val {~async~} {
    note "There is no special handling of synchronous immediate timeouts. Asynchronous immediate timeouts have special handling in order to fail fast and avoid unnecessary Promise jobs."
    perform @sec-leavecriticalsection(waiterList)
    perform ! @sec-createdatapropertyorthrow(resultObj, "async", false)
    perform ! @sec-createdatapropertyorthrow(resultObj, "value", "timed-out")
    return resultObj
  }
  let thisAgent = @sec-agentsignifier()
  let now = $TimeNow()
  let additionalTimeout = $AdditionalTimeout()
  let timeoutTime = $ℝ(now) + realTimeout + additionalTimeout
  note "When _realTimeout_ is +∞, _timeoutTime_ is also +∞."
  let waiterRecord = @ph-new-record(record #"Waiter Record" { [[AgentSignifier]]: thisAgent, [[PromiseCapability]]: promiseCapability, [[TimeoutTime]]: timeoutTime, [[Result]]: "ok", [[AbortRegistration]]: ~empty~ })
  if signal is not val {undefined} {
    let algorithm = closure 0
    let entry = @sec-addabortalgorithm(signal, algorithm)
    assert entry is ty {#"Abort Algorithm Registration Record"}
    set field waiterRecord[[AbortRegistration]] = entry
  }
  perform @sec-addwaiter(waiterList, waiterRecord)
  if mode is val {~sync~} {
    perform @sec-suspendthisagent(waiterList, waiterRecord)
    if waiterList[[Waiters]] sat $Contains(?waiterRecord) {
      set field waiterRecord[[Result]] = "timed-out"
      perform @sec-removewaiter(waiterList, waiterRecord)
    }
  }
  else_if timeoutTime sat $IsFinite() {
    perform @sec-enqueueatomicswaitasynctimeoutjob(waiterList, waiterRecord)
  }
  perform @sec-leavecriticalsection(waiterList)
  if mode is val {~sync~} -> return waiterRecord[[Result]]
  perform ! @sec-createdatapropertyorthrow(resultObj, "async", true)
  perform ! @sec-createdatapropertyorthrow(resultObj, "value", promiseCapability[[Promise]])
  return resultObj
  closure abstract params none captures [waiterList, waiterRecord, signal, promiseCapability] {
    perform @sec-entercriticalsection(waiterList)
    if_else waiterList[[Waiters]] sat $Contains(?waiterRecord) { let pending = true } else { let pending = false }
    if pending is val {true} -> perform @sec-removewaiter(waiterList, waiterRecord)
    perform @sec-leavecriticalsection(waiterList)
    if pending is val {true} -> perform ! @sec-call(promiseCapability[[Reject]], undefined, [signal[[AbortReason]]])
    return ~unused~
  }
}

def @sec-enqueueatomicswaitasynctimeoutjob "EnqueueAtomicsWaitAsyncTimeoutJob" (kind ao params [waiterList : #"WaiterList Record", waiterRecord : #"Waiter Record"] -> val(~unused~)) vars [waiterList, waiterRecord, timeoutJob, timeOfJobExecution, now, currentRealm, delay] {
  let timeoutJob = closure 0
  let now = $TimeNow()
  let currentRealm = $CurrentRealm()
  perform @sec-hostenqueuetimeoutjob(timeoutJob, currentRealm, $𝔽(waiterRecord[[TimeoutTime]]) - now)
  return ~unused~
  closure job params none captures [waiterList, waiterRecord] {
    perform @sec-entercriticalsection(waiterList)
    if waiterList[[Waiters]] sat $Contains(?waiterRecord) {
      let timeOfJobExecution = $TimeNow()
      assert! expr @ph-time-at-least($ℝ(timeOfJobExecution), waiterRecord[[TimeoutTime]])
      set field waiterRecord[[Result]] = "timed-out"
      perform @sec-removewaiter(waiterList, waiterRecord)
      perform @sec-notifywaiter(waiterList, waiterRecord)
    }
    perform @sec-leavecriticalsection(waiterList)
    return ~unused~
  }
}

def @sec-atomiccompareexchangeinsharedblock "AtomicCompareExchangeInSharedBlock" (kind ao params [#"block" : #"Shared Data Block", byteIndexInBuffer : integer, elementSize : sort [#"non-negative"] integer, expectedBytes : list<#"byte value">, replacementBytes : list<#"byte value">] -> list<#"byte value">) vars [#"block", byteIndexInBuffer, elementSize, expectedBytes, replacementBytes, agentRecord, execution, eventsRecord, rawBytesRead, second, oldBytes, newBytes, event] {
  let agentRecord = $AgentRecord()
  let execution = agentRecord[[CandidateExecution]]
  let eventsRecord = $ListFind([[AgentSignifier]], execution[[EventsRecords]], @sec-agentsignifier())
  if $ListLen(execution[[EventsRecords]]) is val {1} {
    let rawBytesRead = @formal-singleagentreadbytes(execution, eventsRecord, #"block", byteIndexInBuffer, elementSize)
  }
  else {
    if $EnteredCriticalSections() sat $IsEmpty() -> perform @formal-agent-interleave()
    let rawBytesRead = @formal-choosesharedbytes(execution, eventsRecord, #"block", byteIndexInBuffer, elementSize)
  }
  note "In implementations, _rawBytesRead_ is the result of a load-link, of a load-exclusive, or of an operand of a read-modify-write instruction on the underlying hardware. The nondeterminism is a semantic prescription of the memory model to describe observable behaviour of hardware with weak consistency."
  note "The comparison of the expected value and the read value is performed outside of the read-modify-write modification function to avoid needlessly strong synchronization when the expected value is not equal to the read value."
  if @sec-bytelistequal(rawBytesRead, expectedBytes) is val {true} {
    let second = closure 0
    let event = record ReadModifyWriteSharedMemory { [[Order]]: ~seq-cst~, [[NoTear]]: true, [[Block]]: #"block", [[ByteIndex]]: byteIndexInBuffer, [[ElementSize]]: elementSize, [[Payload]]: replacementBytes, [[ModifyOp]]: second }
  }
  else {
    let event = record ReadSharedMemory { [[Order]]: ~seq-cst~, [[NoTear]]: true, [[Block]]: #"block", [[ByteIndex]]: byteIndexInBuffer, [[ElementSize]]: elementSize }
  }
  perform $Append(?event, eventsRecord[[EventList]])
  perform $Append(record #"Chosen Value Record" { [[Event]]: event, [[ChosenValue]]: rawBytesRead }, execution[[ChosenValues]])
  return rawBytesRead
  closure read_modify_write atomic params [oldBytes, newBytes] captures [] {
    return newBytes
  }
}

def @sec-atomicreadmodifywrite "AtomicReadModifyWrite" (kind ao params [ta : #"ECMAScript language value", index : #"ECMAScript language value", value : #"ECMAScript language value", #"op" : #"read-modify-write modification function"] -> completion<Number | BigInt> | #"throw completion") vars [ta, index, value, #"op", byteIndexInBuffer, coerced, buffer, elementType] {
  let byteIndexInBuffer = ? @sec-validateatomicaccessonintegertypedarray(ta, index)
  if ta[[ContentType]] is val {~bigint~} -> let coerced = ? @sec-tobigint(value)
  else -> let coerced = $𝔽(? @sec-tointegerorinfinity(value))
  perform ? @sec-revalidateatomicaccess(ta, byteIndexInBuffer)
  let buffer = ta[[ViewedArrayBuffer]]
  let elementType = @sec-typedarrayelementtype(ta)
  return @sec-getmodifysetvalueinbuffer(buffer, byteIndexInBuffer, elementType, coerced, #"op")
}

def @sec-bytelistbitwiseop "ByteListBitwiseOp" (kind ao params [#"op" : doc "&, ^, or |", xBytes : list<#"byte value">, yBytes : list<#"byte value">] -> list<#"byte value">) vars [#"op", xBytes, yBytes, result, i, xByte, yByte, resultByte] {
  assert expr $SameLength([xBytes, yBytes])
  let result = $ListNew()
  let i = 0
  for_each xByte in xBytes {
    let yByte = yBytes[i]
    if #"op" is val {code "&"} {
      let resultByte = $Bitwise(data choice 0, ?xByte, ?yByte)
    }
    else_if #"op" is val {code "^"} {
      let resultByte = $Bitwise(data choice 1, ?xByte, ?yByte)
    }
    else {
      assert #"op" is val {code "|"}
      let resultByte = $Bitwise(data choice 2, ?xByte, ?yByte)
    }
    set var i = i + 1
    perform $Append(?resultByte, ?result)
  }
  return result
}

def @sec-bytelistequal "ByteListEqual" (kind ao params [xBytes : list<#"byte value">, yBytes : list<#"byte value">] -> Boolean) vars [xBytes, yBytes, i, xByte, yByte] {
  if expr not $SameLength([xBytes, yBytes]) -> return false
  let i = 0
  for_each xByte in xBytes {
    let yByte = yBytes[i]
    if xByte != yByte -> return false
    set var i = i + 1
  }
  return true
}

def @sec-atomics.add "Atomics.add" (kind builtin params [ta, index, value]) vars [#"this value", NewTarget, ta, index, value, add, xBytes, yBytes, type, agentRecord, isLittleEndian, x, y, sum, sumBytes] {
  let add = closure 0
  return ? @sec-atomicreadmodifywrite(ta, index, value, add)
  closure read_modify_write atomic params [xBytes, yBytes] captures [ta] {
    let type = @sec-typedarrayelementtype(ta)
    let agentRecord = $AgentRecord()
    let isLittleEndian = agentRecord[[LittleEndian]]
    let x = @sec-rawbytestonumeric(type, xBytes, isLittleEndian)
    let y = @sec-rawbytestonumeric(type, yBytes, isLittleEndian)
    if x is ty {Number} {
      let sum = @sec-numeric-types-number-add(x, y)
    }
    else {
      assert x is ty {BigInt}
      let sum = @sec-numeric-types-bigint-add(x, y)
    }
    let sumBytes = @sec-numerictorawbytes(type, sum, isLittleEndian)
    assert expr $SameLength([sumBytes, xBytes, yBytes])
    return sumBytes
  }
}

def @sec-atomics.and "Atomics.and" (kind builtin params [ta, index, value]) vars [#"this value", NewTarget, ta, index, value, #"and", xBytes, yBytes] {
  let #"and" = closure 0
  return ? @sec-atomicreadmodifywrite(ta, index, value, #"and")
  closure read_modify_write atomic params [xBytes, yBytes] captures [] {
    return @sec-bytelistbitwiseop(code "&", xBytes, yBytes)
  }
}

def @sec-atomics.compareexchange "Atomics.compareExchange" (kind builtin params [ta, index, expectedValue, replacementValue]) vars [#"this value", NewTarget, ta, index, expectedValue, replacementValue, byteIndexInBuffer, buffer, #"block", expected, replacement, elementType, elementSize, agentRecord, isLittleEndian, expectedBytes, replacementBytes, rawBytesRead] {
  let byteIndexInBuffer = ? @sec-validateatomicaccessonintegertypedarray(ta, index)
  let buffer = ta[[ViewedArrayBuffer]]
  let #"block" = buffer[[ArrayBufferData]]
  if ta[[ContentType]] is val {~bigint~} {
    let expected = ? @sec-tobigint(expectedValue)
    let replacement = ? @sec-tobigint(replacementValue)
  }
  else {
    let expected = $𝔽(? @sec-tointegerorinfinity(expectedValue))
    let replacement = $𝔽(? @sec-tointegerorinfinity(replacementValue))
  }
  perform ? @sec-revalidateatomicaccess(ta, byteIndexInBuffer)
  let elementType = @sec-typedarrayelementtype(ta)
  let elementSize = @sec-typedarrayelementsize(ta)
  let agentRecord = $AgentRecord()
  let isLittleEndian = agentRecord[[LittleEndian]]
  let expectedBytes = @sec-numerictorawbytes(elementType, expected, isLittleEndian)
  let replacementBytes = @sec-numerictorawbytes(elementType, replacement, isLittleEndian)
  if @sec-issharedarraybuffer(buffer) is val {true} {
    let rawBytesRead = @sec-atomiccompareexchangeinsharedblock(#"block", byteIndexInBuffer, elementSize, expectedBytes, replacementBytes)
  }
  else {
    let rawBytesRead = @ph-list-of-length(?elementSize, @ph-bytes-from(?elementSize, ?#"block", ?byteIndexInBuffer))
    if @sec-bytelistequal(rawBytesRead, expectedBytes) is val {true} {
      perform $StoreBytes(?replacementBytes, ?#"block", ?byteIndexInBuffer)
    }
  }
  return @sec-rawbytestonumeric(elementType, rawBytesRead, isLittleEndian)
}

def @sec-atomics.exchange "Atomics.exchange" (kind builtin params [ta, index, value]) vars [#"this value", NewTarget, ta, index, value, second, oldBytes, newBytes] {
  let second = closure 0
  return ? @sec-atomicreadmodifywrite(ta, index, value, second)
  closure read_modify_write atomic params [oldBytes, newBytes] captures [] {
    return newBytes
  }
}

def @sec-atomics.islockfree "Atomics.isLockFree" (kind builtin params [size]) vars [#"this value", NewTarget, size, n, agentRecord] {
  let n = ? @sec-tointegerorinfinity(size)
  let agentRecord = $AgentRecord()
  if n == 1 -> return agentRecord[[IsLockFree1]]
  if n == 2 -> return agentRecord[[IsLockFree2]]
  if n == 4 -> return true
  if n == 8 -> return agentRecord[[IsLockFree8]]
  return false
}

def @sec-atomics.load "Atomics.load" (kind builtin params [ta, index]) vars [#"this value", NewTarget, ta, index, byteIndexInBuffer, buffer, elementType] {
  let byteIndexInBuffer = ? @sec-validateatomicaccessonintegertypedarray(ta, index)
  perform ? @sec-revalidateatomicaccess(ta, byteIndexInBuffer)
  let buffer = ta[[ViewedArrayBuffer]]
  let elementType = @sec-typedarrayelementtype(ta)
  return @sec-getvaluefrombuffer(buffer, byteIndexInBuffer, elementType, true, ~seq-cst~)
}

def @sec-atomics.notify "Atomics.notify" (kind builtin params [ta, index, count]) vars [#"this value", NewTarget, ta, index, count, taRecord, byteIndexInBuffer, intCount, buffer, #"block", waiterList, waiters, waiterRecord, waitersCount] {
  let taRecord = ? @sec-validateintegertypedarray(ta, true)
  let byteIndexInBuffer = ? @sec-validateatomicaccess(taRecord, index)
  if count is val {undefined} {
    set var count = math(+∞)
  }
  else {
    let intCount = ? @sec-tointegerorinfinity(count)
    set var count = $max(intCount, 0)
  }
  let buffer = ta[[ViewedArrayBuffer]]
  if @sec-issharedarraybuffer(buffer) is val {false} -> return num_f(+0)
  let #"block" = buffer[[ArrayBufferData]]
  let waiterList = @sec-getwaiterlist(#"block", byteIndexInBuffer)
  perform @sec-entercriticalsection(waiterList)
  let waiters = @sec-removewaiters(waiterList, count)
  for_each waiterRecord in waiters {
    perform @sec-notifywaiter(waiterList, waiterRecord)
  }
  perform @sec-leavecriticalsection(waiterList)
  let waitersCount = $ListLen(?waiters)
  return $𝔽(waitersCount)
}

def @sec-atomics.or "Atomics.or" (kind builtin params [ta, index, value]) vars [#"this value", NewTarget, ta, index, value, #"or", xBytes, yBytes] {
  let #"or" = closure 0
  return ? @sec-atomicreadmodifywrite(ta, index, value, #"or")
  closure read_modify_write atomic params [xBytes, yBytes] captures [] {
    return @sec-bytelistbitwiseop(code "|", xBytes, yBytes)
  }
}

def @sec-atomics.pause "Atomics.pause" (kind builtin params []) vars [#"this value", NewTarget] {
  perform $SpinWaitHint()
  return undefined
}

def @sec-atomics.store "Atomics.store" (kind builtin params [ta, index, value]) vars [#"this value", NewTarget, ta, index, value, byteIndexInBuffer, coerced, buffer, elementType] {
  let byteIndexInBuffer = ? @sec-validateatomicaccessonintegertypedarray(ta, index)
  if ta[[ContentType]] is val {~bigint~} -> let coerced = ? @sec-tobigint(value)
  else -> let coerced = $𝔽(? @sec-tointegerorinfinity(value))
  perform ? @sec-revalidateatomicaccess(ta, byteIndexInBuffer)
  let buffer = ta[[ViewedArrayBuffer]]
  let elementType = @sec-typedarrayelementtype(ta)
  perform @sec-setvalueinbuffer(buffer, byteIndexInBuffer, elementType, coerced, true, ~seq-cst~)
  return coerced
}

def @sec-atomics.sub "Atomics.sub" (kind builtin params [ta, index, value]) vars [#"this value", NewTarget, ta, index, value, subtract, xBytes, yBytes, type, agentRecord, isLittleEndian, x, y, difference, differenceBytes] {
  let subtract = closure 0
  return ? @sec-atomicreadmodifywrite(ta, index, value, subtract)
  closure read_modify_write atomic params [xBytes, yBytes] captures [ta] {
    let type = @sec-typedarrayelementtype(ta)
    let agentRecord = $AgentRecord()
    let isLittleEndian = agentRecord[[LittleEndian]]
    let x = @sec-rawbytestonumeric(type, xBytes, isLittleEndian)
    let y = @sec-rawbytestonumeric(type, yBytes, isLittleEndian)
    if x is ty {Number} {
      let difference = @sec-numeric-types-number-subtract(x, y)
    }
    else {
      assert x is ty {BigInt}
      let difference = @sec-numeric-types-bigint-subtract(x, y)
    }
    let differenceBytes = @sec-numerictorawbytes(type, difference, isLittleEndian)
    assert expr $SameLength([differenceBytes, xBytes, yBytes])
    return differenceBytes
  }
}

def @sec-atomics.wait "Atomics.wait" (kind builtin params [ta, index, value, timeout]) vars [#"this value", NewTarget, ta, index, value, timeout] {
  return ? @sec-dowait(~sync~, ta, index, value, timeout)
}

def @sec-atomics.waitasync "Atomics.waitAsync" (kind builtin params [ta, index, value, timeout]) vars [#"this value", NewTarget, ta, index, value, timeout] {
  return ? @sec-dowait(~async~, ta, index, value, timeout)
}

def @sec-atomics.xor "Atomics.xor" (kind builtin params [ta, index, value]) vars [#"this value", NewTarget, ta, index, value, xor, xBytes, yBytes] {
  let xor = closure 0
  return ? @sec-atomicreadmodifywrite(ta, index, value, xor)
  closure read_modify_write atomic params [xBytes, yBytes] captures [] {
    return @sec-bytelistbitwiseop(code "^", xBytes, yBytes)
  }
}

def @sec-json.israwjson "JSON.isRawJSON" (kind builtin params [#"obj"]) vars [#"this value", NewTarget, #"obj"] {
  if #"obj" is ty {Object} and #"obj" sat $HasSlot([[IsRawJSON]]) -> return true
  return false
}

def @sec-json.parse "JSON.parse" (kind builtin params [#"text", reviver opt]) vars [#"this value", NewTarget, #"text", reviver, jsonString, parseResult, unfiltered, root, rootName, snapshot] {
  let jsonString = ? @sec-tostring(#"text")
  let parseResult = ? @sec-ParseJSON(jsonString)
  let unfiltered = parseResult[[Value]]
  if @sec-iscallable(reviver) is val {false} -> return unfiltered
  let root = @sec-ordinaryobjectcreate(intrinsic [[Object.prototype]])
  let rootName = $"the empty String"()
  perform ! @sec-createdatapropertyorthrow(root, rootName, unfiltered)
  let snapshot = @sec-createjsonparserecord(parseResult[[ParseNode]], rootName, unfiltered)
  return ? @sec-internalizejsonproperty(root, rootName, reviver, snapshot)
}

def @sec-ParseJSON "ParseJSON" (kind ao params [#"text" : String] -> completion<record { [[ParseNode]]: #"Parse Node", [[Value]]: #"ECMAScript language value" }> | #"throw completion") vars [#"text", scriptString, script, result] {
  if $IsJSONText(@sec-stringtocodepoints(#"text")) is val {false} -> throw @ph-new-error([[SyntaxError]])
  let scriptString = $"string-concatenation"("(", #"text", ");")
  let script = @formal-parsetextin(scriptString, |Script|, false, true, false)
  note "The early error rules defined in <emu-xref href=\"#sec-object-initializer-static-semantics-early-errors\"></emu-xref> have special handling for the above invocation of ParseText."
  assert script is ty {#"Parse Node"}
  let result = ! sdo Evaluation(script)
  note "The PropertyDefinitionEvaluation semantics defined in <emu-xref href=\"#sec-runtime-semantics-propertydefinitionevaluation\"></emu-xref> have special handling for the above evaluation."
  if result is ty {Object} {
    assert expr @ph-contains-cond(?script, |ArrayLiteral|) or expr @ph-contains-cond(?script, |ObjectLiteral|)
  }
  else {
    assert result is ty {String; Number; Boolean} or result is val {null}
  }
  return record Record { [[ParseNode]]: script, [[Value]]: result }
}

def @sec-createjsonparserecord "CreateJSONParseRecord" (kind ao params [parseNode : #"Parse Node", key : #"property name", value : #"ECMAScript language value"] -> #"JSON Parse Record") vars [parseNode, key, value, typedValueNode, elements, entries, isArray, contentNodes, length, valueLength, index, propertyName, elementParseRecord, propertyNodes, #"keys", propertyKey, propertyDefinition, propertyNode, propertyValueNode, entryParseRecord] {
  let typedValueNode = @sec-shallowestcontainedjsonvalue(parseNode)
  assert typedValueNode is not val {~empty~}
  let elements = $ListNew()
  let entries = $ListNew()
  if value is ty {Object} {
    let isArray = ! @sec-isarray(value)
    if isArray is val {true} {
      assert typedValueNode is ty {pred(sat @ph-type-nt-parse-node(data choice 1, |ArrayLiteral|))}
      let contentNodes = sdo JSONArrayLiteralContentNodes(typedValueNode)
      let length = $ListLen(?contentNodes)
      let valueLength = ! @sec-lengthofarraylike(value)
      assert valueLength is val {length}
      let index = 0
      repeat_while index < length {
        let propertyName = ! @sec-tostring($𝔽(index))
        let elementParseRecord = @sec-createjsonparserecord(contentNodes[index], propertyName, ! @sec-get-o-p(value, propertyName))
        perform $Append(?elementParseRecord, ?elements)
        set var index = index + 1
      }
    }
    else {
      assert typedValueNode is ty {pred(sat @ph-type-nt-parse-node(data choice 1, |ObjectLiteral|))}
      let propertyNodes = sdo PropertyDefinitionNodes(typedValueNode)
      note "Because _value_ was produced from JSON text and has not been modified, all of its property keys are Strings and will be exhaustively enumerated."
      let #"keys" = ! @sec-enumerableownproperties(value, ~key~)
      for_each propertyKey : String in #"keys" {
        note "In the case of JSON text specifying multiple name/value pairs with the same name for a single object (such as <code>{\"a\":\"lost\",\"a\":\"kept\"}</code>), the value for the corresponding property of the resulting ECMAScript object is specified by the last pair with that name."
        let propertyDefinition = ~empty~
        for_each propertyNode : #"Parse Node" in propertyNodes {
          let propertyName = sdo PropName(propertyNode)
          if propertyName is val {propertyKey} -> set var propertyDefinition = propertyNode
        }
        assert propertyDefinition is val {prods [p"Syntactic - PropertyDefinition : PropertyName[?Yield, ?Await] `:` AssignmentExpression[+In, ?Yield, ?Await]"]}
        let propertyValueNode = $ChildOf(|AssignmentExpression|, ?propertyDefinition)
        let entryParseRecord = @sec-createjsonparserecord(propertyValueNode, propertyKey, ! @sec-get-o-p(value, propertyKey))
        perform $Append(?entryParseRecord, ?entries)
      }
    }
  }
  else {
    assert typedValueNode is neither ty {pred(sat @ph-type-nt-parse-node(data choice 1, |ArrayLiteral|)); pred(sat @ph-type-nt-parse-node(data choice 1, |ObjectLiteral|))}
  }
  return record #"JSON Parse Record" { [[ParseNode]]: typedValueNode, [[Key]]: key, [[Value]]: value, [[Elements]]: elements, [[Entries]]: entries }
}

def @sec-internalizejsonproperty "InternalizeJSONProperty" (kind ao params [holder : Object, name : String, reviver : #"function object", parseRecord : #"JSON Parse Record" | val(~empty~)] -> completion<#"ECMAScript language value"> | #"throw completion") vars [holder, name, reviver, parseRecord, value, context, parseNode, sourceText, elementRecords, entryRecords, isArray, elementRecordsLength, length, index, propertyKey, elementRecord, newElement, #"keys", entry, entryRecord] {
  let value = ? @sec-get-o-p(holder, name)
  let context = @sec-ordinaryobjectcreate(intrinsic [[Object.prototype]])
  if parseRecord is ty {#"JSON Parse Record"} and @sec-samevalue(parseRecord[[Value]], value) is val {true} {
    if value is not ty {Object} {
      let parseNode = parseRecord[[ParseNode]]
      assert parseNode is neither ty {pred(sat @ph-type-nt-parse-node(data choice 1, |ArrayLiteral|)); pred(sat @ph-type-nt-parse-node(data choice 1, |ObjectLiteral|))}
      let sourceText = $SourceText(?parseNode)
      perform ! @sec-createdatapropertyorthrow(context, "source", @sec-codepointstostring(sourceText))
    }
    let elementRecords = parseRecord[[Elements]]
    let entryRecords = parseRecord[[Entries]]
  }
  else {
    let elementRecords = $ListNew()
    let entryRecords = $ListNew()
  }
  if value is ty {Object} {
    let isArray = ? @sec-isarray(value)
    if isArray is val {true} {
      let elementRecordsLength = $ListLen(?elementRecords)
      let length = ? @sec-lengthofarraylike(value)
      let index = 0
      repeat_while index < length {
        let propertyKey = ! @sec-tostring($𝔽(index))
        if_else index < elementRecordsLength { let elementRecord = elementRecords[index] } else { let elementRecord = ~empty~ }
        let newElement = ? @sec-internalizejsonproperty(value, propertyKey, reviver, elementRecord)
        if newElement is val {undefined} {
          perform ? value[[Delete]](propertyKey)
        }
        else {
          perform ? @sec-createdataproperty(value, propertyKey, newElement)
        }
        set var index = index + 1
      }
    }
    else {
      let #"keys" = ? @sec-enumerableownproperties(value, ~key~)
      for_each propertyKey : String in #"keys" {
        let entryRecord = ~empty~
        for_each entry in entryRecords {
          if entryRecord is val {~empty~} and entry[[Key]] is val {propertyKey} -> set var entryRecord = entry
        }
        let newElement = ? @sec-internalizejsonproperty(value, propertyKey, reviver, entryRecord)
        if newElement is val {undefined} {
          perform ? value[[Delete]](propertyKey)
        }
        else {
          perform ? @sec-createdataproperty(value, propertyKey, newElement)
        }
      }
    }
  }
  return ? @sec-call(reviver, holder, [name, value, context])
}

def @sec-shallowestcontainedjsonvalue "ShallowestContainedJSONValue" (kind ao params [root : #"Parse Node"] -> #"Parse Node" | val(~empty~)) vars [root, activeFunc, parseSteps, types, unaryExpr, queue, candidate, queuedChildren, type, #"children"] {
  let activeFunc = $ActiveFunction()
  let parseSteps = ~empty~
  set var parseSteps = ref @sec-json.parse
  assert activeFunc is ty {sort [#"built-in"] #"function object"} and activeFunc sat $HasSlot([[Behaviour]]) and activeFunc[[Behaviour]] is val {parseSteps}
  let types = [|NullLiteral|, |BooleanLiteral|, |NumericLiteral|, |StringLiteral|, |ArrayLiteral|, |ObjectLiteral|, |UnaryExpression|]
  let unaryExpr = ~empty~
  let queue = [root]
  repeat_while queue fails $IsEmpty() {
    let candidate = $ListElem(data choice 1, ?queue)
    perform $RemoveFirst(?queue)
    let queuedChildren = false
    for_each type : nonterminal in types {
      if expr $InstanceOf(candidate, ?type) {
        note "In the JSON grammar, a <code>number</code> token may represent a negative value. In ECMAScript, negation is represented as a unary operation in which a |UnaryExpression| parses to a `-` followed by a derived |UnaryExpression|."
        if type is val {|UnaryExpression|} {
          if $Parent(candidate) is not ty {pred(sat @ph-type-nt-parse-node(data choice 0, |UnaryExpression|))} -> set var unaryExpr = candidate
        }
        else_if type is val {|NumericLiteral|} {
          assert $ParseNodesWithin(unaryExpr) sat $Contains(?candidate)
          return unaryExpr
        }
        else {
          return candidate
        }
      }
      if queuedChildren is val {false} and expr $InstanceOf(candidate, data sort nonterminal) and @ph-contains(?candidate, ?type) is val {true} {
        let #"children" = $ChildNodes(candidate)
        set var queue = $ListConcat([queue, #"children"])
        set var queuedChildren = true
      }
    }
  }
  return ~empty~
}

def @sec-json.rawjson "JSON.rawJSON" (kind builtin params [#"text"]) vars [#"this value", NewTarget, #"text", jsonString, parseResult, internalSlotsList, #"obj"] {
  let jsonString = ? @sec-tostring(#"text")
  if jsonString is val {$"the empty String"()} -> throw @ph-new-error([[SyntaxError]])
  if $FirstUnit(?jsonString) sat @ph-not-json-first-unit() -> throw @ph-new-error([[SyntaxError]])
  if @ph-last-code-unit(?jsonString) sat @ph-not-json-last-unit() -> throw @ph-new-error([[SyntaxError]])
  let parseResult = ? @sec-ParseJSON(jsonString)
  assert parseResult[[Value]] is ty {String; Number; Boolean} or parseResult[[Value]] is val {null}
  let internalSlotsList = [[[IsRawJSON]]]
  let #"obj" = @sec-ordinaryobjectcreate(null, internalSlotsList)
  perform ! @sec-createdatapropertyorthrow(#"obj", "rawJSON", jsonString)
  perform ! @sec-setintegritylevel(#"obj", ~frozen~)
  return #"obj"
}

def @sec-json.stringify "JSON.stringify" (kind builtin params [value, replacer opt, space opt]) vars [#"this value", NewTarget, value, replacer, space, stack, indent, propertyList, replacerFunc, isArray, length, k, propertyKey, propertyValue, item, spaceMV, gap, wrapper, state] {
  let stack = $ListNew()
  let indent = $"the empty String"()
  let propertyList = undefined
  let replacerFunc = undefined
  if replacer is ty {Object} {
    if @sec-iscallable(replacer) is val {true} {
      set var replacerFunc = replacer
    }
    else {
      let isArray = ? @sec-isarray(replacer)
      if isArray is val {true} {
        set var propertyList = $ListNew()
        let length = ? @sec-lengthofarraylike(replacer)
        let k = 0
        repeat_while k < length {
          let propertyKey = ! @sec-tostring($𝔽(k))
          let propertyValue = ? @sec-get-o-p(replacer, propertyKey)
          let item = undefined
          if propertyValue is ty {String} {
            set var item = propertyValue
          }
          else_if propertyValue is ty {Number} {
            set var item = ! @sec-tostring(propertyValue)
          }
          else_if propertyValue is ty {Object} {
            if propertyValue sat @ph-has-slot-or(data choice 0, [[StringData]], [[NumberData]]) -> set var item = ? @sec-tostring(propertyValue)
          }
          if item is not val {undefined} and propertyList fails $Contains(?item) {
            perform $Append(?item, ?propertyList)
          }
          set var k = k + 1
        }
      }
    }
  }
  if space is ty {Object} {
    if space sat $HasSlot([[NumberData]]) {
      set var space = ? @sec-tonumber(space)
    }
    else_if space sat $HasSlot([[StringData]]) {
      set var space = ? @sec-tostring(space)
    }
  }
  if space is ty {Number} {
    let spaceMV = ! @sec-tointegerorinfinity(space)
    set var spaceMV = $min(10, spaceMV)
    if_else spaceMV < 1 { let gap = $"the empty String"() } else { let gap = $StrOfUnits(@ph-occurrences-of(?spaceMV, $CodeUnit(cu(32, "0020", "SPACE")))) }
  }
  else_if space is ty {String} {
    if_else $StrLen(?space) <= 10 { let gap = space } else { let gap = $Substring(?space, 0, 10) }
  }
  else {
    let gap = $"the empty String"()
  }
  let wrapper = @sec-ordinaryobjectcreate(intrinsic [[Object.prototype]])
  perform ! @sec-createdatapropertyorthrow(wrapper, $"the empty String"(), value)
  let state = record #"JSON Serialization Record" { [[ReplacerFunction]]: replacerFunc, [[Stack]]: stack, [[Indent]]: indent, [[Gap]]: gap, [[PropertyList]]: propertyList }
  return ? @sec-serializejsonproperty(state, $"the empty String"(), wrapper)
}

def @sec-serializejsonproperty "SerializeJSONProperty" (kind ao params [state : #"JSON Serialization Record", key : String, holder : Object] -> completion<String | val(undefined)> | #"throw completion") vars [state, key, holder, value, toJSON, rawJSON, isArray] {
  let value = ? @sec-get-o-p(holder, key)
  if value is ty {Object} or value is ty {BigInt} {
    let toJSON = ? @sec-getv(value, "toJSON")
    if @sec-iscallable(toJSON) is val {true} {
      set var value = ? @sec-call(toJSON, value, [key])
    }
  }
  if state[[ReplacerFunction]] is not val {undefined} {
    set var value = ? @sec-call(state[[ReplacerFunction]], holder, [key, value])
  }
  if value is ty {Object} {
    if value sat $HasSlot([[IsRawJSON]]) {
      let rawJSON = ! @sec-get-o-p(value, "rawJSON")
      assert rawJSON is ty {String}
      return rawJSON
    }
    if value sat $HasSlot([[NumberData]]) {
      set var value = ? @sec-tonumber(value)
    }
    else_if value sat $HasSlot([[StringData]]) {
      set var value = ? @sec-tostring(value)
    }
    else_if value sat $HasSlot([[BooleanData]]) {
      set var value = value[[BooleanData]]
    }
    else_if value sat $HasSlot([[BigIntData]]) {
      set var value = value[[BigIntData]]
    }
  }
  if value is val {null} -> return "null"
  if value is val {true} -> return "true"
  if value is val {false} -> return "false"
  if value is ty {String} -> return @sec-quotejsonstring(value)
  if value is ty {Number} {
    if value is ty {sort [finite] Number} -> return ! @sec-tostring(value)
    return "null"
  }
  if value is ty {BigInt} -> throw @ph-new-error([[TypeError]])
  if value is ty {Object} and @sec-iscallable(value) is val {false} {
    let isArray = ? @sec-isarray(value)
    if isArray is val {true} {
      return ? @sec-serializejsonarray(state, value)
    }
    return ? @sec-serializejsonobject(state, value)
  }
  return undefined
}

def @sec-quotejsonstring "QuoteJSONString" (kind ao params [value : String] -> String) vars [value, product, codePoint, unit] {
  let product = @ph-string-solely($CodeUnit(cu(34, "0022", "QUOTATION MARK")))
  for_each codePoint : #"code point" in @sec-stringtocodepoints(value) {
    if codePoint sat @ph-listed-in-column(code "Code Point", table t"table-json-single-character-escapes") {
      set var product = $"string-concatenation"(product, $TableLookup(table t"table-json-single-character-escapes", code "Escape Sequence", code "Code Point", ?codePoint))
    }
    else_if codePoint sat @ph-value-less-than(cu(32, "0020", "SPACE")) or codePoint sat @ph-surrogate-value() {
      let unit = $UnitOrPointOf(data choice 1, $NumericValue(?codePoint))
      set var product = $"string-concatenation"(product, @sec-unicodeescape(unit))
    }
    else {
      set var product = $"string-concatenation"(product, @sec-utf16encodecodepoint(codePoint))
    }
  }
  set var product = $"string-concatenation"(product, $CodeUnit(cu(34, "0022", "QUOTATION MARK")))
  return product
}

def @sec-unicodeescape "UnicodeEscape" (kind ao params [codeUnit : #"code unit"] -> String) vars [codeUnit, n, #"hex"] {
  let n = $NumericValue(?codeUnit)
  assert n <= math(hex(65535, "FFFF"))
  let #"hex" = @ph-lower-hex(?n)
  return $"string-concatenation"($CodeUnit(cu(92, "005C", "REVERSE SOLIDUS")), "u", @sec-stringpad(#"hex", 4, "0", ~start~))
}

def @sec-serializejsonobject "SerializeJSONObject" (kind ao params [state : #"JSON Serialization Record", value : Object] -> completion<String> | #"throw completion") vars [state, value, stepBack, #"keys", partial, propertyKey, stringP, member, final, properties, first, part, separator] {
  if state[[Stack]] sat $Contains(?value) -> throw @ph-new-error([[TypeError]])
  perform $Append(?value, state[[Stack]])
  let stepBack = state[[Indent]]
  set field state[[Indent]] = $"string-concatenation"(state[[Indent]], state[[Gap]])
  if state[[PropertyList]] is not val {undefined} {
    let #"keys" = state[[PropertyList]]
  }
  else {
    let #"keys" = ? @sec-enumerableownproperties(value, ~key~)
  }
  let partial = $ListNew()
  for_each propertyKey in #"keys" {
    let stringP = ? @sec-serializejsonproperty(state, propertyKey, value)
    if stringP is not val {undefined} {
      let member = @sec-quotejsonstring(propertyKey)
      set var member = $"string-concatenation"(member, ":")
      if state[[Gap]] is not val {$"the empty String"()} {
        set var member = $"string-concatenation"(member, $CodeUnit(cu(32, "0020", "SPACE")))
      }
      set var member = $"string-concatenation"(member, stringP)
      perform $Append(?member, ?partial)
    }
  }
  if partial sat $IsEmpty() {
    let final = "{}"
  }
  else {
    if state[[Gap]] is val {$"the empty String"()} {
      let properties = $"the empty String"()
      let first = true
      for_each part in partial {
        if first is val {true} -> set var first = false
        else -> set var properties = $"string-concatenation"(properties, $CodeUnit(cu(44, "002C", "COMMA")))
        set var properties = $"string-concatenation"(properties, part)
      }
      let final = $"string-concatenation"("{", properties, "}")
    }
    else {
      let separator = $"string-concatenation"($CodeUnit(cu(44, "002C", "COMMA")), $CodeUnit(cu(10, "000A", "LINE FEED")), state[[Indent]])
      let properties = $"the empty String"()
      let first = true
      for_each part in partial {
        if first is val {true} -> set var first = false
        else -> set var properties = $"string-concatenation"(properties, separator)
        set var properties = $"string-concatenation"(properties, part)
      }
      let final = $"string-concatenation"("{", $CodeUnit(cu(10, "000A", "LINE FEED")), state[[Indent]], properties, $CodeUnit(cu(10, "000A", "LINE FEED")), stepBack, "}")
    }
  }
  perform $RemoveLast(state[[Stack]])
  set field state[[Indent]] = stepBack
  return final
}

def @sec-serializejsonarray "SerializeJSONArray" (kind ao params [state : #"JSON Serialization Record", value : Object] -> completion<String> | #"throw completion") vars [state, value, stepBack, partial, length, index, stringP, final, properties, first, part, separator] {
  if state[[Stack]] sat $Contains(?value) -> throw @ph-new-error([[TypeError]])
  perform $Append(?value, state[[Stack]])
  let stepBack = state[[Indent]]
  set field state[[Indent]] = $"string-concatenation"(state[[Indent]], state[[Gap]])
  let partial = $ListNew()
  let length = ? @sec-lengthofarraylike(value)
  let index = 0
  repeat_while index < length {
    let stringP = ? @sec-serializejsonproperty(state, ! @sec-tostring($𝔽(index)), value)
    if stringP is val {undefined} {
      perform $Append("null", ?partial)
    }
    else {
      perform $Append(?stringP, ?partial)
    }
    set var index = index + 1
  }
  if partial sat $IsEmpty() {
    let final = "[]"
  }
  else {
    if state[[Gap]] is val {$"the empty String"()} {
      let properties = $"the empty String"()
      let first = true
      for_each part in partial {
        if first is val {true} -> set var first = false
        else -> set var properties = $"string-concatenation"(properties, $CodeUnit(cu(44, "002C", "COMMA")))
        set var properties = $"string-concatenation"(properties, part)
      }
      let final = $"string-concatenation"("[", properties, "]")
    }
    else {
      let separator = $"string-concatenation"($CodeUnit(cu(44, "002C", "COMMA")), $CodeUnit(cu(10, "000A", "LINE FEED")), state[[Indent]])
      let properties = $"the empty String"()
      let first = true
      for_each part in partial {
        if first is val {true} -> set var first = false
        else -> set var properties = $"string-concatenation"(properties, separator)
        set var properties = $"string-concatenation"(properties, part)
      }
      let final = $"string-concatenation"("[", $CodeUnit(cu(10, "000A", "LINE FEED")), state[[Indent]], properties, $CodeUnit(cu(10, "000A", "LINE FEED")), stepBack, "]")
    }
  }
  perform $RemoveLast(state[[Stack]])
  set field state[[Indent]] = stepBack
  return final
}

def @sec-resolveasyncwaiter "ResolveAsyncWaiter" (kind ao params [waiterRecord : #"Waiter Record"] -> val(~unused~)) vars [waiterRecord, entry, promiseCapability] {
  assert @sec-agentsignifier() is val {waiterRecord[[AgentSignifier]]}
  let entry = waiterRecord[[AbortRegistration]]
  if entry is not val {~empty~} -> perform @sec-removeabortalgorithm(entry)
  let promiseCapability = waiterRecord[[PromiseCapability]]
  perform ! @sec-call(promiseCapability[[Resolve]], undefined, [waiterRecord[[Result]]])
  return ~unused~
}

sdo_row @sec-static-semantics-jsonarrayliteralcontentnodes JSONArrayLiteralContentNodes form alg {
  prods [p"Syntactic 0 ArrayLiteral : `[` Elision? `]`", p"Syntactic 1 ArrayLiteral : `[` Elision? `]`", p"Syntactic - ArrayLiteral : `[` ElementList[?Yield, ?Await] `]`", p"Syntactic 0 ArrayLiteral : `[` ElementList[?Yield, ?Await] `,` Elision? `]`", p"Syntactic 1 ArrayLiteral : `[` ElementList[?Yield, ?Await] `,` Elision? `]`"]
  keys ["\n          ArrayLiteral :\n            `[` Elision? `]`\n            `[` ElementList `]`\n            `[` ElementList `,` Elision? `]`\n        "]
  vars []
  steps {
    assert child 5 |Elision| fails $Present()
    if child 5 |ElementList| fails $Present() -> return $ListNew()
    return sdo JSONArrayLiteralContentNodes(child 5 |ElementList|)
  }
}

sdo_row @sec-static-semantics-jsonarrayliteralcontentnodes#1 JSONArrayLiteralContentNodes form alg {
  prods [p"Syntactic 0 ElementList : Elision? AssignmentExpression[+In, ?Yield, ?Await]", p"Syntactic 1 ElementList : Elision? AssignmentExpression[+In, ?Yield, ?Await]"]
  keys ["ElementList : Elision? AssignmentExpression"]
  vars []
  steps {
    assert child 5 |Elision| fails $Present()
    return [child 5 |AssignmentExpression|]
  }
}

sdo_row @sec-static-semantics-jsonarrayliteralcontentnodes#2 JSONArrayLiteralContentNodes form alg {
  prods [p"Syntactic 0 ElementList : ElementList[?Yield, ?Await] `,` Elision? AssignmentExpression[+In, ?Yield, ?Await]", p"Syntactic 1 ElementList : ElementList[?Yield, ?Await] `,` Elision? AssignmentExpression[+In, ?Yield, ?Await]"]
  keys ["ElementList : ElementList `,` Elision? AssignmentExpression"]
  vars [elements]
  steps {
    assert child 5 |Elision| fails $Present()
    let elements = sdo JSONArrayLiteralContentNodes(child 3 |ElementList|)
    return $ListConcat([elements, [child 5 |AssignmentExpression|]])
  }
}

sdo_row @sec-static-semantics-jsonarrayliteralcontentnodes#3 JSONArrayLiteralContentNodes form alg {
  prods [p"Syntactic 0 ElementList : Elision? SpreadElement[?Yield, ?Await]", p"Syntactic 1 ElementList : Elision? SpreadElement[?Yield, ?Await]", p"Syntactic 0 ElementList : ElementList[?Yield, ?Await] `,` Elision? SpreadElement[?Yield, ?Await]", p"Syntactic 1 ElementList : ElementList[?Yield, ?Await] `,` Elision? SpreadElement[?Yield, ?Await]"]
  keys ["\n          ElementList :\n            Elision? SpreadElement\n            ElementList `,` Elision? SpreadElement\n        "]
  vars []
  steps {
    note "JSON text as specified in ECMA-404 does not include |SpreadElement|."
    unreachable 0
  }
}

