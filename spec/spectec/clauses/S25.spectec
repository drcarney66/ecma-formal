  if @sec-issharedarraybuffer(#"obj") is val {false} -> throw @ph-new-error([[TypeError]])
  if @sec-isfixedlengtharraybuffer(#"obj") is val {true} {
    let length = #"obj"[[ArrayBufferByteLength]]
  }
  else {
    let length = #"obj"[[ArrayBufferMaxByteLength]]
  }
  return $𝔽(length)
}

def @sec-sharedarraybuffer.prototype.slice "SharedArrayBuffer.prototype.slice" (kind builtin params [start, end]) vars [#"this value", NewTarget, start, end, #"obj", length, first, final, newLength, ctor, #"new", fromBlock, toBlock] {
  let #"obj" = this_value
  perform ? @sec-requireinternalslot(#"obj", [[ArrayBufferData]])
  if @sec-issharedarraybuffer(#"obj") is val {false} -> throw @ph-new-error([[TypeError]])
  let length = @sec-arraybufferbytelength(#"obj", ~seq-cst~)
  let first = ? @sec-toclampedindex(start, length)
  if_else end is val {undefined} { let final = length } else { let final = ? @sec-toclampedindex(end, length) }
  let newLength = $max(final - first, 0)
  let ctor = ? @sec-speciesconstructor(#"obj", intrinsic [[SharedArrayBuffer]])
  let #"new" = ? @sec-construct(ctor, [$𝔽(newLength)])
  perform ? @sec-requireinternalslot(#"new", [[ArrayBufferData]])
  if @sec-issharedarraybuffer(#"new") is val {false} -> throw @ph-new-error([[TypeError]])
  if #"new"[[ArrayBufferData]] is val {#"obj"[[ArrayBufferData]]} -> throw @ph-new-error([[TypeError]])
  if @sec-arraybufferbytelength(#"new", ~seq-cst~) < newLength -> throw @ph-new-error([[TypeError]])
  let fromBlock = #"obj"[[ArrayBufferData]]
  let toBlock = #"new"[[ArrayBufferData]]
  perform @sec-copydatablockbytes(toBlock, 0, fromBlock, first, newLength)
  return #"new"
}

def @sec-makedataviewwithbufferwitnessrecord "MakeDataViewWithBufferWitnessRecord" (kind ao params [#"obj" : DataView, #"order" : val(~seq-cst~) | val(~unordered~)] -> #"DataView With Buffer Witness Record") vars [#"obj", #"order", buffer, byteLength] {
  let buffer = #"obj"[[ViewedArrayBuffer]]
  if @sec-isdetachedbuffer(buffer) is val {true} {
    let byteLength = ~detached~
  }
  else {
    let byteLength = @sec-arraybufferbytelength(buffer, #"order")
  }
  return record #"DataView With Buffer Witness Record" { [[Object]]: #"obj", [[CachedBufferByteLength]]: byteLength }
}

def @sec-getviewbytelength "GetViewByteLength" (kind ao params [viewRecord : #"DataView With Buffer Witness Record"] -> sort [#"non-negative"] integer) vars [viewRecord, view, byteOffset, byteLength] {
  assert @sec-isviewoutofbounds(viewRecord) is val {false}
  let view = viewRecord[[Object]]
  if view[[ByteLength]] is not val {~auto~} -> return view[[ByteLength]]
  assert @sec-isfixedlengtharraybuffer(view[[ViewedArrayBuffer]]) is val {false}
  let byteOffset = view[[ByteOffset]]
  let byteLength = viewRecord[[CachedBufferByteLength]]
  assert byteLength is not val {~detached~}
  return byteLength - byteOffset
}

def @sec-isviewoutofbounds "IsViewOutOfBounds" (kind ao params [viewRecord : #"DataView With Buffer Witness Record"] -> Boolean) vars [viewRecord, view, bufferByteLength, byteOffsetStart, byteOffsetEnd] {
  let view = viewRecord[[Object]]
  let bufferByteLength = viewRecord[[CachedBufferByteLength]]
  if @sec-isdetachedbuffer(view[[ViewedArrayBuffer]]) is val {true} {
    assert bufferByteLength is val {~detached~}
    return true
  }
  assert bufferByteLength is ty {sort [#"non-negative"] integer}
  let byteOffsetStart = view[[ByteOffset]]
  if view[[ByteLength]] is val {~auto~} {
    let byteOffsetEnd = bufferByteLength
  }
  else {
    let byteOffsetEnd = byteOffsetStart + view[[ByteLength]]
  }
  note "A 0-length DataView whose [[ByteOffset]] is _bufferByteLength_ is not considered out-of-bounds."
  if byteOffsetStart > bufferByteLength or byteOffsetEnd > bufferByteLength -> return true
  return false
}

def @sec-getviewvalue "GetViewValue" (kind ao params [view : #"ECMAScript language value", requestIndex : #"ECMAScript language value", isLittleEndian : #"ECMAScript language value", type : #"TypedArray element type"] -> completion<Number | BigInt> | #"throw completion") vars [view, requestIndex, isLittleEndian, type, getIndex, viewOffset, viewRecord, viewSize, elementSize, bufferIndex] {
  perform ? @sec-requireinternalslot(view, [[DataView]])
  assert view sat $HasSlot([[ViewedArrayBuffer]])
  let getIndex = ? @sec-toindex(requestIndex)
  set var isLittleEndian = @sec-toboolean(isLittleEndian)
  let viewOffset = view[[ByteOffset]]
  let viewRecord = @sec-makedataviewwithbufferwitnessrecord(view, ~unordered~)
  note "Bounds checking is not a synchronizing operation when _view_'s backing buffer is a growable SharedArrayBuffer."
  if @sec-isviewoutofbounds(viewRecord) is val {true} -> throw @ph-new-error([[TypeError]])
  let viewSize = @sec-getviewbytelength(viewRecord)
  let elementSize = $TableLookup(table t"table-the-typedarray-constructors", code "Element Size", code "Element Type", ?type)
  if getIndex + elementSize > viewSize -> throw @ph-new-error([[RangeError]])
  let bufferIndex = getIndex + viewOffset
  return @sec-getvaluefrombuffer(view[[ViewedArrayBuffer]], bufferIndex, type, false, ~unordered~, isLittleEndian)
}

def @sec-setviewvalue "SetViewValue" (kind ao params [view : #"ECMAScript language value", requestIndex : #"ECMAScript language value", isLittleEndian : #"ECMAScript language value", type : #"TypedArray element type", value : #"ECMAScript language value"] -> completion<val(~unused~)> | #"throw completion") vars [view, requestIndex, isLittleEndian, type, value, getIndex, number, viewOffset, viewRecord, viewSize, elementSize, bufferIndex] {
  perform ? @sec-requireinternalslot(view, [[DataView]])
  assert view sat $HasSlot([[ViewedArrayBuffer]])
  let getIndex = ? @sec-toindex(requestIndex)
  if @sec-isbigintelementtype(type) is val {true} -> let number = ? @sec-tobigint(value)
  else -> let number = ? @sec-tonumber(value)
  set var isLittleEndian = @sec-toboolean(isLittleEndian)
  let viewOffset = view[[ByteOffset]]
  let viewRecord = @sec-makedataviewwithbufferwitnessrecord(view, ~unordered~)
  note "Bounds checking is not a synchronizing operation when _view_'s backing buffer is a growable SharedArrayBuffer."
  if @sec-isviewoutofbounds(viewRecord) is val {true} -> throw @ph-new-error([[TypeError]])
  let viewSize = @sec-getviewbytelength(viewRecord)
  let elementSize = $TableLookup(table t"table-the-typedarray-constructors", code "Element Size", code "Element Type", ?type)
  if getIndex + elementSize > viewSize -> throw @ph-new-error([[RangeError]])
  let bufferIndex = getIndex + viewOffset
  perform @sec-setvalueinbuffer(view[[ViewedArrayBuffer]], bufferIndex, type, number, false, ~unordered~, isLittleEndian)
  return ~unused~
}

def @sec-dataview-buffer-byteoffset-bytelength "DataView" (kind builtin params [buffer, byteOffset opt, byteLength opt]) vars [#"this value", NewTarget, buffer, byteOffset, byteLength, offset, bufferByteLength, bufferIsFixedLength, viewByteLength, #"obj"] {
  if new_target is val {undefined} -> throw @ph-new-error([[TypeError]])
  perform ? @sec-requireinternalslot(buffer, [[ArrayBufferData]])
  let offset = ? @sec-toindex(byteOffset)
  if @sec-isdetachedbuffer(buffer) is val {true} -> throw @ph-new-error([[TypeError]])
  let bufferByteLength = @sec-arraybufferbytelength(buffer, ~seq-cst~)
  if offset > bufferByteLength -> throw @ph-new-error([[RangeError]])
  let bufferIsFixedLength = @sec-isfixedlengtharraybuffer(buffer)
  if byteLength is val {undefined} {
    if bufferIsFixedLength is val {true} {
      let viewByteLength = bufferByteLength - offset
    }
    else {
      let viewByteLength = ~auto~
    }
  }
  else {
    let viewByteLength = ? @sec-toindex(byteLength)
    if offset + viewByteLength > bufferByteLength -> throw @ph-new-error([[RangeError]])
  }
  let #"obj" = ? @sec-ordinarycreatefromconstructor(new_target, "%DataView.prototype%", [[[DataView]], [[ViewedArrayBuffer]], [[ByteLength]], [[ByteOffset]]])
  if @sec-isdetachedbuffer(buffer) is val {true} -> throw @ph-new-error([[TypeError]])
  set var bufferByteLength = @sec-arraybufferbytelength(buffer, ~seq-cst~)
  if offset > bufferByteLength -> throw @ph-new-error([[RangeError]])
  if byteLength is not val {undefined} {
    if offset + viewByteLength > bufferByteLength -> throw @ph-new-error([[RangeError]])
  }
  set field #"obj"[[ViewedArrayBuffer]] = buffer
  set field #"obj"[[ByteLength]] = viewByteLength
  set field #"obj"[[ByteOffset]] = offset
  return #"obj"
}

