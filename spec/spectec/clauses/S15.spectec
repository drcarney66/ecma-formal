sdo_row @sec-runtime-semantics-definemethod DefineMethod form alg {
  prods [p"Syntactic - MethodDefinition : ClassElementName[?Yield, ?Await] `(` UniqueFormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`"]
  keys ["MethodDefinition : ClassElementName `(` UniqueFormalParameters `)` `{` FunctionBody `}`"]
  vars [#"obj", proto, propertyKey, envRecord, privateEnv, sourceText, #"closure"]
  steps {
    let propertyKey = ? sdo Evaluation(child 5 |ClassElementName|)
    let envRecord = $Component($Running(), [[LexicalEnvironment]])
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    if proto fails $Present() -> set var proto = intrinsic [[Function.prototype]]
    let sourceText = $SourceText(child 6 |MethodDefinition|)
    let #"closure" = @sec-ordinaryfunctioncreate(proto, sourceText, child 5 |UniqueFormalParameters|, child 5 |FunctionBody|, ~non-lexical-this~, envRecord, privateEnv)
    perform @sec-makemethod(#"closure", #"obj")
    return record Record { [[Key]]: propertyKey, [[Closure]]: #"closure" }
  }
}

sdo_row @sec-runtime-semantics-methoddefinitionevaluation MethodDefinitionEvaluation form alg {
  prods [p"Syntactic - MethodDefinition : ClassElementName[?Yield, ?Await] `(` UniqueFormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`"]
  keys ["MethodDefinition : ClassElementName `(` UniqueFormalParameters `)` `{` FunctionBody `}`"]
  vars [#"obj", enumerable, methodDef]
  steps {
    let methodDef = ? sdo DefineMethod(child 6 |MethodDefinition|; #"obj")
    perform @sec-setfunctionname(methodDef[[Closure]], methodDef[[Key]])
    return ? @sec-definemethodproperty(#"obj", methodDef[[Key]], methodDef[[Closure]], enumerable)
  }
}

sdo_row @sec-runtime-semantics-methoddefinitionevaluation#1 MethodDefinitionEvaluation form alg {
  prods [p"Syntactic - MethodDefinition : `get` ClassElementName[?Yield, ?Await] `(` `)` `{` FunctionBody[~Yield, ~Await] `}`"]
  keys ["MethodDefinition : `get` ClassElementName `(` `)` `{` FunctionBody `}`"]
  vars [#"obj", enumerable, propertyKey, envRecord, privateEnv, sourceText, formalParamList, #"closure", propertyDesc]
  steps {
    let propertyKey = ? sdo Evaluation(child 5 |ClassElementName|)
    let envRecord = $Component($Running(), [[LexicalEnvironment]])
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    let sourceText = $SourceText(child 6 |MethodDefinition|)
    let formalParamList = $ParseGoal([], |FormalParameters|, false, false, false)
    assert expr $InstanceOf(formalParamList, prods [p"Syntactic - FormalParameters : [empty]"])
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[Function.prototype]], sourceText, formalParamList, child 5 |FunctionBody|, ~non-lexical-this~, envRecord, privateEnv)
    perform @sec-makemethod(#"closure", #"obj")
    perform @sec-setfunctionname(#"closure", propertyKey, "get")
    if propertyKey is ty {#"Private Name"} {
      return record PrivateElement { [[Key]]: propertyKey, [[Kind]]: ~accessor~, [[Getter]]: #"closure", [[Setter]]: undefined }
    }
    let propertyDesc = record PropertyDescriptor { [[Getter]]: #"closure", [[Enumerable]]: enumerable, [[Configurable]]: true }
    perform ? @sec-definepropertyorthrow(#"obj", propertyKey, propertyDesc)
    return ~empty~
  }
}

sdo_row @sec-runtime-semantics-methoddefinitionevaluation#2 MethodDefinitionEvaluation form alg {
  prods [p"Syntactic - MethodDefinition : `set` ClassElementName[?Yield, ?Await] `(` PropertySetParameterList `)` `{` FunctionBody[~Yield, ~Await] `}`"]
  keys ["MethodDefinition : `set` ClassElementName `(` PropertySetParameterList `)` `{` FunctionBody `}`"]
  vars [#"obj", enumerable, propertyKey, envRecord, privateEnv, sourceText, #"closure", propertyDesc]
  steps {
    let propertyKey = ? sdo Evaluation(child 5 |ClassElementName|)
    let envRecord = $Component($Running(), [[LexicalEnvironment]])
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    let sourceText = $SourceText(child 6 |MethodDefinition|)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[Function.prototype]], sourceText, child 5 |PropertySetParameterList|, child 5 |FunctionBody|, ~non-lexical-this~, envRecord, privateEnv)
    perform @sec-makemethod(#"closure", #"obj")
    perform @sec-setfunctionname(#"closure", propertyKey, "set")
    if propertyKey is ty {#"Private Name"} {
      return record PrivateElement { [[Key]]: propertyKey, [[Kind]]: ~accessor~, [[Getter]]: undefined, [[Setter]]: #"closure" }
    }
    let propertyDesc = record PropertyDescriptor { [[Setter]]: #"closure", [[Enumerable]]: enumerable, [[Configurable]]: true }
    perform ? @sec-definepropertyorthrow(#"obj", propertyKey, propertyDesc)
    return ~empty~
  }
}

sdo_row @sec-runtime-semantics-methoddefinitionevaluation#3 MethodDefinitionEvaluation form alg {
  prods [p"Syntactic - GeneratorMethod : `*` ClassElementName[?Yield, ?Await] `(` UniqueFormalParameters[+Yield, ~Await] `)` `{` GeneratorBody `}`"]
  keys ["GeneratorMethod : `*` ClassElementName `(` UniqueFormalParameters `)` `{` GeneratorBody `}`"]
  vars [#"obj", enumerable, propertyKey, envRecord, privateEnv, sourceText, #"closure", proto]
  steps {
    let propertyKey = ? sdo Evaluation(child 5 |ClassElementName|)
    let envRecord = $Component($Running(), [[LexicalEnvironment]])
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    let sourceText = $SourceText(child 6 |GeneratorMethod|)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[GeneratorFunction.prototype]], sourceText, child 5 |UniqueFormalParameters|, child 5 |GeneratorBody|, ~non-lexical-this~, envRecord, privateEnv)
    perform @sec-makemethod(#"closure", #"obj")
    perform @sec-setfunctionname(#"closure", propertyKey)
    let proto = @sec-ordinaryobjectcreate(intrinsic [[GeneratorPrototype]])
    perform ! @sec-definepropertyorthrow(#"closure", "prototype", record PropertyDescriptor { [[Value]]: proto, [[Writable]]: true, [[Enumerable]]: false, [[Configurable]]: false })
    return ? @sec-definemethodproperty(#"obj", propertyKey, #"closure", enumerable)
  }
}

