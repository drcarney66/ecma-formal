  keys ["OptionalChain : `?.` PrivateIdentifier"]
  vars [names]
  steps {
    if names sat $Contains(sdo StringValue(child 5 |PrivateIdentifier|)) -> return true
    return false
  }
}

sdo_row @sec-static-semantics-allprivateidentifiersvalid#4 AllPrivateIdentifiersValid form alg {
  prods [p"Syntactic - OptionalChain : OptionalChain[?Yield, ?Await] `.` PrivateIdentifier"]
