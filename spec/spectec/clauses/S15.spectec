}

sdo_row @sec-static-semantics-nonconstructorelements NonConstructorElements form alg {
  prods [p"Syntactic - ClassElementList : ClassElement[?Yield, ?Await]"]
  keys ["ClassElementList : ClassElement"]
  vars []
  steps {
    if sdo ClassElementKind(child 5 |ClassElement|) is val {~non-constructor-method~} {
      return [child 5 |ClassElement|]
    }
    return $ListNew()
  }
}

sdo_row @sec-static-semantics-nonconstructorelements#1 NonConstructorElements form alg {
  prods [p"Syntactic - ClassElementList : ClassElementList[?Yield, ?Await] ClassElement[?Yield, ?Await]"]
  keys ["ClassElementList : ClassElementList ClassElement"]
  vars [#"list"]
  steps {
    let #"list" = sdo NonConstructorElements(child 5 |ClassElementList|)
    if sdo ClassElementKind(child 5 |ClassElement|) is val {~non-constructor-method~} {
      perform $Append(child 5 |ClassElement|, ?#"list")
    }
    return #"list"
  }
}

sdo_row @sec-static-semantics-prototypepropertynamelist PrototypePropertyNameList form alg {
  prods [p"Syntactic - ClassElementList : ClassElement[?Yield, ?Await]"]
  keys ["ClassElementList : ClassElement"]
  vars [propertyName]
  steps {
    let propertyName = sdo PropName(child 5 |ClassElement|)
    if propertyName is val {~empty~} -> return $ListNew()
    if sdo IsStatic(child 5 |ClassElement|) is val {true} -> return $ListNew()
    return [propertyName]
  }
}

sdo_row @sec-static-semantics-prototypepropertynamelist#1 PrototypePropertyNameList form alg {
  prods [p"Syntactic - ClassElementList : ClassElementList[?Yield, ?Await] ClassElement[?Yield, ?Await]"]
  keys ["ClassElementList : ClassElementList ClassElement"]
  vars [#"list", propertyName]
  steps {
    let #"list" = sdo PrototypePropertyNameList(child 5 |ClassElementList|)
    let propertyName = sdo PropName(child 5 |ClassElement|)
    if propertyName is val {~empty~} -> return #"list"
    if sdo IsStatic(child 5 |ClassElement|) is val {true} -> return #"list"
    return $ListConcat([#"list", [propertyName]])
  }
}

sdo_row @sec-static-semantics-allprivateidentifiersvalid#1 AllPrivateIdentifiersValid form alg {
  prods [p"Syntactic - MemberExpression : MemberExpression[?Yield, ?Await] `.` PrivateIdentifier"]
  keys ["MemberExpression : MemberExpression `.` PrivateIdentifier"]
  vars [names]
  steps {
    if names sat $Contains(sdo StringValue(child 5 |PrivateIdentifier|)) {
      return sdo AllPrivateIdentifiersValid(child 5 |MemberExpression|; names)
    }
    return false
  }
}

sdo_row @sec-static-semantics-allprivateidentifiersvalid#2 AllPrivateIdentifiersValid form alg {
