  prods [p"Syntactic - FunctionDeclaration : `function` BindingIdentifier[?Yield, ?Await] `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`", p"Syntactic - FunctionDeclaration : [+Default] `function` `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`", p"Syntactic 0 FunctionExpression : `function` BindingIdentifier[~Yield, ~Await]? `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`", p"Syntactic 1 FunctionExpression : `function` BindingIdentifier[~Yield, ~Await]? `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`", p"Syntactic - GeneratorDeclaration : `function` `*` BindingIdentifier[?Yield, ?Await] `(` FormalParameters[+Yield, ~Await] `)` `{` GeneratorBody `}`", p"Syntactic - GeneratorDeclaration : [+Default] `function` `*` `(` FormalParameters[+Yield, ~Await] `)` `{` GeneratorBody `}`", p"Syntactic 0 GeneratorExpression : `function` `*` BindingIdentifier[+Yield, ~Await]? `(` FormalParameters[+Yield, ~Await] `)` `{` GeneratorBody `}`", p"Syntactic 1 GeneratorExpression : `function` `*` BindingIdentifier[+Yield, ~Await]? `(` FormalParameters[+Yield, ~Await] `)` `{` GeneratorBody `}`", p"Syntactic - AsyncGeneratorDeclaration : `async` [no LineTerminator here] `function` `*` BindingIdentifier[?Yield, ?Await] `(` FormalParameters[+Yield, +Await] `)` `{` AsyncGeneratorBody `}`", p"Syntactic - AsyncGeneratorDeclaration : [+Default] `async` [no LineTerminator here] `function` `*` `(` FormalParameters[+Yield, +Await] `)` `{` AsyncGeneratorBody `}`", p"Syntactic 0 AsyncGeneratorExpression : `async` [no LineTerminator here] `function` `*` BindingIdentifier[+Yield, +Await]? `(` FormalParameters[+Yield, +Await] `)` `{` AsyncGeneratorBody `}`", p"Syntactic 1 AsyncGeneratorExpression : `async` [no LineTerminator here] `function` `*` BindingIdentifier[+Yield, +Await]? `(` FormalParameters[+Yield, +Await] `)` `{` AsyncGeneratorBody `}`", p"Syntactic - AsyncFunctionDeclaration : `async` [no LineTerminator here] `function` BindingIdentifier[?Yield, ?Await] `(` FormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`", p"Syntactic - AsyncFunctionDeclaration : [+Default] `async` [no LineTerminator here] `function` `(` FormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`", p"Syntactic 0 AsyncFunctionExpression : `async` [no LineTerminator here] `function` BindingIdentifier[~Yield, +Await]? `(` FormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`", p"Syntactic 1 AsyncFunctionExpression : `async` [no LineTerminator here] `function` BindingIdentifier[~Yield, +Await]? `(` FormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`"]
  keys ["\n        FunctionDeclaration :\n          `function` BindingIdentifier `(` FormalParameters `)` `{` FunctionBody `}`\n          `function` `(` FormalParameters `)` `{` FunctionBody `}`\n\n        FunctionExpression :\n          `function` BindingIdentifier? `(` FormalParameters `)` `{` FunctionBody `}`\n\n        GeneratorDeclaration :\n          `function` `*` BindingIdentifier `(` FormalParameters `)` `{` GeneratorBody `}`\n          `function` `*` `(` FormalParameters `)` `{` GeneratorBody `}`\n\n        GeneratorExpression :\n          `function` `*` BindingIdentifier? `(` FormalParameters `)` `{` GeneratorBody `}`\n\n        AsyncGeneratorDeclaration :\n          `async` `function` `*` BindingIdentifier `(` FormalParameters `)` `{` AsyncGeneratorBody `}`\n          `async` `function` `*` `(` FormalParameters `)` `{` AsyncGeneratorBody `}`\n\n        AsyncGeneratorExpression :\n          `async` `function` `*` BindingIdentifier? `(` FormalParameters `)` `{` AsyncGeneratorBody `}`\n\n        AsyncFunctionDeclaration :\n          `async` `function` BindingIdentifier `(` FormalParameters `)` `{` AsyncFunctionBody `}`\n          `async` `function` `(` FormalParameters `)` `{` AsyncFunctionBody `}`\n\n        AsyncFunctionExpression :\n          `async` `function` BindingIdentifier? `(` FormalParameters `)` `{` AsyncFunctionBody `}`\n      "]
  vars []
  steps {
    return false
  }
}

sdo_row @sec-static-semantics-containsarguments#3 ContainsArguments form alg {
  prods [p"Syntactic - MethodDefinition : ClassElementName[?Yield, ?Await] `(` UniqueFormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`", p"Syntactic - MethodDefinition : `get` ClassElementName[?Yield, ?Await] `(` `)` `{` FunctionBody[~Yield, ~Await] `}`", p"Syntactic - MethodDefinition : `set` ClassElementName[?Yield, ?Await] `(` PropertySetParameterList `)` `{` FunctionBody[~Yield, ~Await] `}`", p"Syntactic - GeneratorMethod : `*` ClassElementName[?Yield, ?Await] `(` UniqueFormalParameters[+Yield, ~Await] `)` `{` GeneratorBody `}`", p"Syntactic - AsyncGeneratorMethod : `async` [no LineTerminator here] `*` ClassElementName[?Yield, ?Await] `(` UniqueFormalParameters[+Yield, +Await] `)` `{` AsyncGeneratorBody `}`", p"Syntactic - AsyncMethod : `async` [no LineTerminator here] ClassElementName[?Yield, ?Await] `(` UniqueFormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`"]
  keys ["\n        MethodDefinition :\n          ClassElementName `(` UniqueFormalParameters `)` `{` FunctionBody `}`\n          `get` ClassElementName `(` `)` `{` FunctionBody `}`\n          `set` ClassElementName `(` PropertySetParameterList `)` `{` FunctionBody `}`\n\n        GeneratorMethod :\n          `*` ClassElementName `(` UniqueFormalParameters `)` `{` GeneratorBody `}`\n\n        AsyncGeneratorMethod :\n          `async` `*` ClassElementName `(` UniqueFormalParameters `)` `{` AsyncGeneratorBody `}`\n\n        AsyncMethod :\n          `async` ClassElementName `(` UniqueFormalParameters `)` `{` AsyncFunctionBody `}`\n      "]
  vars []
  steps {
    return sdo ContainsArguments(child 5 |ClassElementName|)
  }
