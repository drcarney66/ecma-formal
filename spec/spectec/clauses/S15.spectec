  keys ["\n        ClassElement :\n          MethodDefinition\n          `static` MethodDefinition\n      "]
  vars [#"obj"]
  steps {
    return ? sdo MethodDefinitionEvaluation(child 5 |MethodDefinition|; #"obj", false)
  }
}

sdo_row @sec-static-semantics-classelementevaluation#2 ClassElementEvaluation form alg {
  prods [p"Syntactic - ClassElement : ClassStaticBlock"]
  keys ["ClassElement : ClassStaticBlock"]
