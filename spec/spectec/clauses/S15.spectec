  steps {
    return sdo ClassStaticBlockDefinitionEvaluation(child 5 |ClassStaticBlock|; #"obj")
  }
}

sdo_row @sec-static-semantics-classelementevaluation#3 ClassElementEvaluation form alg {
  prods [p"Syntactic - ClassElement : `;`"]
  keys ["\n        ClassElement : `;`\n      "]
  vars [#"obj"]
  steps {
    return ~empty~
  }
}

sdo_row @sec-runtime-semantics-classdefinitionevaluation ClassDefinitionEvaluation form alg {
  prods [p"Syntactic 00 ClassTail : ClassHeritage[?Yield, ?Await]? `{` ClassBody[?Yield, ?Await]? `}`", p"Syntactic 01 ClassTail : ClassHeritage[?Yield, ?Await]? `{` ClassBody[?Yield, ?Await]? `}`", p"Syntactic 10 ClassTail : ClassHeritage[?Yield, ?Await]? `{` ClassBody[?Yield, ?Await]? `}`", p"Syntactic 11 ClassTail : ClassHeritage[?Yield, ?Await]? `{` ClassBody[?Yield, ?Await]? `}`"]
  keys ["ClassTail : ClassHeritage? `{` ClassBody? `}`"]
  vars [classBinding, className, sourceText, envRecord, classEnv, outerPrivateEnv, classPrivateEnv, description, privateName, name, protoParent, ctorParent, superclassRef, superclass, proto, ctor, defaultCtor, args, #"#the *this* value", #"#NewTarget", #"#the List of arguments that was passed to this function by [[Call]] or [[Construct]]", ctorFunc, func, result, ctorInfo, classElements, instancePrivateMethods, staticPrivateMethods, instanceFields, staticElements, classElement, element, container, existingElement, combined, #"method", elementRecord, values]
  steps {
    let envRecord = component [[LexicalEnvironment]] of $Running()
    let classEnv = @sec-newdeclarativeenvironment(envRecord)
    if classBinding is not val {undefined} {
      perform ! classEnv.CreateImmutableBinding(classBinding, true)
    }
    let outerPrivateEnv = $Component($Running(), [[PrivateEnvironment]])
    let classPrivateEnv = @sec-newprivateenvironment(outerPrivateEnv)
    if child 5 |ClassBody| sat $Present() {
      for_each description : String in sdo PrivateBoundIdentifiers(child 5 |ClassBody|) {
        if classPrivateEnv[[Names]] sat @ph-contains-such(data choice 0, data sort #"Private Name", ?privateName, closure 1) {
          assert pass "This is only possible for getter/setter pairs"
        }
        else {
          let name = @ph-new-private-name-whose-description(?description)
          perform $Append(?name, classPrivateEnv[[Names]])
        }
      }
    }
    if child 5 |ClassHeritage| fails $Present() {
      let protoParent = intrinsic [[Object.prototype]]
      let ctorParent = intrinsic [[Function.prototype]]
    }
    else {
      set field $Running()[[LexicalEnvironment]] = classEnv
      note "The running execution context's PrivateEnvironment is _outerPrivateEnv_ when evaluating |ClassHeritage|."
      let superclassRef = @sec-completion-ao(sdo Evaluation(child 5 |ClassHeritage|))
      set field $Running()[[LexicalEnvironment]] = envRecord
      let superclass = ? @sec-getvalue(? superclassRef)
      if superclass is val {null} {
        let protoParent = null
        let ctorParent = intrinsic [[Function.prototype]]
      }
      else_if @sec-isconstructor(superclass) is val {false} {
        throw @ph-new-error([[TypeError]])
      }
      else {
        let protoParent = ? @sec-get-o-p(superclass, "prototype")
        if protoParent is not ty {Object} and protoParent is not val {null} -> throw @ph-new-error([[TypeError]])
        let ctorParent = superclass
      }
    }
    let proto = @sec-ordinaryobjectcreate(protoParent)
    if child 5 |ClassBody| fails $Present() -> let ctor = ~empty~
    else -> let ctor = sdo ConstructorMethod(child 5 |ClassBody|)
    set field $Running()[[LexicalEnvironment]] = classEnv
    set field $Running()[[PrivateEnvironment]] = classPrivateEnv
    if ctor is val {~empty~} {
      let defaultCtor = closure 0
      let ctorFunc = @sec-createbuiltinfunction(defaultCtor, 0, className, [[[ConstructorKind]], [[SourceText]], [[PrivateMethods]], [[Fields]]], $CurrentRealm(), ctorParent)
    }
    else {
      let ctorInfo = ! sdo DefineMethod(ctor; proto, ctorParent)
      let ctorFunc = ctorInfo[[Closure]]
      perform @sec-makeclassconstructor(ctorFunc)
      perform @sec-setfunctionname(ctorFunc, className)
    }
    set field ctorFunc[[SourceText]] = sourceText
    perform @sec-makeconstructor(ctorFunc, false, proto)
    if child 5 |ClassHeritage| sat $Present() -> set field ctorFunc[[ConstructorKind]] = ~derived~
    perform ! @sec-definemethodproperty(proto, "constructor", ctorFunc, false)
    if child 5 |ClassBody| fails $Present() -> let classElements = $ListNew()
    else -> let classElements = sdo NonConstructorElements(child 5 |ClassBody|)
    let instancePrivateMethods = $ListNew()
    let staticPrivateMethods = $ListNew()
    let instanceFields = $ListNew()
    let staticElements = $ListNew()
    for_each classElement : |ClassElement| in classElements {
      if sdo IsStatic(classElement) is val {false} {
        let element = @sec-completion-ao(sdo ClassElementEvaluation(classElement; proto))
      }
      else {
        let element = @sec-completion-ao(sdo ClassElementEvaluation(classElement; ctorFunc))
      }
      if element is ty {#"abrupt completion"} {
        set field $Running()[[LexicalEnvironment]] = envRecord
        set field $Running()[[PrivateEnvironment]] = outerPrivateEnv
        return ? element
      }
      set var element = ! element
      if element is ty {PrivateElement} {
        assert element[[Kind]] is val {~method~; ~accessor~}
        if sdo IsStatic(classElement) is val {false} -> let container = instancePrivateMethods
        else -> let container = staticPrivateMethods
        let values = @ph-contains-such-binds(data choice 0, data sort PrivateElement, ?existingElement, closure 2, container)
        if $ListLen(values) == 1 or $ListLen(values) != 0 and expr $""() {
          let existingElement = values[0]
          assert expr @ph-both-are(element[[Kind]], existingElement[[Kind]], ~accessor~)
          if element[[Getter]] is val {undefined} {
            let combined = record PrivateElement { [[Key]]: element[[Key]], [[Kind]]: ~accessor~, [[Getter]]: existingElement[[Getter]], [[Setter]]: element[[Setter]] }
          }
          else {
            let combined = record PrivateElement { [[Key]]: element[[Key]], [[Kind]]: ~accessor~, [[Getter]]: element[[Getter]], [[Setter]]: existingElement[[Setter]] }
          }
          perform @ph-replace-in(?existingElement, ?container, ?combined)
        }
        else {
          perform $Append(?element, ?container)
        }
      }
      else_if element is ty {#"ClassFieldDefinition Record"} {
        if sdo IsStatic(classElement) is val {false} -> perform $Append(?element, ?instanceFields)
        else -> perform $Append(?element, ?staticElements)
      }
      else_if element is ty {#"ClassStaticBlockDefinition Record"} {
        perform $Append(?element, ?staticElements)
      }
      else {
        assert element is val {~empty~}
      }
    }
    set field $Running()[[LexicalEnvironment]] = envRecord
    if classBinding is not val {undefined} {
      perform ! classEnv.InitializeBinding(classBinding, ctorFunc)
    }
    set field ctorFunc[[PrivateMethods]] = instancePrivateMethods
    set field ctorFunc[[Fields]] = instanceFields
    for_each #"method" : PrivateElement in staticPrivateMethods {
      perform ! @sec-privatemethodoraccessoradd(ctorFunc, #"method")
    }
    for_each elementRecord in staticElements {
      if elementRecord is ty {#"ClassFieldDefinition Record"} {
        let result = @sec-completion-ao(@sec-definefield(ctorFunc, elementRecord))
      }
      else {
        assert elementRecord is ty {#"ClassStaticBlockDefinition Record"}
        let result = @sec-completion-ao(@sec-call(elementRecord[[BodyFunction]], ctorFunc))
      }
      if result is ty {#"abrupt completion"} {
        set field $Running()[[PrivateEnvironment]] = outerPrivateEnv
        return ? result
      }
    }
    set field $Running()[[PrivateEnvironment]] = outerPrivateEnv
    return ctorFunc
  }
  closure abstract params none captures [] frame (#"#the *this* value", #"#NewTarget", #"#the List of arguments that was passed to this function by [[Call]] or [[Construct]]") {
    let args = #"#the List of arguments that was passed to this function by [[Call]] or [[Construct]]"
    if #"#NewTarget" is val {undefined} -> throw @ph-new-error([[TypeError]])
    let ctorFunc = $ActiveFunction()
    if ctorFunc[[ConstructorKind]] is val {~derived~} {
      note "This branch behaves similarly to `constructor(...args) { super(...args); }`. The most notable distinction is that while the aforementioned ECMAScript source text observably calls the %Symbol.iterator% method on `%Array.prototype%`, this function does not."
      let func = ! ctorFunc[[GetPrototypeOf]]()
      if @sec-isconstructor(func) is val {false} -> throw @ph-new-error([[TypeError]])
      let result = ? @sec-construct(func, args, #"#NewTarget")
    }
    else {
      note "This branch behaves similarly to `constructor() {}`."
      let result = ? @sec-ordinarycreatefromconstructor(#"#NewTarget", "%Object.prototype%")
    }
    perform ? @sec-initializeinstanceelements(result, ctorFunc)
    return @sec-normalcompletion(result)
  }
  closure abstract params [privateName] captures [description] {
    return bool(privateName[[Description]] is val {description})
  }
  closure abstract params [existingElement] captures [element] {
    return bool(existingElement[[Key]] is val {element[[Key]]})
  }
}

sdo_row @sec-runtime-semantics-bindingclassdeclarationevaluation BindingClassDeclarationEvaluation form alg {
  prods [p"Syntactic - ClassDeclaration : `class` BindingIdentifier[?Yield, ?Await] ClassTail[?Yield, ?Await]"]
  keys ["ClassDeclaration : `class` BindingIdentifier ClassTail"]
  vars [className, sourceText, value, envRecord]
  steps {
    let className = sdo StringValue(child 5 |BindingIdentifier|)
    let sourceText = $SourceText(child 6 |ClassDeclaration|)
    let value = ? sdo ClassDefinitionEvaluation(child 5 |ClassTail|; className, className, sourceText)
    let envRecord = $Component($Running(), [[LexicalEnvironment]])
    perform ? @sec-initializeboundname(className, value, envRecord)
    return value
  }
}

sdo_row @sec-runtime-semantics-bindingclassdeclarationevaluation#1 BindingClassDeclarationEvaluation form alg {
  prods [p"Syntactic - ClassDeclaration : [+Default] `class` ClassTail[?Yield, ?Await]"]
  keys ["ClassDeclaration : `class` ClassTail"]
  vars [sourceText]
  steps {
    let sourceText = $SourceText(child 6 |ClassDeclaration|)
    return ? sdo ClassDefinitionEvaluation(child 5 |ClassTail|; undefined, "default", sourceText)
  }
}

sdo_row @sec-class-definitions-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - ClassDeclaration : `class` BindingIdentifier[?Yield, ?Await] ClassTail[?Yield, ?Await]"]
  keys ["ClassDeclaration : `class` BindingIdentifier ClassTail"]
  vars []
  steps {
    perform ? sdo BindingClassDeclarationEvaluation(call_at @ph-this-nt(|ClassDeclaration|))
    return ~empty~
  }
}

sdo_row @sec-class-definitions-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic 0 ClassExpression : `class` BindingIdentifier[?Yield, ?Await]? ClassTail[?Yield, ?Await]"]
  keys ["ClassExpression : `class` ClassTail"]
  vars [sourceText]
  steps {
    let sourceText = $SourceText(child 6 |ClassExpression|)
    return ? sdo ClassDefinitionEvaluation(child 5 |ClassTail|; undefined, $"the empty String"(), sourceText)
  }
}

sdo_row @sec-class-definitions-runtime-semantics-evaluation#2 Evaluation form alg {
  prods [p"Syntactic 1 ClassExpression : `class` BindingIdentifier[?Yield, ?Await]? ClassTail[?Yield, ?Await]"]
  keys ["ClassExpression : `class` BindingIdentifier ClassTail"]
  vars [className, sourceText]
  steps {
    let className = sdo StringValue(child 5 |BindingIdentifier|)
    let sourceText = $SourceText(child 6 |ClassExpression|)
    return ? sdo ClassDefinitionEvaluation(child 5 |ClassTail|; className, className, sourceText)
  }
}

sdo_row @sec-class-definitions-runtime-semantics-evaluation#3 Evaluation form alg {
  prods [p"Syntactic - ClassElementName : PrivateIdentifier"]
  keys ["ClassElementName : PrivateIdentifier"]
  vars [privateIdentifier, privateEnvRecord, names, privateName]
  steps {
    let privateIdentifier = sdo StringValue(child 5 |PrivateIdentifier|)
    let privateEnvRecord = $Component($Running(), [[PrivateEnvironment]])
    let names = privateEnvRecord[[Names]]
    assert expr @ph-exactly-one-private-name(?names, ?privateIdentifier)
    let privateName = @ph-elem-whose-tn(data sort #"Private Name", ?names, [[Description]], data choice 1, ?privateIdentifier)
    return privateName
  }
}

sdo_row @sec-class-definitions-runtime-semantics-evaluation#4 Evaluation form alg {
  prods [p"Syntactic 0 ClassStaticBlockStatementList : StatementList[~Yield, +Await, ~Return]?"]
  keys ["ClassStaticBlockStatementList : [empty]"]
  vars []
  steps {
    return undefined
  }
}

sdo_row @sec-runtime-semantics-instantiateasyncfunctiondeclaration InstantiateAsyncFunctionDeclaration form alg {
  prods [p"Syntactic - AsyncFunctionDeclaration : `async` [no LineTerminator here] `function` BindingIdentifier[?Yield, ?Await] `(` FormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`"]
  keys ["\n        AsyncFunctionDeclaration : `async` `function` BindingIdentifier `(` FormalParameters `)` `{` AsyncFunctionBody `}`\n      "]
  vars [envRecord, privateEnv, name, sourceText, #"closure"]
  steps {
    let name = sdo StringValue(child 5 |BindingIdentifier|)
    let sourceText = $SourceText(child 6 |AsyncFunctionDeclaration|)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[AsyncFunction.prototype]], sourceText, child 5 |FormalParameters|, child 5 |AsyncFunctionBody|, ~non-lexical-this~, envRecord, privateEnv)
    perform @sec-setfunctionname(#"closure", name)
    return #"closure"
  }
}

sdo_row @sec-runtime-semantics-instantiateasyncfunctiondeclaration#1 InstantiateAsyncFunctionDeclaration form alg {
  prods [p"Syntactic - AsyncFunctionDeclaration : [+Default] `async` [no LineTerminator here] `function` `(` FormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`"]
  keys ["\n        AsyncFunctionDeclaration : `async` `function` `(` FormalParameters `)` `{` AsyncFunctionBody `}`\n      "]
  vars [envRecord, privateEnv, sourceText, #"closure"]
  steps {
    let sourceText = $SourceText(child 6 |AsyncFunctionDeclaration|)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[AsyncFunction.prototype]], sourceText, child 5 |FormalParameters|, child 5 |AsyncFunctionBody|, ~non-lexical-this~, envRecord, privateEnv)
    perform @sec-setfunctionname(#"closure", "default")
    return #"closure"
  }
}

sdo_row @sec-runtime-semantics-instantiateasyncfunctionexpression InstantiateAsyncFunctionExpression form alg {
  prods [p"Syntactic 0 AsyncFunctionExpression : `async` [no LineTerminator here] `function` BindingIdentifier[~Yield, +Await]? `(` FormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`"]
  keys ["\n        AsyncFunctionExpression : `async` `function` `(` FormalParameters `)` `{` AsyncFunctionBody `}`\n      "]
  vars [name, envRecord, privateEnv, sourceText, #"closure"]
  steps {
    if name fails $Present() -> set var name = $"the empty String"()
    let envRecord = component [[LexicalEnvironment]] of $Running()
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    let sourceText = $SourceText(child 6 |AsyncFunctionExpression|)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[AsyncFunction.prototype]], sourceText, child 5 |FormalParameters|, child 5 |AsyncFunctionBody|, ~non-lexical-this~, envRecord, privateEnv)
    perform @sec-setfunctionname(#"closure", name)
    return #"closure"
  }
}

sdo_row @sec-runtime-semantics-instantiateasyncfunctionexpression#1 InstantiateAsyncFunctionExpression form alg {
  prods [p"Syntactic 1 AsyncFunctionExpression : `async` [no LineTerminator here] `function` BindingIdentifier[~Yield, +Await]? `(` FormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`"]
  keys ["\n        AsyncFunctionExpression : `async` `function` BindingIdentifier `(` FormalParameters `)` `{` AsyncFunctionBody `}`\n      "]
  vars [name, outerEnv, funcEnv, privateEnv, sourceText, #"closure"]
  steps {
    assert name fails $Present()
    set var name = sdo StringValue(child 5 |BindingIdentifier|)
    let outerEnv = component [[LexicalEnvironment]] of $Running()
    let funcEnv = @sec-newdeclarativeenvironment(outerEnv)
    perform ! funcEnv.CreateImmutableBinding(name, false)
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    let sourceText = $SourceText(child 6 |AsyncFunctionExpression|)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[AsyncFunction.prototype]], sourceText, child 5 |FormalParameters|, child 5 |AsyncFunctionBody|, ~non-lexical-this~, funcEnv, privateEnv)
    perform @sec-setfunctionname(#"closure", name)
    perform ! funcEnv.InitializeBinding(name, #"closure")
    return #"closure"
  }
}

sdo_row @sec-runtime-semantics-evaluateasyncfunctionbody EvaluateAsyncFunctionBody form alg {
  prods [p"Syntactic - AsyncFunctionBody : FunctionBody[~Yield, +Await]"]
  keys ["\n        AsyncFunctionBody : FunctionBody\n      "]
  vars [funcObj, argList, promiseCapability, #"completion"]
  steps {
    let promiseCapability = ! @sec-newpromisecapability(intrinsic [[Promise]])
    let #"completion" = @sec-completion-ao(@sec-functiondeclarationinstantiation(funcObj, argList))
    if #"completion" is ty {#"abrupt completion"} {
      perform ! @sec-call(promiseCapability[[Reject]], undefined, [#"completion"[[Value]]])
    }
    else {
      perform @sec-async-functions-abstract-operations-async-function-start(promiseCapability, child 5 |FunctionBody|)
    }
    return @sec-returncompletion(promiseCapability[[Promise]])
  }
}

sdo_row @sec-async-function-definitions-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic 0 AsyncFunctionExpression : `async` [no LineTerminator here] `function` BindingIdentifier[~Yield, +Await]? `(` FormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`", p"Syntactic 1 AsyncFunctionExpression : `async` [no LineTerminator here] `function` BindingIdentifier[~Yield, +Await]? `(` FormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`"]
  keys ["\n        AsyncFunctionExpression :\n          `async` `function` BindingIdentifier? `(` FormalParameters `)` `{` AsyncFunctionBody `}`\n      "]
  vars []
  steps {
    return sdo InstantiateAsyncFunctionExpression(child 6 |AsyncFunctionExpression|)
  }
}

sdo_row @sec-async-function-definitions-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - UnaryExpression : [+Await] CoverAwaitExpressionAndAwaitUsingDeclarationHead[?Yield]"]
  keys ["\n        UnaryExpression : CoverAwaitExpressionAndAwaitUsingDeclarationHead\n      "]
  vars [expr]
  steps {
    let expr = $CoveredBy(|AwaitExpression|, child 5 |CoverAwaitExpressionAndAwaitUsingDeclarationHead|)
    return ? sdo Evaluation(expr)
  }
}

sdo_row @sec-async-function-definitions-runtime-semantics-evaluation#2 Evaluation form alg {
  prods [p"Syntactic - AwaitExpression : `await` UnaryExpression[?Yield, +Await]"]
  keys ["\n        AwaitExpression : `await` UnaryExpression\n      "]
  vars [exprRef, value]
  steps {
    let exprRef = ? sdo Evaluation(child 5 |UnaryExpression|)
    let value = ? @sec-getvalue(exprRef)
    return ? @await(value)
  }
}

