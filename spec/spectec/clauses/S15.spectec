sdo_row @sec-runtime-semantics-evaluateasyncconcisebody EvaluateAsyncConciseBody form alg {
  prods [p"Syntactic - AsyncConciseBody : [lookahead != `{`] ExpressionBody[?In, +Await]"]
  keys ["\n        AsyncConciseBody : ExpressionBody\n      "]
  vars [funcObj, argList, promiseCapability, #"completion"]
  steps {
    let promiseCapability = ! @sec-newpromisecapability(intrinsic [[Promise]])
    let #"completion" = @sec-completion-ao(@sec-functiondeclarationinstantiation(funcObj, argList))
    if #"completion" is ty {#"abrupt completion"} {
      perform ! @sec-call(promiseCapability[[Reject]], undefined, [#"completion"[[Value]]])
    }
    else {
      perform @sec-async-functions-abstract-operations-async-function-start(promiseCapability, child 5 |ExpressionBody|)
    }
    return @sec-returncompletion(promiseCapability[[Promise]])
  }
}

sdo_row @sec-runtime-semantics-instantiateasyncarrowfunctionexpression InstantiateAsyncArrowFunctionExpression form alg {
  prods [p"Syntactic - AsyncArrowFunction : `async` [no LineTerminator here] AsyncArrowBindingIdentifier[?Yield] [no LineTerminator here] `=>` AsyncConciseBody[?In]"]
  keys ["\n        AsyncArrowFunction : `async` AsyncArrowBindingIdentifier `=>` AsyncConciseBody\n      "]
  vars [name, envRecord, privateEnv, sourceText, #"params", #"closure"]
  steps {
    if name fails $Present() -> set var name = $"the empty String"()
    let envRecord = component [[LexicalEnvironment]] of $Running()
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    let sourceText = $SourceText(child 6 |AsyncArrowFunction|)
    let #"params" = child 5 |AsyncArrowBindingIdentifier|
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[AsyncFunction.prototype]], sourceText, #"params", child 5 |AsyncConciseBody|, ~lexical-this~, envRecord, privateEnv)
    perform @sec-setfunctionname(#"closure", name)
    return #"closure"
  }
}

sdo_row @sec-runtime-semantics-instantiateasyncarrowfunctionexpression#1 InstantiateAsyncArrowFunctionExpression form alg {
  prods [p"Syntactic - AsyncArrowFunction : CoverCallExpressionAndAsyncArrowHead[?Yield, ?Await] [no LineTerminator here] `=>` AsyncConciseBody[?In]"]
  keys ["\n        AsyncArrowFunction : CoverCallExpressionAndAsyncArrowHead `=>` AsyncConciseBody\n      "]
  vars [name, envRecord, privateEnv, sourceText, head, #"params", #"closure"]
  steps {
    if name fails $Present() -> set var name = $"the empty String"()
    let envRecord = component [[LexicalEnvironment]] of $Running()
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    let sourceText = $SourceText(child 6 |AsyncArrowFunction|)
    let head = $CoveredBy(|AsyncArrowHead|, child 5 |CoverCallExpressionAndAsyncArrowHead|)
    let #"params" = $ChildOf(|ArrowFormalParameters|, ?head)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[AsyncFunction.prototype]], sourceText, #"params", child 5 |AsyncConciseBody|, ~lexical-this~, envRecord, privateEnv)
    perform @sec-setfunctionname(#"closure", name)
    return #"closure"
  }
}

sdo_row @sec-async-arrow-function-definitions-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - AsyncArrowFunction : `async` [no LineTerminator here] AsyncArrowBindingIdentifier[?Yield] [no LineTerminator here] `=>` AsyncConciseBody[?In]", p"Syntactic - AsyncArrowFunction : CoverCallExpressionAndAsyncArrowHead[?Yield, ?Await] [no LineTerminator here] `=>` AsyncConciseBody[?In]"]
  keys ["\n        AsyncArrowFunction :\n          `async` AsyncArrowBindingIdentifier `=>` AsyncConciseBody\n          CoverCallExpressionAndAsyncArrowHead `=>` AsyncConciseBody\n      "]
  vars []
  steps {
    return sdo InstantiateAsyncArrowFunctionExpression(child 6 |AsyncArrowFunction|)
  }
}

