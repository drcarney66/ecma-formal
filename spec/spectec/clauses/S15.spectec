sdo_row @sec-runtime-semantics-classfielddefinitionevaluation ClassFieldDefinitionEvaluation form alg {
  prods [p"Syntactic 0 FieldDefinition : ClassElementName[?Yield, ?Await] Initializer[+In, ?Yield, ?Await]?", p"Syntactic 1 FieldDefinition : ClassElementName[?Yield, ?Await] Initializer[+In, ?Yield, ?Await]?"]
  keys ["\n        FieldDefinition : ClassElementName Initializer?\n      "]
  vars [homeObj, name, formalParamList, envRecord, privateEnv, sourceText, initializer]
  steps {
    let name = ? sdo Evaluation(child 5 |ClassElementName|)
    if child 5 |Initializer| sat $Present() {
      let formalParamList = $ParseGoal([], |FormalParameters|, false, false, false)
      assert expr $InstanceOf(formalParamList, prods [p"Syntactic - FormalParameters : [empty]"])
      let envRecord = component [[LexicalEnvironment]] of $Running()
      let privateEnv = $Component($Running(), [[PrivateEnvironment]])
      let sourceText = $EmptyCodePoints()
      let initializer = @sec-ordinaryfunctioncreate(intrinsic [[Function.prototype]], sourceText, formalParamList, child 5 |Initializer|, ~non-lexical-this~, envRecord, privateEnv)
      perform @sec-makemethod(initializer, homeObj)
      set field initializer[[ClassFieldInitializerName]] = name
    }
    else {
      let initializer = ~empty~
    }
    return record #"ClassFieldDefinition Record" { [[Name]]: name, [[Initializer]]: initializer }
  }
}

sdo_row @sec-runtime-semantics-classstaticblockdefinitionevaluation ClassStaticBlockDefinitionEvaluation form alg {
  prods [p"Syntactic - ClassStaticBlock : `static` `{` ClassStaticBlockBody `}`"]
  keys ["ClassStaticBlock : `static` `{` ClassStaticBlockBody `}`"]
  vars [homeObj, lexicalEnv, privateEnv, sourceText, formalParams, bodyFunc]
  steps {
    let lexicalEnv = $Component($Running(), [[LexicalEnvironment]])
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    let sourceText = $EmptyCodePoints()
    let formalParams = $ParseGoal([], |FormalParameters|, false, false, false)
    assert expr $InstanceOf(formalParams, prods [p"Syntactic - FormalParameters : [empty]"])
    let bodyFunc = @sec-ordinaryfunctioncreate(intrinsic [[Function.prototype]], sourceText, formalParams, child 5 |ClassStaticBlockBody|, ~non-lexical-this~, lexicalEnv, privateEnv)
    perform @sec-makemethod(bodyFunc, homeObj)
    return record #"ClassStaticBlockDefinition Record" { [[BodyFunction]]: bodyFunc }
  }
}

sdo_row @sec-runtime-semantics-evaluateclassstaticblockbody EvaluateClassStaticBlockBody form alg {
  prods [p"Syntactic - ClassStaticBlockBody : ClassStaticBlockStatementList"]
  keys ["ClassStaticBlockBody : ClassStaticBlockStatementList"]
  vars [funcObj, result, envRecord]
  steps {
    assert pass "_ is a synthetic function created by ClassStaticBlockDefinitionEvaluation step <emu-xref href=\"#step-synthetic-class-static-block-fn\"></emu-xref>"
    perform ! @sec-functiondeclarationinstantiation(funcObj, [])
    let result = @sec-completion-ao(sdo Evaluation(child 5 |ClassStaticBlockStatementList|))
    let envRecord = $Component($Running(), [[LexicalEnvironment]])
    assert envRecord is ty {#"Declarative Environment Record"}
    perform ? @sec-disposeresources(envRecord[[DisposableResourceStack]], result)
    return @sec-returncompletion(undefined)
  }
}

