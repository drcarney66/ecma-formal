sdo_row @sec-static-semantics-functionbodycontainsusestrict FunctionBodyContainsUseStrict form alg {
  prods [p"Syntactic - FunctionBody : FunctionStatementList[?Yield, ?Await]"]
  keys ["FunctionBody : FunctionStatementList"]
  vars []
  steps {
    if expr @ph-use-strict(child 6 |FunctionBody|) -> return true
    return false
  }
}

sdo_row @sec-runtime-semantics-evaluatefunctionbody EvaluateFunctionBody form alg {
  prods [p"Syntactic - FunctionBody : FunctionStatementList[?Yield, ?Await]"]
  keys ["FunctionBody : FunctionStatementList"]
  vars [funcObj, argList]
  steps {
    perform ? @sec-functiondeclarationinstantiation(funcObj, argList)
    perform ? sdo Evaluation(child 5 |FunctionStatementList|)
    note "If the previous step resulted in a normal completion, then evaluation finished by proceeding past the end of the |FunctionStatementList|."
    return @sec-returncompletion(undefined)
  }
}

sdo_row @sec-runtime-semantics-instantiateordinaryfunctiondeclaration InstantiateOrdinaryFunctionDeclaration form alg {
  prods [p"Syntactic - FunctionDeclaration : `function` BindingIdentifier[?Yield, ?Await] `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`"]
  keys ["FunctionDeclaration : `function` BindingIdentifier `(` FormalParameters `)` `{` FunctionBody `}`"]
  vars [envRecord, privateEnv, name, sourceText, #"closure"]
  steps {
    let name = sdo StringValue(child 5 |BindingIdentifier|)
    let sourceText = $SourceText(child 6 |FunctionDeclaration|)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[Function.prototype]], sourceText, child 5 |FormalParameters|, child 5 |FunctionBody|, ~non-lexical-this~, envRecord, privateEnv)
    perform @sec-setfunctionname(#"closure", name)
    perform @sec-makeconstructor(#"closure")
    return #"closure"
  }
}

sdo_row @sec-runtime-semantics-instantiateordinaryfunctiondeclaration#1 InstantiateOrdinaryFunctionDeclaration form alg {
  prods [p"Syntactic - FunctionDeclaration : [+Default] `function` `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`"]
  keys ["FunctionDeclaration : `function` `(` FormalParameters `)` `{` FunctionBody `}`"]
  vars [envRecord, privateEnv, sourceText, #"closure"]
  steps {
    let sourceText = $SourceText(child 6 |FunctionDeclaration|)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[Function.prototype]], sourceText, child 5 |FormalParameters|, child 5 |FunctionBody|, ~non-lexical-this~, envRecord, privateEnv)
    perform @sec-setfunctionname(#"closure", "default")
    perform @sec-makeconstructor(#"closure")
    return #"closure"
  }
}

sdo_row @sec-runtime-semantics-instantiateordinaryfunctionexpression InstantiateOrdinaryFunctionExpression form alg {
  prods [p"Syntactic 0 FunctionExpression : `function` BindingIdentifier[~Yield, ~Await]? `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`"]
  keys ["FunctionExpression : `function` `(` FormalParameters `)` `{` FunctionBody `}`"]
  vars [name, envRecord, privateEnv, sourceText, #"closure"]
  steps {
    if name fails $Present() -> set var name = $"the empty String"()
    let envRecord = component [[LexicalEnvironment]] of $Running()
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    let sourceText = $SourceText(child 6 |FunctionExpression|)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[Function.prototype]], sourceText, child 5 |FormalParameters|, child 5 |FunctionBody|, ~non-lexical-this~, envRecord, privateEnv)
    perform @sec-setfunctionname(#"closure", name)
    perform @sec-makeconstructor(#"closure")
    return #"closure"
  }
}

sdo_row @sec-runtime-semantics-instantiateordinaryfunctionexpression#1 InstantiateOrdinaryFunctionExpression form alg {
  prods [p"Syntactic 1 FunctionExpression : `function` BindingIdentifier[~Yield, ~Await]? `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`"]
  keys ["FunctionExpression : `function` BindingIdentifier `(` FormalParameters `)` `{` FunctionBody `}`"]
  vars [name, outerEnv, funcEnv, privateEnv, sourceText, #"closure"]
  steps {
    assert name fails $Present()
    set var name = sdo StringValue(child 5 |BindingIdentifier|)
    let outerEnv = $Component($Running(), [[LexicalEnvironment]])
    let funcEnv = @sec-newdeclarativeenvironment(outerEnv)
    perform ! funcEnv.CreateImmutableBinding(name, false)
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    let sourceText = $SourceText(child 6 |FunctionExpression|)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[Function.prototype]], sourceText, child 5 |FormalParameters|, child 5 |FunctionBody|, ~non-lexical-this~, funcEnv, privateEnv)
    perform @sec-setfunctionname(#"closure", name)
    perform @sec-makeconstructor(#"closure")
    perform ! funcEnv.InitializeBinding(name, #"closure")
    return #"closure"
  }
}

sdo_row @sec-function-definitions-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic - FunctionDeclaration : `function` BindingIdentifier[?Yield, ?Await] `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`"]
  keys ["FunctionDeclaration : `function` BindingIdentifier `(` FormalParameters `)` `{` FunctionBody `}`"]
  vars [#"steps", result]
  steps {
    let #"steps" = $EvaluationStepsOf(this_node)
    if #"steps" is not val {~empty~} {
      let result = #"steps"()
      if result is ty {#"abrupt completion"} -> return result
    }
    return ~empty~
  }
}

sdo_row @sec-function-definitions-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - FunctionDeclaration : [+Default] `function` `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`"]
  keys ["FunctionDeclaration : `function` `(` FormalParameters `)` `{` FunctionBody `}`"]
