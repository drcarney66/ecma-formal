sdo_row @sec-static-semantics-classelementkind ClassElementKind form alg {
  prods [p"Syntactic - ClassElement : MethodDefinition[?Yield, ?Await]"]
  keys ["ClassElement : MethodDefinition"]
  vars []
  steps {
    if sdo PropName(child 5 |MethodDefinition|) is val {"constructor"} -> return ~constructor-method~
    return ~non-constructor-method~
  }
}

sdo_row @sec-static-semantics-classelementkind#1 ClassElementKind form alg {
  prods [p"Syntactic - ClassElement : `static` MethodDefinition[?Yield, ?Await]", p"Syntactic - ClassElement : FieldDefinition[?Yield, ?Await] `;`", p"Syntactic - ClassElement : `static` FieldDefinition[?Yield, ?Await] `;`"]
  keys ["\n        ClassElement :\n          `static` MethodDefinition\n          FieldDefinition `;`\n          `static` FieldDefinition `;`\n      "]
  vars []
  steps {
    return ~non-constructor-method~
  }
}

sdo_row @sec-static-semantics-classelementkind#2 ClassElementKind form alg {
  prods [p"Syntactic - ClassElement : ClassStaticBlock"]
  keys ["ClassElement : ClassStaticBlock"]
  vars []
  steps {
    return ~non-constructor-method~
  }
}

sdo_row @sec-static-semantics-classelementkind#3 ClassElementKind form alg {
  prods [p"Syntactic - ClassElement : `;`"]
  keys ["ClassElement : `;`"]
  vars []
  steps {
    return ~empty~
  }
}

sdo_row @sec-static-semantics-constructormethod ConstructorMethod form alg {
  prods [p"Syntactic - ClassElementList : ClassElement[?Yield, ?Await]"]
  keys ["ClassElementList : ClassElement"]
  vars []
  steps {
    if sdo ClassElementKind(child 5 |ClassElement|) is val {~constructor-method~} -> return child 5 |ClassElement|
    return ~empty~
  }
}

sdo_row @sec-static-semantics-constructormethod#1 ConstructorMethod form alg {
  prods [p"Syntactic - ClassElementList : ClassElementList[?Yield, ?Await] ClassElement[?Yield, ?Await]"]
  keys ["ClassElementList : ClassElementList ClassElement"]
  vars [head]
  steps {
    let head = sdo ConstructorMethod(child 5 |ClassElementList|)
    if head is not val {~empty~} -> return head
    if sdo ClassElementKind(child 5 |ClassElement|) is val {~constructor-method~} -> return child 5 |ClassElement|
    return ~empty~
  }
}

sdo_row @sec-static-semantics-isstatic IsStatic form alg {
  prods [p"Syntactic - ClassElement : MethodDefinition[?Yield, ?Await]"]
  keys ["ClassElement : MethodDefinition"]
  vars []
  steps {
    return false
  }
}

sdo_row @sec-static-semantics-isstatic#1 IsStatic form alg {
  prods [p"Syntactic - ClassElement : `static` MethodDefinition[?Yield, ?Await]"]
  keys ["ClassElement : `static` MethodDefinition"]
  vars []
  steps {
    return true
  }
}

sdo_row @sec-static-semantics-isstatic#2 IsStatic form alg {
  prods [p"Syntactic - ClassElement : FieldDefinition[?Yield, ?Await] `;`"]
  keys ["ClassElement : FieldDefinition `;`"]
  vars []
  steps {
    return false
  }
}

sdo_row @sec-static-semantics-isstatic#3 IsStatic form alg {
  prods [p"Syntactic - ClassElement : `static` FieldDefinition[?Yield, ?Await] `;`"]
  keys ["ClassElement : `static` FieldDefinition `;`"]
  vars []
  steps {
    return true
  }
}

sdo_row @sec-static-semantics-isstatic#4 IsStatic form alg {
