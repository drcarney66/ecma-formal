sdo_row @sec-function-definitions-runtime-semantics-evaluation#4 Evaluation form alg {
  prods [p"Syntactic 1 FunctionStatementList : StatementList[?Yield, ?Await, +Return]?"]
  keys ["FunctionStatementList : StatementList"]
  vars [result, env]
  steps {
    let result = @sec-completion-ao(sdo Evaluation(child 5 |StatementList|))
    let env = $Component($Running(), [[LexicalEnvironment]])
    assert env is ty {#"Declarative Environment Record"}
    return ? @sec-disposeresources(env[[DisposableResourceStack]], result)
  }
}

