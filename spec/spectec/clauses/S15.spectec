  keys ["\n        OptionalChain :\n          `?.` `[` Expression `]`\n          `?.` IdentifierName\n          `?.` PrivateIdentifier\n          OptionalChain `[` Expression `]`\n          OptionalChain `.` IdentifierName\n          OptionalChain `.` PrivateIdentifier\n      "]
  vars [call]
  steps {
    return false
  }
}

sdo_row @sec-static-semantics-hascallintailposition#22 HasCallInTailPosition form alg {
  prods [p"Syntactic - OptionalChain : `?.` Arguments[?Yield, ?Await]", p"Syntactic - OptionalChain : OptionalChain[?Yield, ?Await] Arguments[?Yield, ?Await]"]
  keys ["\n        OptionalChain :\n          `?.` Arguments\n          OptionalChain Arguments\n      "]
  vars [call]
  steps {
    if call_at @ph-this-nt(|OptionalChain|) is val {call} -> return true
    return false
  }
}

sdo_row @sec-static-semantics-hascallintailposition#23 HasCallInTailPosition form alg {
