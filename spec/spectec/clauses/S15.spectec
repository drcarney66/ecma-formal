sdo_row @sec-static-semantics-expectedargumentcount#3 ExpectedArgumentCount form alg {
  prods [p"Syntactic - FormalParameterList : FormalParameterList[?Yield, ?Await] `,` FormalParameter[?Yield, ?Await]"]
  keys ["FormalParameterList : FormalParameterList `,` FormalParameter"]
  vars [count]
  steps {
    let count = sdo ExpectedArgumentCount(child 5 |FormalParameterList|)
    if sdo HasInitializer(child 5 |FormalParameterList|) is val {true} or sdo HasInitializer(child 5 |FormalParameter|) is val {true} -> return count
    return count + 1
  }
}

