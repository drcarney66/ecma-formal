-- ECMA-262 SpecTec Clauses: S15

def @sec-class-definitions-static-semantics-early-errors "sec-class-definitions-static-semantics-early-errors" (kind untyped params []) vars [ctor] {
  let ctor = sdo ConstructorMethod(child 5 |ClassBody|)
  if ctor is val {~empty~} -> return false
  return sdo HasDirectSuper(ctor)
}

def @sec-static-semantics-allprivateidentifiersvalid "AllPrivateIdentifiersValid" (kind sdo params [names : list<String>] -> Boolean) vars [names, #"child"] {
  for_children #"child" {
    if expr $InstanceOf(#"child", data sort nonterminal) {
      if sdo AllPrivateIdentifiersValid(#"child"; names) is val {false} -> return false
    }
  }
  return true
}

def @sec-static-semantics-containsarguments "ContainsArguments" (kind sdo params [] -> Boolean) vars [#"child"] {
  for_children #"child" {
    if expr $InstanceOf(#"child", data sort nonterminal) {
      if sdo ContainsArguments(#"child") is val {true} -> return true
    }
  }
  return false
}

def @sec-isintailposition "IsInTailPosition" (kind ao params [call : |CallExpression| | |MemberExpression| | |OptionalChain|] -> Boolean) vars [call, body] {
  if @sec-isstrict(call) is val {false} -> return false
  if $NearestEnclosing(call, [|FunctionBody|, |ConciseBody|, |AsyncConciseBody|]) is val {~empty~} -> return false
  let body = $NearestEnclosing(call, [|FunctionBody|, |ConciseBody|, |AsyncConciseBody|])
  if body sat @ph-nt-of-a(|FunctionBody|, data choice 0, |GeneratorBody|) -> return false
  if body sat @ph-nt-of-a(|FunctionBody|, data choice 1, |AsyncFunctionBody|) -> return false
  if body sat @ph-nt-of-a(|FunctionBody|, data choice 1, |AsyncGeneratorBody|) -> return false
  if body is ty {|AsyncConciseBody|} -> return false
  return @ph-result-of(sdo HasCallInTailPosition(body; call))
}

def @sec-preparefortailcall "PrepareForTailCall" (kind ao params [] -> val(~unused~)) vars [] {
  assert pass "The current execution context will not subsequently be used for the evaluation of any ECMAScript code or built-in functions. The invocation of Call subsequent to the invocation of this abstract operation will create and push a new execution context before performing any such evaluation"
  perform $DiscardContextResources($Running())
  return ~unused~
}

