sdo_row @sec-static-semantics-hascallintailposition HasCallInTailPosition form alg {
  prods [p"Syntactic - StatementList : StatementList[?Yield, ?Await, ?Return] StatementListItem[?Yield, ?Await, ?Return]"]
  keys ["StatementList : StatementList StatementListItem"]
  vars [call, has]
  steps {
    let has = sdo HasCallInTailPosition(child 3 |StatementList|; call)
    if has is val {true} -> return true
    if sdo ContainsUsing(child 3 |StatementList|) is val {true} -> return false
    return sdo HasCallInTailPosition(child 5 |StatementListItem|; call)
  }
}

