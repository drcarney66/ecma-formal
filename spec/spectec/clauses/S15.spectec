  vars [#"obj", enumerable, propertyKey, envRecord, privateEnv, sourceText, #"closure"]
  steps {
    let propertyKey = ? sdo Evaluation(child 5 |ClassElementName|)
    let envRecord = component [[LexicalEnvironment]] of $Running()
    let privateEnv = $Component($Running(), [[PrivateEnvironment]])
    let sourceText = $SourceText(child 6 |AsyncMethod|)
    let #"closure" = @sec-ordinaryfunctioncreate(intrinsic [[AsyncFunction.prototype]], sourceText, child 5 |UniqueFormalParameters|, child 5 |AsyncFunctionBody|, ~non-lexical-this~, envRecord, privateEnv)
    perform @sec-makemethod(#"closure", #"obj")
    perform @sec-setfunctionname(#"closure", propertyKey)
    return ? @sec-definemethodproperty(#"obj", propertyKey, #"closure", enumerable)
  }
}

sdo_row @sec-runtime-semantics-evaluategeneratorbody EvaluateGeneratorBody form alg {
  prods [p"Syntactic - GeneratorBody : FunctionBody[+Yield, ~Await]"]
  keys ["GeneratorBody : FunctionBody"]
  vars [funcObj, argList, gen]
  steps {
    perform ? @sec-functiondeclarationinstantiation(funcObj, argList)
    let gen = ? @sec-ordinarycreatefromconstructor(funcObj, "%GeneratorPrototype%", [[[GeneratorState]], [[GeneratorContext]], [[GeneratorBrand]]])
    set field gen[[GeneratorBrand]] = ~empty~
    set field gen[[GeneratorState]] = ~suspended-start~
    perform @sec-generatorstart(gen, child 5 |FunctionBody|)
    return @sec-returncompletion(gen)
  }
}

