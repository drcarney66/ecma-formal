sdo_row @sec-generator-function-definitions-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - YieldExpression : `yield`"]
  keys ["YieldExpression : `yield`"]
  vars []
  steps {
    return ? @sec-yield(undefined)
  }
}

sdo_row @sec-generator-function-definitions-runtime-semantics-evaluation#2 Evaluation form alg {
  prods [p"Syntactic - YieldExpression : `yield` [no LineTerminator here] AssignmentExpression[?In, +Yield, ?Await]"]
  keys ["YieldExpression : `yield` AssignmentExpression"]
  vars [exprRef, value]
  steps {
    let exprRef = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let value = ? @sec-getvalue(exprRef)
    return ? @sec-yield(value)
  }
}

sdo_row @sec-generator-function-definitions-runtime-semantics-evaluation#3 Evaluation form alg {
  prods [p"Syntactic - YieldExpression : `yield` [no LineTerminator here] `*` AssignmentExpression[?In, +Yield, ?Await]"]
  keys ["YieldExpression : `yield` `*` AssignmentExpression"]
  vars [genKind, exprRef, value, iteratorRecord, iterator, received, innerResult, done, #"throw", closeCompletion, #"return", receivedValue, innerReturnResult, returnedValue]
  steps {
    let genKind = @sec-getgeneratorkind()
    assert genKind is val {~sync~; ~async~}
    let exprRef = ? sdo Evaluation(child 5 |AssignmentExpression|)
    let value = ? @sec-getvalue(exprRef)
    let iteratorRecord = ? @sec-getiterator(value, genKind)
    let iterator = iteratorRecord[[Iterator]]
    let received = @sec-normalcompletion(undefined)
    repeat {
      if received is ty {#"normal completion"} {
        let innerResult = ? @sec-call(iteratorRecord[[NextMethod]], iteratorRecord[[Iterator]], [received[[Value]]])
        if genKind is val {~async~} -> set var innerResult = ? @await(innerResult)
        if innerResult is not ty {Object} -> throw @ph-new-error([[TypeError]])
        let done = ? @sec-iteratorcomplete(innerResult)
        if done is val {true} {
          return ? @sec-iteratorvalue(innerResult)
        }
        if genKind is val {~async~} -> set var received = @sec-completion-ao(@sec-asyncgeneratoryield(? @sec-iteratorvalue(innerResult)))
        else -> set var received = @sec-completion-ao(@sec-generatoryield(innerResult))
      }
      else_if received is ty {#"throw completion"} {
        let #"throw" = ? @sec-getmethod(iterator, "throw")
        if #"throw" is not val {undefined} {
          let innerResult = ? @sec-call(#"throw", iterator, [received[[Value]]])
          if genKind is val {~async~} -> set var innerResult = ? @await(innerResult)
          note "Exceptions from the inner iterator `throw` method are propagated. Normal completions from an inner `throw` method are processed similarly to an inner `next`."
          if innerResult is not ty {Object} -> throw @ph-new-error([[TypeError]])
          let done = ? @sec-iteratorcomplete(innerResult)
          if done is val {true} {
            return ? @sec-iteratorvalue(innerResult)
          }
          if genKind is val {~async~} -> set var received = @sec-completion-ao(@sec-asyncgeneratoryield(? @sec-iteratorvalue(innerResult)))
          else -> set var received = @sec-completion-ao(@sec-generatoryield(innerResult))
        }
        else {
          note "If _iterator_ does not have a `throw` method, this throw is going to terminate the `yield*` loop. But first we need to give _iterator_ a chance to clean up."
          let closeCompletion = @sec-normalcompletion(~empty~)
          if genKind is val {~async~} -> perform ? @sec-asynciteratorclose(iteratorRecord, closeCompletion)
          else -> perform ? @sec-iteratorclose(iteratorRecord, closeCompletion)
          note "The next step throws a *TypeError* to indicate that there was a `yield*` protocol violation: _iterator_ does not have a `throw` method."
          throw @ph-new-error([[TypeError]])
        }
      }
      else {
        assert received is ty {#"return completion"}
        let #"return" = ? @sec-getmethod(iterator, "return")
        if #"return" is val {undefined} {
          let receivedValue = received[[Value]]
          if genKind is val {~async~} {
            set var receivedValue = ? @await(receivedValue)
          }
          return @sec-returncompletion(receivedValue)
        }
        let innerReturnResult = ? @sec-call(#"return", iterator, [received[[Value]]])
        if genKind is val {~async~} -> set var innerReturnResult = ? @await(innerReturnResult)
        if innerReturnResult is not ty {Object} -> throw @ph-new-error([[TypeError]])
        let done = ? @sec-iteratorcomplete(innerReturnResult)
        if done is val {true} {
          let returnedValue = ? @sec-iteratorvalue(innerReturnResult)
          return @sec-returncompletion(returnedValue)
        }
        if genKind is val {~async~} -> set var received = @sec-completion-ao(@sec-asyncgeneratoryield(? @sec-iteratorvalue(innerReturnResult)))
        else -> set var received = @sec-completion-ao(@sec-generatoryield(innerReturnResult))
      }
    }
  }
}

