  }
}

sdo_row @sec-function-definitions-runtime-semantics-evaluation#2 Evaluation form alg {
  prods [p"Syntactic 0 FunctionExpression : `function` BindingIdentifier[~Yield, ~Await]? `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`", p"Syntactic 1 FunctionExpression : `function` BindingIdentifier[~Yield, ~Await]? `(` FormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`"]
  keys ["\n        FunctionExpression : `function` BindingIdentifier? `(` FormalParameters `)` `{` FunctionBody `}`\n      "]
  vars []
  steps {
    return sdo InstantiateOrdinaryFunctionExpression(child 6 |FunctionExpression|)
  }
}

sdo_row @sec-function-definitions-runtime-semantics-evaluation#3 Evaluation form alg {
  prods [p"Syntactic 0 FunctionStatementList : StatementList[?Yield, ?Await, +Return]?"]
  keys ["FunctionStatementList : [empty]"]
