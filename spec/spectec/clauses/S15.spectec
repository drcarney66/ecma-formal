  prods [p"Syntactic - ClassElement : FieldDefinition[?Yield, ?Await] `;`", p"Syntactic - ClassElement : `static` FieldDefinition[?Yield, ?Await] `;`"]
  keys ["\n        ClassElement :\n          FieldDefinition `;`\n          `static` FieldDefinition `;`\n      "]
  vars [#"obj"]
  steps {
    return ? sdo ClassFieldDefinitionEvaluation(child 5 |FieldDefinition|; #"obj")
  }
}

sdo_row @sec-static-semantics-classelementevaluation#1 ClassElementEvaluation form alg {
