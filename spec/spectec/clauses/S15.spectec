  }
}

sdo_row @sec-static-semantics-allprivateidentifiersvalid#5 AllPrivateIdentifiersValid form alg {
  prods [p"Syntactic - ClassBody : ClassElementList[?Yield, ?Await]"]
  keys ["ClassBody : ClassElementList"]
  vars [names, newNames]
  steps {
    let newNames = $ListConcat([names, sdo PrivateBoundIdentifiers(child 6 |ClassBody|)])
    return sdo AllPrivateIdentifiersValid(child 5 |ClassElementList|; newNames)
  }
}

sdo_row @sec-static-semantics-allprivateidentifiersvalid#6 AllPrivateIdentifiersValid form alg {
  prods [p"Syntactic - RelationalExpression : [+In] PrivateIdentifier `in` ShiftExpression[?Yield, ?Await]"]
  keys ["RelationalExpression : PrivateIdentifier `in` ShiftExpression"]
  vars [names]
  steps {
    if names sat $Contains(sdo StringValue(child 5 |PrivateIdentifier|)) {
      return sdo AllPrivateIdentifiersValid(child 5 |ShiftExpression|; names)
    }
    return false
  }
}

sdo_row @sec-static-semantics-privateboundidentifiers PrivateBoundIdentifiers form alg {
  prods [p"Syntactic 0 FieldDefinition : ClassElementName[?Yield, ?Await] Initializer[+In, ?Yield, ?Await]?", p"Syntactic 1 FieldDefinition : ClassElementName[?Yield, ?Await] Initializer[+In, ?Yield, ?Await]?"]
  keys ["\n        FieldDefinition : ClassElementName Initializer?\n      "]
  vars []
  steps {
    return sdo PrivateBoundIdentifiers(child 5 |ClassElementName|)
  }
}

sdo_row @sec-static-semantics-privateboundidentifiers#1 PrivateBoundIdentifiers form alg {
  prods [p"Syntactic - ClassElementName : PrivateIdentifier"]
  keys ["\n        ClassElementName : PrivateIdentifier\n      "]
  vars []
  steps {
    return $ListOf1(sdo StringValue(child 5 |PrivateIdentifier|))
  }
}

sdo_row @sec-static-semantics-privateboundidentifiers#2 PrivateBoundIdentifiers form alg {
  prods [p"Syntactic - ClassElementName : PropertyName[?Yield, ?Await]", p"Syntactic - ClassElement : ClassStaticBlock", p"Syntactic - ClassElement : `;`"]
  keys ["\n        ClassElementName :\n          PropertyName\n\n        ClassElement :\n          ClassStaticBlock\n          `;`\n      "]
  vars []
  steps {
    return $ListNew()
  }
}

sdo_row @sec-static-semantics-privateboundidentifiers#3 PrivateBoundIdentifiers form alg {
  prods [p"Syntactic - ClassElementList : ClassElementList[?Yield, ?Await] ClassElement[?Yield, ?Await]"]
  keys ["\n        ClassElementList : ClassElementList ClassElement\n      "]
  vars [names1, names2]
  steps {
    let names1 = sdo PrivateBoundIdentifiers(child 5 |ClassElementList|)
    let names2 = sdo PrivateBoundIdentifiers(child 5 |ClassElement|)
    return $ListConcat([names1, names2])
  }
}

sdo_row @sec-static-semantics-privateboundidentifiers#4 PrivateBoundIdentifiers form alg {
  prods [p"Syntactic - MethodDefinition : ClassElementName[?Yield, ?Await] `(` UniqueFormalParameters[~Yield, ~Await] `)` `{` FunctionBody[~Yield, ~Await] `}`", p"Syntactic - MethodDefinition : `get` ClassElementName[?Yield, ?Await] `(` `)` `{` FunctionBody[~Yield, ~Await] `}`", p"Syntactic - MethodDefinition : `set` ClassElementName[?Yield, ?Await] `(` PropertySetParameterList `)` `{` FunctionBody[~Yield, ~Await] `}`", p"Syntactic - GeneratorMethod : `*` ClassElementName[?Yield, ?Await] `(` UniqueFormalParameters[+Yield, ~Await] `)` `{` GeneratorBody `}`", p"Syntactic - AsyncMethod : `async` [no LineTerminator here] ClassElementName[?Yield, ?Await] `(` UniqueFormalParameters[~Yield, +Await] `)` `{` AsyncFunctionBody `}`", p"Syntactic - AsyncGeneratorMethod : `async` [no LineTerminator here] `*` ClassElementName[?Yield, ?Await] `(` UniqueFormalParameters[+Yield, +Await] `)` `{` AsyncGeneratorBody `}`"]
  keys ["\n        MethodDefinition :\n          ClassElementName `(` UniqueFormalParameters `)` `{` FunctionBody `}`\n          `get` ClassElementName `(` `)` `{` FunctionBody `}`\n          `set` ClassElementName `(` PropertySetParameterList `)` `{` FunctionBody `}`\n\n        GeneratorMethod :\n          `*` ClassElementName `(` UniqueFormalParameters `)` `{` GeneratorBody `}`\n\n        AsyncMethod :\n          `async` ClassElementName `(` UniqueFormalParameters `)` `{` AsyncFunctionBody `}`\n\n        AsyncGeneratorMethod :\n          `async` `*` ClassElementName `(` UniqueFormalParameters `)` `{` AsyncGeneratorBody `}`\n      "]
  vars []
  steps {
    return sdo PrivateBoundIdentifiers(child 5 |ClassElementName|)
  }
}

