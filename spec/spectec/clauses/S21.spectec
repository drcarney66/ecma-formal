  if millisecond sat $Present() -> let millisecondNumber = ? @sec-tonumber(millisecond)
  if tv is val {nan} -> return nan
  if millisecond fails $Present() -> let millisecondNumber = $𝔽(@sec-millisecondfromtime(tv))
  let date = @sec-makedate($𝔽(@sec-day(tv)), @sec-maketime($𝔽(@sec-hourfromtime(tv)), $𝔽(@sec-minutefromtime(tv)), secondNumber, millisecondNumber))
  let v = @sec-timeclip(date)
  set field dateObj[[DateValue]] = v
  return v
}

def @sec-date.prototype.todatestring "Date.prototype.toDateString" (kind builtin params []) vars [#"this value", NewTarget, dateObj, tv, t] {
  let dateObj = this_value
  perform ? @sec-requireinternalslot(dateObj, [[DateValue]])
  let tv = dateObj[[DateValue]]
  if tv is val {nan} -> return "Invalid Date"
  let t = @sec-localtime(tv)
  return @sec-datestring(t)
}

def @sec-date.prototype.toisostring "Date.prototype.toISOString" (kind builtin params []) vars [#"this value", NewTarget, dateObj, tv, expanded] {
  let dateObj = this_value
  perform ? @sec-requireinternalslot(dateObj, [[DateValue]])
  let tv = dateObj[[DateValue]]
  if tv is val {nan} -> throw @ph-new-error([[RangeError]])
  assert tv is ty {#"integral Number"}
  if @formal-isdatetimerepresentable(tv) is val {false} -> throw @ph-new-error([[RangeError]])
  let expanded = true
  if @sec-yearfromtime(tv) sat $InInterval(0, 9999) -> set var expanded = $ExpandedYearForm(tv)
  return @formal-datetimestring(tv, expanded)
}

def @sec-date.prototype.tojson "Date.prototype.toJSON" (kind builtin params [key]) vars [#"this value", NewTarget, key, #"obj", tv] {
  let #"obj" = ? @sec-toobject(this_value)
  let tv = ? @sec-toprimitive(#"obj", ~number~)
  if tv is ty {Number} and tv is not ty {sort [finite] Number} -> return null
  return ? @sec-invoke(#"obj", "toISOString")
}

def @sec-date.prototype.tostring "Date.prototype.toString" (kind builtin params []) vars [#"this value", NewTarget, dateObj, tv] {
  let dateObj = this_value
  perform ? @sec-requireinternalslot(dateObj, [[DateValue]])
  let tv = dateObj[[DateValue]]
  return @sec-todatestring(tv)
}

def @sec-timestring "TimeString" (kind ao params [tv : butnot(Number, val(nan))] -> String) vars [tv, hour, minute, second] {
  let hour = @sec-tozeropaddeddecimalstring(@sec-hourfromtime(tv), 2)
  let minute = @sec-tozeropaddeddecimalstring(@sec-minutefromtime(tv), 2)
  let second = @sec-tozeropaddeddecimalstring(@sec-secondfromtime(tv), 2)
  return $"string-concatenation"(hour, ":", minute, ":", second, $CodeUnit(cu(32, "0020", "SPACE")), "GMT")
}

def @sec-datestring "DateString" (kind ao params [tv : butnot(Number, val(nan))] -> String) vars [tv, weekday, month, day, yv, yearSign, paddedYear] {
  let weekday = @ph-name-of-entry(table t"sec-todatestring-day-names", code "WeekDay Index", @sec-weekday(tv))
  let month = @ph-name-of-entry(table t"sec-todatestring-month-names", code "Month Index", @sec-monthfromtime(tv))
  let day = @sec-tozeropaddeddecimalstring(@sec-datefromtime(tv), 2)
  let yv = @sec-yearfromtime(tv)
  if_else yv >= 0 { let yearSign = $"the empty String"() } else { let yearSign = "-" }
  let paddedYear = @sec-tozeropaddeddecimalstring($abs(yv), 4)
  return $"string-concatenation"(weekday, $CodeUnit(cu(32, "0020", "SPACE")), month, $CodeUnit(cu(32, "0020", "SPACE")), day, $CodeUnit(cu(32, "0020", "SPACE")), yearSign, paddedYear)
}

def @sec-timezoneestring "TimeZoneString" (kind ao params [tv : #"integral Number"] -> String) vars [tv, systemTimeZoneIdentifier, offsetNanoseconds, offsetMilliseconds, offsetSign, absOffsetMilliseconds, offsetMinute, offsetHour, timeZoneName] {
  let systemTimeZoneIdentifier = @sec-systemtimezoneidentifier()
  if @sec-istimezoneoffsetstring(systemTimeZoneIdentifier) is val {true} {
    let offsetNanoseconds = @sec-parsetimezoneoffsetstring(systemTimeZoneIdentifier)
  }
  else {
    let offsetNanoseconds = @sec-getnamedtimezoneoffsetnanoseconds(systemTimeZoneIdentifier, $ℝ(tv) * $TimeConst(data choice 9))
  }
  let offsetMilliseconds = $truncate(offsetNanoseconds / $TimeConst(data choice 9))
  if offsetMilliseconds >= 0 {
    let offsetSign = "+"
    let absOffsetMilliseconds = offsetMilliseconds
  }
  else {
    let offsetSign = "-"
    let absOffsetMilliseconds = neg offsetMilliseconds
  }
  let offsetMinute = @sec-tozeropaddeddecimalstring(@sec-minutefromtime($𝔽(absOffsetMilliseconds)), 2)
  let offsetHour = @sec-tozeropaddeddecimalstring(@sec-hourfromtime($𝔽(absOffsetMilliseconds)), 2)
  let timeZoneName = $TimeZoneNameSuffix(tv)
  return $"string-concatenation"(offsetSign, offsetHour, offsetMinute, timeZoneName)
}

def @sec-todatestring "ToDateString" (kind ao params [tv : #"integral Number" | val(nan)] -> String) vars [tv, localTime] {
  if tv is val {nan} -> return "Invalid Date"
  let localTime = @sec-localtime(tv)
  return $"string-concatenation"(@sec-datestring(localTime), $CodeUnit(cu(32, "0020", "SPACE")), @sec-timestring(localTime), @sec-timezoneestring(tv))
}

def @sec-date.prototype.totimestring "Date.prototype.toTimeString" (kind builtin params []) vars [#"this value", NewTarget, dateObj, tv, localTime] {
  let dateObj = this_value
  perform ? @sec-requireinternalslot(dateObj, [[DateValue]])
  let tv = dateObj[[DateValue]]
  if tv is val {nan} -> return "Invalid Date"
  let localTime = @sec-localtime(tv)
  return $"string-concatenation"(@sec-timestring(localTime), @sec-timezoneestring(tv))
}

def @sec-date.prototype.toutcstring "Date.prototype.toUTCString" (kind builtin params []) vars [#"this value", NewTarget, dateObj, tv, weekday, month, day, yv, yearSign, paddedYear] {
  let dateObj = this_value
  perform ? @sec-requireinternalslot(dateObj, [[DateValue]])
  let tv = dateObj[[DateValue]]
  if tv is val {nan} -> return "Invalid Date"
  let weekday = @ph-name-of-entry(table t"sec-todatestring-day-names", code "WeekDay Index", @sec-weekday(tv))
  let month = @ph-name-of-entry(table t"sec-todatestring-month-names", code "Month Index", @sec-monthfromtime(tv))
  let day = @sec-tozeropaddeddecimalstring(@sec-datefromtime(tv), 2)
  let yv = @sec-yearfromtime(tv)
  if_else yv >= 0 { let yearSign = $"the empty String"() } else { let yearSign = "-" }
  let paddedYear = @sec-tozeropaddeddecimalstring($abs(yv), 4)
  return $"string-concatenation"(weekday, ",", $CodeUnit(cu(32, "0020", "SPACE")), day, $CodeUnit(cu(32, "0020", "SPACE")), month, $CodeUnit(cu(32, "0020", "SPACE")), yearSign, paddedYear, $CodeUnit(cu(32, "0020", "SPACE")), @sec-timestring(tv))
}

def @sec-date.prototype.valueof "Date.prototype.valueOf" (kind builtin params []) vars [#"this value", NewTarget, dateObj] {
  let dateObj = this_value
  perform ? @sec-requireinternalslot(dateObj, [[DateValue]])
  return dateObj[[DateValue]]
}

def @sec-date.prototype-%symbol.toprimitive% "Date.prototype [ %Symbol.toPrimitive% ]" (kind builtin params [hint]) vars [#"this value", NewTarget, hint, #"obj", tryFirst] {
  let #"obj" = this_value
  if #"obj" is not ty {Object} -> throw @ph-new-error([[TypeError]])
  if hint is val {"string"; "default"} {
    let tryFirst = ~string~
  }
  else_if hint is val {"number"} {
    let tryFirst = ~number~
  }
  else {
    throw @ph-new-error([[TypeError]])
  }
  return ? @sec-ordinarytoprimitive(#"obj", tryFirst)
}

def @sec-fmamultiply "FMAMultiply" (kind ao params [x : Number, y : Number] -> sort [#"non-zero"] #"mathematical value" | val(~not-a-number~) | val(~positive-infinity~) | val(~negative-infinity~) | val(~positive-zero~) | val(~negative-zero~)) vars [x, y, sign] {
  if x is val {nan} or y is val {nan} -> return ~not-a-number~
  let sign = 1
  if x is val {num_f(-0)} or x < num_f(-0) {
    set var x = @sec-numeric-types-number-unaryMinus(x)
    set var sign = neg sign
  }
  if y is val {num_f(-0)} or y < num_f(-0) {
    set var y = @sec-numeric-types-number-unaryMinus(y)
    set var sign = neg sign
  }
  assert pass "_ and _ both have positive signs"
  if x is val {num_f(+∞)} or y is val {num_f(+∞)} {
    if x is val {num_f(+0)} or y is val {num_f(+0)} -> return ~not-a-number~
    if sign is val {math(-1)} -> return ~negative-infinity~
    return ~positive-infinity~
  }
  if x is val {num_f(+0)} or y is val {num_f(+0)} {
    if sign is val {math(-1)} -> return ~negative-zero~
    return ~positive-zero~
  }
  assert pass "_ and _ are both non-zero and finite"
  return sign * $ℝ(x) * $ℝ(y)
}

def @sec-math.fusedMultiplyAdd "Math.fusedMultiplyAdd" (kind builtin params [x, y, z]) vars [#"this value", NewTarget, x, y, z, product] {
  if x is not ty {Number} -> throw @ph-new-error([[TypeError]])
  if y is not ty {Number} -> throw @ph-new-error([[TypeError]])
  if z is not ty {Number} -> throw @ph-new-error([[TypeError]])
  let product = @sec-fmamultiply(x, y)
  if product is val {~not-a-number~} or z is val {nan} -> return nan
  if product is val {~positive-infinity~} {
    if z is val {num_f(-∞)} -> return nan
    return num_f(+∞)
  }
  if product is val {~negative-infinity~} {
    if z is val {num_f(+∞)} -> return nan
    return num_f(-∞)
  }
  if z is val {num_f(+∞); num_f(-∞)} -> return z
  if product is val {~negative-zero~} -> return z
  if product is val {~positive-zero~} -> set var product = 0
  assert pass "_ and _ are both finite"
  return $𝔽(product + $ℝ(z))
}

