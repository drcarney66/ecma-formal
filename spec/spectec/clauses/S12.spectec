sdo_row @sec-numericvalue#6 NumericValue form alg {
  prods [p"Lexical 1 DecimalBigIntegerLiteral :: NonZeroDigit DecimalDigits[+Sep]? BigIntLiteralSuffix", p"Lexical - DecimalBigIntegerLiteral :: NonZeroDigit NumericLiteralSeparator DecimalDigits[+Sep] BigIntLiteralSuffix"]
  keys ["\n          DecimalBigIntegerLiteral ::\n            NonZeroDigit DecimalDigits BigIntLiteralSuffix\n            NonZeroDigit NumericLiteralSeparator DecimalDigits BigIntLiteralSuffix\n        "]
  vars [n, mv]
  steps {
    let n = $CodePointCount(child 5 |DecimalDigits|, |NumericLiteralSeparator|)
    let mv = (sdo MV(child 5 |NonZeroDigit|) * 10 ^ n) + sdo MV(child 5 |DecimalDigits|)
    return $ℤ(mv)
  }
}

