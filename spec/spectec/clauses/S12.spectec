sdo_row @sec-numericvalue NumericValue form alg {
  prods [p"Lexical - NumericLiteral :: DecimalLiteral"]
  keys ["NumericLiteral :: DecimalLiteral"]
  vars [d, e, a, fd, b, n]
  steps {
    let d = child 5 |DecimalLiteral|
    assert d is ty {#"Parse Node"}
    if expr $InstanceOf(d, prods [p"Lexical 10 DecimalLiteral :: DecimalIntegerLiteral `.` DecimalDigits[+Sep]? ExponentPart[+Sep]?"]) or expr $InstanceOf(d, prods [p"Lexical 00 DecimalLiteral :: DecimalIntegerLiteral `.` DecimalDigits[+Sep]? ExponentPart[+Sep]?"]) or expr $InstanceOf(d, prods [p"Lexical 0 DecimalLiteral :: `.` DecimalDigits[+Sep] ExponentPart[+Sep]?"]) or expr $InstanceOf(d, prods [p"Lexical 0 DecimalLiteral :: DecimalIntegerLiteral ExponentPart[+Sep]?"]) -> return @sec-roundmvresult(sdo MV(d))
    let e = sdo MV($ChildOf(|ExponentPart|, ?d))
    if_else expr $InstanceOf(d, prods [p"Lexical 1 DecimalLiteral :: `.` DecimalDigits[+Sep] ExponentPart[+Sep]?"]) { let a = 0 } else { let a = sdo MV($ChildOf(|DecimalIntegerLiteral|, ?d)) }
    if expr $InstanceOf(d, prods [p"Lexical 11 DecimalLiteral :: DecimalIntegerLiteral `.` DecimalDigits[+Sep]? ExponentPart[+Sep]?"]) or expr $InstanceOf(d, prods [p"Lexical 1 DecimalLiteral :: `.` DecimalDigits[+Sep] ExponentPart[+Sep]?"]) {
      let fd = $ChildOf(|DecimalDigits|, ?d)
      let b = sdo MV(fd)
      let n = $CodePointCount(?fd, |NumericLiteralSeparator|)
    }
    else {
      let b = 0
      let n = 0
    }
    return @formal-rounddecimalmv(a * 10 ^ n + b, e - n)
  }
}

