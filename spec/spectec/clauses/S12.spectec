  keys ["DecimalIntegerLiteral :: `0`"]
  vars []
  steps {
    return 0
  }
}

sdo_row @sec-static-semantics-mv#7 MV form equation {
  prods [p"Lexical 0 DecimalIntegerLiteral :: NonZeroDigit NumericLiteralSeparator? DecimalDigits[+Sep]", p"Lexical 1 DecimalIntegerLiteral :: NonZeroDigit NumericLiteralSeparator? DecimalDigits[+Sep]"]
  keys ["DecimalIntegerLiteral :: NonZeroDigit NumericLiteralSeparator? DecimalDigits"]
  vars [n]
  steps {
    let n = $CodePointCount(child 5 |DecimalDigits|, |NumericLiteralSeparator|)
    return (sdo MV(child 5 |NonZeroDigit|) * 10 ^ n) + sdo MV(child 5 |DecimalDigits|)
  }
}

