-- ECMA-262 SpecTec Clauses: S12

sdo_row @sec-identifiercodepoints IdentifierCodePoints form alg {
  prods [p"Lexical - IdentifierName :: IdentifierStart"]
  keys ["IdentifierName :: IdentifierStart"]
  vars [codePoint]
  steps {
    let codePoint = sdo IdentifierCodePoint(child 5 |IdentifierStart|)
    return [codePoint]
  }
}

sdo_row @sec-identifiercodepoints#1 IdentifierCodePoints form alg {
  prods [p"Lexical - IdentifierName :: IdentifierName IdentifierPart"]
  keys ["IdentifierName :: IdentifierName IdentifierPart"]
  vars [codePoints, codePoint]
  steps {
    let codePoints = sdo IdentifierCodePoints(child 3 |IdentifierName|)
    let codePoint = sdo IdentifierCodePoint(child 5 |IdentifierPart|)
    perform $Append(?codePoint, ?codePoints)
    return codePoints
  }
}

sdo_row @sec-identifiercodepoint IdentifierCodePoint form alg {
  prods [p"Lexical - IdentifierStart :: IdentifierStartChar"]
  keys ["IdentifierStart :: IdentifierStartChar"]
  vars []
  steps {
    return $CodePointMatched(child 5 |IdentifierStartChar|)
  }
}

sdo_row @sec-identifiercodepoint#1 IdentifierCodePoint form alg {
  prods [p"Lexical - IdentifierPart :: IdentifierPartChar"]
  keys ["IdentifierPart :: IdentifierPartChar"]
  vars []
  steps {
    return $CodePointMatched(child 5 |IdentifierPartChar|)
  }
}

sdo_row @sec-identifiercodepoint#2 IdentifierCodePoint form alg {
  prods [p"Lexical - UnicodeEscapeSequence :: `u` Hex4Digits"]
  keys ["UnicodeEscapeSequence :: `u` Hex4Digits"]
  vars []
  steps {
    return $UnitOrPointOf(data choice 0, sdo MV(child 5 |Hex4Digits|))
  }
}

sdo_row @sec-identifiercodepoint#3 IdentifierCodePoint form alg {
  prods [p"Lexical - UnicodeEscapeSequence :: `u{` CodePoint `}`"]
  keys ["UnicodeEscapeSequence :: `u{` CodePoint `}`"]
  vars []
  steps {
    return $UnitOrPointOf(data choice 0, sdo MV(child 5 |CodePoint|))
  }
}

sdo_row @sec-static-semantics-mv MV form equation {
  prods [p"Lexical 10 DecimalLiteral :: DecimalIntegerLiteral `.` DecimalDigits[+Sep]? ExponentPart[+Sep]?"]
  keys ["DecimalLiteral :: DecimalIntegerLiteral `.` DecimalDigits"]
  vars [n]
  steps {
    let n = $CodePointCount(child 5 |DecimalDigits|, |NumericLiteralSeparator|)
    return sdo MV(child 5 |DecimalIntegerLiteral|) + (sdo MV(child 5 |DecimalDigits|) * 10 ^ neg n)
  }
}

sdo_row @sec-static-semantics-mv#1 MV form equation {
  prods [p"Lexical 01 DecimalLiteral :: DecimalIntegerLiteral `.` DecimalDigits[+Sep]? ExponentPart[+Sep]?"]
  keys ["DecimalLiteral :: DecimalIntegerLiteral `.` ExponentPart"]
  vars [e]
  steps {
    let e = sdo MV(child 5 |ExponentPart|)
    return sdo MV(child 5 |DecimalIntegerLiteral|) * 10 ^ e
  }
}

sdo_row @sec-static-semantics-mv#2 MV form equation {
  prods [p"Lexical 11 DecimalLiteral :: DecimalIntegerLiteral `.` DecimalDigits[+Sep]? ExponentPart[+Sep]?"]
  keys ["DecimalLiteral :: DecimalIntegerLiteral `.` DecimalDigits ExponentPart"]
  vars [n, e]
  steps {
    let n = $CodePointCount(child 5 |DecimalDigits|, |NumericLiteralSeparator|)
    let e = sdo MV(child 5 |ExponentPart|)
    return (sdo MV(child 5 |DecimalIntegerLiteral|) + (sdo MV(child 5 |DecimalDigits|) * 10 ^ neg n)) * 10 ^ e
  }
}

sdo_row @sec-static-semantics-mv#3 MV form equation {
  prods [p"Lexical 0 DecimalLiteral :: `.` DecimalDigits[+Sep] ExponentPart[+Sep]?"]
  keys ["DecimalLiteral :: `.` DecimalDigits"]
  vars [n]
  steps {
    let n = $CodePointCount(child 5 |DecimalDigits|, |NumericLiteralSeparator|)
    return sdo MV(child 5 |DecimalDigits|) * 10 ^ neg n
  }
}

sdo_row @sec-static-semantics-mv#4 MV form equation {
  prods [p"Lexical 1 DecimalLiteral :: `.` DecimalDigits[+Sep] ExponentPart[+Sep]?"]
  keys ["DecimalLiteral :: `.` DecimalDigits ExponentPart"]
  vars [e, n]
  steps {
    let n = $CodePointCount(child 5 |DecimalDigits|, |NumericLiteralSeparator|)
    let e = sdo MV(child 5 |ExponentPart|)
    return sdo MV(child 5 |DecimalDigits|) * 10 ^ {e - n}
  }
}

sdo_row @sec-static-semantics-mv#5 MV form equation {
  prods [p"Lexical 1 DecimalLiteral :: DecimalIntegerLiteral ExponentPart[+Sep]?"]
  keys ["DecimalLiteral :: DecimalIntegerLiteral ExponentPart"]
  vars [e]
  steps {
    let e = sdo MV(child 5 |ExponentPart|)
    return sdo MV(child 5 |DecimalIntegerLiteral|) * 10 ^ e
  }
}

