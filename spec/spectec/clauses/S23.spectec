def @sec-settypedarrayfromtypedarray "SetTypedArrayFromTypedArray" (kind ao params [target : TypedArray, targetOffset : sort [#"non-negative"] integer | val(math(+∞)), source : TypedArray] -> completion<val(~unused~)> | #"throw completion") vars [target, targetOffset, source, targetBuffer, targetRecord, targetLength, sourceBuffer, sourceRecord, sourceLength, targetType, targetElementSize, targetByteOffset, sourceType, sourceElementSize, sourceByteOffset, sameSharedArrayBuffer, sourceByteLength, sourceByteIndex, targetByteIndex, limit, value] {
  let targetBuffer = target[[ViewedArrayBuffer]]
  let targetRecord = ? @sec-validatetypedarraybounds(target, ~seq-cst~)
  let targetLength = @sec-typedarraylength(targetRecord)
  let sourceBuffer = source[[ViewedArrayBuffer]]
  let sourceRecord = ? @sec-validatetypedarraybounds(source, ~seq-cst~)
  let sourceLength = @sec-typedarraylength(sourceRecord)
  let targetType = @sec-typedarrayelementtype(target)
  let targetElementSize = @sec-typedarrayelementsize(target)
  let targetByteOffset = target[[ByteOffset]]
  let sourceType = @sec-typedarrayelementtype(source)
  let sourceElementSize = @sec-typedarrayelementsize(source)
  let sourceByteOffset = source[[ByteOffset]]
  if targetOffset == math(+∞) -> throw @ph-new-error([[RangeError]])
  if sourceLength + targetOffset > targetLength -> throw @ph-new-error([[RangeError]])
  if target[[ContentType]] is not val {source[[ContentType]]} -> throw @ph-new-error([[TypeError]])
  if_else @sec-issharedarraybuffer(sourceBuffer) is val {true} and @sec-issharedarraybuffer(targetBuffer) is val {true} and sourceBuffer[[ArrayBufferData]] is val {targetBuffer[[ArrayBufferData]]} { let sameSharedArrayBuffer = true } else { let sameSharedArrayBuffer = false }
  if @sec-samevalue(sourceBuffer, targetBuffer) is val {true} or sameSharedArrayBuffer is val {true} {
    let sourceByteLength = @sec-typedarraybytelength(sourceRecord)
    set var sourceBuffer = ? @sec-clonearraybuffer(sourceBuffer, sourceByteOffset, sourceByteLength)
    let sourceByteIndex = 0
