def @sec-findviapredicate "FindViaPredicate" (kind ao params [#"obj" : Object, length : sort [#"non-negative"] integer, direction : val(~ascending~) | val(~descending~), predicate : #"ECMAScript language value", thisArg : #"ECMAScript language value"] -> completion<record { [[Index]]: #"integral Number", [[Value]]: #"ECMAScript language value" }> | #"throw completion") vars [#"obj", length, direction, predicate, thisArg, k, propertyKey, kValue, testResult] {
  if @sec-iscallable(predicate) is val {false} -> throw @ph-new-error([[TypeError]])
  if direction is val {~ascending~} {
    for_range k incl 0 .. excl length {
      let propertyKey = ! @sec-tostring($𝔽(k))
      note "If _obj_ is a TypedArray, the following invocation of Get will return a normal completion."
      let kValue = ? @sec-get-o-p(#"obj", propertyKey)
      let testResult = ? @sec-call(predicate, thisArg, [kValue, $𝔽(k), #"obj"])
      if @sec-toboolean(testResult) is val {true} -> return record Record { [[Index]]: $𝔽(k), [[Value]]: kValue }
    }
  }
  else {
    for_range k incl 0 .. excl length desc {
      let propertyKey = ! @sec-tostring($𝔽(k))
      note "If _obj_ is a TypedArray, the following invocation of Get will return a normal completion."
      let kValue = ? @sec-get-o-p(#"obj", propertyKey)
      let testResult = ? @sec-call(predicate, thisArg, [kValue, $𝔽(k), #"obj"])
      if @sec-toboolean(testResult) is val {true} -> return record Record { [[Index]]: $𝔽(k), [[Value]]: kValue }
    }
  }
  return record Record { [[Index]]: num_f(-1), [[Value]]: undefined }
}

def @sec-array.prototype.flat "Array.prototype.flat" (kind builtin params [depth opt]) vars [#"this value", NewTarget, depth, #"obj", sourceLength, depthNumber, array] {
  let #"obj" = ? @sec-toobject(this_value)
  let sourceLength = ? @sec-lengthofarraylike(#"obj")
  let depthNumber = 1
  if depth is not val {undefined} {
    set var depthNumber = ? @sec-tointegerorinfinity(depth)
    if depthNumber < 0 -> set var depthNumber = 0
  }
  let array = ? @sec-arrayspeciescreate(#"obj", 0)
  perform ? @sec-flattenintoarray(array, #"obj", sourceLength, 0, depthNumber)
  return array
}

def @sec-flattenintoarray "FlattenIntoArray" (kind ao params [target : Object, source : Object, sourceLength : sort [#"non-negative"] integer, start : sort [#"non-negative"] integer, depth : sort [#"non-negative"] integer | val(math(+∞)), mapperFunc : #"function object" opt, thisArg : #"ECMAScript language value" opt] -> completion<sort [#"non-negative"] integer> | #"throw completion") vars [target, source, sourceLength, start, depth, mapperFunc, thisArg, targetIndex, sourceIndex, propertyKey, exists, element, shouldFlatten, newDepth, elementLength] {
  assert_if mapperFunc sat $Present() then @sec-iscallable(mapperFunc) is val {true} and thisArg sat $Present() and depth is val {1}
  let targetIndex = start
  let sourceIndex = 0
  repeat_while sourceIndex < sourceLength {
    let propertyKey = ! @sec-tostring($𝔽(sourceIndex))
    let exists = ? @sec-hasproperty(source, propertyKey)
    if exists is val {true} {
      let element = ? @sec-get-o-p(source, propertyKey)
      if mapperFunc sat $Present() {
        set var element = ? @sec-call(mapperFunc, thisArg, [element, $𝔽(sourceIndex), source])
      }
      let shouldFlatten = false
      if depth > 0 {
        set var shouldFlatten = ? @sec-isarray(element)
      }
      if shouldFlatten is val {true} {
        if depth == math(+∞) -> let newDepth = math(+∞)
        else -> let newDepth = depth - 1
        let elementLength = ? @sec-lengthofarraylike(element)
        set var targetIndex = ? @sec-flattenintoarray(target, element, elementLength, targetIndex, newDepth)
      }
      else {
        if targetIndex >= 2 ^ 53 - 1 -> throw @ph-new-error([[TypeError]])
        perform ? @sec-createdatapropertyorthrow(target, ! @sec-tostring($𝔽(targetIndex)), element)
        set var targetIndex = targetIndex + 1
      }
    }
    set var sourceIndex = sourceIndex + 1
  }
  return targetIndex
}

def @sec-array.prototype.flatmap "Array.prototype.flatMap" (kind builtin params [mapperFunc, thisArg opt]) vars [#"this value", NewTarget, mapperFunc, thisArg, #"obj", sourceLength, array] {
  let #"obj" = ? @sec-toobject(this_value)
