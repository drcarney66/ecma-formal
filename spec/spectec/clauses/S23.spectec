-- ECMA-262 SpecTec Clauses: S23

def @sec-array "Array" (kind builtin params [values rest]) vars [#"this value", NewTarget, values, newTarget, proto, numberOfArgs, length, array, intLength, k, propertyKey, itemK] {
  if_else new_target is val {undefined} { let newTarget = $ActiveFunction() } else { let newTarget = new_target }
  let proto = ? @sec-getprototypefromconstructor(newTarget, "%Array.prototype%")
  let numberOfArgs = $ListLen(?values)
  if numberOfArgs == 0 -> return ! @sec-arraycreate(0, proto)
  if numberOfArgs == 1 {
    let length = values[0]
    let array = ! @sec-arraycreate(0, proto)
    if length is not ty {Number} {
      perform ! @sec-createdatapropertyorthrow(array, "0", length)
      let intLength = num_f(1)
    }
    else {
      let intLength = ! @sec-touint32(length)
      if @sec-samevaluezero(intLength, length) is val {false} -> throw @ph-new-error([[RangeError]])
    }
    perform ! @sec-set-o-p-v-throw(array, "length", intLength, true)
    return array
  }
  assert numberOfArgs >= 2
  let array = ? @sec-arraycreate(numberOfArgs, proto)
  let k = 0
  repeat_while k < numberOfArgs {
    let propertyKey = ! @sec-tostring($𝔽(k))
    let itemK = values[k]
    perform ! @sec-createdatapropertyorthrow(array, propertyKey, itemK)
    set var k = k + 1
  }
  assert $ℝ(@sec-ordinarygetownproperty(array, "length")[[Value]]) == numberOfArgs
  return array
}

def @sec-array.from "Array.from" (kind builtin params [items, mapper opt, thisArg opt]) vars [#"this value", NewTarget, items, mapper, thisArg, ctor, mapping, usingIterator, array, iteratorRecord, k, error, propertyKey, next, mappedValue, defineStatus, arrayLike, length, kValue] {
  let ctor = this_value
  if mapper is val {undefined} {
    let mapping = false
  }
  else {
    if @sec-iscallable(mapper) is val {false} -> throw @ph-new-error([[TypeError]])
    let mapping = true
  }
  let usingIterator = ? @sec-getmethod(items, $WellKnownSymbol("Symbol.iterator"))
  if usingIterator is not val {undefined} {
    if @sec-isconstructor(ctor) is val {true} {
      let array = ? @sec-construct(ctor)
    }
    else {
      let array = ! @sec-arraycreate(0)
    }
    let iteratorRecord = ? @sec-getiteratorfrommethod(items, usingIterator)
    let k = 0
    repeat {
      if k >= 2 ^ 53 - 1 {
        let error = @sec-throwcompletion(@ph-new-error(err [[TypeError]]))
        return ? @sec-iteratorclose(iteratorRecord, error)
      }
      let propertyKey = ! @sec-tostring($𝔽(k))
      let next = ? @sec-iteratorstepvalue(iteratorRecord)
      if next is val {~done~} {
        perform ? @sec-set-o-p-v-throw(array, "length", $𝔽(k), true)
        return array
      }
      if mapping is val {true} {
        let mappedValue = @sec-completion-ao(@sec-call(mapper, thisArg, [next, $𝔽(k)]))
        block {
          assert mappedValue is ty {#"Completion Record"}
          if mappedValue is ty {#"abrupt completion"} -> return ? @sec-iteratorclose(iteratorRecord, mappedValue)
          set var mappedValue = ! mappedValue
        }
      }
      else {
        let mappedValue = next
      }
      let defineStatus = @sec-completion-ao(@sec-createdatapropertyorthrow(array, propertyKey, mappedValue))
      block {
        assert defineStatus is ty {#"Completion Record"}
        if defineStatus is ty {#"abrupt completion"} -> return ? @sec-iteratorclose(iteratorRecord, defineStatus)
        set var defineStatus = ! defineStatus
      }
      set var k = k + 1
    }
  }
  note "_items_ is not iterable so assume it is an array-like object."
  let arrayLike = ! @sec-toobject(items)
  let length = ? @sec-lengthofarraylike(arrayLike)
  if @sec-isconstructor(ctor) is val {true} {
    let array = ? @sec-construct(ctor, [$𝔽(length)])
  }
  else {
    let array = ? @sec-arraycreate(length)
  }
  let k = 0
  repeat_while k < length {
    let propertyKey = ! @sec-tostring($𝔽(k))
    let kValue = ? @sec-get-o-p(arrayLike, propertyKey)
    if mapping is val {true} {
      let mappedValue = ? @sec-call(mapper, thisArg, [kValue, $𝔽(k)])
    }
    else {
      let mappedValue = kValue
    }
    perform ? @sec-createdatapropertyorthrow(array, propertyKey, mappedValue)
    set var k = k + 1
  }
  perform ? @sec-set-o-p-v-throw(array, "length", $𝔽(length), true)
  return array
}

def @sec-array.fromasync "Array.fromAsync" (kind builtin params [items, mapper opt, thisArg opt]) vars [#"this value", NewTarget, items, mapper, thisArg, ctor, mapping, iteratorRecord, usingAsyncIterator, usingSyncIterator, array, k, error, propertyKey, nextResult, done, nextValue, mappedValue, defineStatus, arrayLike, length, kValue] {
  let ctor = this_value
  let mapping = false
  if mapper is not val {undefined} {
    if @sec-iscallable(mapper) is val {false} -> throw @ph-new-error([[TypeError]])
    set var mapping = true
  }
  let iteratorRecord = undefined
  let usingAsyncIterator = ? @sec-getmethod(items, $WellKnownSymbol("Symbol.asyncIterator"))
  if usingAsyncIterator is val {undefined} {
    let usingSyncIterator = ? @sec-getmethod(items, $WellKnownSymbol("Symbol.iterator"))
    if usingSyncIterator is not val {undefined} {
      set var iteratorRecord = @sec-createasyncfromsynciterator(? @sec-getiteratorfrommethod(items, usingSyncIterator))
    }
  }
  else {
    set var iteratorRecord = ? @sec-getiteratorfrommethod(items, usingAsyncIterator)
  }
  if iteratorRecord is not val {undefined} {
    if @sec-isconstructor(ctor) is val {true} {
      let array = ? @sec-construct(ctor)
    }
    else {
      let array = ! @sec-arraycreate(0)
    }
    let k = 0
    repeat {
      if k >= 2 ^ 53 - 1 {
        let error = @sec-throwcompletion(@ph-new-error(err [[TypeError]]))
        return ? @sec-asynciteratorclose(iteratorRecord, error)
      }
      let propertyKey = ! @sec-tostring($𝔽(k))
      let nextResult = ? @sec-call(iteratorRecord[[NextMethod]], iteratorRecord[[Iterator]])
      set var nextResult = ? @await(nextResult)
      if nextResult is not ty {Object} -> throw @ph-new-error([[TypeError]])
      let done = ? @sec-iteratorcomplete(nextResult)
      if done is val {true} {
        perform ? @sec-set-o-p-v-throw(array, "length", $𝔽(k), true)
        return array
      }
      let nextValue = ? @sec-iteratorvalue(nextResult)
      if mapping is val {true} {
        let mappedValue = @sec-completion-ao(@sec-call(mapper, thisArg, [nextValue, $𝔽(k)]))
        block {
          assert mappedValue is ty {#"Completion Record"}
          if mappedValue is ty {#"abrupt completion"} -> return ? @sec-asynciteratorclose(iteratorRecord, mappedValue)
          set var mappedValue = ! mappedValue
        }
        set var mappedValue = @sec-completion-ao(@await(mappedValue))
        block {
          assert mappedValue is ty {#"Completion Record"}
          if mappedValue is ty {#"abrupt completion"} -> return ? @sec-asynciteratorclose(iteratorRecord, mappedValue)
          set var mappedValue = ! mappedValue
        }
      }
      else {
        let mappedValue = nextValue
      }
      let defineStatus = @sec-completion-ao(@sec-createdatapropertyorthrow(array, propertyKey, mappedValue))
      block {
        assert defineStatus is ty {#"Completion Record"}
        if defineStatus is ty {#"abrupt completion"} -> return ? @sec-asynciteratorclose(iteratorRecord, defineStatus)
        set var defineStatus = ! defineStatus
      }
      set var k = k + 1
    }
  }
  else {
    note "_items_ is neither async iterable nor iterable so assume it is an array-like object."
    let arrayLike = ! @sec-toobject(items)
    let length = ? @sec-lengthofarraylike(arrayLike)
    if @sec-isconstructor(ctor) is val {true} {
      let array = ? @sec-construct(ctor, [$𝔽(length)])
    }
    else {
      let array = ? @sec-arraycreate(length)
    }
    let k = 0
    repeat_while k < length {
      let propertyKey = ! @sec-tostring($𝔽(k))
      let kValue = ? @sec-get-o-p(arrayLike, propertyKey)
      set var kValue = ? @await(kValue)
      if mapping is val {true} {
        let mappedValue = ? @sec-call(mapper, thisArg, [kValue, $𝔽(k)])
        set var mappedValue = ? @await(mappedValue)
      }
      else {
        let mappedValue = kValue
      }
      perform ? @sec-createdatapropertyorthrow(array, propertyKey, mappedValue)
      set var k = k + 1
    }
    perform ? @sec-set-o-p-v-throw(array, "length", $𝔽(length), true)
    return array
  }
}

def @sec-array.isarray "Array.isArray" (kind builtin params [arg]) vars [#"this value", NewTarget, arg] {
  return ? @sec-isarray(arg)
}

def @sec-array.of "Array.of" (kind builtin params [items rest]) vars [#"this value", NewTarget, items, length, lengthNumber, ctor, array, k, kValue, propertyKey] {
  let length = $ListLen(?items)
  let lengthNumber = $𝔽(length)
  let ctor = this_value
  if @sec-isconstructor(ctor) is val {true} {
    let array = ? @sec-construct(ctor, [lengthNumber])
  }
  else {
    let array = ? @sec-arraycreate(length)
  }
  let k = 0
  repeat_while k < length {
    let kValue = items[k]
    let propertyKey = ! @sec-tostring($𝔽(k))
    perform ? @sec-createdatapropertyorthrow(array, propertyKey, kValue)
    set var k = k + 1
  }
  perform ? @sec-set-o-p-v-throw(array, "length", lengthNumber, true)
  return array
}

def @sec-get-array-%symbol.species% "get Array [ %Symbol.species% ]" (kind builtin params []) vars [#"this value", NewTarget] {
  return this_value
}

def @sec-array.prototype.at "Array.prototype.at" (kind builtin params [index]) vars [#"this value", NewTarget, index, #"obj", length, k] {
  let #"obj" = ? @sec-toobject(this_value)
  let length = ? @sec-lengthofarraylike(#"obj")
  let k = ? @sec-toabsoluteindex(index, length)
  if k < 0 or k >= length -> return undefined
  return ? @sec-get-o-p(#"obj", ! @sec-tostring($𝔽(k)))
}

def @sec-array.prototype.concat "Array.prototype.concat" (kind builtin params [items rest]) vars [#"this value", NewTarget, items, #"obj", array, nextIndex, item, spreadable, length, sourceIndex, propertyKey, exists, subElement] {
  let #"obj" = ? @sec-toobject(this_value)
  let array = ? @sec-arrayspeciescreate(#"obj", 0)
  let nextIndex = 0
  perform $Prepend(?#"obj", ?items)
  for_each item in items {
    let spreadable = ? @sec-isconcatspreadable(item)
    if spreadable is val {true} {
      let length = ? @sec-lengthofarraylike(item)
      if nextIndex + length > 2 ^ 53 - 1 -> throw @ph-new-error([[TypeError]])
      let sourceIndex = 0
      repeat_while sourceIndex < length {
        let propertyKey = ! @sec-tostring($𝔽(sourceIndex))
        let exists = ? @sec-hasproperty(item, propertyKey)
        if exists is val {true} {
          let subElement = ? @sec-get-o-p(item, propertyKey)
          perform ? @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(nextIndex)), subElement)
        }
        set var nextIndex = nextIndex + 1
        set var sourceIndex = sourceIndex + 1
      }
    }
    else {
      note "_item_ is added as a single item rather than spread."
      if nextIndex >= 2 ^ 53 - 1 -> throw @ph-new-error([[TypeError]])
      perform ? @sec-createdatapropertyorthrow(array, ! @sec-tostring($𝔽(nextIndex)), item)
      set var nextIndex = nextIndex + 1
    }
  }
  perform ? @sec-set-o-p-v-throw(array, "length", $𝔽(nextIndex), true)
  return array
}

def @sec-isconcatspreadable "IsConcatSpreadable" (kind ao params [#"obj" : #"ECMAScript language value"] -> completion<Boolean> | #"throw completion") vars [#"obj", spreadable] {
  if #"obj" is not ty {Object} -> return false
  let spreadable = ? @sec-get-o-p(#"obj", $WellKnownSymbol("Symbol.isConcatSpreadable"))
  if spreadable is not val {undefined} -> return @sec-toboolean(spreadable)
  return ? @sec-isarray(#"obj")
}

def @sec-array.prototype.copywithin "Array.prototype.copyWithin" (kind builtin params [target, start, end opt]) vars [#"this value", NewTarget, target, start, end, #"obj", length, #"to", #"from", final, count, direction, fromKey, toKey, fromPresent, fromValue] {
  let #"obj" = ? @sec-toobject(this_value)
  let length = ? @sec-lengthofarraylike(#"obj")
  let #"to" = ? @sec-toclampedindex(target, length)
  let #"from" = ? @sec-toclampedindex(start, length)
  if_else end is val {undefined} { let final = length } else { let final = ? @sec-toclampedindex(end, length) }
  let count = $min(final - #"from", length - #"to")
  if #"from" < #"to" and #"to" < #"from" + count {
    let direction = math(-1)
    set var #"from" = #"from" + count - 1
    set var #"to" = #"to" + count - 1
  }
  else {
    let direction = 1
  }
  repeat_while count > 0 {
    let fromKey = ! @sec-tostring($𝔽(#"from"))
    let toKey = ! @sec-tostring($𝔽(#"to"))
    let fromPresent = ? @sec-hasproperty(#"obj", fromKey)
    if fromPresent is val {true} {
      let fromValue = ? @sec-get-o-p(#"obj", fromKey)
      perform ? @sec-set-o-p-v-throw(#"obj", toKey, fromValue, true)
    }
    else {
      assert fromPresent is val {false}
      perform ? @sec-deletepropertyorthrow(#"obj", toKey)
    }
    set var #"from" = #"from" + direction
    set var #"to" = #"to" + direction
    set var count = count - 1
  }
  return #"obj"
}

def @sec-array.prototype.entries "Array.prototype.entries" (kind builtin params []) vars [#"this value", NewTarget, #"obj"] {
  let #"obj" = ? @sec-toobject(this_value)
