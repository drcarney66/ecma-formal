  if #"obj" fails $HasSlot([[TypedArrayName]]) -> return undefined
  let name = #"obj"[[TypedArrayName]]
  assert name is ty {String}
  return name
}

def @sec-typedarraycreatefromconstructor "TypedArrayCreateFromConstructor" (kind ao params [ctor : constructor, argList : list<#"ECMAScript language value">] -> completion<TypedArray> | #"throw completion") vars [ctor, argList, ta, taRecord, length] {
  let ta = ? @sec-construct(ctor, argList)
  let taRecord = ? @sec-validatetypedarray(ta, ~seq-cst~)
  assert ta sat $HasSlots([[[ViewedArrayBuffer]], [[TypedArrayName]], [[ContentType]], [[ByteLength]], [[ByteOffset]], [[ArrayLength]]])
  if $ListLen(?argList) is val {1} and argList[0] is ty {Number} {
    if @sec-istypedarrayoutofbounds(taRecord) is val {true} -> throw @ph-new-error([[TypeError]])
    let length = @sec-typedarraylength(taRecord)
    if length < $ℝ(argList[0]) -> throw @ph-new-error([[TypeError]])
  }
  return ta
}

def @sec-typedarray-create-same-type "TypedArrayCreateSameType" (kind ao params [exemplar : TypedArray, length : sort [#"non-negative"] integer] -> completion<TypedArray> | #"throw completion") vars [exemplar, length, ctor, result] {
  let ctor = @ph-intrinsic-assoc(exemplar[[TypedArrayName]], table t"table-the-typedarray-constructors")
  let result = ? @sec-typedarraycreatefromconstructor(ctor, [$𝔽(length)])
  assert result sat $HasSlots([[[TypedArrayName]], [[ContentType]]])
  assert result[[ContentType]] is val {exemplar[[ContentType]]}
  return result
}

def @typedarray-species-create "TypedArraySpeciesCreate" (kind ao params [exemplar : TypedArray, argList : list<#"ECMAScript language value">] -> completion<TypedArray> | #"throw completion") vars [exemplar, argList, defaultCtor, ctor, result] {
  let defaultCtor = @ph-intrinsic-assoc(exemplar[[TypedArrayName]], table t"table-the-typedarray-constructors")
  let ctor = ? @sec-speciesconstructor(exemplar, defaultCtor)
  let result = ? @sec-typedarraycreatefromconstructor(ctor, argList)
  if result[[ContentType]] is not val {exemplar[[ContentType]]} -> throw @ph-new-error([[TypeError]])
  return result
}

def @sec-validatetypedarray "ValidateTypedArray" (kind ao params [#"obj" : #"ECMAScript language value", #"order" : val(~seq-cst~) | val(~unordered~)] -> completion<#"TypedArray With Buffer Witness Record"> | #"throw completion") vars [#"obj", #"order"] {
  perform ? @sec-requireinternalslot(#"obj", [[TypedArrayName]])
  assert #"obj" sat $HasSlot([[ViewedArrayBuffer]])
  return ? @sec-validatetypedarraybounds(#"obj", #"order")
}

def @sec-validatetypedarraybounds "ValidateTypedArrayBounds" (kind ao params [ta : TypedArray, #"order" : val(~seq-cst~) | val(~unordered~)] -> completion<#"TypedArray With Buffer Witness Record"> | #"throw completion") vars [ta, #"order", taRecord] {
  let taRecord = @sec-maketypedarraywithbufferwitnessrecord(ta, #"order")
  if @sec-istypedarrayoutofbounds(taRecord) is val {true} -> throw @ph-new-error([[TypeError]])
  return taRecord
}

def @sec-typedarrayelementsize "TypedArrayElementSize" (kind ao params [#"obj" : TypedArray] -> sort [#"non-negative"] integer) vars [#"obj"] {
  return $TableRowValue(table t"table-the-typedarray-constructors", code "Element Size", #"obj"[[TypedArrayName]])
}

def @sec-typedarrayelementtype "TypedArrayElementType" (kind ao params [#"obj" : TypedArray] -> #"TypedArray element type") vars [#"obj"] {
  return $TableRowValue(table t"table-the-typedarray-constructors", code "Element Type", #"obj"[[TypedArrayName]])
}

def @sec-comparetypedarrayelements "CompareTypedArrayElements" (kind ao params [x : Number | BigInt, y : Number | BigInt, comparator : #"function object" | val(undefined)] -> completion<Number> | #"abrupt completion") vars [x, y, comparator, result] {
  assert x is ty {Number} and y is ty {Number} or x is ty {BigInt} and y is ty {BigInt}
  if comparator is not val {undefined} {
    let result = ? @sec-tonumber(? @sec-call(comparator, undefined, [x, y]))
    if result is val {nan} -> return num_f(+0)
    return result
  }
  if x is val {nan} and y is val {nan} -> return num_f(+0)
  if x is val {nan} -> return num_f(1)
  if y is val {nan} -> return num_f(-1)
  if x < y -> return num_f(-1)
  if x > y -> return num_f(1)
  if x is val {num_f(-0)} and y is val {num_f(+0)} -> return num_f(-1)
  if x is val {num_f(+0)} and y is val {num_f(-0)} -> return num_f(1)
  return num_f(+0)
}

def @sec-allocatetypedarray "AllocateTypedArray" (kind ao params [ctorName : doc "a String which is the name of a TypedArray constructor in", newTarget : constructor, defaultProto : String, length : sort [#"non-negative"] integer opt] -> completion<TypedArray> | #"throw completion") vars [ctorName, newTarget, defaultProto, length, proto, #"obj"] {
  let proto = ? @sec-getprototypefromconstructor(newTarget, defaultProto)
  let #"obj" = @sec-typedarraycreate(proto)
  assert #"obj"[[ViewedArrayBuffer]] is val {undefined}
  set field #"obj"[[TypedArrayName]] = ctorName
  if ctorName is val {"BigInt64Array"; "BigUint64Array"} -> set field #"obj"[[ContentType]] = ~bigint~
  else -> set field #"obj"[[ContentType]] = ~number~
  if length fails $Present() {
    set field #"obj"[[ByteLength]] = 0
    set field #"obj"[[ByteOffset]] = 0
    set field #"obj"[[ArrayLength]] = 0
  }
  else {
    perform ? @sec-allocatetypedarraybuffer(#"obj", length)
  }
  return #"obj"
}

def @sec-initializetypedarrayfromtypedarray "InitializeTypedArrayFromTypedArray" (kind ao params [#"obj" : TypedArray, sourceArray : TypedArray] -> completion<val(~unused~)> | #"throw completion") vars [#"obj", sourceArray, sourceData, elementType, elementSize, sourceType, sourceElementSize, sourceByteOffset, sourceRecord, elementLength, byteLength, #"data", sourceByteIndex, targetByteIndex, count, value] {
