  }
  return #"obj"
}

def @sec-array.prototype.filter "Array.prototype.filter" (kind builtin params [callback, thisArg opt]) vars [#"this value", NewTarget, callback, thisArg, #"obj", length, array, k, #"to", propertyKey, kPresent, kValue, selected] {
  let #"obj" = ? @sec-toobject(this_value)
