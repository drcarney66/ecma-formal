def @sec-frombase64 "FromBase64" (kind ao params [string : String, alphabet : val("base64") | val("base64url"), lastChunkHandling : val("loose") | val("strict") | val("stop-before-partial"), maxLength : sort [#"non-negative"] integer opt] -> doc "a Record with fields [[Read]] (an integer), [[Bytes]] (a List of byte values), and [[Error]] (a *SyntaxError* object or ~none~)") vars [string, alphabet, lastChunkHandling, maxLength, read, bytes, chunk, chunkLength, index, length, error, char, throwOnExtraBits, decodeResult, remaining] {
