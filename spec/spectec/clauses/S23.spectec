def @sec-array.prototype.fill "Array.prototype.fill" (kind builtin params [value, start opt, end opt]) vars [#"this value", NewTarget, value, start, end, #"obj", length, k, final, propertyKey] {
  let #"obj" = ? @sec-toobject(this_value)
