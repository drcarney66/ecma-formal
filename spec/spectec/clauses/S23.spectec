def @sec-decodefinalbase64chunk "DecodeFinalBase64Chunk" (kind ao params [chunk : doc "a String of length 2 or 3", throwOnExtraBits : Boolean] -> completion<list<#"byte value">> | #"throw completion") vars [chunk, throwOnExtraBits, chunkLength, bytes] {
