def @sec-comparearrayelements "CompareArrayElements" (kind ao params [x : #"ECMAScript language value", y : #"ECMAScript language value", comparator : #"function object" | val(undefined)] -> completion<Number> | #"abrupt completion") vars [x, y, comparator, result, xString, yString, xSmaller, ySmaller] {
  if x is val {undefined} and y is val {undefined} -> return num_f(+0)
  if x is val {undefined} -> return num_f(1)
  if y is val {undefined} -> return num_f(-1)
  if comparator is not val {undefined} {
    let result = ? @sec-tonumber(? @sec-call(comparator, undefined, [x, y]))
    if result is val {nan} -> return num_f(+0)
    return result
  }
  let xString = ? @sec-tostring(x)
  let yString = ? @sec-tostring(y)
  let xSmaller = ! @sec-islessthan(xString, yString, true)
  if xSmaller is val {true} -> return num_f(-1)
  let ySmaller = ! @sec-islessthan(yString, xString, true)
  if ySmaller is val {true} -> return num_f(1)
  return num_f(+0)
