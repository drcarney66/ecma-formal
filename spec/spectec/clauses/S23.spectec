  let limit = targetByteIndex + (targetElementSize * sourceLength)
  if sourceType is val {targetType} {
    note "The transfer must be performed in a manner that preserves the bit-level encoding of the source data."
    repeat_while targetByteIndex < limit {
      let value = @sec-getvaluefrombuffer(sourceBuffer, sourceByteIndex, ~uint8~, true, ~unordered~)
      perform @sec-setvalueinbuffer(targetBuffer, targetByteIndex, ~uint8~, value, true, ~unordered~)
      set var sourceByteIndex = sourceByteIndex + 1
      set var targetByteIndex = targetByteIndex + 1
    }
