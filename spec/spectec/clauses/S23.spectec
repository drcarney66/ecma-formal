def @sec-%typedarray%.prototype.with "%TypedArray%.prototype.with" (kind builtin params [index, value]) vars [#"this value", NewTarget, index, value, #"obj", taRecord, length, actualIndex, numericValue, resultArray, k, fromValue] {
