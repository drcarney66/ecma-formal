def @sec-array.prototype.splice "Array.prototype.splice" (kind builtin params [start, deleteCount, items rest]) vars [#"this value", NewTarget, start, deleteCount, items, #"obj", length, actualStart, itemCount, actualDeleteCount, dc, deletedArray, k, #"from", fromValue, #"to", item] {
  let #"obj" = ? @sec-toobject(this_value)
  let length = ? @sec-lengthofarraylike(#"obj")
  let actualStart = ? @sec-toclampedindex(start, length)
  let itemCount = $ListLen(?items)
  if start fails $Present() {
    let actualDeleteCount = 0
