def @sec-fromhex "FromHex" (kind ao params [string : String, maxLength : sort [#"non-negative"] integer opt] -> doc "a Record with fields [[Read]] (an integer), [[Bytes]] (a List of byte values), and [[Error]] (a *SyntaxError* object or ~none~)") vars [string, maxLength, length, bytes, read, error, hexits, byte] {
  if maxLength fails $Present() -> set var maxLength = 2 ^ 53 - 1
