def @sec-sortindexedproperties "SortIndexedProperties" (kind ao params [#"obj" : Object, length : sort [#"non-negative"] integer, sortCompare : pred(sat @ph-type-closure-two-params()), holes : val(~skip-holes~) | val(~read-through-holes~)] -> completion<list<#"ECMAScript language value">> | #"throw completion") vars [#"obj", length, sortCompare, holes, items, k, propertyKey, kRead, kValue, next, result, #"order", sorted, i] {
  let items = $ListNew()
  let k = 0
  repeat_while k < length {
    let propertyKey = ! @sec-tostring($𝔽(k))
    if holes is val {~skip-holes~} {
      let kRead = ? @sec-hasproperty(#"obj", propertyKey)
