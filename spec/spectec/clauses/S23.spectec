def @sec-array.prototype.includes "Array.prototype.includes" (kind builtin params [searchElement, fromIndex opt]) vars [#"this value", NewTarget, searchElement, fromIndex, #"obj", length, k, elementK] {
  let #"obj" = ? @sec-toobject(this_value)
  let length = ? @sec-lengthofarraylike(#"obj")
  if length == 0 -> return false
  let k = ? @sec-toclampedindex(fromIndex, length)
  repeat_while k < length {
