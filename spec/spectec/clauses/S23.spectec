    repeat_while targetByteIndex < limit {
      let value = @sec-getvaluefrombuffer(sourceBuffer, sourceByteIndex, sourceType, true, ~unordered~)
      perform @sec-setvalueinbuffer(targetBuffer, targetByteIndex, targetType, value, true, ~unordered~)
      set var sourceByteIndex = sourceByteIndex + sourceElementSize
      set var targetByteIndex = targetByteIndex + targetElementSize
    }
  }
  return ~unused~
}

