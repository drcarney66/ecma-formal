sdo_row @sec-static-semantics-modulerequests#10 ModuleRequests form alg {
  prods [p"Syntactic - ExportDeclaration : `export` NamedExports `;`", p"Syntactic - ExportDeclaration : `export` VariableStatement[~Yield, +Await]", p"Syntactic - ExportDeclaration : `export` [lookahead ∉ { `using`, `await` }] Declaration[~Yield, +Await]", p"Syntactic - ExportDeclaration : `export` `default` HoistableDeclaration[~Yield, +Await, +Default]", p"Syntactic - ExportDeclaration : `export` `default` ClassDeclaration[~Yield, +Await, +Default]", p"Syntactic - ExportDeclaration : `export` `default` [lookahead ∉ { `function`, `async` [no LineTerminator here] `function`, `class` }] AssignmentExpression[+In, ~Yield, +Await] `;`"]
  keys ["\n          ExportDeclaration :\n            `export` NamedExports `;`\n            `export` VariableStatement\n            `export` Declaration\n            `export` `default` HoistableDeclaration\n            `export` `default` ClassDeclaration\n            `export` `default` AssignmentExpression `;`\n        "]
