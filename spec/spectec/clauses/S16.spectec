sdo_row @sec-static-semantics-exportentries#6 ExportEntries form alg {
  prods [p"Syntactic - ExportDeclaration : `export` VariableStatement[~Yield, +Await]"]
  keys ["ExportDeclaration : `export` VariableStatement"]
  vars [entries, names, name]
  steps {
    let entries = $ListNew()
    let names = sdo BoundNames(child 5 |VariableStatement|)
    for_each name in names {
      perform $Append(record #"ExportEntry Record" { [[ModuleRequest]]: null, [[ImportName]]: null, [[LocalName]]: name, [[ExportName]]: name, [[NamespaceNamesFilter]]: ~empty~ }, ?entries)
    }
    return entries
  }
}

