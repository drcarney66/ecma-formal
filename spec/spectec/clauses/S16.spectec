sdo_row @sec-module-semantics-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic 0 Module : ModuleBody?"]
  keys ["Module : [empty]"]
  vars []
  steps {
    return undefined
  }
}

sdo_row @sec-module-semantics-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - ModuleBody : ModuleItemList"]
  keys ["ModuleBody : ModuleItemList"]
  vars [result]
  steps {
    let result = @sec-completion-ao(sdo Evaluation(child 5 |ModuleItemList|))
    if result is ty {#"normal completion"} and result[[Value]] is val {~empty~} {
      return undefined
    }
    return ? result
  }
}

sdo_row @sec-module-semantics-runtime-semantics-evaluation#2 Evaluation form alg {
  prods [p"Syntactic - ModuleItemList : ModuleItemList ModuleItem"]
  keys ["ModuleItemList : ModuleItemList ModuleItem"]
  vars [sl, s]
  steps {
    let sl = ? sdo Evaluation(child 5 |ModuleItemList|)
    let s = @sec-completion-ao(sdo Evaluation(child 5 |ModuleItem|))
    return ? @sec-updateempty(s, sl)
  }
}

