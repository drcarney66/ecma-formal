  }
}

sdo_row @sec-static-semantics-exportentriesformodule ExportEntriesForModule form alg {
  prods [p"Syntactic - ExportFromClause : `*`"]
  keys ["ExportFromClause : `*`"]
  vars [module, entry]
  steps {
    let entry = record #"ExportEntry Record" { [[ModuleRequest]]: module, [[ImportName]]: ~all-but-default~, [[LocalName]]: null, [[ExportName]]: null, [[NamespaceNamesFilter]]: ~empty~ }
    return [entry]
  }
}

sdo_row @sec-static-semantics-exportentriesformodule#1 ExportEntriesForModule form alg {
  prods [p"Syntactic - ExplicitExportFromClause : `*` `as` ModuleExportName"]
  keys ["\n          ExplicitExportFromClause : `*` `as` ModuleExportName\n        "]
  vars [module, exportName, entry]
  steps {
    let exportName = sdo StringValue(child 5 |ModuleExportName|)
    let entry = record #"ExportEntry Record" { [[ModuleRequest]]: module, [[ImportName]]: ~namespace~, [[LocalName]]: null, [[ExportName]]: exportName, [[NamespaceNamesFilter]]: ~empty~ }
    return [entry]
  }
}

sdo_row @sec-static-semantics-exportentriesformodule#2 ExportEntriesForModule form alg {
  prods [p"Syntactic - ExplicitExportFromClause : NamedExports `as` ModuleExportName"]
  keys ["ExplicitExportFromClause : NamedExports `as` ModuleExportName"]
  vars [module, exportName, importedNames, entry]
  steps {
    let exportName = sdo StringValue(child 5 |ModuleExportName|)
    let importedNames = sdo FilteredNamespaceImportedNames(child 5 |NamedExports|)
    let entry = record #"ExportEntry Record" { [[ModuleRequest]]: module, [[ImportName]]: ~filtered-namespace~, [[LocalName]]: null, [[ExportName]]: exportName, [[NamespaceNamesFilter]]: importedNames }
    return [entry]
  }
}

sdo_row @sec-static-semantics-exportentriesformodule#3 ExportEntriesForModule form alg {
  prods [p"Syntactic - NamedExports : `{` `}`"]
  keys ["NamedExports : `{` `}`"]
  vars [module]
  steps {
    return $ListNew()
  }
}

sdo_row @sec-static-semantics-exportentriesformodule#4 ExportEntriesForModule form alg {
  prods [p"Syntactic - ExportsList : ExportsList `,` ExportSpecifier"]
  keys ["ExportsList : ExportsList `,` ExportSpecifier"]
  vars [module, specs1, specs2]
  steps {
    let specs1 = sdo ExportEntriesForModule(child 5 |ExportsList|; module)
    let specs2 = sdo ExportEntriesForModule(child 5 |ExportSpecifier|; module)
    return $ListConcat([specs1, specs2])
  }
}

sdo_row @sec-static-semantics-exportentriesformodule#5 ExportEntriesForModule form alg {
  prods [p"Syntactic - ExportSpecifier : ModuleExportName"]
  keys ["ExportSpecifier : ModuleExportName"]
  vars [module, sourceName, localName, importName]
  steps {
    let sourceName = sdo StringValue(child 5 |ModuleExportName|)
    if module is val {null} {
      let localName = sourceName
      let importName = null
    }
    else {
      let localName = null
      let importName = sourceName
    }
    return $ListOf1(@ph-new-record(record #"ExportEntry Record" { [[ModuleRequest]]: module, [[ImportName]]: importName, [[LocalName]]: localName, [[ExportName]]: sourceName, [[NamespaceNamesFilter]]: ~empty~ }))
  }
}

sdo_row @sec-static-semantics-exportentriesformodule#6 ExportEntriesForModule form alg {
  prods [p"Syntactic - AliasedExportSpecifier : ModuleExportName `as` ModuleExportName"]
  keys ["\n          AliasedExportSpecifier : ModuleExportName `as` ModuleExportName\n        "]
  vars [module, sourceName, exportName, localName, importName]
  steps {
    let sourceName = sdo StringValue(child 0 |ModuleExportName|)
    let exportName = sdo StringValue(child 1 |ModuleExportName|)
    if module is val {null} {
      let localName = sourceName
      let importName = null
    }
    else {
      let localName = null
      let importName = sourceName
    }
    return $ListOf1(@ph-new-record(record #"ExportEntry Record" { [[ModuleRequest]]: module, [[ImportName]]: importName, [[LocalName]]: localName, [[ExportName]]: exportName, [[NamespaceNamesFilter]]: ~empty~ }))
  }
}

