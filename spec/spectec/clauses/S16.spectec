sdo_row @sec-exports-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic 0 ExportDeclaration : `export` ExportFromClause FromClause WithClause? `;`", p"Syntactic 1 ExportDeclaration : `export` ExportFromClause FromClause WithClause? `;`", p"Syntactic 0 ExportDeclaration : `export` `defer` ExplicitExportFromClause FromClause WithClause? `;`", p"Syntactic 1 ExportDeclaration : `export` `defer` ExplicitExportFromClause FromClause WithClause? `;`", p"Syntactic - ExportDeclaration : `export` NamedExports `;`"]
  keys ["\n          ExportDeclaration :\n            `export` ExportFromClause FromClause WithClause? `;`\n            `export` `defer` ExplicitExportFromClause FromClause WithClause? `;`\n            `export` NamedExports `;`\n        "]
  vars []
  steps {
    return ~empty~
  }
}

sdo_row @sec-exports-runtime-semantics-evaluation#1 Evaluation form alg {
  prods [p"Syntactic - ExportDeclaration : `export` VariableStatement[~Yield, +Await]"]
  keys ["ExportDeclaration : `export` VariableStatement"]
  vars []
  steps {
    return ? sdo Evaluation(child 5 |VariableStatement|)
  }
}

sdo_row @sec-exports-runtime-semantics-evaluation#2 Evaluation form alg {
  prods [p"Syntactic - ExportDeclaration : `export` [lookahead ∉ { `using`, `await` }] Declaration[~Yield, +Await]"]
  keys ["ExportDeclaration : `export` Declaration"]
  vars []
  steps {
    return ? sdo Evaluation(child 5 |Declaration|)
  }
}

sdo_row @sec-exports-runtime-semantics-evaluation#3 Evaluation form alg {
  prods [p"Syntactic - ExportDeclaration : `export` `default` HoistableDeclaration[~Yield, +Await, +Default]"]
  keys ["ExportDeclaration : `export` `default` HoistableDeclaration"]
  vars []
  steps {
    return ? sdo Evaluation(child 5 |HoistableDeclaration|)
  }
}

sdo_row @sec-exports-runtime-semantics-evaluation#4 Evaluation form alg {
  prods [p"Syntactic - ExportDeclaration : `export` `default` ClassDeclaration[~Yield, +Await, +Default]"]
  keys ["ExportDeclaration : `export` `default` ClassDeclaration"]
  vars [value, className, envRecord]
  steps {
    let value = ? sdo BindingClassDeclarationEvaluation(child 5 |ClassDeclaration|)
    let className = $ListElem(data choice 0, sdo BoundNames(child 5 |ClassDeclaration|))
    if className is val {"*default*"} {
      let envRecord = $Component($Running(), [[LexicalEnvironment]])
      perform ? @sec-initializeboundname("*default*", value, envRecord)
    }
    return ~empty~
  }
}

sdo_row @sec-exports-runtime-semantics-evaluation#5 Evaluation form alg {
  prods [p"Syntactic - ExportDeclaration : `export` `default` [lookahead ∉ { `function`, `async` [no LineTerminator here] `function`, `class` }] AssignmentExpression[+In, ~Yield, +Await] `;`"]
  keys ["ExportDeclaration : `export` `default` AssignmentExpression `;`"]
  vars [value, rhs, envRecord]
  steps {
    if @sec-isanonymousfunctiondefinition(child 5 |AssignmentExpression|) is val {true} {
      let value = ? sdo NamedEvaluation(child 5 |AssignmentExpression|; "default")
    }
    else {
      let rhs = ? sdo Evaluation(child 5 |AssignmentExpression|)
      let value = ? @sec-getvalue(rhs)
    }
    let envRecord = $Component($Running(), [[LexicalEnvironment]])
    perform ? @sec-initializeboundname("*default*", value, envRecord)
    return ~empty~
  }
}

