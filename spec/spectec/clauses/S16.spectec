  }
}

sdo_row @sec-static-semantics-modulerequests#4 ModuleRequests form alg {
  prods [p"Syntactic 0 ImportDeclaration : `import` ImportClause FromClause WithClause? `;`"]
  keys ["ImportDeclaration : `import` ImportClause FromClause `;`"]
  vars [specifier, directImportedNames, filteredNamespaceImportedNames]
  steps {
    let specifier = sdo SV(child 5 |FromClause|)
    let directImportedNames = sdo DirectImportedNames(child 5 |ImportClause|)
    let filteredNamespaceImportedNames = sdo FilteredNamespaceImportedNames(child 5 |ImportClause|)
    return $ListOf1(record #"ModuleRequest Record" { [[Specifier]]: specifier, [[Attributes]]: [], [[Phase]]: ~evaluation~, [[ImportedNames]]: @ph-new-record(record #"ImportedNames Record" { [[Direct]]: directImportedNames, [[Namespace]]: filteredNamespaceImportedNames }) })
  }
}

