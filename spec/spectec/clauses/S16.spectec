sdo_row @sec-static-semantics-optionalindirectexportentries#1 OptionalIndirectExportEntries form alg {
  prods [p"Syntactic - ModuleItemList : ModuleItemList ModuleItem"]
  keys ["ModuleItemList : ModuleItemList ModuleItem"]
  vars [entries1, entries2]
  steps {
    let entries1 = sdo OptionalIndirectExportEntries(child 5 |ModuleItemList|)
    let entries2 = sdo OptionalIndirectExportEntries(child 5 |ModuleItem|)
    return $ListConcat([entries1, entries2])
  }
}

sdo_row @sec-static-semantics-optionalindirectexportentries#2 OptionalIndirectExportEntries form alg {
  prods [p"Syntactic - ModuleItem : ImportDeclaration", p"Syntactic - ModuleItem : StatementListItem[~Yield, +Await, ~Return]", p"Syntactic - ExportDeclaration : `export` NamedExports `;`", p"Syntactic - ExportDeclaration : `export` VariableStatement[~Yield, +Await]", p"Syntactic - ExportDeclaration : `export` [lookahead ∉ { `using`, `await` }] Declaration[~Yield, +Await]", p"Syntactic - ExportDeclaration : `export` `default` HoistableDeclaration[~Yield, +Await, +Default]", p"Syntactic - ExportDeclaration : `export` `default` ClassDeclaration[~Yield, +Await, +Default]", p"Syntactic - ExportDeclaration : `export` `default` [lookahead ∉ { `function`, `async` [no LineTerminator here] `function`, `class` }] AssignmentExpression[+In, ~Yield, +Await] `;`"]
  keys ["\n          ModuleItem :\n            ImportDeclaration\n            StatementListItem\n\n          ExportDeclaration :\n            `export` NamedExports `;`\n            `export` VariableStatement\n            `export` Declaration\n            `export` `default` HoistableDeclaration\n            `export` `default` ClassDeclaration\n            `export` `default` AssignmentExpression `;`\n        "]
  vars []
  steps {
    return $ListNew()
  }
}

sdo_row @sec-static-semantics-optionalindirectexportentries#3 OptionalIndirectExportEntries form alg {
  prods [p"Syntactic 0 ExportDeclaration : `export` ExportFromClause FromClause WithClause? `;`", p"Syntactic 1 ExportDeclaration : `export` ExportFromClause FromClause WithClause? `;`"]
  keys ["ExportDeclaration : `export` ExportFromClause FromClause WithClause? `;`"]
  vars [request]
  steps {
    if child 5 |ExportFromClause| is val {prods [p"Syntactic - ExportFromClause : ExplicitExportFromClause"]} -> return $ListNew()
    if child 5 |WithClause| sat $Present() -> let request = @sec-ExportFromDeclarationModuleRequest(child 5 |ExportFromClause|, child 5 |FromClause|, ~evaluation~, child 5 |WithClause|)
    else -> let request = @sec-ExportFromDeclarationModuleRequest(child 5 |ExportFromClause|, child 5 |FromClause|, ~evaluation~)
    return sdo ExportEntriesForModule(child 5 |ExportFromClause|; request)
  }
}

sdo_row @sec-static-semantics-optionalindirectexportentries#4 OptionalIndirectExportEntries form alg {
  prods [p"Syntactic 0 ExportDeclaration : `export` `defer` ExplicitExportFromClause FromClause WithClause? `;`", p"Syntactic 1 ExportDeclaration : `export` `defer` ExplicitExportFromClause FromClause WithClause? `;`"]
  keys ["ExportDeclaration : `export` `defer` ExplicitExportFromClause FromClause WithClause? `;`"]
  vars [phase, request]
  steps {
    if_else child 5 |ExplicitExportFromClause| is val {prods [p"Syntactic - ExplicitExportFromClause : NamedExports"]} { let phase = ~evaluation~ } else { let phase = ~defer~ }
    note "A deferred re-export of a namespace object creates a deferred namespace, in the same way as `import defer`. A deferred re-export of individual bindings only defers loading and evaluating the dependency until the bindings are imported."
    if child 5 |WithClause| sat $Present() -> let request = @sec-ExportFromDeclarationModuleRequest(child 5 |ExplicitExportFromClause|, child 5 |FromClause|, phase, child 5 |WithClause|)
    else -> let request = @sec-ExportFromDeclarationModuleRequest(child 5 |ExplicitExportFromClause|, child 5 |FromClause|, phase)
    return sdo ExportEntriesForModule(child 5 |ExplicitExportFromClause|; request)
  }
}

