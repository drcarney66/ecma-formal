}

sdo_row @sec-static-semantics-exportentriesformodule#1 ExportEntriesForModule form alg {
  prods [p"Syntactic - ExportFromClause : `*` `as` ModuleExportName"]
  keys ["ExportFromClause : `*` `as` ModuleExportName"]
  vars [module, exportName, entry]
  steps {
    let exportName = sdo StringValue(child 5 |ModuleExportName|)
    let entry = record #"ExportEntry Record" { [[ModuleRequest]]: module, [[ImportName]]: ~namespace~, [[LocalName]]: null, [[ExportName]]: exportName }
