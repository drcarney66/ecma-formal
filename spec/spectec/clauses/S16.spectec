sdo_row @sec-withclausetoattributes WithClauseToAttributes form alg {
  prods [p"Syntactic - WithClause : `with` `{` `}`"]
  keys ["\n          WithClause : `with` `{` `}`\n        "]
  vars []
  steps {
    return $ListNew()
  }
}

sdo_row @sec-withclausetoattributes#1 WithClauseToAttributes form alg {
  prods [p"Syntactic 0 WithClause : `with` `{` WithEntries `,`? `}`", p"Syntactic 1 WithClause : `with` `{` WithEntries `,`? `}`"]
  keys ["\n          WithClause : `with` `{` WithEntries `,`? `}`\n        "]
  vars [attrs, #"rest", sorted, least, a]
  steps {
    let attrs = sdo WithClauseToAttributes(child 5 |WithEntries|)
    let #"rest" = $Copy(?attrs)
    let sorted = $ListNew()
    repeat_while #"rest" fails $IsEmpty() {
      let least = $ListElem(data choice 1, ?#"rest")
      for_each a in #"rest" {
        if ! @sec-islessthan(a[[Key]], least[[Key]], true) is val {true} -> set var least = a
      }
      perform $Append(?least, ?sorted)
      perform $RemoveElem(?least, ?#"rest")
    }
    set var attrs = sorted
    return attrs
  }
}

sdo_row @sec-withclausetoattributes#2 WithClauseToAttributes form alg {
  prods [p"Syntactic - WithEntries : AttributeKey `:` StringLiteral"]
  keys ["WithEntries : AttributeKey `:` StringLiteral"]
  vars [key, entry]
  steps {
    let key = sdo PropName(child 5 |AttributeKey|)
    let entry = record #"ImportAttribute Record" { [[Key]]: key, [[Value]]: sdo SV(child 5 |StringLiteral|) }
    return [entry]
  }
}

sdo_row @sec-withclausetoattributes#3 WithClauseToAttributes form alg {
  prods [p"Syntactic - WithEntries : AttributeKey `:` StringLiteral `,` WithEntries"]
  keys ["WithEntries : AttributeKey `:` StringLiteral `,` WithEntries"]
  vars [key, entry, #"rest"]
  steps {
    let key = sdo PropName(child 5 |AttributeKey|)
    let entry = record #"ImportAttribute Record" { [[Key]]: key, [[Value]]: sdo SV(child 5 |StringLiteral|) }
    let #"rest" = sdo WithClauseToAttributes(child 5 |WithEntries|)
    return $ListConcat([[entry], #"rest"])
  }
}

