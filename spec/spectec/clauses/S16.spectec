-- ECMA-262 SpecTec Clauses: S16

def @sec-parse-script "ParseScript" (kind ao params [sourceText : String | seq<#"Unicode code point">, #"realm" : #"Realm Record", hostDefined : pred(sat @ph-type-anything())] -> #"Script Record" | pred(sat @ph-type-syntax-errors())) vars [sourceText, #"realm", hostDefined, script] {
  let script = @sec-parsetext(sourceText, |Script|)
  if script is ty {list<error>} -> return script
  return record #"Script Record" { [[Realm]]: #"realm", [[ECMAScriptCode]]: script, [[LoadedModules]]: [], [[HostDefined]]: hostDefined }
}

def @sec-runtime-semantics-scriptevaluation "ScriptEvaluation" (kind ao params [scriptRecord : #"Script Record"] -> completion<#"ECMAScript language value"> | #"abrupt completion") vars [scriptRecord, globalEnv, scriptContext, scriptNode, result] {
  let globalEnv = scriptRecord[[Realm]][[GlobalEnv]]
  let scriptContext = $NewRecord(data sort #"ECMAScript code execution context")
  set expr component [[Function]] of scriptContext = null
  set expr component [[Realm]] of scriptContext = scriptRecord[[Realm]]
  set expr component [[ScriptOrModule]] of scriptContext = scriptRecord
  set expr component [[VariableEnvironment]] of scriptContext = globalEnv
  set expr component [[LexicalEnvironment]] of scriptContext = globalEnv
  set expr component [[PrivateEnvironment]] of scriptContext = null
  suspend $Running() kind 0
  push scriptContext kind 0
  let scriptNode = scriptRecord[[ECMAScriptCode]]
  let result = @sec-completion-ao(@sec-globaldeclarationinstantiation(scriptNode, globalEnv))
  if result is ty {#"normal completion"} {
    set var result = @sec-completion-ao(sdo Evaluation(scriptNode))
    if result is ty {#"normal completion"} and result[[Value]] is val {~empty~} {
      set var result = @sec-normalcompletion(undefined)
    }
  }
  suspend scriptContext kind 1
  assert expr @ph-not-the-case(data choice 1, bool(expr $StackEmpty()))
  resume_top
  return ? result
}

def @sec-globaldeclarationinstantiation "GlobalDeclarationInstantiation" (kind ao params [script : |Script|, envRecord : #"Global Environment Record"] -> completion<val(~unused~)> | #"throw completion") vars [script, envRecord, lexicalNames, variableNames, name, hasRestrictedGlobal, variableDecls, funcsToInitialize, declaredFuncNames, variableDecl, funcName, funcDefinable, declaredVariableNames, variableDefinable, strict, declaredFuncOrVariableNames, funcDecl, x, globalEnv, blockEnv, funcObj, lexicalDecls, privateEnv, lexicalDecl, variableName] {
  let lexicalNames = sdo LexicallyDeclaredNames(script)
  let variableNames = sdo VarDeclaredNames(script)
  for_each name in lexicalNames {
    if @sec-haslexicaldeclaration(envRecord, name) is val {true} -> throw @ph-new-error([[SyntaxError]])
    let hasRestrictedGlobal = ? @sec-hasrestrictedglobalproperty(envRecord, name)
    note "Global `var` and `function` bindings (except those that are introduced by non-strict direct eval) are non-configurable and are therefore restricted global properties."
    if hasRestrictedGlobal is val {true} -> throw @ph-new-error([[SyntaxError]])
  }
  for_each name in variableNames {
    if @sec-haslexicaldeclaration(envRecord, name) is val {true} -> throw @ph-new-error([[SyntaxError]])
  }
  let variableDecls = sdo VarScopedDeclarations(script)
  let funcsToInitialize = $ListNew()
  let declaredFuncNames = $ListNew()
  for_each variableDecl rev in variableDecls {
    if variableDecl is not ty {|VariableDeclaration|; |ForBinding|; |BindingIdentifier|} {
      assert variableDecl is ty {|FunctionDeclaration|; |GeneratorDeclaration|; |AsyncFunctionDeclaration|; |AsyncGeneratorDeclaration|}
      note "If there are multiple function declarations for the same name, the last declaration is used."
      let funcName = $ListElem(data choice 0, sdo BoundNames(variableDecl))
      if declaredFuncNames fails $Contains(?funcName) {
        let funcDefinable = ? @sec-candeclareglobalfunction(envRecord, funcName)
        if funcDefinable is val {false} -> throw @ph-new-error([[TypeError]])
        perform $Append(?funcName, ?declaredFuncNames)
        perform $Insert(?variableDecl, ?funcsToInitialize)
      }
    }
  }
  let declaredVariableNames = $ListNew()
  for_each variableDecl in variableDecls {
    if variableDecl is ty {|VariableDeclaration|; |ForBinding|; |BindingIdentifier|} {
      for_each name : String in sdo BoundNames(variableDecl) {
        if declaredFuncNames fails $Contains(?name) {
          let variableDefinable = ? @sec-candeclareglobalvar(envRecord, name)
          if variableDefinable is val {false} -> throw @ph-new-error([[TypeError]])
          if declaredVariableNames fails $Contains(?name) {
            perform $Append(?name, ?declaredVariableNames)
          }
        }
      }
    }
  }
  note "No abnormal terminations occur after this algorithm step if the global object is an ordinary object. However, if the global object is a Proxy exotic object it may exhibit behaviours that cause abnormal terminations in some of the following steps."
  if expr $"the host is a web browser"(data choice 0, clause @sec-block-level-function-declarations-web-legacy-compatibility-semantics) {
    let strict = sdo ScriptIsStrict(script)
    if strict is val {false} {
      let declaredFuncOrVariableNames = $ListConcat([declaredFuncNames, declaredVariableNames])
      for_each funcDecl in @ph-annexb-foreach(|FunctionDeclaration|, ?funcDecl, |StatementList|, [|Block|, |CaseClause|, |DefaultClause|], ?x, ?script, ?x) {
        let funcName = sdo StringValue($ChildOf(|BindingIdentifier|, ?funcDecl))
        if expr @ph-annexb-replacing(|FunctionDeclaration|, ?funcDecl, |VariableStatement|, ?funcName, |BindingIdentifier|, ?script) {
          if @sec-haslexicaldeclaration(envRecord, funcName) is val {false} {
            let funcDefinable = ? @sec-candeclareglobalvar(envRecord, funcName)
            if funcDefinable is val {true} {
              note "A var binding for _funcName_ is only instantiated here if it is neither a VarDeclaredName nor the name of another |FunctionDeclaration|."
              if declaredFuncOrVariableNames fails $Contains(?funcName) {
                perform ? @sec-createglobalvarbinding(envRecord, funcName, false)
                perform $Append(?funcName, ?declaredFuncOrVariableNames)
              }
              perform @ph-annexb-evaluated(|FunctionDeclaration|, ?funcDecl, |FunctionDeclaration|, clause @sec-function-definitions-runtime-semantics-evaluation, closure 0)
            }
          }
        }
      }
    }
  }
  let lexicalDecls = sdo LexicallyScopedDeclarations(script)
  let privateEnv = null
  for_each lexicalDecl in lexicalDecls {
    note "Lexically declared names are only instantiated here but not initialized."
    for_each name in sdo BoundNames(lexicalDecl) {
      if sdo IsConstantDeclaration(lexicalDecl) is val {true} {
        perform ? envRecord.CreateImmutableBinding(name, true)
      }
      else {
        perform ? envRecord.CreateMutableBinding(name, false)
      }
    }
  }
  for_each funcDecl : #"Parse Node" in funcsToInitialize {
    let funcName = $ListElem(data choice 0, sdo BoundNames(funcDecl))
    let funcObj = sdo InstantiateFunctionDeclaration(funcDecl; envRecord, privateEnv)
    perform ? @sec-createglobalfunctionbinding(envRecord, funcName, funcObj, false)
  }
  for_each variableName : String in declaredVariableNames {
    perform ? @sec-createglobalvarbinding(envRecord, variableName, false)
  }
  return ~unused~
  closure abstract params none captures [funcName] {
    let globalEnv = $Component($Running(), [[VariableEnvironment]])
    let blockEnv = $Component($Running(), [[LexicalEnvironment]])
    let funcObj = ! blockEnv.GetBindingValue(funcName, false)
    perform ? globalEnv.SetMutableBinding(funcName, funcObj, false)
    return ~unused~
  }
}

def @sec-importedlocalnames "ImportedLocalNames" (kind ao params [importEntries : list<#"ImportEntry Record">] -> list<String>) vars [importEntries, localNames, importEntry] {
  let localNames = $ListNew()
  for_each importEntry : #"ImportEntry Record" in importEntries {
    perform $Append(importEntry[[LocalName]], ?localNames)
  }
  return localNames
}

def @sec-ModuleRequestsKeyEqual "ModuleRequestsKeyEqual" (kind ao params [left : #"ModuleRequest Record" | #"LoadedModuleRequest Record", right : #"ModuleRequest Record" | #"LoadedModuleRequest Record"] -> Boolean) vars [left, right, leftAttrs, rightAttrs, leftAttrsCount, rightAttrsCount, l, r] {
  if left[[Specifier]] is not val {right[[Specifier]]} -> return false
  let leftAttrs = left[[Attributes]]
  let rightAttrs = right[[Attributes]]
  let leftAttrsCount = $ListLen(?leftAttrs)
  let rightAttrsCount = $ListLen(?rightAttrs)
  if leftAttrsCount != rightAttrsCount -> return false
  for_each l : #"ImportAttribute Record" in leftAttrs {
    if rightAttrs sat @ph-not-contains-such(data choice 1, data sort #"ImportAttribute Record", ?r, closure 0) -> return false
  }
  return true
  closure abstract params [r] captures [l] {
    return bool(l[[Key]] is val {r[[Key]]} and l[[Value]] is val {r[[Value]]})
  }
}

def @sec-EvaluateModuleSync "EvaluateModuleSync" (kind ao params [module : #"Module Record", importedNames : #"ImportedNames Record" opt] -> completion<val(~unused~)> | #"throw completion") vars [module, importedNames, allImportedNames, evaluationList, previouslyImportedNames, optionalIndirectRequests, moduleToEvaluate, promise] {
  if importedNames fails $Present() -> set var importedNames = @ph-new-record(record #"ImportedNames Record" { [[Direct]]: [], [[Namespace]]: [] })
  let allImportedNames = @sec-AllImportedNames(importedNames)
  if @sec-ReadyForSyncExecution(module, allImportedNames, ~ignore-deferred-namespace~) is val {false} -> throw @ph-new-error([[TypeError]])
  let evaluationList = [module]
  if module is ty {#"Cyclic Module Record"} {
    let previouslyImportedNames = [@ph-new-record(record #"ModuleImportedNames Record" { [[Module]]: module, [[ImportedNames]]: @ph-new-record(record #"ImportedNames Record" { [[Direct]]: [], [[Namespace]]: [] }) })]
    let optionalIndirectRequests = @sec-GetNewOptionalIndirectExportsModuleRequests(module, @ph-new-record(record #"ImportedNames Record" { [[Direct]]: importedNames[[Direct]], [[Namespace]]: [] }), previouslyImportedNames)
    perform @sec-BuildEvaluationList(evaluationList, module, optionalIndirectRequests, previouslyImportedNames, ~ignore-deferred-namespace~)
  }
  for_each moduleToEvaluate : #"Module Record" in evaluationList {
    let promise = moduleToEvaluate.Evaluate()
    assert promise[[PromiseState]] is val {~fulfilled~; ~rejected~}
    if promise[[PromiseState]] is val {~rejected~} {
      if promise[[PromiseIsHandled]] is val {false} -> perform @sec-host-promise-rejection-tracker(promise, "handle")
      set field promise[[PromiseIsHandled]] = true
      throw promise[[PromiseResult]]
    }
  }
  return ~unused~
}

def @sec-cyclic-module-records "sec-cyclic-module-records" (kind untyped params []) vars [] {
  return $ListNew()
}

def @sec-LoadRequestedModules "LoadRequestedModules" (kind concrete_method recv module : #"Cyclic Module Record" params [importedNames : val(~all~) | list<String> opt, hostDefined : pred(sat @ph-type-anything()) opt] -> Promise) vars [module, importedNames, hostDefined, promiseCapability, state] {
  if importedNames fails $Present() -> set var importedNames = ~all~
  if hostDefined fails $Present() -> set var hostDefined = ~empty~
  let promiseCapability = ! @sec-newpromisecapability(intrinsic [[Promise]])
  let state = record #"GraphLoadingState Record" { [[IsLoading]]: true, [[PendingModulesCount]]: 1, [[Visited]]: [], [[PromiseCapability]]: promiseCapability, [[HostDefined]]: hostDefined }
  perform @sec-InnerModuleLoading(state, module, importedNames)
  return promiseCapability[[Promise]]
}

def @sec-InnerModuleLoading "InnerModuleLoading" (kind ao params [state : #"GraphLoadingState Record", module : #"Module Record", importedNames : val(~all~) | list<String>] -> val(~unused~)) vars [state, module, importedNames, requestsToLoad, r, optionalIndirectRequests, requestedModulesCount, request, error, #"record", loaded, values] {
  assert state[[IsLoading]] is val {true}
  if module is ty {#"Cyclic Module Record"} {
    let requestsToLoad = $ListNew()
    if state[[Visited]] sat @ph-not-contains-such(data choice 0, data sort #"ModuleImportedNames Record", ?r, closure 0) {
      if module[[Status]] is val {~new~} -> set var requestsToLoad = module[[RequestedModules]]
      perform $Append(@ph-new-record(record #"ModuleImportedNames Record" { [[Module]]: module, [[ImportedNames]]: @ph-new-record(record #"ImportedNames Record" { [[Direct]]: [], [[Namespace]]: [] }) }), state[[Visited]])
    }
    let optionalIndirectRequests = @sec-GetNewOptionalIndirectExportsModuleRequests(module, @ph-new-record(record #"ImportedNames Record" { [[Direct]]: importedNames, [[Namespace]]: [] }), state[[Visited]])
    set var requestsToLoad = $ListConcat([requestsToLoad, optionalIndirectRequests])
    let requestedModulesCount = $ListLen(?requestsToLoad)
    set field state[[PendingModulesCount]] = state[[PendingModulesCount]] + requestedModulesCount
    for_each request : #"ModuleRequest Record" in requestsToLoad {
      if @sec-AllImportAttributesSupported(request[[Attributes]]) is val {false} {
        let error = @sec-throwcompletion(@ph-new-error(err [[SyntaxError]]))
        perform @sec-ContinueModuleLoading(state, error, @sec-AllImportedNames(request[[ImportedNames]]))
      }
      else {
        let values = @ph-contains-such-binds(data choice 0, data sort #"LoadedModuleRequest Record", ?#"record", closure 1, module[[LoadedModules]])
        if $ListLen(values) == 1 or $ListLen(values) != 0 and expr $""() {
          let #"record" = values[0]
          perform @sec-InnerModuleLoading(state, #"record"[[Module]], @sec-AllImportedNames(request[[ImportedNames]]))
        }
        else {
          perform @sec-HostLoadImportedModule(module, request, state[[HostDefined]], state)
          note "HostLoadImportedModule will call FinishLoadingImportedModule, which re-enters the graph loading process through ContinueModuleLoading."
        }
      }
      if state[[IsLoading]] is val {false} -> return ~unused~
    }
  }
  assert state[[PendingModulesCount]] >= 1
  set field state[[PendingModulesCount]] = state[[PendingModulesCount]] - 1
  if state[[PendingModulesCount]] == 0 {
    set field state[[IsLoading]] = false
    for_each loaded : #"ModuleImportedNames Record" in state[[Visited]] {
      if loaded[[Module]][[Status]] is val {~new~} -> set field loaded[[Module]][[Status]] = ~unlinked~
    }
    perform ! @sec-call(state[[PromiseCapability]][[Resolve]], undefined, [undefined])
  }
  return ~unused~
  closure abstract params [r] captures [module] {
    return bool(r[[Module]] is val {module})
  }
  closure abstract params [#"record"] captures [request] {
    return bool(@sec-ModuleRequestsKeyEqual(#"record", request) is val {true})
  }
}

def @sec-ContinueModuleLoading "ContinueModuleLoading" (kind ao params [state : #"GraphLoadingState Record", moduleCompletion : completion<#"Module Record"> | #"throw completion", importedNames : val(~all~) | list<String>] -> val(~unused~)) vars [state, moduleCompletion, importedNames] {
  if state[[IsLoading]] is val {false} -> return ~unused~
  if moduleCompletion is ty {#"normal completion"} {
    perform @sec-InnerModuleLoading(state, moduleCompletion[[Value]], importedNames)
  }
  else {
    set field state[[IsLoading]] = false
    perform ! @sec-call(state[[PromiseCapability]][[Reject]], undefined, [moduleCompletion[[Value]]])
  }
  return ~unused~
}

def @sec-moduledeclarationlinking "Link" (kind concrete_method recv module : #"Cyclic Module Record" params [importedNames : val(~all~) | list<String> opt] -> completion<val(~unused~)> | #"throw completion") vars [module, importedNames, stack, result, requiredModule, optionalIndirectRequests, linkingList, previouslyImportedNames] {
  assert module[[Status]] is val {~unlinked~; ~linked~; ~evaluating-async~; ~evaluated~}
  if importedNames fails $Present() -> set var importedNames = ~all~
  let stack = $ListNew()
  let result = @sec-completion-ao(@sec-InnerModuleLinking(module, stack, 0))
  if result is ty {#"abrupt completion"} {
    for_each requiredModule : #"Cyclic Module Record" in stack {
      assert requiredModule[[Status]] is val {~linking~}
      set field requiredModule[[Status]] = ~unlinked~
    }
    assert module[[Status]] is val {~unlinked~}
    return ? result
  }
  assert module[[Status]] is val {~linked~; ~evaluating-async~; ~evaluated~}
  assert stack sat $IsEmpty()
  let optionalIndirectRequests = module.GetOptionalIndirectExportsModuleRequests(importedNames)
  let linkingList = $ListNew()
  let previouslyImportedNames = $ListNew()
  perform @sec-BuildLinkingList(linkingList, module, optionalIndirectRequests, previouslyImportedNames)
  for_each requiredModule : #"Module Record" in linkingList {
    assert_if requiredModule is ty {#"Cyclic Module Record"} then requiredModule[[Status]] is val {~unlinked~; ~linked~; ~evaluating-async~; ~evaluated~}
    perform ? requiredModule.Link([])
  }
  perform ? @sec-ValidateAllRequestedOptionalNamespaceExports(previouslyImportedNames)
  perform ? @sec-ValidateRequestedOptionalIndirectExports(module, importedNames)
  note "All exports of _module_ other than `export defer` ones are also validated by the InitializeEnvironment call on _module_ itself, and it is not observable which one throws the *SyntaxError*."
  if importedNames is val {~all~} -> perform ? @sec-ValidateOwnNamespaceExports(module, ~all~)
  return ~unused~
}

def @sec-InnerModuleLinking "InnerModuleLinking" (kind ao params [module : #"Module Record", stack : list<#"Cyclic Module Record">, index : sort [#"non-negative"] integer] -> completion<sort [#"non-negative"] integer> | #"throw completion") vars [module, stack, index, moduleIndex, linkingList, previouslyImportedNames, requiredModule, done] {
  if module is not ty {#"Cyclic Module Record"} {
    perform ? module.Link()
    return index
  }
  if module[[Status]] is val {~linking~; ~linked~; ~evaluating-async~; ~evaluated~} {
    return index
  }
  assert module[[Status]] is val {~unlinked~}
  set field module[[Status]] = ~linking~
  let moduleIndex = index
  set field module[[DFSAncestorIndex]] = index
  set var index = index + 1
  perform $Append(?module, ?stack)
  let linkingList = $ListNew()
  let previouslyImportedNames = $ListNew()
  perform @sec-BuildLinkingList(linkingList, module, module[[RequestedModules]], previouslyImportedNames)
  for_each requiredModule : #"Module Record" in linkingList {
    set var index = ? @sec-InnerModuleLinking(requiredModule, stack, index)
    if requiredModule is ty {#"Cyclic Module Record"} {
      assert requiredModule[[Status]] is val {~linking~; ~linked~; ~evaluating-async~; ~evaluated~}
      assert expr @ph-iff(bool(requiredModule[[Status]] is val {~linking~}), bool(stack sat $Contains(?requiredModule)))
      if requiredModule[[Status]] is val {~linking~} {
        set field module[[DFSAncestorIndex]] = $min(module[[DFSAncestorIndex]], requiredModule[[DFSAncestorIndex]])
      }
    }
  }
  perform ? module.InitializeEnvironment()
  perform ? @sec-ValidateAllRequestedOptionalNamespaceExports(previouslyImportedNames)
  assert module sat @ph-occurs-exactly-once(?stack)
  assert module[[DFSAncestorIndex]] <= moduleIndex
  if module[[DFSAncestorIndex]] == moduleIndex {
    let done = false
    repeat_while done is val {false} {
      let requiredModule = $ListElem(data choice 2, ?stack)
      perform $RemoveLast(?stack)
      assert requiredModule is ty {#"Cyclic Module Record"}
      set field requiredModule[[Status]] = ~linked~
      if expr @ph-same-tn(?requiredModule, ?module, data sort #"Module Record") -> set var done = true
    }
  }
  return index
}

def @sec-moduleevaluation "Evaluate" (kind concrete_method recv module : #"Cyclic Module Record" params [] -> Promise) vars [module, pending, seen, m, request, stack, promiseCapability, result, requiredModule] {
  let pending = [module]
  let seen = $ListNew()
  repeat_while pending fails $IsEmpty() {
    let m = $ListElem(data choice 1, ?pending)
    perform $RemoveFirst(?pending)
    if seen fails $Contains(?m) and m is ty {#"Cyclic Module Record"} {
      perform $Append(?m, ?seen)
      assert m[[Status]] is val {~evaluating~; ~linked~; ~evaluating-async~; ~evaluated~}
      for_each request : #"ModuleRequest Record" in m[[RequestedModules]] {
        perform $Append(@sec-GetImportedModule(m, request), ?pending)
      }
    }
  }
  assert pass "If this call to Evaluate is happening at the same time as another call to Evaluate within the surrounding agent, ReadyForSyncExecution(_) is *true*"
  assert module[[Status]] is val {~linked~; ~evaluating-async~; ~evaluated~}
  if module[[Status]] is val {~evaluating-async~; ~evaluated~} {
    if module[[CycleRoot]] is not val {~empty~} {
      set var module = module[[CycleRoot]]
    }
    else {
      assert module[[Status]] is val {~evaluated~} and module[[EvaluationError]] is ty {#"throw completion"}
    }
  }
  if module[[TopLevelCapability]] is not val {~empty~} {
    return module[[TopLevelCapability]][[Promise]]
  }
  let stack = $ListNew()
  let promiseCapability = ! @sec-newpromisecapability(intrinsic [[Promise]])
  set field module[[TopLevelCapability]] = promiseCapability
  let result = @sec-completion-ao(@sec-innermoduleevaluation(module, stack, 0))
  if result is ty {#"abrupt completion"} {
    for_each requiredModule : #"Cyclic Module Record" in stack {
      assert requiredModule[[Status]] is val {~evaluating~}
      set field requiredModule[[Status]] = ~evaluated~
      set field requiredModule[[EvaluationError]] = result
    }
    assert module[[Status]] is val {~evaluated~}
    assert expr @ph-same-tn(module[[EvaluationError]], ?result, data sort #"Completion Record")
    perform ! @sec-call(promiseCapability[[Reject]], undefined, [result[[Value]]])
  }
  else {
    assert module[[Status]] is val {~evaluating-async~; ~evaluated~}
    assert module[[EvaluationError]] is val {~empty~}
    if module[[Status]] is val {~evaluated~} {
      assert module[[AsyncEvaluationOrder]] is val {~unset~; ~done~}
      note "_module_.[[AsyncEvaluationOrder]] is ~done~ if and only if _module_ had already been evaluated and that evaluation was asynchronous."
      perform ! @sec-call(promiseCapability[[Resolve]], undefined, [undefined])
    }
    assert stack sat $IsEmpty()
  }
  return promiseCapability[[Promise]]
}

def @sec-innermoduleevaluation "InnerModuleEvaluation" (kind ao params [module : #"Module Record", stack : list<#"Cyclic Module Record">, index : sort [#"non-negative"] integer] -> completion<sort [#"non-negative"] integer> | #"throw completion") vars [module, stack, index, moduleIndex, evaluationList, requiredModule, done] {
  if module is not ty {#"Cyclic Module Record"} {
    perform ? @sec-EvaluateModuleSync(module)
    return index
  }
  if module[[Status]] is val {~evaluating-async~; ~evaluated~} {
    if module[[EvaluationError]] is val {~empty~} -> return index
    return ? module[[EvaluationError]]
  }
  if module[[Status]] is val {~evaluating~} -> return index
  assert module[[Status]] is val {~linked~}
  set field module[[Status]] = ~evaluating~
  let moduleIndex = index
  set field module[[DFSAncestorIndex]] = index
  set field module[[PendingAsyncDependencies]] = 0
  set var index = index + 1
  let evaluationList = $ListNew()
  perform @sec-BuildEvaluationList(evaluationList, module, module[[RequestedModules]], [], ~gather-async-deps~)
  perform $Append(?module, ?stack)
  for_each requiredModule : #"Module Record" in evaluationList {
    set var index = ? @sec-innermoduleevaluation(requiredModule, stack, index)
    if requiredModule is ty {#"Cyclic Module Record"} {
      assert requiredModule[[Status]] is val {~evaluating~; ~evaluating-async~; ~evaluated~}
      assert expr @ph-iff(bool(requiredModule[[Status]] is val {~evaluating~}), bool(stack sat $Contains(?requiredModule)))
      if requiredModule[[Status]] is val {~evaluating~} {
        set field module[[DFSAncestorIndex]] = $min(module[[DFSAncestorIndex]], requiredModule[[DFSAncestorIndex]])
      }
      else {
        set var requiredModule = requiredModule[[CycleRoot]]
        assert requiredModule[[Status]] is val {~evaluating-async~; ~evaluated~}
        if requiredModule[[EvaluationError]] is not val {~empty~} -> return ? requiredModule[[EvaluationError]]
      }
      if requiredModule[[AsyncEvaluationOrder]] is ty {integer} {
        set field module[[PendingAsyncDependencies]] = module[[PendingAsyncDependencies]] + 1
        perform $Append(?module, requiredModule[[AsyncParentModules]])
      }
    }
  }
  if module[[HasTLA]] is val {true} or module[[PendingAsyncDependencies]] > 0 {
    assert module[[AsyncEvaluationOrder]] is val {~unset~}
    set field module[[AsyncEvaluationOrder]] = @sec-IncrementModuleAsyncEvaluationCount()
    if module[[PendingAsyncDependencies]] == 0 -> perform @sec-execute-async-module(module)
  }
  else {
    perform ? module.ExecuteModule()
  }
  assert module sat @ph-occurs-exactly-once(?stack)
  assert module[[DFSAncestorIndex]] <= moduleIndex
  if module[[DFSAncestorIndex]] == moduleIndex {
    let done = false
    repeat_while done is val {false} {
      let requiredModule = $ListElem(data choice 2, ?stack)
      perform $RemoveLast(?stack)
      assert requiredModule is ty {#"Cyclic Module Record"}
      assert requiredModule[[AsyncEvaluationOrder]] is ty {integer} or requiredModule[[AsyncEvaluationOrder]] is val {~unset~}
      if requiredModule[[AsyncEvaluationOrder]] is val {~unset~} -> set field requiredModule[[Status]] = ~evaluated~
      else -> set field requiredModule[[Status]] = ~evaluating-async~
      if expr @ph-same-tn(?requiredModule, ?module, data sort #"Module Record") -> set var done = true
      set field requiredModule[[CycleRoot]] = module
    }
  }
  return index
}

def @sec-execute-async-module "ExecuteAsyncModule" (kind ao params [module : #"Cyclic Module Record"] -> val(~unused~)) vars [module, promiseCapability, fulfilledClosure, onFulfilled, rejectedClosure, error, onRejected] {
  assert module[[Status]] is val {~evaluating~; ~evaluating-async~}
  assert module[[HasTLA]] is val {true}
  let promiseCapability = ! @sec-newpromisecapability(intrinsic [[Promise]])
  let fulfilledClosure = closure 0
  let onFulfilled = @sec-createbuiltinfunction(fulfilledClosure, 0, "", [])
  let rejectedClosure = closure 1
  let onRejected = @sec-createbuiltinfunction(rejectedClosure, 0, "", [])
  perform @sec-performpromisethen(promiseCapability[[Promise]], onFulfilled, onRejected)
  perform ! module.ExecuteModule(promiseCapability)
  return ~unused~
  closure abstract params none captures [module] {
    perform @sec-async-module-execution-fulfilled(module)
    return @sec-normalcompletion(undefined)
  }
  closure abstract params [error] captures [module] {
    perform @sec-async-module-execution-rejected(module, error)
    return @sec-normalcompletion(undefined)
  }
}

def @sec-gather-available-ancestors "GatherAvailableAncestors" (kind ao params [module : #"Cyclic Module Record", execList : list<#"Cyclic Module Record">] -> val(~unused~)) vars [module, execList, ancestorModule] {
  for_each ancestorModule : #"Cyclic Module Record" in module[[AsyncParentModules]] {
    if execList fails $Contains(?ancestorModule) and ancestorModule[[CycleRoot]][[EvaluationError]] is val {~empty~} {
      assert ancestorModule[[Status]] is val {~evaluating-async~}
      assert ancestorModule[[EvaluationError]] is val {~empty~}
      assert ancestorModule[[AsyncEvaluationOrder]] is ty {integer}
      assert ancestorModule[[PendingAsyncDependencies]] > 0
      set field ancestorModule[[PendingAsyncDependencies]] = ancestorModule[[PendingAsyncDependencies]] - 1
      if ancestorModule[[PendingAsyncDependencies]] == 0 {
        perform $Append(?ancestorModule, ?execList)
        if ancestorModule[[HasTLA]] is val {false} -> perform @sec-gather-available-ancestors(ancestorModule, execList)
      }
    }
  }
  return ~unused~
}

def @sec-async-module-execution-fulfilled "AsyncModuleExecutionFulfilled" (kind ao params [module : #"Cyclic Module Record"] -> val(~unused~)) vars [module, execList, sortedExecList, ancestorModule, result] {
  if module[[Status]] is val {~evaluated~} {
    assert module[[EvaluationError]] is not val {~empty~}
    return ~unused~
  }
  assert module[[Status]] is val {~evaluating-async~}
  assert module[[AsyncEvaluationOrder]] is ty {integer}
  assert module[[EvaluationError]] is val {~empty~}
  set field module[[AsyncEvaluationOrder]] = ~done~
  set field module[[Status]] = ~evaluated~
  if module[[TopLevelCapability]] is not val {~empty~} {
    assert expr @ph-same-tn(module[[CycleRoot]], ?module, data sort #"Module Record")
    perform ! @sec-call(module[[TopLevelCapability]][[Resolve]], undefined, [undefined])
  }
  let execList = $ListNew()
  perform @sec-gather-available-ancestors(module, execList)
  assert expr @ph-all-ready-to-evaluate(?execList)
  let sortedExecList = @ph-elements-by-async-order(?execList)
  for_each ancestorModule : #"Cyclic Module Record" in sortedExecList {
    if ancestorModule[[Status]] is val {~evaluated~} {
      assert ancestorModule[[EvaluationError]] is not val {~empty~}
    }
    else_if ancestorModule[[HasTLA]] is val {true} {
      perform @sec-execute-async-module(ancestorModule)
    }
    else {
      let result = @sec-completion-ao(ancestorModule.ExecuteModule())
      if result is ty {#"abrupt completion"} {
        perform @sec-async-module-execution-rejected(ancestorModule, result[[Value]])
      }
      else {
        set field ancestorModule[[AsyncEvaluationOrder]] = ~done~
        set field ancestorModule[[Status]] = ~evaluated~
        if ancestorModule[[TopLevelCapability]] is not val {~empty~} {
          assert expr @ph-same-tn(ancestorModule[[CycleRoot]], ?ancestorModule, data sort #"Module Record")
          perform ! @sec-call(ancestorModule[[TopLevelCapability]][[Resolve]], undefined, [undefined])
        }
      }
    }
  }
  return ~unused~
}

def @sec-async-module-execution-rejected "AsyncModuleExecutionRejected" (kind ao params [module : #"Cyclic Module Record", error : #"ECMAScript language value"] -> val(~unused~)) vars [module, error, ancestorModule] {
  if module[[Status]] is val {~evaluated~} {
    assert module[[EvaluationError]] is not val {~empty~}
    return ~unused~
  }
  assert module[[Status]] is val {~evaluating-async~}
  assert module[[AsyncEvaluationOrder]] is ty {integer}
  assert module[[EvaluationError]] is val {~empty~}
  set field module[[EvaluationError]] = @sec-throwcompletion(error)
  set field module[[Status]] = ~evaluated~
  set field module[[AsyncEvaluationOrder]] = ~done~
  note "_module_.[[AsyncEvaluationOrder]] is set to ~done~ for symmetry with AsyncModuleExecutionFulfilled. In InnerModuleEvaluation, the value of a module's [[AsyncEvaluationOrder]] internal slot is unused when its [[EvaluationError]] internal slot is not ~empty~."
  if module[[TopLevelCapability]] is not val {~empty~} {
    assert expr @ph-same-tn(module[[CycleRoot]], ?module, data sort #"Module Record")
    perform ! @sec-call(module[[TopLevelCapability]][[Reject]], undefined, [error])
  }
  for_each ancestorModule : #"Cyclic Module Record" in module[[AsyncParentModules]] {
    perform @sec-async-module-execution-rejected(ancestorModule, error)
  }
  return ~unused~
}

def @sec-parsemodule "ParseModule" (kind ao params [sourceText : String | seq<#"Unicode code point">, #"realm" : #"Realm Record", hostDefined : pred(sat @ph-type-anything())] -> #"Source Text Module Record" | pred(sat @ph-type-syntax-errors())) vars [sourceText, #"realm", hostDefined, body, requestedModules, importEntries, importedBoundNames, indirectExportEntries, localExportEntries, starExportEntries, exportEntries, exportEntry, importEntry, optionalIndirectExportEntries, async] {
  let body = @sec-parsetext(sourceText, |Module|)
  if body is ty {list<error>} -> return body
  let requestedModules = sdo ModuleRequests(body)
  let importEntries = sdo ImportEntries(body)
  let importedBoundNames = @sec-importedlocalnames(importEntries)
  let indirectExportEntries = $ListNew()
  let localExportEntries = $ListNew()
  let starExportEntries = $ListNew()
  let exportEntries = sdo ExportEntries(body)
  for_each exportEntry : #"ExportEntry Record" in exportEntries {
    if exportEntry[[ModuleRequest]] is val {null} {
      if importedBoundNames fails $Contains(exportEntry[[LocalName]]) {
        perform $Append(?exportEntry, ?localExportEntries)
      }
      else {
        note "When exporting a binding or namespace object which was originally imported from another module, the ExportEntry Record is rewritten to match the form it would have if the binding or namespace object had been re-exported directly from the original module rather than imported then exported. This allows conflicts which arise from exporting the same binding or namespace twice under the same name through `export * from` to be ignored rather than being treated as ambiguous in step <emu-xref href=\"#step-resolveexport-conflict\"></emu-xref> of <emu-xref href=\"#sec-resolveexport\">the ResolveExport concrete method of Source Text Module Records</emu-xref>."
        let importEntry = @ph-elem-whose(?importEntries, [[LocalName]], data choice 1, exportEntry[[LocalName]])
        perform $Append(record #"ExportEntry Record" { [[ModuleRequest]]: importEntry[[ModuleRequest]], [[ImportName]]: importEntry[[ImportName]], [[LocalName]]: null, [[ExportName]]: exportEntry[[ExportName]], [[NamespaceNamesFilter]]: importEntry[[NamespaceNamesFilter]] }, ?indirectExportEntries)
      }
    }
    else_if exportEntry[[ImportName]] is val {~all-but-default~} {
      assert exportEntry[[ExportName]] is val {null}
      perform $Append(?exportEntry, ?starExportEntries)
    }
    else {
      perform $Append(?exportEntry, ?indirectExportEntries)
    }
  }
  let optionalIndirectExportEntries = sdo OptionalIndirectExportEntries(body)
  let async = @ph-contains(?body, term "await")
  return record #"Source Text Module Record" { [[Realm]]: #"realm", [[Environment]]: ~empty~, [[Namespace]]: ~empty~, [[DeferredNamespace]]: ~empty~, [[CycleRoot]]: ~empty~, [[HasTLA]]: async, [[AsyncEvaluationOrder]]: ~unset~, [[TopLevelCapability]]: ~empty~, [[AsyncParentModules]]: [], [[PendingAsyncDependencies]]: ~empty~, [[Status]]: ~new~, [[EvaluationError]]: ~empty~, [[HostDefined]]: hostDefined, [[ECMAScriptCode]]: body, [[Context]]: ~empty~, [[ImportMeta]]: ~empty~, [[RequestedModules]]: requestedModules, [[LoadedModules]]: [], [[ImportEntries]]: importEntries, [[LocalExportEntries]]: localExportEntries, [[IndirectExportEntries]]: indirectExportEntries, [[StarExportEntries]]: starExportEntries, [[OptionalIndirectExportEntries]]: optionalIndirectExportEntries, [[PendingOptionalFilteredNamespaceExports]]: [], [[DFSAncestorIndex]]: ~empty~ }
}

def @sec-getexportednames "GetExportedNames" (kind concrete_method recv module : #"Source Text Module Record" params [exportStarSet : list<#"Source Text Module Record"> opt] -> list<String>) vars [module, exportStarSet, exportedNames, exportEntry, requestedModule, starNames, name] {
  assert module[[Status]] is not val {~new~}
  if exportStarSet fails $Present() -> set var exportStarSet = $ListNew()
  if exportStarSet sat $Contains(?module) {
    assert pass "We've reached the starting point of an `export *` circularity"
    return $ListNew()
  }
  perform $Append(?module, ?exportStarSet)
  let exportedNames = @sec-getownexportednames(module)
  for_each exportEntry : #"ExportEntry Record" in module[[StarExportEntries]] {
    assert exportEntry[[ModuleRequest]] is not val {null}
    let requestedModule = @sec-GetImportedModule(module, exportEntry[[ModuleRequest]])
    let starNames = requestedModule.GetExportedNames(exportStarSet)
    for_each name in starNames {
      if name is not val {"default"} {
        if exportedNames fails $Contains(?name) {
          perform $Append(?name, ?exportedNames)
        }
      }
    }
  }
  return exportedNames
}

def @sec-resolveexport "ResolveExport" (kind concrete_method recv module : #"Source Text Module Record" params [exportName : String, resolveSet : list<record { [[Module]]: #"Module Record", [[ExportName]]: String }> opt] -> #"ResolvedBinding Record" | val(null) | val(~ambiguous~)) vars [module, exportName, resolveSet, #"record", exportEntry, allIndirectEntries, importedModule, localName, moduleNamespace, starResolution, resolution] {
  assert module[[Status]] is not val {~new~}
  if resolveSet fails $Present() -> set var resolveSet = $ListNew()
  for_each_rec [[[Module]], [[ExportName]]] #"record" in resolveSet {
    if expr @ph-same-tn(?module, #"record"[[Module]], data sort #"Module Record") and exportName is val {#"record"[[ExportName]]} {
      assert pass "This is a circular import request"
      return null
    }
  }
  perform $Append(record Record { [[Module]]: module, [[ExportName]]: exportName }, ?resolveSet)
  for_each exportEntry : #"ExportEntry Record" in module[[LocalExportEntries]] {
    if exportEntry[[ExportName]] is val {exportName} {
      assert module[[LocalExportEntries]] sat $Contains(?exportEntry)
      return record #"ResolvedBinding Record" { [[Module]]: module, [[BindingName]]: exportEntry[[LocalName]] }
    }
  }
  let allIndirectEntries = $ListConcat([module[[IndirectExportEntries]], module[[OptionalIndirectExportEntries]]])
  for_each exportEntry : #"ExportEntry Record" in allIndirectEntries {
    if exportEntry[[ExportName]] is val {exportName} {
      assert exportEntry[[ModuleRequest]] is not val {null}
      let importedModule = @sec-GetImportedModule(module, exportEntry[[ModuleRequest]])
      if exportEntry[[ImportName]] is val {~namespace~} {
        assert module[[LocalExportEntries]] fails $Contains(?exportEntry)
        assert exportEntry[[NamespaceNamesFilter]] is val {~empty~}
        if exportEntry[[ModuleRequest]][[Phase]] is val {~defer~} {
          return record #"ResolvedBinding Record" { [[Module]]: importedModule, [[BindingName]]: ~deferred-namespace~ }
        }
        else {
          assert exportEntry[[ModuleRequest]][[Phase]] is val {~evaluation~}
          return record #"ResolvedBinding Record" { [[Module]]: importedModule, [[BindingName]]: ~namespace~ }
        }
      }
      else_if exportEntry[[ImportName]] is val {~filtered-namespace~} {
        assert exportEntry[[NamespaceNamesFilter]] is ty {list<String>}
        let localName = $"string-concatenation"("*", exportName, "*")
        note "`export { ... } as ns from \"mod\"` introduces a local internal binding in the module that contains the |ExportDeclaration|. That binding is created by InitializeEnvironment, but for `export defer` declarations it is initialized here once a consumer attempts to resolve it."
        if module[[OptionalIndirectExportEntries]] sat $Contains(?exportEntry) {
          if module[[Environment]] is val {~empty~} {
            assert module[[Status]] is val {~unlinked~; ~linking~}
            note "When linking across cycles, _module_'s exports might be resolved by ResolveExport before InitializeEnvironment is called on _module_. In that case _module_.[[Environment]] is not set up yet, so the export is marked as needing initialization, which will then be performed by InitializeEnvironment itself."
            if module[[PendingOptionalFilteredNamespaceExports]] fails $Contains(?localName) -> perform $Append(?localName, module[[PendingOptionalFilteredNamespaceExports]])
          }
          else_if ! module[[Environment]].HasBinding(localName) is val {false} {
            perform ! module[[Environment]].CreateImmutableBinding(localName, true)
            let moduleNamespace = @sec-getmodulenamespace(importedModule, exportEntry[[ModuleRequest]][[Phase]], exportEntry[[NamespaceNamesFilter]])
            perform ! module[[Environment]].InitializeBinding(localName, moduleNamespace)
          }
        }
        return record #"ResolvedBinding Record" { [[Module]]: module, [[BindingName]]: localName }
      }
      assert allIndirectEntries sat $Contains(?exportEntry)
      assert exportEntry[[ImportName]] is ty {String}
      return importedModule.ResolveExport(exportEntry[[ImportName]], resolveSet)
    }
  }
  if exportName is val {"default"} {
    assert module sat @ph-not-explicitly-defined-export("default")
    return null
    note "A `default` export cannot be provided by an `export * from \"mod\"` declaration."
  }
  let starResolution = null
  for_each exportEntry : #"ExportEntry Record" in module[[StarExportEntries]] {
    assert exportEntry[[ModuleRequest]] is not val {null}
    let importedModule = @sec-GetImportedModule(module, exportEntry[[ModuleRequest]])
    let resolution = importedModule.ResolveExport(exportName, resolveSet)
    if resolution is val {~ambiguous~} -> return ~ambiguous~
    if resolution is not val {null} {
      assert resolution is ty {#"ResolvedBinding Record"}
      if starResolution is val {null} {
        set var starResolution = resolution
      }
      else {
        assert pass "There is more than one `*` export that includes the requested name"
        if expr @ph-not-same-tn(resolution[[Module]], starResolution[[Module]], data sort #"Module Record") -> return ~ambiguous~
        if resolution[[BindingName]] is not val {starResolution[[BindingName]]} -> return ~ambiguous~
      }
    }
  }
  return starResolution
}

def @sec-source-text-module-record-initialize-environment "InitializeEnvironment" (kind concrete_method recv module : #"Source Text Module Record" params [] -> completion<val(~unused~)> | #"throw completion") vars [module, exportEntry, importedModule, #"realm", envRecord, importEntry, namespace, resolution, phase, localName, filteredNamespace, moduleContext, #"code", variableDecls, declaredVariableNames, variableDecl, name, lexicalDecls, privateEnv, lexicalDecl, funcObj] {
  for_each exportEntry : #"ExportEntry Record" in module[[IndirectExportEntries]] {
    perform ? @sec-ensureresolvablebinding(module, exportEntry[[ExportName]], ~disallow-ambiguous~)
    if exportEntry[[ImportName]] is val {~namespace~} {
      let importedModule = @sec-GetImportedModule(module, exportEntry[[ModuleRequest]])
      note "All exports of _importedModule_ other than `export defer` ones are also validated by the InitializeEnvironment call on _importedModule_ itself, and it is not observable which of the two InitializeEnvironment calls throws the *SyntaxError*."
      perform ? @sec-ValidateOwnNamespaceExports(importedModule, ~all~)
    }
  }
  assert expr @ph-named-exports-resolvable(module)
  let #"realm" = module[[Realm]]
  assert #"realm" is not val {undefined}
  let envRecord = @sec-newmoduleenvironment(#"realm"[[GlobalEnv]])
  set field module[[Environment]] = envRecord
  for_each importEntry : #"ImportEntry Record" in module[[ImportEntries]] {
    let importedModule = @sec-GetImportedModule(module, importEntry[[ModuleRequest]])
    if importEntry[[ImportName]] is val {~namespace~} {
      note "All exports of _importedModule_ other than `export defer` ones are also validated by the InitializeEnvironment call on _importedModule_ itself, and it is not observable which of the two InitializeEnvironment calls throws the *SyntaxError*."
      perform ? @sec-ValidateOwnNamespaceExports(importedModule, ~all~)
      let namespace = @sec-getmodulenamespace(importedModule, importEntry[[ModuleRequest]][[Phase]], ~all~)
      perform ! envRecord.CreateImmutableBinding(importEntry[[LocalName]], true)
      perform ! envRecord.InitializeBinding(importEntry[[LocalName]], namespace)
    }
    else_if importEntry[[ImportName]] is val {~filtered-namespace~} {
      perform ? @sec-ValidateOwnNamespaceExports(importedModule, importEntry[[NamespaceNamesFilter]])
      let namespace = @sec-getmodulenamespace(importedModule, importEntry[[ModuleRequest]][[Phase]], importEntry[[NamespaceNamesFilter]])
      perform ! envRecord.CreateImmutableBinding(importEntry[[LocalName]], true)
      perform ! envRecord.InitializeBinding(importEntry[[LocalName]], namespace)
    }
    else {
      let resolution = importedModule.ResolveExport(importEntry[[ImportName]])
      if resolution is val {null; ~ambiguous~} -> throw @ph-new-error([[SyntaxError]])
      if resolution[[BindingName]] is val {~namespace~; ~deferred-namespace~} {
        if_else resolution[[BindingName]] is val {~namespace~} { let phase = ~evaluation~ } else { let phase = ~defer~ }
        let namespace = @sec-getmodulenamespace(resolution[[Module]], phase, ~all~)
        perform ! envRecord.CreateImmutableBinding(importEntry[[LocalName]], true)
        perform ! envRecord.InitializeBinding(importEntry[[LocalName]], namespace)
      }
      else {
        perform @sec-createimportbinding(envRecord, importEntry[[LocalName]], resolution[[Module]], resolution[[BindingName]])
      }
    }
  }
  for_each exportEntry : #"ExportEntry Record" in $ListConcat([module[[IndirectExportEntries]], module[[OptionalIndirectExportEntries]]]) {
    if exportEntry[[ImportName]] is val {~filtered-namespace~} {
      let localName = $"string-concatenation"("*", exportEntry[[ExportName]], "*")
      if module[[IndirectExportEntries]] sat $Contains(?exportEntry) {
        let importedModule = @sec-GetImportedModule(module, exportEntry[[ModuleRequest]])
        perform ? @sec-ValidateOwnNamespaceExports(importedModule, exportEntry[[NamespaceNamesFilter]])
        let filteredNamespace = @sec-getmodulenamespace(importedModule, exportEntry[[ModuleRequest]][[Phase]], exportEntry[[NamespaceNamesFilter]])
        perform ! envRecord.CreateImmutableBinding(localName, true)
        perform ! envRecord.InitializeBinding(localName, filteredNamespace)
      }
      else_if module[[PendingOptionalFilteredNamespaceExports]] sat $Contains(?localName) and ! envRecord.HasBinding(localName) is val {false} {
        perform ! envRecord.CreateImmutableBinding(localName, true)
        let importedModule = @sec-GetImportedModule(module, exportEntry[[ModuleRequest]])
        let filteredNamespace = @sec-getmodulenamespace(importedModule, exportEntry[[ModuleRequest]][[Phase]], exportEntry[[NamespaceNamesFilter]])
        perform ! envRecord.InitializeBinding(localName, filteredNamespace)
        note "The _localName_ binding of `export defer { ... } as ns from \"mod\"` is created and initialized by whichever of ResolveExport and InitializeEnvironment first needs it. If no importer ever resolves that export, it is never created at all."
      }
    }
  }
  let moduleContext = $NewRecord(data sort #"ECMAScript code execution context")
  set expr component [[Function]] of moduleContext = null
  assert module[[Realm]] is not val {undefined}
  set expr component [[Realm]] of moduleContext = module[[Realm]]
  set expr component [[ScriptOrModule]] of moduleContext = module
  set expr component [[VariableEnvironment]] of moduleContext = module[[Environment]]
  set expr component [[LexicalEnvironment]] of moduleContext = module[[Environment]]
  set expr component [[PrivateEnvironment]] of moduleContext = null
  set field module[[Context]] = moduleContext
  push moduleContext kind 0
  let #"code" = module[[ECMAScriptCode]]
  let variableDecls = sdo VarScopedDeclarations(#"code")
  let declaredVariableNames = $ListNew()
  for_each variableDecl in variableDecls {
    for_each name in sdo BoundNames(variableDecl) {
      if declaredVariableNames fails $Contains(?name) {
        perform ! envRecord.CreateMutableBinding(name, false)
        perform ! envRecord.InitializeBinding(name, undefined)
        perform $Append(?name, ?declaredVariableNames)
      }
    }
  }
  let lexicalDecls = sdo LexicallyScopedDeclarations(#"code")
  let privateEnv = null
  for_each lexicalDecl in lexicalDecls {
    for_each name in sdo BoundNames(lexicalDecl) {
      if sdo IsConstantDeclaration(lexicalDecl) is val {true} {
        perform ! envRecord.CreateImmutableBinding(name, true)
      }
      else {
        perform ! envRecord.CreateMutableBinding(name, false)
      }
      if lexicalDecl is ty {|FunctionDeclaration|; |GeneratorDeclaration|; |AsyncFunctionDeclaration|; |AsyncGeneratorDeclaration|} {
        let funcObj = sdo InstantiateFunctionDeclaration(lexicalDecl; envRecord, privateEnv)
        perform ! envRecord.InitializeBinding(name, funcObj)
      }
    }
  }
  remove moduleContext kind 1
  return ~unused~
}

def @sec-source-text-module-record-execute-module "ExecuteModule" (kind concrete_method recv module : #"Source Text Module Record" params [capability : #"PromiseCapability Record" opt] -> completion<val(~unused~)> | #"throw completion") vars [module, capability, moduleContext, env, result, asyncBody] {
  assert module[[Status]] is val {~linked~; ~evaluating~; ~evaluating-async~; ~evaluated~} and module[[Environment]] is not val {~empty~}
  let moduleContext = module[[Context]]
  if module[[HasTLA]] is val {false} {
    assert capability fails $Present()
    let env = module[[Environment]]
    suspend $Running() kind 0
    push moduleContext kind 0
    let result = @sec-completion-ao(sdo Evaluation(module[[ECMAScriptCode]]))
    set var result = @sec-completion-ao(@sec-disposeresources(env[[DisposableResourceStack]], result))
    suspend moduleContext kind 1
    resume_top
    if result is ty {#"abrupt completion"} {
      return ? result
    }
  }
  else {
    assert capability is ty {#"PromiseCapability Record"}
    let env = module[[Environment]]
    let asyncBody = closure 0
    perform @sec-asyncblockstart(capability, asyncBody, moduleContext)
  }
  return ~unused~
  closure abstract params none captures [module, env] {
    let result = @sec-completion-ao(sdo Evaluation(module[[ECMAScriptCode]]))
    set var result = @sec-completion-ao(@sec-disposeresources(env[[DisposableResourceStack]], result))
    return @sec-completion-ao(result)
  }
}

def @sec-create-default-export-synthetic-module "CreateDefaultExportSyntheticModule" (kind ao params [defaultExport : #"ECMAScript language value"] -> #"Synthetic Module Record") vars [defaultExport, #"realm", setDefaultExport, module] {
  let #"realm" = $CurrentRealm()
  let setDefaultExport = closure 0
  return record #"Synthetic Module Record" { [[Realm]]: #"realm", [[Environment]]: ~empty~, [[Namespace]]: ~empty~, [[DeferredNamespace]]: ~empty~, [[HostDefined]]: undefined, [[ExportNames]]: ["default"], [[EvaluationSteps]]: setDefaultExport }
  closure abstract params [module] captures [defaultExport] {
    perform @sec-setsyntheticmoduleexport(module, "default", defaultExport)
    return @sec-normalcompletion(~unused~)
  }
}

def @sec-parse-json-module "ParseJSONModule" (kind ao params [source : String] -> completion<#"Synthetic Module Record"> | #"throw completion") vars [source, parseResult] {
  let parseResult = ? @sec-ParseJSON(source)
  return @sec-create-default-export-synthetic-module(parseResult[[Value]])
}

def @sec-setsyntheticmoduleexport "SetSyntheticModuleExport" (kind ao params [module : #"Synthetic Module Record", exportName : String, exportValue : #"ECMAScript language value"] -> val(~unused~)) vars [module, exportName, exportValue, envRecord] {
  assert module[[ExportNames]] sat $Contains(?exportName)
  let envRecord = module[[Environment]]
  assert envRecord is not val {~empty~}
  perform ! envRecord.SetMutableBinding(exportName, exportValue, true)
  return ~unused~
}

def @sec-smr-LoadRequestedModules "LoadRequestedModules" (kind concrete_method recv module : #"Synthetic Module Record" params [hostDefined : pred(sat @ph-type-anything()) opt] -> Promise) vars [module, hostDefined] {
  note "This implementation of LoadRequestedModules does not use _hostDefined_."
  return ! @sec-promise-resolve(intrinsic [[Promise]], undefined)
}

def @sec-smr-getexportednames "GetExportedNames" (kind concrete_method recv module : #"Synthetic Module Record" params [exportStarSet : list<#"Source Text Module Record"> opt] -> list<String>) vars [module, exportStarSet] {
  note "This implementation of GetExportedNames does not use _exportStarSet_."
  return module[[ExportNames]]
}

def @sec-smr-resolveexport "ResolveExport" (kind concrete_method recv module : #"Synthetic Module Record" params [exportName : String, resolveSet : list<record { [[Module]]: #"Module Record", [[ExportName]]: String }> opt] -> #"ResolvedBinding Record" | val(null) | val(~ambiguous~)) vars [module, exportName, resolveSet] {
  note "This implementation of ResolveExport does not use _resolveSet_."
  if module[[ExportNames]] fails $Contains(?exportName) -> return null
  return record #"ResolvedBinding Record" { [[Module]]: module, [[BindingName]]: exportName }
}

def @sec-smr-Link "Link" (kind concrete_method recv module : #"Synthetic Module Record" params [] -> completion<val(~unused~)>) vars [module, #"realm", envRecord, exportName] {
  let #"realm" = module[[Realm]]
  let envRecord = @sec-newmoduleenvironment(#"realm"[[GlobalEnv]])
  set field module[[Environment]] = envRecord
  for_each exportName : String in module[[ExportNames]] {
    perform ! envRecord.CreateMutableBinding(exportName, false)
    perform ! envRecord.InitializeBinding(exportName, undefined)
  }
  return @sec-normalcompletion(~unused~)
}

def @sec-smr-Evaluate "Evaluate" (kind concrete_method recv module : #"Synthetic Module Record" params [] -> Promise) vars [module, moduleContext, #"steps", result, promiseCapability] {
  let moduleContext = $NewRecord(data sort #"ECMAScript code execution context")
  set expr component [[Function]] of moduleContext = null
  set expr component [[Realm]] of moduleContext = module[[Realm]]
  set expr component [[ScriptOrModule]] of moduleContext = module
  set expr component [[VariableEnvironment]] of moduleContext = module[[Environment]]
  set expr component [[LexicalEnvironment]] of moduleContext = module[[Environment]]
  suspend $Running() kind 0
  push moduleContext kind 0
  let #"steps" = module[[EvaluationSteps]]
  let result = @sec-completion-ao(#"steps"(module))
  suspend moduleContext kind 1
  resume_top
  let promiseCapability = ! @sec-newpromisecapability(intrinsic [[Promise]])
  block {
    assert result is ty {#"Completion Record"}
    if result is ty {#"abrupt completion"} {
      perform ? @sec-call(promiseCapability[[Reject]], undefined, [result[[Value]]])
      return promiseCapability[[Promise]]
    }
    set var result = ! result
  }
  perform ! @sec-call(promiseCapability[[Resolve]], undefined, [undefined])
  return promiseCapability[[Promise]]
}

def @sec-GetImportedModule "GetImportedModule" (kind ao params [referrer : #"Cyclic Module Record", request : #"ModuleRequest Record"] -> #"Module Record") vars [referrer, request, records, r, #"record"] {
  let records = $ListNew()
  for_each r : #"LoadedModuleRequest Record" in referrer[[LoadedModules]] {
    if @sec-ModuleRequestsKeyEqual(r, request) is val {true} -> perform $Append(?r, ?records)
  }
  assert $ListLen(?records) is val {1}
  let #"record" = $ListElem(data choice 0, ?records)
  return #"record"[[Module]]
}

def @sec-FinishLoadingImportedModule "FinishLoadingImportedModule" (kind ao params [referrer : #"Script Record" | #"Cyclic Module Record" | #"Realm Record", moduleRequest : #"ModuleRequest Record", payload : #"GraphLoadingState Record" | #"PromiseCapability Record", result : completion<#"Module Record"> | #"throw completion"] -> val(~unused~)) vars [referrer, moduleRequest, payload, result, #"record", values] {
  if result is ty {#"normal completion"} {
    let values = @ph-contains-such-binds(data choice 0, data sort #"LoadedModuleRequest Record", ?#"record", closure 0, referrer[[LoadedModules]])
    if $ListLen(values) == 1 or $ListLen(values) != 0 and expr $""() {
      let #"record" = values[0]
      assert expr @ph-same-tn(#"record"[[Module]], result[[Value]], data sort #"Module Record")
    }
    else {
      perform $Append(record #"LoadedModuleRequest Record" { [[Specifier]]: moduleRequest[[Specifier]], [[Attributes]]: moduleRequest[[Attributes]], [[Module]]: result[[Value]] }, referrer[[LoadedModules]])
    }
  }
  if payload is ty {#"GraphLoadingState Record"} {
    perform @sec-ContinueModuleLoading(payload, result, @sec-AllImportedNames(moduleRequest[[ImportedNames]]))
  }
  else {
    perform @sec-ContinueDynamicImport(payload, result, moduleRequest[[Phase]], @sec-AllImportedNames(moduleRequest[[ImportedNames]]))
  }
  return ~unused~
  closure abstract params [#"record"] captures [moduleRequest] {
    return bool(@sec-ModuleRequestsKeyEqual(#"record", moduleRequest) is val {true})
  }
}

def @sec-AllImportAttributesSupported "AllImportAttributesSupported" (kind ao params [attrs : list<#"ImportAttribute Record">] -> Boolean) vars [attrs, supported, attr] {
  let supported = @sec-hostgetsupportedimportattributes()
  for_each attr : #"ImportAttribute Record" in attrs {
    if supported fails $Contains(attr[[Key]]) -> return false
  }
  return true
}

def @sec-getmodulenamespace "GetModuleNamespace" (kind ao params [module : doc "an instance of a concrete subclass of Module Record", phase : val(~defer~) | val(~evaluation~), importedNames : val(~all~) | list<String>] -> doc "a Module Namespace Object") vars [module, phase, importedNames, namespace, exportedNames, unambiguousNames, name, resolution] {
  assert_if module is ty {#"Cyclic Module Record"} then module[[Status]] is not val {~new~}
  note "A filtered namespace object can be requested during linking, by ResolveExport or by InitializeEnvironment, for a module that has not been linked yet. A module's exported names and their resolutions are fully determined once loading has completed, so they do not depend on linking having run."
  let namespace = ~empty~
  if importedNames is val {~all~} {
    if_else phase is val {~defer~} { set var namespace = module[[DeferredNamespace]] } else { set var namespace = module[[Namespace]] }
  }
  if namespace is val {~empty~} {
    let exportedNames = module.GetExportedNames()
    let unambiguousNames = $ListNew()
    for_each name in exportedNames {
      if importedNames is val {~all~} or importedNames sat $Contains(?name) {
        if phase is not val {~defer~} or name is not val {"then"} {
          let resolution = module.ResolveExport(name)
          if resolution is ty {#"ResolvedBinding Record"} -> perform $Append(?name, ?unambiguousNames)
        }
      }
    }
    set var namespace = @sec-modulenamespacecreate(module, unambiguousNames, phase)
    if importedNames is val {~all~} {
      if phase is val {~defer~} -> set field module[[DeferredNamespace]] = namespace
      else -> set field module[[Namespace]] = namespace
    }
  }
  return namespace
}

def @sec-AllImportedNames "AllImportedNames" (kind ao params [importedNames : #"ImportedNames Record"] -> val(~all~) | list<String>) vars [importedNames] {
  return @sec-MergeImportedNames(importedNames[[Direct]], importedNames[[Namespace]])
}

def @sec-MergeImportedNames "MergeImportedNames" (kind ao params [a : val(~all~) | list<String>, b : val(~all~) | list<String>] -> val(~all~) | list<String>) vars [a, b, merged, name] {
  if a is val {~all~} or b is val {~all~} -> return ~all~
  assert a is ty {list<String>} and b is ty {list<String>}
  let merged = $Copy(@ph-the-list(?a))
  for_each name : String in b {
    if merged fails $Contains(?name) {
      perform $Append(?name, ?merged)
    }
  }
  return merged
}

def @sec-ExcludeImportedNames "ExcludeImportedNames" (kind ao params [a : val(~all~) | list<String>, b : val(~all~) | list<String>] -> val(~all~) | list<String>) vars [a, b, result, e] {
  if b is val {~all~} -> return $ListNew()
  if a is val {~all~} -> return ~all~
  assert a is ty {list<String>} and b is ty {list<String>}
  let result = $ListNew()
  for_each e : String in a {
    if b fails $Contains(?e) -> perform $Append(?e, ?result)
  }
  return result
}

def @sec-ListAppendUnique "ListAppendUnique" (kind ao params [list1 : list<Record>, list2 : list<Record>] -> val(~unused~)) vars [list1, list2, r] {
  for_each r : Record in list2 {
    if list1 fails $Contains(?r) -> perform $Append(?r, ?list1)
  }
  return ~unused~
}

def @sec-ExportFromDeclarationModuleRequest "ExportFromDeclarationModuleRequest" (kind ao params [exportFromClause : |ExportFromClause| | |ExplicitExportFromClause|, fromClause : |FromClause|, phase : val(~defer~) | val(~evaluation~), withClause : |WithClause| opt] -> #"ModuleRequest Record") vars [exportFromClause, fromClause, phase, withClause, directImportedNames, filteredNamespaceImportedNames, specifier, attrs] {
  let directImportedNames = sdo DirectImportedNames(exportFromClause)
  let filteredNamespaceImportedNames = sdo FilteredNamespaceImportedNames(exportFromClause)
  let specifier = sdo SV(fromClause)
  if withClause sat $Present() -> let attrs = sdo WithClauseToAttributes(withClause)
  else -> let attrs = $ListNew()
  return record #"ModuleRequest Record" { [[Specifier]]: specifier, [[Attributes]]: attrs, [[Phase]]: phase, [[ImportedNames]]: @ph-new-record(record #"ImportedNames Record" { [[Direct]]: directImportedNames, [[Namespace]]: filteredNamespaceImportedNames }) }
}

def @sec-IsModuleSCCEvaluated "IsModuleSCCEvaluated" (kind ao params [module : #"Cyclic Module Record"] -> Boolean) vars [module] {
  if module[[CycleRoot]] is not val {~empty~} {
    if module[[CycleRoot]][[Status]] is val {~evaluated~} -> return true
    return false
  }
  if module[[Status]] is val {~evaluated~} -> return true
  return false
}

def @sec-ReadyForSyncExecution "ReadyForSyncExecution" (kind ao params [module : #"Module Record", importedNames : val(~all~) | list<String>, onDeferredNamespace : val(~ignore-deferred-namespace~) | val(~gather-async-deps~), seen : list<#"ModuleImportedNames Record"> opt] -> Boolean) vars [module, importedNames, onDeferredNamespace, seen, r, seenForAsyncDeps, request, requiredModule] {
  if module is not ty {#"Cyclic Module Record"} -> return true
  if seen fails $Present() -> set var seen = $ListNew()
  if seen sat @ph-not-contains-such(data choice 0, data sort #"ModuleImportedNames Record", ?r, closure 0) {
    perform $Append(@ph-new-record(record #"ModuleImportedNames Record" { [[Module]]: module, [[ImportedNames]]: @ph-new-record(record #"ImportedNames Record" { [[Direct]]: [], [[Namespace]]: [] }) }), ?seen)
    if @sec-IsModuleSCCEvaluated(module) is val {false} {
      if module[[Status]] is val {~evaluating~; ~evaluating-async~} -> return false
      assert module[[Status]] is val {~linked~; ~evaluated~}
      if module[[HasTLA]] is val {true} -> return false
      if_else onDeferredNamespace is val {~gather-async-deps~} { let seenForAsyncDeps = seen } else { let seenForAsyncDeps = $ListNew() }
      for_each request : #"ModuleRequest Record" in module[[RequestedModules]] {
        let requiredModule = @sec-GetImportedModule(module, request)
        if @sec-ReadyForSyncExecution(requiredModule, @sec-AllImportedNames(request[[ImportedNames]]), ~gather-async-deps~, seenForAsyncDeps) is val {false} {
          return false
        }
      }
    }
  }
  for_each request : #"ModuleRequest Record" in @sec-GetNewOptionalIndirectExportsModuleRequests(module, @ph-new-record(record #"ImportedNames Record" { [[Direct]]: importedNames, [[Namespace]]: [] }), seen) {
    if request[[Phase]] is val {~evaluation~} {
      let requiredModule = @sec-GetImportedModule(module, request)
      if @sec-ReadyForSyncExecution(requiredModule, @sec-AllImportedNames(request[[ImportedNames]]), onDeferredNamespace, seen) is val {false} -> return false
    }
    else {
      assert request[[Phase]] is val {~defer~}
      if onDeferredNamespace is val {~gather-async-deps~} {
        if @sec-GatherAsynchronousTransitiveDependenciesForRequests(module, [request], [], @sec-CopyPreviouslyImportedNames(seen)) fails $IsEmpty() -> return false
      }
      else {
        if @sec-GatherAsynchronousTransitiveDependencies(@sec-GetImportedModule(module, request)) fails $IsEmpty() -> return false
      }
    }
  }
  return true
  closure abstract params [r] captures [module] {
    return bool(r[[Module]] is val {module})
  }
}

def @sec-BuildLinkingList "BuildLinkingList" (kind ao params [linkingList : list<#"Module Record">, referrer : #"Cyclic Module Record", moduleRequests : list<#"ModuleRequest Record">, previouslyImportedNames : list<#"ModuleImportedNames Record">] -> val(~unused~)) vars [linkingList, referrer, moduleRequests, previouslyImportedNames, request, requiredModule, r, optionalIndirectRequests] {
  for_each request : #"ModuleRequest Record" in moduleRequests {
    let requiredModule = @sec-GetImportedModule(referrer, request)
    if linkingList fails $Contains(?requiredModule) {
      perform $Append(?requiredModule, ?linkingList)
      if requiredModule is ty {#"Cyclic Module Record"} {
        assert previouslyImportedNames sat @ph-not-contains-such(data choice 0, data sort #"ModuleImportedNames Record", ?r, closure 0)
        perform $Append(@ph-new-record(record #"ModuleImportedNames Record" { [[Module]]: requiredModule, [[ImportedNames]]: @ph-new-record(record #"ImportedNames Record" { [[Direct]]: [], [[Namespace]]: [] }) }), ?previouslyImportedNames)
      }
    }
    if requiredModule is ty {#"Cyclic Module Record"} {
      let optionalIndirectRequests = @sec-GetNewOptionalIndirectExportsModuleRequests(requiredModule, request[[ImportedNames]], previouslyImportedNames)
      perform @sec-BuildLinkingList(linkingList, requiredModule, optionalIndirectRequests, previouslyImportedNames)
    }
  }
  return ~unused~
  closure abstract params [r] captures [requiredModule] {
    return bool(r[[Module]] is val {requiredModule})
  }
}

def @sec-ValidateAllRequestedOptionalNamespaceExports "ValidateAllRequestedOptionalNamespaceExports" (kind ao params [previouslyImportedNames : list<#"ModuleImportedNames Record">] -> completion<val(~unused~)> | #"throw completion") vars [previouslyImportedNames, r, names] {
  for_each r : #"ModuleImportedNames Record" in previouslyImportedNames {
    let names = r[[ImportedNames]]
    if names[[Namespace]] is val {~all~} -> perform ? @sec-ValidateOwnNamespaceExports(r[[Module]], ~all~)
    perform ? @sec-ValidateRequestedOptionalIndirectExports(r[[Module]], @sec-AllImportedNames(names))
  }
  return ~unused~
}

def @sec-ValidateOwnNamespaceExports "ValidateOwnNamespaceExports" (kind ao params [module : #"Module Record", names : val(~all~) | list<String>] -> completion<val(~unused~)> | #"throw completion") vars [module, names, name] {
  if names is val {~all~} {
    if module is not ty {#"Cyclic Module Record"} -> return ~unused~
    note "Only Cyclic Module Records can have invalid optional indirect exports."
    for_each name : String in module.GetExportedNames() {
      perform ? @sec-ensureresolvablebinding(module, name, ~allow-ambiguous~)
    }
  }
  else {
    for_each name : String in names {
      perform ? @sec-ensureresolvablebinding(module, name, ~disallow-ambiguous~)
    }
  }
  return ~unused~
}

def @sec-ensureresolvablebinding "EnsureResolvableBinding" (kind ao params [module : #"Module Record", name : String, onAmbiguous : val(~allow-ambiguous~) | val(~disallow-ambiguous~)] -> completion<val(~unused~)> | #"throw completion") vars [module, name, onAmbiguous, resolution] {
  let resolution = module.ResolveExport(name)
  if resolution is val {null} -> throw @ph-new-error([[SyntaxError]])
  if onAmbiguous is val {~disallow-ambiguous~} {
    if resolution is val {~ambiguous~} -> throw @ph-new-error([[SyntaxError]])
    assert resolution is ty {#"ResolvedBinding Record"}
  }
  return ~unused~
}

def @sec-ValidateRequestedOptionalIndirectExports "ValidateRequestedOptionalIndirectExports" (kind ao params [module : #"Cyclic Module Record", importedNames : val(~all~) | list<String>] -> completion<val(~unused~)> | #"throw completion") vars [module, importedNames, name, request] {
  if importedNames is val {~all~} -> set var importedNames = module.GetExportedNames()
  for_each name : String in importedNames {
    for_each request : #"OptionalModuleRequest Record" in module.GetOptionalIndirectExportsModuleRequests([name]) {
      if request[[IsStarExport]] is val {false} {
        perform ? @sec-ensureresolvablebinding(module, name, ~disallow-ambiguous~)
        if request[[ImportedNames]][[Namespace]] is ty {List} {
          perform ? @sec-ValidateOwnNamespaceExports(@sec-GetImportedModule(module, request), request[[ImportedNames]][[Namespace]])
        }
      }
    }
  }
  return ~unused~
}

def @sec-BuildEvaluationList "BuildEvaluationList" (kind ao params [evaluationList : list<#"Module Record">, referrer : #"Cyclic Module Record", moduleRequests : list<#"ModuleRequest Record">, previouslyImportedNames : list<#"ModuleImportedNames Record">, onDeferredNamespace : val(~ignore-deferred-namespace~) | val(~gather-async-deps~)] -> val(~unused~)) vars [evaluationList, referrer, moduleRequests, previouslyImportedNames, onDeferredNamespace, request, requiredModule, r, namespaceOptionalIndirectRequests, seen, previouslyImportedNamesCopy, optionalIndirectRequests] {
  for_each request : #"ModuleRequest Record" in moduleRequests {
    if request[[Phase]] is val {~evaluation~} or onDeferredNamespace is val {~gather-async-deps~} {
      let requiredModule = @sec-GetImportedModule(referrer, request)
      if request[[Phase]] is val {~defer~} {
        note "The names requested while gathering the asynchronous dependencies of a deferred module are recorded in a copy of _previouslyImportedNames_, because the modules re-exporting them are not being scheduled for evaluation: a later request with the ~evaluation~ phase for the same names must still add them to _evaluationList_."
        perform @sec-ListAppendUnique(evaluationList, @sec-GatherAsynchronousTransitiveDependencies(requiredModule, [], @sec-CopyPreviouslyImportedNames(previouslyImportedNames)))
      }
      else_if evaluationList fails $Contains(?requiredModule) {
        perform $Append(?requiredModule, ?evaluationList)
      }
      if requiredModule is ty {#"Cyclic Module Record"} {
        if previouslyImportedNames sat @ph-not-contains-such(data choice 0, data sort #"ModuleImportedNames Record", ?r, closure 0) {
          perform $Append(@ph-new-record(record #"ModuleImportedNames Record" { [[Module]]: requiredModule, [[ImportedNames]]: @ph-new-record(record #"ImportedNames Record" { [[Direct]]: [], [[Namespace]]: [] }) }), ?previouslyImportedNames)
        }
        if onDeferredNamespace is val {~gather-async-deps~} and (request[[ImportedNames]][[Namespace]] is val {~all~} or request[[ImportedNames]][[Namespace]] fails $IsEmpty()) {
          let namespaceOptionalIndirectRequests = @sec-GetNewOptionalIndirectExportsModuleRequests(requiredModule, @ph-new-record(record #"ImportedNames Record" { [[Direct]]: [], [[Namespace]]: request[[ImportedNames]][[Namespace]] }), previouslyImportedNames)
          let seen = $ListNew()
          let previouslyImportedNamesCopy = @sec-CopyPreviouslyImportedNames(previouslyImportedNames)
          perform @sec-ListAppendUnique(evaluationList, @sec-GatherAsynchronousTransitiveDependenciesForRequests(requiredModule, namespaceOptionalIndirectRequests, seen, previouslyImportedNamesCopy))
        }
        let optionalIndirectRequests = @sec-GetNewOptionalIndirectExportsModuleRequests(requiredModule, @ph-new-record(record #"ImportedNames Record" { [[Direct]]: request[[ImportedNames]][[Direct]], [[Namespace]]: [] }), previouslyImportedNames)
        perform @sec-BuildEvaluationList(evaluationList, requiredModule, optionalIndirectRequests, previouslyImportedNames, onDeferredNamespace)
      }
    }
  }
  return ~unused~
  closure abstract params [r] captures [requiredModule] {
    return bool(r[[Module]] is val {requiredModule})
  }
}

def @sec-GatherAsynchronousTransitiveDependencies "GatherAsynchronousTransitiveDependencies" (kind ao params [module : #"Module Record", seen : list<#"Module Record"> opt, previouslyImportedNames : list<#"ModuleImportedNames Record"> opt] -> list<#"Module Record">) vars [module, seen, previouslyImportedNames] {
  if seen fails $Present() -> set var seen = $ListNew()
  if previouslyImportedNames fails $Present() -> set var previouslyImportedNames = $ListNew()
  if seen sat $Contains(?module) -> return $ListNew()
  perform $Append(?module, ?seen)
  if module is not ty {#"Cyclic Module Record"} -> return $ListNew()
  if module[[Status]] is val {~evaluating~} or @sec-IsModuleSCCEvaluated(module) is val {true} -> return $ListNew()
  if module[[HasTLA]] is val {true} {
    return [module]
  }
  return @sec-GatherAsynchronousTransitiveDependenciesForRequests(module, module[[RequestedModules]], seen, previouslyImportedNames)
}

def @sec-GatherAsynchronousTransitiveDependenciesForRequests "GatherAsynchronousTransitiveDependenciesForRequests" (kind ao params [referrer : #"Cyclic Module Record", moduleRequests : list<#"ModuleRequest Record">, seen : list<#"Module Record">, previouslyImportedNames : list<#"ModuleImportedNames Record">] -> list<#"Module Record">) vars [referrer, moduleRequests, seen, previouslyImportedNames, result, request, requiredModule, r, optionalIndirectRequests] {
  let result = $ListNew()
  for_each request : #"ModuleRequest Record" in moduleRequests {
    let requiredModule = @sec-GetImportedModule(referrer, request)
    perform @sec-ListAppendUnique(result, @sec-GatherAsynchronousTransitiveDependencies(requiredModule, seen, previouslyImportedNames))
    if requiredModule is ty {#"Cyclic Module Record"} {
      if previouslyImportedNames sat @ph-not-contains-such(data choice 0, data sort #"ModuleImportedNames Record", ?r, closure 0) {
        perform $Append(@ph-new-record(record #"ModuleImportedNames Record" { [[Module]]: requiredModule, [[ImportedNames]]: @ph-new-record(record #"ImportedNames Record" { [[Direct]]: [], [[Namespace]]: [] }) }), ?previouslyImportedNames)
      }
      let optionalIndirectRequests = @sec-GetNewOptionalIndirectExportsModuleRequests(requiredModule, request[[ImportedNames]], previouslyImportedNames)
      perform @sec-ListAppendUnique(result, @sec-GatherAsynchronousTransitiveDependenciesForRequests(requiredModule, optionalIndirectRequests, seen, previouslyImportedNames))
    }
  }
  return result
  closure abstract params [r] captures [requiredModule] {
    return bool(r[[Module]] is val {requiredModule})
  }
}

def @sec-GetNewOptionalIndirectExportsModuleRequests "GetNewOptionalIndirectExportsModuleRequests" (kind ao params [module : #"Cyclic Module Record", importedNames : #"ImportedNames Record", previouslyImportedNames : list<#"ModuleImportedNames Record">] -> list<#"OptionalModuleRequest Record">) vars [module, importedNames, previouslyImportedNames, r, previous, previousNames, newDirectImportedNames, newNamespaceImportedNames] {
  assert previouslyImportedNames sat @ph-contains-such(data choice 0, data sort #"ModuleImportedNames Record", ?r, closure 0)
  let previous = @ph-elem-whose-tn(data sort #"ModuleImportedNames Record", ?previouslyImportedNames, [[Module]], data choice 0, ?module)
  let previousNames = previous[[ImportedNames]]
  let newDirectImportedNames = @sec-ExcludeImportedNames(importedNames[[Direct]], previousNames[[Direct]])
  let newNamespaceImportedNames = @sec-ExcludeImportedNames(importedNames[[Namespace]], previousNames[[Namespace]])
  set field previousNames[[Direct]] = @sec-MergeImportedNames(previousNames[[Direct]], newDirectImportedNames)
  set field previousNames[[Namespace]] = @sec-MergeImportedNames(previousNames[[Namespace]], newNamespaceImportedNames)
  return module.GetOptionalIndirectExportsModuleRequests(@sec-MergeImportedNames(newDirectImportedNames, newNamespaceImportedNames))
  closure abstract params [r] captures [module] {
    return bool(r[[Module]] is val {module})
  }
}

def @sec-CopyPreviouslyImportedNames "CopyPreviouslyImportedNames" (kind ao params [previouslyImportedNames : list<#"ModuleImportedNames Record">] -> list<#"ModuleImportedNames Record">) vars [previouslyImportedNames, copy, r, names, direct, namespace] {
  let copy = $ListNew()
  for_each r : #"ModuleImportedNames Record" in previouslyImportedNames {
    let names = r[[ImportedNames]]
    if_else names[[Direct]] is val {~all~} { let direct = ~all~ } else { let direct = $Copy(@ph-the-list(names[[Direct]])) }
    if_else names[[Namespace]] is val {~all~} { let namespace = ~all~ } else { let namespace = $Copy(@ph-the-list(names[[Namespace]])) }
    perform $Append(@ph-new-record(record #"ModuleImportedNames Record" { [[Module]]: r[[Module]], [[ImportedNames]]: @ph-new-record(record #"ImportedNames Record" { [[Direct]]: direct, [[Namespace]]: namespace }) }), ?copy)
  }
  return copy
}

def @sec-getownexportednames "GetOwnExportedNames" (kind ao params [module : #"Source Text Module Record"] -> list<String>) vars [module, exportedNames, exportEntry] {
  let exportedNames = $ListNew()
  for_each exportEntry : #"ExportEntry Record" in module[[LocalExportEntries]] {
    assert module[[LocalExportEntries]] sat $Contains(?exportEntry)
    assert exportEntry[[ExportName]] is not val {null}
    perform $Append(exportEntry[[ExportName]], ?exportedNames)
  }
  for_each exportEntry : #"ExportEntry Record" in module[[IndirectExportEntries]] {
    assert module[[IndirectExportEntries]] sat $Contains(?exportEntry)
    assert exportEntry[[ExportName]] is not val {null}
    perform $Append(exportEntry[[ExportName]], ?exportedNames)
  }
  for_each exportEntry : #"ExportEntry Record" in module[[OptionalIndirectExportEntries]] {
    if exportEntry[[ExportName]] is not val {null} {
      assert module[[OptionalIndirectExportEntries]] sat $Contains(?exportEntry)
      perform $Append(exportEntry[[ExportName]], ?exportedNames)
    }
  }
  return exportedNames
}

def @sec-GetOptionalIndirectExportsModuleRequests "GetOptionalIndirectExportsModuleRequests" (kind concrete_method recv module : #"Source Text Module Record" params [importedNames : val(~all~) | list<String>] -> list<#"OptionalModuleRequest Record">) vars [module, importedNames, requests, optionalEntry, processEntry, isStarExport, newNamespaceImportedNames, newDirectImportedNames, nextRequest, existingRequest, newRequest, values] {
  let requests = $ListNew()
  for_each optionalEntry : #"ExportEntry Record" in module[[OptionalIndirectExportEntries]] {
    let processEntry = true
    let isStarExport = false
    if optionalEntry[[ImportName]] is val {~all-but-default~} {
      let newNamespaceImportedNames = $ListNew()
      let newDirectImportedNames = @sec-ExcludeImportedNames(@sec-ExcludeImportedNames(importedNames, ["default"]), @sec-getownexportednames(module))
      if newDirectImportedNames sat $IsEmpty() -> set var processEntry = false
      set var isStarExport = true
      note "_optionalEntry_ is for an `export * from \"mod\"` declaration. While it is not by itself an optional indirect export, it is treated as one because it may re-export the optional indirect exports of `\"mod\"`. The resulting OptionalModuleRequest Record has [[IsStarExport]] set to *true* so that the evaluation logic can handle it appropriately."
    }
    else_if importedNames is val {~all~} or importedNames sat $Contains(optionalEntry[[ExportName]]) {
      let newDirectImportedNames = $ListNew()
      let newNamespaceImportedNames = ~all~
      assert optionalEntry[[ImportName]] is ty {String} or optionalEntry[[ImportName]] is val {~filtered-namespace~} or optionalEntry[[ImportName]] is val {~namespace~}
      if optionalEntry[[ImportName]] is ty {String} {
        set var newDirectImportedNames = [optionalEntry[[ImportName]]]
        set var newNamespaceImportedNames = $ListNew()
      }
      if optionalEntry[[ImportName]] is val {~filtered-namespace~} -> set var newNamespaceImportedNames = optionalEntry[[NamespaceNamesFilter]]
    }
    else {
      set var processEntry = false
    }
    if processEntry is val {true} {
      let nextRequest = optionalEntry[[ModuleRequest]]
      let values = @ph-contains-such-binds(data choice 1, data sort #"OptionalModuleRequest Record", ?existingRequest, closure 0, requests)
      if $ListLen(values) == 1 or $ListLen(values) != 0 and expr $""() {
        let existingRequest = values[0]
        set field existingRequest[[ImportedNames]][[Direct]] = @sec-MergeImportedNames(existingRequest[[ImportedNames]][[Direct]], newDirectImportedNames)
        set field existingRequest[[ImportedNames]][[Namespace]] = @sec-MergeImportedNames(existingRequest[[ImportedNames]][[Namespace]], newNamespaceImportedNames)
      }
      else {
        let newRequest = record #"OptionalModuleRequest Record" { [[Specifier]]: nextRequest[[Specifier]], [[Attributes]]: nextRequest[[Attributes]], [[Phase]]: nextRequest[[Phase]], [[ImportedNames]]: @ph-new-record(record #"ImportedNames Record" { [[Direct]]: newDirectImportedNames, [[Namespace]]: newNamespaceImportedNames }), [[IsStarExport]]: isStarExport }
        perform $Append(?newRequest, ?requests)
      }
    }
  }
  return requests
  closure abstract params [existingRequest] captures [nextRequest, isStarExport] {
    return bool(@sec-ModuleRequestsKeyEqual(existingRequest, nextRequest) is val {true} and existingRequest[[Phase]] is val {nextRequest[[Phase]]} and existingRequest[[IsStarExport]] is val {isStarExport})
  }
}

sdo_row @sec-scriptisstrict ScriptIsStrict form alg {
  prods [p"Syntactic 0 Script : ScriptBody?", p"Syntactic 1 Script : ScriptBody?"]
  keys ["Script : ScriptBody?"]
  vars []
  steps {
    if child 5 |ScriptBody| sat $Present() and expr @ph-use-strict(child 5 |ScriptBody|) -> return true
    return false
  }
}

sdo_row @sec-script-semantics-runtime-semantics-evaluation Evaluation form alg {
  prods [p"Syntactic 0 Script : ScriptBody?"]
  keys ["Script : [empty]"]
  vars []
  steps {
    return undefined
  }
}

sdo_row @sec-static-semantics-modulerequests ModuleRequests form alg {
  prods [p"Syntactic 0 Module : ModuleBody?"]
  keys ["Module : [empty]"]
  vars []
  steps {
    return $ListNew()
  }
}

sdo_row @sec-static-semantics-modulerequests#1 ModuleRequests form alg {
  prods [p"Syntactic - ModuleItemList : ModuleItem"]
  keys ["ModuleItemList : ModuleItem"]
  vars []
  steps {
    return sdo ModuleRequests(child 5 |ModuleItem|)
  }
}

sdo_row @sec-static-semantics-modulerequests#2 ModuleRequests form alg {
  prods [p"Syntactic - ModuleItemList : ModuleItemList ModuleItem"]
  keys ["ModuleItemList : ModuleItemList ModuleItem"]
  vars [requests, additionalRequests, moduleRequest, otherModuleRequest, values]
  steps {
    let requests = sdo ModuleRequests(child 5 |ModuleItemList|)
    let additionalRequests = sdo ModuleRequests(child 5 |ModuleItem|)
    for_each moduleRequest : #"ModuleRequest Record" in additionalRequests {
      let values = @ph-contains-such-binds(data choice 0, data sort #"ModuleRequest Record", ?otherModuleRequest, closure 0, requests)
      if $ListLen(values) == 1 or $ListLen(values) != 0 and expr $""() {
        let otherModuleRequest = values[0]
        set field otherModuleRequest[[ImportedNames]][[Direct]] = @sec-MergeImportedNames(otherModuleRequest[[ImportedNames]][[Direct]], moduleRequest[[ImportedNames]][[Direct]])
        set field otherModuleRequest[[ImportedNames]][[Namespace]] = @sec-MergeImportedNames(otherModuleRequest[[ImportedNames]][[Namespace]], moduleRequest[[ImportedNames]][[Namespace]])
      }
      else {
        perform $Append(?moduleRequest, ?requests)
      }
    }
    return requests
  }
  closure abstract params [otherModuleRequest] captures [moduleRequest] {
    return bool(@sec-ModuleRequestsKeyEqual(moduleRequest, otherModuleRequest) is val {true} and moduleRequest[[Phase]] is val {otherModuleRequest[[Phase]]})
  }
}

