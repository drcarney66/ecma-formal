}

def @sec-object-environment-records-hasbinding-n "HasBinding.2" (kind concrete_method recv envRecord : #"Object Environment Record" params [name : String] -> completion<Boolean> | #"throw completion") vars [envRecord, name, bindingObj, foundBinding, unscopables, blocked] {
  let bindingObj = envRecord[[BindingObject]]
  let foundBinding = ? @sec-hasproperty(bindingObj, name)
  if foundBinding is val {false} -> return false
  if envRecord[[IsWithEnvironment]] is val {false} -> return true
  let unscopables = ? @sec-get-o-p(bindingObj, $WellKnownSymbol("Symbol.unscopables"))
  if unscopables is ty {Object} {
    let blocked = @sec-toboolean(? @sec-get-o-p(unscopables, name))
    if blocked is val {true} -> return false
  }
  return true
}

def @sec-object-environment-records-createmutablebinding-n-d "CreateMutableBinding.2" (kind concrete_method recv envRecord : #"Object Environment Record" params [name : String, deletable : Boolean] -> completion<val(~unused~)> | #"throw completion") vars [envRecord, name, deletable, bindingObj] {
  let bindingObj = envRecord[[BindingObject]]
  perform ? @sec-definepropertyorthrow(bindingObj, name, record PropertyDescriptor { [[Value]]: undefined, [[Writable]]: true, [[Enumerable]]: true, [[Configurable]]: deletable })
  return ~unused~
}

def @sec-object-environment-records-initializebinding-n-v "InitializeBinding.2" (kind concrete_method recv envRecord : #"Object Environment Record" params [name : String, value : #"ECMAScript language value"] -> completion<val(~unused~)> | #"throw completion") vars [envRecord, name, value] {
  perform ? envRecord.SetMutableBinding(name, value, false)
  return ~unused~
}

def @sec-object-environment-records-setmutablebinding-n-v-s "SetMutableBinding.2" (kind concrete_method recv envRecord : #"Object Environment Record" params [name : String, value : #"ECMAScript language value", strict : Boolean] -> completion<val(~unused~)> | #"throw completion") vars [envRecord, name, value, strict, bindingObj, stillExists] {
  let bindingObj = envRecord[[BindingObject]]
  let stillExists = ? @sec-hasproperty(bindingObj, name)
  if stillExists is val {false} and strict is val {true} -> throw @ph-new-error([[ReferenceError]])
  perform ? @sec-set-o-p-v-throw(bindingObj, name, value, strict)
  return ~unused~
}

def @sec-object-environment-records-getbindingvalue-n-s "GetBindingValue.2" (kind concrete_method recv envRecord : #"Object Environment Record" params [name : String, strict : Boolean] -> completion<#"ECMAScript language value"> | #"throw completion") vars [envRecord, name, strict, bindingObj, value] {
  let bindingObj = envRecord[[BindingObject]]
  let value = ? @sec-hasproperty(bindingObj, name)
  if value is val {false} {
    if strict is val {false} -> return undefined
    throw @ph-new-error([[ReferenceError]])
  }
  return ? @sec-get-o-p(bindingObj, name)
}

def @sec-object-environment-records-deletebinding-n "DeleteBinding.2" (kind concrete_method recv envRecord : #"Object Environment Record" params [name : String] -> completion<Boolean> | #"throw completion") vars [envRecord, name, bindingObj] {
  let bindingObj = envRecord[[BindingObject]]
  return ? bindingObj[[Delete]](name)
}

