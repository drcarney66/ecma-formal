def @sec-object-environment-records-withbaseobject "WithBaseObject.2" (kind concrete_method recv envRecord : #"Object Environment Record" params [] -> Object | val(undefined)) vars [envRecord] {
  if envRecord[[IsWithEnvironment]] is val {true} -> return envRecord[[BindingObject]]
  return undefined
}

def @sec-bindthisvalue "BindThisValue" (kind ao params [envRecord : #"Function Environment Record", value : #"ECMAScript language value"] -> completion<val(~unused~)> | #"throw completion") vars [envRecord, value] {
  assert envRecord[[ThisBindingStatus]] is not val {~lexical~}
  if envRecord[[ThisBindingStatus]] is val {~initialized~} -> throw @ph-new-error([[ReferenceError]])
  set field envRecord[[ThisValue]] = value
  set field envRecord[[ThisBindingStatus]] = ~initialized~
  return ~unused~
}

def @sec-function-environment-records-hasthisbinding "HasThisBinding.3" (kind concrete_method recv envRecord : #"Function Environment Record" params [] -> Boolean) vars [envRecord] {
  if envRecord[[ThisBindingStatus]] is val {~lexical~} -> return false
  return true
}

def @sec-function-environment-records-getthisbinding "GetThisBinding" (kind concrete_method recv envRecord : #"Function Environment Record" params [] -> completion<#"ECMAScript language value"> | #"throw completion") vars [envRecord] {
  assert envRecord[[ThisBindingStatus]] is not val {~lexical~}
  if envRecord[[ThisBindingStatus]] is val {~uninitialized~} -> throw @ph-new-error([[ReferenceError]])
  return envRecord[[ThisValue]]
}

def @sec-function-environment-records-hassuperbinding "HasSuperBinding.3" (kind concrete_method recv envRecord : #"Function Environment Record" params [] -> Boolean) vars [envRecord] {
  if envRecord[[ThisBindingStatus]] is val {~lexical~} -> return false
  if envRecord[[FunctionObject]][[HomeObject]] is val {undefined} -> return false
  return true
}

def @sec-getsuperbase "GetSuperBase" (kind ao params [envRecord : #"Function Environment Record"] -> Object | val(null) | val(undefined)) vars [envRecord, home] {
  let home = envRecord[[FunctionObject]][[HomeObject]]
  if home is val {undefined} -> return undefined
  assert home is ty {sort [ordinary] object}
  return ! home[[GetPrototypeOf]]()
}

def @sec-global-environment-records-hasbinding-n "HasBinding.3" (kind concrete_method recv envRecord : #"Global Environment Record" params [name : String] -> completion<Boolean> | #"throw completion") vars [envRecord, name, declRecord, objRecord] {
  let declRecord = envRecord[[DeclarativeRecord]]
  if ! declRecord.HasBinding(name) is val {true} -> return true
  let objRecord = envRecord[[ObjectRecord]]
  return ? objRecord.HasBinding(name)
}

def @sec-global-environment-records-createmutablebinding-n-d "CreateMutableBinding.3" (kind concrete_method recv envRecord : #"Global Environment Record" params [name : String, deletable : Boolean] -> completion<val(~unused~)> | #"throw completion") vars [envRecord, name, deletable, declRecord] {
  let declRecord = envRecord[[DeclarativeRecord]]
  if ! declRecord.HasBinding(name) is val {true} -> throw @ph-new-error([[TypeError]])
  return ! declRecord.CreateMutableBinding(name, deletable)
}

def @sec-global-environment-records-createimmutablebinding-n-s "CreateImmutableBinding.2" (kind concrete_method recv envRecord : #"Global Environment Record" params [name : String, strict : Boolean] -> completion<val(~unused~)> | #"throw completion") vars [envRecord, name, strict, declRecord] {
  let declRecord = envRecord[[DeclarativeRecord]]
  if ! declRecord.HasBinding(name) is val {true} -> throw @ph-new-error([[TypeError]])
  return ! declRecord.CreateImmutableBinding(name, strict)
}

def @sec-global-environment-records-initializebinding-n-v "InitializeBinding.3" (kind concrete_method recv envRecord : #"Global Environment Record" params [name : String, value : #"ECMAScript language value"] -> completion<val(~unused~)> | #"throw completion") vars [envRecord, name, value, declRecord, objRecord] {
  let declRecord = envRecord[[DeclarativeRecord]]
  if ! declRecord.HasBinding(name) is val {true} {
    return ! declRecord.InitializeBinding(name, value)
  }
  assert declRecord sat @ph-not-has-binding(data choice 1, ?name)
  let objRecord = envRecord[[ObjectRecord]]
  return ? objRecord.InitializeBinding(name, value)
}

def @sec-global-environment-records-setmutablebinding-n-v-s "SetMutableBinding.3" (kind concrete_method recv envRecord : #"Global Environment Record" params [name : String, value : #"ECMAScript language value", strict : Boolean] -> completion<val(~unused~)> | #"throw completion") vars [envRecord, name, value, strict, declRecord, objRecord] {
  let declRecord = envRecord[[DeclarativeRecord]]
  if ! declRecord.HasBinding(name) is val {true} {
    return ? declRecord.SetMutableBinding(name, value, strict)
  }
  let objRecord = envRecord[[ObjectRecord]]
  return ? objRecord.SetMutableBinding(name, value, strict)
}

def @sec-global-environment-records-getbindingvalue-n-s "GetBindingValue.3" (kind concrete_method recv envRecord : #"Global Environment Record" params [name : String, strict : Boolean] -> completion<#"ECMAScript language value"> | #"throw completion") vars [envRecord, name, strict, declRecord, objRecord] {
  let declRecord = envRecord[[DeclarativeRecord]]
  if ! declRecord.HasBinding(name) is val {true} {
    return ? declRecord.GetBindingValue(name, strict)
  }
  let objRecord = envRecord[[ObjectRecord]]
  return ? objRecord.GetBindingValue(name, strict)
}

def @sec-global-environment-records-deletebinding-n "DeleteBinding.3" (kind concrete_method recv envRecord : #"Global Environment Record" params [name : String] -> completion<Boolean> | #"throw completion") vars [envRecord, name, declRecord, objRecord, globalObj, existingProperty] {
  let declRecord = envRecord[[DeclarativeRecord]]
  if ! declRecord.HasBinding(name) is val {true} {
    return ! declRecord.DeleteBinding(name)
  }
  let objRecord = envRecord[[ObjectRecord]]
  let globalObj = objRecord[[BindingObject]]
  let existingProperty = ? @sec-hasownproperty(globalObj, name)
  if existingProperty is val {true} {
    return ? objRecord.DeleteBinding(name)
  }
  return true
}

