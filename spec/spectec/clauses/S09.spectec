-- ECMA-262 SpecTec Clauses: S09

def @sec-declarative-environment-records-hasbinding-n "HasBinding" (kind concrete_method recv envRecord : #"Declarative Environment Record" params [name : String] -> completion<Boolean>) vars [envRecord, name] {
  if envRecord sat @ph-has-binding(?name) -> return true
  return false
}

def @sec-declarative-environment-records-createmutablebinding-n-d "CreateMutableBinding" (kind concrete_method recv envRecord : #"Declarative Environment Record" params [name : String, deletable : Boolean] -> completion<val(~unused~)>) vars [envRecord, name, deletable] {
  assert envRecord sat @ph-not-has-binding(data choice 0, ?name)
  perform $AddBinding(envRecord, name, record Record { [[Value]]: ~empty~, [[Mutable]]: true, [[Initialized]]: false, [[Strict]]: false, [[Deletable]]: deletable })
  return ~unused~
}

def @sec-declarative-environment-records-createimmutablebinding-n-s "CreateImmutableBinding" (kind concrete_method recv envRecord : #"Declarative Environment Record" params [name : String, strict : Boolean] -> completion<val(~unused~)>) vars [envRecord, name, strict] {
  assert envRecord sat @ph-not-has-binding(data choice 0, ?name)
  perform $AddBinding(envRecord, name, record Record { [[Value]]: ~empty~, [[Mutable]]: false, [[Initialized]]: false, [[Strict]]: strict, [[Deletable]]: false })
  return ~unused~
}

def @sec-declarative-environment-records-initializebinding-n-v "InitializeBinding" (kind concrete_method recv envRecord : #"Declarative Environment Record" params [name : String, value : #"ECMAScript language value"] -> completion<val(~unused~)>) vars [envRecord, name, value] {
  assert envRecord sat @ph-has-binding(?name)
  assert $BindingFor(envRecord, name) is ty {sort [uninitialized] binding}
  set field $BindingFor(envRecord, name)[[Value]] = value
  set field $BindingFor(envRecord, name)[[Initialized]] = true
  return ~unused~
}

def @sec-declarative-environment-records-setmutablebinding-n-v-s "SetMutableBinding" (kind concrete_method recv envRecord : #"Declarative Environment Record" params [name : String, value : #"ECMAScript language value", strict : Boolean] -> completion<val(~unused~)> | #"throw completion") vars [envRecord, name, value, strict] {
  if envRecord sat @ph-not-has-binding(data choice 1, ?name) {
    if strict is val {true} -> throw @ph-new-error([[ReferenceError]])
    perform ! envRecord.CreateMutableBinding(name, true)
    perform ! envRecord.InitializeBinding(name, value)
    return ~unused~
  }
  if @ph-binding-for(?name, ?envRecord) is ty {sort [strict] binding} -> set var strict = true
  if @ph-binding-for(?name, ?envRecord) sat @ph-not-yet-initialized() {
    throw @ph-new-error([[ReferenceError]])
  }
  else_if @ph-binding-for(?name, ?envRecord) is ty {sort [mutable] binding} {
    set field $BindingFor(envRecord, name)[[Value]] = value
  }
  else {
    assert $BindingFor(envRecord, name)[[Mutable]] is val {false}
    if strict is val {true} -> throw @ph-new-error([[TypeError]])
  }
  return ~unused~
}

def @sec-declarative-environment-records-getbindingvalue-n-s "GetBindingValue" (kind concrete_method recv envRecord : #"Declarative Environment Record" params [name : String, strict : Boolean] -> completion<#"ECMAScript language value"> | #"throw completion") vars [envRecord, name, strict] {
  assert envRecord sat @ph-has-binding(?name)
  if @ph-binding-for(?name, ?envRecord) is ty {sort [uninitialized] binding} -> throw @ph-new-error([[ReferenceError]])
  return @ph-bound-value(?name, ?envRecord)
}

def @sec-declarative-environment-records-deletebinding-n "DeleteBinding" (kind concrete_method recv envRecord : #"Declarative Environment Record" params [name : String] -> completion<Boolean>) vars [envRecord, name] {
  assert envRecord sat @ph-has-binding(?name)
  if $BindingFor(envRecord, name)[[Deletable]] is val {false} -> return false
  perform $RemoveBinding(envRecord, name)
  return true
}

