def @sec-weakset-iterable "WeakSet" (kind builtin params [iterable opt]) vars [#"this value", NewTarget, iterable, #"set", adder, iteratorRecord, next, status] {
  if new_target is val {undefined} -> throw @ph-new-error([[TypeError]])
