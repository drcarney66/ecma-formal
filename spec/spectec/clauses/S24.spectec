def @sec-set.prototype.symmetricdifference "Set.prototype.symmetricDifference" (kind builtin params [other]) vars [#"this value", NewTarget, other, #"set", otherRecord, keysIterator, resultSetData, next, resultIndex, alreadyInResult, result] {
