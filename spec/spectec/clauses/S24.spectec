def @sec-createmapiterator "CreateMapIterator" (kind ao params [map : #"ECMAScript language value", #"kind" : val(~key+value~) | val(~key~) | val(~value~)] -> completion<Generator> | #"throw completion") vars [map, #"kind", #"closure", entries, index, entriesCount, entry, result] {
