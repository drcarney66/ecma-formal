def @sec-createsetiterator "CreateSetIterator" (kind ao params [#"set" : #"ECMAScript language value", #"kind" : val(~key+value~) | val(~value~)] -> completion<Generator> | #"throw completion") vars [#"set", #"kind", #"closure", index, entries, entriesCount, entry, result] {
  perform ? @sec-requireinternalslot(#"set", [[SetData]])
