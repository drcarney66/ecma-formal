def @sec-map-iterable "Map" (kind builtin params [iterable opt]) vars [#"this value", NewTarget, iterable, map, adder] {
  if new_target is val {undefined} -> throw @ph-new-error([[TypeError]])
  let map = ? @sec-ordinarycreatefromconstructor(new_target, "%Map.prototype%", [[[MapData]]])
  set field map[[MapData]] = $ListNew()
  if iterable is val {undefined; null} -> return map
  let adder = ? @sec-get-o-p(map, "set")
  if @sec-iscallable(adder) is val {false} -> throw @ph-new-error([[TypeError]])
  return ? @sec-add-entries-from-iterable(map, iterable, adder)
}

def @sec-add-entries-from-iterable "AddEntriesFromIterable" (kind ao params [target : Object, iterable : butnot(#"ECMAScript language value", val(undefined) | val(null)), adder : #"function object"] -> completion<Object> | #"throw completion") vars [target, iterable, adder, iteratorRecord, next, error, key, value, status] {
  let iteratorRecord = ? @sec-getiterator(iterable, ~sync~)
  repeat {
    let next = ? @sec-iteratorstepvalue(iteratorRecord)
    if next is val {~done~} -> return target
    if next is not ty {Object} {
      let error = @sec-throwcompletion(@ph-new-error(err [[TypeError]]))
      return ? @sec-iteratorclose(iteratorRecord, error)
    }
    let key = @sec-completion-ao(@sec-get-o-p(next, "0"))
    block {
      assert key is ty {#"Completion Record"}
      if key is ty {#"abrupt completion"} -> return ? @sec-iteratorclose(iteratorRecord, key)
      set var key = ! key
    }
    let value = @sec-completion-ao(@sec-get-o-p(next, "1"))
    block {
      assert value is ty {#"Completion Record"}
      if value is ty {#"abrupt completion"} -> return ? @sec-iteratorclose(iteratorRecord, value)
      set var value = ! value
    }
    let status = @sec-completion-ao(@sec-call(adder, target, [key, value]))
    block {
      assert status is ty {#"Completion Record"}
      if status is ty {#"abrupt completion"} -> return ? @sec-iteratorclose(iteratorRecord, status)
      set var status = ! status
    }
  }
}

