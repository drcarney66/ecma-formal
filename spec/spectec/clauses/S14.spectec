sdo_row @sec-runtime-semantics-loopevaluation#3 LoopEvaluation form alg {
  prods [p"Syntactic - IterationStatement : ForInOfStatement[?Yield, ?Await, ?Return]"]
  keys ["IterationStatement : ForInOfStatement"]
  vars [labelSet]
