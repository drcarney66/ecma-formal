sdo_row @sec-runtime-semantics-fordeclarationbindinginitialization#1 ForDeclarationBindingInitialization form alg {
  prods [p"Syntactic - ForDeclaration : [+Using] `using` [no LineTerminator here] ForBinding[?Yield, ?Await, ~Pattern]", p"Syntactic - ForDeclaration : [+Using, +Await] `await` [no LineTerminator here] `using` [no LineTerminator here] ForBinding[?Yield, +Await, ~Pattern]"]
  keys ["\n          ForDeclaration :\n            `using` ForBinding\n            `await` `using` ForBinding\n        "]
  vars [value, envRecord]
  steps {
    throw @ph-new-error([[SyntaxError]])
  }
}

sdo_row @sec-runtime-semantics-fordeclarationbindinginstantiation ForDeclarationBindingInstantiation form alg {
  prods [p"Syntactic - ForDeclaration : LetOrConst ForBinding[?Yield, ?Await, +Pattern]"]
  keys ["ForDeclaration : LetOrConst ForBinding"]
  vars [envRecord, name]
  steps {
    for_each name in sdo BoundNames(child 5 |ForBinding|) {
      if sdo IsConstantDeclaration(child 5 |LetOrConst|) is val {true} {
        perform ! envRecord.CreateImmutableBinding(name, true)
      }
      else {
        perform ! envRecord.CreateMutableBinding(name, false)
      }
    }
    return ~unused~
  }
}

sdo_row @sec-runtime-semantics-fordeclarationbindinginstantiation#1 ForDeclarationBindingInstantiation form alg {
  prods [p"Syntactic - ForDeclaration : [+Using] `using` [no LineTerminator here] ForBinding[?Yield, ?Await, ~Pattern]", p"Syntactic - ForDeclaration : [+Using, +Await] `await` [no LineTerminator here] `using` [no LineTerminator here] ForBinding[?Yield, +Await, ~Pattern]"]
  keys ["\n          ForDeclaration :\n            `using` ForBinding\n            `await` `using` ForBinding\n        "]
  vars [envRecord, name]
  steps {
    for_each name in sdo BoundNames(child 5 |ForBinding|) {
      perform ! envRecord.CreateImmutableBinding(name, true)
    }
    return ~unused~
  }
}

