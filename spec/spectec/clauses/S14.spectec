}

sdo_row @sec-runtime-semantics-dowhileloopevaluation DoWhileLoopEvaluation form alg {
  prods [p"Syntactic - DoWhileStatement : `do` Statement[?Yield, ?Await, ?Return] `while` `(` Expression[+In, ?Yield, ?Await] `)` `;`"]
  keys ["DoWhileStatement : `do` Statement `while` `(` Expression `)` `;`"]
  vars [labelSet, iterationResult, stmtResult, exprRef, exprValue]
  steps {
    let iterationResult = undefined
    repeat {
      let stmtResult = @sec-completion-ao(sdo Evaluation(child 5 |Statement|))
      if @sec-loopcontinues(stmtResult, labelSet) is val {false} -> return ? @sec-updateempty(stmtResult, iterationResult)
      if stmtResult[[Value]] is not val {~empty~} -> set var iterationResult = stmtResult[[Value]]
      let exprRef = ? sdo Evaluation(child 5 |Expression|)
      let exprValue = ? @sec-getvalue(exprRef)
      if @sec-toboolean(exprValue) is val {false} -> return iterationResult
    }
  }
}

sdo_row @sec-runtime-semantics-whileloopevaluation WhileLoopEvaluation form alg {
  prods [p"Syntactic - WhileStatement : `while` `(` Expression[+In, ?Yield, ?Await] `)` Statement[?Yield, ?Await, ?Return]"]
  keys ["WhileStatement : `while` `(` Expression `)` Statement"]
  vars [labelSet, iterationResult, exprRef, exprValue, stmtResult]
  steps {
    let iterationResult = undefined
    repeat {
      let exprRef = ? sdo Evaluation(child 5 |Expression|)
      let exprValue = ? @sec-getvalue(exprRef)
      if @sec-toboolean(exprValue) is val {false} -> return iterationResult
      let stmtResult = @sec-completion-ao(sdo Evaluation(child 5 |Statement|))
      if @sec-loopcontinues(stmtResult, labelSet) is val {false} -> return ? @sec-updateempty(stmtResult, iterationResult)
      if stmtResult[[Value]] is not val {~empty~} -> set var iterationResult = stmtResult[[Value]]
    }
  }
}

sdo_row @sec-runtime-semantics-forloopevaluation ForLoopEvaluation form alg {
  prods [p"Syntactic 000 ForStatement : `for` `(` [lookahead != `let` `[`] Expression[~In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 001 ForStatement : `for` `(` [lookahead != `let` `[`] Expression[~In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 010 ForStatement : `for` `(` [lookahead != `let` `[`] Expression[~In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 011 ForStatement : `for` `(` [lookahead != `let` `[`] Expression[~In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 100 ForStatement : `for` `(` [lookahead != `let` `[`] Expression[~In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 101 ForStatement : `for` `(` [lookahead != `let` `[`] Expression[~In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 110 ForStatement : `for` `(` [lookahead != `let` `[`] Expression[~In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 111 ForStatement : `for` `(` [lookahead != `let` `[`] Expression[~In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]"]
  keys ["ForStatement : `for` `(` Expression? `;` Expression? `;` Expression? `)` Statement"]
  vars [labelSet, exprRef, #"test", increment]
  steps {
    if child 0 |Expression| sat $Present() {
      let exprRef = ? sdo Evaluation(child 0 |Expression|)
      perform ? @sec-getvalue(exprRef)
    }
    if_else child 1 |Expression| sat $Present() { let #"test" = child 1 |Expression| } else { let #"test" = ~empty~ }
    if_else child 2 |Expression| sat $Present() { let increment = child 2 |Expression| } else { let increment = ~empty~ }
    return ? @sec-forbodyevaluation(#"test", increment, child 5 |Statement|, [], labelSet)
  }
}

sdo_row @sec-runtime-semantics-forloopevaluation#1 ForLoopEvaluation form alg {
  prods [p"Syntactic 00 ForStatement : `for` `(` `var` VariableDeclarationList[~In, ?Yield, ?Await] `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 01 ForStatement : `for` `(` `var` VariableDeclarationList[~In, ?Yield, ?Await] `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 10 ForStatement : `for` `(` `var` VariableDeclarationList[~In, ?Yield, ?Await] `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 11 ForStatement : `for` `(` `var` VariableDeclarationList[~In, ?Yield, ?Await] `;` Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]"]
  keys ["ForStatement : `for` `(` `var` VariableDeclarationList `;` Expression? `;` Expression? `)` Statement"]
  vars [labelSet, #"test", increment]
  steps {
    perform ? sdo Evaluation(child 5 |VariableDeclarationList|)
    if_else child 0 |Expression| sat $Present() { let #"test" = child 0 |Expression| } else { let #"test" = ~empty~ }
    if_else child 1 |Expression| sat $Present() { let increment = child 1 |Expression| } else { let increment = ~empty~ }
    return ? @sec-forbodyevaluation(#"test", increment, child 5 |Statement|, [], labelSet)
  }
}

sdo_row @sec-runtime-semantics-forloopevaluation#2 ForLoopEvaluation form alg {
  prods [p"Syntactic 00 ForStatement : `for` `(` LexicalDeclaration[~In, ?Yield, ?Await] Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 01 ForStatement : `for` `(` LexicalDeclaration[~In, ?Yield, ?Await] Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 10 ForStatement : `for` `(` LexicalDeclaration[~In, ?Yield, ?Await] Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]", p"Syntactic 11 ForStatement : `for` `(` LexicalDeclaration[~In, ?Yield, ?Await] Expression[+In, ?Yield, ?Await]? `;` Expression[+In, ?Yield, ?Await]? `)` Statement[?Yield, ?Await, ?Return]"]
  keys ["ForStatement : `for` `(` LexicalDeclaration Expression? `;` Expression? `)` Statement"]
  vars [labelSet, oldEnv, loopEnv, isConst, boundNames, name, forDecl, perIterationLets, #"test", increment, bodyResult]
  steps {
    let oldEnv = $Component($Running(), [[LexicalEnvironment]])
    let loopEnv = @sec-newdeclarativeenvironment(oldEnv)
    let isConst = sdo IsConstantDeclaration(child 5 |LexicalDeclaration|)
    let boundNames = sdo BoundNames(child 5 |LexicalDeclaration|)
    for_each name in boundNames {
      if isConst is val {true} {
        perform ! loopEnv.CreateImmutableBinding(name, true)
      }
      else {
        perform ! loopEnv.CreateMutableBinding(name, false)
      }
    }
    set field $Running()[[LexicalEnvironment]] = loopEnv
    let forDecl = @sec-completion-ao(sdo Evaluation(child 5 |LexicalDeclaration|))
    if forDecl is ty {#"abrupt completion"} {
      set var forDecl = @sec-completion-ao(@sec-disposeresources(loopEnv[[DisposableResourceStack]], forDecl))
      assert forDecl is ty {#"abrupt completion"}
      set field $Running()[[LexicalEnvironment]] = oldEnv
      return ? forDecl
    }
    if_else isConst is val {false} { let perIterationLets = boundNames } else { let perIterationLets = $ListNew() }
    if_else child 0 |Expression| sat $Present() { let #"test" = child 0 |Expression| } else { let #"test" = ~empty~ }
    if_else child 1 |Expression| sat $Present() { let increment = child 1 |Expression| } else { let increment = ~empty~ }
    let bodyResult = @sec-completion-ao(@sec-forbodyevaluation(#"test", increment, child 5 |Statement|, perIterationLets, labelSet))
    set var bodyResult = @sec-completion-ao(@sec-disposeresources(loopEnv[[DisposableResourceStack]], bodyResult))
    assert_if bodyResult is ty {#"normal completion"} then bodyResult[[Value]] is not val {~empty~}
    set field $Running()[[LexicalEnvironment]] = oldEnv
    return ? bodyResult
  }
}

sdo_row @sec-static-semantics-isdestructuring IsDestructuring form alg {
  prods [p"Syntactic - MemberExpression : PrimaryExpression[?Yield, ?Await]"]
  keys ["MemberExpression : PrimaryExpression"]
  vars []
  steps {
    if child 5 |PrimaryExpression| is ty {|ObjectLiteral|; |ArrayLiteral|} -> return true
    return false
  }
}

sdo_row @sec-static-semantics-isdestructuring#1 IsDestructuring form alg {
  prods [p"Syntactic - MemberExpression : MemberExpression[?Yield, ?Await] `[` Expression[+In, ?Yield, ?Await] `]`", p"Syntactic - MemberExpression : MemberExpression[?Yield, ?Await] `.` IdentifierName", p"Syntactic - MemberExpression : MemberExpression[?Yield, ?Await] TemplateLiteral[?Yield, ?Await, +Tagged]", p"Syntactic - MemberExpression : SuperProperty[?Yield, ?Await]", p"Syntactic - MemberExpression : MetaProperty", p"Syntactic - MemberExpression : `new` MemberExpression[?Yield, ?Await] Arguments[?Yield, ?Await]", p"Syntactic - MemberExpression : MemberExpression[?Yield, ?Await] `.` PrivateIdentifier", p"Syntactic - NewExpression : `new` NewExpression[?Yield, ?Await]", p"Syntactic - LeftHandSideExpression : CallExpression[?Yield, ?Await]", p"Syntactic - LeftHandSideExpression : OptionalExpression[?Yield, ?Await]"]
  keys ["\n          MemberExpression :\n            MemberExpression `[` Expression `]`\n            MemberExpression `.` IdentifierName\n            MemberExpression TemplateLiteral\n            SuperProperty\n            MetaProperty\n            `new` MemberExpression Arguments\n            MemberExpression `.` PrivateIdentifier\n\n          NewExpression :\n            `new` NewExpression\n\n          LeftHandSideExpression :\n            CallExpression\n            OptionalExpression\n        "]
  vars []
  steps {
    return false
  }
}

