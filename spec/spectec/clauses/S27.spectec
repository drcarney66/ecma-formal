  let rejectSteps = closure 1
  let reject = @sec-createbuiltinfunction(rejectSteps, 1, "", [])
  return record Record { [[Resolve]]: resolve, [[Reject]]: reject }
  closure abstract params [resolution] captures [promiseOrEmpty] {
