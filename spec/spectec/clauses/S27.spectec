def @sec-promise.prototype.finally "Promise.prototype.finally" (kind builtin params [onFinally]) vars [#"this value", NewTarget, onFinally, promise, ctor, thenFinally, catchFinally, thenFinallyClosure, value, result, p, returnValue, valueThunk, catchFinallyClosure, reason, throwReason, thrower] {
