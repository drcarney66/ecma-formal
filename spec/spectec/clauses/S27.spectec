    if #"realm" sat $Present() {
      let oldRealm = $Component($Running(), [[Realm]])
      set field $Running()[[Realm]] = #"realm"
      let iteratorResult = @sec-createiterresultobject(value, done)
      set field $Running()[[Realm]] = oldRealm
    }
    else {
      let iteratorResult = @sec-createiterresultobject(value, done)
    }
    perform ! @sec-call(promiseCapability[[Resolve]], undefined, [iteratorResult])
  }
  return ~unused~
}

def @sec-asyncgeneratorresume "AsyncGeneratorResume" (kind ao params [gen : AsyncGenerator, #"completion" : #"Completion Record"] -> val(~unused~)) vars [gen, #"completion", genContext] {
  assert gen[[AsyncGeneratorState]] is val {~suspended-start~; ~suspended-yield~}
  let genContext = gen[[AsyncGeneratorContext]]
  set field gen[[AsyncGeneratorState]] = ~executing~
  perform ! @sec-runsuspendedcontext(genContext, #"completion")
  return ~unused~
}

def @sec-asyncgeneratorunwrapyieldresumption "AsyncGeneratorUnwrapYieldResumption" (kind ao params [resumptionValue : #"Completion Record"] -> completion<#"ECMAScript language value"> | #"abrupt completion") vars [resumptionValue, awaited] {
  if resumptionValue is not ty {#"return completion"} -> return ? resumptionValue
  let awaited = @sec-completion-ao(@await(resumptionValue[[Value]]))
  if awaited is ty {#"throw completion"} -> return ? awaited
  assert awaited is ty {#"normal completion"}
  return @sec-returncompletion(awaited[[Value]])
}

def @sec-asyncgeneratoryield "AsyncGeneratorYield" (kind ao params [arg : #"ECMAScript language value"] -> completion<#"ECMAScript language value"> | #"abrupt completion") vars [arg, genContext, gen, #"completion", previousContext, previousRealm, queue, toYield, resumptionValue] {
  let genContext = $Running()
  assert genContext sat @ph-generator-context()
  let gen = $Component(?genContext, [[Generator]])
  assert @sec-getgeneratorkind() is val {~async~}
  let #"completion" = @sec-normalcompletion(arg)
  assert $ContextBelowTop() is not val {~empty~}
  let previousContext = @ph-second-to-top-context()
  let previousRealm = $Component(?previousContext, [[Realm]])
  perform @sec-asyncgeneratorcompletestep(gen, #"completion", false, previousRealm)
  let queue = gen[[AsyncGeneratorQueue]]
  if queue fails $IsEmpty() {
    note "Execution continues without suspending the generator."
    let toYield = $ListElem(data choice 1, ?queue)
    let resumptionValue = @sec-completion-ao(toYield[[Completion]])
    return ? @sec-asyncgeneratorunwrapyieldresumption(resumptionValue)
  }
  set field gen[[AsyncGeneratorState]] = ~suspended-yield~
  let resumptionValue = @sec-completion-ao(@sec-runcallercontext(undefined))
  return ? @sec-asyncgeneratorunwrapyieldresumption(resumptionValue)
}

def @sec-asyncgeneratorawaitreturn "AsyncGeneratorAwaitReturn" (kind ao params [gen : AsyncGenerator] -> val(~unused~)) vars [gen, queue, next, #"completion", promiseCompletion, promise, fulfilledClosure, value, result, onFulfilled, rejectedClosure, reason, onRejected] {
  assert gen[[AsyncGeneratorState]] is val {~draining-queue~}
  let queue = gen[[AsyncGeneratorQueue]]
  assert queue fails $IsEmpty()
  let next = $ListElem(data choice 1, ?queue)
  let #"completion" = @sec-completion-ao(next[[Completion]])
  assert #"completion" is ty {#"return completion"}
  let promiseCompletion = @sec-completion-ao(@sec-promise-resolve(intrinsic [[Promise]], #"completion"[[Value]]))
  if promiseCompletion is ty {#"abrupt completion"} {
    perform @sec-asyncgeneratorcompletestep(gen, promiseCompletion, true)
    perform @sec-asyncgeneratordrainqueue(gen)
    return ~unused~
  }
  assert promiseCompletion is ty {#"normal completion"}
  let promise = promiseCompletion[[Value]]
  let fulfilledClosure = closure 0
  let onFulfilled = @sec-createbuiltinfunction(fulfilledClosure, 1, "", [])
  let rejectedClosure = closure 1
  let onRejected = @sec-createbuiltinfunction(rejectedClosure, 1, "", [])
  perform @sec-performpromisethen(promise, onFulfilled, onRejected)
  return ~unused~
  closure abstract params [value] captures [gen] {
    assert gen[[AsyncGeneratorState]] is val {~draining-queue~}
    let result = @sec-normalcompletion(value)
    perform @sec-asyncgeneratorcompletestep(gen, result, true)
    perform @sec-asyncgeneratordrainqueue(gen)
    return @sec-normalcompletion(undefined)
  }
  closure abstract params [reason] captures [gen] {
    assert gen[[AsyncGeneratorState]] is val {~draining-queue~}
    let result = @sec-throwcompletion(reason)
    perform @sec-asyncgeneratorcompletestep(gen, result, true)
    perform @sec-asyncgeneratordrainqueue(gen)
    return @sec-normalcompletion(undefined)
  }
}

def @sec-asyncgeneratordrainqueue "AsyncGeneratorDrainQueue" (kind ao params [gen : AsyncGenerator] -> val(~unused~)) vars [gen, queue, next, #"completion"] {
  assert gen[[AsyncGeneratorState]] is val {~draining-queue~}
  let queue = gen[[AsyncGeneratorQueue]]
  repeat_while queue fails $IsEmpty() {
    let next = $ListElem(data choice 1, ?queue)
    let #"completion" = @sec-completion-ao(next[[Completion]])
    if #"completion" is ty {#"return completion"} {
      perform @sec-asyncgeneratorawaitreturn(gen)
      return ~unused~
    }
    if #"completion" is ty {#"normal completion"} {
      set var #"completion" = @sec-normalcompletion(undefined)
    }
    perform @sec-asyncgeneratorcompletestep(gen, #"completion", true)
  }
  set field gen[[AsyncGeneratorState]] = ~completed~
  return ~unused~
}

def @sec-async-function-constructor-arguments "AsyncFunction" (kind builtin params [paramArgs rest, bodyArg]) vars [#"this value", NewTarget, paramArgs, bodyArg, activeFunc] {
  let activeFunc = $ActiveFunction()
  if bodyArg fails $Present() -> set var bodyArg = $"the empty String"()
  return ? @sec-createdynamicfunction(activeFunc, new_target, ~async~, paramArgs, bodyArg)
}

def @sec-async-functions-abstract-operations-async-function-start "AsyncFunctionStart" (kind ao params [promiseCapability : #"PromiseCapability Record", asyncFuncBody : |FunctionBody| | |ExpressionBody| | pred(sat @ph-type-header-closure-no-params())] -> val(~unused~)) vars [promiseCapability, asyncFuncBody, runningContext, asyncContext] {
  let runningContext = $Running()
  let asyncContext = $Copy(?runningContext)
  note "Copying the execution state is required for AsyncBlockStart to resume its execution. It is ill-defined to resume a currently executing context."
  perform @sec-asyncblockstart(promiseCapability, asyncFuncBody, asyncContext)
  return ~unused~
}

def @sec-asyncblockstart "AsyncBlockStart" (kind ao params [promiseCapability : #"PromiseCapability Record", asyncBody : #"Parse Node" | pred(sat @ph-type-header-closure-no-params()), asyncContext : #"execution context"] -> val(~unused~)) vars [promiseCapability, asyncBody, asyncContext, #"closure", acAsyncContext, result, callerContext] {
  let #"closure" = closure 0
  set_code_state asyncContext to #"closure"
  let result = ! @sec-runsuspendedcontext(asyncContext, @sec-normalcompletion(~empty~))
  assert result is val {~unused~; ~empty~}
  note "The possible sources of _result_ values are Await or, if the async function doesn't await anything, step <emu-xref href=\"#step-asyncblockstart-return-undefined\"></emu-xref> above."
  return ~unused~
  closure abstract params none captures [promiseCapability, asyncBody] {
    let acAsyncContext = $Running()
    if asyncBody is ty {#"Parse Node"} {
      let result = @sec-completion-ao(sdo Evaluation(asyncBody))
    }
    else {
      assert asyncBody is ty {pred(sat @ph-type-closure-no-params())}
      let result = @sec-completion-ao(asyncBody())
    }
    assert result is ty {#"normal completion"; #"return completion"; #"throw completion"}
    remove acAsyncContext kind 0
    if result is ty {#"normal completion"} {
      perform ! @sec-call(promiseCapability[[Resolve]], undefined, [undefined])
    }
    else_if result is ty {#"return completion"} {
      perform ! @sec-call(promiseCapability[[Resolve]], undefined, [result[[Value]]])
    }
    else {
      assert result is ty {#"throw completion"}
      perform ! @sec-call(promiseCapability[[Reject]], undefined, [result[[Value]]])
    }
    let callerContext = $Running()
    resume callerContext with @sec-normalcompletion(~unused~)
    unreachable 0
  }
}

def @await "Await" (kind ao params [arg : #"ECMAScript language value"] -> completion<#"ECMAScript language value" | val(~empty~)> | #"throw completion") vars [arg, asyncContext, promise, fulfilledClosure, value, onFulfilled, rejectedClosure, reason, onRejected] {
  let asyncContext = $Running()
  let promise = ? @sec-promise-resolve(intrinsic [[Promise]], arg)
  let fulfilledClosure = closure 0
  let onFulfilled = @sec-createbuiltinfunction(fulfilledClosure, 1, "", [])
  let rejectedClosure = closure 1
  let onRejected = @sec-createbuiltinfunction(rejectedClosure, 1, "", [])
  perform @sec-performpromisethen(promise, onFulfilled, onRejected)
  return ? @sec-runcallercontext(~empty~)
  closure abstract params [value] captures [asyncContext] {
    perform @sec-completion-ao(@sec-runsuspendedcontext(asyncContext, @sec-normalcompletion(value)))
    note "The Completion Record returned by RunSuspendedContext is intentionally ignored."
    return @sec-normalcompletion(undefined)
  }
  closure abstract params [reason] captures [asyncContext] {
    perform @sec-completion-ao(@sec-runsuspendedcontext(asyncContext, @sec-throwcompletion(reason)))
    note "The Completion Record returned by RunSuspendedContext is intentionally ignored."
    return @sec-normalcompletion(undefined)
  }
}

def @sec-iterator.prototype.transfer "Iterator.prototype.transfer" (kind builtin params []) vars [#"this value", NewTarget, O, state, proto, transferred, genContext, closedSteps, closedNext, closedIter] {
  let O = this_value
  if O is not ty {Object} -> throw @ph-new-error([[TypeError]])
  if O sat $HasSlot([[GeneratorState]]) {
    let state = O[[GeneratorState]]
    if state is val {~executing~} -> throw @ph-new-error([[TypeError]])
    let proto = ? O[[GetPrototypeOf]]()
    if O sat $HasSlot([[UnderlyingIterators]]) {
      let transferred = @sec-ordinaryobjectcreate(proto, [[[GeneratorState]], [[GeneratorContext]], [[GeneratorBrand]], [[UnderlyingIterators]]])
      set field transferred[[UnderlyingIterators]] = O[[UnderlyingIterators]]
      set field O[[UnderlyingIterators]] = $ListNew()
    }
    else {
      let transferred = @sec-ordinaryobjectcreate(proto, [[[GeneratorState]], [[GeneratorContext]], [[GeneratorBrand]]])
    }
    set field transferred[[GeneratorBrand]] = O[[GeneratorBrand]]
    set field transferred[[GeneratorState]] = state
    let genContext = O[[GeneratorContext]]
    set field transferred[[GeneratorContext]] = genContext
    if state is val {~suspended-start~; ~suspended-yield~} {
      set field genContext[[Generator]] = transferred
    }
    set field O[[GeneratorState]] = ~completed~
    return transferred
  }
  if O sat $HasSlot([[IteratedArrayLike]]) {
    let proto = ? O[[GetPrototypeOf]]()
    let transferred = @sec-ordinaryobjectcreate(proto, [[[IteratedArrayLike]], [[ArrayLikeNextIndex]], [[ArrayLikeIterationKind]]])
    set field transferred[[IteratedArrayLike]] = O[[IteratedArrayLike]]
    set field transferred[[ArrayLikeNextIndex]] = O[[ArrayLikeNextIndex]]
    set field transferred[[ArrayLikeIterationKind]] = O[[ArrayLikeIterationKind]]
    set field O[[IteratedArrayLike]] = undefined
    return transferred
  }
  if O sat $HasSlot([[IteratingRegExp]]) {
    let proto = ? O[[GetPrototypeOf]]()
    let transferred = @sec-ordinaryobjectcreate(proto, [[[IteratingRegExp]], [[IteratedString]], [[Global]], [[Unicode]], [[Done]]])
    set field transferred[[IteratingRegExp]] = O[[IteratingRegExp]]
    set field transferred[[IteratedString]] = O[[IteratedString]]
    set field transferred[[Global]] = O[[Global]]
    set field transferred[[Unicode]] = O[[Unicode]]
    set field transferred[[Done]] = O[[Done]]
    set field O[[Done]] = true
    return transferred
  }
  if O sat $HasSlot([[Iterated]]) {
    let proto = ? O[[GetPrototypeOf]]()
    let transferred = @sec-ordinaryobjectcreate(proto, [[[Iterated]]])
    set field transferred[[Iterated]] = O[[Iterated]]
    let closedSteps = closure 0
    let closedNext = @sec-createbuiltinfunction(closedSteps, 0, "", [])
    let closedIter = @sec-ordinaryobjectcreate(null)
    set field O[[Iterated]] = record #"Iterator Record" { [[Iterator]]: closedIter, [[NextMethod]]: closedNext, [[Done]]: true }
    return transferred
  }
  throw @ph-new-error([[TypeError]])
  closure abstract params none captures [] {
    return @sec-createiterresultobject(undefined, true)
  }
}

def @sec-%asynciteratorprototype%.transfer "%AsyncIteratorPrototype%.transfer" (kind builtin params []) vars [#"this value", NewTarget, O, state, proto, transferred, genContext] {
  let O = this_value
  if O is not ty {Object} -> throw @ph-new-error([[TypeError]])
  if O sat $HasSlot([[AsyncGeneratorState]]) {
    let state = O[[AsyncGeneratorState]]
    if state is val {~executing~} or state is val {~draining-queue~} -> throw @ph-new-error([[TypeError]])
    if O[[AsyncGeneratorQueue]] fails $IsEmpty() -> throw @ph-new-error([[TypeError]])
    let proto = ? O[[GetPrototypeOf]]()
    let transferred = @sec-ordinaryobjectcreate(proto, [[[AsyncGeneratorState]], [[AsyncGeneratorContext]], [[AsyncGeneratorQueue]], [[GeneratorBrand]]])
    set field transferred[[GeneratorBrand]] = O[[GeneratorBrand]]
    set field transferred[[AsyncGeneratorState]] = state
    let genContext = O[[AsyncGeneratorContext]]
    set field transferred[[AsyncGeneratorContext]] = genContext
    set field transferred[[AsyncGeneratorQueue]] = $ListNew()
    if state is val {~suspended-start~; ~suspended-yield~} {
      set field genContext[[Generator]] = transferred
    }
    set field O[[AsyncGeneratorState]] = ~completed~
    return transferred
  }
  throw @ph-new-error([[TypeError]])
}

