def @sec-%iteratorhelperprototype%.next "%IteratorHelperPrototype%.next" (kind builtin params []) vars [#"this value", NewTarget] {
  return ? @sec-generatorresume(this_value, undefined, "Iterator Helper")
}

def @sec-%iteratorhelperprototype%.return "%IteratorHelperPrototype%.return" (kind builtin params []) vars [#"this value", NewTarget, #"obj", #"completion"] {
  let #"obj" = this_value
  perform ? @sec-requireinternalslot(#"obj", [[UnderlyingIterators]])
  assert #"obj" sat $HasSlot([[GeneratorState]])
  if #"obj"[[GeneratorState]] is val {~suspended-start~} {
    set field #"obj"[[GeneratorState]] = ~completed~
    note "Once a generator enters the completed state it never leaves it and its associated execution context is never resumed. Any execution state associated with _obj_ can be discarded at this point."
    perform ? @sec-iteratorcloseall(#"obj"[[UnderlyingIterators]], @sec-normalcompletion(~unused~))
    return @sec-createiterresultobject(undefined, true)
  }
  let #"completion" = @sec-returncompletion(undefined)
  return ? @sec-generatorresumeabrupt(#"obj", #"completion", "Iterator Helper")
}

def @sec-iterator "Iterator" (kind builtin params []) vars [#"this value", NewTarget] {
  if new_target is val {undefined; $ActiveFunction()} -> throw @ph-new-error([[TypeError]])
  return ? @sec-ordinarycreatefromconstructor(new_target, "%Iterator.prototype%")
}

def @sec-iterator.concat "Iterator.concat" (kind builtin params [items rest]) vars [#"this value", NewTarget, items, iterables, item, #"method", #"closure", iterable, iterator, iteratorRecord, innerAlive, innerValue, #"completion", gen] {
  let iterables = $ListNew()
  for_each item in items {
    if item is not ty {Object} -> throw @ph-new-error([[TypeError]])
    let #"method" = ? @sec-getmethod(item, $WellKnownSymbol("Symbol.iterator"))
    if #"method" is val {undefined} -> throw @ph-new-error([[TypeError]])
    perform $Append(record Record { [[OpenMethod]]: #"method", [[Iterable]]: item }, ?iterables)
  }
  let #"closure" = closure 0
  let gen = @sec-createiteratorfromclosure(#"closure", "Iterator Helper", intrinsic [[IteratorHelperPrototype]], [[[UnderlyingIterators]]])
  set field gen[[UnderlyingIterators]] = $ListNew()
  return gen
  closure abstract params none captures [iterables] {
    for_each iterable : Record in iterables {
      let iterator = ? @sec-call(iterable[[OpenMethod]], iterable[[Iterable]])
      if iterator is not ty {Object} -> throw @ph-new-error([[TypeError]])
      let iteratorRecord = ? @sec-getiteratordirect(iterator)
      let innerAlive = true
      repeat_while innerAlive is val {true} {
        let innerValue = ? @sec-iteratorstepvalue(iteratorRecord)
        if innerValue is val {~done~} {
          set var innerAlive = false
        }
        else {
          let #"completion" = @sec-completion-ao(@sec-yield(innerValue))
          if #"completion" is ty {#"abrupt completion"} {
            return ? @sec-iteratorclose(iteratorRecord, #"completion")
          }
        }
      }
    }
    return @sec-returncompletion(undefined)
  }
}

def @sec-iterator.from "Iterator.from" (kind builtin params [#"obj"]) vars [#"this value", NewTarget, #"obj", iteratorRecord, hasInstance, wrapper] {
  let iteratorRecord = ? @sec-getiteratorflattenable(#"obj", ~iterate-string-primitives~)
  let hasInstance = ? @sec-ordinaryhasinstance(intrinsic [[Iterator]], iteratorRecord[[Iterator]])
  if hasInstance is val {true} {
    return iteratorRecord[[Iterator]]
  }
  let wrapper = @sec-ordinaryobjectcreate(intrinsic [[WrapForValidIteratorPrototype]], [[[Iterated]]])
  set field wrapper[[Iterated]] = iteratorRecord
