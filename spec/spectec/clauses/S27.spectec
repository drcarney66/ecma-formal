def @sec-iterator.prototype.drop "Iterator.prototype.drop" (kind builtin params [limit]) vars [#"this value", NewTarget, limit, #"obj", iterated, numberLimit, error, intLimit, #"closure", remaining, next, value, #"completion", result] {
