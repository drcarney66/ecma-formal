    assert promise[[PromiseState]] is val {~rejected~}
    let reason = promise[[PromiseResult]]
    if promise[[PromiseIsHandled]] is val {false} -> perform @sec-host-promise-rejection-tracker(promise, "handle")
    let rejectJob = @sec-newpromisereactionjob(rejectReaction, reason)
    perform @sec-hostenqueuepromisejob(rejectJob[[Job]], rejectJob[[Realm]])
