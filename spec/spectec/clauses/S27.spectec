def @sec-createresolvingfunctions "CreateResolvingFunctions" (kind ao params [toResolve : Promise] -> record { [[Resolve]]: #"function object", [[Reject]]: #"function object" }) vars [toResolve, promiseOrEmpty, resolveSteps, resolution, promise, selfResolutionError, #"then", thenAction, thenJobCallback, job, resolve, rejectSteps, reason, reject] {
  let promiseOrEmpty = record Record { [[Value]]: toResolve }
  let resolveSteps = closure 0
