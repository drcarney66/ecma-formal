def @sec-generatorstart "GeneratorStart" (kind ao params [gen : Generator, genBody : |FunctionBody| | pred(sat @ph-type-header-closure-no-params())] -> val(~unused~)) vars [gen, genBody, genContext, #"closure", acGenContext, acGen, result, resumption, resultValue, callerContext] {
