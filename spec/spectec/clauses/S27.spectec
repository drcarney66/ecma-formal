def @sec-performpromisethen "PerformPromiseThen" (kind ao params [promise : Promise, onFulfilled : #"ECMAScript language value", onRejected : #"ECMAScript language value", resultCapability : #"PromiseCapability Record" opt] -> Object | val(undefined)) vars [promise, onFulfilled, onRejected, resultCapability, onFulfilledJobCallback, onRejectedJobCallback, fulfillReaction, rejectReaction, value, fulfillJob, reason, rejectJob] {
  assert @sec-ispromise(promise) is val {true}
  if resultCapability fails $Present() {
    set var resultCapability = undefined
  }
  if @sec-iscallable(onFulfilled) is val {false} {
    let onFulfilledJobCallback = ~empty~
  }
  else {
    let onFulfilledJobCallback = @sec-hostmakejobcallback(onFulfilled)
  }
  if @sec-iscallable(onRejected) is val {false} {
    let onRejectedJobCallback = ~empty~
  }
  else {
    let onRejectedJobCallback = @sec-hostmakejobcallback(onRejected)
  }
  let fulfillReaction = record #"PromiseReaction Record" { [[Capability]]: resultCapability, [[Type]]: ~fulfill~, [[Handler]]: onFulfilledJobCallback }
  let rejectReaction = record #"PromiseReaction Record" { [[Capability]]: resultCapability, [[Type]]: ~reject~, [[Handler]]: onRejectedJobCallback }
  if promise[[PromiseState]] is val {~pending~} {
    perform $Append(?fulfillReaction, promise[[PromiseFulfillReactions]])
    perform $Append(?rejectReaction, promise[[PromiseRejectReactions]])
  }
  else_if promise[[PromiseState]] is val {~fulfilled~} {
    let value = promise[[PromiseResult]]
    let fulfillJob = @sec-newpromisereactionjob(fulfillReaction, value)
    perform @sec-hostenqueuepromisejob(fulfillJob[[Job]], fulfillJob[[Realm]])
