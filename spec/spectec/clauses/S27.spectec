def @sec-iterator.zip "Iterator.zip" (kind builtin params [iterables, options opt]) vars [#"this value", NewTarget, iterables, options, mode, paddingOption, iters, padding, inputIter, next, iter, needClosing, iterCount, paddingIter, usingIterator, #"completion", finishResults, results] {
  if iterables is not ty {Object} -> throw @ph-new-error([[TypeError]])
  set var options = ? @sec-getoptionsobject(options)
  let mode = ? @sec-get-o-p(options, "mode")
  if mode is val {undefined} -> set var mode = "shortest"
  if mode is not val {"shortest"; "longest"; "strict"} -> throw @ph-new-error([[TypeError]])
  let paddingOption = undefined
  if mode is val {"longest"} {
    set var paddingOption = ? @sec-get-o-p(options, "padding")
    if paddingOption is not val {undefined} and paddingOption is not ty {Object} -> throw @ph-new-error([[TypeError]])
  }
  let iters = $ListNew()
  let padding = $ListNew()
  let inputIter = ? @sec-getiterator(iterables, ~sync~)
  let next = ~not-started~
  repeat_while next is not val {~done~} {
    set var next = @sec-completion-ao(@sec-iteratorstepvalue(inputIter))
    block {
      assert next is ty {#"Completion Record"}
      if next is ty {#"abrupt completion"} -> return ? @sec-iteratorcloseall(iters, next)
      set var next = ! next
    }
    if next is not val {~done~} {
      let iter = @sec-completion-ao(@sec-getiteratorflattenable(next, ~reject-primitives~))
      let needClosing = $ListConcat([[inputIter], iters])
      block {
        assert iter is ty {#"Completion Record"}
        if iter is ty {#"abrupt completion"} -> return ? @sec-iteratorcloseall(needClosing, iter)
        set var iter = ! iter
      }
      perform $Append(?iter, ?iters)
    }
  }
  let iterCount = $ListLen(?iters)
  if mode is val {"longest"} {
    if paddingOption is val {undefined} {
      repeat_n iterCount {
        perform $Append(undefined, ?padding)
      }
    }
    else {
      let paddingIter = @sec-completion-ao(@sec-getiterator(paddingOption, ~sync~))
      block {
        assert paddingIter is ty {#"Completion Record"}
        if paddingIter is ty {#"abrupt completion"} -> return ? @sec-iteratorcloseall(iters, paddingIter)
        set var paddingIter = ! paddingIter
      }
      let usingIterator = true
      repeat_n iterCount {
        if usingIterator is val {true} {
          set var next = @sec-completion-ao(@sec-iteratorstepvalue(paddingIter))
          block {
            assert next is ty {#"Completion Record"}
            if next is ty {#"abrupt completion"} -> return ? @sec-iteratorcloseall(iters, next)
            set var next = ! next
          }
          if next is val {~done~} {
            set var usingIterator = false
          }
          else {
            perform $Append(?next, ?padding)
          }
        }
        if usingIterator is val {false} -> perform $Append(undefined, ?padding)
      }
      if usingIterator is val {true} {
        let #"completion" = @sec-completion-ao(@sec-iteratorclose(paddingIter, @sec-normalcompletion(~unused~)))
        block {
          assert #"completion" is ty {#"Completion Record"}
          if #"completion" is ty {#"abrupt completion"} -> return ? @sec-iteratorcloseall(iters, #"completion")
          set var #"completion" = ! #"completion"
        }
      }
    }
  }
  let finishResults = closure 0
  return @sec-iteratorzip(iters, mode, padding, finishResults)
  closure abstract params [results] captures [] {
    return @sec-createarrayfromlist(results)
  }
}

def @sec-iterator.zipkeyed "Iterator.zipKeyed" (kind builtin params [iterables, options opt]) vars [#"this value", NewTarget, iterables, options, mode, paddingOption, iters, padding, allKeys, #"keys", key, propertyDesc, value, iter, iterCount, finishResults, results, #"obj", i] {
