table t"table-additional-fields-of-source-text-module-records" @sec-source-text-module-records#0 {
  kind fields
  thead true
  schema ("Source Text Module Record", true)
  vars []
  rows [
    row [
      cell { text "Field Name" }
      cell { text "Value Type" }
      cell { text "Meaning" }
    ]
    row [
      cell { field [[ECMAScriptCode]] }
      cell { ty (#"Parse Node") }
      cell { text "The result of parsing the source text of this module using |Module| as the goal symbol." }
    ]
    row [
      cell { field [[Context]] }
      cell { ty (#"ECMAScript code execution context" | val(~empty~)) }
      cell { text "The execution context associated with this module. It is ~empty~ until the module's environment has been initialized." }
    ]
    row [
      cell { field [[ImportMeta]] }
      cell { ty (Object | val(~empty~)) }
      cell { text "An object exposed through the `import.meta` meta property. It is ~empty~ until it is accessed by ECMAScript code." }
    ]
    row [
      cell { field [[ImportEntries]] }
      cell { ty (list<#"ImportEntry Record">) }
      cell { text "A List of ImportEntry records derived from the code of this module." }
    ]
    row [
      cell { field [[LocalExportEntries]] }
      cell { ty (list<#"ExportEntry Record">) }
      cell { text "A List of ExportEntry records derived from the code of this module that correspond to declarations that occur within the module." }
    ]
    row [
      cell { field [[IndirectExportEntries]] }
      cell { ty (list<#"ExportEntry Record">) }
      cell { text "A List of ExportEntry records derived from the code of this module that correspond to reexported imports that occur within the module or exports from `export * as namespace` declarations." }
    ]
    row [
      cell { field [[StarExportEntries]] }
      cell { ty (list<#"ExportEntry Record">) }
      cell { text "A List of ExportEntry records derived from the code of this module that correspond to `export *` declarations that occur within the module, not including `export * as namespace` declarations." }
    ]
  ]
}

