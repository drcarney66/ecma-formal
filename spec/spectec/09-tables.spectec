table t"table-abstract-methods-of-environment-records" @sec-the-environment-record-type-hierarchy#0 {
  kind abstract_methods
  thead true
  vars [name, deletable, strict, value]
  rows [
    row [
      cell { text "Method" }
      cell { text "Purpose" }
      cell { text "Definitions" }
    ]
    row [
      cell { sig (method HasBinding (name: String) -> completion<Boolean> | #"throw completion") }
      cell { text "It determines if an Environment Record has a binding for _name_." }
      cell { text "It has concrete definitions in the following types:\n<emu-concrete-method-dfns for=\"HasBinding\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method CreateMutableBinding (name: String, deletable: Boolean) -> completion<val(~unused~)> | #"throw completion") }
      cell { text "It creates a new but uninitialized mutable binding in an Environment Record. _name_ is the text of the bound name. If _deletable_ is *true* the binding may be subsequently deleted." }
      cell { text "It has concrete definitions in the following types:\n<emu-concrete-method-dfns for=\"CreateMutableBinding\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method CreateImmutableBinding (name: String, strict: Boolean) -> completion<val(~unused~)> | #"throw completion") }
      cell { text "It creates a new but uninitialized immutable binding in an Environment Record. _name_ is the text of the bound name. If _strict_ is *true* then attempts to set it after it has been initialized will always throw an exception, regardless of the strict mode setting of operations that reference that binding." }
      cell { text "It has concrete definitions in the following types:\n<emu-concrete-method-dfns for=\"CreateImmutableBinding\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method InitializeBinding (name: String, value: #"ECMAScript language value") -> completion<val(~unused~)> | #"throw completion") }
      cell { text "It sets the value of an already existing but uninitialized binding in an Environment Record. _name_ is the text of the bound name. _value_ is the value for the binding." }
      cell { text "It has concrete definitions in the following types:\n<emu-concrete-method-dfns for=\"InitializeBinding\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method SetMutableBinding (name: String, value: #"ECMAScript language value", strict: Boolean) -> completion<val(~unused~)> | #"throw completion") }
      cell { text "It sets the value of an already existing mutable binding in an Environment Record. _name_ is the text of the bound name. _value_ is the value for the binding. If _strict_ is *true* and the binding cannot be set, this will throw a *TypeError* exception." }
      cell { text "It has concrete definitions in the following types:\n<emu-concrete-method-dfns for=\"SetMutableBinding\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method GetBindingValue (name: String, strict: Boolean) -> completion<#"ECMAScript language value"> | #"throw completion") }
      cell { text "It returns the value of an already existing binding from an Environment Record. _name_ is the text of the bound name. _strict_ is used to identify references originating in strict mode code or that otherwise require strict mode reference semantics. If _strict_ is *true* and the binding does not exist, this will throw a *ReferenceError* exception. If the binding exists but is uninitialized a *ReferenceError* is thrown, regardless of the value of _strict_." }
      cell { text "It has concrete definitions in the following types:\n<emu-concrete-method-dfns for=\"GetBindingValue\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method DeleteBinding (name: String) -> completion<Boolean> | #"throw completion") }
      cell { text "It deletes a binding from an Environment Record. _name_ is the text of the bound name. If a binding for _name_ exists, this removes the binding and returns *true*. If the binding exists but cannot be removed, this returns *false*. If the binding does not exist, this returns *true*." }
      cell { text "It has concrete definitions in the following types:\n<emu-concrete-method-dfns for=\"DeleteBinding\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method HasThisBinding () -> Boolean) }
      cell { text "It determines if an Environment Record establishes a `this` binding. This returns *true* if it does and *false* if it does not." }
      cell { text "It has concrete definitions in the following types:\n<emu-concrete-method-dfns for=\"HasThisBinding\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method GetThisBinding () -> completion<#"ECMAScript language value"> | #"throw completion") }
      cell { text "It returns the value of this Environment Record's `this` binding. It throws a *ReferenceError* if the `this` binding has not been initialized." }
      cell { text "It has concrete definitions in the following types:\n<emu-concrete-method-dfns for=\"GetThisBinding\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method HasSuperBinding () -> Boolean) }
      cell { text "It determines if an Environment Record establishes a `super` method binding. This returns *true* if it does and *false* if it does not. If it returns *true* it implies that the Environment Record is a Function Environment Record, although the reverse implication does not hold." }
      cell { text "It has concrete definitions in the following types:\n<emu-concrete-method-dfns for=\"HasSuperBinding\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method WithBaseObject () -> Object | val(undefined)) }
      cell { text "If this Environment Record is associated with a `with` statement, it returns the with object. Otherwise, it returns *undefined*." }
      cell { text "It has concrete definitions in the following types:\n<emu-concrete-method-dfns for=\"WithBaseObject\"></emu-concrete-method-dfns>" }
    ]
  ]
}

table t"table-abstract-methods-of-module-records" @sec-abstract-module-records#1 {
  kind abstract_methods
  thead true
  vars [hostDefined, exportStarSet, exportName, resolveSet]
  rows [
    row [
      cell { text "Method" }
      cell { text "Purpose" }
      cell { text "Definitions" }
    ]
    row [
      cell { sig (method LoadRequestedModules (hostDefined: pred(sat @ph-type-anything()) opt) -> Promise) }
      cell { text "<p>It prepares the module for linking by recursively loading all its dependencies.</p>" }
      cell { text "Within this specification it has definitions in the following types; hosts may provide additional types with their own definitions:\n<emu-concrete-method-dfns for=\"LoadRequestedModules\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method GetExportedNames (exportStarSet: list<#"Source Text Module Record"> opt) -> list<String>) }
      cell { text "<p>It returns a list of all names that are either directly or indirectly exported from this module.</p>\n<p>LoadRequestedModules must have completed successfully prior to invoking this method.</p>" }
      cell { text "Within this specification it has definitions in the following types; hosts may provide additional types with their own definitions:\n<emu-concrete-method-dfns for=\"GetExportedNames\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method ResolveExport (exportName: String, resolveSet: records [[[Module]]: #"Module Record", [[ExportName]]: String] opt) -> #"ResolvedBinding Record" | val(null) | val(~ambiguous~)) }
      cell { text "<p>It returns the binding of a name exported by this module. Bindings are represented by a <dfn id=\"resolvedbinding-record\" variants=\"ResolvedBinding Records\">ResolvedBinding Record</dfn>, of the form { [[Module]]: Module Record, [[BindingName]]: String | ~namespace~ }. If the export is a Module Namespace Object without a direct binding in any module, [[BindingName]] will be set to ~namespace~. It returns *null* if the name cannot be resolved, or ~ambiguous~ if multiple bindings were found.</p>\n<p>Each time this operation is called with a specific _exportName_, _resolveSet_ pair as arguments it must return the same result.</p>\n<p>LoadRequestedModules must have completed successfully prior to invoking this method.</p>" }
      cell { text "Within this specification it has definitions in the following types; hosts may provide additional types with their own definitions:\n<emu-concrete-method-dfns for=\"ResolveExport\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method Link () -> completion<val(~unused~)> | #"throw completion") }
      cell { text "<p>It prepares the module for evaluation by transitively resolving all module dependencies and creating a Module Environment Record.</p>\n<p>LoadRequestedModules must have completed successfully prior to invoking this method.</p>" }
      cell { text "Within this specification it has definitions in the following types; hosts may provide additional types with their own definitions:\n<emu-concrete-method-dfns for=\"Link\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method Evaluate () -> Promise) }
      cell { text "<p>It returns a promise for the evaluation of this module and its dependencies, resolving on successful evaluation or if it has already been evaluated successfully, and rejecting for an evaluation error or if it has already been evaluated unsuccessfully. If the promise is rejected, hosts are expected to handle the promise rejection and rethrow the evaluation error. Unless this module is a Cyclic Module Record, the returned promise must be already settled.</p>\n<p>Link must have completed successfully prior to invoking this method.</p>" }
      cell { text "Within this specification it has definitions in the following types; hosts may provide additional types with their own definitions:\n<emu-concrete-method-dfns for=\"Evaluate\"></emu-concrete-method-dfns>" }
    ]
  ]
}

table t"table-additional-essential-internal-methods-of-function-objects" @sec-object-internal-methods-and-internal-slots#1 {
  kind internal_methods
  thead true
  vars [thisArg, argList, newTarget]
  rows [
    row [
      cell { text "Internal Method" }
      cell { text "Description" }
      cell { text "Definitions" }
    ]
    row [
      cell { sig (field [[Call]] (thisArg: #"ECMAScript language value", argList: list<#"ECMAScript language value">) -> completion<#"ECMAScript language value"> | #"throw completion") }
      cell { text "It executes code associated with this object. Invoked via a function call expression. The arguments to the internal method are a *this* value and a List whose elements are the arguments passed to the function by a call expression. Objects that implement this internal method are <em>callable</em>." }
      cell { text "Within this specification it has definitions in the following types; hosts may provide additional types with their own definitions:\n<emu-internal-method-dfns for=\"[[Call]]\"></emu-internal-method-dfns>" }
    ]
    row [
      cell { sig (field [[Construct]] (argList: list<#"ECMAScript language value">, newTarget: constructor) -> completion<Object> | #"throw completion") }
      cell { text "It creates an object. Invoked via the `new` operator or a `super` call. The first argument to the internal method is a List whose elements are the arguments of the constructor invocation or the `super` call. The second argument is the object to which the `new` operator was initially applied. Objects that implement this internal method are called <em>constructors</em>. A function object is not necessarily a constructor and such non-constructor function objects do not have a [[Construct]] internal method." }
      cell { text "Within this specification it has definitions in the following types; hosts may provide additional types with their own definitions:\n<emu-internal-method-dfns for=\"[[Construct]]\"></emu-internal-method-dfns>" }
    ]
  ]
}

table t"table-additional-fields-of-function-environment-records" @sec-function-environment-records#0 {
  kind fields
  thead true
  schema ("Function Environment Record", true)
  vars []
  rows [
    row [
      cell { text "Field Name" }
      cell { text "Value" }
      cell { text "Meaning" }
    ]
    row [
      cell { field [[ThisValue]] }
      cell { ty (#"ECMAScript language value") }
      cell { text "This is the *this* value used for this invocation of the function." }
    ]
    row [
      cell { field [[ThisBindingStatus]] }
      cell { ty (val(~lexical~) | val(~initialized~) | val(~uninitialized~)) }
      cell { text "If the value is ~lexical~, this is an |ArrowFunction| or |AsyncArrowFunction| and does not have a local *this* value." }
    ]
    row [
      cell { field [[FunctionObject]] }
      cell { ty (#"ECMAScript function object") }
      cell { text "The function object whose invocation caused this Environment Record to be created." }
    ]
    row [
      cell { field [[NewTarget]] }
      cell { ty (constructor | val(undefined)) }
      cell { text "If this Environment Record was created by the [[Construct]] internal method, [[NewTarget]] is the value of the [[Construct]] _newTarget_ parameter. Otherwise, its value is *undefined*." }
    ]
  ]
}

table t"table-additional-fields-of-global-environment-records" @sec-global-environment-records#0 {
  kind fields
  thead true
  schema ("Global Environment Record", true)
  vars []
  rows [
    row [
      cell { text "Field Name" }
      cell { text "Value" }
      cell { text "Meaning" }
    ]
    row [
      cell { field [[ObjectRecord]] }
      cell { ty (#"Object Environment Record") }
      cell { text "Binding object is the global object. It contains global built-in bindings as well as |FunctionDeclaration|, |GeneratorDeclaration|, |AsyncFunctionDeclaration|, |AsyncGeneratorDeclaration|, and |VariableDeclaration| bindings in global code for the associated realm." }
    ]
    row [
      cell { field [[GlobalThisValue]] }
      cell { ty (Object) }
      cell { text "The value returned by `this` in global scope. Hosts may provide any ECMAScript Object value." }
    ]
    row [
      cell { field [[DeclarativeRecord]] }
      cell { ty (#"Declarative Environment Record") }
      cell { text "<emu-not-ref>Contains</emu-not-ref> bindings for all declarations in global code for the associated realm code except for |FunctionDeclaration|, |GeneratorDeclaration|, |AsyncFunctionDeclaration|, |AsyncGeneratorDeclaration|, and |VariableDeclaration| bindings." }
    ]
  ]
}

