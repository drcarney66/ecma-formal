      cell span (2, 1) { text "<emu-xref href=\"#sec-exp-operator\" title></emu-xref>\nand <emu-xref href=\"#sec-math.pow\" title></emu-xref>" }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-exponentiate }
      cell { ty (completion<BigInt> | #"throw completion") }
    ]
    row [
      cell { op @sec-numeric-types-number-multiply }
      cell span (2, 1) { expr (code "x * y") }
      cell span (2, 1) { text "<emu-xref href=\"#sec-multiplicative-operators\" title></emu-xref>" }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-multiply }
      cell { ty (BigInt) }
    ]
    row [
      cell { op @sec-numeric-types-number-divide }
      cell span (2, 1) { expr (code "x / y") }
      cell span (2, 1) { text "<emu-xref href=\"#sec-multiplicative-operators\" title></emu-xref>" }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-divide }
      cell { ty (completion<BigInt> | #"throw completion") }
    ]
    row [
      cell { op @sec-numeric-types-number-remainder }
      cell span (2, 1) { expr (code "x % y") }
      cell span (2, 1) { text "<emu-xref href=\"#sec-multiplicative-operators\" title></emu-xref>" }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-remainder }
      cell { ty (completion<BigInt> | #"throw completion") }
    ]
    row [
      cell { op @sec-numeric-types-number-add }
      cell span (2, 1) { lines [expr (code "x ++"), expr (code "++ x"), expr (code "x + y")] }
      cell span (2, 1) { text "<emu-xref href=\"#sec-postfix-increment-operator\" title></emu-xref>,\n<emu-xref href=\"#sec-prefix-increment-operator\" title></emu-xref>,\nand <emu-xref href=\"#sec-addition-operator-plus\" title></emu-xref>" }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-add }
      cell { ty (BigInt) }
    ]
    row [
      cell { op @sec-numeric-types-number-subtract }
      cell span (2, 1) { lines [expr (code "x --"), expr (code "-- x"), expr (code "x - y")] }
      cell span (2, 1) { text "<emu-xref href=\"#sec-postfix-decrement-operator\" title></emu-xref>,\n<emu-xref href=\"#sec-prefix-decrement-operator\" title></emu-xref>,\nand <emu-xref href=\"#sec-subtraction-operator-minus\" title></emu-xref>" }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-subtract }
      cell { ty (BigInt) }
    ]
    row [
      cell { op @sec-numeric-types-number-leftShift }
      cell span (2, 1) { expr (code "x << y") }
      cell span (2, 1) { text "<emu-xref href=\"#sec-left-shift-operator\" title></emu-xref>" }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-leftShift }
      cell { ty (BigInt) }
    ]
    row [
      cell { op @sec-numeric-types-number-signedRightShift }
      cell span (2, 1) { expr (code "x >> y") }
      cell span (2, 1) { text "<emu-xref href=\"#sec-signed-right-shift-operator\" title></emu-xref>" }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-signedRightShift }
      cell { ty (BigInt) }
    ]
    row [
      cell { op @sec-numeric-types-number-unsignedRightShift }
      cell span (2, 1) { expr (code "x >>> y") }
      cell span (2, 1) { text "<emu-xref href=\"#sec-unsigned-right-shift-operator\" title></emu-xref>" }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-unsignedRightShift }
      cell { ty (#"throw completion") }
    ]
    row [
      cell { op @sec-numeric-types-number-lessThan }
      cell span (2, 1) { lines [expr (code "x < y"), expr (code "x > y"), expr (code "x <= y"), expr (code "x >= y")] }
      cell span (2, 1) { text "<emu-xref href=\"#sec-relational-operators\" title></emu-xref>,\nvia <emu-xref href=\"#sec-islessthan\" title></emu-xref>" }
      cell { raw "Boolean or *undefined* (for unordered inputs)" }
    ]
    row [
      cell { op @sec-numeric-types-bigint-lessThan }
      cell { ty (Boolean) }
    ]
    row [
      cell { op @sec-numeric-types-number-equal }
      cell span (2, 1) { lines [expr (code "x == y"), expr (code "x != y"), expr (code "x === y"), expr (code "x !== y")] }
      cell span (2, 1) { text "<emu-xref href=\"#sec-equality-operators\" title></emu-xref>,\nvia <emu-xref href=\"#sec-isstrictlyequal\" title></emu-xref>" }
      cell span (2, 1) { ty (Boolean) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-equal }
    ]
    row [
      cell { op @sec-numeric-types-number-sameValue }
      cell { expr (code "Object.is(x, y)") }
      cell { text "Object internal methods,\nvia <emu-xref href=\"#sec-samevalue\" title></emu-xref>,\nto test exact value equality" }
      cell { ty (Boolean) }
    ]
    row [
      cell { op @sec-numeric-types-number-sameValueZero }
      cell { expr (code "[x].includes(y)") }
      cell { text "via <emu-xref href=\"#sec-samevaluezero\" title></emu-xref>,\nto test value equality, ignoring the difference between *+0*<sub>𝔽</sub> and *-0*<sub>𝔽</sub>, as in Array, Map, and Set methods" }
      cell { ty (Boolean) }
    ]
    row [
      cell { op @sec-numeric-types-number-bitwiseAND }
      cell span (2, 1) { expr (code "x & y") }
      cell span (6, 1) { text "<emu-xref href=\"#sec-binary-bitwise-operators\" title></emu-xref>" }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-bitwiseAND }
      cell { ty (BigInt) }
    ]
    row [
      cell { op @sec-numeric-types-number-bitwiseXOR }
      cell span (2, 1) { expr (code "x ^ y") }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-bitwiseXOR }
      cell { ty (BigInt) }
    ]
    row [
      cell { op @sec-numeric-types-number-bitwiseOR }
      cell span (2, 1) { expr (code "x | y") }
      cell { ty (Number) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-bitwiseOR }
      cell { ty (BigInt) }
    ]
    row [
      cell { op @sec-numeric-types-number-tostring }
      cell span (2, 1) { expr (code "String(x)") }
      cell span (2, 1) { text "Many expressions and built-in functions, via <emu-xref href=\"#sec-tostring\" title></emu-xref>" }
      cell span (2, 1) { ty (String) }
    ]
    row [
      cell { op @sec-numeric-types-bigint-tostring }
    ]
  ]
}

table t"table-object-property-attributes" @sec-property-attributes#0 {
  kind data
  thead true
  vars []
  rows [
    row [
      cell { text "Attribute Name" }
      cell { text "Types of property for which it is present" }
      cell { text "Value Domain" }
      cell { text "Default Value" }
      cell { text "Description" }
    ]
    row [
      cell { expr ([[Value]]) }
      cell { text "data property" }
      cell { ty (#"ECMAScript language value") }
      cell { expr (undefined) }
      cell { text "The value retrieved by a get access of the property." }
    ]
    row [
      cell { expr ([[Writable]]) }
      cell { text "data property" }
      cell { ty (Boolean) }
      cell { expr (false) }
      cell { text "If *false*, attempts by ECMAScript code to change the property's [[Value]] attribute using [[Set]] will not succeed." }
    ]
    row [
      cell { expr ([[Getter]]) }
      cell { text "accessor property" }
      cell { ty (#"function object" | val(undefined)) }
      cell { expr (undefined) }
      cell { text "If the value is not *undefined*, its [[Call]] internal method (<emu-xref href=\"#table-additional-essential-internal-methods-of-function-objects\"></emu-xref>) is called with an empty arguments list to retrieve the property value each time a get access of the property is performed." }
    ]
    row [
      cell { expr ([[Setter]]) }
      cell { text "accessor property" }
      cell { ty (#"function object" | val(undefined)) }
      cell { expr (undefined) }
      cell { text "If the value is not *undefined*, its [[Call]] internal method (<emu-xref href=\"#table-additional-essential-internal-methods-of-function-objects\"></emu-xref>) is called with an arguments list containing the assigned value as its sole argument each time a set access of the property is performed. The effect of a property's [[Setter]] internal method may, but is not required to, have an effect on the value returned by subsequent calls to the property's [[Getter]] internal method." }
    ]
    row [
      cell { expr ([[Enumerable]]) }
      cell { text "data property or accessor property" }
      cell { ty (Boolean) }
      cell { expr (false) }
      cell { text "If *true*, the property will be enumerated by a for-in enumeration (see <emu-xref href=\"#sec-for-in-and-for-of-statements\"></emu-xref>). Otherwise, the property is said to be non-enumerable." }
    ]
    row [
      cell { expr ([[Configurable]]) }
      cell { text "data property or accessor property" }
      cell { ty (Boolean) }
      cell { expr (false) }
      cell { text "If *false*, attempts to delete the property, change it from a data property to an accessor property or from an accessor property to a data property, or make any changes to its attributes (other than replacing an existing [[Value]] or setting [[Writable]] to *false*) will fail." }
    ]
  ]
}

table t"table-privateelement-fields" @sec-privateelement-specification-type#0 {
  kind fields
  thead true
  schema ("PrivateElement", false)
  vars []
  rows [
