      cell { raw "All" }
      cell { ty (val(~field~) | val(~method~) | val(~accessor~)) }
      cell { text "The kind of the element." }
    ]
    row [
      cell { field [[Value]] }
      cell { raw "~field~ and ~method~" }
      cell { ty (#"ECMAScript language value") }
      cell { text "The value of the field." }
    ]
    row [
      cell { field [[Getter]] }
      cell { expr (~accessor~) }
