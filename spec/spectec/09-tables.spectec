table t"table-module-record-fields" @sec-abstract-module-records#0 {
  kind fields
  thead true
  schema ("Module Record", false)
  vars []
  rows [
    row [
      cell { text "Field Name" }
      cell { text "Value Type" }
      cell { text "Meaning" }
    ]
    row [
      cell { field [[Realm]] }
      cell { ty (#"Realm Record") }
      cell { text "The Realm within which this module was created." }
    ]
    row [
      cell { field [[Environment]] }
      cell { ty (#"Module Environment Record" | val(~empty~)) }
      cell { text "The Environment Record containing the top level bindings for this module. This field is set when the module is linked." }
    ]
    row [
      cell { field [[Namespace]] }
      cell { ty (Object | val(~empty~)) }
      cell { text "The Module Namespace Object (<emu-xref href=\"#sec-module-namespace-objects\"></emu-xref>) if one has been created for this module." }
    ]
    row [
      cell { field [[HostDefined]] }
      cell { ty (pred(sat @spec-copy-6(data choice 0, undefined))) }
      cell { text "Field reserved for use by host environments that need to associate additional information with a module." }
    ]
  ]
}

