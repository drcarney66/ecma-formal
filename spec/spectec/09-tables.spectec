table t"table-agent-record" @sec-agents#0 {
  kind fields
  thead true
  schema ("Agent Record", false)
  vars []
  rows [
    row [
      cell { text "Field Name" }
      cell { text "Value" }
      cell { text "Meaning" }
    ]
    row [
      cell { field [[LittleEndian]] }
      cell { ty (Boolean) }
      cell { text "The default value computed for the <em>isLittleEndian</em> parameter when it is needed by the algorithms GetValueFromBuffer and SetValueInBuffer. The choice is implementation-defined and should be the alternative that is most efficient for the implementation." }
    ]
    row [
      cell { field [[CanBlock]] }
      cell { ty (Boolean) }
      cell { text "Determines whether the agent can block or not." }
    ]
    row [
      cell { field [[Signifier]] }
      cell { ty (#"agent signifier") }
      cell { text "Uniquely identifies the agent within its agent cluster." }
    ]
    row [
      cell { field [[IsLockFree1]] }
      cell { ty (Boolean) }
      cell { text "*true* if atomic operations on one-<emu-not-ref>byte values</emu-not-ref> are lock-free, *false* otherwise." }
    ]
    row [
      cell { field [[IsLockFree2]] }
      cell { ty (Boolean) }
      cell { text "*true* if atomic operations on two-<emu-not-ref>byte values</emu-not-ref> are lock-free, *false* otherwise." }
    ]
    row [
      cell { field [[IsLockFree8]] }
      cell { ty (Boolean) }
      cell { text "*true* if atomic operations on eight-<emu-not-ref>byte values</emu-not-ref> are lock-free, *false* otherwise." }
    ]
    row [
      cell { field [[CandidateExecution]] }
      cell { ty (#"candidate execution Record") }
      cell { text "See the memory model." }
    ]
    row [
      cell { field [[KeptAlive]] }
      cell { ty (list<Object | Symbol>) }
      cell { text "Initially a new empty List, representing the list of objects and/or symbols to be kept alive until the end of the current Job" }
    ]
    row [
      cell { field [[ModuleAsyncEvaluationCount]] }
      cell { ty (integer) }
      cell { text "Initially 0, used to assign unique incrementing values to the [[AsyncEvaluationOrder]] field of modules that are asynchronous or have asynchronous dependencies." }
    ]
    row [
      cell { field [[GlobalSymbolRegistry]] }
      cell { ty (list<#"GlobalSymbolRegistry Record">) }
      cell { text "Initially a new empty List, representing the list of Symbol values produced by <emu-xref href=\"#sec-symbol.for\">Symbol.for</emu-xref>." }
    ]
  ]
}

