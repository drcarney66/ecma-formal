table t"table-well-known-symbols" @sec-well-known-symbols#0 {
  kind data
  thead true
  vars []
  rows [
    row [
      cell { text "Specification Name" }
      cell { text "[[Description]]" }
      cell { text "Value and Purpose" }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.asyncDispose"))) }
      cell { expr ("Symbol.asyncDispose") }
      cell { text "A method that asynchronously performs resource cleanup on an object. Called by AsyncDisposableStack objects and `await using` declarations when evaluation of their containing scope completes." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.asyncIterator"))) }
      cell { expr ("Symbol.asyncIterator") }
      cell { text "A method that returns the default async iterator for an object. Called by the semantics of the `for`-`await`-`of` statement." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.dispose"))) }
      cell { expr ("Symbol.dispose") }
      cell { text "A method that performs explicit resource cleanup on an object. Called by DisposableStack objects, AsyncDisposableStack objects, and `using` declarations when evaluation of their containing scope completes." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.hasInstance"))) }
      cell { expr ("Symbol.hasInstance") }
      cell { text "A method that determines if a constructor object recognizes an object as one of the constructor's instances. Called by the semantics of the `instanceof` operator." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.isConcatSpreadable"))) }
      cell { expr ("Symbol.isConcatSpreadable") }
      cell { text "A Boolean valued property that if true indicates that an object should be flattened to its array elements by <emu-xref href=\"#sec-array.prototype.concat\">`Array.prototype.concat`</emu-xref>." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.iterator"))) }
      cell { expr ("Symbol.iterator") }
      cell { text "A method that returns the default iterator for an object. Called by the semantics of the for-of statement." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.match"))) }
      cell { expr ("Symbol.match") }
      cell { text "A regular expression method that matches the regular expression against a string. Called by the <emu-xref href=\"#sec-string.prototype.match\">`String.prototype.match`</emu-xref> method." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.matchAll"))) }
      cell { expr ("Symbol.matchAll") }
      cell { text "A regular expression method that returns an iterator that yields matches of the regular expression against a string. Called by the <emu-xref href=\"#sec-string.prototype.matchall\">`String.prototype.matchAll`</emu-xref> method." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.replace"))) }
      cell { expr ("Symbol.replace") }
      cell { text "A regular expression method that replaces matched substrings of a string. Called by the <emu-xref href=\"#sec-string.prototype.replace\">`String.prototype.replace`</emu-xref> method." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.search"))) }
      cell { expr ("Symbol.search") }
      cell { text "A regular expression method that returns the index within a string that matches the regular expression. Called by the <emu-xref href=\"#sec-string.prototype.search\">`String.prototype.search`</emu-xref> method." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.species"))) }
      cell { expr ("Symbol.species") }
      cell { text "A function valued property that is the constructor function that is used to create derived objects." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.split"))) }
      cell { expr ("Symbol.split") }
      cell { text "A regular expression method that splits a string at the indices that match the regular expression. Called by the <emu-xref href=\"#sec-string.prototype.split\">`String.prototype.split`</emu-xref> method." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.toPrimitive"))) }
      cell { expr ("Symbol.toPrimitive") }
      cell { text "A method that converts an object to a corresponding primitive value. Called by the ToPrimitive abstract operation." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.toStringTag"))) }
      cell { expr ("Symbol.toStringTag") }
      cell { text "A String valued property that is used in the creation of the default string description of an object. Accessed by the built-in method <emu-xref href=\"#sec-object.prototype.tostring\">`Object.prototype.toString`</emu-xref>." }
    ]
    row [
      cell { dfn (expr ($WellKnownSymbol("Symbol.unscopables"))) }
      cell { expr ("Symbol.unscopables") }
      cell { text "An object valued property whose own and inherited property names are property names that are excluded from the `with` environment bindings of the associated object." }
    ]
  ]
}

table t"table-white-space-code-points" @sec-white-space#0 {
  kind data
  thead true
  vars []
  rows [
    row [
      cell { text "Code Points" }
      cell { text "Name" }
      cell { text "Abbreviation" }
    ]
    row [
      cell { code (expr (cp(9, "0009", none))) }
      cell { text "CHARACTER TABULATION" }
      cell { text "&lt;TAB>" }
    ]
    row [
      cell { code (expr (cp(11, "000B", none))) }
      cell { text "LINE TABULATION" }
      cell { text "&lt;VT>" }
    ]
    row [
      cell { code (expr (cp(12, "000C", none))) }
      cell { text "FORM FEED (FF)" }
      cell { text "&lt;FF>" }
    ]
    row [
      cell { code (expr (cp(65279, "FEFF", none))) }
      cell { text "ZERO WIDTH NO-BREAK SPACE" }
      cell { text "&lt;ZWNBSP>" }
    ]
    row [
      cell { raw "any code point in general category “Space_Separator”" }
      cell { text "" }
      cell { text "&lt;USP>" }
    ]
  ]
}

table t"table-writesharedmemory-fields" @sec-memory-model-fundamentals#1 {
  kind fields
  thead true
  schema ("WriteSharedMemory Event", false)
  vars []
  rows [
    row [
      cell { text "Field Name" }
      cell { text "Value" }
      cell { text "Meaning" }
    ]
    row [
      cell { field [[Order]] }
      cell { ty (val(~seq-cst~) | val(~unordered~) | val(~init~)) }
      cell { text "The weakest ordering guaranteed by the memory model for the event." }
    ]
    row [
      cell { field [[NoTear]] }
      cell { ty (Boolean) }
      cell { text "Whether this event is allowed to be read from multiple read events with equal memory range as this event." }
    ]
    row [
      cell { field [[Block]] }
      cell { ty (#"Shared Data Block") }
      cell { text "The block the event operates on." }
    ]
    row [
      cell { field [[ByteIndex]] }
      cell { ty (sort [#"non-negative"] integer) }
      cell { text "The byte address of the write in [[Block]]." }
    ]
    row [
      cell { field [[ElementSize]] }
      cell { ty (sort [#"non-negative"] integer) }
      cell { text "The size of the write." }
    ]
    row [
      cell { field [[Payload]] }
      cell { ty (list<#"byte value">) }
      cell { text "The List of byte values to be read by other events." }
    ]
  ]
}

