table t"table-tobigint" @sec-tobigint#0 {
  kind conversion
  thead true
  vars [arg, primitive]
  rows [
    row [
      cell { text "Argument Type" }
      cell { text "Result" }
    ]
    row [
      cell { ty (Undefined) }
      cell { stmt { throw @ph-new-error([[TypeError]]) } }
    ]
    row [
      cell { ty (Null) }
      cell { stmt { throw @ph-new-error([[TypeError]]) } }
    ]
    row [
      cell { ty (Boolean) }
      cell { stmt { return @ph-if-and-if(bign(1), bool(primitive is val {true}), bign(0), bool(primitive is val {false})) } }
    ]
    row [
      cell { ty (BigInt) }
      cell { stmt { return primitive } }
    ]
    row [
      cell { ty (Number) }
      cell { stmt { throw @ph-new-error([[TypeError]]) } }
    ]
    row [
      cell { ty (String) }
      cell { alg @sec-tobigint#1 }
    ]
    row [
      cell { ty (Symbol) }
      cell { stmt { throw @ph-new-error([[TypeError]]) } }
    ]
  ]
}

