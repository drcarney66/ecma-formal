      cell { ty (val(~normal~) | val(~break~) | val(~continue~) | val(~return~) | val(~throw~)) }
      cell { text "The type of completion that occurred." }
    ]
    row [
      cell { field [[Value]] }
      cell { ty (pred(sat @ph-type-except(data sort #"Completion Record"))) }
      cell { text "The value that was produced." }
    ]
    row [
      cell { field [[Target]] }
      cell { ty (String | val(~empty~)) }
      cell { text "The target label for directed control transfers. It must be ~empty~ when [[Type]] is neither ~break~ nor ~continue~." }
    ]
  ]
}

table t"table-controlescape-code-point-values" @sec-patterns-static-semantics-character-value#0 {
  kind data
  thead true
  vars []
  rows [
