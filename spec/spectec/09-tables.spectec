      cell { text "ControlEscape" }
      cell { text "Numeric Value" }
      cell { text "Code Point" }
      cell { text "Unicode Name" }
      cell { text "Symbol" }
    ]
    row [
      cell { expr (code "t") }
      cell { expr (9) }
      cell { code (expr (cp(9, "0009", none))) }
      cell { text "CHARACTER TABULATION" }
      cell { text "&lt;HT>" }
    ]
    row [
      cell { expr (code "n") }
      cell { expr (10) }
      cell { code (expr (cp(10, "000A", none))) }
      cell { text "LINE FEED (LF)" }
      cell { text "&lt;LF>" }
    ]
    row [
      cell { expr (code "v") }
      cell { expr (11) }
      cell { code (expr (cp(11, "000B", none))) }
      cell { text "LINE TABULATION" }
      cell { text "&lt;VT>" }
    ]
    row [
      cell { expr (code "f") }
      cell { expr (12) }
      cell { code (expr (cp(12, "000C", none))) }
      cell { text "FORM FEED (FF)" }
      cell { text "&lt;FF>" }
    ]
    row [
      cell { expr (code "r") }
      cell { expr (13) }
      cell { code (expr (cp(13, "000D", none))) }
      cell { text "CARRIAGE RETURN (CR)" }
      cell { text "&lt;CR>" }
    ]
  ]
}

table t"table-cyclic-module-fields" @sec-cyclic-module-records#0 {
  kind fields
  thead true
  schema ("Cyclic Module Record", true)
  vars []
  rows [
    row [
      cell { text "Field Name" }
      cell { text "Value Type" }
      cell { text "Meaning" }
    ]
    row [
      cell { field [[Status]] }
      cell { ty (val(~new~) | val(~unlinked~) | val(~linking~) | val(~linked~) | val(~evaluating~) | val(~evaluating-async~) | val(~evaluated~)) }
      cell { text "Initially ~new~. Transitions to ~unlinked~, ~linking~, ~linked~, ~evaluating~, possibly ~evaluating-async~, ~evaluated~ (in that order) as the module progresses throughout its lifecycle. ~evaluating-async~ indicates this module is queued to execute on completion of its asynchronous dependencies or it is a module whose [[HasTLA]] field is *true* that has been executed and is pending top-level completion." }
    ]
    row [
      cell { field [[EvaluationError]] }
      cell { ty (#"throw completion" | val(~empty~)) }
      cell { text "A throw completion representing the exception that occurred during evaluation. ~empty~ if no exception occurred or if [[Status]] is not ~evaluated~." }
    ]
    row [
      cell { field [[DFSAncestorIndex]] }
      cell { ty (integer | val(~empty~)) }
      cell { text "Auxiliary field used during Link and Evaluate only. If [[Status]] is either ~linking~ or ~evaluating~, this is either the module's depth-first traversal index or that of an “earlier” module in the same strongly connected component." }
    ]
    row [
      cell { field [[RequestedModules]] }
      cell { ty (list<#"ModuleRequest Record">) }
      cell { text "A List of the ModuleRequest Records associated with the imports in this module. The List is in source text occurrence order of the imports." }
    ]
    row [
      cell { field [[LoadedModules]] }
      cell { ty (list<#"LoadedModuleRequest Record">) }
      cell { text "A map from the specifier strings used by the module represented by this record to request the importation of a module with the relative import attributes to the resolved Module Record. The list does not contain two different Records _r1_ and _r2_ such that ModuleRequestsEqual(_r1_, _r2_) is *true*." }
    ]
    row [
      cell { field [[CycleRoot]] }
      cell { ty (#"Cyclic Module Record" | val(~empty~)) }
      cell { text "The first visited module of the cycle, the root DFS ancestor of the strongly connected component. For a module not in a cycle, this would be the module itself. Once Evaluate has completed, a module's [[DFSAncestorIndex]] is the depth-first traversal index of its [[CycleRoot]]." }
    ]
    row [
      cell { field [[HasTLA]] }
      cell { ty (Boolean) }
      cell { text "Whether this module is individually asynchronous (for example, if it's a Source Text Module Record containing a top-level await). Having an asynchronous dependency does not mean this field is *true*. This field must not change after the module is parsed." }
    ]
    row [
      cell { field [[AsyncEvaluationOrder]] }
      cell { ty (val(~unset~) | integer | val(~done~)) }
      cell { text "This field is initially set to ~unset~, and remains ~unset~ for fully synchronous modules. For modules that are either themselves asynchronous or have an asynchronous dependency, it is set to an integer that determines the order in which execution of pending modules is queued by <emu-xref href=\"#sec-async-module-execution-fulfilled\"></emu-xref>. Once the pending module is successfully executed, the field is set to ~done~." }
    ]
    row [
      cell { field [[TopLevelCapability]] }
      cell { ty (#"PromiseCapability Record" | val(~empty~)) }
      cell { text "If this module is the [[CycleRoot]] of some cycle, and Evaluate() was called on some module in that cycle, this field contains the PromiseCapability Record for that entire evaluation. It is used to settle the Promise object that is returned from the Evaluate() abstract method. This field will be ~empty~ for any dependencies of that module, unless a top-level Evaluate() has been initiated for some of those dependencies." }
    ]
    row [
      cell { field [[AsyncParentModules]] }
      cell { ty (list<#"Cyclic Module Record">) }
      cell { text "If this module or a dependency has [[HasTLA]] *true*, and execution is in progress, this tracks the parent importers of this module for the top-level execution job. These parent modules will not start executing before this module has successfully completed execution." }
    ]
    row [
      cell { field [[PendingAsyncDependencies]] }
      cell { ty (integer | val(~empty~)) }
      cell { text "If this module has any asynchronous dependencies, this tracks the number of asynchronous dependency modules remaining to execute for this module. A module with asynchronous dependencies will be executed when this field reaches 0 and there are no execution errors." }
    ]
  ]
}

table t"table-cyclic-module-methods" @sec-cyclic-module-records#1 {
  kind abstract_methods
  thead true
  vars [capability]
  rows [
    row [
      cell { text "Method" }
      cell { text "Purpose" }
      cell { text "Definitions" }
    ]
    row [
      cell { sig (method InitializeEnvironment () -> completion<val(~unused~)> | #"throw completion") }
      cell { text "It initializes the Environment Record of the module, including resolving all imported bindings, and creates the module's execution context." }
      cell { text "Within this specification it has definitions in the following types; hosts may provide additional types with their own definitions:\n<emu-concrete-method-dfns for=\"InitializeEnvironment\"></emu-concrete-method-dfns>" }
    ]
    row [
      cell { sig (method ExecuteModule (capability: #"PromiseCapability Record" opt) -> completion<val(~unused~)> | #"throw completion") }
      cell { text "It evaluates the module's code within its execution context. If this module has *true* in [[HasTLA]], then a PromiseCapability Record is passed as an argument, and the method is expected to resolve or reject the given capability. In this case, the method must not throw an exception, but instead reject the PromiseCapability Record if necessary." }
      cell { text "Within this specification it has definitions in the following types; hosts may provide additional types with their own definitions:\n<emu-concrete-method-dfns for=\"ExecuteModule\"></emu-concrete-method-dfns>" }
    ]
  ]
}

