      cell { code (expr (math(hex(9, "0009")))) }
      cell { text "CHARACTER TABULATION" }
      cell { text "&lt;HT>" }
    ]
    row [
      cell { expr (code "\\n") }
      cell { code (expr (math(hex(10, "000A")))) }
      cell { text "LINE FEED (LF)" }
      cell { text "&lt;LF>" }
    ]
    row [
      cell { expr (code "\\v") }
      cell { code (expr (math(hex(11, "000B")))) }
      cell { text "LINE TABULATION" }
      cell { text "&lt;VT>" }
    ]
    row [
      cell { expr (code "\\f") }
      cell { code (expr (math(hex(12, "000C")))) }
      cell { text "FORM FEED (FF)" }
      cell { text "&lt;FF>" }
    ]
    row [
      cell { expr (code "\\r") }
      cell { code (expr (math(hex(13, "000D")))) }
      cell { text "CARRIAGE RETURN (CR)" }
      cell { text "&lt;CR>" }
    ]
    row [
      cell { expr (code "\\\"") }
      cell { code (expr (math(hex(34, "0022")))) }
      cell { text "QUOTATION MARK" }
      cell { text "`\"`" }
    ]
    row [
      cell { expr (code "\\'") }
      cell { code (expr (math(hex(39, "0027")))) }
      cell { text "APOSTROPHE" }
      cell { text "`'`" }
    ]
    row [
      cell { expr (code "\\\\") }
      cell { code (expr (math(hex(92, "005C")))) }
      cell { text "REVERSE SOLIDUS" }
      cell { text "`\\\\`" }
    ]
  ]
}

