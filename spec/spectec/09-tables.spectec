      cell { expr (null) }
      cell { expr ("*default*") }
    ]
    row [
      cell { expr (code "export default 42;") }
      cell { expr ("default") }
      cell { expr (null) }
      cell { expr (null) }
      cell { expr ("*default*") }
    ]
    row [
