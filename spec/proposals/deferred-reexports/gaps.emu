<emu-clause id="sec-static-semantics-importentriesformodule" type="sdo">
  <emu-grammar>ImportSpecifier : ModuleExportName</emu-grammar>
  <emu-alg>
    1. Let _localName_ be <del> the</del><ins>the</ins> StringValue of |ModuleExportName|.
    1. Let _entry_ be the ImportEntry Record { [[ModuleRequest]]: _module_, [[ImportName]]: _localName_, [[LocalName]]: _localName_, [[NamespaceNamesFilter]]: ~empty~ }.
    1. Return « _entry_ ».
  </emu-alg>
</emu-clause>
<emu-clause id="sec-DirectImportedNames" type="sdo">
  <emu-grammar>ImportSpecifier : ModuleExportName</emu-grammar>
  <emu-alg>
    1. Let _importedName_ be the StringValue of <del> |ModuleExportName|</del><ins>|ModuleExportName|</ins>.
    1. Return « _importedName_ ».
  </emu-alg>
</emu-clause>
