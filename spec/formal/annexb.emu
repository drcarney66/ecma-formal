    </emu-alg>
  </emu-reading>
  <emu-reading id="row-contains-if-function" clause="sec-static-semantics-contains" grammar-clause="sec-functiondeclarations-in-ifstatement-statement-clauses" grammar="IfStatement :
      `if` `(` Expression `)` FunctionDeclaration `else` Statement
      `if` `(` Expression `)` Statement `else` FunctionDeclaration
      `if` `(` Expression `)` FunctionDeclaration `else` FunctionDeclaration
