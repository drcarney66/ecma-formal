<emu-clause id="formal-tables">
  <h1>Table Lookups</h1>
  <p>The specification's tables as data: a value in a column of the row a key selects.</p>

  <emu-primitive id="prim-tablerowvalue" name="TableRowValue">
    <emu-signature>TableRowValue(_t_: a table, _valueColumn_: a String, _key_: anything): anything</emu-signature>
    <p>The entry in the column of _t_ headed _valueColumn_ of the row "for _key_": the row whose entry in _t_'s first column, which names its rows, is _key_ (TableLookup(_t_, _valueColumn_, the first column's heading, _key_)). An entry of several lines is _key_ if one of its lines is. _t_ has such a row.</p>
  </emu-primitive>

  <emu-primitive id="prim-tableassociated" name="TableAssociated">
    <emu-signature>TableAssociated(_t_: a table, _key_: anything): anything</emu-signature>
    <p>The value associated with _key_ in _t_, a step's table of two columns ("the abstract operation associated with _key_ in the following table"): the entry in the second column of the row whose entry in the first column is _key_. A sequence of Unicode code points _key_ is the entry written in code as those code points. _t_ has such a row.</p>
  </emu-primitive>

  <emu-phrase id="ph-cu-table" kind="expression" rule="cu-table">
    <emu-pattern>the code unit whose numeric value is determined by _c_ according to _t_</emu-pattern>
    <p>_t_'s rows are escape sequences, each a backslash and one character; _c_ is that character (a |SingleEscapeCharacter|, one code point), so its row is the one whose “Escape Sequence” entry is a backslash followed by the code point _c_ matches.</p>
    <emu-params>_c_: a Parse Node, _t_: a table</emu-params>
    <emu-alg>
      1. Let _e_ be the string-concatenation of 0x005C (REVERSE SOLIDUS) and UTF16EncodeCodePoint(the code point matched by _c_).
      1. Return TableLookup(_t_, *"Code Unit Value"*, *"Escape Sequence"*, _e_).
    </emu-alg>
  </emu-phrase>
  <emu-phrase id="ph-intrinsic-assoc" kind="expression" rule="intrinsic-assoc" literals="spelled">
    <emu-pattern>the intrinsic object associated with the constructor name _n_ in _t_</emu-pattern>
    <p>_t_'s first column is headed “Constructor Name and Intrinsic” (table-the-typedarray-constructors): each entry is a constructor name, then its intrinsic on a second line.</p>
    <emu-params>_n_: a String, _t_: a table</emu-params>
    <emu-alg>
      1. Return TableRowValue(_t_, *"Intrinsic"*, _n_).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-typedarray-constructor-name" kind="expression">
    <emu-pattern>the String value of the Constructor Name value specified in <emu-xref href="#table-the-typedarray-constructors"></emu-xref> for this <var>TypedArray</var> constructor</emu-pattern>
    <p>This _TypedArray_ constructor is the active function object, the intrinsic its row lists on the second line of its “Constructor Name and Intrinsic” entry; the Constructor Name is the first line, a String.</p>
    <emu-alg>
      1. Return TableRowValue(<emu-xref href="#table-the-typedarray-constructors"></emu-xref>, *"Constructor Name"*, the active function object).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-name-of-entry" kind="expression" rule="name-of-entry">
    <emu-pattern>the Name of the entry in _t_ whose _column_ = _k_</emu-pattern>
    <p>The entry in _t_'s “Name” column of the row whose entry in the column headed _column_ is _k_.</p>
    <emu-params>_t_: a table, _column_: a String, _k_: anything</emu-params>
    <emu-alg>
      1. Return TableLookup(_t_, *"Name"*, _column_, _k_).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-listed-in-column" kind="predicate" subject="_x_" rule="listed-in-column-bare">
    <emu-pattern>is listed in the “_column_” column of _t_</emu-pattern>
    <emu-params>_column_: a String, _t_: a table, _x_: anything</emu-params>
    <emu-alg>
      1. Return TableColumnHas(_t_, _column_, _x_).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-tn-listed-in-column" kind="predicate" subject="_x_" rule="listed-in-column-tn" alternatives="all">
    <emu-pattern>is a _tn_ listed in the “_column_” column of _t_</emu-pattern>
    <p>"a" and "an" are one article; _tn_ names the sort of _x_.</p>
    <emu-params>_tn_: a type, _column_: a String, _t_: a table, _x_: anything</emu-params>
    <emu-alg>
      1. If _x_ is not a _tn_, return *false*.
      1. Return TableColumnHas(_t_, _column_, _x_).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-listed-property-name" kind="predicate" subject="_p_" rule="listed-property-name">
    <emu-pattern>is a <emu-not-ref>Unicode property name</emu-not-ref> listed in the “<emu-not-ref>Property name</emu-not-ref>” column of _t_</emu-pattern>
    <p>The table's entries are code text; _p_ is listed when the String of its code points is one of them.</p>
    <emu-params>_t_: a table, _p_: ECMAScript source text</emu-params>
    <emu-alg>
      1. Return TableColumnHas(_t_, *"Property name"*, CodePointsToString(_p_)).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-listed-property-name-or-alias" kind="predicate" subject="_p_" rule="listed-property-name-or-alias">
    <emu-pattern>is a <emu-not-ref>Unicode property name</emu-not-ref> or property alias listed in the “<emu-not-ref>Property name and aliases</emu-not-ref>” column of _t_</emu-pattern>
    <p>An entry lists a property name and its aliases, one per line.</p>
    <emu-params>_t_: a table, _p_: ECMAScript source text</emu-params>
    <emu-alg>
      1. Return TableColumnHas(_t_, *"Property name and aliases"*, CodePointsToString(_p_)).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-not-listed-property-name-or-alias" kind="predicate" subject="_p_">
    <emu-pattern>is not a <emu-not-ref>Unicode property name</emu-not-ref> or property alias listed in the “<emu-not-ref>Property name and aliases</emu-not-ref>” column of _t_</emu-pattern>
    <emu-params>_t_: a table, _p_: ECMAScript source text</emu-params>
    <emu-alg>
      1. If TableColumnHas(_t_, *"Property name and aliases"*, CodePointsToString(_p_)) is *true*, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-listed-property-name-or-alias-either" kind="predicate" subject="_p_" rule="listed-property-name-or-alias-either">
    <emu-pattern>is a <emu-not-ref>Unicode property name</emu-not-ref> or property alias listed in the “<emu-not-ref>Property name and aliases</emu-not-ref>” column of _t_ or _u_</emu-pattern>
    <emu-params>_t_: a table, _u_: a table, _p_: ECMAScript source text</emu-params>
    <emu-alg>
      1. If TableColumnHas(_t_, *"Property name and aliases"*, CodePointsToString(_p_)) is *true*, return *true*.
      1. Return TableColumnHas(_u_, *"Property name and aliases"*, CodePointsToString(_p_)).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-listed-binary-property-or-of-strings" kind="predicate" subject="_p_" rule="listed-binary-property-or-of-strings">
    <emu-pattern>is a binary Unicode property or binary property alias listed in the “<emu-not-ref>Property name and aliases</emu-not-ref>” column of _t_, or a binary Unicode property of strings listed in the “<emu-not-ref>Property name</emu-not-ref>” column of _u_</emu-pattern>
    <emu-params>_t_: a table, _u_: a table, _p_: ECMAScript source text</emu-params>
    <emu-alg>
      1. If TableColumnHas(_t_, *"Property name and aliases"*, CodePointsToString(_p_)) is *true*, return *true*.
      1. Return TableColumnHas(_u_, *"Property name"*, CodePointsToString(_p_)).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-listed-canonical-property-name" kind="predicate" subject="_p_" rule="listed-canonical-property-name">
    <emu-pattern>is a canonical, unaliased <emu-not-ref>Unicode property name</emu-not-ref> listed in the “<emu-not-ref>Canonical property name</emu-not-ref>” column of _t_</emu-pattern>
    <p>The column holds only canonical names.</p>
    <emu-params>_t_: a table, _p_: ECMAScript source text</emu-params>
    <emu-alg>
      1. Return TableColumnHas(_t_, *"Canonical property name"*, CodePointsToString(_p_)).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-listed-binary-property-of-strings" kind="predicate" subject="_p_" rule="listed-binary-property-of-strings">
    <emu-pattern>is a binary property of strings listed in the “<emu-not-ref>Property name</emu-not-ref>” column of _t_</emu-pattern>
    <emu-params>_t_: a table, _p_: ECMAScript source text</emu-params>
    <emu-alg>
      1. Return TableColumnHas(_t_, *"Property name"*, CodePointsToString(_p_)).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-has-all-slots" kind="predicate" subject="_o_" rule="has-all-slots-has" alternatives="all">
    <emu-pattern>has all of the internal slots of _k_ (_c_)</emu-pattern>
    <p>The internal slots are those the referenced clause's table lists; _k_ names the kind of object it describes. "see" before the reference changes nothing.</p>
    <emu-params>_k_: a type, _c_: a clause, _o_: an Object</emu-params>
    <emu-alg>
      1. Return HasSlots(SlotsListed(_c_), _o_).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-not-has-all-slots" kind="predicate" subject="_o_" rule="has-all-slots-not" alternatives="all">
    <emu-pattern>does not have all of the internal slots of _k_ (see _c_)</emu-pattern>
    <p>The negation of having all of the internal slots the referenced clause's table lists. "see" before the reference changes nothing.</p>
    <emu-params>_k_: a type, _c_: a clause, _o_: an Object</emu-params>
    <emu-alg>
      1. If HasSlots(SlotsListed(_c_), _o_) is *true*, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-reading clause="sec-encodeforregexpescape" steps="2.a" hashes="cb6d04ae11e3f7507b6eaff5d8710127c865f243ba7c95f61ff4b1d700789659">
    <emu-alg reading="definition">
      1. Return the string-concatenation of 0x005C (REVERSE SOLIDUS) and the ControlEscape value specified in <emu-xref href="#table-controlescape-code-point-values"></emu-xref> for Code Point _codePoint_.
    </emu-alg>
  </emu-reading>

  <emu-reading clause="sec-patterns-static-semantics-character-value" steps="1" hashes="8bbb733a4f94fdae385a6c30e48d182f205fde9f5e45750676471d5b4a8ade32">
    <emu-alg reading="definition">
      1. Return TableLookup(<emu-xref href="#table-controlescape-code-point-values"></emu-xref>, *"Numeric Value"*, *"ControlEscape"*, CodePointsToString(the source text matched by |ControlEscape|)).
    </emu-alg>
    <emu-note>
      <p>The row is the one whose ControlEscape entry is the matched |ControlEscape|.</p>
    </emu-note>
  </emu-reading>

  <emu-reading clause="sec-runtime-semantics-unicodematchproperty-p" steps="3" hashes="837c23031d678d80d39f67a04777aaa020c5dd715b6154e00482ddee50eec0e6">
    <emu-alg reading="definition">
      1. If _p_ is a <emu-not-ref>Unicode property name</emu-not-ref> or property alias listed in the “<emu-not-ref>Property name and aliases</emu-not-ref>” column of <emu-xref href="#table-nonbinary-unicode-properties"></emu-xref>, let _t_ be <emu-xref href="#table-nonbinary-unicode-properties"></emu-xref>; else let _t_ be <emu-xref href="#table-binary-unicode-properties"></emu-xref>.
      1. Let _c_ be TableLookup(_t_, *"Canonical property name"*, *"Property name and aliases"*, CodePointsToString(_p_)).
    </emu-alg>
    <emu-note>
      <p>The corresponding row is the one of step 2's tables that lists _p_.</p>
    </emu-note>
  </emu-reading>

  <emu-reading clause="sec-runtime-semantics-unicodematchpropertyvalue-p-v" steps="3" hashes="12f1159daa1516123a8c5fbd602b7f1a6bfb6258e4e9779bfbbf94ef9a426bec">
    <emu-alg reading="definition">
      1. Let _value_ be CanonicalPropertyValue(_p_, _v_).
    </emu-alg>
    <emu-note>
      <p>The corresponding row is the row of PropertyValueAliases.txt for _p_ that lists _v_ (step 2); its canonical property value is its long name (<emu-xref href="#prim-canonicalpropertyvalue"></emu-xref>).</p>
    </emu-note>
  </emu-reading>
</emu-clause>
