<emu-clause id="formal-sorts">
  <h1>Data Sorts</h1>
  <p>The sorts that operation headers and steps name, each with its test on a value: a primitive, an operation, steps over _v_, or none (residue).</p>

  <emu-primitive id="prim-isnonterminal" name="IsNonterminal">
    <emu-signature>IsNonterminal(_v_: anything): a Boolean</emu-signature>
    <p>Whether _v_ is a nonterminal symbol of one of the ECMAScript grammars (<emu-xref href="#sec-context-free-grammars"></emu-xref>).</p>
  </emu-primitive>

  <emu-primitive id="prim-isgrammarsymbol" name="IsGrammarSymbol">
    <emu-signature>IsGrammarSymbol(_v_: anything): a Boolean</emu-signature>
    <p>Whether _v_ is a terminal or nonterminal symbol of one of the ECMAScript grammars (<emu-xref href="#sec-context-free-grammars"></emu-xref>).</p>
  </emu-primitive>

  <emu-primitive id="prim-isinternalslotname" name="IsInternalSlotName">
    <emu-signature>IsInternalSlotName(_v_: anything): a Boolean</emu-signature>
    <p>Whether _v_ is a name enclosed in double square brackets [[ ]] that identifies an internal slot (<emu-xref href="#sec-object-internal-methods-and-internal-slots"></emu-xref>).</p>
  </emu-primitive>

  <emu-primitive id="prim-isagentsignifier" name="IsAgentSignifier">
    <emu-signature>IsAgentSignifier(_v_: anything): a Boolean</emu-signature>
    <p>Whether _v_ is an agent signifier, the globally-unique opaque value that identifies an agent (<emu-xref href="#sec-agents"></emu-xref>).</p>
  </emu-primitive>

  <emu-primitive id="prim-propertyiskind" name="PropertyIsKind">
    <emu-signature>PropertyIsKind(_p_: an own property, _kind_: ~data~ or ~accessor~): a Boolean</emu-signature>
    <p>Whether _p_ is a _kind_ property: a data property or an accessor property (<emu-xref href="#sec-object-type"></emu-xref>).</p>
  </emu-primitive>

  <emu-primitive id="prim-closurekind" name="ClosureKind">
    <emu-signature>ClosureKind(_c_: anything, _kind_: ~job~, ~matcher~, ~matcher-continuation~, or ~read-modify-write~): a Boolean</emu-signature>
    <p>Whether _c_ is an Abstract Closure made by a step "a new Job Abstract Closure", "a new Matcher", "a new MatcherContinuation" or "a new read-modify-write modification function" (by _kind_) "with parameters … when called" (<emu-xref href="#sec-abstract-closure"></emu-xref>).</p>
  </emu-primitive>

  <emu-primitive id="prim-isdatablock" name="IsDataBlock">
    <emu-signature>IsDataBlock(_v_: anything): a Boolean</emu-signature>
    <p>Whether _v_ is a Data Block that is not a Shared Data Block (<emu-xref href="#sec-data-blocks"></emu-xref>).</p>
  </emu-primitive>

  <emu-primitive id="prim-isshareddatablock" name="IsSharedDataBlock">
    <emu-signature>IsSharedDataBlock(_v_: anything): a Boolean</emu-signature>
    <p>Whether _v_ is a Shared Data Block (<emu-xref href="#sec-data-blocks"></emu-xref>).</p>
  </emu-primitive>

  <emu-primitive id="prim-ischarset" name="IsCharSet">
    <emu-signature>IsCharSet(_v_: anything): a Boolean</emu-signature>
    <p>Whether _v_ is a CharSet (<emu-xref href="#sec-pattern-notation"></emu-xref>).</p>
  </emu-primitive>

  <emu-phrase id="ph-not-internal-method-defined-in" kind="predicate" subject="_m_" meaning="not IsOrdinaryMethod(_m_, _definition_)">
    <emu-pattern>is not the internal method defined in _definition_</emu-pattern>
  </emu-phrase>

  <!-- Records -->

  <emu-sort name="Environment Record" record clause="sec-environment-records">
    <p>Abstract class; its values are the Records of its concrete subclasses.</p>
  </emu-sort>

  <emu-sort name="Declarative Environment Record" super="Environment Record" record clause="sec-declarative-environment-records"></emu-sort>

  <emu-sort name="Object Environment Record" super="Environment Record" record clause="sec-object-environment-records"></emu-sort>

  <emu-sort name="Function Environment Record" super="Declarative Environment Record" record clause="sec-function-environment-records"></emu-sort>

  <emu-sort name="Global Environment Record" super="Environment Record" record clause="sec-global-environment-records"></emu-sort>

  <emu-sort name="Module Environment Record" super="Declarative Environment Record" record clause="sec-module-environment-records"></emu-sort>

  <emu-sort name="PrivateEnvironment Record" record clause="sec-privateenvironment-records"></emu-sort>

  <emu-sort name="Reference Record" record clause="sec-reference-record-specification-type"></emu-sort>

  <emu-sort name="Super Reference Record" super="Reference Record" clause="sec-reference-record-specification-type">
    <p>A Reference Record whose [[ThisValue]] is not ~empty~ (Table: Reference Record Fields, [[ThisValue]]).</p>
    <emu-alg>
      1. If _v_ is not a Reference Record, return *false*.
      1. Return IsSuperReference(_v_).
    </emu-alg>
  </emu-sort>

  <emu-sort name="Private Name" record clause="sec-private-names">
    <p>A globally unique value with an immutable [[Description]]; "a new Private Name whose [[Description]] is _d_" makes a Record of this kind.</p>
  </emu-sort>

  <emu-sort name="PrivateElement" record clause="sec-privateelement-specification-type"></emu-sort>

  <emu-sort name="ClassFieldDefinition Record" record clause="sec-classfielddefinition-record-specification-type"></emu-sort>

  <emu-sort name="ClassStaticBlockDefinition Record" record clause="sec-classstaticblockdefinition-record-specification-type"></emu-sort>

  <emu-sort name="Iterator Record" record clause="sec-iterator-records"></emu-sort>

  <emu-sort name="DisposableResource Record" record clause="sec-disposableresource-records"></emu-sort>

  <emu-sort name="Realm Record" record clause="sec-code-realms"></emu-sort>

  <emu-sort name="Property Descriptor" record clause="sec-property-descriptor-specification-type"></emu-sort>

  <emu-sort name="PropertyDescriptor" super="Property Descriptor" record clause="sec-property-descriptor-specification-type">
    <p>The schema name that tags literal descriptions of Property Descriptor records: a Record literal "PropertyDescriptor { … }" is a Property Descriptor.</p>
  </emu-sort>

  <emu-sort name="execution context" record clause="sec-execution-contexts">
    <p>A specification device with the state components of <emu-xref href="#table-state-components-for-all-execution-contexts"></emu-xref>; made by "a new execution context".</p>
  </emu-sort>

  <emu-sort name="ECMAScript code execution context" super="execution context" record clause="sec-execution-contexts">
    <p>An execution context with the additional state components of <emu-xref href="#table-additional-state-components-for-ecmascript-code-execution-contexts"></emu-xref>; made by "a new ECMAScript code execution context".</p>
  </emu-sort>

  <emu-sort name="JobCallback Record" record clause="sec-jobcallback-records"></emu-sort>

  <emu-sort name="Script Record" record clause="sec-script-records"></emu-sort>

  <emu-sort name="Module Record" record clause="sec-abstract-module-records">
    <p>Abstract class; 'values of the Record specification type'.</p>
  </emu-sort>

  <emu-sort name="Cyclic Module Record" super="Module Record" record clause="sec-cyclic-module-records"></emu-sort>

  <emu-sort name="Source Text Module Record" super="Cyclic Module Record" record clause="sec-source-text-module-records"></emu-sort>

  <emu-sort name="Synthetic Module Record" super="Module Record" record clause="sec-synthetic-module-records"></emu-sort>

  <emu-sort name="ResolvedBinding Record" record clause="sec-abstract-module-records"></emu-sort>

  <emu-sort name="ModuleRequest Record" record clause="sec-modulerequest-record"></emu-sort>

  <emu-sort name="LoadedModuleRequest Record" record clause="sec-modulerequest-record"></emu-sort>

  <emu-sort name="ImportAttribute Record" record clause="sec-modulerequest-record"></emu-sort>

  <emu-sort name="ImportEntry Record" record clause="sec-source-text-module-records"></emu-sort>

  <emu-sort name="ExportEntry Record" record clause="sec-source-text-module-records"></emu-sort>

  <emu-sort name="GraphLoadingState Record" record clause="sec-cyclic-module-records"></emu-sort>

  <emu-sort name="PromiseCapability Record" record clause="sec-promisecapability-records"></emu-sort>

  <emu-sort name="PromiseReaction Record" record clause="sec-promisereaction-records"></emu-sort>

  <emu-sort name="TypedArray With Buffer Witness Record" record clause="sec-typedarray-with-buffer-witness-records"></emu-sort>

  <emu-sort name="DataView With Buffer Witness Record" record clause="sec-dataview-with-buffer-witness-records"></emu-sort>

  <emu-sort name="Time Zone Identifier Record" record clause="sec-time-zone-identifier-record"></emu-sort>

  <emu-sort name="MatchState" record clause="sec-pattern-notation"></emu-sort>

  <emu-sort name="RegExp Record" record clause="sec-regexp-records"></emu-sort>

  <emu-sort name="Match Record" record clause="sec-match-records"></emu-sort>

  <emu-sort name="Set Record" record clause="sec-set-records"></emu-sort>

  <emu-sort name="WaiterList Record" record clause="sec-waiterlist-records"></emu-sort>

  <emu-sort name="Waiter Record" record clause="sec-waiter-record"></emu-sort>

  <emu-sort name="JSON Parse Record" record clause="sec-json-parse-record"></emu-sort>

  <emu-sort name="JSON Serialization Record" record clause="sec-json-serialization-record"></emu-sort>

  <emu-sort name="Agent Record" record clause="sec-agents"></emu-sort>

  <emu-sort name="Agent Events Record" record clause="sec-agent-event-records"></emu-sort>

  <emu-sort name="candidate execution" record clause="sec-candidate-executions"></emu-sort>

  <emu-sort name="Memory event" record clause="sec-memory-model-fundamentals">
    <p>A Shared Data Block event, a Synchronize event, or a host-specific event.</p>
  </emu-sort>

  <emu-sort name="Shared Data Block event" super="Memory event" record clause="sec-memory-model-fundamentals">
    <p>Either a ReadSharedMemory, WriteSharedMemory, or ReadModifyWriteSharedMemory Record.</p>
  </emu-sort>

  <emu-sort name="ReadSharedMemory" super="Shared Data Block event" record clause="sec-memory-model-fundamentals"></emu-sort>

  <emu-sort name="WriteSharedMemory" super="Shared Data Block event" record clause="sec-memory-model-fundamentals"></emu-sort>

  <emu-sort name="WriteSharedMemory event" super="Shared Data Block event" clause="sec-memory-model-fundamentals">
    <p>The text's name for a WriteSharedMemory Record.</p>
    <emu-alg>
      1. If _v_ is a WriteSharedMemory, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="ReadModifyWriteSharedMemory" super="Shared Data Block event" record clause="sec-memory-model-fundamentals">
    <p>The Records the literal ReadModifyWriteSharedMemory { … } makes; the text's "ReadModifyWriteSharedMemory event" is a variant of this name.</p>
  </emu-sort>

  <emu-sort name="Synchronize event" super="Memory event" record clause="sec-memory-model-fundamentals">
    <p>Has no fields; made by "a new Synchronize event".</p>
  </emu-sort>

  <emu-sort name="continue completion" super="Completion Record" clause="sec-completion-record-specification-type">
    <p>Any Completion Record with a [[Type]] value of ~continue~.</p>
    <emu-alg>
      1. If _v_ is not a Completion Record, return *false*.
      1. If _v_.[[Type]] is ~continue~, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="break completion" super="Completion Record" clause="sec-completion-record-specification-type">
    <p>Any Completion Record with a [[Type]] value of ~break~.</p>
    <emu-alg>
      1. If _v_ is not a Completion Record, return *false*.
      1. If _v_.[[Type]] is ~break~, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="implementation-defined Completion Record" super="Completion Record" clause="sec-debugger-statement-runtime-semantics-evaluation">
    <p>A Completion Record whose content the implementation chooses: as a test, any Completion Record.</p>
    <emu-alg>
      1. If _v_ is a Completion Record, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="fully" clause="sec-property-descriptor-specification-type">
    <p>As in fully populated Property Descriptor: an accessor or a data Property Descriptor that has all of the corresponding fields of <emu-xref href="#table-object-property-attributes"></emu-xref>. "populated" carries no test of its own.</p>
    <emu-alg>
      1. If _v_ is not a Property Descriptor, return *false*.
      1. If IsAccessorDescriptor(_v_) is *true*, then
        1. If _v_ has a [[Getter]] field, _v_ has a [[Setter]] field, _v_ has an [[Enumerable]] field, and _v_ has a [[Configurable]] field, return *true*.
        1. Return *false*.
      1. If IsDataDescriptor(_v_) is *true*, then
        1. If _v_ has a [[Value]] field, _v_ has a [[Writable]] field, _v_ has an [[Enumerable]] field, and _v_ has a [[Configurable]] field, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="populated" clause="sec-property-descriptor-specification-type">
    <p>Only in "fully populated"; the definition is the test of "fully".</p>
    <emu-alg>
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <!-- Objects -->

  <emu-sort name="object" super="ECMAScript language value" clause="sec-object-type">
    <p>The plain word: a value of the Object type.</p>
    <emu-alg>
      1. If _v_ is an Object, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="function object" super="Object" clause="sec-object-internal-methods-and-internal-slots">
    <p>An object that supports the [[Call]] internal method.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ has a [[Call]] internal method, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="constructor" super="function object" clause="sec-object-internal-methods-and-internal-slots">
    <p>An object that supports the [[Construct]] internal method; every constructor is a function object.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ has a [[Construct]] internal method, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="ordinary" super="Object" clause="sec-object-internal-methods-and-internal-slots">
    <p>An ordinary object: the three criteria of the dfn ordinary-object.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_.[[GetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-getprototypeof"></emu-xref>, return *false*.
      1. If _v_.[[SetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-setprototypeof-v"></emu-xref>, return *false*.
      1. If _v_.[[IsExtensible]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-isextensible"></emu-xref>, return *false*.
      1. If _v_.[[PreventExtensions]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-preventextensions"></emu-xref>, return *false*.
      1. If _v_.[[GetOwnProperty]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-getownproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[DefineOwnProperty]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-defineownproperty-p-desc"></emu-xref>, return *false*.
      1. If _v_.[[HasProperty]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-hasproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[Get]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-get-p-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Set]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-set-p-v-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Delete]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-delete-p"></emu-xref>, return *false*.
      1. If _v_.[[OwnPropertyKeys]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-ownpropertykeys"></emu-xref>, return *false*.
      1. If _v_ has a [[Call]] internal method, then
        1. If _v_.[[Call]] is not the internal method defined in <emu-xref href="#sec-ecmascript-function-objects-call-thisargument-argumentslist"></emu-xref> and _v_.[[Call]] is not the internal method defined in <emu-xref href="#sec-built-in-function-objects-call-thisargument-argumentslist"></emu-xref>, return *false*.
      1. If _v_ has a [[Construct]] internal method, then
        1. If _v_.[[Construct]] is not the internal method defined in <emu-xref href="#sec-ecmascript-function-objects-construct-argumentslist-newtarget"></emu-xref> and _v_.[[Construct]] is not the internal method defined in <emu-xref href="#sec-built-in-function-objects-construct-argumentslist-newtarget"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="extensible" super="Object" clause="sec-ordinary-object-internal-methods-and-internal-slots">
    <p>As it applies to objects: its [[Extensible]] internal slot is *true*. For an object without that slot the test is residue.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have an [[Extensible]] internal slot, return whether _v_ has not been observed to return *false* from its [[IsExtensible]] internal method or *true* from its [[PreventExtensions]] internal method.
      1. Return _v_.[[Extensible]].
    </emu-alg>
  </emu-sort>

  <emu-sort name="ECMAScript function object" super="function object" clause="sec-ecmascript-function-objects">
    <p>An ordinary function object whose [[Call]] internal method is the one OrdinaryFunctionCreate installs (10.2.1).</p>
    <emu-alg>
      1. If _v_ is not an ordinary object, return *false*.
      1. If IsCallable(_v_) is *false*, return *false*.
      1. If _v_.[[Call]] is not the internal method defined in <emu-xref href="#sec-ecmascript-function-objects-call-thisargument-argumentslist"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="built-in" super="Object" clause="sec-built-in-function-objects">
    <p>As it applies to function objects: a built-in function object is an ordinary object whose [[Call]] internal method conforms to the definition in 10.3.1.</p>
    <emu-alg>
      1. If _v_ is not an ordinary object, return *false*.
      1. If IsCallable(_v_) is *false*, return *false*.
      1. If _v_.[[Call]] is not the internal method defined in <emu-xref href="#sec-built-in-function-objects-call-thisargument-argumentslist"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="bound function exotic object" super="function object" clause="sec-bound-function-exotic-objects">
    <p>Its [[Call]] and (if applicable) [[Construct]] internal methods are those of 10.4.1, and its other essential internal methods those of 10.1.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If IsCallable(_v_) is *false*, return *false*.
      1. If _v_.[[Call]] is not the internal method defined in <emu-xref href="#sec-bound-function-exotic-objects-call-thisargument-argumentslist"></emu-xref>, return *false*.
      1. If _v_ has a [[Construct]] internal method, then
        1. If _v_.[[Construct]] is not the internal method defined in <emu-xref href="#sec-bound-function-exotic-objects-construct-argumentslist-newtarget"></emu-xref>, return *false*.
      1. If _v_.[[GetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-getprototypeof"></emu-xref>, return *false*.
      1. If _v_.[[SetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-setprototypeof-v"></emu-xref>, return *false*.
      1. If _v_.[[IsExtensible]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-isextensible"></emu-xref>, return *false*.
      1. If _v_.[[PreventExtensions]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-preventextensions"></emu-xref>, return *false*.
      1. If _v_.[[GetOwnProperty]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-getownproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[DefineOwnProperty]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-defineownproperty-p-desc"></emu-xref>, return *false*.
      1. If _v_.[[HasProperty]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-hasproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[Get]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-get-p-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Set]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-set-p-v-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Delete]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-delete-p"></emu-xref>, return *false*.
      1. If _v_.[[OwnPropertyKeys]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-ownpropertykeys"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="Array exotic object" super="Object" clause="sec-array-exotic-objects">
    <p>Its [[DefineOwnProperty]] internal method is the one of 10.4.2.1, and its other essential internal methods those of 10.1; it has no [[Call]] or [[Construct]] internal method.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ has a [[Call]] internal method, return *false*.
      1. If _v_ has a [[Construct]] internal method, return *false*.
      1. If _v_.[[GetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-getprototypeof"></emu-xref>, return *false*.
      1. If _v_.[[SetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-setprototypeof-v"></emu-xref>, return *false*.
      1. If _v_.[[IsExtensible]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-isextensible"></emu-xref>, return *false*.
      1. If _v_.[[PreventExtensions]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-preventextensions"></emu-xref>, return *false*.
      1. If _v_.[[GetOwnProperty]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-getownproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[DefineOwnProperty]] is not the internal method defined in <emu-xref href="#sec-array-exotic-objects-defineownproperty-p-desc"></emu-xref>, return *false*.
      1. If _v_.[[HasProperty]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-hasproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[Get]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-get-p-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Set]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-set-p-v-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Delete]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-delete-p"></emu-xref>, return *false*.
      1. If _v_.[[OwnPropertyKeys]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-ownpropertykeys"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="Array" super="Object" clause="sec-array-exotic-objects">
    <p>An Array exotic object ("or simply, an Array").</p>
    <emu-alg>
      1. If _v_ is an Array exotic object, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="String exotic object" super="Object" clause="sec-string-exotic-objects">
    <p>Its [[GetOwnProperty]], [[DefineOwnProperty]], and [[OwnPropertyKeys]] internal methods are those of 10.4.3, and its other essential internal methods those of 10.1; it has no [[Call]] or [[Construct]] internal method.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ has a [[Call]] internal method, return *false*.
      1. If _v_ has a [[Construct]] internal method, return *false*.
      1. If _v_.[[GetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-getprototypeof"></emu-xref>, return *false*.
      1. If _v_.[[SetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-setprototypeof-v"></emu-xref>, return *false*.
      1. If _v_.[[IsExtensible]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-isextensible"></emu-xref>, return *false*.
      1. If _v_.[[PreventExtensions]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-preventextensions"></emu-xref>, return *false*.
      1. If _v_.[[GetOwnProperty]] is not the internal method defined in <emu-xref href="#sec-string-exotic-objects-getownproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[DefineOwnProperty]] is not the internal method defined in <emu-xref href="#sec-string-exotic-objects-defineownproperty-p-desc"></emu-xref>, return *false*.
      1. If _v_.[[HasProperty]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-hasproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[Get]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-get-p-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Set]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-set-p-v-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Delete]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-delete-p"></emu-xref>, return *false*.
      1. If _v_.[[OwnPropertyKeys]] is not the internal method defined in <emu-xref href="#sec-string-exotic-objects-ownpropertykeys"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="arguments exotic object" super="Object" clause="sec-arguments-exotic-objects">
    <p>Its [[GetOwnProperty]], [[DefineOwnProperty]], [[Get]], [[Set]], and [[Delete]] internal methods are those of 10.4.4, and the ones not specified there those of 10.1; it has no [[Call]] or [[Construct]] internal method.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ has a [[Call]] internal method, return *false*.
      1. If _v_ has a [[Construct]] internal method, return *false*.
      1. If _v_.[[GetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-getprototypeof"></emu-xref>, return *false*.
      1. If _v_.[[SetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-setprototypeof-v"></emu-xref>, return *false*.
      1. If _v_.[[IsExtensible]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-isextensible"></emu-xref>, return *false*.
      1. If _v_.[[PreventExtensions]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-preventextensions"></emu-xref>, return *false*.
      1. If _v_.[[GetOwnProperty]] is not the internal method defined in <emu-xref href="#sec-arguments-exotic-objects-getownproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[DefineOwnProperty]] is not the internal method defined in <emu-xref href="#sec-arguments-exotic-objects-defineownproperty-p-desc"></emu-xref>, return *false*.
      1. If _v_.[[HasProperty]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-hasproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[Get]] is not the internal method defined in <emu-xref href="#sec-arguments-exotic-objects-get-p-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Set]] is not the internal method defined in <emu-xref href="#sec-arguments-exotic-objects-set-p-v-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Delete]] is not the internal method defined in <emu-xref href="#sec-arguments-exotic-objects-delete-p"></emu-xref>, return *false*.
      1. If _v_.[[OwnPropertyKeys]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-ownpropertykeys"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="TypedArray" super="Object" clause="sec-typedarray-exotic-objects">
    <p>Its [[PreventExtensions]], [[GetOwnProperty]], [[HasProperty]], [[DefineOwnProperty]], [[Get]], [[Set]], [[Delete]], and [[OwnPropertyKeys]] internal methods are those of 10.4.5, and its other essential internal methods those of 10.1; it has no [[Call]] or [[Construct]] internal method.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ has a [[Call]] internal method, return *false*.
      1. If _v_ has a [[Construct]] internal method, return *false*.
      1. If _v_.[[GetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-getprototypeof"></emu-xref>, return *false*.
      1. If _v_.[[SetPrototypeOf]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-setprototypeof-v"></emu-xref>, return *false*.
      1. If _v_.[[IsExtensible]] is not the ordinary object internal method defined in <emu-xref href="#sec-ordinary-object-internal-methods-and-internal-slots-isextensible"></emu-xref>, return *false*.
      1. If _v_.[[PreventExtensions]] is not the internal method defined in <emu-xref href="#sec-typedarray-preventextensions"></emu-xref>, return *false*.
      1. If _v_.[[GetOwnProperty]] is not the internal method defined in <emu-xref href="#sec-typedarray-getownproperty"></emu-xref>, return *false*.
      1. If _v_.[[DefineOwnProperty]] is not the internal method defined in <emu-xref href="#sec-typedarray-defineownproperty"></emu-xref>, return *false*.
      1. If _v_.[[HasProperty]] is not the internal method defined in <emu-xref href="#sec-typedarray-hasproperty"></emu-xref>, return *false*.
      1. If _v_.[[Get]] is not the internal method defined in <emu-xref href="#sec-typedarray-get"></emu-xref>, return *false*.
      1. If _v_.[[Set]] is not the internal method defined in <emu-xref href="#sec-typedarray-set"></emu-xref>, return *false*.
      1. If _v_.[[Delete]] is not the internal method defined in <emu-xref href="#sec-typedarray-delete"></emu-xref>, return *false*.
      1. If _v_.[[OwnPropertyKeys]] is not the internal method defined in <emu-xref href="#sec-typedarray-ownpropertykeys"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="module namespace exotic object" super="Object" clause="sec-module-namespace-exotic-objects">
    <p>Every essential internal method of <emu-xref href="#table-essential-internal-methods"></emu-xref> is the one of 10.4.6; it has no [[Call]] or [[Construct]] internal method.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ has a [[Call]] internal method, return *false*.
      1. If _v_ has a [[Construct]] internal method, return *false*.
      1. If _v_.[[GetPrototypeOf]] is not the internal method defined in <emu-xref href="#sec-module-namespace-exotic-objects-getprototypeof"></emu-xref>, return *false*.
      1. If _v_.[[SetPrototypeOf]] is not the internal method defined in <emu-xref href="#sec-module-namespace-exotic-objects-setprototypeof-v"></emu-xref>, return *false*.
      1. If _v_.[[IsExtensible]] is not the internal method defined in <emu-xref href="#sec-module-namespace-exotic-objects-isextensible"></emu-xref>, return *false*.
      1. If _v_.[[PreventExtensions]] is not the internal method defined in <emu-xref href="#sec-module-namespace-exotic-objects-preventextensions"></emu-xref>, return *false*.
      1. If _v_.[[GetOwnProperty]] is not the internal method defined in <emu-xref href="#sec-module-namespace-exotic-objects-getownproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[DefineOwnProperty]] is not the internal method defined in <emu-xref href="#sec-module-namespace-exotic-objects-defineownproperty-p-desc"></emu-xref>, return *false*.
      1. If _v_.[[HasProperty]] is not the internal method defined in <emu-xref href="#sec-module-namespace-exotic-objects-hasproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[Get]] is not the internal method defined in <emu-xref href="#sec-module-namespace-exotic-objects-get-p-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Set]] is not the internal method defined in <emu-xref href="#sec-module-namespace-exotic-objects-set-p-v-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Delete]] is not the internal method defined in <emu-xref href="#sec-module-namespace-exotic-objects-delete-p"></emu-xref>, return *false*.
      1. If _v_.[[OwnPropertyKeys]] is not the internal method defined in <emu-xref href="#sec-module-namespace-exotic-objects-ownpropertykeys"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="Proxy exotic object" super="Object" clause="sec-proxy-object-internal-methods-and-internal-slots">
    <p>Its essential internal methods (including [[Call]] and [[Construct]], if applicable) are those of 10.5.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_.[[GetPrototypeOf]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-getprototypeof"></emu-xref>, return *false*.
      1. If _v_.[[SetPrototypeOf]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-setprototypeof-v"></emu-xref>, return *false*.
      1. If _v_.[[IsExtensible]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-isextensible"></emu-xref>, return *false*.
      1. If _v_.[[PreventExtensions]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-preventextensions"></emu-xref>, return *false*.
      1. If _v_.[[GetOwnProperty]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-getownproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[DefineOwnProperty]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-defineownproperty-p-desc"></emu-xref>, return *false*.
      1. If _v_.[[HasProperty]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-hasproperty-p"></emu-xref>, return *false*.
      1. If _v_.[[Get]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-get-p-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Set]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-set-p-v-receiver"></emu-xref>, return *false*.
      1. If _v_.[[Delete]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-delete-p"></emu-xref>, return *false*.
      1. If _v_.[[OwnPropertyKeys]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-ownpropertykeys"></emu-xref>, return *false*.
      1. If _v_ has a [[Call]] internal method, then
        1. If _v_.[[Call]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-call-thisargument-argumentslist"></emu-xref>, return *false*.
      1. If _v_ has a [[Construct]] internal method, then
        1. If _v_.[[Construct]] is not the internal method defined in <emu-xref href="#sec-proxy-object-internal-methods-and-internal-slots-construct-argumentslist-newtarget"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="immutable" super="Object" clause="sec-immutable-prototype-exotic-objects">
    <p>As it applies to objects (only in "immutable prototype exotic object"): its [[SetPrototypeOf]] internal method is the one of 10.4.7.1.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_.[[SetPrototypeOf]] is not the internal method defined in <emu-xref href="#sec-immutable-prototype-exotic-objects-setprototypeof-v"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="prototype exotic object" super="Object" clause="sec-immutable-prototype-exotic-objects">
    <p>The head of "immutable prototype exotic object" (dfn immutable-prototype-exotic-object): its [[SetPrototypeOf]] internal method is the one of 10.4.7.1.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_.[[SetPrototypeOf]] is not the internal method defined in <emu-xref href="#sec-immutable-prototype-exotic-objects-setprototypeof-v"></emu-xref>, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="WeakRef" super="Object" clause="sec-properties-of-weak-ref-instances">
    <p>A WeakRef instance: an object with a [[WeakRefTarget]] internal slot.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have a [[WeakRefTarget]] internal slot, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="FinalizationRegistry" super="Object" clause="sec-properties-of-finalization-registry-instances">
    <p>A FinalizationRegistry instance: an object with a [[Cells]] internal slot.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have a [[Cells]] internal slot, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="WeakMap" super="Object" clause="sec-properties-of-weakmap-instances">
    <p>A WeakMap instance: an object with a [[WeakMapData]] internal slot.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have a [[WeakMapData]] internal slot, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="WeakSet" super="Object" clause="sec-properties-of-weakset-instances">
    <p>A WeakSet instance: an object with a [[WeakSetData]] internal slot.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have a [[WeakSetData]] internal slot, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="DataView" super="Object" clause="sec-properties-of-dataview-instances">
    <p>A DataView instance: the presence of the [[DataView]] internal slot identifies objects created using the DataView constructor.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have a [[DataView]] internal slot, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="Generator" super="Object" clause="sec-properties-of-generator-instances">
    <p>A Generator instance: an object with a [[GeneratorState]] internal slot (Table 'Internal Slots of Generator Instances'); this includes the objects CreateIteratorFromClosure returns.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have a [[GeneratorState]] internal slot, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="AsyncGenerator" super="Object" clause="sec-properties-of-asyncgenerator-intances">
    <p>An AsyncGenerator instance: an object with an [[AsyncGeneratorState]] internal slot.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have an [[AsyncGeneratorState]] internal slot, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="Promise" super="Object" alg="IsPromise" clause="sec-properties-of-promise-instances"></emu-sort>

  <emu-sort name="ArrayBuffer" super="Object" clause="sec-properties-of-the-arraybuffer-instances">
    <p>An ArrayBuffer instance: an object whose [[ArrayBufferData]] internal slot holds a Data Block, not a Shared Data Block.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have an [[ArrayBufferData]] internal slot, return *false*.
      1. If _v_.[[ArrayBufferData]] is a Shared Data Block, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="SharedArrayBuffer" super="Object" clause="sec-properties-of-the-sharedarraybuffer-instances">
    <p>A SharedArrayBuffer instance: an object whose [[ArrayBufferData]] internal slot holds a Shared Data Block.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have an [[ArrayBufferData]] internal slot, return *false*.
      1. If _v_.[[ArrayBufferData]] is a Shared Data Block, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="Uint8Array" super="TypedArray" clause="sec-validateuint8array">
    <p>An object whose [[TypedArrayName]] is *"Uint8Array"*, as ValidateUint8Array checks.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have a [[TypedArrayName]] internal slot, return *false*.
      1. If _v_.[[TypedArrayName]] is *"Uint8Array"*, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="For-In Iterator instance" super="Object" clause="sec-properties-of-for-in-iterator-instances">
    <p>An object with the internal slots of Table 'Internal Slots of For-In Iterator Instances'.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ has [[Object]], [[ObjectWasVisited]], [[VisitedKeys]], and [[RemainingKeys]] internal slots, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="Array Iterator Instance" super="Object" clause="sec-properties-of-array-iterator-instances">
    <p>An object with the internal slots of Table 'Internal Slots of Array Iterator Instances'.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ has [[IteratedArrayLike]], [[ArrayLikeNextIndex]], and [[ArrayLikeIterationKind]] internal slots, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="RegExp String Iterator Object Instance" super="Object" clause="sec-properties-of-regexp-string-iterator-instances">
    <p>An object with the internal slots of Table 'Internal Slots of RegExp String Iterator Instances'.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ has [[IteratingRegExp]], [[IteratedString]], [[Global]], [[Unicode]], and [[Done]] internal slots, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="initialized RegExp instance" super="Object" clause="sec-properties-of-regexp-instances">
    <p>A RegExp instance on which RegExpInitialize has set the internal slots, so [[RegExpMatcher]] is no longer its initial *undefined*.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have a [[RegExpMatcher]] internal slot, return *false*.
      1. If _v_.[[RegExpMatcher]] is *undefined*, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="iterator object" super="Object" clause="sec-iterator-interface">
    <p>An object that implements the iterator interface: a conformance requirement on the behaviour of its next method, not a property of its state.</p>
  </emu-sort>

  <emu-sort name="data property" test="PropertyIsKind(_v_, ~data~)" clause="sec-object-type"></emu-sort>

  <emu-sort name="accessor property" test="PropertyIsKind(_v_, ~accessor~)" clause="sec-object-type"></emu-sort>

  <!-- Values -->

  <emu-sort name="Undefined" clause="sec-ecmascript-language-types-undefined-type">
    <p>The Undefined type has exactly one value, called *undefined*.</p>
    <emu-alg>
      1. If _v_ is *undefined*, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="Null" clause="sec-ecmascript-language-types-null-type">
    <p>The Null type has exactly one value, called *null*.</p>
    <emu-alg>
      1. If _v_ is *null*, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="integral Number" super="Number" clause="sec-mathematical-operations">
    <p>A finite Number value whose mathematical value is in the set of integers.</p>
    <emu-alg>
      1. If _v_ is not a Number, return *false*.
      1. If _v_ is not finite, return *false*.
      1. If ℝ(_v_) is an integer, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="NaN" super="Number" clause="sec-terms-and-definitions-nan">
    <p>The Number value that is an IEEE 754-2019 NaN value; the Number type represents all of them as the single value *NaN*.</p>
    <emu-alg>
      1. If _v_ is *NaN*, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="non-negative" clause="sec-mathematical-operations">
    <p>For a Number, one in the inclusive interval from *+0*<sub>𝔽</sub> to *+∞*<sub>𝔽</sub> (so not *-0*<sub>𝔽</sub> and not *NaN*); for an extended mathematical value, one that is ≥ 0.</p>
    <emu-alg>
      1. If _v_ is a Number, then
        1. If _v_ is in the inclusive interval from *+0*<sub>𝔽</sub> to *+∞*<sub>𝔽</sub>, return *true*.
        1. Return *false*.
      1. If _v_ is an extended mathematical value and _v_ ≥ 0, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="non-zero" clause="sec-ecmascript-language-types-number-type">
    <p>For a Number, one that is neither *+0*<sub>𝔽</sub> nor *-0*<sub>𝔽</sub> (the "non-zero finite Numbers" are the finite Numbers but the two zeros); for a mathematical value, one other than 0.</p>
    <emu-alg>
      1. If _v_ is a Number, then
        1. If _v_ is either *+0*<sub>𝔽</sub> or *-0*<sub>𝔽</sub>, return *false*.
        1. Return *true*.
      1. If _v_ is a mathematical value and _v_ ≠ 0, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="positive" clause="sec-mathematical-operations">
    <p>An extended mathematical value greater than 0.</p>
    <emu-alg>
      1. If _v_ is an extended mathematical value and _v_ > 0, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="odd" clause="sec-mathematical-operations">
    <p>An odd integer; for a Number, an integral Number whose mathematical value is odd.</p>
    <emu-alg>
      1. If _v_ is a Number, then
        1. If _v_ is not an integral Number, return *false*.
        1. Set _v_ to ℝ(_v_).
      1. If _v_ is an integer and _v_ is odd, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="finite" clause="sec-ecmascript-language-types-number-type">
    <p>A Number that is neither *NaN* nor an infinity (dfn finite), or an extended mathematical value that is a mathematical value; a BigInt, an integer, is finite, and no other value is. As a modifier ("_y_ is a finite Number") the test is asked of any value, so it answers *false* for one that is none of these.</p>
    <emu-alg>
      1. If _v_ is not a Number, _v_ is not a BigInt, and _v_ is not an extended mathematical value, return *false*.
      1. If _v_ is finite, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="time value" super="Number" clause="sec-time-values-and-time-range">
    <p>A Number, either a finite integral Number representing an instant in time to millisecond precision or *NaN* representing no specific instant.</p>
    <emu-alg>
      1. If _v_ is an integral Number, return *true*.
      1. If _v_ is *NaN*, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="epoch nanoseconds count" super="integer" clause="sec-epoch-nanoseconds">
    <p>An integer that represents an instant in time to nanosecond precision, from MinEpochNanoseconds to MaxEpochNanoseconds.</p>
    <emu-alg>
      1. If _v_ is an integer and _v_ is in the inclusive interval from MinEpochNanoseconds to MaxEpochNanoseconds, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="Unicode code point" clause="sec-source-text">
    <p>A Unicode code point value, from U+0000 to U+10FFFF, surrogate code points included; the model identifies a code point with its numeric value.</p>
    <emu-alg>
      1. If _v_ is an integer and _v_ is in the inclusive interval from 0 to 0x10FFFF, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="code point" super="Unicode code point" clause="sec-source-text">
    <p>Short for Unicode code point.</p>
    <emu-alg>
      1. If _v_ is a Unicode code point, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="code unit" clause="sec-ecmascript-language-types-string-type">
    <p>An element of a String: a 16-bit unsigned integer value, treated as a UTF-16 code unit value; the model identifies a code unit with its numeric value.</p>
    <emu-alg>
      1. If _v_ is an integer and _v_ is in the inclusive interval from 0 to 0xFFFF, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="surrogate" super="code unit" clause="sec-ecmascript-language-types-string-type">
    <p>A leading surrogate or a trailing surrogate: a code unit whose numeric value is in the inclusive interval from 0xD800 to 0xDFFF.</p>
    <emu-alg>
      1. If _v_ is a code unit and the numeric value of _v_ is in the inclusive interval from 0xD800 to 0xDFFF, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="leading" clause="sec-ecmascript-language-types-string-type">
    <p>As in leading surrogate: a code unit whose numeric value is in the inclusive interval from 0xD800 to 0xDBFF.</p>
    <emu-alg>
      1. If _v_ is a code unit and the numeric value of _v_ is in the inclusive interval from 0xD800 to 0xDBFF, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="trailing" clause="sec-ecmascript-language-types-string-type">
    <p>As in trailing surrogate: a code unit whose numeric value is in the inclusive interval from 0xDC00 to 0xDFFF.</p>
    <emu-alg>
      1. If _v_ is a code unit and the numeric value of _v_ is in the inclusive interval from 0xDC00 to 0xDFFF, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="character" super="code point" context="ph-character-of-pattern" clause="sec-pattern-semantics">
    <p>In a BMP pattern a single 16-bit Unicode BMP code point, in a Unicode pattern a UTF-16 encoded code point (the model identifies a character with its character value). The pattern is the one whose _regexpRecord_ the steps or the header name: there the test is also ph-character-of-pattern's. Where they name none (CharacterRange's header, a CharSetElement's test), the text leaves the pattern open, and the test is the union of the two, a code point.</p>
    <emu-alg>
      1. If _v_ is a code point, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-phrase id="ph-character-of-pattern" kind="predicate" subject="_v_">
    <emu-pattern>is a character of the pattern of _regexpRecord_</emu-pattern>
    <p>A character in the context of the pattern whose RegExp Record is _regexpRecord_ (<emu-xref href="#sec-pattern-semantics"></emu-xref>): the pattern is a BMP pattern when its flags contain neither `u` nor `v`, which HasEitherUnicodeFlag reads from [[Unicode]] and [[UnicodeSets]].</p>
    <emu-params>_regexpRecord_: a RegExp Record, _v_: anything</emu-params>
    <emu-alg>
      1. If HasEitherUnicodeFlag(_regexpRecord_) is *true*, then
        1. If _v_ is a code point, return *true*.
        1. Return *false*.
      1. If _v_ is a code unit, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-sort name="CharSetElement" clause="sec-pattern-notation">
    <p>A character when _regexpRecord_.[[UnicodeSets]] is *false*, and otherwise a sequence of characters (empty, one, or more); a character is interchangeable with a sequence of one character. The test is the union of the two.</p>
    <emu-alg>
      1. If _v_ is a character, return *true*.
      1. If _v_ is a List of characters, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="CharSet" test="IsCharSet(_v_)" type="a List of CharSetElements" clause="sec-pattern-notation">
    <p>A mathematical set of CharSetElements; a sequence of one character equals that character.</p>
  </emu-sort>

  <emu-sort name="single" clause="sec-pattern-notation">
    <p>One character, not a sequence of zero or several: a value that is not a List, or a List of exactly one element.</p>
    <emu-alg>
      1. If _v_ is a List, then
        1. If the number of elements in _v_ is 1, return *true*.
        1. Return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="empty" test="IsEmpty(_v_)" clause="sec-list-and-record-specification-type">
    <p>A List with no elements («»), a CharSet with no elements, or a String of length 0.</p>
  </emu-sort>

  <emu-sort name="possibly empty" clause="sec-list-and-record-specification-type">
    <p>No restriction: "a possibly empty List" is a List of any length. The data pass folds "possibly empty" into this one adjective.</p>
    <emu-alg>
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="byte value" super="integer" clause="sec-data-blocks">
    <p>An integer in the inclusive interval from 0 to 255.</p>
    <emu-alg>
      1. If _v_ is an integer and _v_ is in the inclusive interval from 0 to 255, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="byte" super="byte value" clause="sec-data-blocks">
    <p>A byte value, as in "For each byte _byte_ of _toEncode_"; a variant of "byte value".</p>
    <emu-alg>
      1. If _v_ is a byte value, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="property name" super="property key" clause="sec-object-type">
    <p>A property key that is a String.</p>
    <emu-alg>
      1. If _v_ is a String, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="integer index" super="property name" clause="sec-object-type">
    <p>A property name _n_ such that CanonicalNumericIndexString(_n_) returns an integral Number in the inclusive interval from *+0*<sub>𝔽</sub> to 𝔽(2<sup>53</sup> - 1).</p>
    <emu-alg>
      1. If _v_ is not a property name, return *false*.
      1. Let _n_ be CanonicalNumericIndexString(_v_).
      1. If _n_ is an integral Number and _n_ is in the inclusive interval from *+0*<sub>𝔽</sub> to 𝔽(2<sup>53</sup> - 1), return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="array index" super="integer index" clause="sec-object-type">
    <p>An integer index _n_ such that CanonicalNumericIndexString(_n_) returns an integral Number in the inclusive interval from *+0*<sub>𝔽</sub> to 𝔽(2<sup>32</sup> - 2).</p>
    <emu-alg>
      1. If _v_ is not an integer index, return *false*.
      1. Let _n_ be CanonicalNumericIndexString(_v_).
      1. If _n_ is an integral Number and _n_ is in the inclusive interval from *+0*<sub>𝔽</sub> to 𝔽(2<sup>32</sup> - 2), return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="sequence of Unicode code points" super="List" type="a List of code points" clause="sec-source-text">
    <p>Held as a List of code points, as StringToCodePoints returns it and ParseText uses it.</p>
    <emu-alg>
      1. If _v_ is not a List, return *false*.
      1. For each element _e_ of _v_, do
        1. If _e_ is not a code point, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="ECMAScript source text" super="sequence of Unicode code points" clause="sec-source-text">
    <p>ECMAScript source text is a sequence of Unicode code points.</p>
    <emu-alg>
      1. If _v_ is a sequence of Unicode code points, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="TypedArray element type" type="~int8~, ~uint8~, ~uint8clamped~, ~int16~, ~uint16~, ~int32~, ~uint32~, ~bigint64~, ~biguint64~, ~float16~, ~float32~, or ~float64~" clause="sec-typedarray-objects">
    <p>The underlying binary scalar data type of a _TypedArray_'s elements: an entry of the Element Type column of <emu-xref href="#table-the-typedarray-constructors"></emu-xref>.</p>
    <emu-alg>
      1. If _v_ is one of ~int8~, ~uint8~, ~uint8clamped~, ~int16~, ~uint16~, ~int32~, ~uint32~, ~bigint64~, ~biguint64~, ~float16~, ~float32~, or ~float64~, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-sort>

  <!-- Other -->

  <emu-sort name="nonterminal" super="grammar symbol" test="IsNonterminal(_v_)" clause="sec-context-free-grammars">
    <p>An abstract symbol of one of the ECMAScript grammars that is the left-hand side of productions.</p>
  </emu-sort>

  <emu-sort name="grammar symbol" test="IsGrammarSymbol(_v_)" clause="sec-context-free-grammars">
    <p>A terminal or nonterminal symbol of one of the ECMAScript grammars.</p>
  </emu-sort>

  <emu-sort name="internal slot name" test="IsInternalSlotName(_v_)" clause="sec-object-internal-methods-and-internal-slots">
    <p>A name enclosed in double square brackets [[ ]] that identifies an internal slot.</p>
  </emu-sort>

  <emu-sort name="agent signifier" test="IsAgentSignifier(_v_)" clause="sec-agents">
    <p>A globally-unique opaque value used to identify an Agent: the [[Signifier]] of an agent's Agent Record.</p>
  </emu-sort>

  <emu-sort name="Data Block" test="IsDataBlock(_v_)" type="a List of byte values" clause="sec-data-blocks"></emu-sort>

  <emu-sort name="Shared Data Block" test="IsSharedDataBlock(_v_)" type="a List of byte values" clause="sec-data-blocks"></emu-sort>

  <emu-sort name="error" clause="sec-parsetext">
    <p>Not defined; "a List of errors" tests ParseText's result, "a non-empty List of *SyntaxError* objects": an error object, one with an [[ErrorData]] internal slot.</p>
    <emu-alg>
      1. If _v_ is not an Object, return *false*.
      1. If _v_ does not have an [[ErrorData]] internal slot, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="binding" clause="sec-environment-records">
    <p>An association of an identifier with a variable or function in an Environment Record: a Record with the fields [[Value]], [[Mutable]], [[Initialized]], [[Strict]] and [[Deletable]], and for an indirect binding [[Module]] and [[BindingName]] (<emu-xref href="#formal-env"></emu-xref>).</p>
    <emu-alg>
      1. If _v_ is not a Record, return *false*.
      1. If _v_ does not have a [[Mutable]] field, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="strict" clause="sec-declarative-environment-records-createimmutablebinding-n-s">
    <p>As it applies to bindings: recorded as a strict binding by CreateImmutableBinding(_N_, *true*).</p>
    <emu-alg>
      1. If _v_ is not a binding, return *false*.
      1. Return _v_.[[Strict]].
    </emu-alg>
  </emu-sort>

  <emu-sort name="mutable" clause="sec-declarative-environment-records-createmutablebinding-n-d">
    <p>As it applies to bindings: created by CreateMutableBinding.</p>
    <emu-alg>
      1. If _v_ is not a binding, return *false*.
      1. Return _v_.[[Mutable]].
    </emu-alg>
  </emu-sort>

  <emu-sort name="uninitialized" clause="sec-declarative-environment-records-createmutablebinding-n-d">
    <p>As it applies to bindings: recorded as uninitialized at creation and not yet initialized.</p>
    <emu-alg>
      1. If _v_ is not a binding, return *false*.
      1. If _v_.[[Initialized]] is *true*, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="indirect" clause="sec-createimportbinding">
    <p>As it applies to bindings: created by CreateImportBinding, referencing a target module and binding name.</p>
    <emu-alg>
      1. If _v_ is not a binding, return *false*.
      1. If _v_ does not have a [[Module]] field, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-sort>

  <emu-sort name="Unicode property name" clause="sec-runtime-semantics-unicodematchproperty-p">
    <p>Not defined in ECMA-262; membership is the Unicode Character Database's. Residue.</p>
  </emu-sort>

  <emu-sort name="Unicode property value" clause="sec-runtime-semantics-unicodematchpropertyvalue-p-v">
    <p>Not defined in ECMA-262; membership is PropertyValueAliases.txt's. Residue.</p>
  </emu-sort>

  <emu-sort name="Matcher" super="Abstract Closure" test="ClosureKind(_v_, ~matcher~)" clause="sec-pattern-notation"></emu-sort>

  <emu-sort name="MatcherContinuation" super="Abstract Closure" test="ClosureKind(_v_, ~matcher-continuation~)" clause="sec-pattern-notation"></emu-sort>

  <emu-sort name="Job Abstract Closure" super="Abstract Closure" test="ClosureKind(_v_, ~job~)" clause="sec-jobs"></emu-sort>

  <emu-sort name="read-modify-write modification function" super="Abstract Closure" test="ClosureKind(_v_, ~read-modify-write~)" clause="sec-arraybuffer-notation"></emu-sort>
</emu-clause>
