<emu-clause id="formal-lists">
  <h1>Lists, Sets and Data Blocks</h1>
  <p>The notation of Lists, Sets and Data Blocks that the steps use without defining it.</p>

  <emu-phrase id="ph-ith-element" kind="expression">
    <emu-pattern>_i_<sup>th</sup> element of _l_</emu-pattern>
    <emu-params>_i_: a positive integer, _l_: a List</emu-params>
    <emu-alg>
      1. Assert: _i_ ≤ the number of elements in _l_.
      1. Let _k_ be 0.
      1. Let _found_ be ~empty~.
      1. For each element _e_ of _l_, do
        1. Set _k_ to _k_ + 1.
        1. If _k_ = _i_, set _found_ to _e_.
      1. Return _found_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-single-code-point-element" kind="expression">
    <emu-pattern>the single code point element of _l_</emu-pattern>
    <emu-params>_l_: a List of code points</emu-params>
    <emu-alg>
      1. Return the sole element of _l_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-set-difference" kind="expression">
    <emu-pattern>a new Set containing all elements of _a_ that are not in _b_</emu-pattern>
    <emu-params>_a_: a Set, _b_: a Set</emu-params>
    <emu-alg>
      1. Let _s_ be a new empty List.
      1. For each element _e_ of _a_, do
        1. If _b_ does not contain _e_, append _e_ to _s_.
      1. Return _s_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-block-bytes" kind="expression">
    <emu-pattern>a List whose elements are bytes from _block_ at indices in the interval from _i_ (inclusive) to _j_ (exclusive)</emu-pattern>
    <emu-params>_block_: a Data Block, _i_: a non-negative integer, _j_: a non-negative integer</emu-params>
    <emu-alg>
      1. Let _l_ be a new empty List.
      1. For each integer _k_ such that _i_ ≤ _k_ &lt; _j_, in ascending order, do
        1. Append _block_[_k_] to _l_.
      1. Return _l_.
    </emu-alg>
  </emu-phrase>
  <emu-phrase id="ph-duplicate-entries" kind="predicate" subject="_l_" rule="dups" alternatives="all">
    <emu-pattern>contains any duplicate entries</emu-pattern>
    <p>The rule's alternatives "entries" and "elements" are synonyms: both name the List's elements.</p>
    <emu-params>_l_: a List</emu-params>
    <emu-alg>
      1. Let _seen_ be a new empty List.
      1. For each element _e_ of _l_, do
        1. If _seen_ contains _e_, return *true*.
        1. Append _e_ to _seen_.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-element-also-occurs" kind="condition" rule="elem-occurs">
    <emu-pattern>any element of _a_ also occurs in _b_</emu-pattern>
    <emu-params>_a_: a List, _b_: a List</emu-params>
    <emu-alg>
      1. For each element _e_ of _a_, do
        1. If _b_ contains _e_, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>
  <emu-phrase id="ph-result-of" kind="expression" rule="result-of">
    <emu-pattern>the result of _x_</emu-pattern>
    <emu-params>_x_: anything</emu-params>
    <emu-alg>
      1. Return _x_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-occurs-exactly-once" kind="predicate" subject="_x_" rule="occurs-once">
    <emu-pattern>occurs exactly once in _l_</emu-pattern>
    <emu-params>_l_: a List, _x_: anything</emu-params>
    <emu-alg>
      1. Let _count_ be 0.
      1. For each element _e_ of _l_, do
        1. If _e_ is _x_, set _count_ to _count_ + 1.
      1. If _count_ = 1, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-more-than-one-occurrence" kind="predicate" subject="_l_" rule="more-than-once">
    <emu-pattern>contains more than one occurrence of _x_</emu-pattern>
    <emu-params>_x_: anything, _l_: a List</emu-params>
    <emu-alg>
      1. Let _count_ be 0.
      1. For each element _e_ of _l_, do
        1. If _e_ is _x_, set _count_ to _count_ + 1.
      1. If _count_ > 1, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-duplicate-entries-for" kind="predicate" subject="_l_" rule="dups-for">
    <emu-pattern>contains any duplicate entries for _x_</emu-pattern>
    <p>Duplicate entries for _x_ are two or more elements of _l_ that are _x_.</p>
    <emu-params>_x_: anything, _l_: a List</emu-params>
    <emu-alg>
      1. If _l_ contains more than one occurrence of _x_, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-element-not-in-either" kind="condition" rule="elem-not-occurs">
    <emu-pattern>any element of _a_ does not also occur in either _b_, or _c_</emu-pattern>
    <emu-params>_a_: a List, _b_: a List, _c_: a List</emu-params>
    <emu-alg>
      1. For each element _e_ of _a_, do
        1. If _b_ does not contain _e_ and _c_ does not contain _e_, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-list-consisting-of" kind="expression" rule="list-consisting">
    <emu-pattern>a List consisting of _l_</emu-pattern>
    <emu-params>_l_: a List</emu-params>
    <emu-alg>
      1. Return a copy of _l_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-the-list" kind="expression" rule="typed-var-list">
    <emu-pattern>the List _l_</emu-pattern>
    <emu-params>_l_: a List</emu-params>
    <emu-alg>
      1. Assert: _l_ is a List.
      1. Return _l_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-the-string" kind="expression" rule="typed-var-string" alternatives="all">
    <emu-pattern>the String value _s_</emu-pattern>
    <p>"the String _s_" and "the String value _s_" both name the String value of _s_.</p>
    <emu-params>_s_: a String</emu-params>
    <emu-alg>
      1. Assert: _s_ is a String.
      1. Return _s_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-new-error" kind="expression" rule="new-error">
    <emu-pattern>a newly created _name_ object</emu-pattern>
    <p>An instance of the error constructor _name_ names: an ordinary object that inherits from that constructor's prototype object and has an [[ErrorData]] internal slot whose value is *undefined* (the Properties of _NativeError_, AggregateError and SuppressedError Instances); %…% is the current Realm Record's intrinsic. The host may add own properties to it (HostExtendObject).</p>
    <emu-params>_name_: an error constructor's name</emu-params>
    <emu-alg>
      1. If _name_ is *AggregateError*, let _o_ be OrdinaryObjectCreate(%AggregateError.prototype%, « [[ErrorData]] »).
      1. Else if _name_ is *EvalError*, let _o_ be OrdinaryObjectCreate(%EvalError.prototype%, « [[ErrorData]] »).
      1. Else if _name_ is *RangeError*, let _o_ be OrdinaryObjectCreate(%RangeError.prototype%, « [[ErrorData]] »).
      1. Else if _name_ is *ReferenceError*, let _o_ be OrdinaryObjectCreate(%ReferenceError.prototype%, « [[ErrorData]] »).
      1. Else if _name_ is *SuppressedError*, let _o_ be OrdinaryObjectCreate(%SuppressedError.prototype%, « [[ErrorData]] »).
      1. Else if _name_ is *SyntaxError*, let _o_ be OrdinaryObjectCreate(%SyntaxError.prototype%, « [[ErrorData]] »).
      1. Else if _name_ is *TypeError*, let _o_ be OrdinaryObjectCreate(%TypeError.prototype%, « [[ErrorData]] »).
      1. Else,
        1. Assert: _name_ is *URIError*.
        1. Let _o_ be OrdinaryObjectCreate(%URIError.prototype%, « [[ErrorData]] »).
      1. Perform HostExtendObject(_o_).
      1. Return _o_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-finite-numbers" kind="condition" rule="plural-finite-numbers">
    <emu-pattern>_xs_ are finite Numbers</emu-pattern>
    <p>Every element is a finite Number.</p>
    <emu-params>_xs_: a List of Numbers</emu-params>
    <emu-alg>
      1. For each element _x_ of _xs_, do
        1. If _x_ is not a finite Number, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-nonzero-finite-numbers" kind="condition" rule="plural-nonzero-finite-numbers">
    <emu-pattern>_xs_ are non-zero finite Numbers</emu-pattern>
    <p>Every element is a non-zero finite Number: finite, and neither *+0*<sub>𝔽</sub> nor *-0*<sub>𝔽</sub>.</p>
    <emu-params>_xs_: a List of Numbers</emu-params>
    <emu-alg>
      1. For each element _x_ of _xs_, do
        1. If _x_ is not a non-zero finite Number, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-no-duplicate-entries" kind="predicate" subject="_l_" rule="dups-none" alternatives="all">
    <emu-pattern>has no duplicate entries</emu-pattern>
    <p>"has" and "contains" are synonyms here.</p>
    <emu-params>_l_: a List</emu-params>
    <emu-alg>
      1. If _l_ contains any duplicate entries, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-any-duplicate-entries" kind="predicate" subject="_l_" rule="dups-any" alternatives="all">
    <emu-pattern>has any duplicate entries</emu-pattern>
    <p>"has" and "contains" are synonyms here.</p>
    <emu-params>_l_: a List</emu-params>
    <emu-alg>
      1. If _l_ contains any duplicate entries, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-elements-of" kind="expression" rule="elements-of-all">
    <emu-pattern>the elements of _l_</emu-pattern>
    <emu-params>_l_: a List</emu-params>
    <emu-alg>
      1. Return a copy of _l_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-first-elements-of" kind="expression" rule="elements-of-first">
    <emu-pattern>the first _k_ elements of _l_</emu-pattern>
    <emu-params>_k_: a non-negative integer, _l_: a List</emu-params>
    <emu-alg>
      1. Assert: _k_ ≤ the number of elements in _l_.
      1. Let _r_ be a new empty List.
      1. For each element _e_ of _l_, do
        1. If the number of elements in _r_ &lt; _k_, append _e_ to _r_.
      1. Return _r_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-append-elements" kind="step">
    <emu-pattern>Append the elements of _a_ to _b_.</emu-pattern>
    <p>Each element of _a_ is appended, in order; "Append _x_ to _b_" would append the List itself.</p>
    <emu-params>_a_: a List, _b_: a List</emu-params>
    <emu-alg>
      1. For each element _e_ of _a_, do
        1. Append _e_ to _b_.
      1. Return ~unused~.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-list-whose-elements" kind="expression" rule="list-elems">
    <emu-pattern>a List whose elements are _parts_</emu-pattern>
    <p>Every use names the elements by one plural expression ("the elements of _l_", "the first _k_ elements of _l_", "the code units that are the elements of _s_"), whose value is a List of them.</p>
    <emu-params>_parts_: a List</emu-params>
    <emu-alg>
      1. Let _elements_ be the sole element of _parts_.
      1. Assert: _elements_ is a List.
      1. Return a copy of _elements_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-has-no-elements" kind="predicate" subject="_l_" rule="has-no-elements">
    <emu-pattern>has no elements</emu-pattern>
    <emu-params>_l_: a List</emu-params>
    <emu-alg>
      1. If _l_ is empty, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-has-any-elements" kind="predicate" subject="_l_" rule="has-any-elements">
    <emu-pattern>has any elements</emu-pattern>
    <emu-params>_l_: a List</emu-params>
    <emu-alg>
      1. If _l_ is empty, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-has-n-elements" kind="predicate" subject="_l_" rule="has-n-elements">
    <emu-pattern>has _n_ elements</emu-pattern>
    <emu-params>_n_: a non-negative integer, _l_: a List</emu-params>
    <emu-alg>
      1. If the number of elements in _l_ = _n_, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-new-record" kind="expression" rule="new-rec">
    <emu-pattern>a new _r_</emu-pattern>
    <p>A Record literal denotes a Record created where it is evaluated.</p>
    <emu-params>_r_: a Record</emu-params>
    <emu-alg>
      1. Return _r_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-both-are" kind="condition" rule="both-val">
    <emu-pattern>_a_ and _b_ are both _v_</emu-pattern>
    <emu-params>_a_: anything, _b_: anything, _v_: anything</emu-params>
    <emu-alg>
      1. If _a_ is _v_ and _b_ is _v_, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-integers-ascending" kind="expression" rule="list-ints-asc">
    <emu-pattern>a List of the integers in the interval from _a_ (inclusive) to _b_ (exclusive), in ascending order</emu-pattern>
    <emu-params>_a_: an integer, _b_: an integer</emu-params>
    <emu-alg>
      1. Let _l_ be a new empty List.
      1. For each integer _k_ such that _a_ ≤ _k_ &lt; _b_, in ascending order, do
        1. Append _k_ to _l_.
      1. Return _l_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-integers-descending" kind="expression" rule="list-ints-desc">
    <emu-pattern>a List of the integers in the interval from _a_ (inclusive) to _b_ (exclusive), in descending order</emu-pattern>
    <emu-params>_a_: an integer, _b_: an integer</emu-params>
    <emu-alg>
      1. Let _l_ be a new empty List.
      1. For each integer _k_ such that _a_ ≤ _k_ &lt; _b_, in descending order, do
        1. Append _k_ to _l_.
      1. Return _l_.
    </emu-alg>
  </emu-phrase>

  <emu-reading clause="sec-GetImportedModule" steps="1" hashes="e94b0b0fa3a841c92018fa7bdf2d617835f4290b1a460c77fa9bf19f9756b876">
    <emu-alg reading="definition">
      1. Let _records_ be a new empty List.
      1. For each LoadedModuleRequest Record _r_ of _referrer_.[[LoadedModules]], do
        1. If ModuleRequestsEqual(_r_, _request_) is *true*, append _r_ to _records_.
    </emu-alg>
    <emu-note>
      <p>The List keeps the order of _referrer_.[[LoadedModules]]; step 2 asserts it has one element.</p>
    </emu-note>
  </emu-reading>
  <emu-reading clause="sec-internalizejsonproperty" steps="5.c.ii.1" hashes="6847491d77430e7b7c1a3a5364afd158d75b1248c676a52cde0fb9f67dd7cdad">
    <emu-alg reading="definition">
      1. Let _entryRecord_ be ~empty~.
      1. For each element _entry_ of _entryRecords_, do
        1. If _entryRecord_ is ~empty~ and _entry_.[[Key]] is _propertyKey_, set _entryRecord_ to _entry_.
    </emu-alg>
    <emu-note>
      <p>CreateJSONParseRecord makes one entry per own property key, so at most one element has the key; the reading takes the first.</p>
    </emu-note>
  </emu-reading>

  <emu-phrase id="ph-elements-in-order" kind="expression" rule="elems-in-order">
    <emu-pattern>a List whose elements are the elements of _l_, in order</emu-pattern>
    <emu-params>_l_: a List</emu-params>
    <emu-alg>
      1. Let _r_ be a new empty List.
      1. For each element _e_ of _l_, do
        1. Append _e_ to _r_.
      1. Return _r_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-elements-by-async-order" kind="expression" rule="elems-by-async-order">
    <emu-pattern>a List whose elements are the elements of _l_, sorted by their [[AsyncEvaluationOrder]] field in ascending order</emu-pattern>
    <p>Each step takes the first element with the least [[AsyncEvaluationOrder]]; the fields are distinct integers at the only site (AsyncModuleExecutionFulfilled, whose step 10 asserts that they are integers).</p>
    <emu-params>_l_: a List of Records</emu-params>
    <emu-alg>
      1. Let _rest_ be a copy of _l_.
      1. Let _r_ be a new empty List.
      1. Repeat, while _rest_ is not empty,
        1. Let _min_ be the first element of _rest_.
        1. For each element _e_ of _rest_, do
          1. If _e_.[[AsyncEvaluationOrder]] &lt; _min_.[[AsyncEvaluationOrder]], set _min_ to _e_.
        1. Append _min_ to _r_.
        1. Remove _min_ from _rest_.
      1. Return _r_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-elements-lexicographic" kind="expression" rule="elems-lexicographic">
    <emu-pattern>a List whose elements are the elements of _l_, sorted according to lexicographic code unit order</emu-pattern>
    <p>Lexicographic code unit order is IsLessThan's order on Strings (<emu-xref href="#sec-islessthan"></emu-xref>, step 3); each step takes the first least element.</p>
    <emu-params>_l_: a List of Strings</emu-params>
    <emu-alg>
      1. Let _rest_ be a copy of _l_.
      1. Let _r_ be a new empty List.
      1. Repeat, while _rest_ is not empty,
        1. Let _min_ be the first element of _rest_.
        1. For each element _e_ of _rest_, do
          1. If ! IsLessThan(_e_, _min_, *true*) is *true*, set _min_ to _e_.
        1. Append _min_ to _r_.
        1. Remove _min_ from _rest_.
      1. Return _r_.
    </emu-alg>
  </emu-phrase>

  <emu-primitive id="prim-listfind" name="ListFind">
    <emu-signature>ListFind(_f_: a field name, _l_: a List, _v_: anything): anything</emu-signature>
    <p>The element of _l_ whose _f_ field is _v_. Exactly one element of _l_ has an _f_ field whose value is _v_.</p>
  </emu-primitive>

  <emu-primitive id="prim-listfindof" name="ListFindOf">
    <emu-signature>ListFindOf(_t_: a type, _f_: a field name, _l_: a List, _v_: anything): anything</emu-signature>
    <p>ListFind(_f_, _l_, _v_) among the elements of _l_ of the Record sort _t_: the element of _l_ that is a _t_ and whose _f_ field is _v_. Exactly one element of _l_ is a _t_ with an _f_ field whose value is _v_.</p>
  </emu-primitive>

  <emu-phrase id="ph-elem-whose" kind="expression" rule="elem-whose" alternatives="all">
    <emu-pattern>the element of _l_ whose _f_ is _v_</emu-pattern>
    <p>"field" after the field name only says that it names a field.</p>
    <emu-params>_l_: a List, _f_: a field name, _v_: anything</emu-params>
    <emu-alg>
      1. Return ListFind(_f_, _l_, _v_).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-elem-whose-tn" kind="expression" rule="elem-whose-tn" alternatives="all">
    <emu-pattern>the _t_ in _l_ whose _f_ is _v_</emu-pattern>
    <p>"field" after the field name only says that it names a field. The element is the one among those of sort _t_.</p>
    <emu-params>_t_: a type, _l_: a List, _f_: a field name, _v_: anything</emu-params>
    <emu-alg>
      1. Return ListFindOf(_t_, _f_, _l_, _v_).
    </emu-alg>
  </emu-phrase>
  <emu-result-type clause="ph-elem-whose-tn">a _t_</emu-result-type>

  <emu-reading clause="sec-evaluate-import-call" steps="11.f" hashes="cdd3e1a363f7f652b84db13178cb7c02c7d83d79e187a340ff42715495e22153">
    <emu-alg reading="definition">
      1. Let _rest_ be a copy of _attrs_.
      1. Let _sorted_ be a new empty List.
      1. Repeat, while _rest_ is not empty,
        1. Let _least_ be the first element of _rest_.
        1. For each element _a_ of _rest_, do
          1. If ! IsLessThan(_a_.[[Key]], _least_.[[Key]], *true*) is *true*, set _least_ to _a_.
        1. Append _least_ to _sorted_.
        1. Remove _least_ from _rest_.
      1. Set _attrs_ to _sorted_.
    </emu-alg>
    <emu-note>
      <p>Lexicographic order of sequences of UTF-16 code units is IsLessThan's order on Strings (<emu-xref href="#sec-islessthan"></emu-xref>, step 3). The [[Key]] fields are distinct, so each step's least element is unique. _attrs_ is not shared, so its sorted copy replaces it.</p>
      <p>This sorting is observable only in that hosts are prohibited from changing behaviour based on the order in which attributes are enumerated.</p>
    </emu-note>
  </emu-reading>
  <emu-reading clause="sec-withclausetoattributes" steps="2" hashes="cdd3e1a363f7f652b84db13178cb7c02c7d83d79e187a340ff42715495e22153">
    <emu-alg reading="definition">
      1. Let _rest_ be a copy of _attrs_.
      1. Let _sorted_ be a new empty List.
      1. Repeat, while _rest_ is not empty,
        1. Let _least_ be the first element of _rest_.
        1. For each element _a_ of _rest_, do
          1. If ! IsLessThan(_a_.[[Key]], _least_.[[Key]], *true*) is *true*, set _least_ to _a_.
        1. Append _least_ to _sorted_.
        1. Remove _least_ from _rest_.
      1. Set _attrs_ to _sorted_.
    </emu-alg>
    <emu-note>
      <p>Lexicographic order of sequences of UTF-16 code units is IsLessThan's order on Strings (<emu-xref href="#sec-islessthan"></emu-xref>, step 3). Keys can be equal only where the WithClause early error rejects the clause; that rule does not observe their order, and each step takes the first least element. _attrs_ is not shared, so its sorted copy replaces it.</p>
      <p>This sorting is observable only in that hosts are prohibited from changing behaviour based on the order in which attributes are enumerated.</p>
    </emu-note>
  </emu-reading>
  <emu-reading clause="sec-GetImportedModule" steps="2" hashes="c297b2612b4bb5efeab9aeb5fc4955931a712d4b7b1ecf232c348433614be006">
    <emu-alg reading="definition">
      1. Assert: the number of elements in _records_ is 1.
    </emu-alg>
    <emu-note>
      <p>The step's "since …" clause is a remark on why the condition holds; the condition is that _records_ has one element.</p>
    </emu-note>
  </emu-reading>
  <emu-reading clause="sec-add-value-to-keyed-group" steps="1.a.i" hashes="8a4a632a27b1b8975d21fdf07f5bb329ab6c421e5422f9364682a4183145bf81">
    <emu-alg reading="definition">
      1. Assert: _groups_ contains exactly one Record _g_ such that SameValue(_g_.[[Key]], _key_) is *true*.
    </emu-alg>
    <emu-note>
      <p>The criterion is step 1.a's: SameValue of the element's [[Key]] and _key_ is *true*.</p>
    </emu-note>
  </emu-reading>
  <emu-phrase id="ph-all-ready-to-evaluate" kind="condition">
    <emu-pattern>All elements of _l_ have their [[AsyncEvaluationOrder]] field set to an integer, [[PendingAsyncDependencies]] field set to 0, and [[EvaluationError]] field set to ~empty~</emu-pattern>
    <p>The three field conditions, of each element of _l_.</p>
    <emu-params>_l_: a List of Cyclic Module Records</emu-params>
    <emu-alg>
      1. For each element _m_ of _l_, do
        1. If _m_.[[AsyncEvaluationOrder]] is not an integer, return *false*.
        1. If _m_.[[PendingAsyncDependencies]] ≠ 0, return *false*.
        1. If _m_.[[EvaluationError]] is not ~empty~, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>
  <emu-reading clause="sec-getmodulenamespace" steps="1" hashes="923b6db88916f3af0ed8bb4bae24720c5e9a71aa725bd7825e5b956a38ff1e40">
    <emu-alg reading="definition">
      1. If _module_ is a Cyclic Module Record, then
        1. Assert: _module_.[[Status]] is neither ~new~ nor ~unlinked~.
    </emu-alg>
    <emu-note>
      <p>"[[Status]] is not ~new~ or ~unlinked~" excludes both values.</p>
    </emu-note>
  </emu-reading>
  <emu-reading clause="sec-innermoduleevaluation" steps="16.b.iv" hashes="3d74ad205ebccc44438f57da3742950ab0cbbb769311e4906dc25d8370d0bdcb">
    <emu-alg reading="definition">
      1. Assert: _requiredModule_.[[AsyncEvaluationOrder]] is an integer or _requiredModule_.[[AsyncEvaluationOrder]] is ~unset~.
    </emu-alg>
    <emu-note>
      <p>The alternatives are a type and a value; each is its own condition.</p>
    </emu-note>
  </emu-reading>
  <emu-reading clause="sec-resolveexport" steps="7.a" hashes="4cc25adc96bc3ace6b48221e054fa5cdb44b6a25a5521aadc8de626778893c4b">
    <emu-alg reading="definition">
      1. Assert: _module_ does not explicitly define an export named *"default"*.
    </emu-alg>
    <emu-note>
      <p>"This module" is _module_; a `default` export is the export named *"default"*.</p>
    </emu-note>
  </emu-reading>

  <emu-phrase id="ph-neither-nor-nor" kind="predicate" subject="_x_" rule="neither3">
    <emu-pattern>is neither _a_ nor _b_ nor _c_</emu-pattern>
    <emu-params>_a_: a type, _b_: a type, _c_: a type, _x_: anything</emu-params>
    <emu-alg>
      1. If _x_ is a _a_, return *false*.
      1. If _x_ is a _b_, return *false*.
      1. If _x_ is a _c_, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-same-tn" kind="condition" rule="same-tn">
    <emu-pattern>_a_ and _b_ are the same _t_</emu-pattern>
    <p>One value of type _t_: _a_ is _b_ (<emu-xref href="#sec-identity"></emu-xref>).</p>
    <emu-params>_a_: anything, _b_: anything, _t_: a type</emu-params>
    <emu-alg>
      1. If _a_ is _b_ and _a_ is a _t_, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-not-same-tn" kind="condition" rule="not-same-tn">
    <emu-pattern>_a_ and _b_ are not the same _t_</emu-pattern>
    <p>The negation of "_a_ and _b_ are the same _t_".</p>
    <emu-params>_a_: anything, _b_: anything, _t_: a type</emu-params>
    <emu-alg>
      1. If _a_ is _b_ and _a_ is a _t_, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-same-as" kind="predicate" subject="_x_" rule="same-as">
    <emu-pattern>is the same _t_ as _e_</emu-pattern>
    <p>One value of type _t_: _x_ is _e_ (<emu-xref href="#sec-identity"></emu-xref>).</p>
    <emu-params>_t_: a type, _e_: anything, _x_: anything</emu-params>
    <emu-alg>
      1. If _x_ is _e_ and _x_ is a _t_, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-both-empty" kind="condition" rule="both-empty">
    <emu-pattern>_xs_ are both empty</emu-pattern>
    <p>"both": _xs_ has two elements, each a List or a sequence.</p>
    <emu-params>_xs_: a List</emu-params>
    <emu-alg>
      1. Assert: the number of elements in _xs_ is 2.
      1. For each element _x_ of _xs_, do
        1. If _x_ is not empty, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>
  <emu-phrase id="ph-two-entries" kind="predicate" subject="_l_" rule="two-entries">
    <emu-pattern>has two different entries _a_ and _b_ such that _c_</emu-pattern>
    <p>Two entries at different positions of the List; _c_ is tested with _a_ and _b_ bound to them, in either order.</p>
    <emu-params>_a_: anything, _b_: anything, _c_: a condition on _a_ and _b_, _l_: a List</emu-params>
    <emu-alg>
      1. Let _n_ be the number of elements in _l_.
      1. For each integer _i_ such that 0 ≤ _i_ &lt; _n_, in ascending order, do
        1. For each integer _j_ such that 0 ≤ _j_ &lt; _n_, in ascending order, do
          1. If _i_ ≠ _j_ and _c_(_l_[_i_], _l_[_j_]) is *true*, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-contains-such" kind="predicate" subject="_l_" rule="contains-such" alternatives="all">
    <emu-pattern>contains a _t_ _x_ such that _c_</emu-pattern>
    <p>"a" and "an" are one article. _c_ is tested with _x_ bound to an element of type _t_.</p>
    <emu-params>_t_: a type, _x_: anything, _c_: a condition on _x_, _l_: a List</emu-params>
    <emu-alg>
      1. For each element _e_ of _l_, do
        1. If _e_ is a _t_ and _c_(_e_) is *true*, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-contains-such-binds" kind="predicate" subject="_l_" rule="contains-such-binds" alternatives="all">
    <emu-pattern>contains a _t_ _x_ such that _c_</emu-pattern>
    <p>"a" and "an" are one article. The condition of an If or Else if whose consequent reads _x_: the elements of type _t_ that _c_ holds of. With none the condition is false; with one it is true and _x_ is that element in the consequent; with more the text does not say which, and the step stops.</p>
    <emu-params>_t_: a type, _x_: anything, _c_: a condition on _x_, _l_: a List</emu-params>
    <emu-alg>
      1. Let _r_ be a new empty List.
      1. For each element _e_ of _l_, do
        1. If _e_ is a _t_ and _c_(_e_) is *true*, append _e_ to _r_.
      1. Return _r_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-not-explicitly-defined-export" kind="predicate" subject="_module_">
    <emu-pattern>does not explicitly define an export named _n_</emu-pattern>
    <p>A module defines an export explicitly by an ExportEntry Record of its [[LocalExportEntries]] or [[IndirectExportEntries]] whose [[ExportName]] is the export's name (ParseModule); the [[StarExportEntries]] have no [[ExportName]].</p>
    <emu-params>_n_: a String, _module_: a Source Text Module Record</emu-params>
    <emu-alg>
      1. For each ExportEntry Record _e_ of _module_.[[LocalExportEntries]], do
        1. If _e_.[[ExportName]] is _n_, return *false*.
      1. For each ExportEntry Record _e_ of _module_.[[IndirectExportEntries]], do
        1. If _e_.[[ExportName]] is _n_, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-contains-one-such" kind="predicate" subject="_l_" rule="contains-one-such">
    <emu-pattern>contains exactly one _t_ _x_ such that _c_</emu-pattern>
    <p>_c_ is tested with _x_ bound to an element of type _t_; exactly one element meets it when the count of those that do is 1.</p>
    <emu-params>_t_: a type, _x_: anything, _c_: a condition on _x_, _l_: a List</emu-params>
    <emu-alg>
      1. Let _n_ be 0.
      1. For each element _e_ of _l_, do
        1. If _e_ is a _t_ and _c_(_e_) is *true*, set _n_ to _n_ + 1.
      1. If _n_ = 1, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-not-contains-such" kind="predicate" subject="_l_" rule="not-contains-such" alternatives="all">
    <emu-pattern>does not contain a _t_ _x_ such that _c_</emu-pattern>
    <p>"a" and "an" are one article. _c_ is tested with _x_ bound to an element of type _t_.</p>
    <emu-params>_t_: a type, _x_: anything, _c_: a condition on _x_, _l_: a List</emu-params>
    <emu-alg>
      1. For each element _e_ of _l_, do
        1. If _e_ is a _t_ and _c_(_e_) is *true*, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-iter-backwards" kind="expression" rule="iter-backwards">
    <emu-pattern>_l_, iterating backwards from its second-to-last element</emu-pattern>
    <p>The elements a For-each visits: the second-to-last element of _l_, then each element before it, back to the first; none when _l_ has fewer than two elements.</p>
    <emu-params>_l_: a List</emu-params>
    <emu-alg>
      1. Let _r_ be a new empty List.
      1. Let _n_ be the number of elements in _l_.
      1. Let _k_ be _n_ - 1.
      1. Repeat, while _k_ > 0,
        1. Set _k_ to _k_ - 1.
        1. Append _l_[_k_] to _r_.
      1. Return _r_.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-see-xref" kind="expression" rule="see-xref">
    <emu-pattern>_e_ (see _r_)</emu-pattern>
    <p>The parenthetical is a cross-reference; the value is _e_'s.</p>
    <emu-params>_e_: anything, _r_: a cross-reference</emu-params>
    <emu-alg>
      1. Return _e_.
    </emu-alg>
  </emu-phrase>
</emu-clause>
