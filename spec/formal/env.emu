<emu-clause id="formal-env">
  <h1>Environment Record Bindings</h1>
  <p>An Environment Record's bindings (<emu-xref href="#sec-environment-records"></emu-xref>): a table from names to binding Records, held by the Environment Record apart from its fields.</p>

  <emu-primitive id="prim-newbindingsrecord" name="NewBindingsRecord">
    <emu-signature>NewBindingsRecord(_kind_: an Environment Record sort): an Environment Record</emu-signature>
    <p>A new Environment Record of sort _kind_ with no fields and no bindings.</p>
  </emu-primitive>

  <emu-primitive id="prim-bindingshas" name="BindingsHas">
    <emu-signature>BindingsHas(_env_: an Environment Record, _N_: a String): a Boolean</emu-signature>
    <p>Whether _env_ has a binding for the name _N_.</p>
  </emu-primitive>

  <emu-primitive id="prim-bindingfor" name="BindingFor">
    <emu-signature>BindingFor(_env_: an Environment Record, _N_: a String): a binding Record</emu-signature>
    <p>_env_'s binding for _N_. _env_ has one.</p>
  </emu-primitive>

  <emu-primitive id="prim-addbinding" name="AddBinding">
    <emu-signature>AddBinding(_env_: an Environment Record, _N_: a String, _b_: a binding Record): ~unused~</emu-signature>
    <p>Makes _b_ _env_'s binding for _N_, after the bindings it has. _env_ has no binding for _N_.</p>
  </emu-primitive>

  <emu-primitive id="prim-removebinding" name="RemoveBinding">
    <emu-signature>RemoveBinding(_env_: an Environment Record, _N_: a String): ~unused~</emu-signature>
    <p>_env_ no longer has a binding for _N_; its other bindings keep their order.</p>
  </emu-primitive>

  <emu-primitive id="prim-bindingnames" name="BindingNames">
    <emu-signature>BindingNames(_env_: an Environment Record): a List of Strings</emu-signature>
    <p>A new List of the names _env_ has bindings for, in the order they were added.</p>
  </emu-primitive>

  <emu-primitive id="prim-strictfromoutside" name="StrictFromOutside">
    <emu-signature>StrictFromOutside(_node_: a Parse Node): a Boolean</emu-signature>
    <p>Whether _node_ is in source text that is strict mode code from outside it (<emu-xref href="#sec-strict-mode-code"></emu-xref>: eval code of a direct eval contained in strict mode code): the parser invocation that made _node_ was given that its source text is strict.</p>
  </emu-primitive>

  <emu-phrase id="ph-has-binding" kind="predicate" subject="_env_" rule="has-binding-yes">
    <emu-pattern>has a binding for _N_</emu-pattern>
    <emu-params>_N_: a String, _env_: an Environment Record</emu-params>
    <emu-alg>
      1. If BindingNames(_env_) contains _N_, return *true*.
      1. Return *false*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-not-has-binding" kind="predicate" subject="_env_" rule="has-binding-no" alternatives="all">
    <emu-pattern>does not have a binding for _N_</emu-pattern>
    <p>"does not already have" and "does not have" are synonyms: "already" adds nothing to the test.</p>
    <emu-params>_N_: a String, _env_: an Environment Record</emu-params>
    <emu-alg>
      1. If BindingNames(_env_) contains _N_, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-not-env-for" kind="predicate" subject="_env_" rule="env-for-not" alternatives="all">
    <emu-pattern>is not the Environment Record for a _nt_ clause</emu-pattern>
    <p>"a" and "an" are synonyms. _env_ was not created for an instance of _nt_: CatchClauseEvaluation records in [[CreatedFor]] the |Catch| it creates its Environment Record for.</p>
    <emu-params>_nt_: a nonterminal, _env_: an Environment Record</emu-params>
    <emu-alg>
      1. If _env_ has a [[CreatedFor]] field, then
        1. If _env_.[[CreatedFor]] is an instance of _nt_, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-reading clause="sec-runtime-semantics-catchclauseevaluation" steps="2" hashes="47e0a6d8a98f51ebcd7a28275552b6ce2bf9e2a2d7ec75b7fb07e3042e2db86e">
    <emu-alg reading="definition">
      1. Let _catchEnv_ be NewDeclarativeEnvironment(_oldEnv_).
      1. Set _catchEnv_.[[CreatedFor]] to this Parse Node.
    </emu-alg>
    <emu-note>
      <p>The step, and a record of the |Catch| that _catchEnv_ is the Environment Record for, which only "the Environment Record for a |Catch| clause" reads.</p>
    </emu-note>
  </emu-reading>

  <emu-phrase id="ph-binding-for" kind="expression" rule="binding-for">
    <emu-pattern>the binding for _N_ in _env_</emu-pattern>
    <emu-params>_N_: a String, _env_: an Environment Record</emu-params>
    <emu-alg>
      1. Return BindingFor(_env_, _N_).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-bound-value" kind="expression" rule="bound-value">
    <emu-pattern>the value currently bound to _N_ in _env_</emu-pattern>
    <emu-params>_N_: a String, _env_: an Environment Record</emu-params>
    <emu-alg>
      1. Return BindingFor(_env_, _N_).[[Value]].
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-env-empty" kind="expression" rule="env-empty">
    <emu-pattern>a new _t_ containing no bindings</emu-pattern>
    <emu-params>_t_: an Environment Record sort</emu-params>
    <emu-alg>
      1. Return NewBindingsRecord(_t_).
    </emu-alg>
  </emu-phrase>

  <emu-phrase id="ph-not-yet-initialized" kind="predicate" subject="_b_" rule="not-yet-initialized">
    <emu-pattern>has not yet been initialized</emu-pattern>
    <emu-params>_b_: a binding</emu-params>
    <emu-alg>
      1. If _b_.[[Initialized]] is *true*, return *false*.
      1. Return *true*.
    </emu-alg>
  </emu-phrase>

  <emu-reading clause="sec-declarative-environment-records-createmutablebinding-n-d" steps="2" hashes="000c9ceb3b517a66003074259c53506c1ab653027740b2618a45cca51044beb7">
    <emu-alg reading="definition">
      1. Perform AddBinding(_envRecord_, _name_, Record { [[Value]]: ~empty~, [[Mutable]]: *true*, [[Initialized]]: *false*, [[Strict]]: *false*, [[Deletable]]: _deletable_ }).
    </emu-alg>
    <emu-note>
      <p>A mutable binding is created uninitialized, with no value yet; it may be deleted exactly when _deletable_ is *true*.</p>
    </emu-note>
  </emu-reading>

  <emu-reading clause="sec-declarative-environment-records-createimmutablebinding-n-s" steps="2" hashes="0ee5b00e5d41479f9bc4b711c8a4ac87bb993c8fdbb4e5bde6c4a016afd610c7">
    <emu-alg reading="definition">
      1. Perform AddBinding(_envRecord_, _name_, Record { [[Value]]: ~empty~, [[Mutable]]: *false*, [[Initialized]]: *false*, [[Strict]]: _strict_, [[Deletable]]: *false* }).
    </emu-alg>
    <emu-note>
      <p>An immutable binding is created uninitialized, with no value yet; it is a strict binding exactly when _strict_ is *true*.</p>
    </emu-note>
  </emu-reading>

  <emu-reading clause="sec-declarative-environment-records-deletebinding-n" steps="2" hashes="e05c8b2b4ab172c4f3824f23addc63d78bf74f515b61af3b20be1e590f17c328">
    <emu-alg reading="definition">
      1. If BindingFor(_envRecord_, _name_).[[Deletable]] is *false*, return *false*.
    </emu-alg>
  </emu-reading>

  <emu-reading clause="sec-declarative-environment-records-deletebinding-n" steps="3" hashes="10d7b87f251004043040ff8b7c99c8ae0239977e72cfc7aac43ff789470acf4b">
    <emu-alg reading="definition">
      1. Perform RemoveBinding(_envRecord_, _name_).
    </emu-alg>
  </emu-reading>

  <emu-reading clause="sec-declarative-environment-records-initializebinding-n-v" steps="2" hashes="01c22a6160088fca470aa86818a943b6feb8c74d0f319bc96e50be60e47e2131">
    <emu-alg reading="definition">
      1. Set BindingFor(_envRecord_, _name_).[[Value]] to _value_.
    </emu-alg>
  </emu-reading>

  <emu-reading clause="sec-declarative-environment-records-initializebinding-n-v" steps="3" hashes="5422f0b1f751fd522f4814f469c640bdb33416f52d48d3e81661c694482d0ad5">
    <emu-alg reading="definition">
      1. Set BindingFor(_envRecord_, _name_).[[Initialized]] to *true*.
    </emu-alg>
  </emu-reading>

  <emu-reading clause="sec-declarative-environment-records-setmutablebinding-n-v-s" steps="4.a" hashes="6f4fc58d46c3a4b7a3e5308072fe518a79fd08946c51b4bc2e1ae9a5bb1a5922">
    <emu-alg reading="definition">
      1. Set BindingFor(_envRecord_, _name_).[[Value]] to _value_.
    </emu-alg>
    <emu-note>
      <p>"its" is the binding for _name_ in _envRecord_ of the step it is under.</p>
    </emu-note>
  </emu-reading>

  <emu-reading clause="sec-module-environment-records-getbindingvalue-n-s" steps="3 3.a" hashes="b15be2f1dd0a5719a323f80467752910afbf15c5dd1ef420247e1c2c28a47c4d 77e3342e7fa849e6b973fded89ef945bcfaf6854c1400cf02866d2f285b9b520">
    <emu-alg reading="definition">
      1. If BindingFor(_envRecord_, _name_) is an indirect binding, then
        1. Let _module_ be BindingFor(_envRecord_, _name_).[[Module]].
        1. Let _targetName_ be BindingFor(_envRecord_, _name_).[[BindingName]].
        1. Let _targetEnv_ be _module_.[[Environment]].
        1. If _targetEnv_ is ~empty~, throw a *ReferenceError* exception.
        1. Return ? _targetEnv_.GetBindingValue(_targetName_, *true*).
    </emu-alg>
    <emu-note>
      <p>"the binding for _name_" is the binding for _name_ in _envRecord_ (step 2), and the indirection values are the target module and binding name CreateImportBinding recorded.</p>
    </emu-note>
  </emu-reading>

  <emu-reading clause="sec-createimportbinding" steps="3" hashes="2929b71a3a38ea27c3f5dcfee0267265b9ecba2bd50e998f1fe7e9e507e15627">
    <emu-alg reading="definition">
      1. Perform AddBinding(_envRecord_, _name_, Record { [[Value]]: ~empty~, [[Mutable]]: *false*, [[Initialized]]: *true*, [[Strict]]: *false*, [[Deletable]]: *false*, [[Module]]: _targetModule_, [[BindingName]]: _targetName_ }).
    </emu-alg>
    <emu-note>
      <p>The binding's value is read through its target binding (Module Environment Records' GetBindingValue), so it holds none of its own.</p>
    </emu-note>
  </emu-reading>

  <emu-reading clause="sec-declarative-environment-records-initializebinding-n-v" steps="1" hashes="da63aadbf8d069575da634cf203be690a0f6405d0f8be87cf926e3c800a03ec2">
    <emu-alg reading="definition">
      1. Assert: _envRecord_ has a binding for _name_.
      1. Assert: BindingFor(_envRecord_, _name_) is an uninitialized binding.
    </emu-alg>
    <emu-note>
      <p>"must have an uninitialized binding" is two facts: the binding exists, and it is uninitialized.</p>
    </emu-note>
  </emu-reading>

  <emu-reading clause="sec-declarative-environment-records-setmutablebinding-n-v-s" steps="5.a" hashes="9d8b8323513e77f36f2194bbf5c51ca26d04a149d4298f48f7dd83817405e0e6">
    <emu-alg reading="definition">
      1. Assert: BindingFor(_envRecord_, _name_).[[Mutable]] is *false*.
    </emu-alg>
    <emu-note>
      <p>"This" is the attempt to set the value of the binding for _name_ in _envRecord_; it is an attempt on an immutable binding exactly when that binding is not mutable.</p>
    </emu-note>
  </emu-reading>

  <emu-reading clause="sec-global-environment-records-initializebinding-n-v" steps="3" hashes="1168d108f9152c050aeced0f516192bbe93651132b6838fd3c63525c5610d2c2">
    <emu-alg reading="definition">
      1. Assert: _declRecord_ does not have a binding for _name_.
    </emu-alg>
    <emu-note>
      <p>Step 2 has returned whenever _declRecord_ has a binding for _name_, so here it has none; a Global Environment Record's bindings are those of its [[DeclarativeRecord]] and its [[ObjectRecord]], so a binding for _name_, if it exists, is the latter's. At this step the prose and the reading hold together.</p>
    </emu-note>
  </emu-reading>
</emu-clause>
