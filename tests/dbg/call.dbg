// Statement stepping over calls: stepIn at `var r = f(1)` stops at the callee's first
// statement (one more context); next after `return y` lands in the caller at the call expression,
// in [[Call]] (the statement is the caller's); stepOut from the callee lands there too; next at
// the last statement steps over its call to the end.
{"send": {"command": "initialize"}}
{"expect": {"type": "response", "command": "initialize", "success": true}}
{"expect": {"type": "event", "event": "initialized"}}
{"send": {"command": "launch", "arguments": {"program": "${program}", "stopOnEntry": true}}}
{"expect": {"type": "response", "command": "launch", "success": true}}
{"send": {"command": "configurationDone"}}
{"expect": {"type": "response", "command": "configurationDone", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "entry", "spec": {"alg": "ParseScript", "path": "1"}, "js": {"contexts": 1}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 5, "column": 1, "endLine": 5, "endColumn": 14, "lo": 47, "hi": 60, "contexts": 2}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 2, "column": 3, "endLine": 2, "endColumn": 17, "lo": 18, "hi": 32, "contexts": 3}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 3, "column": 3, "endLine": 3, "endColumn": 12, "lo": 35, "hi": 44, "contexts": 3}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "[[Call]]", "path": "8"}, "js": {"line": 5, "column": 9, "endLine": 5, "endColumn": 13, "lo": 55, "hi": 59, "contexts": 2, "statement": {"line": 5, "column": 1, "lo": 47, "hi": 60}}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 6, "column": 1, "endLine": 6, "endColumn": 10, "lo": 61, "hi": 70, "contexts": 2}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 2, "column": 3, "endLine": 2, "endColumn": 17, "lo": 18, "hi": 32, "contexts": 3}}}}
{"send": {"command": "stepOut", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepOut", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "[[Call]]", "path": "8"}, "js": {"line": 6, "column": 5, "endLine": 6, "endColumn": 9, "lo": 65, "hi": 69, "contexts": 2, "statement": {"line": 6, "column": 1, "lo": 61, "hi": 70}}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 7, "column": 1, "endLine": 7, "endColumn": 14, "lo": 71, "hi": 84, "contexts": 2}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "terminated", "body": {"outcome": "normal: 5"}}}
{"send": {"command": "disconnect"}}
{"expect": {"type": "response", "command": "disconnect", "success": true}}
