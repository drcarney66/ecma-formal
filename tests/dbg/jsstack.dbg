// The JS stack (stackTrace {view: "js"}): one frame per execution context, the running one first.
// A getter run from a map callback three calls deep: get, (anonymous), map (inBuiltin), f, f, f,
// (script) at the call, and the realm's (host) context. A generator resumed by next runs above the
// built-in's context. eval code is (eval), with no position. An iterator helper's closure, resumed
// by next, runs in a context of its own, (iterator), below the mapper's. Paging by startFrame and
// levels.
{"send": {"command": "initialize"}}
{"expect": {"type": "response", "command": "initialize", "success": true}}
{"expect": {"type": "event", "event": "initialized"}}
{"send": {"command": "launch", "arguments": {"program": "${program}", "stopOnEntry": true}}}
{"expect": {"type": "response", "command": "launch", "success": true}}
{"send": {"command": "configurationDone"}}
{"expect": {"type": "response", "command": "configurationDone", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "entry", "js": {"contexts": 1}}}}
{"send": {"command": "stackTrace", "arguments": {"threadId": 1, "view": "js"}}}
{"expect": {"type": "response", "command": "stackTrace", "success": true, "body": {"totalFrames": 1, "contexts": 1, "stackFrames": [{"id": 0, "name": "(host)", "line": 0}]}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 9, "contexts": 2}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 10, "contexts": 2}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 13, "contexts": 2}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 2, "contexts": 3}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 7, "contexts": 3}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 2, "contexts": 4}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 7, "contexts": 4}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 2, "contexts": 5}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 3, "contexts": 5}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 4, "contexts": 7}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 11, "contexts": 8}}}}
{"send": {"command": "stackTrace", "arguments": {"threadId": 1, "view": "js"}}}
{"expect": {"type": "response", "command": "stackTrace", "success": true, "body": {"totalFrames": 8, "contexts": 8, "stackFrames": [{"id": 0, "name": "get", "source": {"name": "jsstack.js"}, "line": 11, "column": 3, "spec": {"frames": {"lo": 0}, "site": "call"}}, {"id": 1, "name": "(anonymous)", "line": 4, "column": 14}, {"id": 2, "name": "map", "line": 0, "inBuiltin": "Array.prototype.map", "spec": {"site": "builtin"}}, {"id": 3, "name": "f", "line": 3, "column": 12}, {"id": 4, "name": "f", "line": 7, "column": 10}, {"id": 5, "name": "f", "line": 7, "column": 10}, {"id": 6, "name": "(script)", "line": 13, "column": 9, "spec": {"site": "script"}}, {"id": 7, "name": "(host)", "line": 0}]}}}
{"send": {"command": "stackTrace", "arguments": {"threadId": 1, "view": "js", "startFrame": 6, "levels": 1}}}
{"expect": {"type": "response", "command": "stackTrace", "success": true, "body": {"totalFrames": 8, "stackFrames": [{"id": 6, "name": "(script)"}]}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 18, "contexts": 2}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 19, "contexts": 2}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 15, "contexts": 4}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 20, "contexts": 2}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 16, "contexts": 4}}}}
{"send": {"command": "stackTrace", "arguments": {"threadId": 1, "view": "js"}}}
{"expect": {"type": "response", "command": "stackTrace", "success": true, "body": {"totalFrames": 4, "contexts": 4, "stackFrames": [{"id": 0, "name": "g", "line": 16, "column": 3, "spec": {"frames": {"lo": 0}, "site": "resume"}}, {"id": 1, "name": "next", "line": 0, "inBuiltin": "%GeneratorPrototype%.next"}, {"id": 2, "name": "(script)", "line": 20, "column": 9}, {"id": 3, "name": "(host)", "line": 0}]}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "js": {"line": 21, "contexts": 2}}}}
{"send": {"command": "setSpecBreakpoints", "arguments": {"breakpoints": [{"alg": "EvalDeclarationInstantiation", "path": "1"}]}}}
{"expect": {"type": "response", "command": "setSpecBreakpoints", "success": true, "body": {"breakpoints": [{"verified": true}]}}}
{"send": {"command": "continue", "arguments": {"threadId": 1}}}
{"expect": {"type": "response", "command": "continue", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "breakpoint", "spec": {"alg": "EvalDeclarationInstantiation", "path": "1"}}}}
{"send": {"command": "stackTrace", "arguments": {"threadId": 1, "view": "js"}}}
{"expect": {"type": "response", "command": "stackTrace", "success": true, "body": {"totalFrames": 3, "contexts": 3, "stackFrames": [{"id": 0, "name": "(eval)", "line": 0, "column": 0, "spec": {"frames": {"lo": 0, "hi": 1}, "site": "eval"}}, {"id": 1, "name": "(script)", "line": 21, "column": 9, "spec": {"frames": {"lo": 1}}}, {"id": 2, "name": "(host)", "line": 0}]}}}
{"send": {"command": "setExceptionBreakpoints", "arguments": {"filters": ["debugger"]}}}
{"expect": {"type": "response", "command": "setExceptionBreakpoints", "success": true}}
{"send": {"command": "continue", "arguments": {"threadId": 1}}}
{"expect": {"type": "response", "command": "continue", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "breakpoint", "description": "debugger statement"}}}
{"send": {"command": "stackTrace", "arguments": {"threadId": 1, "view": "js"}}}
{"expect": {"type": "response", "command": "stackTrace", "success": true, "body": {"totalFrames": 5, "contexts": 5, "stackFrames": [{"id": 0, "name": "(anonymous)", "line": 23, "column": 3}, {"id": 1, "name": "(iterator)", "line": 0, "spec": {"site": "resume"}}, {"id": 2, "name": "next", "inBuiltin": "%IteratorHelperPrototype%.next"}, {"id": 3, "name": "(script)", "line": 22}, {"id": 4, "name": "(host)"}]}}}
{"send": {"command": "continue", "arguments": {"threadId": 1}}}
{"expect": {"type": "response", "command": "continue", "success": true}}
{"expect": {"type": "event", "event": "terminated"}}
{"send": {"command": "disconnect"}}
{"expect": {"type": "response", "command": "disconnect", "success": true}}
