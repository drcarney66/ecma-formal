// A throw caught in the caller: next at `throw 7` lands on the catch's first statement,
// without the stop at the call a return makes; stepOut from the throwing callee lands on the catch's
// statement too.
{"send": {"command": "initialize"}}
{"expect": {"type": "response", "command": "initialize", "success": true}}
{"expect": {"type": "event", "event": "initialized"}}
{"send": {"command": "launch", "arguments": {"program": "${program}", "stopOnEntry": true}}}
{"expect": {"type": "response", "command": "launch", "success": true}}
{"send": {"command": "configurationDone"}}
{"expect": {"type": "response", "command": "configurationDone", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "entry", "spec": {"alg": "ParseScript", "path": "1"}, "js": {"contexts": 1}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 4, "column": 1, "endLine": 4, "endColumn": 7, "lo": 28, "hi": 34, "contexts": 2}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 6, "column": 3, "endLine": 6, "endColumn": 7, "lo": 43, "hi": 47, "contexts": 2}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 2, "column": 3, "endLine": 2, "endColumn": 11, "lo": 17, "hi": 25, "contexts": 3}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 8, "column": 3, "endLine": 8, "endColumn": 9, "lo": 64, "hi": 70, "contexts": 2}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 10, "column": 7, "endLine": 10, "endColumn": 11, "lo": 79, "hi": 83, "contexts": 2}}}}
{"send": {"command": "stepIn", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepIn", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 2, "column": 3, "endLine": 2, "endColumn": 11, "lo": 17, "hi": 25, "contexts": 3}}}}
{"send": {"command": "stepOut", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "stepOut", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 10, "column": 26, "endLine": 10, "endColumn": 36, "lo": 98, "hi": 108, "contexts": 2}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "terminated", "body": {"outcome": "normal: 14"}}}
{"send": {"command": "disconnect"}}
{"expect": {"type": "response", "command": "disconnect", "success": true}}
