// A throw consumed without a catch statement in the caller: stepOut from `throw 1` in an async
// function lands where its context's run is left, as a return through an await does, and next lands
// at `h()`; next at `throw 3`, caught by an empty catch in f, lands at `f()` in k, as a return does.
{"send": {"command": "initialize"}}
{"expect": {"type": "response", "command": "initialize", "success": true}}
{"expect": {"type": "event", "event": "initialized"}}
