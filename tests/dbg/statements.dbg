// Statement stepping (granularity "statement"): from the entry, next stops at each of the
// five statements, at step 1 of its Evaluation, with body.js giving its span; stackTrace's
// frame has endLine/endColumn.
{"send": {"command": "initialize"}}
{"expect": {"type": "response", "command": "initialize", "success": true}}
{"expect": {"type": "event", "event": "initialized"}}
{"send": {"command": "launch", "arguments": {"program": "${program}", "stopOnEntry": true}}}
{"expect": {"type": "response", "command": "launch", "success": true}}
{"send": {"command": "configurationDone"}}
{"expect": {"type": "response", "command": "configurationDone", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "entry", "spec": {"alg": "ParseScript", "path": "1"}, "js": {"contexts": 1}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 1, "column": 1, "endLine": 1, "endColumn": 11, "lo": 0, "hi": 10, "contexts": 2}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 2, "column": 1, "endLine": 2, "endColumn": 11, "lo": 11, "hi": 21, "contexts": 2}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 3, "column": 1, "endLine": 3, "endColumn": 15, "lo": 22, "hi": 36, "contexts": 2}}}}
{"send": {"command": "stackTrace", "arguments": {"threadId": 1, "levels": 1}}}
{"expect": {"type": "response", "command": "stackTrace", "success": true, "body": {"stackFrames": [{"name": "Evaluation", "line": 3, "column": 1, "endLine": 3, "endColumn": 15}]}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 4, "column": 1, "endLine": 4, "endColumn": 11, "lo": 37, "hi": 47, "contexts": 2}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "stopped", "body": {"reason": "step", "spec": {"alg": "Evaluation", "path": "1"}, "js": {"line": 5, "column": 1, "endLine": 5, "endColumn": 10, "lo": 48, "hi": 57, "contexts": 2}}}}
{"send": {"command": "next", "arguments": {"threadId": 1, "granularity": "statement"}}}
{"expect": {"type": "response", "command": "next", "success": true}}
{"expect": {"type": "event", "event": "output", "body": {"output": "6\n"}}}
{"expect": {"type": "event", "event": "terminated", "body": {"outcome": "normal: undefined"}}}
{"send": {"command": "disconnect"}}
{"expect": {"type": "response", "command": "disconnect", "success": true}}
